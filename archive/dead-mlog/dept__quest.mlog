// ---------------------------------------------------------------------------
// 6. QuestAddFile — register a file in the dossier
// ---------------------------------------------------------------------------
pattern QuestAddFile(qid: String, filename: String, file_type: String, storage_path: String) -> String {
  // Check version: increment if same filename exists
  let vrows = query("SELECT MAX(version) as max_v FROM quest_files WHERE quest_id = ?1 AND filename = ?2", [qid, filename])
  let mut ver = 1.0
  if length(vrows) > 0.0 then {
    let max_v = to_float(TryVal(try json_get(vrows[0], "max_v", "0")))
    if max_v > 0.0 then {
      let ver = max_v + 1.0
    }
  }

  db_execute("INSERT INTO quest_files (quest_id, filename, file_type, version, storage_path, created_at) VALUES (?1, ?2, ?3, ?4, ?5, datetime('now'))",
    [qid, filename, file_type, to_string(ver), storage_path])

  let _ = AuditLog("quest_add_file", "quest", "id=" + qid + " file=" + filename + " v" + to_string(ver))
  return "Fajl " + filename + " v" + to_string(ver) + " dobavlen v dosse " + qid + "."
}
// ---------------------------------------------------------------------------
// 7. QuestSetStepLabel — rename a checkpoint step
// ---------------------------------------------------------------------------
pattern QuestSetStepLabel(qid: String, step_num: String, label: String) -> String {
  db_execute("UPDATE quest_checkpoints SET step_label = ?1 WHERE quest_id = ?2 AND step_num = ?3", [label, qid, step_num])
  return "Shag " + step_num + " pereimenovan v: " + label
}
