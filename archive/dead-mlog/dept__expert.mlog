// АРХИВ DEAD-паттернов из dept/expert.mlog — #449 A.1, решение владельца 2026-10-02
// (вариант «в архив», история git сохранена; файл НЕ импортируется app.mlog
// и не входит в прод-неймспейс). SHA256 фрагмента: f66c933c
// Оживёт потребность — переносить назад осознанно, с вызовом и тестом.
// ═══════════════════════════════════════════════════════════════════════

// Gate 1: Briefing must contain disclaimer — every output carries accountability marker
pattern ExpertGateBriefingMustHaveDisclaimer(briefingText: String) -> String {
  let disc = ExpertDisclaimer()
  if contains(briefingText, substring(disc, 0.0, 20.0)) == false then {
    let _ = AuditLog("hard_gate_violation", "expert", "Gate 1: briefing without disclaimer")
    return "ОТКАЗ: Брифинг без дисклеймера недействителен. Каждый брифинг должен содержать ExpertDisclaimer()."
  }
  return "PASS"
}
// Gate 3: No speculation-only briefings — must contain at least one [ФАКТ] marker
pattern ExpertGateNoSpeculationOnly(briefingText: String) -> String {
  if contains(briefingText, "[ФАКТ]") == false and contains(briefingText, "[FACT]") == false then {
    let _ = AuditLog("hard_gate_violation", "expert", "Gate 3: briefing without any [ФАКТ] markers")
    return "ОТКАЗ: Брифинг содержит только спекуляцию. Каждый брифинг обязан включать минимум один верифицированный [ФАКТ]."
  }
  return "PASS"
}
// Gate 6: No CallLLMProxy in expert code — structural integrity gate
pattern ExpertGateNoProxyAudit() -> String {
  // This gate is checked at deployment time. At runtime, we verify the count is 0.
  let _ = AuditLog("gate_check", "expert", "Gate 6: proxy audit — verified 0 CallLLMProxy calls in expert.mlog")
  return "PASS"
}
