pattern DISCIPLINES() -> String { return "structural,hydraulic,power_electronics" }
pattern DISCIPLINE_NAMES_RU() -> String { return "строймеханика=structural,строительная=structural,несущая=structural,кровля=structural,теплица=structural,каркас=structural,балка=structural,ферма=structural,снеговая=structural,ветровая=structural,гидравлика=hydraulic,гидропривод=hydraulic,гидроцилиндр=hydraulic,подъёмник=hydraulic,подъемник=hydraulic,инвертор=power_electronics,коммутатор=power_electronics,преобразователь=power_electronics,ветрогенератор=power_electronics,солнечн=power_electronics,электроника=power_electronics,фотоэлектрич=power_electronics" }
// Error classes for learning loop
pattern ERROR_CLASSES() -> String { return "missed_load_case,wrong_coefficient,wrong_norm,dimensional_error,wrong_assumption,method_error,none" }
