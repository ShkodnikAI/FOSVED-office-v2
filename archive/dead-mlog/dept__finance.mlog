// ── Depth → Model mapping ──
// depth 0: claude-3-5-haiku (fast, cheap — simple lookups, invoice listing)
// depth 1: claude-sonnet-4-20250514 (balanced — cashflow, tax calc)
// depth 2: claude-sonnet-4-20250514 (high reasoning — multi-jurisdiction, unit economics)
// depth 3: claude-opus-4-20250514 (deep — cross-jurisdiction analysis, quarterly review)
pattern FinanceSelectModel(depth: Int) -> String {
  if depth == 0.0 then { return "claude-3-5-haiku" }
  if depth == 1.0 then { return "claude-sonnet-4-20250514" }
  if depth == 2.0 then { return "claude-sonnet-4-20250514" }
  if depth == 3.0 then { return "claude-opus-4-20250514" }
  return "claude-sonnet-4-20250514"
}
// ── Per-operation token budgets ──
// [Context, Analysis, Output] per depth level
pattern FinanceOpBudget(depth: Int) -> String {
  if depth == 0.0 then { return "2000,500,500" }        // total ~3000
  if depth == 1.0 then { return "4000,2000,1000" }       // total ~7000
  if depth == 2.0 then { return "6000,4000,1500" }       // total ~11500
  if depth == 3.0 then { return "8000,6000,2000" }       // total ~16000
  return "4000,2000,1000"
}
// GET /finance/invoices?status=overdue&limit=20
pattern FinanceInvoicesAPI(status: String, limit: Int) -> String {
  // №312: литеральный SQL + параметры (см. FinanceForecastsAPI)
  return json_encode(query("SELECT id, invoice_number, client_name, amount, currency, status, due_date, jurisdiction FROM invoices WHERE (?1 = '' OR status = ?1) ORDER BY due_date ASC LIMIT ?2", [status, limit]))
}
// GET /finance/metrics — MAPE snapshot
pattern FinanceMetricsAPI() -> String {
  let rows = query("SELECT AVG(v.mape) as avg_mape, COUNT(*) as n FROM financial_forecast_verifications v JOIN financial_forecasts f ON v.forecast_id = f.id WHERE f.result_type = 'forecast' AND v.verified_at >= datetime('now', '-30 days') AND v.mape IS NOT NULL", [])
  if length(rows) > 0.0 then {
    let avg_mape = to_float(to_string(json_get(get(rows, 0.0), "avg_mape", "0")))
    let n = to_float(to_string(json_get(get(rows, 0.0), "n", "0")))
    return json_encode({metric: "mape-cashflow", value: avg_mape, sample_size: n, period: "last_30_days"})
  }
  return json_encode({metric: "mape-cashflow", value: null, sample_size: 0, period: "last_30_days", note: "insufficient data"})
}
pattern FinanceVerifyRecord(forecast_id: String, actual_amount: String) -> String {
  // Retrieve forecast
  let rows = query("SELECT id, amount, result_type, status, verification_date FROM financial_forecasts WHERE id = ?", [forecast_id])
  if length(rows) == 0.0 then { return "Прогноз #" + forecast_id + " не найден." }

  let forecast = get(rows, 0.0)
  let forecast_amount = get(forecast, "amount")
  let result_type = get(forecast, "result_type")
  let current_status = get(forecast, "status")

  // Cannot verify already-verified forecasts
  if current_status == "verified" or current_status == "missed" or current_status == "partial" then {
    return "Прогноз #" + forecast_id + " уже верифицирован (статус: " + current_status + "). Ретроактивная модификация запрещена."
  }

  // Calculate MAPE
  let mut mape = 0.0
  if to_string(forecast_amount) != "null" and to_string(forecast_amount) != "0" then {
    let fa = to_float(to_string(forecast_amount))
    let aa = to_float(actual_amount)
    let diff = aa - fa
    if diff < 0.0 then { let diff = 0.0 - diff }
    let mape = diff / fa * 100.0
  }

  // Determine outcome based on MAPE targets
  // Targets: 30d ≤ 5%, 60d ≤ 10%, 90d ≤ 15% — simplified: use 10% as base
  let outcome = "verified"
  if mape > 15.0 then { let outcome = "missed" }
  if mape > 10.0 and mape <= 15.0 then { let outcome = "partial" }

  // Save verification
  let _ = db_execute("INSERT INTO financial_forecast_verifications (forecast_id, outcome, actual_value, mape, verified_at) VALUES (?, ?, ?, ?, datetime('now'))", [forecast_id, outcome, actual_amount, to_string(mape)])
  // Update forecast status
  let _ = db_execute("UPDATE financial_forecasts SET status = ? WHERE id = ?", [outcome, forecast_id])

  let report = "✅ Verification #" + forecast_id + "\n\n"
  let report = report + "Forecasted: " + to_string(forecast_amount) + "\n"
  let report = report + "Actual: " + actual_amount + "\n"
  let report = report + "MAPE: " + to_string(mape) + "%\n"
  let report = report + "Outcome: " + outcome + "\n\n"
  if outcome == "verified" then { let report = report + "Прогноз в пределах нормы (MAPE ≤ 10%)." }
  if outcome == "partial" then { let report = report + "Прогнос в пределах допуска (MAPE ≤ 15%), но выше целевого. Рекомендуется анализ ошибки." }
  if outcome == "missed" then { let report = report + "🚨 Прогноз серьёзно отклонился (MAPE > 15%). Требуется corrigendum — пересмотр методологии для данного типа прогноза." }

  return report
}
pattern FinanceClassifyError(forecast_id: String) -> String {
  let rows = query("SELECT f.result_type, f.jurisdiction, f.business_form, v.mape, v.notes FROM financial_forecasts f JOIN financial_forecast_verifications v ON v.forecast_id = f.id WHERE f.id = ? ORDER BY v.verified_at DESC LIMIT 1", [forecast_id])
  if length(rows) == 0.0 then { return "no data" }

  let v = get(rows, 0.0)
  let result_type = get(v, "result_type")
  let jx = get(v, "jurisdiction")

  // Heuristic error classification
  if result_type == "forecast" then {
    // Cashflow forecast error — likely: revenue overestimate, expense underestimate, or external shock
    return "FORECAST_ERROR: likely cause = revenue_overestimate OR expense_underestimate OR external_shock. Check: did revenue assumptions hold? Were there unplanned expenses? Currency shift?"
  }
  if result_type == "tax" then {
    return "TAX_ERROR: likely cause = rate_change OR wrong_jurisdiction_rule OR missing_deduction. Check: has tax rate changed in " + jx + "? Was the right regime applied?"
  }
  if result_type == "unit_economics" then {
    return "UNIT_ECON_ERROR: likely cause = churn_underestimate OR cac_volatility OR cohort_mixing. Check: was churn rate correct? Were CAC inputs stable? Were cohorts properly separated?"
  }
  return "OTHER_ERROR: unclassified. Manual review needed."
}
// Marketing: Finance verifies Marketing's CAC/LTV against reality
pattern FinanceVerifyMarketingMetrics(period: String) -> String {
  // Get Marketing's claimed CAC/LTV
  let marketing_claims = query("SELECT id, short_title, amount FROM financial_forecasts WHERE result_type = 'unit_economics' AND status = 'published' AND short_title LIKE '%Marketing%' ORDER BY created_at DESC LIMIT 5", [])
  if length(marketing_claims) == 0.0 then { return "No Marketing unit economics claims to verify." }
  return "Marketing claims pending verification: " + to_string(length(marketing_claims)) + ". Use /finance-verify with actual data."
}
// Legal: tax disputes, contractual payments
pattern FinanceLegalContext(query_text: String) -> String {
  // Return structured financial context for Legal department
  let overdue_invoices = query("SELECT id, invoice_number, client_name, amount, currency, status, due_date FROM invoices WHERE status IN ('escalation', 'pre_legal') ORDER BY due_date ASC", [])
  return json_encode({department: "finance", context: "pre_legal_invoices", data: overdue_invoices, query: query_text})
}
// OSP: strategic financial forecasts (3+ months)
pattern FinanceOSPContext() -> String {
  let cashflow_forecasts = query("SELECT id, short_title, confidence, jurisdiction, business_form, amount, currency, verification_date FROM financial_forecasts WHERE result_type = 'forecast' AND status IN ('published', 'verified', 'partial') ORDER BY created_at DESC LIMIT 5", [])
  let mape_data = query("SELECT AVG(v.mape) as avg_mape, COUNT(*) as n FROM financial_forecast_verifications v WHERE v.verified_at >= datetime('now', '-90 days') AND v.mape IS NOT NULL", [])
  return json_encode({department: "finance", forecasts: cashflow_forecasts, mape: mape_data, note: "Finance provides cashflow data and MAPE accuracy for OSP's strategic analysis. Investment decisions remain OSP domain."})
}
pattern GateNoRoundingForComfort(reply: String) -> String {
  let r = lower(reply)
  if contains(r, "округлено до") or contains(r, "приблизительн") or contains(r, "прим.") or contains(r, "~") then {
    return "FAIL: Finance never rounds for comfort. Every копейка counts. Remove approximate language and provide exact figures."
  }
  return "PASS"
}
pattern FinanceConvertCurrency(amount: String, from_currency: String, to_currency: String, date: String) -> String {
  // Same currency — no conversion
  if from_currency == to_currency then { return amount }
  // Get exchange rate from DB (stored by scheduler)
  let rate_rows = query("SELECT rate FROM exchange_rates WHERE from_currency = ? AND to_currency = ? AND rate_date <= ? ORDER BY rate_date DESC LIMIT 1", [from_currency, to_currency, date])
  if length(rate_rows) > 0.0 then {
    let rate = to_float(to_string(json_get(get(rate_rows, 0.0), "rate", "0")))
    let result = to_float(amount) * to_float(to_string(rate))
    return to_string(result)
  }
  // Fallback: try reverse rate
  let reverse_rows = query("SELECT rate FROM exchange_rates WHERE from_currency = ? AND to_currency = ? AND rate_date <= ? ORDER BY rate_date DESC LIMIT 1", [to_currency, from_currency, date])
  if length(reverse_rows) > 0.0 then {
    let rev_rate = to_float(to_string(json_get(get(reverse_rows, 0.0), "rate", "0")))
    let result = to_float(amount) / to_float(to_string(rev_rate))
    return to_string(result)
  }
  return "NO_RATE: exchange rate " + from_currency + "->" + to_currency + " not found for " + date + ". Enter rate manually or update exchange_rates table."
}
pattern FinanceRevenueRecognition(amount: String, currency: String, basis: String, period_start: String, period_end: String) -> String {
  // basis: "cash" or "accrual"
  if basis == "cash" then {
    // Cash basis: recognize when payment received
    let payments = query("SELECT SUM(paid_amount) as total FROM invoices WHERE paid_at >= ? AND paid_at <= ? AND currency = ? AND status = 'paid'", [period_start, period_end, currency])
    if length(payments) > 0.0 then {
      let total = to_float(to_string(json_get(get(payments, 0.0), "total", "0")))
      return "CASH_BASIS: recognized " + to_string(total) + " " + currency + " (payments received " + period_start + " to " + period_end + ")"
    }
    return "CASH_BASIS: no payments in period"
  }
  // Accrual basis: recognize when earned (issued date)
  let earned = query("SELECT SUM(amount) as total FROM invoices WHERE issue_date >= ? AND issue_date <= ? AND currency = ? AND status NOT IN ('drafted', 'written_off')", [period_start, period_end, currency])
  if length(earned) > 0.0 then {
    let total = to_float(to_string(json_get(get(earned, 0.0), "total", "0")))
    // Deferred revenue: invoices issued but not yet due
    let deferred = query("SELECT SUM(amount) as total FROM invoices WHERE issue_date < ? AND due_date > ? AND currency = ? AND status NOT IN ('drafted', 'written_off', 'paid', 'closed')", [period_end, period_end, currency])
    let deferred_amount = "0"
    if length(deferred) > 0.0 then { let deferred_amount = to_float(to_string(json_get(get(deferred, 0.0), "total", "0"))) }
    return "ACCRUAL_BASIS: recognized " + to_string(total) + " " + currency + " (earned " + period_start + " to " + period_end + "). Deferred: " + deferred_amount + " " + currency
  }
  return "ACCRUAL_BASIS: no revenue in period"
}
pattern FinanceTaxCalendarList(jurisdiction: String, limit: Int) -> String {
  let rows = query("SELECT id, tax_type, description, deadline_date, completed, notify_days_before FROM tax_calendar_events WHERE jurisdiction = ? ORDER BY deadline_date ASC LIMIT ?", [jurisdiction, limit])
  if length(rows) == 0.0 then { return "No tax calendar events for " + jurisdiction }
  let result = "📅 Tax Calendar (" + jurisdiction + "):\n"
  let i = 0.0
  while i < length(rows) {
    let row = get(rows, i)
    let status_icon = "⬜"
    if get(row, "completed") == 1.0 then { let status_icon = "✅" }
    let result = result + status_icon + " #" + to_string(get(row, "id")) + " " + get(row, "tax_type") + ": " + get(row, "description") + " — " + to_string(get(row, "deadline_date")) + "\n"
    let i = i + 1.0
  }
  return result
}
pattern FinanceTaxCalendarComplete(event_id: String) -> String {
  let rows = query("SELECT id, completed FROM tax_calendar_events WHERE id = ?", [event_id])
  if length(rows) == 0.0 then { return "Tax event #" + event_id + " not found" }
  let current = to_string(json_get(get(rows, 0.0), "completed", ""))
  if current == 1.0 then { return "Tax event #" + event_id + " already completed" }
  let _ = db_execute("UPDATE tax_calendar_events SET completed = 1, completed_at = datetime('now') WHERE id = ?", [event_id])
  let _ = AuditLog("finance_tax_complete", "finance", "event_id=" + event_id)
  return "✅ Tax event #" + event_id + " marked as completed"
}
pattern FinanceCompatibilityLookup(jurisdiction: String, business_form: String) -> String {
  // BY
  if jurisdiction == "BY" and business_form == "ooo" then { return "COMPATIBLE: ООО in BY (ОСН 18% profit / УСН 3-5% / ПВТ 9%). Full double-entry accounting." }
  if jurisdiction == "BY" and business_form == "ip" then { return "COMPATIBLE: ИП in BY (13% НДФЛ + НДС or единый налог). Simplified accounting (КУДиР)." }
  if jurisdiction == "BY" and business_form == "selfemployed" then { return "INCOMPATIBLE: самозанятый does not exist in BY. Nearest: ремесленник (единый налог) or ИП." }
  // RU
  if jurisdiction == "RU" and business_form == "ooo" then { return "COMPATIBLE: ООО in RU (ОСН 20% profit / УСН 6%/15% / IT 0% profit). Full accounting." }
  if jurisdiction == "RU" and business_form == "ip" then { return "COMPATIBLE: ИП in RU (ОСН / УСН 6%/15% / ПСН / НПД 4%/6%). Simplified accounting." }
  if jurisdiction == "RU" and business_form == "selfemployed" then { return "COMPATIBLE: самозанятый (НПД) in RU. 4% for individuals, 6% for business clients. No employees allowed. Limit 2.4M RUB/year." }
  // EU
  if jurisdiction == "EU" and business_form == "ooo" then { return "COMPATIBLE: GmbH/SARL/SpA equivalent in EU. VAT OSS for B2C, reverse charge B2B. CIT varies 9-30% by member state." }
  if jurisdiction == "EU" and business_form == "ip" then { return "COMPATIBLE: Freiberufler/Auto-entrepreneur/Einzelunternehmen in EU. Varies by member state. Simplified regimes available." }
  if jurisdiction == "EU" and business_form == "selfemployed" then { return "PARTIAL: самозанятый concept varies in EU. NL: ZZP, DE: Freiberufler, FR: Auto-entrepreneur. Check specific country." }
  // US
  if jurisdiction == "US" and business_form == "ooo" then { return "COMPATIBLE: LLC in US (disregarded/partnership/S-Corp/C-Corp). CIT 21% for C-Corp, pass-through for others. State taxes vary." }
  if jurisdiction == "US" and business_form == "ip" then { return "COMPATIBLE: Sole Proprietorship in US. Personal income tax (10-37%) + SE tax 15.3%. Simplest form." }
  if jurisdiction == "US" and business_form == "selfemployed" then { return "COMPATIBLE: Independent Contractor / 1099 in US. SE tax 15.3% + income tax. Quarterly estimated payments required." }
  return "UNKNOWN: combination " + jurisdiction + "/" + business_form + " not in compatibility matrix."
}
pattern FinanceVerifyByHorizon(forecast_id: String, actual_amount: String) -> String {
  let rows = query("SELECT id, amount, result_type, status, verification_date, created_at FROM financial_forecasts WHERE id = ?", [forecast_id])
  if length(rows) == 0.0 then { return "Forecast #" + forecast_id + " not found" }
  let f = get(rows, 0.0)
  let forecast_amount = get(f, "amount")
  let created = get(f, "created_at")
  let vdate = get(f, "verification_date")
  // Determine horizon from created_at to verification_date
  let horizon = "30" // default
  let days_diff = to_float(to_string(vdate)) - to_float(to_string(created))
  if days_diff > 60.0 then { let horizon = "90" }
  if days_diff > 30.0 and days_diff <= 60.0 then { let horizon = "60" }
  // MAPE targets by horizon
  let mape_target = 5.0
  if horizon == "60" then { let mape_target = 10.0 }
  if horizon == "90" then { let mape_target = 15.0 }
  // Calculate MAPE
  let fa = to_float(to_string(forecast_amount))
  let aa = to_float(actual_amount)
  let diff = aa - fa
  if diff < 0.0 then { let diff = 0.0 - diff }
  let mape = diff / fa * 100.0
  // Outcome with horizon-aware targets
  let outcome = "verified"
  if mape > mape_target * 1.5 then { let outcome = "missed" }
  if mape > mape_target and mape <= mape_target * 1.5 then { let outcome = "partial" }
  // Save
  let _ = db_execute("INSERT INTO financial_forecast_verifications (forecast_id, outcome, actual_value, mape, verified_at) VALUES (?, ?, ?, ?, datetime('now'))", [forecast_id, outcome, actual_amount, to_string(mape)])
  let _ = db_execute("UPDATE financial_forecasts SET status = ? WHERE id = ?", [outcome, forecast_id])
  let report = "📊 Verification #" + forecast_id + " (" + horizon + "d horizon)\n\n"
  let report = report + "Forecasted: " + to_string(forecast_amount) + "\n"
  let report = report + "Actual: " + actual_amount + "\n"
  let report = report + "MAPE: " + to_string(mape) + "% (target ≤" + to_string(mape_target) + "%)\n"
  let report = report + "Outcome: " + outcome + "\n"
  return report
}
pattern FinanceBotHandlers() -> String {
  let handlers = ""
  let handlers = handlers + "/finance-forecast <days> [BY|RU|EU|US] [ooo|ip|selfemployed] → FinanceCashflowForecast\n"
  let handlers = handlers + "/finance-invoice [overdue|open|paid] → FinanceInvoiceHandler\n"
  let handlers = handlers + "/finance-tax <jurisdiction> <amount> <type> [form] → FinanceTaxCalc\n"
  let handlers = handlers + "/finance-verify <id> [actualAmount] → FinanceVerifyForecast (inline keyboard for outcome)\n"
  let handlers = handlers + "/finance-archive [filter] → FinanceArchiveSearch\n"
  let handlers = handlers + "/finance-score → FinanceScore\n"
  let handlers = handlers + "/finance-runway <cash> <burn> → FinanceRunwayCalc\n"
  let handlers = handlers + "/finance-unit <CAC|LTV|payback> → FinanceUnitEconomics\n"
  let handlers = handlers + "/finance-mrr → FinanceMrrArr\n"
  let handlers = handlers + "/finance [free text] → HandleFinance (intent classification)\n"
  return handlers
}
pattern FinanceRegistryEntry() -> String {
  return json_encode({slug: "finance", title: "Финансы", shortName: "ФИН", status: "active", psychotype_primary: "Педант", psychotype_secondary: "Методист", metric_name: "mape-cashflow", metric_targets: "30d ≤5%, 60d ≤10%, 90d ≤15%", archiveModel: "FinancialForecast", verificationModel: "FinancialForecastVerification", monthlyReviewModel: "FinanceMonthlyReview", aliases: "финансы,финанс,фин,бухгалтерия,finance", routingTriggers: "счёт,инвойс,оплата,выручка,бюджет,MRR,ARR,cashflow,налог,ндс,CAC,LTV,маржа,прибыль,доход,расход,ROI,payback,runway,burn rate", requiredContext: "jurisdiction (BY/RU/EU/US) + businessForm (ooo/ip/selfemployed)", commands: "/finance,/finance-forecast,/finance-invoice,/finance-tax,/finance-verify,/finance-archive,/finance-score,/finance-runway,/finance-unit", schedule: "daily 8:00, monthly 1st 10:00, quarterly 1st 11:00"})
}
pattern FinanceYanaRouting(query: String) -> String {
  let t = lower(query)
  // Direct Finance patterns
  if contains(t, "сколько денег") or contains(t, "хватит ли денег") or contains(t, "кассов разрыв") then { return "ROUTE:finance:cashflow" }
  if contains(t, "просрочен") and contains(t, "инвойс") then { return "ROUTE:finance:invoice" }
  if contains(t, "какой vat") or contains(t, "какой ндс") then { return "ROUTE:finance:tax" }
  if contains(t, "окупаемост") or contains(t, "стоимость привлечен") then { return "ROUTE:finance:unit_economics" }
  // Cross-department patterns
  if contains(t, "окупается ли реклам") then { return "ROUTE:finance+marketing:unit_economics_verify" }
  if contains(t, "договор") and (contains(t, "eur") or contains(t, "usd")) then { return "ROUTE:legal+finance:contract_with_tax" }
  // Not Finance scope
  if contains(t, "куда вложить") or contains(t, "инвестиционн") then { return "ROUTE:osp:investment_advice" }
  if contains(t, "аудит отчётност") then { return "ROUTE:qa:audit" }
  return "NO_ROUTE"
}
// Yana's context question protocol — must ask before Finance work
pattern FinanceYanaContextCheck(query: String, chat_id: String) -> String {
  let jurisdiction = FinanceExtractJurisdiction(query)
  let business_form = FinanceExtractBusinessForm(query)
  let mut needs_context = ""
  if jurisdiction == "BY" then {
    // Check if default was used (no explicit jurisdiction in query)
    let t = lower(query)
    let has_jurisdiction = contains(t, "беларус") or contains(t, "by") or contains(t, "byn")
    if has_jurisdiction == false then {
      let default_jx = kv_get("DEFAULT_JURISDICTION")
      if to_string(default_jx) == "()" or to_string(default_jx) == "" then {
        let needs_context = needs_context + "jurisdiction "
      }
    }
  }
  if business_form == "ooo" then {
    let t = lower(query)
    let has_bf = contains(t, "ooo") or contains(t, "ооо") or contains(t, "обществ")
    if has_bf == false then {
      let default_bf = kv_get("DEFAULT_BUSINESS_FORM")
      if to_string(default_bf) == "()" or to_string(default_bf) == "" then {
        let needs_context = needs_context + "businessForm"
      }
    }
  }
  if needs_context != "" then {
    return "YANA_ASK: перед финансовым расчётом уточните: " + needs_context + ". Без этих параметров расчёт может быть систематически неверным."
  }
  return "CONTEXT_OK"
}
