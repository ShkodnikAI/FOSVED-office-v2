// Format chain report body with badges
pattern FormatChainBody(dept: String, text: String) -> String {
  let body = replace(text, "[ФАКТ]", "<span class=\"badge badge-fact\">ФАКТ</span>")
  let body = replace(body, "[ИНТЕРПРЕТАЦИЯ]", "<span class=\"badge badge-interp\">ИНТЕРПРЕТАЦИЯ</span>")
  let body = replace(body, "[СПЕКУЛЯЦИЯ]", "<span class=\"badge badge-spec\">СПЕКУЛЯЦИЯ</span>")
  let body = replace(body, "[FACT]", "<span class=\"badge badge-fact\">FACT</span>")
  let body = replace(body, "[FACT verified]", "<span class=\"badge badge-verified\">FACT verified</span>")
  return body
}
