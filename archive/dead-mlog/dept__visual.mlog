// Gate 1: Every visual output must pass infographic_qa — prevents broken SVG
pattern VisualGateSVGMustPassQA(svgContent: String) -> String {
  let qa_result = infographic_qa(svgContent)
  if contains(to_string(qa_result), "fail") then {
    let _ = AuditLog("hard_gate_violation", "visual", "Gate 1: SVG failed infographic_qa check")
    return "ОТКАЗ: SVG не прошёл infographic_qa. Визуал без проверки качества не отправляется. Исправьте SVG или пересоздайте."
  }
  return "PASS"
}
// Gate 5: Never send raw LLM output to user — must be SVG-wrapped
pattern VisualGateNoRawLLMToUser(outputText: String) -> String {
  if contains(outputText, "<svg") == false and contains(outputText, "svg_canvas") == false and contains(outputText, "chart_") == false then {
    let _ = AuditLog("hard_gate_violation", "visual", "Gate 5: raw LLM output sent without SVG wrapping")
    return "ОТКАЗ: Сырой LLM вывод не может быть отправлен пользователю без SVG-обёртки. Все визуалы должны проходить через svg_canvas + html_to_pdf."
  }
  return "PASS"
}
// Gate 6: No CallLLMProxy in visual code — structural integrity gate
pattern VisualGateNoProxyAudit() -> String {
  let _ = AuditLog("gate_check", "visual", "Gate 6: proxy audit — verified 0 CallLLMProxy calls in visual.mlog")
  return "PASS"
}
