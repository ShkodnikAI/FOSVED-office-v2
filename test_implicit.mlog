db { url: "sqlite:/tmp/test_implicit.db" }

pattern TestBare() -> String {
  let items = [1.0, 2.0, 3.0]
  let result = ""
  db_execute("CREATE TABLE IF NOT EXISTS test_implicit (id INTEGER PRIMARY KEY, detail TEXT)")
  db_execute("DELETE FROM test_implicit")
  db_execute("INSERT INTO test_implicit (detail) VALUES ('bare_before_loop')")
  each x in items {
    let result = result + to_string(x)
    db_execute("INSERT INTO test_implicit (detail) VALUES ('bare_iter_" + to_string(x) + "')")
  }
  db_execute("INSERT INTO test_implicit (detail) VALUES ('bare_after_loop')")
  return result
}

pattern TestLet() -> String {
  let items = [1.0, 2.0, 3.0]
  let result = ""
  db_execute("CREATE TABLE IF NOT EXISTS test_implicit (id INTEGER PRIMARY KEY, detail TEXT)")
  db_execute("DELETE FROM test_implicit")
  db_execute("INSERT INTO test_implicit (detail) VALUES ('let_before_loop')")
  each x in items {
    let result = result + to_string(x)
    let _ = db_execute("INSERT INTO test_implicit (detail) VALUES ('let_iter_" + to_string(x) + "')")
  }
  db_execute("INSERT INTO test_implicit (detail) VALUES ('let_after_loop')")
  return result
}

pattern ShowRows() -> String {
  let rows = query("SELECT detail FROM test_implicit ORDER BY id", [])
  let out = ""
  each row in rows {
    let out = out + json_get(row, "detail", "") + "\n"
  }
  return out
}

mlogserver {
  port: 19999
  route "/test1" method=GET {
    let r = TestBare()
    return respond("200 bare_result=[" + r + "]")
  }
  route "/test2" method=GET {
    let r = TestLet()
    return respond("200 let_result=[" + r + "]")
  }
  route "/rows" method=GET {
    return respond("200 " + ShowRows())
  }
}