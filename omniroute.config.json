{
  "connections": {
    "zai": {
      "url": "https://api.z.ai/api/paas/v4/chat/completions",
      "apiKeyEnv": "ZAI_API_KEY",
      "format": "openai",
      "models": ["glm-4.6", "glm-4-plus"],
      "timeout": 120,
      "costPerMtokIn": 0.5,
      "costPerMtokOut": 1.5
    },
    "deepseek": {
      "url": "https://api.deepseek.com/v1/chat/completions",
      "apiKeyEnv": "DEEPSEEK_API_KEY",
      "format": "openai",
      "models": ["deepseek-v4-pro", "deepseek-v4-flash"],
      "timeout": 120,
      "costPerMtokIn": 0.14,
      "costPerMtokOut": 0.28
    },
    "groq": {
      "url": "https://api.groq.com/openai/v1/chat/completions",
      "apiKeyEnv": "GROQ_API_KEY",
      "format": "openai",
      "models": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant", "mixtral-8x7b-32768", "gemma2-9b-it"],
      "timeout": 90,
      "costPerMtokIn": 0.0,
      "costPerMtokOut": 0.0
    },
    "grok": {
      "url": "https://api.x.ai/v1/chat/completions",
      "apiKeyEnv": "GROK_API_KEY",
      "format": "openai",
      "models": ["grok-3", "grok-3-mini"],
      "timeout": 120,
      "costPerMtokIn": 3.0,
      "costPerMtokOut": 15.0
    },
    "anthropic": {
      "url": "https://api.anthropic.com/v1/messages",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "format": "anthropic",
      "models": ["claude-sonnet-4-20250514", "claude-3.5-haiku-20241022"],
      "timeout": 120,
      "costPerMtokIn": 3.0,
      "costPerMtokOut": 15.0
    },
    "openai": {
      "url": "https://api.openai.com/v1/chat/completions",
      "apiKeyEnv": "OPENAI_API_KEY",
      "format": "openai",
      "models": ["gpt-4o", "gpt-4o-mini"],
      "timeout": 120,
      "costPerMtokIn": 2.5,
      "costPerMtokOut": 10.0
    },
    "apodex": {
      "url": "https://api.apodex.ai/v1/chat/completions",
      "apiKeyEnv": "APODEX_API_KEY",
      "format": "openai",
      "models": ["apodex-1.0-mini", "apodex-1.0"],
      "timeout": 300,
      "costPerMtokIn": 2.0,
      "costPerMtokOut": 8.0
    }
  },
  "combos": {
    "fosved-standard": {
      "description": "Standard quality — zai primary, groq fallback, deepseek tertiary, cerebras last",
      "chain": [
        {"connection": "zai", "models": ["glm-4.6", "glm-4-plus"]},
        {"connection": "groq", "models": ["llama-3.3-70b-versatile"]},
        {"connection": "deepseek", "models": ["deepseek-v4-pro", "deepseek-v4-flash"]},
        {"connection": "cerebras", "models": ["gpt-oss-120b"]}
      ]
    },
    "fosved-deep": {
      "description": "Deep analysis — zai primary, groq secondary, deepseek tertiary, cerebras quaternary, anthropic last",
      "chain": [
        {"connection": "zai", "models": ["glm-4.6"]},
        {"connection": "groq", "models": ["llama-3.3-70b-versatile"]},
        {"connection": "deepseek", "models": ["deepseek-v4-pro"]},
        {"connection": "cerebras", "models": ["gpt-oss-120b"]},
        {"connection": "anthropic", "models": ["claude-sonnet-4-20250514"]}
      ]
    },
    "fosved-free": {
      "description": "Free tier — groq primary (zero cost), deepseek secondary, cerebras tertiary",
      "chain": [
        {"connection": "groq", "models": ["llama-3.3-70b-versatile", "llama-3.1-8b-instant"]},
        {"connection": "deepseek", "models": ["deepseek-v4-pro", "deepseek-v4-flash"]},
        {"connection": "cerebras", "models": ["gpt-oss-120b"]}
      ]
    },
    "fosved-fusion": {
      "description": "Fusion — multi-provider consensus, best quality",
      "chain": [
        {"connection": "zai", "models": ["glm-4.6"]},
        {"connection": "groq", "models": ["llama-3.3-70b-versatile"]},
        {"connection": "deepseek", "models": ["deepseek-v4-pro"]},
        {"connection": "cerebras", "models": ["gpt-oss-120b"]},
        {"connection": "anthropic", "models": ["claude-sonnet-4-20250514"]}
      ],
      "fusion": true
    }
  },
  "compression": {
    "enabled": true,
    "maxTokens": 64000,
    "algorithm": "rolling-summary",
    "keepSystemPrompt": true
  },
  "circuitBreaker": {
    "threshold": 3,
    "resetAfterMs": 60000,
    "halfOpenRequests": 1
  },
  "port": 20128,
  "logLevel": "info"
}
