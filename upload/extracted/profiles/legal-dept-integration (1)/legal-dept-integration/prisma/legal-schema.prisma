// legal-schema.prisma
// Legal department models — APPEND to main prisma/schema.prisma

// ─── MAIN ARCHIVE MODEL ──────────────────────────────────────────────

model LegalAssessment {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Core content
  shortTitle        String
  fullResult        String    @db.Text
  confidence        String    @default("medium")  // low | medium | high

  // Document type
  documentType      String    // NDA | MSA | SLA | TZ | analysis | risk_map | red_flag_review | template_draft
  status            String    @default("drafted")
  // Statuses:
  //   drafted | published | under-lawyer-review | signed |
  //   verified-clean | rewrite | dispute | superseded

  verificationDate  DateTime?
  supersededById    Int?

  // Context (mandatory)
  jurisdiction      String    // BY | RU | EU | US (own)
  businessForm      String    // ooo | ip | selfemployed (own)

  // Counterparty context (optional — null for one-sided analyses)
  counterpartyJurisdiction String?
  counterpartyForm  String?

  // Risk
  riskLevel         String    @default("medium")  // low | medium | high | critical

  // Archive references
  archiveMessageId  Int?
  archiveChannelId  BigInt?

  // Optional links
  clientId          Int?
  projectId         Int?

  // Relations
  verifications     LegalAssessmentVerification[]
  linkedDocuments   LegalDocument[]

  @@index([status])
  @@index([documentType])
  @@index([createdAt])
  @@index([verificationDate])
  @@index([jurisdiction])
  @@index([riskLevel])
  @@index([clientId])
  @@index([projectId])
  @@map("legal_assessments")
}

// ─── VERIFICATION MODEL ──────────────────────────────────────────────

model LegalAssessmentVerification {
  id                       Int      @id @default(autoincrement())
  assessmentId             Int

  outcome                  String   // clean | rewrite | dispute
  rewriteWasPredictable    Boolean? // если outcome=rewrite — мог ли быть предусмотрен?
  disputeNature            String?  // если outcome=dispute — характер
  notes                    String?  @db.Text
  verifiedAt               DateTime @default(now())

  assessment               LegalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([verifiedAt])
  @@map("legal_assessment_verifications")
}

// ─── MONTHLY REVIEW MODEL ────────────────────────────────────────────

model LegalMonthlyReview {
  id                       Int       @id @default(autoincrement())
  periodStart              DateTime
  periodEnd                DateTime

  totalAssessments         Int       @default(0)
  cleanSignings            Int       @default(0)
  rewriteCount             Int       @default(0)
  disputeCount             Int       @default(0)
  predictableRewritesCount Int       @default(0)

  pctCleanSignings         Float?    // main metric
  pctPredictableMissed     Float?    // methodology gap metric

  errorPatterns            String?   @db.Text  // JSON clustered errors
  improvements             String?   @db.Text

  // Archive references
  archiveMessageId         Int?
  archiveChannelId         BigInt?

  createdAt                DateTime  @default(now())

  @@index([periodStart])
  @@map("legal_monthly_reviews")
}

// ─── CONTRACT TEMPLATE MODEL ─────────────────────────────────────────
// Reusable templates: NDA, MSA, SLA, TZ for different jurisdictions

model ContractTemplate {
  id                Int       @id @default(autoincrement())
  documentType      String    // NDA | MSA | SLA | TZ
  jurisdiction      String    // BY | RU | EU | US
  businessForm      String?   // ooo | ip | selfemployed (или null если универсальный)
  name              String    // e.g., "BY ООО MSA для услуг разработки"
  version           String    @default("1.0")
  status            String    @default("active")  // active | deprecated | draft

  templateBody      String    @db.Text  // markdown template with placeholders
  placeholders      String?   @db.Text  // JSON description of placeholders

  notes             String?   @db.Text
  lastUpdated       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([documentType])
  @@index([jurisdiction])
  @@index([status])
  @@map("contract_templates")
}

// ─── LEGAL DOCUMENT MODEL ────────────────────────────────────────────
// Concrete document instances created from templates or from scratch

model LegalDocument {
  id                Int       @id @default(autoincrement())
  assessmentId      Int?      // если документ был создан в рамках assessment

  documentType      String    // NDA | MSA | SLA | TZ | other
  name              String    // human-readable name
  version           String    @default("1.0")
  status            String    @default("draft")  // draft | review | sent | signed | superseded

  parties           String    @db.Text  // JSON: array of {name, jurisdiction, form, role}
  jurisdiction      String
  applicableLaw     String?
  forum             String?

  body              String    @db.Text  // full text
  fileUrl           String?   // если хранится отдельно

  // Signatures tracking
  signedDate        DateTime?
  signedByOwner     Boolean   @default(false)
  signedByCounterparty Boolean @default(false)

  // Archive
  archiveMessageId  Int?
  archiveChannelId  BigInt?
  archiveDocumentId String?   // Telegram file_id for document

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  assessment        LegalAssessment? @relation(fields: [assessmentId], references: [id])

  @@index([assessmentId])
  @@index([documentType])
  @@index([status])
  @@index([signedDate])
  @@map("legal_documents")
}
