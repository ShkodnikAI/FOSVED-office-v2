// Smoke-test F-1.2: verify /remind parsing conditions
// Evaluates the EXACT same conditions as in the production code

let result = SmokeF12()
respond(result)

pattern SmokeF12() -> String {
  let daily_ok = "/remind daily 09:00 проверка"
  let once_ok  = "/remind once 2026-07-25 09:00 проверка"
  let weekly_ok = "/remind weekly mon 09:00 проверка"
  let yearly_ok = "/remind yearly 03-15 09:00 проверка"

  let daily_bad  = "/remind daily 0900 проверка"
  let weekly_bad = "/remind weekly xyz 09:00 проверка"
  let once_bad   = "/remind once 2026-07-25 0900 проверка"

  // A.1: len(text) > 20.0 and substring(text, 16.0, 17.0) == ":"
  let a1_pos = len(daily_ok) > 20.0 and substring(daily_ok, 16.0, 17.0) == ":"
  let a1_neg = len(daily_bad) > 20.0 and substring(daily_bad, 16.0, 17.0) == ":"

  // A.2: len(text) > 29.0 and substring(text, 26.0, 27.0) == ":"
  let a2_pos = len(once_ok) > 29.0 and substring(once_ok, 26.0, 27.0) == ":"
  let a2_neg = len(once_bad) > 29.0 and substring(once_bad, 26.0, 27.0) == ":"

  // A.3: valid_day and len(text) > 25.0 and substring(text, 21.0, 22.0) == ":"
  let day_part_ok = substring(weekly_ok, 15.0, 18.0)
  let valid_day_ok = (day_part_ok == "mon" or day_part_ok == "tue" or day_part_ok == "wed" or day_part_ok == "thu" or day_part_ok == "fri" or day_part_ok == "sat" or day_part_ok == "sun")
  let a3_pos = valid_day_ok and len(weekly_ok) > 25.0 and substring(weekly_ok, 21.0, 22.0) == ":"
  let day_part_bad = substring(weekly_bad, 15.0, 18.0)
  let valid_day_bad = (day_part_bad == "mon" or day_part_bad == "tue" or day_part_bad == "wed" or day_part_bad == "thu" or day_part_bad == "fri" or day_part_bad == "sat" or day_part_bad == "sun")
  let a3_neg = valid_day_bad and len(weekly_bad) > 25.0 and substring(weekly_bad, 21.0, 22.0) == ":"

  // yearly: len(text) > 27.0 and substring(text, 17.0, 18.0) == "-"
  let yearly_pos = len(yearly_ok) > 27.0 and substring(yearly_ok, 17.0, 18.0) == "-"

  // Extraction
  let daily_fire = substring(daily_ok, 14.0, 19.0)
  let daily_rem  = substring(daily_ok, 20.0, len(daily_ok))
  let once_date  = substring(once_ok, 13.0, 23.0)
  let once_fire  = substring(once_ok, 24.0, 29.0)
  let once_rem   = substring(once_ok, 30.0, len(once_ok))
  let weekly_fire = substring(weekly_ok, 19.0, 24.0)
  let weekly_rem  = substring(weekly_ok, 25.0, len(weekly_ok))
  let yearly_md  = substring(yearly_ok, 15.0, 20.0)
  let yearly_fire = substring(yearly_ok, 21.0, 26.0)
  let yearly_rem  = substring(yearly_ok, 27.0, len(yearly_ok))

  let report = "== Conditions ==\n"
  let report = report + "A.1 daily pos:  " + to_string(a1_pos) + "\n"
  let report = report + "A.1 daily neg:  " + to_string(a1_neg) + "\n"
  let report = report + "A.2 once pos:   " + to_string(a2_pos) + "\n"
  let report = report + "A.2 once neg:   " + to_string(a2_neg) + "\n"
  let report = report + "A.3 weekly pos: " + to_string(a3_pos) + "\n"
  let report = report + "A.3 weekly neg: " + to_string(a3_neg) + "\n"
  let report = report + "yearly control: " + to_string(yearly_pos) + "\n"
  let report = report + "== Extraction ==\n"
  let report = report + "daily fire=" + daily_fire + " rem=" + daily_rem + "\n"
  let report = report + "once date=" + once_date + " fire=" + once_fire + " rem=" + once_rem + "\n"
  let report = report + "weekly fire=" + weekly_fire + " rem=" + weekly_rem + "\n"
  let report = report + "yearly md=" + yearly_md + " fire=" + yearly_fire + " rem=" + yearly_rem + "\n"

  return report
}
