// ============================================================
// NARAD #10 доп.: Интерактивный Mini App — глубина, Red Team, архив
// Файл: dept/miniapp.mlog
// Импортируется в app.mlog через: import ./dept/miniapp
// ============================================================


// --- Таблица для Mini App ответов ---

pattern InitMiniAppTables() {
  db_execute("CREATE TABLE IF NOT EXISTS miniapp_responses (id TEXT PRIMARY KEY, chat_id TEXT NOT NULL, dept TEXT NOT NULL, title TEXT, raw_text TEXT NOT NULL, html TEXT, depth INTEGER DEFAULT 2, parent_id TEXT, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)")
  db_execute("CREATE TABLE IF NOT EXISTS watchlist (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT NOT NULL, title TEXT NOT NULL, dept TEXT, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)")
}


// --- Парсер JSON-строки (для web_app_data.data) ---

pattern ExtractJsonString(json_str: String, key: String) -> String {
  let search = "\"" + key + "\":\""
  let pos = index_of(json_str, search)
  if pos < 0.0 {
    return ""
  }
  let start = pos + len(search)
  let end_pos = index_of(json_str, "\"", start)
  if end_pos < 0.0 {
    return ""
  }
  return substring(json_str, start, end_pos)
}


// --- Конфигурация глубины анализа ---

pattern GetDepthInstruction(depth: Float) -> String {
  if depth == 1.0 {
    return "Otvet' v 2-3 sloyah. Bystraya ocenka. Samoe glavnoe."
  }
  if depth == 3.0 {
    return "Glubokoe preparirovanie. 8-10 sloev. ACH minimum 5 gipotez. Premortem. Chislovye ocenki. Vse metody SPD."
  }
  if depth == 4.0 {
    return "Polnoe preparirovanie + Red Team. 12+ sloev. ACH, premortem, Kantilionovskij analiz, narativ vs potoki, source triangulation. Posle osnovnogo analiza — sam sebe Red Team: najdi slepye pyatna i kontrargumenty."
  }
  // depth == 2 — стандартный
  return "Otvet' v 5-7 sloyah. Standartnyj analiz."
}


pattern GetDepthLabel(depth: Float) -> String {
  if depth == 1.0 { return "Bystraya ocenka" }
  if depth == 3.0 { return "Glubokoe preparirovanie" }
  if depth == 4.0 { return "Polnoe preparirovanie + Red Team" }
  return "Standartnyj analiz"
}


pattern GetDepthPercent(depth: Float) -> String {
  if depth == 1.0 { return "25" }
  if depth == 3.0 { return "75" }
  if depth == 4.0 { return "100" }
  return "50"
}


// --- Генерация doc_id ---

pattern GenerateDocId(dept: String) -> String {
  let ts = to_string(now())
  return dept + "-" + ts
}


// --- Генерация HTML для Mini App ---

pattern RenderMiniAppHtml(content: String, dept: String, title: String, depth: Float, doc_id: String) -> String {
  let depth_label = GetDepthLabel(depth)
  let depth_percent = GetDepthPercent(depth)

  // Экранируем кавычки в контенте для HTML
  let safe_content = replace(content, "&", "&amp;")
  safe_content = replace(safe_content, "<", "&lt;")
  safe_content = replace(safe_content, ">", "&gt;")

  let safe_title = replace(title, "&", "&amp;")
  safe_title = replace(safe_title, "<", "&lt;")
  safe_title = replace(safe_title, ">", "&gt;")

  let html = "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>"
  html = html + "*{margin:0;padding:0;box-sizing:border-box}"
  html = html + "body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;background:#1a1a2e;color:#fff;padding:16px;padding-bottom:120px}"
  html = html + ".header{margin-bottom:16px}"
  html = html + ".dept-badge{display:inline-block;background:rgba(255,255,255,0.1);padding:4px 10px;border-radius:12px;font-size:11px;margin-bottom:8px}"
  html = html + ".title{font-size:18px;font-weight:600;line-height:1.3}"
  html = html + ".depth-indicator{display:flex;align-items:center;gap:8px;margin-top:8px}"
  html = html + ".depth-bar{flex:1;height:4px;background:rgba(255,255,255,0.2);border-radius:2px}"
  html = html + ".depth-fill{height:100%;background:#fff;border-radius:2px;transition:width 0.3s}"
  html = html + ".depth-label{font-size:11px;opacity:0.7}"
  html = html + ".content{font-size:14px;line-height:1.6;white-space:pre-wrap;opacity:0.95}"
  html = html + ".action-bar{position:fixed;bottom:0;left:0;right:0;display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;padding:12px 16px;background:#fff;border-top:1px solid #e2e8f0}"
  html = html + ".action-btn{padding:10px 6px;border:1px solid #e2e8f0;border-radius:8px;background:#fff;font-size:11px;cursor:pointer;text-align:center;color:#1a1a2e}"
  html = html + ".action-btn:active{background:#f1f5f9}"
  html = html + ".action-btn.primary{background:#1a1a2e;color:#fff;border-color:#1a1a2e}"
  html = html + ".action-btn.danger{background:#fee2e2;color:#dc2626;border-color:#fecaca}"
  html = html + "</style></head><body>"
  html = html + "<div class=\"header\">"
  html = html + "<span class=\"dept-badge\">" + dept + "</span>"
  html = html + "<div class=\"title\">" + safe_title + "</div>"
  html = html + "<div class=\"depth-indicator\">"
  html = html + "<div class=\"depth-bar\"><div class=\"depth-fill\" style=\"width:" + depth_percent + "%\"></div></div>"
  html = html + "<span class=\"depth-label\">" + depth_label + "</span>"
  html = html + "</div></div>"
  html = html + "<div class=\"content\">" + safe_content + "</div>"
  html = html + "<div class=\"action-bar\">"
  html = html + "<button class=\"action-btn primary\" onclick=\"deeperAnalysis()\">Uglubit'</button>"
  html = html + "<button class=\"action-btn danger\" onclick=\"redTeam()\">Red Team</button>"
  html = html + "<button class=\"action-btn\" onclick=\"addToWatch()\">Nablyudat'</button>"
  html = html + "<button class=\"action-btn\" onclick=\"archiveReport()\">V arkhiv</button>"
  html = html + "<button class=\"action-btn\" onclick=\"addNote()\">Zamechaniya</button>"
  html = html + "<button class=\"action-btn\" onclick=\"copyText()\">Kopirovat'</button>"
  html = html + "</div>"
  html = html + "<script>"
  html = html + "var tg=window.Telegram.WebApp;var docId='" + doc_id + "';"
  html = html + "function deeperAnalysis(){tg.sendData(JSON.stringify({action:'deepen',doc_id:docId}));tg.close()}"
  html = html + "function redTeam(){tg.sendData(JSON.stringify({action:'redteam',doc_id:docId}));tg.close()}"
  html = html + "function addToWatch(){tg.sendData(JSON.stringify({action:'watch',doc_id:docId}));tg.close()}"
  html = html + "function archiveReport(){tg.sendData(JSON.stringify({action:'archive',doc_id:docId}));tg.close()}"
  html = html + "function addNote(){var n=prompt('Vvedite zamechanie:');if(n){tg.sendData(JSON.stringify({action:'note',doc_id:docId,text:n}));tg.close()}}"
  html = html + "function copyText(){var t=document.querySelector('.content').innerText;navigator.clipboard.writeText(t).then(function(){tg.showAlert('Skopirovano!')})}"
  html = html + "tg.expand()</script></body></html>"

  return html
}


// --- Отправка Mini App через Telegram API ---

pattern SendMiniApp(chat_id: String, html: String, doc_id: String, title: String) {
  // Сохраняем HTML для отдачи по GET /miniapp/:id
  // (сerve route в app.mlog)
  kv_set("miniapp_html_" + doc_id, html)
  kv_set("miniapp_title_" + doc_id, title)

  let token = env("TELEGRAM_BOT_TOKEN")
  // Формируем URL для WebApp (нужен HTTPS — настраивается через reverse proxy)
  let base_url = env("MINIAPP_BASE_URL")
  if len(trim(base_url)) == 0.0 {
    // Фоллбэк: отправляем как обычное сообщение с HTML
    send_message(chat_id, title + "\n\n[Mini App trebuet HTTPS dlya polnoj funkcii]")
    return
  }

  let webapp_url = base_url + "/miniapp?id=" + doc_id
  let api_url = "https://api.telegram.org/bot" + token + "/sendMessage"

  // Экранируем title для JSON
  let safe_title = replace(title, "\"", "\\\"")
  let safe_url = replace(webapp_url, "\"", "\\\"")
  let body = "{\"chat_id\":\"" + chat_id + "\",\"text\":\"" + safe_title + "\",\"reply_markup\":{\"inline_keyboard\":[[{\"text\":\"Otkryt analiz\",\"web_app\":{\"url\":\"" + safe_url + "\"}}]]}}"

  let _ = http_post(api_url, body, "application/json")
}


// --- Сохранение ответа и отправка Mini App ---

pattern SaveAndSendMiniApp(chat_id: String, dept: String, title: String, reply: String, depth: Float, parent_id: String) -> String {
  let doc_id = GenerateDocId(dept)
  let html = RenderMiniAppHtml(reply, dept, title, depth, doc_id)

  // Сохраняем в БД
  query("INSERT INTO miniapp_responses (id, chat_id, dept, title, raw_text, html, depth, parent_id) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", [doc_id, chat_id, dept, title, reply, html, to_string(depth), parent_id])

  // Отправляем
  SendMiniApp(chat_id, html, doc_id, title)

  return doc_id
}


// --- Обработка callback от Mini App (web_app_data) ---

pattern HandleMiniAppAction(action: String, doc_id: String, chat_id: String, payload: String) {
  let rows = query("SELECT dept, title, raw_text, depth FROM miniapp_responses WHERE id = ?", [doc_id])
  let row_dept = ""
  let row_title = ""
  let row_text = ""
  let row_depth = 2.0

  each row in rows {
    row_dept = row.dept
    row_title = row.title
    row_text = row.raw_text
    if type_of(row.depth) == "Float" {
      row_depth = row.depth
    }
  }

  if len(row_dept) == 0.0 {
    send_message(chat_id, "Dokument ne najden: " + doc_id)
    return
  }

  if action == "deepen" {
    // Углубляем: уровень + 1
    let new_depth = row_depth + 1.0
    if new_depth > 4.0 {
      new_depth = 4.0
    }
    let depth_instr = GetDepthInstruction(new_depth)
    let deeper_prompt = "Predydushchij analiz byl poverkhnostnym. Uglubi ego: dobav' bolshe sloev, konkretnyh faktov, chislovyh ocenok. Ispol'zuj ACH (minimum 5 gipotez), premortem, Kantilionovskij analiz gde primenimo. \n\nGlubina analiza: " + GetDepthLabel(new_depth) + "\n\nPredydushchij analiz:\n\n" + row_text
    let context = BuildContext(row_dept, row_title, chat_id)
    let provider = trim(read_file("config/priority_provider.txt"))
    let model = trim(read_file("config/priority_model.txt"))
    let api_key = GetApiKey(provider)
    let deeper_reply = call_claude(api_key, model, context + "\n\n" + depth_instr, deeper_prompt)
    let _ = SaveAndSendMiniApp(chat_id, row_dept, row_title + " (uglublenie)", deeper_reply, new_depth, doc_id)
    return
  }

  if action == "redteam" {
    let rt_prompt = "Ty — krasnaya komanda. Najdi slepye pyatna, oshibki, neproverennye dopusheniya v sleduyushchem analize. Predlozhi kontrargumenty. Oceni chto upushcheno. Ne soglashaysya — ischi slabosti.\n\n" + row_text
    let context = BuildContext(row_dept, row_title, chat_id)
    let provider = trim(read_file("config/priority_provider.txt"))
    let model = trim(read_file("config/priority_model.txt"))
    let api_key = GetApiKey(provider)
    let rt_reply = call_claude(api_key, model, context, rt_prompt)
    let _ = SaveAndSendMiniApp(chat_id, row_dept, "Red Team: " + row_title, rt_reply, 4.0, doc_id)
    return
  }

  if action == "watch" {
    query("INSERT INTO watchlist (chat_id, title, dept) VALUES (?, ?, ?)", [chat_id, row_title, row_dept])
    kv_set("watch:" + chat_id + ":" + row_title, "1")
    send_message(chat_id, "Tema dobavlena v nablyudenie: " + row_title)
    return
  }

  if action == "archive" {
    let archive_channel = env("TELEGRAM_ARCHIVE_CHANNEL_ID")
    if len(trim(archive_channel)) > 0.0 {
      let archive_msg = "[" + row_dept + "] " + row_title + "\n\n" + row_text
      // Обрезаем до 4000 символов для Telegram лимита
      if len(archive_msg) > 4000.0 {
        archive_msg = substring(archive_msg, 0.0, 4000.0)
      }
      let token = env("TELEGRAM_BOT_TOKEN")
      let safe_msg = replace(archive_msg, "\"", "\\\"")
      let safe_channel = replace(archive_channel, "\"", "\\\"")
      let url = "https://api.telegram.org/bot" + token + "/sendMessage"
      let body = "{\"chat_id\":\"" + safe_channel + "\",\"text\":\"" + safe_msg + "\"}"
      let _ = http_post(url, body, "application/json")
      send_message(chat_id, "Otpravleno v arkhiv")
    } else {
      send_message(chat_id, "Arhivnyj kanal ne nastroen (TELEGRAM_ARCHIVE_CHANNEL_ID)")
    }
    return
  }

  if action == "note" {
    let note_text = ExtractJsonString(payload, "text")
    if len(note_text) > 0.0 {
      query("UPDATE miniapp_responses SET raw_text = raw_text || char(10) || char(10) || '[ZAMECHANIE VLADEL''CA]: ' || ? WHERE id = ?", [note_text, doc_id])
      send_message(chat_id, "Zamechanie dobavleno")
    }
    return
  }

  send_message(chat_id, "Neizvestnoe deystvie: " + action)
}


// --- Разбор глубины из запроса (для /osp deep, /osp full) ---

pattern ParseDepthModifier(query_text: String) -> String {
  // Возвращает строку "depth|actual_query"
  let depth = 2.0
  let actual = query_text

  if starts_with(actual, "deep ") {
    depth = 3.0
    actual = substring(actual, 5.0, len(actual))
  }
  if starts_with(actual, "full ") {
    depth = 4.0
    actual = substring(actual, 5.0, len(actual))
  }

  return to_string(depth) + "|" + actual
}