// probe #499 A.4 (2): доступ к полю passed у InfographicQAResult
// и контраст тёмной темы FOSVED. Запуск: ./bin/mlog run scripts/probe499qa.mlog

pattern Probe1() -> String {
  let dark = "#16212b"
  let ink_l = "#e9edf2"
  let gold = "#c9a961"
  let g1 = svg_group([svg_rect(0.0, 0.0, 360.0, 72.0, dark, dark) +
    svg_text(18.0, 24.0, "ОТЧЁТ", 10.0, gold) +
    svg_text(18.0, 48.0, "Тема пробной карточки", 14.0, ink_l)], "translate(0.0,0.0)")
  let body = svg_group([svg_text(18.0, 20.0, "Вердикт: наблюдать", 10.0, gold) +
    svg_text(18.0, 40.0, "Тезис первый про рынок нефти", 9.0, ink_l) +
    svg_text(18.0, 56.0, "Тезис второй про запасы", 9.0, ink_l)], "translate(0.0,96.0)")
  let footer = svg_group([svg_rect(0.0, 0.0, 360.0, 30.0, dark, dark) +
    svg_text(18.0, 18.0, "FOSVED OFFICE", 7.0, gold)], "translate(0.0,474.0)")
  let svg = svg_canvas(360.0, 504.0, "0 0 360 504", [g1, body, footer])
  let qa = infographic_qa(svg)
  let s = to_string(qa)
  let verdict = "pass_field_err"
  return "TOSTRING=" + s + "\nCONTAINS_FALSE=" + to_string(contains(s, "passed: false")) + "\nSVG_HEAD=" + substring(svg, 0.0, 120.0)
}

pattern Main1(input: String) -> String {
  return Probe1()
}

flow Main {
  input: String = "" -> Main1 -> output
}
