// Наряд #424: живой пробе реестра крона — SchedulesRegistry() парсится
// реальным интерпретатором, слот collect-new на месте, размер реестра.
// Ожидание: в выводе есть 'collect-news', 'CollectNewsSlot', '0 */6 * * *'.

import dept/schedules

mlogserver {
  port: 10002
  host: "127.0.0.1"

route "/" method=GET {
  let reg = SchedulesRegistry()
  let n = to_string(length(reg))
  let has = "no"
  each entry in reg {
    if to_string(json_get(entry, "name", "")) == "collect-news" then {
      let has = "yes"
    }
  }
  return respond("200 registry=" + n + " collect-news=" + has)
}

}
