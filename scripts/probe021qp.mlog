// №425: проба URL-декодирования query-параметров mlog-021.
// Гипотеза: 0.21 декодирует значения query ('+' -> ' ', %XX -> байты,
// url_decode_fallback server.rs:55), 0.19 не декодировал -> секреты с
// '+' в URL ломают hash-сравнение auth (403) на /cron/* и /schedules/*.
mlogserver {
  port: 10011
  host: "127.0.0.1"

route "/echo" method=GET {
  let s = query_param("secret")
  return respond("200 raw=[" + s + "]")
}

route "/" method=GET {
  return respond("probe alive")
}

}
