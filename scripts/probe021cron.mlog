// №423-проба: изоляция auth-блока /cron/morning (дословно из app.mlog:2631-2640),
// но 403-ветки различимы, чтобы понять, какая именно сработала в проде.
// Побочных эффектов нет: MorningBrief/YanaSelfLearn вырезаны.

mlogserver {
  port: 10001
  host: "127.0.0.1"

route "/cron/morning" method=GET {
    let secret = redact(query_param("secret"), "all")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 empty-env") }
    if redact(secret, "hash_only") != redact(cron_secret, "hash_only") then { return respond("403 mismatch") }
    return respond("200 ok")
}

route "/" method=GET {
    return respond("probe alive")
}

}
