// Наряд #423: живой пробе новых паттернов ОСП на реальном интерпретаторе.
// Ожидания:
//   (A) OSPNeedsLiveSearch — событийные запросы → true:
//         «что происходит…» (general), «кадровые перестановки» (маркер),
//         политический домен; структурный запрос → false:
//         «структура процентных ставок» (monetary), «рынок акций» (financial).
//   (B) OSPLiveSearchBlock БЕЗ TAVILY_API_KEY → точная причина
//         «(живой поиск не выполнен: ключ Tavily не задан)» — честная
//         деградация A.3, сеть не трогается (гвард ДО http-вызова).
//   (C) Проба секции контекста: BuildOSPContext не вызывается здесь
//         (тянет :4000 и весь контур) — гвард его логики в pytest.
// Сеть наружу: не нужна (ключ пустой → TavilySearch не вызывается).

import dept/utils
import dept/osp

mlogserver {
  port: 10001
  host: "127.0.0.1"

route "/" method=GET {
  let r1 = to_string(OSPNeedsLiveSearch("что происходит с правительством", "general"))
  let r2 = to_string(OSPNeedsLiveSearch("структура процентных ставок", "monetary"))
  let r3 = to_string(OSPNeedsLiveSearch("кадровые перестановки", "general"))
  let r4 = to_string(OSPNeedsLiveSearch("рынок акций", "financial"))
  let r5 = to_string(OSPNeedsLiveSearch("переговоры НАТО", "general"))
  let r6 = to_string(OSPNeedsLiveSearch("переговоры НАТО", "geopolitical"))
  let block = OSPLiveSearchBlock("что происходит с кадровыми перестановками")
  return respond("200 needs=" + r1 + "/" + r2 + "/" + r3 + "/" + r4 + "/" + r5 + "/" + r6 + " | block=" + block)
}

}
