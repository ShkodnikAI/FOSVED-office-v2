// probe #499: живой прогон GenerateAnalysisCard на бинаре 0.30.0.
// (1) полный отчёт с структурой → PDF-карточка создаётся, тело заполнено;
// (2) короткий ответ без структуры → пустая строка, карточка не создаётся (A.3).
// Запуск:
//   rm -rf /tmp/n499card && mkdir -p /tmp/n499card/visuals && ./bin/mlog run scripts/probe499card.mlog

db { url: "sqlite:/tmp/n499card/test.db" }

import dept/utils
import dept/visual

// 0.34.0 (№799/№800): undefined-function отказывает на компиляции — dept-модуль
// зовёт шов call_python (живёт в app-слое); стаб — канонка батареи (n550v3/n556v3).
pattern call_python(module: String, function: String, args_json: String) -> String {
  return "{\"error\": \"stub\"}"
}

pattern InitDB() -> String {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS miniapp_responses (id TEXT PRIMARY KEY, dept TEXT, title TEXT, query TEXT, raw_text TEXT DEFAULT '', html TEXT, confidence TEXT, created_at TEXT DEFAULT (datetime('now')))")
  let _ = db_execute("CREATE TABLE IF NOT EXISTS visual_artifacts (id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, source_type TEXT, source_id TEXT, path TEXT, created_at TEXT DEFAULT (datetime('now')))")
  let _ = db_execute("CREATE TABLE IF NOT EXISTS audit_log (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT DEFAULT (datetime('now')), action TEXT, actor TEXT, dept TEXT, details TEXT, status TEXT)")
  return "ok"
}

pattern BuildContext(q: String, c: String, d: String) -> String {
  return ""
}

pattern RecordAssistantMessage(chat_id: String, role: String, content: String) -> String {
  return ""
}

pattern SeedAndRun() -> String {
  let _ = InitDB()
  // #521: фикстура воспроизводит прод-скрин 16.10 — сырая разметка **,
  // вердикт заголовком с текстом на следующей строке, тезисы с процентами
  // ВНЕ раздела сценариев, обрывок дисклеймера, тема 70+ символов.
  let full = "КОНТР-АНАЛИЗ · OSP-2026-10-16-GOLD-01\n\n[ФАКТ] Текущая цена золота **$4 118,42** — рост +48,7% YTD с начала года.\n[ИНТЕРПРЕТАЦИЯ] Изменение за 30 дней составляет +6,2% при волатильности 18%.\n[ФАКТ] 52-недельный диапазон $2 760,00–$4 198,50.\n\nВероятность коррекции на истории была высокой — см. эпизоды 2013 и 2021.\nАналитическая оценка для информирования решени\n\n## Вердикт\n\n**Золото остаётся в бычьем тренде**, но локально перекуплено: коррекция вероятна до конца месяца.\n\n## ВЕРОЯТНОСТИ СЦЕНАРИЕВ\n\n| Сценарий | Вероятность |\n|---|---|\n| Базовый: консолидация $4 000–4 300/oz | 55% |\n| Бычий: тест $4 600/oz | 25% |\n| Медвежий: откат к $3 600/oz | 20% |\n\nИсточники: https://reuters.com/markets и https://eia.gov/petroleum.\nПроверка прогноза: 2026-11-12 по фактическим ценам.\n"
  let long_topic = "Что у нас будет с ценой на золото до конца года — вероятности и сценарии из отчёта ОСП"
  // повторный прогон: DELETE — irreversible-синк под мостом №391, нельзя;
  // чистится сам файл tmp-БД между прогонами (в скриптах и tmp_path тестов)
  let _ = db_execute("INSERT INTO miniapp_responses (id, dept, title, query, raw_text, html, confidence, created_at) VALUES ('doc-full', 'osp', ?, 'вопрос', ?, '', '2.0', datetime('now'))", [long_topic, full])
  let _ = db_execute("INSERT INTO miniapp_responses (id, dept, title, query, raw_text, html, confidence, created_at) VALUES ('doc-short', 'osp', 'Короткий', 'вопрос', 'Да.', '', '1.0', datetime('now'))", [])
  let r1 = GenerateAnalysisCard("report", "doc-full", "555")
  let r2 = GenerateAnalysisCard("report", "doc-short", "555")
  return "R1=" + r1 + " | R2=" + r2
}

pattern Main1(input: String) -> String {
  return SeedAndRun()
}

flow Main {
  input: String = "" -> Main1 -> output
}
