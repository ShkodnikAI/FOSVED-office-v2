// ══════════════════════════════════════════════════════════════════════════
// Пример 4. МАРШРУТИЗАЦИЯ ЯНЫ: ДВА РОУТЕРА → ОДНА МЕТРИКА (§2.3 п.1, §2.6)
// Аудит Fosved Office 02.11.2026. Файл самодостаточен:
//   mlog check examples/04_yana_routing.mlog --root examples/04_yana_routing.mlog
//   mlog test  examples/04_yana_routing.mlog
// Проверено на mlog 0.38.0 (цель наряда #620) и bin/mlog 0.34.1 (прод офиса).
//
// ЧТО ПОКАЗАНО. Маршрутизация в офисе — это ДВА роутера и НОЛЬ метрик:
//   • mlog:  DetectDepartment (app.mlog:1639-1698), 37 префикс-правил,
//            единственный вызов — app.mlog:4694, хвост — http_post на
//            Python-роут /detect-dept (proxy/routes_core.py:164).
//   • python: detect_dept (proxy/core.py:802-848): фаза 1 — COMMAND_DEPT
//            (core.py:726-739, 28 команд), фаза 1.5 — обращения-имена
//            DEPT_ADDRESS (core.py:747-763, 21 имя, №404), фаза 2 —
//            взвешенные русские ключевые слова (core.py:764-800),
//            fallback — 'yana' (core.py:848).
//   • след решения пишется: app.mlog:4695 INSERT trace_log
//            details='step_0_after_detect_dept=<dept>', status='ok'.
//     Единственные читатели trace_log (dept/admin.mlog:896 и :904) фильтруют
//     status != 'ok' → ВСЕ следы маршрутизации исключены из отчётов.
//     След есть, метрики нет: «сколько запросов ушло не в тот отдел» —
//     ощущение, а не число. Это и есть главный дефект роутинга.
//   • дрейф роутеров: в Python есть /visual-image и /project, в mlog их нет;
//     в mlog есть 11 команд, которых нет в Python (/lab-watch, /lab-score,
//     /lab-recalibrate, /quickexpert, /deepexpert, /cro, /marketing-context,
//     /marketing-ideas, /issue, /ci, /docs) — они попадают в фазу 2 и решаются
//     ключевыми словами, то есть наугад.
//   • мёртвая ветка: app.mlog:4855 `if dept == "visual-image"` недостижима.
//     Причина уточнена повторной проверкой 02.11.2026 (первая версия этого
//     комментария утверждала, что Python 'visual-image' не возвращает никогда,
//     — ОПРОВЕРГНУТО): Python-роутер сортирует COMMAND_DEPT по убыванию длины
//     и требует разделителя после команды (proxy/core.py:805-806), поэтому
//     «/visual-image кот» → 'visual-image' В PYTHON. Ветка мертва потому, что
//     webhook-диспетчер берёт отдел из mlog-роутера (app.mlog:4694
//     DetectDepartment), где правила «/visual-image» НЕТ, а более раннее
//     «/visual» (app.mlog:1661) матчит префиксом → dept = "visual". Команда
//     объявлена в /help (app.mlog:2991) и молча уходит в HandleVisual.
//   • /project (core.py:737) → dept='project', а в диспетчере app.mlog
//     16 веток (4714-4896) и 'project' среди них нет → молчаливый уход в хвост.
//   • класс дефекта подтверждён историей: №376 (комментарий app.mlog:1648) —
//     /quickexpert и /deepexpert «молча уходили в Яну», пока их не дописали
//     в каскад. Исправили один случай; механизма, который ловит следующий, нет.
//   • тестов на проводку нет: test_n559v3.mlog:11 прямо фиксирует, что
//     DetectDepartment в замыкание батареи не входит.
//
// РЕШЕНИЕ. Правила обоих роутеров вынесены в таблицу routing_rule (засеяны
// из кода, см. RoutingSeedRules) — после этого «дрейф», «мёртвая ветка» и
// «молчаливый уход в Яну» становятся ЗАПРОСАМИ, а не прозой. Каждое решение
// маршрутизации — запись routing_case с вердиктом, который считает программа.
// Метрика — RoutingMetric: n, misroutes, silent_yana, accuracy%.
// Правка правила — только через RoutingRulePropose с выигрышем на ОТЛОЖЕННОЙ
// выборке (поправка 1 решения владельца по ОСП: никакой механической правки
// без held-out-доказательства) и с карточкой kind='flag' (контракт примера 1).
// ══════════════════════════════════════════════════════════════════════════

db { url: env("DATABASE_URL") }

// Схема аддитивна (ADR-0060 офиса): CREATE TABLE IF NOT EXISTS, никаких DROP.
// ВАЖНО: таблица не заканчивается колонкой DateTime default(now()) — в
// парсере схем Metalogos такое поле может молча выпасть (проверено).
// ВАЖНО: между `import` и следующей декларацией НЕЛЬЗЯ ставить комментарии —
// парсер импорта проглатывает их как часть имени модуля (проверено).
import ./card_contract

schema routing {
  table routing_rule {
    id: Int primary_key auto_increment,
    prefix: Text,
    dept: Text,
    router: Text,
    rank: Int default("0"),
    source_ref: Text default(""),
    active: Int default("1"),
    note: Text default(""),
    created_at: DateTime default(now())
  }
  table routing_branch {
    dept: Text primary_key,
    source_ref: Text default(""),
    note: Text default("")
  }
  table routing_case {
    id: Int primary_key auto_increment,
    batch: Text default(""),
    text: Text,
    expected_dept: Text,
    routed_mlog: Text default(""),
    routed_python: Text default(""),
    matched_rule: Text default(""),
    verdict: Text default(""),
    holdout: Int default("0"),
    corrected_dept: Text nullable,
    correction_reason: Text nullable,
    card_id: Int nullable,
    note: Text default(""),
    created_at: DateTime default(now())
  }
  table routing_rule_proposal {
    id: Int primary_key auto_increment,
    prefix: Text,
    new_dept: Text,
    reason: Text default(""),
    actor: Text default(""),
    train_n: Float default("0"),
    train_before: Float default("0"),
    train_after: Float default("0"),
    hold_n: Float default("0"),
    hold_before: Float default("0"),
    hold_after: Float default("0"),
    verdict: Text default(""),
    card_id: Int nullable,
    note: Text default(""),
    created_at: DateTime default(now())
  }
  // Таблица офиса (app.mlog:4695 пишет в неё след маршрутизации). Создаётся
  // здесь только чтобы пример был самодостаточен; в проде уже существует.
  table trace_log {
    id: Int primary_key auto_increment,
    action: Text default(""),
    actor: Text default(""),
    dept: Text default(""),
    details: Text default(""),
    status: Text default(""),
    note: Text default(""),
    timestamp: DateTime default(now())
  }
}

// Порог достаточности выборки — тот же, что CardScore(min_n) в контракте
// (пример 1) и устав ОСП (n ≥ 10). Ниже порога метрика не публикуется.
pattern RoutingMinN() -> Float { return 10.0 }

pattern RoutingBeforePipe(s: String) -> String {
  let parts = split(s, "|")
  return to_string(get(parts, 0.0))
}

