// ПРОБА A2b — форма обработки результата в legal.mlog:794-800:
//   let rows = db_execute("SELECT …")   → String
//   let data = parse_json(rows)         → json_get(data, "0.total_predictable")
// Если заменить db_execute на query(), rows становится List — parse_json(List)
// это СТАТИЧЕСКАЯ ошибка, т.е. починка не сводится к поиску-замене вызова.
db { url: env("DATABASE_URL") }

pattern B1Schema() -> String {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS probe_lr (id INTEGER, cnt INTEGER)", [])
  return "ok"
}

pattern B1ProdShape() -> String {
  let rows = query("SELECT SUM(cnt) as total_predictable FROM probe_lr", [])
  let data = parse_json(rows)
  return to_string(json_get(data, "0.total_predictable", "0"))
}

test "форма прода после наивной замены db_execute→query" {
  assert_eq(B1Schema(), "ok")
  assert_eq(B1ProdShape(), "0")
}
