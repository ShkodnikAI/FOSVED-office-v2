db { url: env("DATABASE_URL") }
pattern Fmt2(x: Float) -> String { return to_string(round(x * 100.0) / 100.0) }
test "формат числа владельцу: round до 2 знаков" {
  print("MAPE=" + Fmt2(5.263157894736842) + "%")
  print("coverage=" + Fmt2(33.33333333) + "%")
  print("brier=" + Fmt2(0.1875) + "")
  assert_eq(Fmt2(5.263157894736842), "5.26")
  assert_eq(Fmt2(33.33333333), "33.33")
  assert_eq(Fmt2(0.1875), "0.19")
}
