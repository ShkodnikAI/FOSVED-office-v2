// ПРОБА A2 (ревью плана офиса, 02.11.2026) — как именно чинятся 25 прод-сайтов
// db_execute("SELECT/WITH …") и MySQL-синтаксис. Форма сайта quest.mlog:24
// (QuestCreate, вызывается из app.mlog:3355) в аудите НЕ была учтена: это не
// SELECT, а WITH-RECURSIVE + INSERT, поэтому query() к нему неприменим.
// Исполнено: bin/mlog 0.38.0 и 0.34.1, DATABASE_URL=sqlite::memory:

db { url: env("DATABASE_URL") }

pattern TryVal(x: String) -> String { return x.value }

pattern A2Schema() -> String {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS probe_cp (quest_id TEXT, step_num TEXT, step_label TEXT, status TEXT)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS probe_reviews (id INTEGER PRIMARY KEY, cnt INTEGER, created_at TEXT)", [])
  let _ = db_execute("INSERT OR REPLACE INTO probe_reviews (id, cnt, created_at) VALUES (1, 3, datetime('now','-10 days'))", [])
  let _ = db_execute("INSERT OR REPLACE INTO probe_reviews (id, cnt, created_at) VALUES (2, 4, datetime('now','-100 days'))", [])
  return "schema ok"
}

// A. ТОЧНАЯ форма прода quest.mlog:24 (CTE + INSERT через db_execute)
pattern A2CteInsert(qid: String, steps: String) -> String {
  let r = TryVal(try db_execute("WITH RECURSIVE seq(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM seq WHERE n < CAST(?2 AS INTEGER) - 1) INSERT INTO probe_cp (quest_id, step_num, step_label, status) SELECT ?1, n, 'Shag ' || CAST(n + 1 AS TEXT), 'pending' FROM seq", [qid, steps]))
  if to_string(r) == "()" then { return "REFUSED" }
  return "OK"
}

pattern A2CountCp(qid: String) -> String {
  let rows = query("SELECT COUNT(*) as cnt FROM probe_cp WHERE quest_id = ?1", [qid])
  return to_string(json_get(get(rows, 0.0), "cnt", "-1"))
}

// B. Замена, доступная на 0.34.1: while-цикл с параметризованным INSERT
pattern A2WhileInsert(qid: String, steps: String) -> String {
  let total = to_float_or(steps, 0.0)
  let mut i = 0.0
  while i < total {
    let _ = db_execute("INSERT INTO probe_cp (quest_id, step_num, step_label, status) VALUES (?1, ?2, ?3, 'pending')", [qid, to_string(i), "Shag " + to_string(i + 1.0)])
    i = i + 1.0
  }
  return "inserted=" + to_string(i)
}

// C. MySQL-диалект (legal.mlog:795: INTERVAL '90 days') через правильный query()
pattern A2IntervalMySQL() -> String {
  let r = TryVal(try query("SELECT SUM(cnt) as total FROM probe_reviews WHERE created_at >= datetime('now') - INTERVAL '90 days'", []))
  if to_string(r) == "()" then { return "REFUSED" }
  return to_string(r)
}

// D. Тот же запрос в диалекте SQLite — должен вернуть 3 (только свежая строка)
pattern A2IntervalSQLite() -> String {
  let rows = query("SELECT SUM(cnt) as total FROM probe_reviews WHERE created_at >= datetime('now','-90 days')", [])
  return to_string(json_get(get(rows, 0.0), "total", "-1"))
}

// A: quest.mlog:24 — ЕДИНСТВЕННЫЙ сайт из grep-выборки «db_execute + SELECT/WITH»,
// который НЕ сломан: db_execute отказывает только когда запрос ВОЗВРАЩАЕТ набор
// строк, а CTE+INSERT не возвращает (подробнее — probe_a2_cte.mlog).
// Поэтому прод-счётчик сломанных сайтов = 24, а не 25/26.
test "A: quest.mlog:24 (CTE+INSERT) работает — в прод-счётчик 24 он не входит" {
  assert_eq(A2Schema(), "schema ok")
  assert_eq(A2CteInsert("Q-1", "4"), "OK")
  assert_eq(A2CountCp("Q-1"), "4")
}

test "B: замена while-циклом даёт те же строки на 0.34.1-синтаксисе" {
  assert_eq(A2Schema(), "schema ok")
  assert_eq(A2WhileInsert("Q-2", "4"), "inserted=4")
  assert_eq(A2CountCp("Q-2"), "4")
}

test "C: MySQL INTERVAL не проходит и через query()" {
  assert_eq(A2Schema(), "schema ok")
  assert_eq(A2IntervalMySQL(), "REFUSED")
}

test "D: диалект SQLite возвращает данные" {
  assert_eq(A2Schema(), "schema ok")
  assert_eq(A2IntervalSQLite(), "3")
}
