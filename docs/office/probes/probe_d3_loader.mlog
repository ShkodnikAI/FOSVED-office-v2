}

// ── C. Поправка диспетчера: проверка бюджета ПОСЛЕ (добавляем только если влезет)
pattern D3CFixAfterCheck() -> String {
  let mut result = ""
  let budget = 25000.0
  let mut n = 0.0
  let s = redact(read_file_or("skills/deconstruct/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 22.0 <= budget then {
    result = result + "\n--- deconstruct ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/awareness-frame/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 25.0 <= budget then {
    result = result + "\n--- awareness-frame ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/root-cause-mapping/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 28.0 <= budget then {
    result = result + "\n--- root-cause-mapping ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/forces-and-potentials/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 29.0 <= budget then {
    result = result + "\n--- forces-and-potentials ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/strategic-maneuvers/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 29.0 <= budget then {
    result = result + "\n--- strategic-maneuvers ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/two-paths-synthesis/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 29.0 <= budget then {
    result = result + "\n--- two-paths-synthesis ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/decision-tree-forecast/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 32.0 <= budget then {
    result = result + "\n--- decision-tree-forecast ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/reflexive-impact/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 26.0 <= budget then {
    result = result + "\n--- reflexive-impact ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/calibration/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 23.0 <= budget then {
    result = result + "\n--- calibration ---\n" + s
    n = n + 1.0
  }
  let s = redact(read_file_or("skills/system-health-diagnostics/SKILL.md", ""), "all")
  if s != "" and length(result) + length(s) + 35.0 <= budget then {
    result = result + "\n--- system-health-diagnostics ---\n" + s
    n = n + 1.0
  }
  return "n=" + to_string(n) + " chars=" + to_string(length(result)) + " budget=25000"
}

// ── D. «Ядро/приложения»: каждое ядро ≤1500, одно приложение ≤9000 ───────
pattern D3DFixCoreApp(app: String) -> String {
  let core_limit = 1500.0
  let app_limit = 9000.0
  let budget = 25000.0
  let mut result = ""
  let mut n = 0.0
  let s = substring(redact(read_file_or("skills/deconstruct/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- deconstruct ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/awareness-frame/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- awareness-frame ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/root-cause-mapping/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- root-cause-mapping ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/forces-and-potentials/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- forces-and-potentials ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/strategic-maneuvers/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- strategic-maneuvers ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/two-paths-synthesis/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- two-paths-synthesis ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/decision-tree-forecast/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- decision-tree-forecast ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/reflexive-impact/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- reflexive-impact ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/calibration/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- calibration ---\n" + s
    n = n + 1.0
  }
  let s = substring(redact(read_file_or("skills/system-health-diagnostics/SKILL.md", ""), "all"), 0.0, core_limit)
  if s != "" and length(result) + length(s) <= budget then {
    result = result + "\n--- system-health-diagnostics ---\n" + s
    n = n + 1.0
  }
  let core_n = n
  let a = substring(redact(read_file_or("skills/" + app + "/SKILL.md", ""), "all"), 0.0, app_limit)
  if a != "" and length(result) + length(a) <= budget then {
    result = result + "\n--- app:" + app + " ---\n" + a
    n = n + 1.0
  }
  return "core=" + to_string(core_n) + "/10 total=" + to_string(n) + " chars=" + to_string(length(result)) + " budget=25000"
}

test "A: прод-загрузчик context.mlog:213 (бюджет 25000, проверка ДО)" {
  print("A " + D3AProdContext())
  assert_eq(contains(D3AProdContext(), "n=2 chars=29370"), true)
}

test "B: прод-загрузчик osp.mlog:833 (бюджет 12000)" {
  print("B " + D3BProdEnriched())
  assert_eq(contains(D3BProdEnriched(), "n=1 chars=15409"), true)
}

test "C: проверка бюджета ПОСЛЕ добавления всё равно режет ядро" {
  print("C " + D3CFixAfterCheck())
  assert_eq(contains(D3CFixAfterCheck(), "n=1 chars=15409"), true)
}

test "D: ядро 10×1500 + приложение 9000 — все 10 ядер и приложение в бюджете" {
  print("D " + D3DFixCoreApp("cross-asset-divergence"))
  assert_eq(contains(D3DFixCoreApp("cross-asset-divergence"), "core=10/10"), true)
  assert_eq(contains(D3DFixCoreApp("cross-asset-divergence"), "total=11 chars=24313"), true)
}
