// Fosved Office v2 — Main Application (MEGA-3)
// 14 departments + routing + memory + cron + lockdown + voice + chain + learning + audit + archive

// ── Наряд №419 (Metalogos gh#572): статус совместимости с Metalogos 0.21.0 ─────
// Прод-бинарь 0.19.0 этой декларации НЕ понимает (profile-грамматика появилась
// в 0.20.x), поэтому мост ADR-0161 (`profile legacy`) ЗДЕСЬ НЕ ОБЪЯВЛЕН — его
// добавит миграционный наряд вместе с полным Category-A контуром (ценз:
// `mlog-021 audit app.mlog` в отчёте №419 — ~430 UNTRUSTED_DECISION №327 +
// clearance-семейство + 33 деструктивных сайта под гранты). Entry-проба
// entrypoint.sh (audit-чек кандидата) держит прод на 0.19 и перережется на
// 0.21 автоматически, когда файл пройдёт аудит. Хвосты для того наряда:
// инфраструктура нативных расписаний уже здесь (dept/schedules.mlog + роуты
// /schedules/*), на 0.19 они безопасно неактивны.

// ── Миграционный наряд №421 (продолжение №419): мост ADR-0161 ────────────────
// Декларация profile legacy — часть полного Category-A контура (этот наряд):
// egress-clearance переводится в Info-события (burn-down метрика), остальные
// гейты (№327 anti-injection, гранты, SECRET_LEAK) остаются на полной силе.
// Ценз миграции: mlog-021 audit app.mlog → 0 errors (см. отчёт наряда).
// ── ОТКАТ 2026-09-24: наряд №421 добавил profile legacy НИЖЕ вопреки явному
// предупреждению наряда №419 (см. блок комментариев выше) — "прод-бинарь
// 0.19.0 этой декларации НЕ понимает". Проверено исполнением: bin/mlog
// --version → 0.19.0, grammar rev: 1. mlog run app.mlog падал с parse error
// на этой строке, офис не поднимался. Строка удалена до реального перехода
// на Metalogos 0.20.x+, когда наряд №421 сможет быть повторно применён
// корректно — вместе с обновлением bin/mlog, не раньше.
// profile legacy { egress: permissive_with_audit }

db { url: env("DATABASE_URL") }

// Наряд №419: персистность KV-стора (в нём живёт стор нативного cron —
// ключ cron_jobs). Дедуп-штампы окон №418 и задания переживают рестарт
// процесса; при полном ре-деплое бутстрап dept/schedules.mlog перерегистрирует
// реестр (идемпотентно по target). На 0.19-фолбэке декларация безвредна
// (KV API тот же).
memory { persist: "data/metalogos_kv.db" }

llm {
  // #399 A.2 (Metalogos-#757, бинарь 0.27.1): настраиваемый потолок вместо
  // апстрим-жёстких 1024 токенов (≈600–800 слов русского — каждый структурированный
  // отчёт отдела обрывался на полуслове; факт 2026-09-29: отчёт ОСП оборван,
  // «Вердикт» пуст). Значение 8192 — верхний общий знаменатель output-лимитов
  // подключённых моделей (deepseek-chat ≤8k, groq Llama ≤8k, kimi/zai/cerebras/sakana ≥8k):
  // 8192 ток. ≈ 20–25 тыс. символов русского — покрывает самый длинный протокол
  // (ОСП Deep, Эксперт: 4 слоя + 7 категорий + боевые вопросы, ЛЗ Deep Scan) с запасом.
  // Превышение не тишина: SendReport добавляет пометку «ответ обрезан» через
  // llm_last_finish_reason() (dept/miniapp.mlog). Env-переопределение: METALOGOS_LLM_MAX_TOKENS.
  // ВНИМАНИЕ: поле не понимают 0.20/0.25/0.27.0 — фолбэк-ветка entrypoint вырезает
  // его из serve-копии (sed-патч #399); граница — до вывода 0.20 из ротации (ADR-0009).
  // Грамматика 0.27.1: max_tokens идёт СРАЗУ ПОСЛЕ providers (хвост — упорядоченная цепочка).
  // #505 A.1: timeout — на провайдера, дефолт рантайма 30 с не вмещает отчёт 8192 ток.; reverse_proxy держит 300 с.
  // #505 A.2: deepseek первым — единственный провайдер модели default_model (deepseek-chat);
  // остальные не обслуживают её, поэтому при deepseek первом переход к резерву даёт результат.
  providers: [
    { alias: deepseek, provider: openai_compatible, key: env("DEEPSEEK_API_KEY"), url: "https://api.deepseek.com/v1/chat/completions" },
    { alias: kimi, provider: openai_compatible, key: env("KIMI_API_KEY"), url: "https://api.moonshot.ai/v1/chat/completions" },
    { alias: zai, provider: openai_compatible, key: env("ZAI_API_KEY"), url: "https://api.z.ai/api/paas/v4/chat/completions" },
    { alias: groq, provider: openai_compatible, key: env("GROQ_API_KEY"), url: "https://api.groq.com/openai/v1/chat/completions" },
    { alias: cerebras, provider: openai_compatible, key: env("CEREBRAS_API_KEY"), url: "https://api.cerebras.ai/v1/chat/completions" },
    { alias: sakana, provider: openai_compatible, key: env("SAKANA_API_KEY"), url: "https://api.sakana.ai/v1/chat/completions" }
  ],
  max_tokens: 8192,
  timeout: 150,
  default_model: "deepseek-chat",
  failover: auto,
  circuit_breaker: 3
}

import dept/utils
