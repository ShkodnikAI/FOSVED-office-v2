// Fosved Office v2 — Main Application (MEGA-3)
// 14 departments + routing + memory + cron + lockdown + voice + chain + learning + audit + archive

db { url: env("DATABASE_URL") }

llm {
  providers: [
    { alias: kimi, provider: openai_compatible, key: env("KIMI_API_KEY"), url: "https://api.moonshot.ai/v1/chat/completions" },
    { alias: deepseek, provider: openai_compatible, key: env("DEEPSEEK_API_KEY"), url: "https://api.deepseek.com/v1/chat/completions" },
    { alias: zai, provider: openai_compatible, key: env("ZAI_API_KEY"), url: "https://api.z.ai/api/paas/v4/chat/completions" },
    { alias: groq, provider: openai_compatible, key: env("GROQ_API_KEY"), url: "https://api.groq.com/openai/v1/chat/completions" },
    { alias: cerebras, provider: openai_compatible, key: env("CEREBRAS_API_KEY"), url: "https://api.cerebras.ai/v1/chat/completions" }
  ],
  default_model: "deepseek-chat",
  failover: auto,
  circuit_breaker: 3
}

