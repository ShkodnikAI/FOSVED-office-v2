// ============================================================
// MEMORY — SQLite via db_execute() in InitDB()
// ============================================================

// ============================================================
// INIT DATABASE — all 22 tables
// ============================================================

// #556: шов LLM-вызовов навыков ЛЗ — dept/lz.mlog вызывает LZLlm,
// определение живёт в app-слое (замыкание прода), чтобы батарея v3 могла
// подставить стаб (импортированные определения сильнее локальных, нативы
// не перекрываются — проверено пробой bin/mlog перед нарядом).
// Промпты менялись ТОЛЬКО в части формата ответа (A.2/A.3), смысловая
// часть не тронута (запрет наряда).
pattern LZLlm(prompt: String) -> String {
  return to_string(TryVal(try call_llm(prompt)))
}

pattern InitDB() -> String {
  // Dialog & Memory
  db_execute("CREATE TABLE IF NOT EXISTS dialog_history (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, role TEXT, dept TEXT, content TEXT, created_at TEXT DEFAULT (datetime('now')))")
  // №587 A.1: оценки владельца «+»/«−» к конкретным ответам/отчётам
  db_execute("CREATE TABLE IF NOT EXISTS reply_ratings (id INTEGER PRIMARY KEY AUTOINCREMENT, dept TEXT, kind TEXT DEFAULT 'reply', ref TEXT DEFAULT '', chat_id TEXT, message_id INTEGER, vote INTEGER, comment TEXT, prompt_message_id INTEGER, created_at TEXT DEFAULT (datetime('now')), voted_at TEXT)")
  // №588 A.3: resume-маркеры ночного цикла (NightPhaseDone/Mark/Begin, dept/scheduler.mlog)
  db_execute("CREATE TABLE IF NOT EXISTS night_run_state (day TEXT PRIMARY KEY, phases TEXT NOT NULL DEFAULT '', updated_at TEXT)")
  // №597 A.1: реестр сообщённого (proxy/reported.py; DDL зеркалится в Python
  // init_db — идемпотентно с обеих сторон; запись — только после успешной
  // отправки владельцу)
  db_execute("CREATE TABLE IF NOT EXISTS reported_items (id INTEGER PRIMARY KEY AUTOINCREMENT, channel TEXT NOT NULL, item_key TEXT NOT NULL, first_reported_at TEXT DEFAULT (datetime('now')), last_reported_at TEXT DEFAULT (datetime('now')), times INTEGER NOT NULL DEFAULT 1, last_value TEXT, UNIQUE(channel, item_key))")
  db_execute("CREATE TABLE IF NOT EXISTS adapt_corrections (id INTEGER PRIMARY KEY AUTOINCREMENT, dept TEXT, original_query TEXT, original_response TEXT, correction TEXT, corr_type TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS error_patterns (id INTEGER PRIMARY KEY AUTOINCREMENT, dept TEXT, error_type TEXT, query_text TEXT, correction TEXT, created_at TEXT DEFAULT (datetime('now')))")

  // Reports
  db_execute("CREATE TABLE IF NOT EXISTS miniapp_responses (id TEXT PRIMARY KEY, dept TEXT, title TEXT, query TEXT, raw_text TEXT, html TEXT, confidence TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS miniapp_notes (id INTEGER PRIMARY KEY AUTOINCREMENT, doc_id TEXT, note_text TEXT, created_at TEXT DEFAULT (datetime('now')))")
  // #485 A.3: итог ночного цикла (NightSlot пишет с маркером scan_data='night-slot';
  // DDL зеркалит proxy/core.py — таблица должна существовать и до старта Flask)
  db_execute("CREATE TABLE IF NOT EXISTS admin_night_reports (id INTEGER PRIMARY KEY AUTOINCREMENT, scan_data TEXT, review_data TEXT, health_score INTEGER, findings_count INTEGER, created_at TEXT DEFAULT (datetime('now')))")

  // Metrics
  db_execute("CREATE TABLE IF NOT EXISTS dept_metrics (id INTEGER PRIMARY KEY AUTOINCREMENT, dept TEXT, metric_name TEXT, metric_value TEXT, period TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS token_usage (id INTEGER PRIMARY KEY AUTOINCREMENT, dept TEXT, provider TEXT, model TEXT, input_tokens TEXT, output_tokens TEXT, cost_usd TEXT, request_type TEXT, created_at TEXT DEFAULT (datetime('now')))")
  // TEAM-3 #482 A.1: доска находок команды (публикация/подписка вместо затираемой ячейки inject:<dept>).
  // ttl хранится как вычисленный expires_at (datetime('now','+N hours') при вставке);
  // delivered — механизм one-shot чтения инъекций владельца (перевод InjectContext).
  db_execute("CREATE TABLE IF NOT EXISTS team_board (id INTEGER PRIMARY KEY AUTOINCREMENT, from_dept TEXT NOT NULL, kind TEXT NOT NULL, topic TEXT NOT NULL, tags TEXT DEFAULT '[]', payload TEXT DEFAULT '', sources TEXT DEFAULT '', severity TEXT DEFAULT '', delivered INTEGER DEFAULT 0, created_at TEXT DEFAULT (datetime('now')), expires_at TEXT)")

  // Security
  db_execute("CREATE TABLE IF NOT EXISTS audit_log (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT DEFAULT (datetime('now')), action TEXT, actor TEXT, dept TEXT, details TEXT, status TEXT)")
  // FO-007: trace_log — отладочные чекпоинты (audit_log — только действия)
  db_execute("CREATE TABLE IF NOT EXISTS trace_log (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp TEXT DEFAULT (datetime('now')), action TEXT, actor TEXT, dept TEXT, details TEXT, status TEXT)")

  // DevOps
  db_execute("CREATE TABLE IF NOT EXISTS narads (id TEXT PRIMARY KEY, title TEXT, description TEXT, requested_by TEXT, changed_files TEXT, risk_level TEXT, status TEXT, created_at TEXT DEFAULT (datetime('now')), approved_at TEXT, executed_at TEXT, result TEXT)")
  // FO-046 (#161): нарядный контур 2.0 — расширение модели наряда.
  // dept/priority/plan/acceptance/test_status/test_log/report/dispatch_id/
  // rework_count/in_work_at/testing_at. ALTER идемпотентен (try): колонки
  // добираются к живой БД при старте. Логика — в dept/narad.mlog.
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN dept TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN priority TEXT DEFAULT 'normal'"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN plan TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN acceptance TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN test_status TEXT DEFAULT 'none'"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN test_log TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN report TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN dispatch_id TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN rework_count INTEGER DEFAULT 0"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN in_work_at TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:narads", 3600.0, "once"), "ALTER TABLE narads ADD COLUMN testing_at TEXT"))
  // FO-049 (#161): метрики нарядной дисциплины — строка на каждый закрытый наряд
  db_execute("CREATE TABLE IF NOT EXISTS narad_stats (id INTEGER PRIMARY KEY AUTOINCREMENT, narad_id TEXT, dept TEXT, first_try INTEGER DEFAULT 0, rework_count INTEGER DEFAULT 0, lead_seconds INTEGER, accepted_by TEXT, created_at TEXT DEFAULT (datetime('now')))")
  let _ = TryVal(try db_execute("CREATE INDEX IF NOT EXISTS idx_narad_stats_created ON narad_stats(created_at)"))
  db_execute("CREATE TABLE IF NOT EXISTS debriefs (id INTEGER PRIMARY KEY AUTOINCREMENT, dept TEXT, period TEXT, content TEXT, actions_taken TEXT, created_at TEXT DEFAULT (datetime('now')))")
  // SHOP (диспатч #172): сравнительный анализ товаров — модель данных.
  // Базис schema.org/Offer: price/old_price/card_price, availability (in_stock),
  // shippingDetails (delivery_*), hasMerchantReturnPolicy (return_ok),
  // warranty_months, seller. Цены — BYN, нормализация на сборщиках SHOP-3
  // (proxy/shop_engine.py: parse_price/to_byn). FK не ставим — стиль narads.
  db_execute("CREATE TABLE IF NOT EXISTS shop_products (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, query_text TEXT, brand TEXT, model TEXT, gtin TEXT, category TEXT, specs_json TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS shop_sellers (id INTEGER PRIMARY KEY AUTOINCREMENT, platform TEXT NOT NULL, name TEXT, inn TEXT, rating REAL, deals_count INTEGER, seller_years REAL, official INTEGER, return_ok INTEGER, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS shop_offers (id INTEGER PRIMARY KEY AUTOINCREMENT, product_id INTEGER NOT NULL, platform TEXT NOT NULL, platform_code TEXT, title TEXT, variant_json TEXT, url TEXT NOT NULL, seller_id INTEGER, price_byn REAL, old_price_byn REAL, card_price_byn REAL, in_stock INTEGER, delivery_days INTEGER, delivery_cost_byn REAL, installment_ok INTEGER, pay_on_delivery INTEGER, warranty_months INTEGER, specs_json TEXT, rating REAL, reviews_count INTEGER, reviews_fresh_days INTEGER, unit_label TEXT, unit_price_byn REAL, image_url TEXT, fetched_at TEXT DEFAULT (datetime('now')), UNIQUE(platform, platform_code))")
  db_execute("CREATE TABLE IF NOT EXISTS shop_price_history (id INTEGER PRIMARY KEY AUTOINCREMENT, offer_id INTEGER NOT NULL, price_byn REAL NOT NULL, old_price_byn REAL, in_stock INTEGER, ts TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE INDEX IF NOT EXISTS idx_shop_ph_offer_ts ON shop_price_history(offer_id, ts)")
  db_execute("CREATE TABLE IF NOT EXISTS shop_watches (id INTEGER PRIMARY KEY AUTOINCREMENT, product_id INTEGER NOT NULL, target_price_byn REAL, discount_pct REAL, alert_in_stock INTEGER DEFAULT 0, status TEXT DEFAULT 'active', last_checked_at TEXT, last_alert_json TEXT, created_at TEXT DEFAULT (datetime('now')))")
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:shop_watches", 3600.0, "once"), "ALTER TABLE shop_watches ADD COLUMN last_alert_json TEXT"))
  db_execute("CREATE TABLE IF NOT EXISTS shop_dossiers (id INTEGER PRIMARY KEY AUTOINCREMENT, product_id INTEGER NOT NULL, format TEXT NOT NULL, payload TEXT, snapshot_json TEXT NOT NULL, created_at TEXT DEFAULT (datetime('now')))")
  // Наряд #329: URL фото товара (WB basket-хост, вычисляется в SHOP-3).
  // В свежей схеме — колонка выше в CREATE shop_offers; к живой БД
  // добирается идемпотентным ALTER (try), паттерн db:alter:<table>.
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:shop_offers", 3600.0, "once"), "ALTER TABLE shop_offers ADD COLUMN image_url TEXT"))
  // Наряд #437 A.3: название оффера для проверки соответствия выдачи
  // запросу («найдено не то: <категория> вместо <предмет>») — колонка
  // в свежей схеме выше, к живой БД — тот же идемпотентный ALTER.
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:shop_offers", 3600.0, "once"), "ALTER TABLE shop_offers ADD COLUMN title TEXT"))

  // Admin
  db_execute("CREATE TABLE IF NOT EXISTS admin_reports (id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT, content TEXT, duration_sec TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS admin_findings (id INTEGER PRIMARY KEY AUTOINCREMENT, severity TEXT, category TEXT, file TEXT, issue TEXT, fix TEXT, status TEXT DEFAULT 'open', created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS admin_proposals (id INTEGER PRIMARY KEY AUTOINCREMENT, content TEXT, status TEXT, narad_id TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS knowledge_graph (id INTEGER PRIMARY KEY AUTOINCREMENT, node_type TEXT, node_name TEXT, file_path TEXT, line_start TEXT, line_end TEXT, description TEXT, updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS knowledge_edges (id INTEGER PRIMARY KEY AUTOINCREMENT, source_name TEXT, target_name TEXT, edge_type TEXT, file_path TEXT, updated_at TEXT DEFAULT (datetime('now')))")

  // Archive
  db_execute("CREATE TABLE IF NOT EXISTS channel_archive (id INTEGER PRIMARY KEY AUTOINCREMENT, doc_id TEXT, dept TEXT, title TEXT, channel_message_id TEXT, archived_at TEXT DEFAULT (datetime('now')))")

  // Factory
  db_execute("CREATE TABLE IF NOT EXISTS factory_orders (id TEXT PRIMARY KEY, client_name TEXT, status TEXT, requirements TEXT, departments TEXT, branding TEXT, llm_config TEXT, repo_url TEXT, render_url TEXT, created_at TEXT DEFAULT (datetime('now')), completed_at TEXT)")

  // LZ
  db_execute("CREATE TABLE IF NOT EXISTS lz_telegram_channels (id INTEGER PRIMARY KEY AUTOINCREMENT, channel_id TEXT, channel_name TEXT, category TEXT, added_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS lz_github_updates (id INTEGER PRIMARY KEY AUTOINCREMENT, update_id TEXT UNIQUE, channel_id TEXT, channel_name TEXT, text TEXT, date TEXT, scanned_at TEXT DEFAULT (datetime('now')))")
  // MON-1 (#171): посты Telegram-каналов от монитор-процесса (telegram_monitor.py)
  // НЕ переиспользуем lz_github_updates — там GitHub-релизы (lz_github.py, channel_id="github")
  db_execute("CREATE TABLE IF NOT EXISTS lz_channel_posts (id INTEGER PRIMARY KEY AUTOINCREMENT, channel_id TEXT NOT NULL, message_id TEXT NOT NULL, channel_name TEXT, text TEXT, media_type TEXT, date TEXT, scanned_at TEXT DEFAULT (datetime('now')), UNIQUE(channel_id, message_id))")
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:lz_channel_posts", 3600.0, "once"), "ALTER TABLE lz_channel_posts ADD COLUMN stats_json TEXT"))
  // #252: миграция lz_telegram_posts → lz_github_updates. Таблица хранила GitHub-релизы
  // из lz_github.py (channel_id="github") — имя врало. Блок идемпотентен: пока старая
  // таблица существует в sqlite_master — разовый ALTER-апгрейд + копия данных
  // (INSERT OR IGNORE гасит дубли по UNIQUE update_id) + DROP; после первого прогона
  // — no-op. Ретро-читателей у старого имени нет (grep по дереву, #252) — VIEW не нужна.
  // #428 A.4: весь блок — только если старая таблица существует. Раньше
  // ALTER шёл безусловно и ловил no such table при каждом старте, а гейт
  // сравнивал сериализацию пустого выборка с литеральной парой скобок —
  // на 0.27.0 пустой выбор сериализуется иначе, гейт всегда был истинным,
  // и INSERT/DROP добавляли ещё две caught-error строки в бут-лог.
  let lz_old_posts = query("SELECT name FROM sqlite_master WHERE type='table' AND name='lz_telegram_posts'", [])
  if length(lz_old_posts) > 0.0 then {
    let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:lz_telegram_posts", 3600.0, "once"), "ALTER TABLE lz_telegram_posts ADD COLUMN update_id TEXT"))
    let _ = TryVal(try db_execute("INSERT OR IGNORE INTO lz_github_updates (update_id, channel_id, channel_name, text, date, scanned_at) SELECT update_id, channel_id, channel_name, text, date, scanned_at FROM lz_telegram_posts"))
    let _ = TryVal(try db_execute_with_grant(grant_issue("db:drop:lz_telegram_posts", 3600.0, "once"), "DROP TABLE lz_telegram_posts"))
  }
  db_execute("CREATE TABLE IF NOT EXISTS lz_monitors (id INTEGER PRIMARY KEY AUTOINCREMENT, query TEXT, sources TEXT, frequency TEXT, last_scan TEXT, created_at TEXT DEFAULT (datetime('now')))")

  // System
  db_execute("CREATE TABLE IF NOT EXISTS system_settings (key TEXT PRIMARY KEY, value TEXT)")

  // FOIP-003.16: Per-provider rate limiting
  db_execute("CREATE TABLE IF NOT EXISTS rate_limits (provider TEXT, created_at TEXT)")
  let _ = TryVal(try db_execute("CREATE INDEX IF NOT EXISTS idx_rl_provider ON rate_limits(provider, created_at)"))

  // Yana calendar & reminders
  db_execute("CREATE TABLE IF NOT EXISTS yana_events (id INTEGER PRIMARY KEY AUTOINCREMENT, event_text TEXT, event_date TEXT, event_type TEXT DEFAULT 'reminder', created_at TEXT DEFAULT (datetime('now')))")
  // Yana events - alter table extensions
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN reminded_at TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN rrule_kind TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN fire_time TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN fire_weekday TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN fire_monthday TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN next_fire_at TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN until_date TEXT"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN active INTEGER DEFAULT 1"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:yana_events", 3600.0, "once"), "ALTER TABLE yana_events ADD COLUMN chat_id TEXT"))

  // Yana metrics — delegation accuracy & forgetting incidents
  db_execute("CREATE TABLE IF NOT EXISTS yana_delegation_log (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, query TEXT, delegated_to TEXT, dept_response_summary TEXT, was_correct INTEGER, feedback_source TEXT, delegated_at TEXT DEFAULT (datetime('now')), verified_at TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS yana_forgetting_incidents (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, query TEXT, forgotten_topic TEXT, memory_existed INTEGER, yana_answer_summary TEXT, correct_info TEXT, reported_at TEXT DEFAULT (datetime('now')), verified_at TEXT)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_yana_deleg_delegated_to ON yana_delegation_log(delegated_to)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_yana_deleg_was_correct ON yana_delegation_log(was_correct)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_yana_forget_chat_id ON yana_forgetting_incidents(chat_id)")

  // OSP — analysis archive & research sources (per METHODOLOGY v3, hard rule #8)
  // NOTE: db_execute/db_insert in this file — interpreter-only functions. Works because serve = interpreter (confirmed 2026-06-22). If backend changes — re-verify (METALOGOS_INSTRUCTIONS.md §6.9).
  db_execute("CREATE TABLE IF NOT EXISTS analysis (id INTEGER PRIMARY KEY AUTOINCREMENT, topic TEXT, full_result TEXT, status TEXT DEFAULT 'drafted', verification_date TEXT, confidence TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS research_source (id INTEGER PRIMARY KEY AUTOINCREMENT, analysis_id INTEGER, url TEXT, title TEXT, tier TEXT DEFAULT 'secondary', claim TEXT, created_at TEXT DEFAULT (datetime('now')), FOREIGN KEY(analysis_id) REFERENCES analysis(id))")

  // OSP — I&W Indicators (per Indicator model in prisma/schema.prisma)
  db_execute("CREATE TABLE IF NOT EXISTS indicator (id INTEGER PRIMARY KEY AUTOINCREMENT, analysis_id INTEGER, description TEXT, verify_date TEXT, is_binary INTEGER DEFAULT 1, result INTEGER, verified_at TEXT, confirms_what TEXT, pre_verify_reminder_sent INTEGER DEFAULT 0, scheduled_job_id TEXT, created_at TEXT DEFAULT (datetime('now')), FOREIGN KEY(analysis_id) REFERENCES analysis(id))")
  db_execute("CREATE INDEX IF NOT EXISTS idx_indicator_verify_date ON indicator(verify_date)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_indicator_analysis_id ON indicator(analysis_id)")

  // OSP — Watchlist items (per WatchlistItem model in prisma/schema.prisma)
  db_execute("CREATE TABLE IF NOT EXISTS watchlist_item (id INTEGER PRIMARY KEY AUTOINCREMENT, analysis_id INTEGER, topic TEXT, frequency TEXT DEFAULT 'DAILY', last_check_at TEXT, next_check_at TEXT, active INTEGER DEFAULT 1, last_delta TEXT, delta_count INTEGER DEFAULT 0, created_at TEXT DEFAULT (datetime('now')), FOREIGN KEY(analysis_id) REFERENCES analysis(id))")
  db_execute("CREATE INDEX IF NOT EXISTS idx_watchlist_next_check ON watchlist_item(next_check_at)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_watchlist_active ON watchlist_item(active)")

  // OSP — Brier score log (per BrierScoreLog model)
  db_execute("CREATE TABLE IF NOT EXISTS brier_score_log (id INTEGER PRIMARY KEY AUTOINCREMENT, analysis_id INTEGER, forecast_probability REAL, actual_outcome REAL, brier_score REAL, cumulative_brier REAL, total_forecasts INTEGER, created_at TEXT DEFAULT (datetime('now')), FOREIGN KEY(analysis_id) REFERENCES analysis(id))")

  // OSP — Calibration curve (per CalibrationCurvePoint model)
  db_execute("CREATE TABLE IF NOT EXISTS calibration_curve_point (id INTEGER PRIMARY KEY AUTOINCREMENT, bin_label TEXT, bin_center REAL, forecasts_in_bin INTEGER, actual_rate REAL, deviation REAL, created_at TEXT DEFAULT (datetime('now')))")

  // OSP — Asymmetric bets (per AsymmetricBet model)
  db_execute("CREATE TABLE IF NOT EXISTS asymmetric_bet (id INTEGER PRIMARY KEY AUTOINCREMENT, thesis TEXT, probability TEXT, bounded_downside TEXT, potential_upside TEXT, upside_downside_ratio REAL, exit_conditions TEXT, time_horizon TEXT, execution_mechanism TEXT, status TEXT DEFAULT 'OPEN', closed_at TEXT, outcome_note TEXT, result_pnl REAL, created_at TEXT DEFAULT (datetime('now')))")

  // Generic dept archive (narad 3/6) — for marketing/finance/legal learning loop
  db_execute("CREATE TABLE IF NOT EXISTS dept_archive (id INTEGER PRIMARY KEY AUTOINCREMENT, dept TEXT NOT NULL, topic TEXT, full_result TEXT, status TEXT DEFAULT 'drafted', verification_date TEXT, confidence TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS dept_verification (id INTEGER PRIMARY KEY AUTOINCREMENT, archive_id INTEGER, actual_outcome TEXT, error_diagnosis TEXT, verified_at TEXT DEFAULT (datetime('now')), FOREIGN KEY(archive_id) REFERENCES dept_archive(id))")

  // Narad 8 — calibrated metrics: structured columns (nullable, additive, safe for existing data)
  // dept_archive.forecast_value: numeric forecast at creation time (Finance only)
  // dept_verification.actual_value: numeric actual post-factum (Finance only)
  // dept_verification.outcome_flag: categorical flag (Legal: "clean" / "rewrite_required")
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:dept_archive", 3600.0, "once"), "ALTER TABLE dept_archive ADD COLUMN forecast_value REAL"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:dept_verification", 3600.0, "once"), "ALTER TABLE dept_verification ADD COLUMN actual_value REAL"))
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:dept_verification", 3600.0, "once"), "ALTER TABLE dept_verification ADD COLUMN outcome_flag TEXT"))

  // Webhook dedup — time-windowed (WH-3): replaces eternal kv-flag
  db_execute("CREATE TABLE IF NOT EXISTS webhook_dedup (update_id TEXT PRIMARY KEY, seen_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS dev_tasks (id TEXT PRIMARY KEY, title TEXT, task_type TEXT, status TEXT, qa_status TEXT, telegram_snapshot_id TEXT, estimate_low TEXT, estimate_expected TEXT, estimate_high TEXT, estimate_confidence TEXT, actual_hours TEXT, created_at TEXT DEFAULT (datetime('now')), updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS dept_activity (dept TEXT PRIMARY KEY, last_used_at TEXT, use_count INTEGER DEFAULT 0)")
  db_execute("CREATE TABLE IF NOT EXISTS campaign_verifications (id INTEGER PRIMARY KEY AUTOINCREMENT, campaign_id TEXT, conversion_accuracy TEXT, cac_accuracy TEXT, reach_accuracy TEXT, conversion_within_target TEXT, cac_within_target TEXT, was_overoptimistic TEXT, verified_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS legal_assessments (id INTEGER PRIMARY KEY AUTOINCREMENT, short_title TEXT, full_result TEXT, document_type TEXT, status TEXT, jurisdiction TEXT, business_form TEXT, counterparty_jurisdiction TEXT, counterparty_form TEXT, risk_level TEXT, confidence TEXT, verification_date TEXT, created_at TEXT DEFAULT (datetime('now')), updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS training_sessions (id INTEGER PRIMARY KEY AUTOINCREMENT, dept_name TEXT, specialist_name TEXT, session_type TEXT, status TEXT, polygon_pass_rate TEXT, created_at TEXT DEFAULT (datetime('now')), completed_at TEXT, ratified_at TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS scan_logs (id INTEGER PRIMARY KEY AUTOINCREMENT, scan_type TEXT, sources_queried TEXT, artifacts_found INTEGER, created_at TEXT DEFAULT (datetime('now')))")
  // ИСПРАВЛЕНО: knowledge_artifacts существовала только как комментарий-
  // документация в dept/lz.mlog (строка ~16), не как реальный db_execute
  // — каждая вставка/обновление годами тихо падала с "no such table",
  // поймано try, не крашилось, но и не сохранялось ничего. Подтверждено
  // реальным исполнением перед правкой. Схема — из того же комментария,
  // адаптирована под SQLite (SERIAL→AUTOINCREMENT, TIMESTAMP→TEXT).
  db_execute("CREATE TABLE IF NOT EXISTS knowledge_artifacts (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER DEFAULT 0, title TEXT NOT NULL, domain TEXT NOT NULL, source TEXT, source_url TEXT, source_tier INTEGER DEFAULT 2, hype_cycle_stage TEXT, disruption_score REAL DEFAULT 0.0, inflection_signals TEXT DEFAULT '[]', cross_domain_potential TEXT DEFAULT '[]', competing_alternatives TEXT DEFAULT '[]', status TEXT DEFAULT 'tracking', confirmation_count INTEGER DEFAULT 0, tracked_since TEXT DEFAULT (datetime('now')), last_scored_at TEXT, created_at TEXT DEFAULT (datetime('now')), updated_at TEXT DEFAULT (datetime('now')))")
  // Та же болезнь — все три таблицы ниже существовали только как
  // комментарий-документация в dept/lz.mlog (строки ~31-66), реальных
  // db_execute не было. tracked_technologies/watchlist_entries имели
  // реальные (годами падавшие) UPDATE/INSERT-вызовы; disruption_alerts
  // пока не имеет вызовов вообще, заведена на будущее по той же схеме.
  db_execute("CREATE TABLE IF NOT EXISTS tracked_technologies (id INTEGER PRIMARY KEY AUTOINCREMENT, artifact_id INTEGER, technology_name TEXT NOT NULL, category TEXT, oob_data TEXT DEFAULT '{}', patent_activity TEXT DEFAULT '[]', talent_flow TEXT DEFAULT '[]', vc_investment TEXT DEFAULT '[]', disruption_1y REAL, disruption_3y REAL, disruption_5y REAL, disruption_10y REAL, created_at TEXT DEFAULT (datetime('now')), updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS watchlist_entries (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER DEFAULT 0, topic TEXT NOT NULL, domain TEXT, threshold_disruption REAL DEFAULT 70.0, threshold_inflection INTEGER DEFAULT 1, status TEXT DEFAULT 'active', created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS disruption_alerts (id INTEGER PRIMARY KEY AUTOINCREMENT, artifact_id INTEGER, alert_type TEXT, severity TEXT DEFAULT 'medium', confirmation_count INTEGER DEFAULT 0, osp_triggered INTEGER DEFAULT 0, message TEXT, created_at TEXT DEFAULT (datetime('now')), resolved_at TEXT)")
  // #553 A.1: колонка провенанса LLM-полей knowledge_artifacts. ALTER
  // идемпотентен: на существующей колонке бросает — TryVal глотает
  // (конвенция ALTER-миграций этого InitDB). Заполняют LZProvRecord/
  // LZProvRule (dept/lz.mlog) в момент записи значения.
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:knowledge_artifacts", 3600.0, "once"), "ALTER TABLE knowledge_artifacts ADD COLUMN provenance TEXT DEFAULT '{}'"))
  // #559 A.1: исход алерта для FPR (confirmed|retracted|pending, дефолт pending;
  // проставляется вручную при разборе — честный подсчёт без выдуманных исходов)
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:alter:disruption_alerts", 3600.0, "once"), "ALTER TABLE disruption_alerts ADD COLUMN outcome TEXT DEFAULT 'pending'"))
  // #565 A.1/A.2: ключи предсказаний и журнал сырых прогонов. Ключи пишутся
  // В МОМЕНТ предсказания (LZDisruptionScore/LZHypeCycleMap/LZInflectionDetect,
  // dept/lz.mlog); ретроактивные запрещены. Сводные метрики — только из raw
  // grading_runs (LZSummaryFromRaw), honest-калибровка — LZRecalibrate.
  db_execute("CREATE TABLE IF NOT EXISTS prediction_keys (id INTEGER PRIMARY KEY AUTOINCREMENT, artifact_id INTEGER, kind TEXT, claim TEXT, predicted_at TEXT DEFAULT (datetime('now')), verify_source TEXT, due_at TEXT, status TEXT DEFAULT 'pending', graded_at TEXT, score REAL, grader TEXT, caveats TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS grading_runs (id INTEGER PRIMARY KEY AUTOINCREMENT, run_date TEXT DEFAULT (datetime('now')), metric TEXT, n INTEGER, raw TEXT, summary TEXT, caveats TEXT, grader_errata TEXT)")
  // #556 A.5: идемпотентная миграция данных ЛЗ — длинные стадии в коды/NULL,
  // дубли артефактов слиты (keeper = min id, остальные archived, без удаления).
  // Выполняется на каждом старте, повторный прогон ничего не меняет.
  let _ = LZDataMaintain()
  // #566 A.1: категория-кандидат watchlist «thin-skills-vs-fat-tool-layers» —
  // идемпотентный seed (повторный старт ничего не дублирует)
  let _ = LZWatchSeedCategory()

  // ── Visual Department: artifacts + templates ──
  db_execute("CREATE TABLE IF NOT EXISTS visual_artifacts (id INTEGER PRIMARY KEY AUTOINCREMENT, type TEXT NOT NULL, source_type TEXT, source_id TEXT, path TEXT, content_hash TEXT, template_version TEXT DEFAULT '1.0', created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS visual_templates (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT UNIQUE NOT NULL, type TEXT NOT NULL, spec TEXT, version TEXT DEFAULT '1.0', updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS style_evolution (id INTEGER PRIMARY KEY AUTOINCREMENT, quarter TEXT NOT NULL, coverage_rate REAL, recall_rate REAL, patterns_added TEXT, patterns_retired TEXT, notes TEXT, created_at TEXT DEFAULT (datetime('now')))")
  let _ = TryVal(try db_execute("CREATE INDEX IF NOT EXISTS idx_visual_type ON visual_artifacts(type)"))
  let _ = TryVal(try db_execute("CREATE INDEX IF NOT EXISTS idx_visual_source ON visual_artifacts(source_type, source_id)"))

  // ── QUEST-1: Dossier system for multi-step tasks (grants, contracts, reports) ──
  db_execute("CREATE TABLE IF NOT EXISTS quests (id TEXT PRIMARY KEY, title TEXT, quest_type TEXT DEFAULT 'general', status TEXT DEFAULT 'active', current_step INTEGER DEFAULT 0, total_steps INTEGER DEFAULT 0, deadline TEXT, owner_chat_id TEXT, metadata TEXT, created_at TEXT DEFAULT (datetime('now')), updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS quest_files (id INTEGER PRIMARY KEY AUTOINCREMENT, quest_id TEXT, filename TEXT, file_type TEXT, version INTEGER DEFAULT 1, storage_path TEXT, metadata TEXT, created_at TEXT DEFAULT (datetime('now')), FOREIGN KEY(quest_id) REFERENCES quests(id))")
  db_execute("CREATE TABLE IF NOT EXISTS quest_checkpoints (id INTEGER PRIMARY KEY AUTOINCREMENT, quest_id TEXT, step_num INTEGER, step_label TEXT, status TEXT DEFAULT 'pending', approved_by TEXT, notes TEXT, created_at TEXT DEFAULT (datetime('now')), approved_at TEXT, FOREIGN KEY(quest_id) REFERENCES quests(id))")
  // ── FO-035: FORGE-контур — схема §4 ТЗ v3 ──
  db_execute("CREATE TABLE IF NOT EXISTS forge_projects (slug TEXT PRIMARY KEY, name TEXT, description TEXT, goal TEXT, project_type TEXT, template_id TEXT, customer_name TEXT, gate_policy TEXT DEFAULT 'key_stages', model_combo TEXT DEFAULT 'fosved-standard', departments TEXT DEFAULT 'dev', status TEXT DEFAULT 'active', created_at TEXT DEFAULT (datetime('now')), updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_customer_data (project_slug TEXT PRIMARY KEY, secret_ref TEXT, updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_project_secrets (project_slug TEXT, env_key TEXT, secret_ref TEXT, PRIMARY KEY (project_slug, env_key))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_repos (name TEXT PRIMARY KEY, project_slug TEXT, description TEXT, github_url TEXT, commits_count INTEGER DEFAULT 0, last_commit_at TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_runs (id INTEGER PRIMARY KEY AUTOINCREMENT, project_slug TEXT, repo_name TEXT, stage_id TEXT, command TEXT, exit_code TEXT, output TEXT, duration_ms TEXT, created_at TEXT DEFAULT (datetime('now')))")
  // FO-035 A.2: secrets_store (SEC-5 минимальный; шифрование — proxy/forge_secrets.py, AES-256-GCM, FORGE_MASTER_KEY)
  db_execute("CREATE TABLE IF NOT EXISTS secrets_store (key TEXT PRIMARY KEY, value_encrypted TEXT, updated_at TEXT DEFAULT (datetime('now')))")
  // ── FO-036 (наряд #134): FORGE-2v3 — задачи, этапы, задания, история решений ──
  db_execute("CREATE TABLE IF NOT EXISTS forge_tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, project_slug TEXT, title TEXT, description TEXT, status TEXT DEFAULT 'proposed', priority TEXT DEFAULT 'normal', created_by TEXT, claimed_by TEXT, claimed_at TEXT, blocked_by TEXT, created_at TEXT DEFAULT (datetime('now')), updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_stages (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id INTEGER, seq INTEGER, title TEXT, description TEXT, needs_owner_gate TEXT DEFAULT 'false', status TEXT DEFAULT 'pending', commit_tag TEXT, commit_sha TEXT, failed_runs INTEGER DEFAULT 0, started_at TEXT, finished_at TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS forge_briefs (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id INTEGER, version INTEGER DEFAULT 1, content TEXT, approved TEXT DEFAULT 'false', approved_at TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_finding_decisions (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id INTEGER, stage_id TEXT, step TEXT, finding_text TEXT, decision TEXT, decided_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_step_config (project_slug TEXT, step TEXT, policy TEXT, PRIMARY KEY (project_slug, step))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_whitelist (id INTEGER PRIMARY KEY AUTOINCREMENT, project_slug TEXT, command TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_gates (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id INTEGER, stage_id TEXT, kind TEXT, question TEXT, context TEXT, options_json TEXT, decision TEXT, decided_by TEXT, decided_at TEXT, telegram_message_id TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS forge_previews (slug TEXT PRIMARY KEY, project_slug TEXT, repo_name TEXT, kind TEXT DEFAULT 'live', port INTEGER, pid TEXT, status TEXT DEFAULT 'running', last_access_at TEXT, started_at TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS forge_remarks (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id INTEGER, stage_id TEXT, commit_sha TEXT, text TEXT, file_hint TEXT, attachment_ref TEXT, kind TEXT, status TEXT DEFAULT 'open', resolved_by_commit TEXT, gate_id TEXT, created_at TEXT DEFAULT (datetime('now')), resolved_at TEXT)")
  // FO-043 (наряд #150): метрика формата правок (§15) — исходы применения диффов
  db_execute("CREATE TABLE IF NOT EXISTS forge_edit_stats (id INTEGER PRIMARY KEY AUTOINCREMENT, task_id TEXT, stage_id TEXT, path TEXT, outcome TEXT, fuzzy TEXT, created_at TEXT DEFAULT (datetime('now')))")
  // FO-027: durable-степы цепочек (чекпоинты + resume; Temporal/Inngest паттерн)
  db_execute("CREATE TABLE IF NOT EXISTS chain_steps (id INTEGER PRIMARY KEY AUTOINCREMENT, chain_id TEXT, chat_id TEXT, step_num REAL, dept TEXT, mode TEXT, input_hash TEXT, reply TEXT, model TEXT, tokens_in TEXT, tokens_out TEXT, cost_usd TEXT, status TEXT DEFAULT 'pending', dept_chain TEXT DEFAULT '', query TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')), updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE INDEX IF NOT EXISTS idx_chain_steps_chain ON chain_steps(chain_id, step_num, dept)")

  // ── FOIP-003 Phase 1: Session Log + Token Metering ──
  db_execute("CREATE TABLE IF NOT EXISTS session_log (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, session_seq INTEGER DEFAULT 0, event_type TEXT, dept TEXT, data TEXT, model TEXT, tokens_in INTEGER DEFAULT 0, tokens_out INTEGER DEFAULT 0, latency_ms INTEGER DEFAULT 0, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE INDEX IF NOT EXISTS idx_slog_chat ON session_log(chat_id, session_seq)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_slog_type ON session_log(event_type)")
  db_execute("CREATE TABLE IF NOT EXISTS daily_stats (id INTEGER PRIMARY KEY AUTOINCREMENT, date TEXT, dept TEXT, model TEXT, total_calls INTEGER DEFAULT 0, total_tokens_in INTEGER DEFAULT 0, total_tokens_out INTEGER DEFAULT 0, total_errors INTEGER DEFAULT 0, total_latency_ms INTEGER DEFAULT 0, estimated_cost_usd REAL DEFAULT 0.0)")
  db_execute("CREATE UNIQUE INDEX IF NOT EXISTS idx_dstats_date_dept ON daily_stats(date, dept, model)")

  // FOIP-003.9: Design tokens table
  db_execute("CREATE TABLE IF NOT EXISTS design_tokens (name TEXT PRIMARY KEY, tokens_json TEXT, updated_at TEXT DEFAULT (datetime('now')))")
  // FOIP-003.11: Marketing ideas library
  db_execute("CREATE TABLE IF NOT EXISTS marketing_ideas (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, aarr_stage TEXT, budget_level TEXT, business_stage TEXT, description TEXT, tags TEXT)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_mideas_stage ON marketing_ideas(aarr_stage)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_mideas_tags ON marketing_ideas(tags)")

  // ═════════════════════════════════════════════════════════════════════
  // ═════════════════════════════════════════════════════════════════════
  // ── naryad-363: DDL-пак — таблицы, используемые кодом, но не созданные ──
  // 45 таблиц (50 со всеми ручными). Источники схем: (а) эталонные декларации из шапок dept/*.mlog
  // (перевод в SQLite), (б) выведены из реальных INSERT/SELECT-колонок
  // (что код пишет — то и создаём); мусор от ---комментариев эталонов вычищен.
  // Скрипт-доказательство: scripts/naryad363_scan.py, naryad363_missing.json.
  db_execute("CREATE TABLE IF NOT EXISTS ai_eval_runs (id INTEGER PRIMARY KEY AUTOINCREMENT, coherence_score REAL, created_at TEXT DEFAULT (datetime('now')), faithfulness_score REAL, groundedness_score REAL, model_id TEXT, overall_pass_rate REAL, project TEXT, prompt_injection_score REAL, relevance_score REAL, status TEXT, total_cases TEXT, updated_at TEXT DEFAULT (datetime('now')), completed_at TEXT, verdict TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS analysis_verifications (id INTEGER PRIMARY KEY AUTOINCREMENT, analysis_id INTEGER, scenario_outcomes TEXT, brier_scores TEXT, brier_total REAL, error_category TEXT, error_note TEXT, improvements_for_next TEXT, biases_active_in_analysis TEXT DEFAULT '[]', indicators_triggered INTEGER DEFAULT 0, indicators_total INTEGER DEFAULT 0, verified_at TEXT DEFAULT (datetime('now')), verified_by TEXT DEFAULT 'system')")
  db_execute("CREATE TABLE IF NOT EXISTS architecture_decisions (id INTEGER PRIMARY KEY AUTOINCREMENT, alternatives TEXT, consequences TEXT, context TEXT, created_at TEXT DEFAULT (datetime('now')), decision TEXT, status TEXT, task_id TEXT, title TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS arsenal_reviews (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER DEFAULT 0, year_half TEXT UNIQUE, skills_in_use TEXT DEFAULT '[]', skills_underused TEXT DEFAULT '[]', skills_obsolete TEXT DEFAULT '[]', skills_to_add TEXT DEFAULT '[]', tooling_changes TEXT, new_sources_added TEXT, review_note TEXT, created_at TEXT DEFAULT (datetime('now')), review_notes TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS audience_segments (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER DEFAULT 0, name TEXT NOT NULL, description TEXT NOT NULL, pain_point TEXT NOT NULL, where_to_reach TEXT NOT NULL, current_alternative TEXT, estimated_size INTEGER, size_basis TEXT, status TEXT DEFAULT 'hypothesized', created_at DATETIME DEFAULT (datetime('now')), updated_at DATETIME DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS code_repositories (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), has_ci TEXT, has_gitignore TEXT, has_license TEXT, has_readme TEXT, name TEXT, storage_primary TEXT, task_type TEXT, url TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS contract_templates (id INTEGER PRIMARY KEY AUTOINCREMENT, document_type TEXT, jurisdiction TEXT, business_form TEXT, name TEXT, version INTEGER DEFAULT 1, status TEXT DEFAULT 'active')")
  db_execute("CREATE TABLE IF NOT EXISTS cross_asset_divergences (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER DEFAULT 0, date TEXT DEFAULT (datetime('now')), pair_assets TEXT, divergence_type TEXT, z_score REAL, notes TEXT, created_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS cross_dept_tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), reference_id TEXT, severity TEXT, source_dept TEXT, status TEXT, summary TEXT, target_dept TEXT, task_type TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS defect_records (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), environment TEXT, project TEXT, severity TEXT, status TEXT, summary TEXT, test_run_id TEXT, updated_at TEXT DEFAULT (datetime('now')), has_regression_test TEXT, verified_at TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS design_artifacts (id INTEGER PRIMARY KEY AUTOINCREMENT, a11y_score REAL, artifact_type TEXT, content TEXT, created_at TEXT DEFAULT (datetime('now')), design_tokens TEXT, has_mobile TEXT, has_responsive TEXT, interaction_states TEXT, iteration_count REAL, name TEXT, parent_artifact_id TEXT, status TEXT, updated_at TEXT DEFAULT (datetime('now')), user_tasks TEXT, a11y_issues TEXT, a11y_level TEXT)")
