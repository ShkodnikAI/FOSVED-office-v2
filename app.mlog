// ── OSP archive helpers (interpreter-only, confirmed 2026-06-22) ──

pattern SaveAnalysis(topic: String, result: String) -> String {
  db_execute("INSERT INTO analysis (topic, full_result, status) VALUES (?1, ?2, 'drafted')", [topic, result])
  let rows = query("SELECT last_insert_rowid() as lid", [])
  let count = length(rows)
  if count == 0.0 then { return "0" }
  return json_get(rows[0], "lid", "0")
}

pattern AttachSource(analysis_id: String, title: String, claim: String) -> String {
  db_execute("INSERT INTO research_source (analysis_id, title, claim) VALUES (?1, ?2, ?3)", [analysis_id, title, claim])
  return "ok"
}

// ── Factory ──

pattern HandleFactoryStep(order_id: String, input: String, chat_id: String) -> String {
  let step = kv_get("order_step_" + order_id)
  let step_num = to_float(step)

  if step_num == 1.0 then {
    kv_set("order_step_" + order_id, "2")
    kv_set("order_client_" + order_id, input)
    db_execute("UPDATE factory_orders SET client_name = ?1 WHERE id = ?2", [input, order_id])
    return "Step 2/7: What tasks should the office handle?"
  }
  if step_num == 2.0 then {
    kv_set("order_step_" + order_id, "3")
    kv_set("order_tasks_" + order_id, input)
    db_execute("UPDATE factory_orders SET requirements = ?1 WHERE id = ?2", [input, order_id])
    return "Step 3/7: Which departments? (yana, osp, lz, expert, marketing, finance, legal, dev, design, qa, visual, engineering, kavalnya)"
  }
  if step_num == 3.0 then {
    kv_set("order_step_" + order_id, "4")
    kv_set("order_depts_" + order_id, input)
    db_execute("UPDATE factory_orders SET departments = ?1 WHERE id = ?2", [input, order_id])
    return "Step 4/7: Branding? (name, language, style preferences)"
  }
  if step_num == 4.0 then {
    kv_set("order_step_" + order_id, "5")
    kv_set("order_branding_" + order_id, input)
    db_execute("UPDATE factory_orders SET branding = ?1 WHERE id = ?2", [input, order_id])
    return "Step 5/7: Which LLM providers/keys are available?"
  }
  if step_num == 5.0 then {
    kv_set("order_step_" + order_id, "6")
    kv_set("order_llm_" + order_id, input)
    db_execute("UPDATE factory_orders SET llm_config = ?1 WHERE id = ?2", [input, order_id])
    let summary = "Order summary:\n"
    let summary = summary + "Client: " + kv_get("order_client_" + order_id) + "\n"
    let summary = summary + "Tasks: " + kv_get("order_tasks_" + order_id) + "\n"
    let summary = summary + "Departments: " + kv_get("order_depts_" + order_id) + "\n"
    let summary = summary + "Branding: " + kv_get("order_branding_" + order_id) + "\n"
    let summary = summary + "LLM: " + input + "\n\nConfirm? Send 'yes' or 'no'."
    kv_set("order_summary_" + order_id, summary)
    return summary
  }
  if step_num == 6.0 then {
    if lower(input) == "yes" or lower(input) == "ok" then {
      kv_set("order_step_" + order_id, "7")
      db_execute("UPDATE factory_orders SET status = 'building' WHERE id = ?1", [order_id])
      let _ = AuditLog("factory_build", "factory", "building: " + order_id)
      kv_set("active_order", "")
      return "Order confirmed. Building office...\nStatus: building\nTrack: /factory_list"
    } else {
      kv_set("active_order", "")
      db_execute("UPDATE factory_orders SET status = 'cancelled' WHERE id = ?1", [order_id])
      return "Order cancelled."
    }
  }
  return "Factory flow completed."
}

// LZDeepScan, LZAllScan are defined in dept/lz.mlog (imported above) — they call real scanners (ScanWeb, ScanGitHub, etc.)
// Do NOT re-define them here or they will shadow the real implementations.

pattern RecordUserMessage(chat_id: String, dept: String, text: String) -> String {
  db_execute("INSERT INTO dialog_history (chat_id, role, dept, content) VALUES (?1, 'user', ?2, ?3)", [chat_id, dept, text])
  let _ = SaveDialogV2(chat_id, "user", dept, text)
  let _ = try db_execute("INSERT INTO dept_activity (dept, last_used_at, use_count) VALUES (?1, datetime('now'), 1) ON CONFLICT(dept) DO UPDATE SET last_used_at = datetime('now'), use_count = use_count + 1", [dept])
  return "ok"
}

pattern RecordAssistantMessage(chat_id: String, dept: String, text: String) -> String {
  db_execute("INSERT INTO dialog_history (chat_id, role, dept, content) VALUES (?1, 'assistant', ?2, ?3)", [chat_id, dept, text])
  let _ = SaveDialogV2(chat_id, "assistant", dept, text)
  return "ok"
}

// ── FO-017: Dialog v2 — Parts + event-log (python-side) ──
// Best-effort зеркалирование реплик в Dialog v2 (/dialog/message):
// dialog_history остаётся источником истины до ревизии FM3 (наряд #83);
// отказ/таймаут прокси молча игнорируется — диалог не блокируется.
pattern SaveDialogV2(session_id: String, role: String, dept: String, content: String) -> String {
  let body = json_encode({session_id: session_id, role: role, dept: dept, content: content, source: "app.mlog"})
  let result = try http_post("http://127.0.0.1:4000/dialog/message", body, "application/json", 3.0)
  if to_string(result) == "()" then { return "" }
  return result
}

pattern SendTelegramReply(chat_id: String, text: String) -> String {
  let token = env("TELEGRAM_BOT_TOKEN")
  let body = json_encode({chat_id: to_float(chat_id), text: text})
  let result = try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json")
  return result
}

// Send Telegram reply with MarkdownV2 formatting + fallback to plain text.
// Escapes text via EscapeMarkdownV2Simple, sends with parse_mode: "MarkdownV2".
// If Telegram rejects the formatting (ok != true), resends original text without parse_mode.
// Used for yana/admin departments where bold/italic formatting matters.
pattern SendTelegramReplyMDV2(chat_id: String, text: String) -> String {
  let token = env("TELEGRAM_BOT_TOKEN")
  let escaped = EscapeMarkdownV2Simple(text)
  let body = json_encode({chat_id: to_float(chat_id), text: escaped, parse_mode: "MarkdownV2"})
  let result = try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json")
  if to_string(result) == "()" then {
    // Network error caught by try — fallback to plain text directly
    let body2 = json_encode({chat_id: to_float(chat_id), text: text})
    let result2 = try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body2, "application/json")
    return result2
  }
  let parsed = parse_json(result)
  let ok = json_get(parsed, "ok", "")
  if ok != "true" then {
    // Telegram rejected MarkdownV2 formatting — fallback to plain text
    let body2 = json_encode({chat_id: to_float(chat_id), text: text})
    let result2 = try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body2, "application/json")
    return result2
  }
  return result
}

pattern SendTyping(chat_id: String) -> String {
  let token = env("TELEGRAM_BOT_TOKEN")
  let body = json_encode({chat_id: to_float(chat_id), action: "typing"})
  let result = try http_post("https://api.telegram.org/bot" + token + "/sendChatAction", body, "application/json")
  return result
}

// ── FO-020: карточка review-очереди (inference review, наряд #86) ──
// /review → топ-8 невыверенного (parent_count DESC) с кнопками
// approve/decline/undo; решения через /review/decide, всё в audit_log.
pattern JsonEscapeText(s: String) -> String {
  let r = replace(s, "\\", "/")
  let r = replace(r, "\"", "'")
  let r = replace(r, "\n", "\\n")
  return r
}

pattern ReviewQueueCard(chat_id: String) -> String {
  let body = json_encode({limit: 8.0})
  let resp = try http_post("http://127.0.0.1:4000/review/queue", body, "application/json", 5.0)
  if to_string(resp) == "()" then {
    let _ = SendTelegramReply(chat_id, "Review-очередь недоступна (proxy не отвечает).")
    return ""
  }
  let parsed = try parse_json(resp)
  if to_string(parsed) == "()" then {
    let _ = SendTelegramReply(chat_id, "Review-очередь: ошибка разбора ответа.")
    return ""
  }
  let depth = to_string(json_get(parsed, "depth", "0"))
  let items = json_get(parsed, "items", "[]")
  let count = to_float(json_get(parsed, "count", "0"))
  if count == 0.0 then {
    let _ = SendTelegramReply(chat_id, "🔍 Review-очередь пуста — всё выведенное подтверждено (глубина: " + depth + ").")
    return "ok"
  }
  let mut text = "🔍 Review-очередь (" + depth + " невыверенных, топ по числу источников):\n\n"
  let mut kb = ""
  each it in items {
    let sid = to_string(json_get(it, "source", ""))
    let iid = to_string(json_get(it, "id", ""))
    let pc = to_string(json_get(it, "parent_count", "1"))
    let content = to_string(json_get(it, "content", ""))
    let text = text + "• [" + sid + "#" + iid + " x" + pc + "] " + substring(content, 0.0, 140.0) + "\n"
    let kb = kb + "[{text: \"ОК\", callback_data: \"rv_approve_" + sid + "_" + iid + "\"},{text: \"NO\", callback_data: \"rv_decline_" + sid + "_" + iid + "\"},{text: \"UNDO\", callback_data: \"rv_undo_" + sid + "_" + iid + "\"}],"
  }
  if length(kb) > 0.0 then { let kb = substring(kb, 0.0, length(kb) - 1.0) }
  let token = env("TELEGRAM_BOT_TOKEN")
  let text_esc = JsonEscapeText(text)
  let body2 = "{\"chat_id\": " + to_string(to_float(chat_id)) + ", \"text\": \"" + text_esc + "\", \"reply_markup\": {\"inline_keyboard\": [" + kb + "]}}"
  let _ = try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body2, "application/json")
  return "ok"
}

pattern CallLLMProxy(dept: String, messages: String) -> String {
  let body = json_encode({dept: dept, messages: parse_json(messages)})
  let result = try http_post("http://127.0.0.1:4000/ask", body, "application/json", 240.0)
  if to_string(result) == "()" then { return "" }
  return result
}

// ── FOIP-003.1: Session Log ──
pattern LogSessionEvent(chat_id: String, event_type: String, dept: String, data: String, model: String, tokens_in: String, tokens_out: String) -> String {
  db_execute("INSERT INTO session_log (chat_id, session_seq, event_type, dept, data, model, tokens_in, tokens_out, created_at) VALUES (?, (SELECT COALESCE(MAX(session_seq),0)+1 FROM session_log WHERE chat_id=?), ?, ?, ?, ?, ?, ?, datetime('now'))", [chat_id, chat_id, event_type, dept, data, model, tokens_in, tokens_out])
  return "ok"
}

// ── FOIP-003.2: Resilient LLM Calling with fallback + cooldown ──
// ── FOIP-003.15: Model-Tier Routing ──
// Priority: tier-specific > dept-specific > global > default
pattern GetModelFallbackChain(dept: String) -> String {
  // FOIP-003.15: Check tier-specific override first
  let tier = kv_get("query_tier")
  if tier != "" then {
    let tier_file = "config/tier_" + tier + ".txt"
    let tier_content = read_file(tier_file)
    if tier_content != "" then {
      let tier_lines = split(tier_content, "\n")
      let mut tier_models = ""
      each tl in tier_lines {
        let trimmed = trim(tl)
        if length(trimmed) > 0 and starts_with(trimmed, "#") == false then {
          if tier_models != "" then { tier_models = tier_models + "," }
          tier_models = tier_models + trimmed
        }
      }
      if tier_models != "" then {
        let _ = AuditLog("tier_routing", "system", "tier=" + tier + " models=" + tier_models)
        return tier_models
      }
    }
  }
  // Read dept-specific override, fallback to global priority_model
  let override_file = "config/override_" + dept + ".txt"
  let override_content = read_file(override_file)
  if override_content != "" then {
    // Extract model lines (skip comments and empty)
    let ov_lines = split(override_content, "\n")
    let mut ov_models = ""
    each ov_line in ov_lines {
      let trimmed = trim(ov_line)
      if length(trimmed) > 0 and starts_with(trimmed, "#") == false then {
        if ov_models != "" then { ov_models = ov_models + "," }
        ov_models = ov_models + trimmed
      }
    }
    if ov_models != "" then { return ov_models }
  }
  let global = read_file("config/priority_model.txt")
  if global != "" then { return trim(global) }
  return "glm-4.6"
}


pattern IsModelCooled(model: String) -> String {
  let fails = kv_get("fails:" + model)
  if fails == "" then { return "available" }
  if to_int(fails) >= 3 then { return "cooled" }
  return "available"
}

pattern MarkModelFail(model: String) -> String {
  let fails = kv_get("fails:" + model)
  let mut count = 0
  if fails != "" then { count = to_int(fails) }
  let _ = kv_set("fails:" + model, to_string(count + 1))
  return "ok"
}

pattern ClearModelFails(model: String) -> String {
  let _ = kv_set("fails:" + model, "")
  return "ok"
}

// ============================================================
// FOIP-003.14: Internal Endpoint Auth
// ============================================================
pattern RequireInternalAuth() -> String {
  let token = query_param("token")
  let expected = env("INTERNAL_API_TOKEN")
  if expected == "" then { return "ok" }
  if token == expected then { return "ok" }
  return "unauthorized"
}

// ============================================================
// FOIP-003.15: Model-Tier Classification
// Tiers: "quick" (cheap/fast), "standard" (default), "deep" (powerful)
// ============================================================
pattern ClassifyQueryTier(text: String, dept: String) -> String {
  let t = lower(trim(text))
  let quick_cmds = ["/start", "/help", "/status", "/office", "/dept", "/stats", "/cost", "/costs", "/budget", "/model", "/learning", "/\u043d\u0430\u0440\u044f\u0434\u044b", "/rate", "/yana"]
  each cmd in quick_cmds {
    if t == cmd then { return "quick" }
  }
  if t == "\u043f\u0440\u0438\u0432\u0435\u0442" or t == "\u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439" or t == "\u0441\u043f\u0430\u0441\u0438\u0431\u043e" or t == "\u043e\u043a" or t == "ok" or t == "hello" then { return "quick" }
  if length(t) < 20.0 then { return "quick" }
  if starts_with(text, "/osp deep") then { return "deep" }
  if starts_with(text, "/osp full") then { return "deep" }
  if starts_with(text, "/osp wargame") then { return "deep" }
  if starts_with(text, "/lz deep") then { return "deep" }
  if starts_with(text, "/chain") then { return "deep" }
  if starts_with(text, "/debrief") then { return "deep" }
  let deep_kw = ["\u0430\u043d\u0430\u043b\u0438\u0437", "\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435", "wargame", "\u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f", "\u043f\u0440\u043e\u0433\u043d\u043e\u0437", "\u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435", "\u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439", "\u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439", "\u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439", "\u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u0439", "\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0439", "\u0441\u0440\u0430\u0432\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439", "\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0439", "\u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0439", "\u0441\u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438\u0440\u0443\u0439", "\u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0439", "research"]
  each kw in deep_kw {
    if contains(t, kw) then { return "deep" }
  }
  return "standard"
}

// ============================================================
// FOIP-003.16: Per-Provider Rate Limiting
// ============================================================
pattern GetProviderRateLimit(provider: String) -> String {
  let key = "rate_limit:" + provider
  let val = kv_get(key)
  if val != "" then { return val }
  return "20"
}

pattern CheckRateLimit(provider: String) -> String {
  let limit = to_float(GetProviderRateLimit(provider))
  let rows = query("SELECT COUNT(*) as c FROM rate_limits WHERE provider = ? AND created_at > datetime('now', '-1 minute')", [provider])
  if to_string(rows) == "()" then { return "ok" }
  let count = to_float(json_get(rows[0], "c", "0"))
  if count >= limit then { return "limited" }
  return "ok"
}

pattern RecordRateLimitCall(provider: String) -> String {
  let _ = db_execute("INSERT INTO rate_limits (provider, created_at) VALUES (?, datetime('now'))", [provider])
  let _ = try db_execute("DELETE FROM rate_limits WHERE created_at < datetime('now', '-2 minutes')", [])
  return "ok"
}

pattern SetProviderRateLimit(provider: String, limit: String) -> String {
  let _ = kv_set("rate_limit:" + provider, limit)
  return "ok"
}

pattern CallLLMResilient(dept: String, messages: String) -> String {
  let chain = try GetModelFallbackChain(dept)
  if to_string(chain) == "()" then { return json_encode({reply: "Error: GetModelFallbackChain crashed", model: "", tokens_in: "0", tokens_out: "0", error: "GetModelFallbackChain"}) }
  let models = try split(chain, ",")
  if to_string(models) == "()" then { return json_encode({reply: "Error: split chain crashed", model: "", tokens_in: "0", tokens_out: "0", error: "split"}) }
  let mut last_error = ""
  let mut reply = ""
  let mut used_model = ""
  let mut tokens_in = "0"
  let mut tokens_out = "0"
  let mut found = ""

  each raw_model in models {
    let model = trim(raw_model)
    if model != "" and found == "" then {
      let mut status = try IsModelCooled(model)
      if to_string(status) == "()" then { status = "available" }
      if status == "cooled" then {
        last_error = "model " + model + " cooled (3+ fails)"
      } else {
        // FOIP-003.16: Rate limit check
        let mut rl_status = try CheckRateLimit(model)
        if to_string(rl_status) == "()" then { rl_status = "ok" }
        if rl_status == "limited" then {
          last_error = "model " + model + " rate-limited"
        } else {
          let _ = try RecordRateLimitCall(model)
          let msgs_parsed = try parse_json(messages)
          if to_string(msgs_parsed) == "()" then {
            last_error = "parse_json(messages) crashed"
          } else {
            let body = try json_encode({dept: dept, messages: msgs_parsed, model_override: model})
            if to_string(body) == "()" then {
              last_error = "json_encode body crashed"
            } else {
              let result = try http_post("http://127.0.0.1:4000/ask", body, "application/json", 240.0)
              if to_string(result) == "()" then {
                last_error = "no response from " + model
                let _ = try MarkModelFail(model)
              } else {
                let parsed = try parse_json(result)
                if to_string(parsed) == "()" then {
                  last_error = "parse error from " + model
                  let _ = try MarkModelFail(model)
                } else {
                  let r = to_string(try json_get(parsed, "reply", ""))
                  if r == "" or r == "()" then {
                    last_error = "empty reply from " + model
                    let _ = try MarkModelFail(model)
                  } else {
                    reply = r
                    used_model = to_string(try json_get(parsed, "model", model))
                    tokens_in = to_string(try json_get(parsed, "tokens_in", "0"))
                    tokens_out = to_string(try json_get(parsed, "tokens_out", "0"))
                    let _ = try ClearModelFails(model)
                    found = "yes"
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Clear tier after use
  let _ = kv_set("query_tier", "")

  if reply == "" then {
    return json_encode({reply: "Error: all models failed (" + last_error + "). Try again later.", model: "", tokens_in: "0", tokens_out: "0", error: last_error})
  }
  return json_encode({reply: reply, model: used_model, tokens_in: tokens_in, tokens_out: tokens_out})
}

// ── FOIP-003.3: Token Metering ──
pattern LogTokenUsage(chat_id: String, dept: String, model: String, tokens_in: String, tokens_out: String) -> String {
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let _ = LogSessionEvent(chat_id, "token_usage", dept, "", model, tokens_in, tokens_out)
  let _ = db_execute("INSERT INTO daily_stats (date, dept, model, total_calls, total_tokens_in, total_tokens_out) VALUES (?, ?, ?, 1, ?, ?) ON CONFLICT(date, dept, model) DO UPDATE SET total_calls = total_calls + 1, total_tokens_in = total_tokens_in + ?, total_tokens_out = total_tokens_out + ?", [today, dept, model, tokens_in, tokens_out, tokens_in, tokens_out])
  return "ok"
}

pattern LogModelSuccess(chat_id: String, dept: String, model: String, tokens_in: String, tokens_out: String) -> String {
  let _ = LogTokenUsage(chat_id, dept, model, tokens_in, tokens_out)
  return "ok"
}

pattern LogModelFailure(chat_id: String, dept: String, model: String, error: String) -> String {
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let _ = LogSessionEvent(chat_id, "model_error", dept, error, model, "0", "0")
  let _ = db_execute("INSERT INTO daily_stats (date, dept, model, total_errors) VALUES (?, ?, ?, 1) ON CONFLICT(date, dept, model) DO UPDATE SET total_errors = total_errors + 1", [today, dept, model])
  return "ok"
}

// ── FOIP-003.13: Enhanced Analytics ──
pattern GetModelCostPer1M(model: String, direction: String) -> String {
  // direction: "in" or "out"
  let key = "model_cost:" + model + ":" + direction
  let val = kv_get(key)
  if val == "" then {
    if direction == "in" then { return "0.000002" }
    return "0.000006"
  }
  return val
}

pattern AggregateDailyStats() -> String {
  let rows = query("SELECT id, model, total_tokens_in, total_tokens_out FROM daily_stats WHERE estimated_cost_usd = 0.0", [])
  let updated = "0"
  each row in rows {
    let rid = to_string(json_get(row, "id", "0"))
    let m = to_string(json_get(row, "model", ""))
    let ti = to_float(json_get(row, "total_tokens_in", "0"))
    let to_ = to_float(json_get(row, "total_tokens_out", "0"))
    let cost_in_rate = to_float(GetModelCostPer1M(m, "in"))
    let cost_out_rate = to_float(GetModelCostPer1M(m, "out"))
    let cost = ti * cost_in_rate + to_ * cost_out_rate
    let _ = db_execute("UPDATE daily_stats SET estimated_cost_usd = ? WHERE id = ?", [to_string(cost), rid])
    let updated = to_string(to_float(updated) + 1.0)
  }
  return "Пересчитано строк: " + updated
}

pattern ShowStats(chat_id: String) -> String {
  let _ = InitDB()
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let _ = AggregateDailyStats()
  let rows = query("SELECT dept, SUM(total_calls) as calls, SUM(total_tokens_in) as ti, SUM(total_tokens_out) as to_, SUM(total_errors) as errs, SUM(estimated_cost_usd) as cost FROM daily_stats WHERE date = ? GROUP BY dept ORDER BY calls DESC", [today])
  if length(rows) == 0.0 then { return "Статистика за сегодня (" + today + ") пуста." }
  let out = "Статистика за " + today + "\n"
  let out = out + "==============================\n"
  let grand_calls = 0.0
  let grand_ti = 0.0
  let grand_to = 0.0
  let grand_errs = 0.0
  let grand_cost = 0.0
  each row in rows {
    let d = to_string(json_get(row, "dept", "?"))
    let c = to_float(json_get(row, "calls", "0"))
    let ti = to_float(json_get(row, "ti", "0"))
    let to_ = to_float(json_get(row, "to_", "0"))
    let e = to_float(json_get(row, "errs", "0"))
    let cost = to_float(json_get(row, "cost", "0"))
    let grand_calls = grand_calls + c
    let grand_ti = grand_ti + ti
    let grand_to = grand_to + to_
    let grand_errs = grand_errs + e
    let grand_cost = grand_cost + cost
    let err_str = to_string(to_int(e))
    if e > 0.0 then { let err_str = "! " + err_str }
    let out = out + d + ": " + to_string(to_int(c)) + " calls | " + to_string(to_int(ti)) + "+" + to_string(to_int(to_)) + " tokens | " + err_str + " errors\n"
  }
  let out = out + "==============================\n"
  let out = out + "TOTAL: " + to_string(to_int(grand_calls)) + " calls | " + to_string(to_int(grand_ti)) + "+" + to_string(to_int(grand_to)) + " tokens | " + to_string(to_int(grand_errs)) + " errors\n"
  return out
}

pattern ShowCosts(chat_id: String) -> String {
  let _ = InitDB()
  let _ = AggregateDailyStats()
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let rows = query("SELECT model, SUM(total_calls) as calls, SUM(total_tokens_in) as ti, SUM(total_tokens_out) as to_, SUM(estimated_cost_usd) as cost FROM daily_stats WHERE date = ? GROUP BY model ORDER BY cost DESC", [today])
  if length(rows) == 0.0 then { return "Данных о расходах за сегодня нет." }
  let out = "Расходы за " + today + "\n"
  let out = out + "==============================\n"
  let total_cost = 0.0
  let total_calls = 0.0
  let total_tokens = 0.0
  each row in rows {
    let m = to_string(json_get(row, "model", "?"))
    let c = to_float(json_get(row, "calls", "0"))
    let ti = to_float(json_get(row, "ti", "0"))
    let to_ = to_float(json_get(row, "to_", "0"))
    let cost = to_float(json_get(row, "cost", "0"))
    let total_cost = total_cost + cost
    let total_calls = total_calls + c
    let total_tokens = total_tokens + ti + to_
    let out = out + m + ": " + to_string(to_int(c)) + " calls | " + to_string(to_int(ti + to_)) + " tokens | ~$" + to_string(cost) + "\n"
  }
  let out = out + "==============================\n"
  let out = out + "TOTAL: ~$" + to_string(total_cost) + " | " + to_string(to_int(total_calls)) + " calls | " + to_string(to_int(total_tokens)) + " tokens\n"
  // Last 7 days trend
  let trend_rows = query("SELECT date, SUM(estimated_cost_usd) as cost, SUM(total_calls) as calls FROM daily_stats GROUP BY date ORDER BY date DESC LIMIT 7", [])
  if length(trend_rows) > 0.0 then {
    let out = out + "\nLast 7 days:\n"
    each tr in trend_rows {
      let td = to_string(json_get(tr, "date", "?"))
      let tc = to_string(json_get(tr, "cost", "0"))
      let tcl = to_string(to_int(to_float(json_get(tr, "calls", "0"))))
      let out = out + "  " + td + ": ~$" + tc + " (" + tcl + " calls)\n"
    }
  }
  return out
}

// ── FOIP-003.4: Smart Model Routing — stats-aware fallback ──
pattern GetModelErrorRate(model: String) -> String {
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let rows = query("SELECT total_calls, total_errors FROM daily_stats WHERE date = ? AND model = ?", [today, model])
  if length(rows) == 0.0 then { return "0" }
  let calls = to_int(json_get(rows[0], "total_calls", "0"))
  let errors = to_int(json_get(rows[0], "total_errors", "0"))
  if calls == 0 then { return "0" }
  return to_string(to_float(errors) / to_float(calls) * 100.0)
}

pattern RecordModelResult(dept: String, model: String, success: String) -> String {
  if success != "ok" then {
    let _ = LogModelFailure(dept, dept, model, "fallback triggered")
  }
  return "ok"
}

// ── FOIP-003.5: Context Compaction ──
pattern EstimateTokens(text: String) -> String {
  return to_string(length(text) / 4.0)
}

pattern GetCompactedHistory(chat_id: String, limit: String) -> String {
  let total_rows = query("SELECT COUNT(*) as cnt FROM dialog_history WHERE chat_id = ?", [chat_id])
  let total = to_int(json_get(total_rows[0], "cnt", "0"))
  let lim = to_int(limit)
  if total <= lim * 2 then {
    return GetRecentDialog(chat_id, limit)
  }
  let early_rows = query("SELECT role, content FROM dialog_history WHERE chat_id = ? ORDER BY created_at ASC LIMIT 3", [chat_id])
  let recent_rows = query("SELECT role, content FROM dialog_history WHERE chat_id = ? ORDER BY created_at DESC LIMIT ?", [chat_id, limit])
  let out = ""
  each row in early_rows {
    let role = to_string(json_get(row, "role", ""))
    let content = to_string(json_get(row, "content", ""))
    if length(content) > 300.0 then { let content = substring(content, 0.0, 300.0) + "..." }
    let out = out + role + ": " + content + "\n"
  }
  let skipped = total - 3 - lim
  if skipped > 0 then {
    let out = out + "\n[... " + to_string(skipped) + " messages skipped for context economy ...]\n\n"
  }
  each row in recent_rows {
    let role = to_string(json_get(row, "role", ""))
    let content = to_string(json_get(row, "content", ""))
    let out = out + role + ": " + content + "\n"
  }
  return out
}

// ── FOIP-003.6: Three input channels (followup/steer/inject) ──
pattern InjectContext(target_dept: String, context_text: String) -> String {
  let existing = kv_get("inject:" + target_dept)
  if existing != "" then {
    let _ = kv_set("inject:" + target_dept, existing + "\n---\n" + context_text)
  } else {
    let _ = kv_set("inject:" + target_dept, context_text)
  }
  return "ok"
}

pattern GetInjectedContext(dept: String) -> String {
  let ctx = kv_get("inject:" + dept)
  if ctx != "" then {
    let _ = kv_set("inject:" + dept, "")
  }
  return ctx
}

pattern SteerDept(dept: String, correction: String) -> String {
  let _ = kv_set("steer:" + dept, correction)
  return "ok"
}

pattern GetSteerContext(dept: String) -> String {
  let ctx = kv_get("steer:" + dept)
  if ctx != "" then {
    let _ = kv_set("steer:" + dept, "")
  }
  return ctx
}


pattern IsImageRequest(text: String) -> String {
  // Returns "true" if text asks for image generation, "" otherwise
  let t = lower(text)
  if contains(t, "сгенерируй изображен") then { return "true" }
  if contains(t, "сгенерируй картинк") then { return "true" }
  if contains(t, "нарисуй") then { return "true" }
  if contains(t, "создай изображен") then { return "true" }
  if contains(t, "создай картинк") then { return "true" }
  if contains(t, "generate image") then { return "true" }
  if contains(t, "create image") then { return "true" }
  if contains(t, "нарисуй логотип") then { return "true" }
  if contains(t, "сделай иллюстрац") then { return "true" }
  if contains(t, "сгенерируй логотип") then { return "true" }
  if contains(t, "generate logo") then { return "true" }
  if contains(t, "create logo") then { return "true" }
  if contains(t, "нарисуй иконк") then { return "true" }
  if contains(t, "нарисуй постер") then { return "true" }
  if contains(t, "сделай обложк") then { return "true" }
  return ""
}

pattern HandleDesignImage(prompt: String, chat_id: String) -> String {
  // Call /generate-image endpoint — it generates and sends photo to Telegram
  let body = json_encode({prompt: prompt, chat_id: to_float(chat_id)})
  let result = try http_post("http://127.0.0.1:4000/generate-image", body, "application/json", 180.0)
  if to_string(result) == "()" then {
    let _ = SendTelegramReply(chat_id, "Ошибка: генерация изображений недоступна.")
    return ""
  }
  let parsed = parse_json(result)
  let status = json_get(parsed, "status", "error")
  if status == "ok" then {
    return ""
  } else {
    let err = json_get(parsed, "error", "Unknown error")
    return "Ошибка генерации: " + err
  }
}

// ============================================================
// INLINED from dept/context.mlog (bypass binary import caching)
// ============================================================

pattern BuildContext(dept: String, query: String, chat_id: String) -> String {
  let profile = ReadDeptProfile(dept)

  // OSP: use tier-based skill loading (LoadOspSkills), format from deconstruct skill
  let skills = ""
  if dept == "osp" then {
    let skills = LoadOspSkills(query)
  } else {
    let skills = SelectSkillsByKeywords(dept, query)
  }

  let corrections = GetCorrections(dept)
  // FOIP-003.6: Cross-dept inject + mid-turn steer
  let injected = GetInjectedContext(dept)
  let steer = GetSteerContext(dept)
  // IDEA-4: Context Budget — use budgeted history (max 4000 tokens)
  let dialog = GetBudgetedHistory(chat_id, "10", "4000")
  let memories = YanaRecallMemories(query)
  let now_info = YanaNowInfo()

  // IDEA-1: Read consensus memory (cross-session baton)
  let consensus = ReadConsensus()
  // IDEA-2: Recall past learnings for this dept+query
  let learnings = RecallLearnings(dept, query)
  // FO-019: Owner Profile — static/dynamic/buckets одним вызовом
  let owner_profile = GetOwnerProfile(dept)
  // IDEA-5: Expert Persona Injection
  let mut persona = ""
  if dept != "yana" then { let persona = GetExpertPersona(dept) }
  // IDEA-6: Brand Contract for design dept
  let mut brand = ""
  if dept == "design" then { let brand = GetBrandContract() }
  // IDEA-7: Sub-Agent resolution
  let sub_agent = ResolveSubAgent(dept, query)

  // Fresh news for OSP and LZ departments
  let news = ""
  if dept == "osp" or dept == "lz" then {
    let news_body = json_encode({query: query, dept: dept, limit: 5})
    let news_result = try http_post("http://127.0.0.1:4000/news/fresh", news_body, "application/json")
    if to_string(news_result) != "()" then {
      let news_parsed = try parse_json(news_result)
      if to_string(news_parsed) != "()" then {
        let news = json_get(news_parsed, "news", "")
      }
    }
  }

  // Guard all context variables against Unit from try
  let s_memories = to_string(memories)
  if s_memories == "()" then { let s_memories = "" }
  let s_corrections = to_string(corrections)
  if s_corrections == "()" then { let s_corrections = "" }
  let s_dialog = to_string(dialog)
  if s_dialog == "()" then { let s_dialog = "" }
  let s_now = to_string(now_info)
  if s_now == "()" then { let s_now = "" }
  let s_skills = to_string(skills)
  if s_skills == "()" then { let s_skills = "" }
  let s_injected = to_string(injected)
  if s_injected == "()" then { let s_injected = "" }
  let s_steer = to_string(steer)
  if s_steer == "()" then { let s_steer = "" }
  let s_persona = to_string(persona)
  if s_persona == "()" then { let s_persona = "" }
  let s_brand = to_string(brand)
  if s_brand == "()" then { let s_brand = "" }
  let s_consensus = to_string(consensus)
  if s_consensus == "()" then { let s_consensus = "" }
  let s_learnings = to_string(learnings)
  if s_learnings == "()" then { let s_learnings = "" }
  let s_owner_profile = to_string(owner_profile)
  if s_owner_profile == "()" then { let s_owner_profile = "" }
  let s_sub_agent = to_string(sub_agent)
  if s_sub_agent == "()" then { let s_sub_agent = "" }
  let context = profile + "\n\n=== Текущая дата и время ===\n" + s_now + "\n\n=== Active Skills ===\n" + s_skills + "\n\n=== Corrections ===\n" + s_corrections + "\n\n=== Cross-dept Context ===" + s_injected + "\n\n=== Steering ===" + s_steer + "\n\n=== Long-term Memory ===\n" + s_memories + "\n\n=== Recent Dialog ===\n" + s_dialog

  // IDEA-5/6/7: Append persona, brand, sub-agent if present
  if s_persona != "" then { let context = context + "\n\n" + s_persona }
  if s_brand != "" then { let context = context + "\n\n" + s_brand }
  if s_sub_agent != "" then { let context = context + "\n\n=== Sub-Agent Specialization ===\nТы работаешь в роли суб-агента: " + s_sub_agent + ". Применяй специализацию этого под-роли."
  }
  // IDEA-1/2: Append consensus and learnings
  if s_consensus != "" then { let context = context + "\n\n=== Cross-Session Consensus (baton) ===\n" + s_consensus }
  if s_learnings != "" then { let context = context + "\n\n" + s_learnings }
  // FO-019: профиль владельца одним вызовом (вместо ad-hoc сборки)
  if s_owner_profile != "" then { let context = context + "\n\n" + s_owner_profile }

  // Append fresh news if available
  if news != "" then {
  // FOIP-003.10: Product context for marketing dept
  if dept == "marketing" then {
    let pc = kv_get("product_context:" + chat_id)
    if pc == "" then { let pc = kv_get("product_context:default") }
    if to_string(pc) != "()" then {
      if pc != "" then {
        let context = context + "\n\n=== Product Context ===\n" + pc
      }
    }
  }
    let context = context + "\n\n" + news + "\nУчитывай эти свежие события в своём анализе. Ссылайся на них если релевантны."
  }

  // Дублируем дату в самый конец контекста — чтобы LLM не забыл после 25K навыков
  if dept == "osp" then {
    let context = context + "\n\n=== ПОВТОР: ТЕКУЩАЯ ДАТА ===\n" + now_info + "\nВНИМАНИЕ: Все даты в препарировании, ID, прогнозы и индикаторы должны привязываться к этой дате. Запрещено использовать любые другие даты как текущие. Если в АРХИВЕ ПРОШЛЫХ СЕССИЙ есть похожее препарирование — это НЕ образец для переписывания. Проведи НОВЫЙ анализ на текущую дату с актуальными событиями. Дата в шапке, ID, все индикаторы и даты проверки — считай ТОЛЬКО от текущей даты, никогда от даты старого отчёта. КРИТИЧНО: дату в шапке отчёта («Дата препарирования», «Сейчас») копируй ПОСИМВОЛЬНО из значения выше, точь-в-точь, без округления, без сдвига на дни, без «примерно»."
  }

  // FORMAT_INSTRUCTION — ONLY for expert (OSP gets format from deconstruct skill)
  if dept == "expert" then {
    let format_instruction = "\n\n## ФОРМАТ ОТВЕТА (ОБЯЗАТЕЛЬНО)\n\nОтвечай РАЗВЁРНУТО. Ты — Эксперт, подготовка к встрече/переговорам. Структура:\n\n1. *Профиль контрагента* — кто, что, позиция на рынке, ключевые фигуры, масштаб\n2. *Контекст встречи* — цель, формат, участники с каждой стороны, история отношений\n3. *Ключевые факты и цифры* — что нужно знать перед встречей: рыночные данные, финансовые показатели, последние новости, публичные заявления\n4. *Позиция и рычаги* — их вероятная позиция, наши рычаги, их рычаги, зона возможного соглашения (ZOPA)\n5. *Боевые вопросы* — 7-10 вопросов для встречи: проверяющие, прощупывающие, сигнальные. Каждый вопрос с ожидаемым ответом (хороший/уклончивый/тревожный) и логикой: зачем задаём\n6. *Красные флаги* — на что обратить внимание: манипуляции, скрытые мотивы, противоречия в публичной информации\n7. *Рекомендуемая стратегия* — подход к переговорам, точки давления, готовность к компромиссу, BATNA\n8. *Decision points* — какие решения должны быть приняты на встрече, кто их принимает\n\nМаркируй уверенность: [ФАКТ] — подтверждённые данные, [ОЦЕНКА] — экспертная оценка, [РИСК] — потенциальная проблема.\nЯзык: русский. Не будь кратким. Препарируй встречу глубоко.\n"
    let context = context + format_instruction
  }

  return context
}

// ── FO-019: Owner Profile (static/dynamic/buckets, один вызов) ──
// Метафильтр dept: питон-сайд приоритизирует buckets по интересам департамента.
// Best-effort: отказ/таймаут прокси → пустая строка, диалог не блокируется.
pattern GetOwnerProfile(dept: String) -> String {
  let body = json_encode({dept: dept})
  let resp = try http_post("http://127.0.0.1:4000/profile/owner", body, "application/json", 3.0)
  if to_string(resp) == "()" then { return "" }
  let parsed = try parse_json(resp)
  if to_string(parsed) == "()" then { return "" }
  return to_string(json_get(parsed, "profile", ""))
}

pattern ReadDeptProfile(dept: String) -> String {
  let cached = kv_get("fc_profile_" + dept)
  if cached != "" then { return cached }
  let content = read_file("library/" + dept + ".md")
  if content != "" then { return content }
  return "Department: " + dept + ". Act professionally."
}

// Skill loading for non-OSP departments — two-phase approach (WH-4):
// Phase 1: core skills (first 3 in index) always loaded — guarantees dept always has guidance
// Phase 2: remaining skills matched by query keywords appearing in skill content
// Budget: 80000 chars (was 2000), per-skill limit: 15000 chars (was 500)
pattern SelectSkillsByKeywords(dept: String, query: String) -> String {
  let index_content = read_file("skills_index/" + dept + ".txt")
  if index_content == "" then { return "No skills loaded." }
  let _nl = "\n"
  let _sp = " "
  let skills_list = split(trim(index_content), _nl)
  let result = ""
  let budget = 80000.0
  let skill_limit = 15000.0
  let core_count = 3.0
  let i = 0.0

  // Extract up to 6 significant keywords (>= 4 chars) from query for matching
  let t = lower(query)
  let words = split(t, _sp)
  let mut kw0 = ""
  let mut kw1 = ""
  let mut kw2 = ""
  let mut kw3 = ""
  let mut kw4 = ""
  let mut kw5 = ""
  let mut wi = 0.0
  each w in words {
    if length(w) >= 4.0 then {
      if wi == 0.0 then { kw0 = w }
      if wi == 1.0 then { kw1 = w }
      if wi == 2.0 then { kw2 = w }
      if wi == 3.0 then { kw3 = w }
      if wi == 4.0 then { kw4 = w }
      if wi == 5.0 then { kw5 = w }
      wi = wi + 1.0
    }
  }

  each skill in skills_list {
    if length(result) < budget then {
      let skill_name = trim(skill)
      let skill_content = read_file("skills/" + skill_name + "/SKILL.md")
      if skill_content != "" then {
        if i < core_count then {
          // Phase 1: core skills always loaded
          let result = result + "\n--- " + skill_name + " ---\n" + substring(skill_content, 0.0, skill_limit)
        } else {
          // Phase 2: match by any query keyword appearing in skill content
          let sc = lower(skill_content)
          if (kw0 != "" and contains(sc, kw0)) or (kw1 != "" and contains(sc, kw1)) or (kw2 != "" and contains(sc, kw2)) or (kw3 != "" and contains(sc, kw3)) or (kw4 != "" and contains(sc, kw4)) or (kw5 != "" and contains(sc, kw5)) then {
            let result = result + "\n--- " + skill_name + " ---\n" + substring(skill_content, 0.0, skill_limit)
          }
        }
      }
    }
    let i = i + 1.0
  }
  if result == "" then { return "Skills available for " + dept + ": " + index_content }
  return result
}

// ── OSP tier-based skill loading (confirmed builtins only) ──
// Tier 1 always, Tier 2 by topic triggers, Tier 3 by explicit triggers.
// Budget: 25000 chars total. Path: skills/<name>/SKILL.md (flat, no osp/ subdir).
pattern LoadOspSkills(query: String) -> String {
  let t = lower(query)
  let mut result = ""
  let mut budget = 25000.0

  // ── Tier 1: Methodological core (always) ──
  let s = read_file("skills/deconstruct/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- deconstruct ---\n" + s }
  let s = read_file("skills/awareness-frame/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- awareness-frame ---\n" + s }
  let s = read_file("skills/root-cause-mapping/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- root-cause-mapping ---\n" + s }
  let s = read_file("skills/forces-and-potentials/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- forces-and-potentials ---\n" + s }
  let s = read_file("skills/strategic-maneuvers/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- strategic-maneuvers ---\n" + s }
  let s = read_file("skills/two-paths-synthesis/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- two-paths-synthesis ---\n" + s }
  let s = read_file("skills/decision-tree-forecast/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- decision-tree-forecast ---\n" + s }
  let s = read_file("skills/reflexive-impact/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- reflexive-impact ---\n" + s }
  let s = read_file("skills/calibration/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- calibration ---\n" + s }
  let s = read_file("skills/system-health-diagnostics/SKILL.md")
  if s != "" and length(result) < budget then { result = result + "\n--- system-health-diagnostics ---\n" + s }

  // ── Tier 2: Domain depth (by topic triggers) ──
  // Finance / markets
  if (contains(t, "рынок") or contains(t, "актив") or contains(t, "валют") or contains(t, "акци") or contains(t, "облигац") or contains(t, "крипто") or contains(t, "нефт") or contains(t, "gold") or contains(t, "золот")) and length(result) < budget then {
    let s = read_file("skills/cross-asset-divergence/SKILL.md")
    if s != "" then { result = result + "\n--- cross-asset-divergence ---\n" + s }
  }
  if (contains(t, "рынок") or contains(t, "актив") or contains(t, "валют") or contains(t, "крипто") or contains(t, "нефт")) and length(result) < budget then {
    let s = read_file("skills/macro-regime-id/SKILL.md")
    if s != "" then { result = result + "\n--- macro-regime-id ---\n" + s }
    let s = read_file("skills/cantillon/SKILL.md")
    if s != "" then { result = result + "\n--- cantillon ---\n" + s }
  }
  // Person / leader
  if (contains(t, "персона") or contains(t, "лидер") or contains(t, "президент") or contains(t, "глава") or contains(t, "министр") or contains(t, "губернатор") or contains(t, "ceo") or contains(t, "исчез")) and length(result) < budget then {
    let s = read_file("skills/deep-profiling/SKILL.md")
    if s != "" then { result = result + "\n--- deep-profiling ---\n" + s }
  }
  // Narrative / media
  if (contains(t, "нарратив") or contains(t, "пропаганд") or contains(t, "заявлен") or contains(t, "сми") or contains(t, "media") or contains(t, "информаци")) and length(result) < budget then {
    let s = read_file("skills/narrative-vs-flows/SKILL.md")
    if s != "" then { result = result + "\n--- narrative-vs-flows ---\n" + s }
  }
  // Sources / verification
  if (contains(t, "источник") or contains(t, "проверь") or contains(t, "правда") or contains(t, "фактчек")) and length(result) < budget then {
    let s = read_file("skills/source-triangulation/SKILL.md")
    if s != "" then { result = result + "\n--- source-triangulation ---\n" + s }
  }
  // Investment / risk
  if (contains(t, "ставк") or contains(t, "инвестиц") or contains(t, "риск") or contains(t, "портфель") or contains(t, "хедж")) and length(result) < budget then {
    let s = read_file("skills/asymmetric-bet-structure/SKILL.md")
    if s != "" then { result = result + "\n--- asymmetric-bet-structure ---\n" + s }
    let s = read_file("skills/antifragility-design/SKILL.md")
    if s != "" then { result = result + "\n--- antifragility-design ---\n" + s }
  }
  // Cycles
  if (contains(t, "цикл") or contains(t, "фаза") or contains(t, "перелом") or contains(t, "кондратьев") or contains(t, "juglar")) and length(result) < budget then {
    let s = read_file("skills/cycle-position/SKILL.md")
    if s != "" then { result = result + "\n--- cycle-position ---\n" + s }
  }
  // I&W
  if (contains(t, "индикатор") or contains(t, "наблюден") or contains(t, "watch") or contains(t, "тревог")) and length(result) < budget then {
    let s = read_file("skills/iw-watchlist/SKILL.md")
    if s != "" then { result = result + "\n--- iw-watchlist ---\n" + s }
  }

  // ── Tier 3: Special techniques (explicit triggers) ──
  if (contains(t, "война") or contains(t, "армия") or contains(t, "фронт") or contains(t, "наступлен") or contains(t, "воен")) and length(result) < budget then {
    let s = read_file("skills/order-of-battle/SKILL.md")
    if s != "" then { result = result + "\n--- order-of-battle ---\n" + s }
  }
  if (contains(t, "коллапс") or contains(t, "обвал") or contains(t, "транзит") or contains(t, "фазов")) and length(result) < budget then {
    let s = read_file("skills/phase-transition-detection/SKILL.md")
    if s != "" then { result = result + "\n--- phase-transition-detection ---\n" + s }
  }
  if (contains(t, "переговор") or contains(t, "коалиц") or contains(t, "консенсус")) and length(result) < budget then {
    let s = read_file("skills/schelling-points/SKILL.md")
    if s != "" then { result = result + "\n--- schelling-points ---\n" + s }
  }
  if (contains(t, "контр") or contains(t, "redteam") or contains(t, "red-team") or contains(t, "слеп")) and length(result) < budget then {
    let s = read_file("skills/red-team/SKILL.md")
    if s != "" then { result = result + "\n--- red-team ---\n" + s }
  }

  if result == "" then { return "No OSP skills loaded." }
  return result
}

pattern CompressDialog(chat_id: String) -> String {
  let rows = query("SELECT COUNT(*) as cnt FROM dialog_history WHERE chat_id = ?", [chat_id])
  return "ok"
}

