  db_execute("CREATE TABLE IF NOT EXISTS security_audits (id INTEGER PRIMARY KEY AUTOINCREMENT, audit_type TEXT, created_at TEXT DEFAULT (datetime('now')), findings_critical TEXT, findings_high TEXT, findings_low TEXT, findings_medium TEXT, project TEXT, status TEXT, updated_at TEXT DEFAULT (datetime('now')), completed_at TEXT, summary TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS qa_assessments (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), full_result TEXT, project TEXT, short_title TEXT, status TEXT, test_type TEXT, updated_at TEXT DEFAULT (datetime('now')), verification_date TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS cross_dept_tasks (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), reference_id TEXT, severity TEXT, source_dept TEXT, status TEXT, summary TEXT, target_dept TEXT, task_type TEXT)")
  // Dev (5) — dept/dev.mlog: tech_radar_entries, architecture_decisions,
  //   code_repositories, dev_estimate_verifications, dev_rule_violations.
  db_execute("CREATE TABLE IF NOT EXISTS tech_radar_entries (id INTEGER PRIMARY KEY AUTOINCREMENT, category TEXT, created_at TEXT DEFAULT (datetime('now')), description TEXT, name TEXT, radar_state TEXT, rationale TEXT, updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS architecture_decisions (id INTEGER PRIMARY KEY AUTOINCREMENT, alternatives TEXT, consequences TEXT, context TEXT, created_at TEXT DEFAULT (datetime('now')), decision TEXT, status TEXT, task_id TEXT, title TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS code_repositories (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), has_ci TEXT, has_gitignore TEXT, has_license TEXT, has_readme TEXT, name TEXT, storage_primary TEXT, task_type TEXT, url TEXT)")
