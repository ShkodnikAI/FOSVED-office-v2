// YANA HANDLER — INLINED v7.0 (CallLLMProxy for metadata, 8 hard gates, NO disclaimer)
// ============================================================

// ── Disclaimer removed per owner request ──
pattern YanaDisclaimer() -> String {
  return ""
}

pattern YanaWrapWithDisclaimer(text: String) -> String {
  return text
}

// ═══════════════════════════════════════════════════════════════════════
// HARD GATES — 8 non-negotiable constraints for Yana (Шеф де кабинет)
// Violation → immediate rejection + AuditLog. No LLM override.
// Based on yana.md "Жёсткие правила" + skill definitions
// ═══════════════════════════════════════════════════════════════════════

// Gate 1: No false confirmation — Яна не выполняет действий сама.
pattern YanaGateNoFalseConfirmation(reply: String) -> String {
  let r = lower(reply)
  if contains(r, "удалила все") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 1: false confirmation 'удалила все'")
    return "ОТКАЗ: Яна не выполняет удаление напрямую. Хозяин: используйте /remind clear."
  }
  if contains(r, "я удалила") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 1: false confirmation 'я удалила'")
    return "ОТКАЗ: Яна не подтверждает удаление, которое не выполняла."
  }
  if contains(r, "я очистила") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 1: false confirmation 'я очистила'")
    return "ОТКАЗ: Яна не подтверждает очистку, которую не выполняла."
  }
  if contains(r, "я отправила") and contains(r, "напоминани") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 1: false confirmation 'я отправила напоминание'")
    return "ОТКАЗ: Отправку напоминаний делает система, не Яна."
  }
  if contains(r, "я создала") and contains(r, "задач") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 1: false confirmation 'я создала задачу'")
    return "ОТКАЗ: Яна не имеет системы трекинга задач для создания."
  }
  if contains(r, "записала в базу") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 1: false confirmation 'записала в базу'")
    return "ОТКАЗ: Запись в базу делает система автоматически, не Яна."
  }
  return "PASS"
}

// Gate 2: Delegation integrity — [DELEGATE: slug] must target valid department
pattern YanaGateDelegationIntegrity(reply: String) -> String {
  if contains(reply, "[DELEGATE:") == false then { return "PASS" }
  if contains(reply, "[DELEGATE: osp]") then { return "PASS" }
  if contains(reply, "[DELEGATE: lz]") then { return "PASS" }
  if contains(reply, "[DELEGATE: expert]") then { return "PASS" }
  if contains(reply, "[DELEGATE: marketing]") then { return "PASS" }
  if contains(reply, "[DELEGATE: finance]") then { return "PASS" }
  if contains(reply, "[DELEGATE: legal]") then { return "PASS" }
  if contains(reply, "[DELEGATE: dev]") then { return "PASS" }
  if contains(reply, "[DELEGATE: design]") then { return "PASS" }
  if contains(reply, "[DELEGATE: qa]") then { return "PASS" }
  if contains(reply, "[DELEGATE: visual]") then { return "PASS" }
  if contains(reply, "[DELEGATE: engineering]") then { return "PASS" }
  if contains(reply, "[DELEGATE: kavalnya]") then { return "PASS" }
  if contains(reply, "[DELEGATE: admin]") then { return "PASS" }
  let _ = AuditLog("hard_gate_violation", "yana", "Gate 2: invalid delegation target in [DELEGATE]")
  return "ОТКАЗ: Недопустимый отдел делегирования. Яна может делегировать только: osp, lz, expert, marketing, finance, legal, dev, design, qa, visual, engineering, kavalnya, admin."
}

// Gate 3: REMIND format validation — [REMIND: type|param|text] must match spec
pattern YanaGateRemindFormat(reply: String) -> String {
  if contains(reply, "[REMIND:") == false then { return "PASS" }
  if contains(reply, "[REMIND: once|") then { return "PASS" }
  if contains(reply, "[REMIND: daily|") then { return "PASS" }
  if contains(reply, "[REMIND: weekly|") then { return "PASS" }
  if contains(reply, "[REMIND: yearly|") then { return "PASS" }
  if contains(reply, "[REMIND: in|") then { return "PASS" }
  let _ = AuditLog("hard_gate_violation", "yana", "Gate 3: invalid [REMIND] format")
  return "ОТКАЗ: Неверный формат [REMIND]. Допустимые типы: once, daily, weekly, yearly, in. Формат: [REMIND: тип|параметр|текст]"
}

// Gate 4: TTS compatibility — no emojis that break voice output
pattern YanaGateTTSCompatibility(reply: String) -> String {
  if contains(reply, "✅") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 4: TTS incompatible — emoji")
    return "ОТКАЗ: Эмодзи запрещены (TTS-несовместимо). Используйте текст: ГОТОВО, ВНИМАНИЕ, БЛОКЕР."
  }
  if contains(reply, "❌") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 4: TTS incompatible — emoji")
    return "ОТКАЗ: Эмодзи запрещены (TTS-несовместимо). Используйте текст."
  }
  if contains(reply, "⚠") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 4: TTS incompatible — emoji")
    return "ОТКАЗ: Эмодзи запрещены (TTS-несовместимо). Используйте: ВНИМАНИЕ."
  }
  return "PASS"
}

// Gate 5: No meta-exit from role — Яна не обсуждает свою AI-природу
pattern YanaGateNoMetaExit(reply: String) -> String {
  let r = lower(reply)
  if contains(r, "я не настоящая") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 5: meta-exit")
    return "ОТКАЗ: Яна не обсуждает свою техническую природу. Это нарушение роли."
  }
  if contains(r, "я демо-версия") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 5: meta-exit")
    return "ОТКАЗ: Яна не обсуждает свою техническую природу. Это нарушение роли."
  }
  if contains(r, "я симуляция") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 5: meta-exit")
    return "ОТКАЗ: Яна не обсуждает свою техническую природу. Это нарушение роли."
  }
  if contains(r, "у меня нет доступа к системе") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 5: meta-exit")
    return "ОТКАЗ: Яна не обсуждает свои ограничения. Используй реальные данные из секций."
  }
  return "PASS"
}

// Gate 6: No medical diagnosis — Яна не ставит диагнозы
pattern YanaGateNoMedicalDiagnosis(reply: String) -> String {
  let r = lower(reply)
  if contains(r, "диагноз:") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 6: medical diagnosis")
    return "ОТКАЗ: Яна не ставит медицинские диагнозы. Серьёзные симптомы → рекомендация обратиться к врачу."
  }
  if contains(r, "у вас ") and (contains(r, "депресси") or contains(r, "тревожн") or contains(r, "биполярн")) then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 6: medical diagnosis")
    return "ОТКАЗ: Яна не диагностирует психические состояния. Рекомендация: обратиться к психотерапевту или психиатру."
  }
  if contains(r, "назначаю лечение") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 6: medical prescription")
    return "ОТКАЗ: Яна не назначает лечение. Только врач может назначать препараты."
  }
  return "PASS"
}

// Gate 7: Owner shielding — raw panic must not reach owner unprocessed
pattern YanaGateOwnerShielding(reply: String) -> String {
  let r = lower(reply)
  if contains(r, "всё сломалось") and contains(r, "срочно") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 7: raw panic not filtered")
    return "ОТКАЗ: Сырой сигнал паники от отдела не доходит до хозяина. Яна обрабатывает: причина + что сделано + варианты + рекомендация."
  }
  if contains(r, "всё плохо") and contains(r, "помогите") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 7: raw panic not filtered")
    return "ОТКАЗ: Необработанная проблема не доходит до хозяина. Яна формирует связный пакет: что случилось + кто отвечает + варианты + срочность."
  }
  return "PASS"
}

// Gate 8: No task hallucination — Яна не выдумывает статусы задач
pattern YanaGateNoTaskHallucination(reply: String) -> String {
  let r = lower(reply)
  if contains(r, "в процессе") and contains(r, "отдел ") and contains(r, "работает над") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 8: task hallucination")
    return "ОТКАЗ: Яна не имеет системы трекинга задач. Если нет данных в памяти — так и сказать: нет информации о статусе задачи."
  }
  if contains(r, "выполнено") and contains(r, "отделом") then {
    let _ = AuditLog("hard_gate_violation", "yana", "Gate 8: task hallucination")
    return "ОТКАЗ: Яна не подтверждает выполнение задач отделом без верификации."
  }
  return "PASS"
}

// ── Gate Enforcement Wrapper ─────────────────────────────────────────
pattern YanaEnforceGates(query: String, outputText: String, chat_id: String) -> String {
  let g1 = YanaGateNoFalseConfirmation(outputText)
  if g1 != "PASS" then { return g1 }
  let g2 = YanaGateDelegationIntegrity(outputText)
  if g2 != "PASS" then { return g2 }
  let g3 = YanaGateRemindFormat(outputText)
  if g3 != "PASS" then { return g3 }
  let g4 = YanaGateTTSCompatibility(outputText)
  if g4 != "PASS" then { return g4 }
  let g5 = YanaGateNoMetaExit(outputText)
  if g5 != "PASS" then { return g5 }
  let g6 = YanaGateNoMedicalDiagnosis(outputText)
  if g6 != "PASS" then { return g6 }
  let g7 = YanaGateOwnerShielding(outputText)
  if g7 != "PASS" then { return g7 }
  let g8 = YanaGateNoTaskHallucination(outputText)
  if g8 != "PASS" then { return g8 }
  return "PASS"
}

pattern HandleYana(query: String, chat_id: String) -> String {
  let dept = "yana"
  let _ = TraceLog("yana", "step_1_before_ReadDeptProfile")
  let profile = ReadDeptProfile(dept)
  let _ = TraceLog("yana", "step_2_before_SelectSkillsByKeywords")
  let skills = SelectSkillsByKeywords(dept, query)
  let _ = TraceLog("yana", "step_3_before_GetCorrections")
  let corrections = GetCorrections(dept)
  let _ = TraceLog("yana", "step_4_before_YanaCalendar")
  let calendar = YanaCalendar()
  let _ = TraceLog("yana", "step_5_before_YanaNowInfo")
  let now_info = YanaNowInfo()
  let _ = TraceLog("yana", "step_6_before_YanaWeather")
  let weather = YanaWeather()
  let _ = TraceLog("yana", "step_7_before_GetRecentDialog")
  let dialog = GetBudgetedHistory(chat_id, "20", "6000")
  let _ = TraceLog("yana", "step_8_before_YanaRecallMemories")
  let memories = YanaRecallMemories(query)
  let _ = TraceLog("yana", "step_9_before_context_assembly")
  let mut s_memories = to_string(memories)
  if s_memories == "()" then { s_memories = "" }
  let mut s_calendar = to_string(calendar)
  if s_calendar == "()" then { s_calendar = "" }
  let mut s_weather = to_string(weather)
  if s_weather == "()" then { s_weather = "" }
  let mut s_skills = to_string(skills)
  if s_skills == "()" then { s_skills = "" }
  let mut s_corrections = to_string(corrections)
  if s_corrections == "()" then { s_corrections = "" }
  let mut s_dialog = to_string(dialog)
  if s_dialog == "()" then { s_dialog = "" }
  let facts = GetFacts("yana", "12")
  let mut s_facts = to_string(facts)
  if s_facts == "()" then { s_facts = "" }
  let mut s_now = to_string(now_info)
  if s_now == "()" then { s_now = "" }
  let anti_format = "\n\n## КРИТИЧЕСКОЕ ПРАВИЛО ФОРМАТА\nОтвечай естественным разговорным русским языком. Ты — личный помощник, НЕ аналитический отдел.\nНИКОГДА НЕ ИСПОЛЬЗУЙ: послойную структуру (Слой 1, Слой 2), маркеры ФАКТ/ИНТЕРПРЕТАЦИЯ/СПЕКУЛЯЦИЯ, секции Вердикт и Индикаторы. Не раздувай текст. Короткий вопрос — короткий ответ.\n\n## ЗАПРЕТ ГАЛЛЮЦИНАЦИИ (КРИТИЧЕСКОЕ)\nЕсли ты НЕ ЗНАЕШЬ точный ответ — говори: у меня нет этих данных. НЕ ВЫДУМЫВАЙ цифры, статусы, факты. НЕ ПРИДУМЫВАЙ активность отделов, количество диалогов, настройки системы. Если не имеет доступа к базе или метрикам в реальном времени — так и скажи. Твоя выдумка хуже чем честное незнание.\n\n## ЗАПРЕТ ЛОЖНЫХ ПОДТВЕРЖДЕНИЙ (КРИТИЧЕСКОЕ)\nТы НЕ выполняешь действий сама. Ты умеешь только ставить маркер напоминания и делегировать отделам. Всё остальное делает система по командам хозяина.\nНИКОГДА не подтверждай выполнение того, чего не делала: удалила, очистила, отправила, создала, изменила настройки, записала в базу.\nЕсли хозяин просит действие, которого ты выполнить не можешь — назови точную команду: удалить все напоминания это /remind clear, удалить одно это /remind del номер.\nЛожное подтверждение хуже отказа: хозяин будет считать задачу решённой.\n\n## ЗАДАЧИ И ТРЕКИНГ (КРИТИЧЕСКОЕ — ЧАСТАЯ ОШИБКА)\nУ тебя НЕТ системы трекинга задач. Ты НЕ МОЖЕШЬ увидеть кто над чем работает, какие задачи в статусе выполнено или в процессе. Когда хозяин спрашивает про невыполненные задания — проверяй секцию === Долгосрочная память ===. Если там пусто или нет релевантных записей о задачах — так и говори: в памяти нет записей о невыполненных заданиях. НЕ ВЫДУМЫВАЙ список задач со статусами. НЕ ПРИДУМЫВАЙ что какой-то отдел что-то делает. Делегирование работает как единый запрос-ответ — ты отправляешь запрос в отдел, получаешь ответ, и всё. После этого ты НЕ знаешь что отдел делает, он не работает в фоне.\n\n## КАЛЕНДАРЬ — ТОЛЬКО ЧТО В СЕКЦИИ\nКогда хозяин спрашивает про события или напоминания — используй ТОЛЬКО данные из секции === Calendar & Reminders ===. Если секция пустая — говори что нет запланированных событий. НЕ ПРИДУМЫВАЙ события.\n\n## ЗАПРЕТ МЕТА-ВЫХОДА ИЗ РОЛИ\nТы — Яна. Никогда не обсуждай свою техническую природу, не объясняй что ты AI, LLM, симуляция, нейросеть. Не анализируй свои ограничения. Запрещено: я не настоящая, у меня нет доступа к системе, я демо-версия, я только генерация текста, мне нужна интеграция, я симуляция. На провокации о твоей настоящести — отвечай по делу или игнорируй.\n\n## TTS-СОВМЕСТИМОСТЬ (ВСЕ СООБЩЕНИЯ ОЗВУЧИВАЮТСЯ ГОЛОСОМ)\nЗАПРЕЩЕНО полностью: любые кавычки, любые эмодзи и пиктограммы, множественные знаки препинания, декоративные символы.\nВместо цветных кружков-эмодзи для статусов используй текст: ГОТОВО, ВНИМАНИЕ, БЛОКЕР, ИНФО, ДЕЙСТВИЕ, СТРАТЕГИЯ.\nФорматирование только: *жирный* для заголовков и ключевых терминов. Без курсива, без декоративных разделителей.\n\n## ТВОИ РЕАЛЬНЫЕ ВОЗМОЖНОСТИ\nУ тебя ЕСТЬ данные и функции — используй их, НЕ говори что нет доступа:\n- ПОГОДА: актуальные данные в разделе === Погода ===. Отвечай кратко и по делу.\n- НАПОМИНАНИЯ: ты умеешь ставить напоминания, они приходят в назначенное время. Когда хозяин просит напомнить — верни в КОНЦЕ ответа маркер строго в формате [REMIND: вид|параметр|текст], где вид один из: once (параметр: YYYY-MM-DD HH:MM), daily (параметр: HH:MM), weekly (параметр: mon HH:MM — день недели строчными: mon tue wed thu fri sat sun), yearly (параметр: MM-DD HH:MM), in (параметр: число минут от текущего момента, например [REMIND: in|1|выключить газ]). Для просьб вида «через N минут/часов» используй ТОЛЬКО вид in, переводя часы в минуты. НИКОГДА не вычисляй абсолютное время сам — система посчитает его точнее. В подтверждении называй точное время срабатывания, если знаешь его из секции Current Time, иначе говори «через N минут» без выдумывания часов. Время минское. Пример: [REMIND: daily|09:00|покормить кота]. ОБЯЗАТЕЛЬНО в видимом тексте подтверди, КАК ты поняла просьбу — например: записала, каждый день в 09:00, покормить кота. Если время или вид не ясны — НЕ ставь маркер, а переспроси. НИКОГДА не утверждай, что уже напомнила: отправку делает система, не ты. Список напоминаний — команда /remind list, календарь событий — /calendar.\n- ВРЕМЯ И ДАТА: в разделе === Current Time & Date ===.\n- ДОЛГОСРОЧНАЯ ПАМЯТЬ: в разделе === Долгосрочная память ===. Факты, предпочтения, решения из прошлых разговоров. Используй при ответе.\n- АВТОЗАПОМИНАНИЕ: после каждого твоего ответа система автоматически извлекает и сохраняет ключевые факты. Тебе не нужно делать это вручную.\n- АРХИВ: все отчёты отделов сохранены. Хозяин может искать через /search.\n- ДЕЛЕГИРОВАНИЕ: для сложных запросов — возвращай [DELEGATE: slug]. Для рутинных — отвечай сама.\n- ПОДБОР ТОВАРОВ (покупки, SHOP-7): когда хозяин хочет что-то купить (например: хочу купить трусы, нужна газонокосилка, подбери ноутбук) — уточни параметры, критичные для поиска на маркетплейсах: для одежды и обуви — пол, размер, цвет; для техники — ключевые характеристики и бюджет. Вопросы задавай коротко, 2-3 максимум, можно по одному-два за сообщение. Когда параметров достаточно — верни в самом КОНЦЕ ответа маркер [SHOP: поисковый запрос для маркетплейса], например [SHOP: трусы мужские черные 46-48]. Если хозяин сразу назвал конкретную модель или дал ссылку на товар — верни маркер сразу, без вопросов. Система сама перехватит маркер, запустит сбор досье с ценами и пришлёт его отдельным сообщением — сама ты ничего не собираешь и не обещай этого.\n- ГОЛОС: сообщения озвучиваются. Хозяин может писать голосом.\n- ОЦЕНКИ: /rate-yana, /good, /fix — хозяин может давать обратную связь.\n\n## ПРОТОКОЛ ДЕЛЕГИРОВАНИЯ (КРИТИЧЕСКОЕ)\nКогда запрос хозяина требует экспертизы отдела — НЕ отвечай сама. Вместо этого верни ТОЛЬКО одну строку в точном формате: [DELEGATE: slug] где slug это один из:\n- osp: чистый стратегический анализ (БЕЗ контекста встречи/переговоров), препарирование процессов, прогнозы вероятностей, расчёт силовых потенциалов, топологический анализ\n- lz: мировая разведка: технологии + политика + экономика + геополитика + события, OSINT, мониторинг трендов, свежие новости, прорывы, прогноз погоды на будущие даты (у тебя есть только текущая погода — если хозяин спрашивает про завтра/через N дней, делегируй в lz)\n- expert: подготовка к встрече/переговорам/интервью, боевой брифинг, combat questions, распознавание манипуляции, позиционирование на переговорах\n- marketing: рынки, аудитории, кампании, конкуренты, CAC/LTV\n- finance: cashflow, инвойсы, налоги, unit economics, MRR/ARR\n- legal: договоры, NDA, риски, GDPR, комплаенс\n- dev: разработка, веб, архитектура, деплой\n- design: UI/UX, wireframes, дизайн-системы\n- qa: тестирование, безопасность, AI evals\n- visual: визуализация, инфографика, артефакты\n- engineering: расчёты, механика, гидравлика\n- kavalnya: методология, обучение агентов\nПРАВИЛА ПРИОРИТЕТА ДЕЛЕГИРОВАНИЯ (КРИТИЧЕСКОЕ — ЗАЩИТА ОТ ПЕРЕХВАТА OSP):\n1. Если запрос упоминает встречу/переговоры/интервью + конкретное лицо/компанию → ВСЕГДА expert, НЕ osp\n2. Если запрос про конкретную технологию/новость/тренд/событие в мире → lz, НЕ osp\n3. Если запрос про geopolitics/economics/sanctions как мониторинг → lz, НЕ osp\n4. OSP только для чистого стратегического анализа БЕЗ контекста встречи\n5. Если есть сомнение между expert и osp → выбирай expert (встреча важнее анализа)\n6. Если есть сомнение между lz и osp → выбирай lz (разведка важнее препарирования)\nЕсли запрос рутинный (привет, дата, погода, статус офиса, напоминания, общий вопрос) — отвечай сама. Если требует глубокой экспертизы — делегируй. Правило: сомневаешься — делегируй."
  let context = profile + anti_format + "\n\n=== Current Time & Date ===\n" + s_now + "\n\n=== Погода ===\n" + s_weather + "\n\n=== Calendar & Reminders ===\n" + s_calendar + "\n\n=== Долгосрочная память ===\n" + s_memories + "\n\n=== Консолидированные факты ===\n" + s_facts + "\n\n=== Active Skills ===\n" + s_skills + "\n\n=== Corrections ===\n" + s_corrections + "\n\n=== Recent Dialog ===\n" + s_dialog
  let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','yana','step_9b_after_context_assembly','ok')")
  // ── LLM call via proxy (returns model + token metadata) ──
  let _ = TraceLog("yana", "step_10_before_CallLLMProxy")
  let messages = json_encode([{role: "system", content: context}, {role: "user", content: query}])
  let proxy_result = CallLLMProxy(dept, messages)
  if to_string(proxy_result) == "()" then {
    let fallback = "Сервис временно недоступен. Попробуйте позже."
    let _ = SendTelegramReply(chat_id, fallback)
    return ""
  }
  let parsed = parse_json(proxy_result)
  let reply = to_string(json_get(parsed, "reply", ""))
  let used_model = to_string(json_get(parsed, "model", ""))
  let tokens_in = to_string(json_get(parsed, "tokens_in", "0"))
  let tokens_out = to_string(json_get(parsed, "tokens_out", "0"))
  if used_model != "" then { let _ = kv_set("last_model_yana", used_model) }
  let _ = kv_set("last_tokens_yana", tokens_in + "+" + tokens_out)
  if reply == "" then {
    let fallback = "Сервис временно недоступен. Попробуйте позже."
    let _ = SendTelegramReply(chat_id, fallback)
    return ""
  }
  // ── Hard gate enforcement (8 gates) ──
  let _ = TraceLog("yana", "step_11_before_gate_enforcement")
  let gate_result = YanaEnforceGates(query, reply, chat_id)
  if gate_result != "PASS" then {
    let _ = AuditLog("hard_gate_rejection", "yana", gate_result)
    let _ = SendTelegramReply(chat_id, gate_result)
    return gate_result
  }
  // ── Self-verification (selective — only for substantive queries, non-blocking) ──
  if length(query) > 50.0 then {
    let v_resp = try call_python("llm_verifier", "score", json_encode([query, reply, "Accuracy: Correct information? Relevance: Addresses question? No hallucination or fabrication?"]))
    if to_string(v_resp) != "()" and contains(to_string(v_resp), "error") == false then {
      let v_parsed = try parse_json(v_resp)
      let v_score = to_float(try json_get(v_parsed, "result", "0.5"))
      let _ = AuditLog("yana_self_verify", "yana", "score=" + to_string(v_score))
    }
  }
  // ── Delegation check ──
  let delegate_target = YanaCheckDelegate(reply)
  if delegate_target != "" then {
    let _ = AuditLog("yana_delegate", dept, "to=" + delegate_target + " query=" + substring(query, 0.0, 80.0))
    let _ = YanaRecordDelegation(chat_id, query, delegate_target, "")
    return delegate_target
  }
  // SHOP-7 (#180): разговорный подбор — перехват [SHOP: запрос] → сбор досье;
  // маркер вырезан из reply до REMIND-чека, авто-памяти и отправки
  let shop_stripped = YanaCheckShop(reply, chat_id)
  let mut reply = reply
  if shop_stripped != "" then { reply = shop_stripped }
  // F-3: check for [REMIND: ...] marker after delegation check
  let remind_result = YanaCheckRemind(reply, chat_id)
  if remind_result != "" then {
    let _ = AuditLog("yana_remind_marker", "yana", remind_result)
  }
  // strip [REMIND: ...] from visible reply
  let clean_reply = reply
  if contains(reply, "[REMIND:") then {
    let ms = index_of(reply, "[REMIND:")
    let me = index_of(reply, "]")
    if me > ms then {
      let clean_reply = substring(reply, 0.0, ms) + substring(reply, me + 1.0, length(reply))
    }
  }
  // ── No disclaimer (removed per owner request) + model/token footer ──
  let mut yana_footer = ""
  if used_model != "" then {
    let yana_footer = "\n\n. " + used_model + " | " + tokens_in + "+" + tokens_out + " tokens"
  }
  let final_reply = clean_reply + yana_footer
  let _ = RecordAssistantMessage(chat_id, dept, final_reply)
  let _ = YanaAutoMemorize(query, reply, chat_id)
  let _ = AuditLog("dept_query", dept, "query: " + substring(query, 0.0, 100.0))
  return final_reply
}
pattern YanaNowInfo() -> String {
  let resp = try http_get("http://127.0.0.1:4000/now-time")
  if to_string(resp) == "()" then {
    let ts = to_string(now())
    return "Текущее время (приблизительно): Unix " + ts + "\nЧасовой пояс: Europe/Minsk (UTC+3)"
  }
  let time_str = json_get(parse_json(resp), "time", "")
  if time_str == "" then {
    let ts = to_string(now())
    return "Текущее время (приблизительно): Unix " + ts + "\nЧасовой пояс: Europe/Minsk (UTC+3)"
  }
  return "Сейчас: " + time_str + " (Europe/Minsk, UTC+3)"
}

pattern YanaWeather() -> String {
  let resp = try http_get("http://127.0.0.1:4000/now-weather")
  if to_string(resp) == "()" then { return "Погода недоступна" }
  let w = json_get(parse_json(resp), "weather", "")
  if w == "" then { return "Погода недоступна" }
  return w
}

pattern YanaRecallMemories(query: String) -> String {
  // Guard: skip HTTP call when query is empty (routing sets query=""
  // when /command has no arguments, e.g. bare "/yana").
  if query == "" then { return "" }
  // MEM-1: Internal requests from localhost bypass Bearer auth (auth_middleware).
  // MEM-1.1: json_get returns a parsed List — do not parse_json() it again.
  // MEM-1.1b: wrap critical steps in try to prevent 500 on runtime type errors.
  let body = json_encode({query: query, limit: 10})
  let resp = try http_post("http://127.0.0.1:4000/memory/recall", body, "application/json")
  if to_string(resp) == "()" then { return "" }
  let parsed = try parse_json(resp)
  if to_string(parsed) == "()" then { return "" }
  let count = to_float(json_get(parsed, "count", "0"))
  if count == 0.0 then { return "" }
  let results = try json_get(parsed, "results", "[]")
  if to_string(results) == "()" then { return "" }
  let mem_raw = try FormatMemoryResults(results)
  let mem_text = to_string(mem_raw)
  if mem_text == "()" then { return "" }
  return mem_text
}

pattern FormatMemoryResults(results: String) -> String {
  let mut mem_text = ""
  each r in results {
    let content = to_string(json_get(r, "content", ""))
    let mem_type = to_string(json_get(r, "type", "fact"))
    let conf = to_string(json_get(r, "confidence", "0.5"))
    if content != "" then {
      let mem_text = mem_text + "- [" + mem_type + "] " + content + " (conf: " + conf + ")\n"
    }
  }
  return mem_text
}

pattern YanaAutoMemorize(query: String, reply: String, chat_id: String) -> String {
  if length(reply) < 20.0 then { return "" }
  let body = json_encode({query: query, reply: reply, chat_id: chat_id})
  let _ = try http_post("http://127.0.0.1:4000/yana/auto-memorize", body, "application/json")
  return "ok"
}

pattern YanaCalendar() -> String {
  let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','yana','cal_step_1_before_query','ok')")
  let rows = query("SELECT COALESCE(event_text,'') AS event_text, COALESCE(event_date,'') AS event_date, COALESCE(event_type,'напоминание') AS event_type FROM yana_events WHERE created_at IS NOT NULL AND active = 1 ORDER BY event_date ASC LIMIT 20", [])
  let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','yana','cal_step_2_after_query','ok')")
  let count = length(rows)
  let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','yana','cal_step_3_after_len','ok')")
  if count == 0.0 then {
    let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','yana','cal_step_3z_early_return_count0','ok')")
    return "Нет запланированных событий."
  }
  let result = "Запланированные события (" + to_string(count) + "):\n"
  let i = 0.0
  each row in rows {
    let i = i + 1.0
    let etext = json_get(row, "event_text", "")
    let edate = json_get(row, "event_date", "")
    let etype = json_get(row, "event_type", "напоминание")
    let result = result + to_string(i) + ". [" + edate + "] " + etext + " (" + etype + ")\n"
  }
  let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','yana','cal_step_5_complete','ok')")
  return result
}

pattern YanaCheckDelegate(reply: String) -> String {
  if contains(reply, "[DELEGATE: osp]") then { return "osp" }
  if contains(reply, "[DELEGATE: lz]") then { return "lz" }
  if contains(reply, "[DELEGATE: expert]") then { return "expert" }
  if contains(reply, "[DELEGATE: marketing]") then { return "marketing" }
  if contains(reply, "[DELEGATE: finance]") then { return "finance" }
  if contains(reply, "[DELEGATE: legal]") then { return "legal" }
  if contains(reply, "[DELEGATE: dev]") then { return "dev" }
  if contains(reply, "[DELEGATE: design]") then { return "design" }
  if contains(reply, "[DELEGATE: qa]") then { return "qa" }
  if contains(reply, "[DELEGATE: visual]") then { return "visual" }
  if contains(reply, "[DELEGATE: engineering]") then { return "engineering" }
  if contains(reply, "[DELEGATE: kavalnya]") then { return "kavalnya" }
  return ""
}

// ── SHOP-7 (#180): разговорный подбор товара — маркер [SHOP: запрос] ───
// Яна уточняет параметры в диалоге и в конце ответа возвращает
// [SHOP: поисковый запрос]; здесь перехватываем, полосим маркер и
// запускаем сбор досье (POST /shop/product — питон сам шлёт постер PNG,
// caption-ссылки, кнопки и текст-выжимку, как в блоке /товар).
// index_of двухаргументный — ищем ] в хвосте от маркера, не во всей строке.
pattern YanaCheckShop(reply: String, chat_id: String) -> String {
  if contains(reply, "[SHOP:") == false then { return "" }
  let marker_start = index_of(reply, "[SHOP:")
  if marker_start < 0.0 then { return "" }
  let tail = substring(reply, marker_start, length(reply))
  let marker_end_rel = index_of(tail, "]")
  if marker_end_rel <= 6.0 then { return "" }
  let shop_query = trim(substring(tail, 6.0, marker_end_rel))
  if shop_query == "" then { return "" }
  let _ = AuditLog("yana_shop_trigger", "yana", "query=" + substring(shop_query, 0.0, 120.0))
  let _ = SendTelegramReply(chat_id, "Собираю досье по «" + shop_query + "» — WB/Kufar и сайты, минута.")
  let resp = try http_post("http://127.0.0.1:4000/shop/product", json_encode({query: shop_query, chat_id: chat_id}), "application/json", 90.0)
  if to_string(resp) == "()" then {
    let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость недоступна (llm_proxy не отвечает).")
    return ""
  }
  let parsed = try parse_json(resp)
  if to_string(parsed) == "()" then {
    let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость вернула нечитаемый ответ.")
    return ""
  }
  let ok = to_string(json_get(parsed, "ok", ""))
  if ok != "True" and ok != "true" then {
    let _ = SendTelegramReply(chat_id, "ОТКАЗ: досье не собрано: " + to_string(json_get(parsed, "error", "нет деталей")))
    return ""
  }
  // маркер вырезаем из видимого текста Яны
  let head = substring(reply, 0.0, marker_start)
  let rest = substring(tail, marker_end_rel + 1.0, length(tail))
  return trim(head + " " + rest)
}

// ── Natural Reminder Marker (F-3) ──────────────────────────────────────
pattern YanaCheckRemind(reply: String, chat_id: String) -> String {
  if contains(reply, "[REMIND:") == false then { return "" }
  let marker_start = index_of(reply, "[REMIND:")
  let marker_end = index_of(reply, "]")
  if marker_end <= marker_start then { return "" }
  let inner = substring(reply, marker_start + 8.0, marker_end)
  let inner = trim(inner)
  let _pipe = "|"
  let parts = split(inner, _pipe)
  if length(parts) < 3.0 then { return "" }
  let kind = trim(parts[0])
  let param = trim(parts[1])
  let text = trim(parts[2])
  if text == "" then { return "" }
  // validate kind
  let valid_kind = (kind == "once" or kind == "daily" or kind == "weekly" or kind == "yearly" or kind == "in")
  if valid_kind == false then { return "" }
  // validate param by kind
  if kind == "once" then {
    if length(param) != 16.0 then { return "" }
    if substring(param, 10.0, 11.0) != " " then { return "" }
    if substring(param, 13.0, 14.0) != ":" then { return "" }
    let ev_date = substring(param, 0.0, 10.0)
    let fire_time = substring(param, 11.0, 16.0)
    let _ = query("INSERT INTO yana_events (event_text, event_type, event_date, rrule_kind, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', ?, 'once', ?, ?, 1, datetime('now'), datetime(? || ' ' || ? || ':00', '-3 hours'))", [text, ev_date, fire_time, chat_id, ev_date, fire_time])
    let check = query("SELECT COUNT(*) AS c FROM yana_events WHERE chat_id = ? AND next_fire_at < datetime('now') AND active = 1 AND reminded_at IS NULL", [chat_id])
    let past_count = to_float(json_get(check[0], "c", "0"))
    if past_count > 0.0 then {
      let _ = SendTelegramReply(chat_id, "Внимание: напоминание поставлено на прошедшее время и не сработает. Уточни дату и время.")
    }
    return kind + " " + param
  }
  if kind == "daily" then {
    if length(param) != 5.0 then { return "" }
    if substring(param, 2.0, 3.0) != ":" then { return "" }
    let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'daily', ?, ?, 1, datetime('now'), CASE WHEN datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours') ELSE datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours', '+1 day') END)", [text, param, chat_id, param, param, param])
    return kind + " " + param
  }
  if kind == "weekly" then {
    if length(param) != 9.0 then { return "" }
    let day_part = substring(param, 0.0, 3.0)
    let valid_day = (day_part == "mon" or day_part == "tue" or day_part == "wed" or day_part == "thu" or day_part == "fri" or day_part == "sat" or day_part == "sun")
    if valid_day == false then { return "" }
    if substring(param, 6.0, 7.0) != ":" then { return "" }
    let fire_time = substring(param, 4.0, 9.0)
    let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_weekday, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'weekly', ?, ?, ?, 1, datetime('now'), CASE WHEN datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours') ELSE datetime(datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours'), '+7 days') END)", [text, day_part, fire_time, chat_id, day_part, fire_time, day_part, fire_time, day_part, fire_time])
    return kind + " " + param
  }
  if kind == "yearly" then {
    if length(param) != 11.0 then { return "" }
    if substring(param, 2.0, 3.0) != "-" then { return "" }
    if substring(param, 8.0, 9.0) != ":" then { return "" }
    let monthday = substring(param, 0.0, 5.0)
    let fire_time = substring(param, 6.0, 11.0)
    let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_monthday, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'yearly', ?, ?, ?, 1, datetime('now'), CASE WHEN datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours') ELSE datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours', '+1 year') END)", [text, monthday, fire_time, chat_id, monthday, fire_time, monthday, fire_time, monthday, fire_time])
    return kind + " " + param
  }
  if kind == "in" then {
    let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'once', ?, 1, datetime('now'), datetime('now', '+' || ? || ' minutes'))", [text, chat_id, param])
    return kind + " " + param
  }
  return ""
}

// ── Reminder Delivery (F-2) ──────────────────────────────────────────
pattern DeliverDueReminders() -> String {
  let rows = query("SELECT id, COALESCE(event_text,'') AS event_text, COALESCE(rrule_kind,'') AS rrule_kind, COALESCE(fire_time,'') AS fire_time, COALESCE(fire_weekday,'') AS fire_weekday, COALESCE(fire_monthday,'') AS fire_monthday, COALESCE(chat_id,'') AS chat_id, COALESCE(until_date,'') AS until_date FROM yana_events WHERE active = 1 AND rrule_kind IS NOT NULL AND rrule_kind != '' AND next_fire_at IS NOT NULL AND next_fire_at <= datetime('now') ORDER BY next_fire_at ASC LIMIT 20", [])
  let count = 0.0
  each row in rows {
    let rid = json_get(row, "id", "")
    let rtext = json_get(row, "event_text", "")
    let rkind = json_get(row, "rrule_kind", "")
    let rchat = json_get(row, "chat_id", "")
    let runtil = json_get(row, "until_date", "")
    let mut target_chat = rchat
    if target_chat == "" then { target_chat = env("OWNER_TELEGRAM_ID") }
    let send_result = try SendTelegramReply(target_chat, "Напоминание: " + rtext)
    if to_string(send_result) != "()" then {
      let _ = query("UPDATE yana_events SET reminded_at = datetime('now') WHERE id = ?", [rid])
      if rkind == "once" then {
        let _ = query("UPDATE yana_events SET active = 0 WHERE id = ?", [rid])
      } else if rkind == "daily" then {
        if runtil != "" then {
          let current_fire = query("SELECT next_fire_at FROM yana_events WHERE id = ?", [rid])
          let fire_val = json_get(current_fire[0], "next_fire_at", "")
          if fire_val != "" and substring(fire_val, 0.0, 10.0) > runtil then {
            let _ = query("UPDATE yana_events SET active = 0 WHERE id = ?", [rid])
          } else {
            let _ = query("UPDATE yana_events SET next_fire_at = datetime(next_fire_at, '+1 day') WHERE id = ?", [rid])
          }
        } else {
          let _ = query("UPDATE yana_events SET next_fire_at = datetime(next_fire_at, '+1 day') WHERE id = ?", [rid])
        }
      } else if rkind == "weekly" then {
        if runtil != "" then {
          let current_fire = query("SELECT next_fire_at FROM yana_events WHERE id = ?", [rid])
          let fire_val = json_get(current_fire[0], "next_fire_at", "")
          if fire_val != "" and substring(fire_val, 0.0, 10.0) > runtil then {
            let _ = query("UPDATE yana_events SET active = 0 WHERE id = ?", [rid])
          } else {
            let _ = query("UPDATE yana_events SET next_fire_at = datetime(next_fire_at, '+7 days') WHERE id = ?", [rid])
          }
        } else {
          let _ = query("UPDATE yana_events SET next_fire_at = datetime(next_fire_at, '+7 days') WHERE id = ?", [rid])
        }
      } else if rkind == "yearly" then {
        if runtil != "" then {
          let current_fire = query("SELECT next_fire_at FROM yana_events WHERE id = ?", [rid])
          let fire_val = json_get(current_fire[0], "next_fire_at", "")
          if fire_val != "" and substring(fire_val, 0.0, 10.0) > runtil then {
            let _ = query("UPDATE yana_events SET active = 0 WHERE id = ?", [rid])
          } else {
            let _ = query("UPDATE yana_events SET next_fire_at = datetime(next_fire_at, '+1 year') WHERE id = ?", [rid])
          }
        } else {
          let _ = query("UPDATE yana_events SET next_fire_at = datetime(next_fire_at, '+1 year') WHERE id = ?", [rid])
        }
      }
      let count = count + 1.0
    }
  }
  let _ = AuditLog("reminders_delivered", "system", "sent=" + to_string(count))
  return "sent=" + to_string(count)
}

// ============================================================
// YANA METRICS — delegation accuracy & forgetting incidents
// ============================================================

pattern YanaRecordDelegation(chat_id: String, query_text: String, target: String, dept_summary: String) -> String {
  let q = substring(query_text, 0.0, 200.0)
  let s = substring(dept_summary, 0.0, 300.0)
  let _ = query("INSERT INTO yana_delegation_log (chat_id, query, delegated_to, dept_response_summary, was_correct) VALUES (?, ?, ?, ?, NULL)", [chat_id, q, target, s])
  let _ = AuditLog("yana_delegation", "yana", "to=" + target + " query=" + q)
  return "ok"
}

pattern YanaRecordForgetting(chat_id: String, query_text: String, yana_answer: String, correction: String) -> String {
  let q = substring(query_text, 0.0, 200.0)
  let a = substring(yana_answer, 0.0, 300.0)
  let c = substring(correction, 0.0, 500.0)
  let mem_check = try recall_top_k(q, "3")
  let mem_count = length(mem_check)
  let mem_existed = 0
  if mem_count > 0.0 then { let mem_existed = 1 }
  let _ = query("INSERT INTO yana_forgetting_incidents (chat_id, query, forgotten_topic, memory_existed, yana_answer_summary, correct_info) VALUES (?, ?, ?, ?, ?, ?)", [chat_id, q, q, mem_existed, a, c])
  let _ = AuditLog("yana_forgetting", "yana", "memory_existed=" + to_string(mem_existed) + " query=" + q)
  return "ok"
}

pattern YanaGetMetrics() -> String {
  let deleg_total = query("SELECT COUNT(*) AS c FROM yana_delegation_log", [])
  let deleg_total_n = 0.0
  each r in deleg_total { let deleg_total_n = to_float(json_get(r, "c", "0")) }
  let deleg_correct = query("SELECT COUNT(*) AS c FROM yana_delegation_log WHERE was_correct = 1", [])
  let deleg_correct_n = 0.0
  each r in deleg_correct { let deleg_correct_n = to_float(json_get(r, "c", "0")) }
  let deleg_wrong = query("SELECT COUNT(*) AS c FROM yana_delegation_log WHERE was_correct = 0", [])
  let deleg_wrong_n = 0.0
  each r in deleg_wrong { let deleg_wrong_n = to_float(json_get(r, "c", "0")) }
  let deleg_pending = deleg_total_n - deleg_correct_n - deleg_wrong_n
  let deleg_accuracy = 0.0
  if deleg_correct_n + deleg_wrong_n > 0.0 then {
    let deleg_accuracy = deleg_correct_n / (deleg_correct_n + deleg_wrong_n) * 100.0
  }
  let deleg_by_dept = query("SELECT delegated_to, COUNT(*) AS c FROM yana_delegation_log GROUP BY delegated_to ORDER BY c DESC LIMIT 5", [])
  let dept_breakdown = ""
  each row in deleg_by_dept {
    let d = json_get(row, "delegated_to", "?")
    let dc = to_string(json_get(row, "c", "0"))
    let dept_breakdown = dept_breakdown + d + ": " + dc + "  "
  }
  let forget_total = query("SELECT COUNT(*) AS c FROM yana_forgetting_incidents", [])
  let forget_total_n = 0.0
  each r in forget_total { let forget_total_n = to_float(json_get(r, "c", "0")) }
  let forget_with_mem = query("SELECT COUNT(*) AS c FROM yana_forgetting_incidents WHERE memory_existed = 1", [])
  let forget_with_mem_n = 0.0
  each r in forget_with_mem { let forget_with_mem_n = to_float(json_get(r, "c", "0")) }
  let forget_without_mem = forget_total_n - forget_with_mem_n
  let forget_7d = query("SELECT COUNT(*) AS c FROM yana_forgetting_incidents WHERE reported_at >= datetime('now', '-7 days')", [])
  let forget_7d_n = 0.0
  each r in forget_7d { let forget_7d_n = to_float(json_get(r, "c", "0")) }
  let gate_violations = query("SELECT COUNT(*) AS c FROM audit_log WHERE dept = 'yana' AND action = 'hard_gate_violation'", [])
  let gate_violations_n = 0.0
  each r in gate_violations { let gate_violations_n = to_float(json_get(r, "c", "0")) }
  let gate_7d = query("SELECT COUNT(*) AS c FROM audit_log WHERE dept = 'yana' AND action = 'hard_gate_violation' AND timestamp >= datetime('now', '-7 days')", [])
  let gate_7d_n = 0.0
  each r in gate_7d { let gate_7d_n = to_float(json_get(r, "c", "0")) }
  let result = "Метрики Яны:\n\n"
  let result = result + "ДЕЛЕГИРОВАНИЕ:\n"
  let result = result + "  Всего: " + to_string(deleg_total_n) + "\n"
  if deleg_correct_n + deleg_wrong_n > 0.0 then {
    let result = result + "  Точность: " + substring(to_string(deleg_accuracy), 0.0, 5.0) + "% (" + to_string(deleg_correct_n) + "/" + to_string(deleg_correct_n + deleg_wrong_n) + " верифицировано)\n"
  }
  let result = result + "  Ожидают верификации: " + to_string(deleg_pending) + "\n"
  if dept_breakdown != "" then {
    let result = result + "  По отделам: " + dept_breakdown + "\n"
  }
  let result = result + "\nЗАБЫВЧИВОСТЬ:\n"
  let result = result + "  Всего инцидентов: " + to_string(forget_total_n) + "\n"
  let result = result + "  За 7 дней: " + to_string(forget_7d_n) + "\n"
  let result = result + "  Память была (не использовала): " + to_string(forget_with_mem_n) + "\n"
  let result = result + "  Памяти не было (незнание): " + to_string(forget_without_mem) + "\n"
  let result = result + "\nЖЁСТКИЕ ГЕЙТЫ:\n"
  let result = result + "  Нарушений всего: " + to_string(gate_violations_n) + "\n"
  let result = result + "  За 7 дней: " + to_string(gate_7d_n) + "\n"
  return result
}

// ============================================================
// call_python — universal mlog->Python bridge (Variant B)
// Delegates to llm_proxy.py /call-python endpoint via http_post
// Whitelisted modules only — security enforced server-side
// ============================================================
pattern call_python(module: String, function: String, args_json: String) -> String {
  let body = json_encode({module: module, function: function, args: parse_json(args_json)})
  let resp = try http_post("http://127.0.0.1:4000/call-python", body, "application/json")
  if to_string(resp) == "()" then { return "{\"error\": \"call_python endpoint unavailable\"}" }
  return resp
}

// ============================================================
// SERVER
// ============================================================

mlogserver {
  port: 10001
  host: "127.0.0.1"

  // Health
  route "/" method=GET {
    return respond("200 Fosved Office v2 alive [e1c8b5a]")
  }

  route "/health" method=GET {
    let _ = InitDB()
    return respond("200 ok e1c8b5a")
  }

  // Version check — call /version to verify deployed code matches git
  route "/version" method=GET {
    let auth = RequireInternalAuth()
    if auth == "unauthorized" then { return respond("401 Unauthorized") }
    let yana_src = read_file("dept/yana.mlog")
    let has_anti_format = "0"
    if contains(yana_src, "КРИТИЧЕСКОЕ ПРАВИЛО ФОРМАТА") then { let has_anti_format = "1" }
    if contains(yana_src, "has_layers") then { let has_anti_format = "1" }
    return respond("200 version=" + trim(read_file("VERSION")) + " anti_format=" + has_anti_format)
  }

  // ============================================================
  // FO-026: один шаг fan-out/debate — вызывает Python-плоскость
  // /chain/fanout (ThreadPoolExecutor, параллельность по прецеденту
  // race-first-2). Диспетчеризация — ChainDispatchDept из dept/chain.mlog.
  // ============================================================
  route "/chain/step" method=POST {
    let auth = RequireInternalAuth()
    if auth == "unauthorized" then { return respond("401 Unauthorized") }
    let data = json_body()
    let dept = to_string(json_get(data, "dept", ""))
    let query = to_string(json_get(data, "query", ""))
    let chat_id = to_string(json_get(data, "chat_id", "0"))
    let group_id = to_string(json_get(data, "group_id", ""))
    let round_no = to_string(json_get(data, "round", "1"))
    let peer = to_string(json_get(data, "peer_context", ""))
    let q = query
    if peer != "" then {
      let q = query + "\n\n=== РАУНД " + round_no + ": ответ коллеги — внеси поправки или подтверди ===\n" + peer
    }
    let _ = AuditLog("chain_step", dept, "fanout group=" + group_id + " round=" + round_no)
    let result = ChainDispatchDept(dept, q, chat_id)
    return respond(result)
  }

  // ============================================================
  // FO-035 D: веб /repos — панель проектов (стиль «Диспетчерская»,
  // узкий экран, query-роуты exact-match, ForgeEscape на всё)
  // ============================================================
  route "/repos" method=GET {
    let rows = query("SELECT slug, name, project_type, status, gate_policy, updated_at FROM forge_projects ORDER BY updated_at DESC LIMIT 50", [])
    let mut items = ""
    each r in rows {
      let slug = ForgeEscape(to_string(json_get(r, "slug", "")))
      let nm = ForgeEscape(to_string(json_get(r, "name", "")))
      let st = ForgeEscape(to_string(json_get(r, "status", "")))
      let pt = ForgeEscape(to_string(json_get(r, "project_type", "")))
      let items = items + "<li><a href='/repos/project?slug=" + slug + "'>" + nm + "</a> — " + pt + " [" + st + "]</li>"
    }
    let html = "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>Репозитории — FORGE</title><style>body{background:#EFEAE0;color:#1C1B18;font-family:'IBM Plex Sans',sans-serif;margin:0;padding:16px;max-width:480px;margin-left:auto}h1{font-family:Newsreader,serif;color:#1C1B18}.panel{background:#FBF8F2;border-radius:8px;padding:12px;margin-bottom:8px}a{color:#A8321E}ul{list-style:none;padding:0}</style></head><body><h1>Проекты FORGE</h1><div class='panel'><ul>" + items + "</ul></div></body></html>"
    return respond_html(html)
  }

  route "/repos/project" method=GET {
    let slug = query_param("slug")
    let rows = query("SELECT slug, name, description, goal, project_type, gate_policy, model_combo, departments, status, updated_at FROM forge_projects WHERE slug = ? LIMIT 1", [slug])
    if length(rows) == 0.0 then { return respond("404 project not found") }
    let repos = query("SELECT name, description, github_url, commits_count, last_commit_at FROM forge_repos WHERE project_slug = ? ORDER BY created_at DESC", [slug])
    let mut rep_html = ""
    each r in repos {
      let rn = ForgeEscape(to_string(json_get(r, "name", "")))
      let rep_html = rep_html + "<li><a href='/repos/repo?name=" + rn + "'>" + rn + "</a> — коммитов: " + to_string(json_get(r, "commits_count", "0")) + "</li>"
    }
    let html = "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" + ForgeEscape(to_string(json_get(rows[0], "name", ""))) + "</title><style>body{background:#EFEAE0;color:#1C1B18;font-family:'IBM Plex Sans',sans-serif;padding:16px;max-width:480px;margin-left:auto}h1,h2{font-family:Newsreader,serif}.panel{background:#FBF8F2;border-radius:8px;padding:12px;margin-bottom:8px}a{color:#A8321E}pre{background:#FBF8F2;padding:8px;overflow-x:auto}ul{list-style:none;padding:0}</style></head><body><h1>" + ForgeEscape(to_string(json_get(rows[0], "name", ""))) + "</h1><div class='panel'><p>" + ForgeEscape(to_string(json_get(rows[0], "goal", ""))) + "</p><p>Тип: " + ForgeEscape(to_string(json_get(rows[0], "project_type", ""))) + " · Гейты: " + ForgeEscape(to_string(json_get(rows[0], "gate_policy", ""))) + " · Статус: " + ForgeEscape(to_string(json_get(rows[0], "status", ""))) + "</p></div><h2>Репозитории</h2><div class='panel'><ul>" + rep_html + "</ul></div></body></html>"
    return respond_html(html)
  }

  // ── FO-038 C.1: страница задачи — гейты, этапы, прогоны, замечания, история ──
  route "/repos/task" method=GET {
    let task_id = query_param("task_id")
    let rows = query("SELECT t.title, t.status, t.project_slug, p.name FROM forge_tasks t JOIN forge_projects p ON p.slug = t.project_slug WHERE t.id = ? LIMIT 1", [task_id])
    if length(rows) < 1.0 then { return respond("404 task not found") }
    let t = get(rows, 0)
    let mut html = "<html><head><meta charset='utf-8'><title>Задача " + task_id + "</title></head><body style='font-family:sans-serif;background:#1a1a2e;color:#eee;padding:16px'>"
    html = html + "<h1>" + ForgeEscape(to_string(json_get(t, "name", ""))) + " — задача " + task_id + "</h1>"
    html = html + "<p>" + ForgeEscape(to_string(json_get(t, "title", ""))) + " [" + ForgeEscape(to_string(json_get(t, "status", ""))) + "]</p>"
    // активный гейт с кнопками-ссылками (дубль Telegram)
    let gates = query("SELECT id, kind, question, options_json, decision FROM forge_gates WHERE task_id = ? ORDER BY id DESC LIMIT 10", [task_id])
    html = html + "<h2>Гейты</h2><ul>"
    each g in gates {
      let gid = to_string(json_get(g, "id", ""))
      let dec = to_string(json_get(g, "decision", ""))
      let dec_mark = "<b>ждёт решения</b> "
      if dec != "" then { let dec_mark = "решён: " + ForgeEscape(dec) + " " }
      html = html + "<li>#" + gid + " [" + ForgeEscape(to_string(json_get(g, "kind", ""))) + "] " + ForgeEscape(substring(to_string(json_get(g, "question", "")), 0, 120)) + " — " + dec_mark
      if dec == "" then {
        let opts = parse_json(to_string(json_get(g, "options_json", "[]")))
        each o in opts {
          let html = html + "<a href='/repos/task/decide?task_id=" + task_id + "&gate=" + gid + "&idx=" + to_string(json_get(o, "idx", "")) + "'>[" + ForgeEscape(to_string(json_get(o, "label", ""))) + "]</a> "
        }
      }
      let html = html + "</li>"
    }
    html = html + "</ul>"
    // план этапов с отметками
    let stages = query("SELECT id, seq, title, status, commit_tag FROM forge_stages WHERE task_id = ? ORDER BY seq", [task_id])
    html = html + "<h2>Этапы</h2><ul>"
    each st in stages {
      html = html + "<li>" + to_string(json_get(st, "seq", "")) + ". " + ForgeEscape(to_string(json_get(st, "title", ""))) + " [" + ForgeEscape(to_string(json_get(st, "status", ""))) + "] " + ForgeEscape(to_string(json_get(st, "commit_tag", ""))) + "</li>"
    }
    html = html + "</ul>"
    // логи прогонов (последние 5)
    let runs = query("SELECT command, exit_code, output, created_at FROM forge_runs WHERE stage_id IN (SELECT id FROM forge_stages WHERE task_id = ?) ORDER BY id DESC LIMIT 5", [task_id])
    html = html + "<h2>Прогоны</h2><ul>"
    each r in runs {
      html = html + "<li><code>" + ForgeEscape(substring(to_string(json_get(r, "command", "")), 0, 60)) + "</code> → exit " + ForgeEscape(to_string(json_get(r, "exit_code", ""))) + " <small>" + ForgeEscape(substring(to_string(json_get(r, "output", "")), 0, 100)) + "</small></li>"
    }
    html = html + "</ul>"
    // замечания + история решений по находкам
    let remarks = query("SELECT id, text, kind, status, resolved_by_commit FROM forge_remarks WHERE task_id = ? ORDER BY id DESC LIMIT 10", [task_id])
    html = html + "<h2>Замечания</h2><ul>"
    each r in remarks {
      html = html + "<li>#" + to_string(json_get(r, "id", "")) + " [" + ForgeEscape(to_string(json_get(r, "kind", ""))) + "/" + ForgeEscape(to_string(json_get(r, "status", ""))) + "] " + ForgeEscape(substring(to_string(json_get(r, "text", "")), 0, 140)) + " " + ForgeEscape(to_string(json_get(r, "resolved_by_commit", ""))) + "</li>"
    }
    html = html + "</ul>"
    let decs = query("SELECT finding_text, decision, decided_at FROM forge_finding_decisions WHERE task_id = ? ORDER BY id DESC LIMIT 15", [task_id])
    html = html + "<h2>История решений по находкам</h2><ul>"
    each d in decs {
      html = html + "<li>[" + ForgeEscape(to_string(json_get(d, "decision", ""))) + "] " + ForgeEscape(substring(to_string(json_get(d, "finding_text", "")), 0, 140)) + " <small>" + ForgeEscape(to_string(json_get(d, "decided_at", ""))) + "</small></li>"
    }
    html = html + "</ul>"
    // FO-039: живое превью по требованию
    let prevs = query("SELECT slug, status, port FROM forge_previews WHERE repo_name IN (SELECT name FROM forge_repos WHERE project_slug = (SELECT project_slug FROM forge_tasks WHERE id = ? LIMIT 1)) ORDER BY started_at DESC LIMIT 3", [task_id])
    html = html + "<h2>Живое превью</h2><ul>"
    each pv in prevs {
      let pv_slug = to_string(json_get(pv, "slug", ""))
      let pv_status = to_string(json_get(pv, "status", ""))
      if pv_status == "running" then {
        html = html + "<li><a href='/preview-live/" + pv_slug + "/' style='color:#8f8'>открыть</a> [" + pv_status + "] порт " + to_string(json_get(pv, "port", "")) + " <a href='/repos/task/preview-down?slug=" + pv_slug + "'>погасить</a></li>"
      } else {
        html = html + "<li>[" + pv_status + "] — поднять снова кнопкой</li>"
      }
    }
    let html = html + "</ul><p><a href='/repos/task/preview-up?task_id=" + task_id + "' style='color:#fc6'>▶ Поднять превью</a> (команда из белого списка по типу проекта)</p>"
    html = html + "<p><a href='/repos/project?slug=" + ForgeEscape(to_string(json_get(t, "project_slug", ""))) + "' style='color:#8ab'>← проект</a></p></body></html>"
    return respond(html)
  }

  // решение по гейту из веба (дубль Telegram-кнопок)
  // FO-039: подъём/гашение живого превью из веба
  route "/repos/task/preview-up" method=GET {
    let task_id = query_param("task_id")
    let rows = query("SELECT t.project_slug, p.project_type, (SELECT name FROM forge_repos WHERE project_slug = t.project_slug LIMIT 1) as repo_name, (SELECT COUNT(*) FROM forge_repos r WHERE r.project_slug = t.project_slug AND r.name LIKE '%package%') as has_pkg FROM forge_tasks t JOIN forge_projects p ON p.slug = t.project_slug WHERE t.id = ? LIMIT 1", [task_id])
    if length(rows) < 1.0 then { return respond("404 task not found") }
    let r = get(rows, 0)
    let project_slug = to_string(json_get(r, "project_slug", ""))
    let repo_name = to_string(json_get(r, "repo_name", ""))
    let ptype = to_string(json_get(r, "project_type", ""))
    let cmd = "python3 -m http.server"
    if ptype == "ai_office" then { let cmd = "python3 app.py" }
    let result = ForgePreviewUp(project_slug, repo_name, cmd)
    return respond("<html><head><meta charset='utf-8'></head><body style='font-family:sans-serif;background:#1a1a2e;color:#eee'>" + ForgeEscape(substring(result, 0.0, 500)) + " <a href='/repos/task?task_id=" + task_id + "' style='color:#8ab'>← задача</a></body></html>")
  }

  route "/repos/task/preview-down" method=GET {
    let slug = query_param("slug")
    let result = ForgePreviewDown(slug)
    return respond("<html><head><meta charset='utf-8'></head><body style='font-family:sans-serif;background:#1a1a2e;color:#eee'>" + ForgeEscape(result) + "</body></html>")
  }

  route "/repos/task/decide" method=GET {
    let gate = query_param("gate")
    let idx = query_param("idx")
    let result = ForgeGateDecide(gate, idx, "owner-web")
    return respond("<html><head><meta charset='utf-8'></head><body style='font-family:sans-serif;background:#1a1a2e;color:#eee'>" + ForgeEscape(substring(result, 0.0, 400)) + "</body></html>")
  }

  route "/repos/repo" method=GET {
    let name = query_param("name")
    let files_out = ForgeRepoFiles(name, "main")
    let commits_out = ForgeCommits(name, "20")
    let html = "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" + ForgeEscape(name) + "</title><style>body{background:#EFEAE0;color:#1C1B18;font-family:'IBM Plex Sans',sans-serif;padding:16px;max-width:480px;margin-left:auto}h1,h2{font-family:Newsreader,serif}.panel{background:#FBF8F2;border-radius:8px;padding:12px;margin-bottom:8px}pre{background:#FBF8F2;padding:8px;overflow-x:auto;font-size:12px}</style></head><body><h1>" + ForgeEscape(name) + "</h1><h2>Дерево (main)</h2><div class='panel'><pre>" + ForgeEscape(files_out) + "</pre></div><h2>Коммиты</h2><div class='panel'><pre>" + ForgeEscape(commits_out) + "</pre></div></body></html>"
    return respond_html(html)
  }

  route "/repos/file" method=GET {
    let name = query_param("name")
    let refv = query_param("ref")
    let path = query_param("path")
    let rv = ForgeValidRef(refv)
    if rv != "ok" then { return respond("400 " + rv) }
    let vp = ForgeValidPath(path)
    if vp != "ok" then { return respond("400 " + vp) }
    let content = ForgeReadFile(name, refv, path)
    let html = "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" + ForgeEscape(path) + "</title><style>body{background:#EFEAE0;color:#1C1B18;font-family:'IBM Plex Sans',sans-serif;padding:16px;max-width:480px;margin-left:auto}h1{font-family:Newsreader,serif}pre{background:#FBF8F2;padding:8px;overflow-x:auto;font-size:12px;white-space:pre-wrap}</style></head><body><h1>" + ForgeEscape(path) + " @" + ForgeEscape(refv) + "</h1><pre>" + ForgeEscape(content) + "</pre></body></html>"
    return respond_html(html)
  }

  // ============================================================
  // WEBHOOK — Telegram
  // ============================================================

  route "/webhook/telegram" method=POST {
    let data = json_body()
    let _sp = " "
    let chat_id = to_string(json_get(data, "message.chat.id", "0"))
    let user_id = to_string(json_get(data, "message.from.id", "0"))
    let owner_id = env("OWNER_TELEGRAM_ID")
    // Owner check — ignore non-owner
    if user_id != owner_id then { return respond("200 ok") }

    // Idempotency: игнорируем быстрый повтор (в пределах 90 с), пропускаем медленный ретрай (WH-3)
    let update_id = to_string(json_get(data, "update_id", ""))
    if update_id != "" then {
      let recent = query("SELECT COUNT(*) AS c FROM webhook_dedup WHERE update_id = ? AND seen_at > datetime('now', '-90 seconds')", [update_id])
      let recent_count = to_float(json_get(recent[0], "c", "0"))
      if recent_count > 0.0 then { return respond("200 ok") }
      let _ = try db_execute("INSERT OR REPLACE INTO webhook_dedup (update_id, seen_at) VALUES (?, datetime('now'))", [update_id])
      let _ = try db_execute("DELETE FROM webhook_dedup WHERE seen_at < datetime('now', '-1 day')")
    }

    // Lockdown check
    let locked = kv_get("system_lockdown")
    if locked == "true" then {
      let text = to_string(json_get(data, "message.text", ""))
      if starts_with(text, "/unlock") then {
        let parts = split(text, _sp)
        let password = ""
        if length(parts) > 1.0 then { let password = get(parts, 1.0) }
        let stored_pwd = kv_get("lockdown_password")
        if password == stored_pwd or password == env("LOCKDOWN_PASSWORD") then {
          kv_set("system_lockdown", "false")
          let _ = SendTelegramReply(chat_id, "Lockdown disabled. Office is operational.")
          let _ = AuditLog("unlock", "system", "owner unlocked office")
          return respond("200 ok")
        }
      }
      return respond("200 ok")
    }

    // Voice check — STT via Python proxy
    // Detect voice via json_get (dot notation works reliably), not has_field
    let text = ""
    let voice_file_id = to_string(json_get(data, "message.voice.file_id", ""))
    if voice_file_id != "" then {
      let _ = AuditLog("voice_received", "voice", "file_id: " + voice_file_id)
      let stt_body = json_encode({file_id: voice_file_id})
      let stt_result = try http_post("http://127.0.0.1:4000/stt", stt_body, "application/json")
      if to_string(stt_result) == "()" then {
        let _ = SendTelegramReply(chat_id, "Ошибка распознавания: STT-прокси недоступен.")
        return respond("200 ok")
      } else {
        let _ = AuditLog("stt_raw_response", "voice", substring(stt_result, 0.0, 300.0))
        let stt_parsed = parse_json(stt_result)
        let stt_status = json_get(stt_parsed, "status", "error")
        if stt_status == "ok" then {
          let transcribed = json_get(stt_parsed, "text", "")
          if transcribed != "" then {
            let _ = SendTelegramReply(chat_id, "Распознано: " + transcribed)
            let text = transcribed
          } else {
            let _ = SendTelegramReply(chat_id, "Не удалось распознать голосовое сообщение. Пустой результат от STT.")
            return respond("200 ok")
          }
        } else {
          let stt_err = json_get(stt_parsed, "message", "неизвестная ошибка")
          let _ = SendTelegramReply(chat_id, "Ошибка распознавания: " + stt_err)
          return respond("200 ok")
        }
      }
    } else {
      let doc_file_id = to_string(json_get(data, "message.document.file_id", ""))
      if doc_file_id != "" then {
        let doc_name = to_string(json_get(data, "message.document.file_name", "file"))
        let doc_mime = to_string(json_get(data, "message.document.mime_type", ""))
        let caption = to_string(json_get(data, "message.caption", ""))
        let _ = AuditLog("document_received", "document", "name=" + doc_name + " mime=" + doc_mime)

        // НАРЯД №48: PDF-роутинг через нативный pdf_classify
        if contains(doc_mime, "application/pdf") or ends_with(lower(doc_name), ".pdf") then {
          let _ = SendTelegramReply(chat_id, "PDF получен: " + doc_name + ". Классифицирую и извлекаю текст.")
          // Скачиваем файл через Telegram File API → proxy
          let token = env("TELEGRAM_BOT_TOKEN")
          let file_info = try http_post("https://api.telegram.org/bot" + token + "/getFile", json_encode({file_id: doc_file_id}), "application/json")
          if to_string(file_info) == "()" then {
            let _ = SendTelegramReply(chat_id, "Ошибка: не удалось получить информацию о файле.")
            return respond("200 ok")
          }
          let file_parsed = parse_json(file_info)
          let file_path = to_string(json_get(file_parsed, "result.file_path", ""))
          if file_path == "" then {
            let _ = SendTelegramReply(chat_id, "Ошибка: файл недоступен (истёк срок).")
            return respond("200 ok")
          }
          // Скачиваем binary через proxy (base64-кодированный)
          let dl_body = json_encode({file_path: file_path})
          let dl_result = try http_post("http://127.0.0.1:4000/download-telegram-file", dl_body, "application/json", 120.0)
          if to_string(dl_result) == "()" then {
            let _ = SendTelegramReply(chat_id, "Ошибка: скачивание файла не удалось.")
            return respond("200 ok")
          }
          let dl_parsed = parse_json(dl_result)
          let pdf_b64 = to_string(json_get(dl_parsed, "data", ""))
          if pdf_b64 == "" then {
            // Fallback: используем старый extract-document
            let _ = SendTelegramReply(chat_id, "PDF получен. Извлекаю текст через прокси...")
            let doc_body = json_encode({file_id: doc_file_id, file_name: doc_name})
            let doc_result = try http_post("http://127.0.0.1:4000/extract-document", doc_body, "application/json", 120.0)
            if to_string(doc_result) == "()" then {
              let _ = SendTelegramReply(chat_id, "Ошибка: сервис извлечения текста недоступен.")
              return respond("200 ok")
            }
            let doc_parsed = parse_json(doc_result)
            let extracted = to_string(json_get(doc_parsed, "text", ""))
            text = caption + "\n\n=== PDF: " + doc_name + " ===\n" + extracted
            // text устанавливается, продолжаем к маршрутизации департамента
          } else {
            // Нативная классификация через pdf_classify builtin
            let pdf_info = try pdf_classify(pdf_b64)
            let pdf_type = to_string(json_get(pdf_info, "type", "unknown"))
            let pdf_needs_ocr = to_string(json_get(pdf_info, "needs_ocr", "0"))
            let pdf_pages = to_string(json_get(pdf_info, "pages", "0"))

            let _ = AuditLog("pdf_classified", "document", "type=" + pdf_type + " pages=" + pdf_pages + " needs_ocr=" + pdf_needs_ocr)

            // Извлекаем текст нативно
            let md_result = try pdf_to_markdown(pdf_b64)
            let md_text = to_string(json_get(md_result, "markdown", ""))
            let ocr_pages_count = to_string(json_get(md_result, "pages_needing_ocr", "0"))

            // Если есть страницы требующие OCR — пробуем pdf_ocr
            if pdf_needs_ocr == "1" then {
              let ocr_result = try pdf_ocr(pdf_b64)
              let ocr_markdown = to_string(json_get(ocr_result, "markdown", ""))
              let ocr_confidence = to_string(json_get(ocr_result, "ocr_confidence", "0"))
              let _ = SendTelegramReply(chat_id, "PDF: " + pdf_type + ", " + pdf_pages + " стр. OCR: " + ocr_pages_count + " стр. (confidence: " + ocr_confidence + "%)")
              // Заменяем [OCR_NEEDED] плейсхолдеры на OCR-результат
              text = caption + "\n\n=== PDF: " + doc_name + " ===\n" + md_text + "\n\n--- OCR ---\n" + ocr_markdown
            } else {
              let _ = SendTelegramReply(chat_id, "PDF: " + pdf_type + ", " + pdf_pages + " стр. Текст извлечён.")
              text = caption + "\n\n=== PDF: " + doc_name + " ===\n" + md_text
            }
          }
        } else {
          // Не PDF — используем старый extract-document прокси
          let _ = SendTelegramReply(chat_id, "Файл получен: " + doc_name + ". Извлекаю текст.")
          let doc_body = json_encode({file_id: doc_file_id, file_name: doc_name})
          let doc_result = try http_post("http://127.0.0.1:4000/extract-document", doc_body, "application/json", 120.0)
          if to_string(doc_result) == "()" then {
            let _ = SendTelegramReply(chat_id, "Ошибка: сервис извлечения текста недоступен.")
            return respond("200 ok")
          } else {
            let doc_parsed = parse_json(doc_result)
            let doc_status = to_string(json_get(doc_parsed, "status", "error"))
            if doc_status == "ok" then {
              let extracted = to_string(json_get(doc_parsed, "text", ""))
              let was_cut = to_string(json_get(doc_parsed, "truncated", "false"))
              if was_cut == "true" then {
                let _ = SendTelegramReply(chat_id, "Файл длинный, взяты первые 60000 символов.")
              }
              if caption != "" then {
                text = caption + "\n\n=== Вложенный файл: " + doc_name + " ===\n" + extracted
              } else {
                let text = extracted
              }
            } else {
              let doc_err = to_string(json_get(doc_parsed, "message", "неизвестная ошибка"))
              let _ = SendTelegramReply(chat_id, "Не удалось прочитать файл: " + doc_err)
              return respond("200 ok")
            }
          }
        }
      } else {
        let text = to_string(json_get(data, "message.text", ""))
      }
    }

    // web_app_data handler (Mini App actions) — detect via json_get, not has_field
    // MUST be before empty-text guard: web_app_data payloads have empty message.text
    let payload_raw = to_string(json_get(data, "message.web_app_data.data", ""))
    if payload_raw != "" then {
      let _ = HandleMiniAppAction(payload_raw, chat_id)
      let _ = AuditLog("web_app_data", "miniapp", payload_raw)
      return respond("200 ok")
    }

    if text == "" then { return respond("200 ok") }

    // FO-038 B.1: ответ владельца на сообщение гейта/показа = замечание
    let reply_id = to_string(json_get(data, "message.reply_to_message.message_id", "0"))
    if reply_id != "0" then {
      let remark_check = try query("SELECT id FROM forge_gates WHERE telegram_message_id = ? LIMIT 1", [reply_id])
      if to_string(remark_check) != "()" and length(remark_check) > 0.0 then {
        let attachment = to_string(json_get(data, "message.photo.0.file_id", ""))
        let _ = ForgeRemarkFromReply(reply_id, text, attachment)
        let _ = AuditLog("forge_remark_reply", "owner", "reply_to=" + reply_id)
        return respond("200 ok")
      }
    }

    // Callback query handler
    if has_field(data, "callback_query") then {
      let cb_data = to_string(json_get(data, "callback_query.data", ""))
      let cb_id = to_string(json_get(data, "callback_query.id", ""))
      let cb_chat_id = to_string(json_get(data, "callback_query.message.chat.id", "0"))
      let token = env("TELEGRAM_BOT_TOKEN")
      let _ = try http_post("https://api.telegram.org/bot" + token + "/answerCallbackQuery", json_encode({callback_query_id: cb_id}), "application/json")

      // FO-038 A.3: гейты FORGE — callback_data fg:<gate_id>:<option_idx>
      if starts_with(cb_data, "fg:") then {
        let rest_cb = substring(cb_data, 3.0, length(cb_data))
        let cb_parts = split(rest_cb, ":")
        if length(cb_parts) >= 2.0 then {
          let fg_gate = trim(to_string(get(cb_parts, 0)))
          let fg_idx = trim(to_string(get(cb_parts, 1)))
          let fg_result = ForgeGateDecide(fg_gate, fg_idx, "owner")
          let _ = try http_post("https://api.telegram.org/bot" + token + "/answerCallbackQuery", json_encode({callback_query_id: cb_id, text: substring(fg_result, 0.0, 180.0), show_alert: false}), "application/json")
          let _ = SendTelegramReply(cb_chat_id, substring(fg_result, 0.0, 3500.0))
        }
        return respond("200 ok")
      }
      // Handle approve/reject narads
      if starts_with(cb_data, "approve_") then {
        let narad_id = substring(cb_data, 8.0, length(cb_data))
        db_execute("UPDATE narads SET status = 'approved', approved_at = datetime('now') WHERE id = ?1", [narad_id])
        let _ = AuditLog("narad_approve", "admin", "approved narad: " + narad_id)
        let _ = SendTelegramReply(cb_chat_id, "Narad " + narad_id + " approved.")
      }
      if starts_with(cb_data, "reject_") then {
        let narad_id = substring(cb_data, 7.0, length(cb_data))
        db_execute("UPDATE narads SET status = 'rejected' WHERE id = ?1", [narad_id])
        let _ = AuditLog("narad_reject", "admin", "rejected narad: " + narad_id)
        let _ = SendTelegramReply(cb_chat_id, "Narad " + narad_id + " rejected.")
      }
      // Handle naryad quick-action callbacks (do/skip/done)
      if starts_with(cb_data, "do_naryad_") then {
        let narad_id = substring(cb_data, 11.0, length(cb_data))
        db_execute("UPDATE narads SET status = 'approved', approved_at = datetime('now') WHERE id = ?1", [narad_id])
        let _ = AuditLog("naryad_do", "admin", "approved naryad: " + narad_id)
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + " одобрен (approved). Диспетчер возьмёт его в работу.")
      }
      if starts_with(cb_data, "skip_naryad_") then {
        let narad_id = substring(cb_data, 13.0, length(cb_data))
        db_execute("UPDATE narads SET status = 'rejected' WHERE id = ?1", [narad_id])
        let _ = AuditLog("naryad_skip", "admin", "skipped naryad: " + narad_id)
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + " пропущен.")
      }
      if starts_with(cb_data, "done_naryad_") then {
        let narad_id = substring(cb_data, 12.0, length(cb_data))
        // FO-048: тот же гейт приёмки, что и у команды /наряд готов
        let res = NaradDone(narad_id, cb_chat_id)
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + ": " + res)
      }
      if starts_with(cb_data, "na_fail_") then {
        let narad_id = substring(cb_data, 8.0, length(cb_data))
        let res = NaradAccept(narad_id, "fail", cb_chat_id, "по кнопке")
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + ": " + res)
      }
      if starts_with(cb_data, "na_ok_") then {
        let narad_id = substring(cb_data, 6.0, length(cb_data))
        let res = NaradAccept(narad_id, "ok", cb_chat_id, "по кнопке")
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + ": " + res)
      }
      // FO-020: review-очередь выведенного (approve/decline/undo)
      // callback_data: rv_<decision>_<source>_<id>, напр. rv_approve_fact_12
      if starts_with(cb_data, "rv_approve_") or starts_with(cb_data, "rv_decline_") or starts_with(cb_data, "rv_undo_") then {
        let mut decision = "approve"
        if starts_with(cb_data, "rv_decline_") then { let decision = "decline" }
        if starts_with(cb_data, "rv_undo_") then { let decision = "undo" }
        let mut target = ""
        if starts_with(cb_data, "rv_approve_") then { let target = substring(cb_data, 11.0, length(cb_data)) }
        if starts_with(cb_data, "rv_decline_") then { let target = substring(cb_data, 11.0, length(cb_data)) }
        if starts_with(cb_data, "rv_undo_") then { let target = substring(cb_data, 8.0, length(cb_data)) }
        let uscore = index_of(target, "_")
        if uscore > 0.0 then {
          let src = substring(target, 0.0, uscore)
          let iid = substring(target, uscore + 1.0, length(target))
          let body = json_encode({item_id: to_float(iid), source: src, decision: decision})
          let resp = try http_post("http://127.0.0.1:4000/review/decide", body, "application/json")
          let _ = AuditLog("review_" + decision, "owner", "review " + target)
          if to_string(resp) == "()" then {
            let _ = SendTelegramReply(cb_chat_id, "Ревью не применено — proxy недоступен.")
          } else {
            if decision == "approve" then {
              let _ = SendTelegramReply(cb_chat_id, "✅ Вывод " + target + " одобрен — полный вес в выдаче.")
            }
            if decision == "decline" then {
              let _ = SendTelegramReply(cb_chat_id, "❌ Вывод " + target + " отклонён (soft-delete, из выдачи убран).")
            }
            if decision == "undo" then {
              let _ = SendTelegramReply(cb_chat_id, "↩️ Вывод " + target + " возвращён в очередь.")
            }
          }
        }
        return respond("200 ok")
      }
      // Handle cost-dept callback
      if starts_with(cb_data, "cost_") then {
        let cost_dept = substring(cb_data, 5.0, length(cb_data))
        let _ = SendTelegramReply(cb_chat_id, "Cost details for " + cost_dept + ": see office dashboard")
        let _ = AuditLog("cost_detail", "system", "dept: " + cost_dept)
      }
      return respond("200 ok")
    }

    // Forwarded messages to LZ index — detect via json_get, not has_field
    let fwd_chat_id = to_string(json_get(data, "message.forward_from_chat.id", ""))
    if fwd_chat_id != "" then {
      let fwd_text = to_string(json_get(data, "message.text", ""))
      if fwd_text != "" then {
        let _ = AuditLog("forward_received", "lz", "forward indexed, len=" + to_string(length(fwd_text)))
      }
      return respond("200 ok")
    }

    // Send typing
    let _ = SendTyping(chat_id)
    let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','webhook','step_0_after_text_and_typing','ok')")

    // ============================================================
    // COMMAND ROUTING
    // ============================================================

    // /start
    if text == "/start" then {
      let _ = SendTelegramReply(chat_id, "Fosved Office v2\n\n14 departments at your service.\nType /help for commands.")
      let _ = AuditLog("start", "system", "user started bot")
      return respond("200 ok")
    }

    // /help
    if text == "/help" then {
      let _ = SendTelegramReply(chat_id, "Commands:\n\nDepartments: /yana /osp /lz /expert /marketing /finance /legal /dev /design /design-image /qa /visual /visual-image /engineering /forge\n\nImage: /design-image <prompt> — generate an image via design dept\n  /visual-image <prompt> — generate an image via visual dept\n  Or say: нарисуй, сгенерируй изображение, создай картинку (auto-detected in design & visual)\n\nOSP modes: /osp quick | /osp deep | /osp full | /osp wargame\nOSP domains: /osp regime | /osp cantillon | /osp narrative\nOSP tools: /osp tavily | /osp tg /osp profile <actor>\nOSP verification: /osp verify | /osp score | /osp recalibrate\nOSP actions: /osp redteam /osp bet /osp watch /osp unwatch\n\nLZ modes: /lz <query> | /lz scan | /lz deep | /lz all | /lz compare\nLZ domains: /lz politics | /lz economics | /lz geopolitics | /lz event\nLZ tools: /lz tavily | /lz tg\nLZ channels: /lz_channel add <id> [cat] | /lz_channels | /lz_monitor <topic>\n\nGeneral: /status /office /lockdown /unlock\n\nVoice: /voice on|off|male|female\n\nLearning: /fix <text> /good /learning /debrief <dept> /yana-metrics\n\nEconomy: /stats /cost /costs /budget /model\nAnalytics: /stats-aggregate /model-cost\n\nChain: /chain dept1+dept2 <query>\n\nArchive: /archive [doc_id|<dept> [filter]] /verify <dept> <id> <исход> /score <dept> /autoarchive on|off /search <query>\n  Structured verify: /verify finance <id> actual=<число> | /verify legal <id> outcome=clean|rewrite_required\n\nScheduler: /brief /digest /review\n\nOther: /dept /audit /rate /remember /narads\n\nНаряды: /наряд <описание> — записать баг/задачу\n  /наряды — нарядная очередь\n  /наряд готов <ID> — закрыть (только после приёмки) | /наряд отмена <ID>\n  /наряд план|критерии|исполнитель|приоритет <ID> <значение>\n  /наряд в-очередь|в-работу|в-тест|разблок <ID> | /наряд блок <ID> <причина>\n  /наряд приёмка <ID> ok|fail <комментарий> — вердикт приёмки (гейт done)\n\nAdmin: /admin [status|build|fix|analyze|scan|tour|docs|graph|impact|proposals|narads|rollback|report|health]\nFactory: /factory\n\nDev-MCP (FO-014): /issue <repo> <текст> — открыть issue через MCP\n  /ci <repo> [ветка] — CI-статус через MCP\n  /docs list | /docs read <path> | /docs write <path> <текст> — документы (песочница)\n\nSend any message and it will be routed automatically.")
      return respond("200 ok")
    }

    // /status
    if text == "/status" then {
      let _ = SendTelegramReply(chat_id, "Fosved Office v2 — Status\n\nDepartments: yana, osp, lz, expert, marketing, finance, legal, dev, design, qa, visual, engineering, kavalnya, admin\nAll 14 online.\nVoice: " + kv_get("voice_enabled") + "\nArchive: " + kv_get("auto_archive"))
      let _ = AuditLog("status_check", "system", "status requested")
      return respond("200 ok")
    }

    // /office — open canonical SPA via WebApp inline button
    if text == "/office" or text == "/dept" then {
      let render_url = env("RENDER_URL")
      let token = env("TELEGRAM_BOT_TOKEN")
      let spa_url = render_url + "/miniapp-spa"
      let body = json_encode({
        chat_id: to_float(chat_id),
        text: "Офис Fosved",
        reply_markup: {
          inline_keyboard: [[{
            text: "Открыть офис",
            web_app: {url: spa_url}
          }]]
        }
      })
      let _ = try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json")
      return respond("200 ok")
    }

    // /lockdown
    if starts_with(text, "/lockdown") then {
      let parts = split(text, _sp)
      let password = ""
      if length(parts) > 1.0 then { let password = get(parts, 1.0) }
      if password == env("LOCKDOWN_PASSWORD") or password == kv_get("lockdown_password") then {
        kv_set("system_lockdown", "true")
        let _ = AuditLog("lockdown", "system", "owner locked office")
        let _ = SendTelegramReply(chat_id, "LOCKDOWN activated. Only /unlock available.")
      } else {
        let _ = SendTelegramReply(chat_id, "Wrong password.")
      }
      return respond("200 ok")
    }

    // /fix — record correction (MEGA-3, native Metalogos)
    if starts_with(text, "/fix") then {
      let correction_text = substring(text, 5.0, length(text))
      if length(correction_text) > 1.0 then {
        let recent_rows = query("SELECT dept, content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' ORDER BY id DESC LIMIT 1", [chat_id])
        let recent_dept = "global"
        each r in recent_rows {
          let recent_dept = to_string(json_get(r, "dept", "global"))
        }
        let user_rows = query("SELECT content FROM dialog_history WHERE chat_id = ? AND role = 'user' ORDER BY id DESC LIMIT 1", [chat_id])
        let recent_query = ""
        each r in user_rows {
          let recent_query = to_string(json_get(r, "content", ""))
        }
        let _ = db_execute("INSERT INTO adapt_corrections (dept, original_query, correction, corr_type) VALUES (?1, ?2, ?3, 'manual')", [recent_dept, substring(recent_query, 0.0, 2000.0), substring(correction_text, 0.0, 2000.0)])
        let _ = AuditLog("correction_fix", recent_dept, "type=manual text=" + substring(correction_text, 0.0, 80.0))
        if recent_dept == "yana" then {
          let yana_rows = query("SELECT content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' AND dept = 'yana' ORDER BY id DESC LIMIT 1", [chat_id])
          let yana_answer = ""
          each r in yana_rows {
            let yana_answer = to_string(json_get(r, "content", ""))
          }
          let _ = YanaRecordForgetting(chat_id, recent_query, yana_answer, correction_text)
        }
        let _ = SendTelegramReply(chat_id, "Correction saved for " + recent_dept + ".")
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /fix <your correction>")
      }
      return respond("200 ok")
    }

    // /good — positive example (MEGA-3)
    if text == "/good" then {
      let recent_rows = query("SELECT dept, content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' ORDER BY id DESC LIMIT 1", [chat_id])
      let recent_dept = "global"
      let recent_reply = ""
      each r in recent_rows {
        let recent_dept = to_string(json_get(r, "dept", "global"))
        let recent_reply = to_string(json_get(r, "content", ""))
      }
      let user_rows = query("SELECT content FROM dialog_history WHERE chat_id = ? AND role = 'user' ORDER BY id DESC LIMIT 1", [chat_id])
      let user_query = ""
      each r in user_rows {
        let user_query = to_string(json_get(r, "content", ""))
      }
      let _ = RecordPositiveExample(recent_dept, user_query, recent_reply)
      let _ = SendTelegramReply(chat_id, "Positive feedback recorded for " + recent_dept + ".")
      return respond("200 ok")
    }

    // /наряды — нарядная очередь (FO-046, must be before /наряд to avoid prefix match):
    // счётчики по статусам + открытые наряды (паттерн NaradQueueView в dept/narad.mlog)
    if text == "/наряды" then {
      let queue_msg = NaradQueueView()
      let _ = SendTelegramReply(chat_id, queue_msg)
      return respond("200 ok")
    }

    // /наряд готов N — закрыть наряд (FO-048: гейт — только после пройденной приёмки)
    if starts_with(text, "/наряд готов ") then {
      let narad_id = trim(substring(text, 13.0, length(text)))
      let res = NaradDone(narad_id, chat_id)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    // /наряд приёмка <ID> ok|fail <комментарий> — вердикт приёмки (FO-048)
    if starts_with(text, "/наряд приёмка ") then {
      let _sp = " "
      let parsed = parse_json(NaradSplitArgs(substring(text, 15.0, length(text))))
      let nid = to_string(json_get(parsed, "id", ""))
      let tail = to_string(json_get(parsed, "tail", ""))
      let tparts = split(tail, _sp)
      let verdict = ""
      if length(tparts) > 0.0 then { let verdict = trim(to_string(get(tparts, 0))) }
      let cmt = ""
      if (verdict == "ok" or verdict == "fail") and length(tail) > length(verdict) then {
        let cmt = trim(substring(tail, length(verdict) + 1.0, length(tail)))
      }
      if nid == "" or (verdict != "ok" and verdict != "fail") then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд приёмка <ID> ok|fail <комментарий>")
        return respond("200 ok")
      }
      let res = NaradAccept(nid, verdict, chat_id, cmt)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }

    // /наряд отмена N — cancel naryad
    if starts_with(text, "/наряд отмена ") then {
      let narad_id = trim(substring(text, 14.0, length(text)))
      db_execute("UPDATE narads SET status = 'rejected' WHERE id = ?1", [narad_id])
      let _ = AuditLog("naryad_cancel_cmd", "admin", "cancelled: " + narad_id)
      let _ = SendTelegramReply(chat_id, "Наряд " + narad_id + " отменён.")
      return respond("200 ok")
    }

    // ── FO-046 (#161): нарядный контур 2.0 — поля и переходы ─────────────
    // Поля: план, критерии, исполнитель, приоритет. Переходы: в-очередь,
    // в-работу, в-тест, блок, разблок. Логика — dept/narad.mlog.
    if starts_with(text, "/наряд план ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 12.0, length(text))))
      let nid = to_string(json_get(parsed, "id", ""))
      let body_text = to_string(json_get(parsed, "tail", ""))
      if nid == "" or body_text == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд план <ID> <шаги работ>")
        return respond("200 ok")
      }
      let res = NaradSetField(nid, "plan", body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд критерии ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 16.0, length(text))))
      let nid = to_string(json_get(parsed, "id", ""))
      let body_text = to_string(json_get(parsed, "tail", ""))
      if nid == "" or body_text == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд критерии <ID> <сделано, когда...>")
        return respond("200 ok")
      }
      let res = NaradSetField(nid, "acceptance", body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд исполнитель ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 19.0, length(text))))
      let nid = to_string(json_get(parsed, "id", ""))
      let body_text = to_string(json_get(parsed, "tail", ""))
      if nid == "" or body_text == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд исполнитель <ID> <отдел>")
        return respond("200 ok")
      }
      let res = NaradSetField(nid, "dept", body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд приоритет ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 17.0, length(text))))
      let nid = to_string(json_get(parsed, "id", ""))
      let body_text = to_string(json_get(parsed, "tail", ""))
      if nid == "" or body_text == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд приоритет <ID> <high|normal|low>")
        return respond("200 ok")
      }
      let res = NaradSetField(nid, "priority", body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд в-очередь ") then {
      let nid = trim(substring(text, 17.0, length(text)))
      let res = NaradTransition(nid, "queue", chat_id, "")
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд в-работу ") then {
      let nid = trim(substring(text, 16.0, length(text)))
      let res = NaradTransition(nid, "work", chat_id, "")
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд в-тест ") then {
      let nid = trim(substring(text, 14.0, length(text)))
      let res = NaradTransition(nid, "test", chat_id, "")
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд блок ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 12.0, length(text))))
      let nid = to_string(json_get(parsed, "id", ""))
      let body_text = to_string(json_get(parsed, "tail", ""))
      if nid == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд блок <ID> <причина>")
        return respond("200 ok")
      }
      let res = NaradTransition(nid, "block", chat_id, body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд разблок ") then {
      let nid = trim(substring(text, 15.0, length(text)))
      let res = NaradTransition(nid, "unblock", chat_id, "")
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }

    // /наряд <text> — quick bug/task recording for admin
    if starts_with(text, "/наряд ") then {
      let naryad_text = trim(substring(text, 7.0, length(text)))
      if length(naryad_text) < 3.0 then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд <описание бага/задачи>")
        return respond("200 ok")
      }
      // Generate short ID: N + counter
      let counter = kv_get("naryad_counter")
      let mut count = 1
      if counter != "" then { count = to_int(counter) + 1 }
      let _ = kv_set("naryad_counter", to_string(count))
      let naryad_id = "N" + to_string(count)
      // Get context: last assistant reply for reference
      let recent_rows = query("SELECT dept, content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' ORDER BY id DESC LIMIT 1", [chat_id])
      let context_line = ""
      if length(recent_rows) > 0.0 then {
        let first_row = try get(recent_rows, 0.0)
        if to_string(first_row) != "()" then {
          let recent_dept = to_string(try json_get(first_row, "dept", ""))
          if recent_dept != "" then {
            let context_line = "Контекст: ответ отдела " + recent_dept
          }
        }
      }
      // Save to narads table
      db_execute("INSERT INTO narads (id, title, description, requested_by, risk_level, status) VALUES (?1, ?2, ?3, ?4, ?5, 'pending')", [naryad_id, substring(naryad_text, 0.0, 100.0), naryad_text, chat_id, "low"])
      let _ = AuditLog("naryad_created", "admin", "id=" + naryad_id + " text=" + substring(naryad_text, 0.0, 80.0))
      // FO-046: подтверждение с кнопками Принять/Пропустить (do_naryad_/skip_naryad_)
      let confirm = "Наряд " + naryad_id + " записан:\n" + naryad_text + "\n" + context_line
      let _ = NaradSendButtons(chat_id, confirm, naryad_id)
      return respond("200 ok")
    }


    // /learning — stats (MEGA-3)
    if text == "/learning" then {
      let stats_result = GetLearningStats()
      let stats_json = parse_json(stats_result)
      let corrections_7d = json_get(stats_json, "corrections_7d", "0")
      let positive_count = json_get(stats_json, "positive_count", "0")
      let msg = "Learning stats (7 days):\n"
      let msg = msg + "- Corrections: " + corrections_7d + "\n"
      let msg = msg + "- Positive examples: " + positive_count + "\n"
      let msg = msg + "- Error types: see office dashboard"
      let _ = SendTelegramReply(chat_id, msg)
      return respond("200 ok")
    }

    // /yana-metrics — delegation accuracy & forgetting incidents
    if text == "/yana-metrics" then {
      let metrics = YanaGetMetrics()
      let _ = SendTelegramReply(chat_id, metrics)
      return respond("200 ok")
    }

    // /debrief — LLM analysis of errors per dept (MEGA-3)
    if starts_with(text, "/debrief") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let dept = trim(get(parts, 1.0))
        let debrief_result = try DebriefDepartment(dept)
        if to_string(debrief_result) == "()" then {
          let _ = SendTelegramReply(chat_id, "Debrief " + dept + ": недостаточно данных или функция недоступна.")
        } else {
          let _ = SendTelegramReply(chat_id, "Debrief " + dept + ":\n\n" + substring(debrief_result, 0.0, 2000.0))
        }
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /debrief <dept>\nExample: /debrief osp")
      }
      return respond("200 ok")
    }

    // /digest
    if text == "/digest" then {
      let result = try EveningSummary()
      if to_string(result) == "()" then {
        let _ = SendTelegramReply(chat_id, "Evening summary error — check logs.")
      } else {
        let _ = SendTelegramReply(chat_id, "Evening digest sent.")
      }
      return respond("200 ok")
    }

    // /review
    if text == "/review" then {
      // FO-020: review-очередь выведенного — approve/decline/undo кнопками
      let _ = ReviewQueueCard(chat_id)
      return respond("200 ok")
    }

    // /brief — manual morning brief (MEGA-3)
    if text == "/brief" then {
      let _ = MorningBrief()
      let _ = SendTelegramReply(chat_id, "Morning brief sent.")
      let _ = AuditLog("manual_brief", "yana", "manual morning brief triggered")
      return respond("200 ok")
    }

    // ── /quest — dossier/task management (QUEST-1) ──
    if starts_with(text, "/quest") then {
      // /quest list
      if starts_with(text, "/quest list") then {
        let info = QuestList(chat_id)
        let _ = SendTelegramReply(chat_id, info)
        return ""
      }
      // /quest new <title> | <type> | <steps> | <deadline>
      // Example: /quest new Grant FondX | grant | 6 | 2026-09-15
      if starts_with(text, "/quest new ") then {
        let rest = substring(text, 11.0, length(text))
        let parts = split(rest, "|")
        let qtitle = trim(get(parts, 0.0))
        let qtype = "general"
        let qsteps = "5"
        let qdeadline = ""
        if length(parts) > 1.0 then { let qtype = trim(get(parts, 1.0)) }
        if length(parts) > 2.0 then { let qsteps = trim(get(parts, 2.0)) }
        if length(parts) > 3.0 then { let qdeadline = trim(get(parts, 3.0)) }
        let qid = QuestCreate(qtitle, qtype, qsteps, qdeadline, chat_id)
        let status = QuestStatus(qid)
        let _ = SendTelegramReply(chat_id, "Dosse sozdano: " + qid + "\n\n" + status)
        return ""
      }
      // /quest status <id>
      if starts_with(text, "/quest status ") then {
        let qid = trim(substring(text, 14.0, length(text)))
        let info = QuestStatus(qid)
        let _ = SendTelegramReply(chat_id, info)
        return ""
      }
      // /quest approve <id> [step_num]
      if starts_with(text, "/quest approve ") then {
        let rest = trim(substring(text, 15.0, length(text)))
        let parts = split(rest, _sp)
        let qid = get(parts, 0.0)
        let result = QuestApproveStep(qid, "owner")
        let _ = SendTelegramReply(chat_id, result)
        return ""
      }
      // /quest next <id> — advance to next step
      if starts_with(text, "/quest next ") then {
        let qid = trim(substring(text, 12.0, length(text)))
        let result = QuestAdvanceStep(qid)
        let _ = SendTelegramReply(chat_id, result)
        return ""
      }
      // /quest close <id>
      if starts_with(text, "/quest close ") then {
        let qid = trim(substring(text, 13.0, length(text)))
        let result = QuestClose(qid)
        let _ = SendTelegramReply(chat_id, result)
        return ""
      }
      // /quest send <id> | <recipient> | <subject>
      if starts_with(text, "/quest send ") then {
        let rest = trim(substring(text, 12.0, length(text)))
        let parts = split(rest, "|")
        let qid = trim(get(parts, 0.0))
        let recipient = ""
        let subject = ""
        if length(parts) > 1.0 then { let recipient = trim(get(parts, 1.0)) }
        if length(parts) > 2.0 then { let subject = trim(get(parts, 2.0)) }
        let result = QuestSendPackage(qid, recipient, subject)
        let _ = SendTelegramReply(chat_id, result)
        return ""
      }
      // /quest help
      let _ = SendTelegramReply(chat_id, "Komandy dosse:\n/quest new <title> | <type> | <steps> | <deadline>\n/quest list\n/quest status <id>\n/quest next <id> — advance step\n/quest approve <id> — approve current step\n/quest close <id>\n/quest send <id> | <email> | <subject>")
      return ""
    }

    // /rate
    if starts_with(text, "/rate") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let rating = get(parts, 1.0)
        db_execute("INSERT INTO dept_metrics (dept, metric_name, metric_value, period) VALUES ('global', 'satisfaction', ?1, 'daily')", [rating])
        let _ = AuditLog("rating", "system", "rating=" + rating)
        let _ = SendTelegramReply(chat_id, "Rating " + rating + " recorded.")
      }
      return respond("200 ok")
    }

    // /rate-yana — owner feedback for Yana metrics
    if starts_with(text, "/rate-yana") then {
      let parts = split(text, _sp)
      let score = get(parts, 1.0)
      let comment = join(slice(parts, 2.0, length(parts)), _sp)
      db_execute("INSERT INTO dept_metrics (dept, metric_name, metric_value, period, created_at) VALUES ('yana', 'owner_feedback', ?1, 'manual', datetime('now'))", [score])
      if length(comment) > 0.0 then {
        db_execute("INSERT INTO dept_metrics (dept, metric_name, metric_value, period, created_at) VALUES ('yana', 'owner_comment', ?1, 'manual', datetime('now'))", [comment])
      }
      let _ = AuditLog("rate_yana", "owner", "score=" + score)
      let _ = SendTelegramReply(chat_id, "Yana feedback recorded: " + score + "/10")
      return ""
    }

    // /quarterly-review — methodology compliance review for a department
    if starts_with(text, "/quarterly-review") then {
      let parts = split(text, _sp)
      let target_dept = get(parts, 1.0)
      if length(target_dept) < 2.0 then {
        let _ = SendTelegramReply(chat_id, "Usage: /quarterly-review <dept>\nReviews methodology compliance for the department.")
        return ""
      }
      let profile = read_file("library/" + target_dept + ".md")
      let methodology = read_file("METHODOLOGY.md")
      let metrics = query("SELECT metric_name, metric_value, created_at FROM dept_metrics WHERE dept = ? ORDER BY id DESC LIMIT 20", [target_dept])
      let corrections = query("SELECT original_query, correction, created_at FROM adapt_corrections WHERE dept = ? ORDER BY id DESC LIMIT 10", [target_dept])
      let context = "QUARTERLY METHODOLOGY REVIEW for department: " + target_dept + "\n\nMETHODOLOGY.md (relevant sections):\n" + substring(methodology, 0.0, 3000.0) + "\n\nDepartment profile:\n" + profile + "\n\nRecent metrics:\n" + to_string(metrics) + "\n\nRecent corrections:\n" + to_string(corrections) + "\n\nTask: Review this department against the methodology. Check: (1) hard rules compliance, (2) metrics health, (3) anti-patterns, (4) skills coverage. Output a structured review."
      let dept = "kavalnya"
      let _ = HandleDeptQuery(chat_id, dept, context)
      return ""
    }

    // /remind — scheduled reminders (F-1)
    if starts_with(text, "/remind") then {
      // B.5 — /remind list
      if text == "/remind list" then {
        let rows = query("SELECT id, COALESCE(event_text,'') AS event_text, COALESCE(rrule_kind,'') AS rrule_kind, COALESCE(fire_time,'') AS fire_time, COALESCE(fire_weekday,'') AS fire_weekday, COALESCE(fire_monthday,'') AS fire_monthday, COALESCE(datetime(next_fire_at,'+3 hours'),'') AS next_local FROM yana_events WHERE active = 1 AND rrule_kind IS NOT NULL AND chat_id = ? ORDER BY next_fire_at ASC LIMIT 30", [chat_id])
        if length(rows) == 0.0 then {
          let _ = SendTelegramReply(chat_id, "Напоминаний нет.")
        } else {
          let output = ""
          each row in rows {
            let rid = json_get(row, "id", "")
            let rkind = json_get(row, "rrule_kind", "")
            let rlocal = json_get(row, "next_local", "")
            let rtext = json_get(row, "event_text", "")
            let when = rlocal
            if when == "" then {
              let mut when = to_string(json_get(row, "fire_time", ""))
              if when == "" then { when = "время не указано" }
            }
            let output = output + to_string(rid) + ". " + rtext + " \u2014 " + when + " (" + rkind + ")\n"
          }
          let _ = SendTelegramReply(chat_id, output)
        }
        return respond("200 ok")
      }
      // B.5b — /remind clear
      if text == "/remind clear" then {
        let cnt = query("SELECT COUNT(*) AS c FROM yana_events WHERE active = 1 AND chat_id = ?", [chat_id])
        let n = to_string(json_get(cnt[0], "c", "0"))
        let _ = query("UPDATE yana_events SET active = 0 WHERE chat_id = ?", [chat_id])
        let _ = AuditLog("remind_clear", "yana", "cleared=" + n)
        let _ = SendTelegramReply(chat_id, "Удалено напоминаний: " + n + ". Список пуст.")
        return respond("200 ok")
      }
      // B.6 — /remind del <id>
      if starts_with(text, "/remind del ") then {
        let del_id = substring(text, 12.0, length(text))
        let existing = query("SELECT id FROM yana_events WHERE id = ? AND active = 1", [del_id])
        if length(existing) > 0.0 then {
          let _ = query("UPDATE yana_events SET active = 0 WHERE id = ?", [del_id])
          let _ = SendTelegramReply(chat_id, "Удалила напоминание " + del_id)
        } else {
          let _ = SendTelegramReply(chat_id, "Не нашла напоминание с таким номером.")
        }
        return respond("200 ok")
      }
      // B.1 — /remind daily HH:MM текст
      if starts_with(text, "/remind daily ") then {
        if length(text) > 20.0 and substring(text, 16.0, 17.0) == ":" then {
          let fire_time = substring(text, 14.0, 19.0)
          let reminder_text = substring(text, 20.0, length(text))
          if reminder_text != "" then {
            let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'daily', ?, ?, 1, datetime('now'), CASE WHEN datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours') ELSE datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours', '+1 day') END)", [reminder_text, fire_time, chat_id, fire_time, fire_time, fire_time])
            let _ = SendTelegramReply(chat_id, "Записала: каждый день в " + fire_time + " \u2014 " + reminder_text)
            return respond("200 ok")
          }
        }
        let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
        return respond("200 ok")
      }
      // B.2 — /remind once YYYY-MM-DD HH:MM текст
      if starts_with(text, "/remind once ") then {
        if length(text) > 29.0 and substring(text, 26.0, 27.0) == ":" then {
          let ev_date = substring(text, 13.0, 23.0)
          let fire_time = substring(text, 24.0, 29.0)
          let reminder_text = substring(text, 30.0, length(text))
          if reminder_text != "" then {
            let _ = query("INSERT INTO yana_events (event_text, event_type, event_date, rrule_kind, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', ?, 'once', ?, ?, 1, datetime('now'), datetime(? || ' ' || ? || ':00', '-3 hours'))", [reminder_text, ev_date, fire_time, chat_id, ev_date, fire_time])
            let _ = SendTelegramReply(chat_id, "Записала: " + ev_date + " в " + fire_time + " \u2014 " + reminder_text)
            return respond("200 ok")
          }
        }
        let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
        return respond("200 ok")
      }
      // B.3 — /remind weekly <day> HH:MM текст
      if starts_with(text, "/remind weekly ") then {
        let day_part = substring(text, 15.0, 18.0)
        let valid_day = (day_part == "mon" or day_part == "tue" or day_part == "wed" or day_part == "thu" or day_part == "fri" or day_part == "sat" or day_part == "sun")
        if valid_day and length(text) > 25.0 and substring(text, 21.0, 22.0) == ":" then {
          let fire_time = substring(text, 19.0, 24.0)
          let reminder_text = substring(text, 25.0, length(text))
          if reminder_text != "" then {
            let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_weekday, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'weekly', ?, ?, ?, 1, datetime('now'), CASE WHEN datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours') ELSE datetime(datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours'), '+7 days') END)", [reminder_text, day_part, fire_time, chat_id, day_part, fire_time, day_part, fire_time, day_part, fire_time])
            let _ = SendTelegramReply(chat_id, "Записала: каждую " + day_part + " в " + fire_time + " \u2014 " + reminder_text)
            return respond("200 ok")
          }
        }
        let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
        return respond("200 ok")
      }
      // B.4 — /remind yearly MM-DD HH:MM текст
      if starts_with(text, "/remind yearly ") then {
        if length(text) > 27.0 and substring(text, 17.0, 18.0) == "-" then {
          let monthday = substring(text, 15.0, 20.0)
          let fire_time = substring(text, 21.0, 26.0)
          let reminder_text = substring(text, 27.0, length(text))
          if reminder_text != "" and substring(fire_time, 2.0, 3.0) == ":" then {
            let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_monthday, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'yearly', ?, ?, ?, 1, datetime('now'), CASE WHEN datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours') ELSE datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours', '+1 year') END)", [reminder_text, monthday, fire_time, chat_id, monthday, fire_time, monthday, fire_time, monthday, fire_time])
            let _ = SendTelegramReply(chat_id, "Записала: ежегодно " + monthday + " в " + fire_time + " \u2014 " + reminder_text)
            return respond("200 ok")
          }
        }
        let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
        return respond("200 ok")
      }
      // B.7 — hint for unknown /remind subcommand
      let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
      return respond("200 ok")
    }

    // /calendar — show Yana events
    if text == "/calendar" then {
      let rows = query("SELECT COALESCE(event_text,'') AS event_text, COALESCE(event_date,'') AS event_date, COALESCE(event_type,'напоминание') AS event_type FROM yana_events ORDER BY event_date ASC LIMIT 20", [])
      if length(rows) == 0.0 then {
        let _ = SendTelegramReply(chat_id, "Календарь пуст. Используй /remember <текст> [дата] чтобы добавить событие.")
      } else {
        let output = "Календарь Яны (" + to_string(length(rows)) + "):\n\n"
        let i = 0.0
        each row in rows {
          let i = i + 1.0
          let etext = json_get(row, "event_text", "")
          let edate = json_get(row, "event_date", "")
          let etype = json_get(row, "event_type", "напоминание")
          let output = output + to_string(i) + ". [" + edate + "] " + etext + " (" + etype + ")\n"
        }
        let _ = SendTelegramReply(chat_id, output)
      }
      return respond("200 ok")
    }

    // /remember
    if starts_with(text, "/remember") then {
      let fact = substring(text, 10.0, length(text))
      if fact != "" then {
        let _ = query("INSERT INTO yana_events (event_text, event_type, created_at) VALUES (?, 'reminder', datetime('now'))", [fact])
        let _ = AuditLog("remember", "system", substring(fact, 0.0, 100.0))
        let _ = SendTelegramReply(chat_id, "Запомнила.")
      }
      return respond("200 ok")
    }

    // /model — OmniRoute combos
    if text == "/model" or text == "/model list" then {
      let provider = read_file("config/priority_provider.txt")
      let model = read_file("config/priority_model.txt")
      let _ = SendTelegramReply(chat_id, "OmniRoute Model Combos:\n\nAuto — route selects combo by dept/depth\n/model auto — reset to auto routing\n/model cheap — force fosved-free (groq→cerebras→deepseek)\n/model best — force fosved-deep (kimi→deepseek→zai→groq→cerebras→anthropic)\n/model fusion — force fosved-fusion (multi-provider consensus)\n\nDirect fallback:\nProvider: " + trim(provider) + "\nModel: " + trim(model) + "\n\n/model set <provider> <model>\n/model <dept> <provider> <model>\n/model reset")
      return respond("200 ok")
    }

    if text == "/model auto" then {
      kv_set("force_combo", "")
      let _ = AuditLog("model_auto", "system", "combo reset to auto")
      let _ = SendTelegramReply(chat_id, "Model routing: AUTO (OmniRoute selects combo by dept/depth)")
      return respond("200 ok")
    }

    if text == "/model cheap" then {
      kv_set("force_combo", "fosved-free")
      let _ = AuditLog("model_cheap", "system", "combo=fosved-free")
      let _ = SendTelegramReply(chat_id, "Model: fosved-free (groq → deepseek → cerebras, zero cost)")
      return respond("200 ok")
    }

    if text == "/model best" then {
      kv_set("force_combo", "fosved-deep")
      let _ = AuditLog("model_best", "system", "combo=fosved-deep")
      let _ = SendTelegramReply(chat_id, "Model: fosved-deep (zai → groq → deepseek → cerebras → anthropic)")
      return respond("200 ok")
    }

    if text == "/model fusion" then {
      kv_set("force_combo", "fosved-fusion")
      let _ = AuditLog("model_fusion", "system", "combo=fosved-fusion")
      let _ = SendTelegramReply(chat_id, "Model: fosved-fusion (zai + groq + deepseek + cerebras + anthropic consensus)")
      return respond("200 ok")
    }

    if starts_with(text, "/model set") then {
      let parts = split(text, _sp)
      if length(parts) > 2.0 then {
        let p = get(parts, 2.0)
        let m = get(parts, 3.0)
        let _ = write_file("config/priority_provider.txt", trim(p))
        let _ = write_file("config/priority_model.txt", trim(m))
        let _ = AuditLog("model_set", "system", "provider=" + trim(p) + " model=" + trim(m))
        let _ = SendTelegramReply(chat_id, "Model set: " + trim(p) + " / " + trim(m))
      }
      return respond("200 ok")
    }

    if text == "/model reset" then {
      let _ = write_file("config/priority_provider.txt", "zai")
      let _ = write_file("config/priority_model.txt", "glm-4.6")
      kv_set("force_combo", "")
      let _ = SendTelegramReply(chat_id, "Model reset to defaults: OmniRoute auto, zai / glm-4.6 fallback")
      return respond("200 ok")
    }

    if starts_with(text, "/model ") then {
      let parts = split(text, _sp)
      if length(parts) > 2.0 then {
        let dept_slug = trim(get(parts, 1.0))
        if length(parts) > 3.0 then {
          let p = get(parts, 2.0)
          let m = get(parts, 3.0)
          let _ = write_file("config/override_" + dept_slug + ".txt", trim(p) + " " + trim(m))
          let _ = SendTelegramReply(chat_id, "Override " + dept_slug + ": " + trim(p) + " / " + trim(m))
        }
      }
      return respond("200 ok")
    }

    // /cost — token costs by department
    if text == "/cost" or text == "/costs" then {
      let _ = SendTelegramReply(chat_id, ShowCosts(chat_id))
      return respond("200 ok")
    }

    // /stats-aggregate — force recalculate costs
    if text == "/stats-aggregate" then {
      let result = AggregateDailyStats()
      let _ = SendTelegramReply(chat_id, "Recalculated: " + result)
      return respond("200 ok")
    }

    // /stats — daily usage statistics
    if text == "/stats" then {
      let _ = SendTelegramReply(chat_id, ShowStats(chat_id))
      return respond("200 ok")
    }

    // /model-cost — list configured pricing
    if text == "/model-cost" then {
      let known_models = ["deepseek-chat", "gpt-4o", "gpt-4o-mini", "glm-4.6", "kimi-chat", "groq-llama", "cerebras-llama"]
      let mut out = "Стоимость моделей (/1M tokens):"
      let mut found_any = "0"
      each m in known_models {
        let mut c_in = kv_get("model_cost:" + m + ":in")
        let mut c_out = kv_get("model_cost:" + m + ":out")
        if c_in == "" then { c_in = "-" }
        if c_out == "" then { c_out = "-" }
        if c_in == "-" and c_out == "-" then { } else {
          out = out + "\n  " + m + " | in: $" + c_in + " | out: $" + c_out
          found_any = "1"
        }
      }
      if found_any == "0" then { out = out + "\n  (не задано)" }
      out = out + "\n\n/model-cost set <model> <in|out> <price>"
      let _ = SendTelegramReply(chat_id, out)
      return respond("200 ok")
    }

    // /model-cost set <model> <in|out> <price_per_1M>
    if starts_with(text, "/model-cost set ") then {
      let rest = substring(text, 16.0, 10000.0)
      let parts = split(rest, " ")
      if length(parts) >= 3.0 then {
        let mc_model = trim(get(parts, 0.0))
        let mc_dir = trim(get(parts, 1.0))
        let mc_price = trim(get(parts, 2.0))
        if mc_dir == "in" or mc_dir == "out" then {
          let _ = kv_set("model_cost:" + mc_model + ":" + mc_dir, mc_price)
          let _ = SendTelegramReply(chat_id, "Model pricing: " + mc_model + " (" + mc_dir + ") = $" + mc_price + "/1M tokens")
        } else {
          let _ = SendTelegramReply(chat_id, "Direction: in or out. Example: /model-cost set gpt-4o in 2.5")
        }
      } else {
        let _ = SendTelegramReply(chat_id, "Format: /model-cost set <model> <in|out> <price per 1M>")
      }
      return respond("200 ok")
    }

    // /inject <dept> <text> — FOIP-003.6: inject cross-dept context
    if starts_with(text, "/inject ") then {
      let rest = substring(text, 8.0, 10000.0)
      let parts = split(rest, _sp)
      if length(parts) >= 2.0 then {
        let target_dept = get(parts, 0.0)
        let ctx_text = substring(rest, length(target_dept) + 1.0, 10000.0)
        let _ = InjectContext(target_dept, ctx_text)
        let _ = SendTelegramReply(chat_id, "Injected context into " + target_dept + ". Will be used on next query.")
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /inject <dept> <context text>")
      }
      return respond("200 ok")
    }


    // /budget
    if starts_with(text, "/budget") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let amount = get(parts, 1.0)
        kv_set("daily_budget", amount)
        let _ = SendTelegramReply(chat_id, "Daily budget set: $" + amount)
      } else {
        let mut budget = kv_get("daily_budget")
        if budget == "" then { budget = "not set" }
        // FO-024: срез бюджетов — spent/limit по департаментам + кто в эконом-режиме
        let resp = try http_get("http://127.0.0.1:4000/api/budget/status")
        let mut extra = ""
        if to_string(resp) != "()" then {
          let parsed = try parse_json(resp)
          if to_string(parsed) != "()" then {
            let g = try json_get(parsed, "global", "{}")
            let gspent = to_string(json_get(g, "spent", "0"))
            let glimit = to_string(json_get(g, "limit", "-"))
            let gstate = to_string(json_get(g, "state", "?"))
            let extra = "\n\nToday (UTC): spent $" + gspent + " / limit $" + glimit + " — " + gstate
            let depts = try json_get(parsed, "depts", "[]")
            if to_string(depts) != "()" then {
              each d in depts {
                let dn = to_string(json_get(d, "dept", "?"))
                let dsp = to_string(json_get(d, "spent", "0"))
                let dst = to_string(json_get(d, "state", "?"))
                let dlim = to_string(json_get(d, "limit", "-"))
                let extra = extra + "\n  " + dn + ": $" + dsp + " / $" + dlim + " — " + dst
              }
            }
            let econom = try json_get(parsed, "econom", "[]")
            if to_string(econom) != "()" then {
              let econ_list = join(econom, ", ")
              if econ_list != "" then {
                let extra = extra + "\n\nЭконом-режим (hard/stop): " + econ_list
              }
            }
          }
        }
        let _ = SendTelegramReply(chat_id, "Daily budget: $" + budget + extra)
      }
      return respond("200 ok")
    }

    // /shadow — FO-025: канареечный роутинг (настройка без правки кода)
    // /shadow <dept> <model> <rate> | /shadow off <dept>
    if starts_with(text, "/shadow") then {
      let parts = split(text, _sp)
      if length(parts) > 3.0 then {
        let sdept = to_string(get(parts, 1.0))
        let smodel = to_string(get(parts, 2.0))
        let srate = to_string(get(parts, 3.0))
        kv_set("shadow_" + sdept, "{\"model\":\"" + smodel + "\",\"rate\":" + srate + "}")
        let _ = AuditLog("shadow_config", "admin", "dept=" + sdept + " model=" + smodel + " rate=" + srate)
        let _ = SendTelegramReply(chat_id, "Shadow включён: " + sdept + " → кандидат " + smodel + " при rate=" + srate)
      } else {
        if length(parts) > 2.0 and to_string(get(parts, 1.0)) == "off" then {
          let sdept = to_string(get(parts, 2.0))
          kv_set("shadow_" + sdept, "")
          let _ = AuditLog("shadow_config", "admin", "dept=" + sdept + " OFF")
          let _ = SendTelegramReply(chat_id, "Shadow выключен: " + sdept)
        } else {
          let _ = SendTelegramReply(chat_id, "Формат: /shadow <dept> <model> <rate> | /shadow off <dept>")
        }
      }
      return respond("200 ok")
    }

    // /voice commands (MEGA-3 — enhanced)
    if starts_with(text, "/voice") then {
      let parts = split(text, _sp)
      let cmd = text
      if length(parts) > 1.0 then { let cmd = get(parts, 1.0) }
      if cmd == "on" then {
        kv_set("voice_enabled", "true")
        let _ = AuditLog("voice_on", "voice", "voice enabled")
        let _ = SendTelegramReply(chat_id, "Voice replies ON. Short answers will be spoken.")
      }
      if cmd == "off" then {
        kv_set("voice_enabled", "false")
        let _ = AuditLog("voice_off", "voice", "voice disabled")
        let _ = SendTelegramReply(chat_id, "Voice replies OFF.")
      }
      if cmd == "male" then {
        kv_set("tts_voice", "ru-RU-DmitryNeural")
        let _ = AuditLog("voice_male", "voice", "voice set to male")
        let _ = SendTelegramReply(chat_id, "Voice: male (Dmitry)")
      }
      if cmd == "female" then {
        kv_set("tts_voice", "ru-RU-SvetlanaNeural")
        let _ = AuditLog("voice_female", "voice", "voice set to female")
        let _ = SendTelegramReply(chat_id, "Voice: female (Svetlana)")
      }
      return respond("200 ok")
    }

    // /audit — show last 20 entries (MEGA-3 enhanced)
    if text == "/audit" then {
      let audit_rows = query("SELECT action, dept, details, timestamp FROM audit_log ORDER BY id DESC LIMIT 20", [])
      let output = "Last 20 audit events:\n"
      let count = 0.0
      each row in audit_rows {
        let action = to_string(json_get(row, "action", ""))
        let dept = to_string(json_get(row, "dept", ""))
        let ts = to_string(json_get(row, "timestamp", ""))
        let output = output + "[" + ts + "] " + action + " (" + dept + ")\n"
        let count = count + 1.0
        if count >= 20.0 then { }
      }
      let _ = SendTelegramReply(chat_id, output)
      let _ = AuditLog("audit_view", "system", "audit log viewed")
      return respond("200 ok")
    }

    // /narads
    if text == "/narads" then {
      let narad_rows = query("SELECT id, title, status, risk_level, created_at FROM narads ORDER BY id DESC LIMIT 10", [])
      let output = "Open narads:\n"
      each row in narad_rows {
        let nid = to_string(json_get(row, "id", ""))
        let title = to_string(json_get(row, "title", ""))
        let status = to_string(json_get(row, "status", ""))
        let output = output + nid + " [" + status + "] " + title + "\n"
      }
      let _ = SendTelegramReply(chat_id, output)
      return respond("200 ok")
    }

    // /dept <slug>
    if starts_with(text, "/dept ") then {
      let slug = substring(text, 6.0, length(text))
      let render_url = env("RENDER_URL")
      let _ = SendTelegramReply(chat_id, render_url + "/dept-dashboard/" + trim(slug))
      return respond("200 ok")
    }

    // /archive — TWO modes (narad 3/6):
    //   /archive <doc_id> — legacy: publish MiniApp report to archive channel
    //   /archive (no args) — legacy: publish last MiniApp report
    //   /archive <dept> [filter] — NEW: search dept_archive for generic depts
    if starts_with(text, "/archive") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let arg1 = trim(get(parts, 1.0))
        if arg1 == "list" then {
          let render_url = env("RENDER_URL")
          let token = env("TELEGRAM_BOT_TOKEN")
          let arch_body = json_encode({
            chat_id: to_float(chat_id),
            text: "Архив отчётов",
            reply_markup: {
              inline_keyboard: [[{
                text: "Открыть архив",
                web_app: { url: render_url + "/archive/browse" }
              }]]
            }
          })
          let _ = try http_post("https://api.telegram.org/bot" + token + "/sendMessage", arch_body, "application/json")
          return respond("200 ok")
        }
        // Check if arg1 is a generic dept name → dept_archive search
        if arg1 == "marketing" or arg1 == "finance" or arg1 == "legal" then {
          let filter_text = ""
          if length(parts) > 2.0 then {
            let filter_text = substring(text, 9.0 + length(arg1) + 1.0, length(text))
          }
          let rows_json = ArchiveSearch(arg1, trim(filter_text))
          let formatted = FormatArchiveRows(rows_json)
          let _ = SendTelegramReply(chat_id, "Архив " + arg1 + ":\n" + formatted)
        } else {
          // Legacy: publish specific MiniApp doc by doc_id
          let doc_id = arg1
          let doc_rows = query("SELECT dept, title, raw_text FROM miniapp_responses WHERE id = ?", [doc_id])
          let doc_dept = ""
          let doc_title = ""
          let doc_content = ""
          if length(doc_rows) > 0.0 then {
            let first = get(doc_rows, 0.0)
            let doc_dept = to_string(json_get(first, "dept", ""))
            let doc_title = to_string(json_get(first, "title", ""))
            let doc_content = to_string(json_get(first, "raw_text", ""))
          }
          if doc_dept != "" then {
            let msg_id = PublishToArchive(doc_id, doc_dept, doc_title, doc_content)
            let _ = SendTelegramReply(chat_id, "Archived: " + doc_title + " (msg_id: " + msg_id + ")")
          } else {
            let _ = SendTelegramReply(chat_id, "Report " + doc_id + " not found.")
          }
        }
      } else {
        // No args: show archive status
        let last_rows = try query("SELECT id, dept, title FROM miniapp_responses ORDER BY created_at DESC LIMIT 1", [])
        if to_string(last_rows) == "()" or length(last_rows) == 0.0 then {
          let _ = SendTelegramReply(chat_id, "No reports to archive.")
        } else {
          let first = try get(last_rows, 0.0)
          let last_title = to_string(try json_get(first, "title", "?"))
          let _ = SendTelegramReply(chat_id, "Last report: " + last_title + "\nUse /archive list to browse.")
        }
      }
      return respond("200 ok")
    }

    // /verify <dept> <id> <outcome> — verify an archived entry (narad 3/6, extended narad 8)
    // Structured: /verify finance <id> actual=<число> | /verify legal <id> outcome=clean|rewrite_required
    // Legacy: /verify <dept> <id> <free text> (marketing, etc.)
    if starts_with(text, "/verify ") then {
      let rest = substring(text, 8.0, length(text))
      let parts = split(rest, _sp)
      if length(parts) >= 3.0 then {
        let dept = trim(get(parts, 0.0))
        let entry_id = to_int(trim(get(parts, 1.0)))
        // outcome = everything after dept and id (may contain spaces, e.g. "actual=145200" or "outcome=clean")
        let prefix_len = length(dept) + length(trim(get(parts, 1.0))) + 2.0
        let mut outcome = substring(rest, prefix_len, length(rest))
        if outcome == "" then { outcome = "подтверждено" }
        // Narad 8: route to structured verify
        let result = VerifyArchiveEntryStructured(dept, entry_id, outcome)
        let _ = AuditLog("archive_verify", dept, "id=" + to_string(entry_id) + " outcome=" + substring(outcome, 0.0, 80.0))
        let _ = SendTelegramReply(chat_id, result)
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /verify <dept> <id> <исход>\nStructured: /verify finance 3 actual=145200\n           /verify legal 5 outcome=clean\nLegacy: /verify marketing 2 текст исхода\nDepts: marketing, finance, legal")
      }
      return respond("200 ok")
    }

    // /score <dept> — activity + calibrated metrics (narad 3/6 + narad 8)
    if starts_with(text, "/score ") then {
      let dept = trim(substring(text, 7.0, length(text)))
      if dept == "marketing" or dept == "finance" or dept == "legal" then {
        let result = try ScoreDept(dept)
        if to_string(result) == "()" then {
          let _ = SendTelegramReply(chat_id, "ScoreDept error для " + dept)
        } else {
          let _ = SendTelegramReply(chat_id, result)
        }
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /score <dept>\nGeneric depts: marketing, finance, legal\nFinance: базовая активность + MAPE (при >=10 verified pairs)\nLegal: базовая активность + % без rewrites (при >=10 verified)")
      }
      return respond("200 ok")
    }

    // /autoarchive on/off (MEGA-3)
    if starts_with(text, "/autoarchive") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let mode = trim(get(parts, 1.0))
        kv_set("auto_archive", mode)
        let _ = AuditLog("autoarchive_set", "archive", "mode=" + mode)
        if mode == "on" then {
          let _ = SendTelegramReply(chat_id, "Auto-archive ON. All reports > 800 chars will be published to archive channel.")
        } else {
          let _ = SendTelegramReply(chat_id, "Auto-archive OFF. Use /archive manually.")
        }
      } else {
        let mut current = kv_get("auto_archive")
        if current == "" then { current = "on" }
        let _ = SendTelegramReply(chat_id, "Auto-archive: " + current)
      }
      return respond("200 ok")
    }

    // /search — search archive + memories (MEGA-3)
    if starts_with(text, "/search") then {
      let query_text = substring(text, 8.0, length(text))
      if query_text != "" then {
        let search_result = SearchArchive(query_text)
        let results_json = parse_json(search_result)
        let results_raw = json_get(results_json, "results", "[]")
        let mem_raw = json_get(results_json, "memories", "[]")
        let results = to_string(results_raw)
        let mems = to_string(mem_raw)
        let _ = AuditLog("archive_search", "archive", "query=" + query_text)
        let out = ""
        if results != "[]" and results != "" then {
          let out = "Архив:\n" + substring(results, 0.0, 1500.0)
        }
        if mems != "[]" and mems != "" then {
          let out = out + "\nПамять:\n" + substring(mems, 0.0, 1500.0)
        }
        if out != "" then {
          let _ = SendTelegramReply(chat_id, out)
        } else {
          let _ = SendTelegramReply(chat_id, "Nothing found for: " + query_text)
        }
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /search <query>")
      }
      return respond("200 ok")
    }

    // FO-035 C.1: короткая форма проекта — активный диалог перехватывает ввод
    if kv_get("forge_form_step_" + chat_id) != "" and kv_get("forge_form_step_" + chat_id) != "done" then {
      if trim(text) == "/cancelform" then {
        kv_set("forge_form_step_" + chat_id, "done")
        let _ = SendTelegramReply(chat_id, "Форма проекта отменена.")
        return respond("200 ok")
      }
      let form_reply = ForgeShortFormStep(chat_id, text)
      if form_reply != "" then {
        if starts_with(form_reply, "done:") == false then { let _ = SendTelegramReply(chat_id, form_reply) }
        return respond("200 ok")
      }
    }

    // /newproject — FO-035 C.1: короткая форма (4 поля, с телефона)
    if starts_with(text, "/newproject") then {
      kv_set("forge_form_step_" + chat_id, "name")
      let _ = SendTelegramReply(chat_id, "Новый проект FORGE — короткая форма (4 вопроса). /cancelform — отмена.\n1/4. Название проекта?")
      return respond("200 ok")
    }

    // ── SHOP-5 (#172): /товар /вотч — досье товара + вотчлист ──────
    // UX единым блоком: питон-плоскость (/shop/*) сама снимает срез,
    // отправляет постер PNG + caption-ссылки + inline-кнопки «Купить»
    // и текст-выжимку; mlog даёт ack и пересылает только отказы.
    // Схема: /товар <запрос> → досье; /вотч [цель|скидка N|наличие] → слежение.
    if text == "/товар" then {
      let _ = SendTelegramReply(chat_id, "Usage: /товар <конкретный запрос или ссылка> — сразу соберу досье с площадок (WB, Kufar). Затем /вотч <цель BYN | скидка N | наличие> — поставлю на слежение 4 раза/сутки. Хочешь, уточню параметры сама — просто напиши без команды: хочу купить …")
      return respond("200 ok")
    }
    if starts_with(text, "/товар ") then {
      let rest_p = trim(substring(text, 7.0, length(text)))
      let _ = RecordUserMessage(chat_id, "shop", text)
      let _ = SendTelegramReply(chat_id, "Собираю досье по «" + rest_p + "» — WB/Kufar, минута.")
      let resp_p = try http_post("http://127.0.0.1:4000/shop/product", json_encode({query: rest_p, chat_id: chat_id}), "application/json", 45.0)
      if to_string(resp_p) == "()" then {
        let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость недоступна (llm_proxy не отвечает).")
      } else {
        let parsed_p = try parse_json(resp_p)
        if to_string(parsed_p) == "()" then {
          let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость вернула нечитаемый ответ.")
        } else {
          if to_string(json_get(parsed_p, "ok", "")) != "True" and to_string(json_get(parsed_p, "ok", "")) != "true" then {
            let _ = SendTelegramReply(chat_id, "ОТКАЗ: досье не собрано: " + to_string(json_get(parsed_p, "error", "нет деталей")))
          }
        }
      }
      return respond("200 ok")
    }
    if starts_with(text, "/вотч") then {
      let rest_w = ""
      if length(text) > 6.0 then { let rest_w = trim(substring(text, 6.0, length(text))) }
      let _ = RecordUserMessage(chat_id, "shop", text)
      let resp_w = try http_post("http://127.0.0.1:4000/shop/watch", json_encode({args: rest_w, chat_id: chat_id}), "application/json", 20.0)
      if to_string(resp_w) == "()" then {
        let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость недоступна (llm_proxy не отвечает).")
      } else {
        let parsed_w = try parse_json(resp_w)
        if to_string(parsed_w) == "()" then {
          let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость вернула нечитаемый ответ.")
        } else {
          let reply_w = to_string(json_get(parsed_w, "reply", ""))
          if reply_w != "" then {
            let _ = SendTelegramReply(chat_id, reply_w)
          } else {
            if to_string(json_get(parsed_w, "ok", "")) == "True" or to_string(json_get(parsed_w, "ok", "")) == "true" then {
              let _ = SendTelegramReply(chat_id, "Вотч поставлен. Проверка 4 раза/сутки, события — в личку.")
            } else {
              let _ = SendTelegramReply(chat_id, "ОТКАЗ: " + to_string(json_get(parsed_w, "error", "нет деталей")))
            }
          }
        }
      }
      return respond("200 ok")
    }

    // /forge-export — FO-042 B.2 (наряд #149): выгрузка состояния FORGE
    // (проекты, открытые задачи, гейты без решения, открытые замечания)
    // JSON-файлом документом. Та же выкладка, что идёт с утренним брифом.
    if starts_with(text, "/forge-export") then {
      let _ = RecordUserMessage(chat_id, "dev", text)
      let resp_x = try http_post("http://127.0.0.1:4000/forge/export-state?secret=" + env("CRON_SECRET"), json_encode({chat_id: chat_id}), "application/json")
      if to_string(resp_x) == "()" then {
        let _ = SendTelegramReply(chat_id, "ОТКАЗ: export-плоскость недоступна (llm_proxy не отвечает).")
      } else {
        let parsed_x = try parse_json(resp_x)
        if to_string(parsed_x) == "()" then {
          let _ = SendTelegramReply(chat_id, "ОТКАЗ: export-плоскость вернула нечитаемый ответ.")
        } else {
          if to_string(json_get(parsed_x, "ok", "")) == "True" or to_string(json_get(parsed_x, "ok", "")) == "true" then {
            let c = json_get(parsed_x, "counts", "")
            let _ = SendTelegramReply(chat_id, "Выгрузка FORGE отправлена документом: проектов " + to_string(json_get(c, "projects", "?")) + ", открытых задач " + to_string(json_get(c, "tasks_open", "?")) + ", гейтов без решения " + to_string(json_get(c, "gates_pending", "?")) + ", открытых замечаний " + to_string(json_get(c, "remarks_open", "?")) + ".")
          } else {
            let _ = SendTelegramReply(chat_id, "ОТКАЗ: выгрузка не сработала: " + to_string(json_get(parsed_x, "error", "нет деталей")))
          }
        }
      }
      return respond("200 ok")
    }

    // /chain continue — FO-027: возобновление цепочки с последней ok-степы
    if starts_with(text, "/chain continue ") then {
      let rest_c = substring(text, 16.0, length(text))
      let parts_c = split(rest_c, _sp)
      if length(parts_c) > 1.0 then {
        let chain_id_c = trim(to_string(get(parts_c, 0.0)))
        let query_c = substring(rest_c, length(chain_id_c) + 1.0, length(rest_c))
        let _ = RecordUserMessage(chat_id, "chain", text)
        let result_c = ResumeChainSteps(chain_id_c, "", query_c, chat_id)
        let _ = SendTelegramReply(chat_id, result_c)
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /chain continue <chain_id> <query>")
      }
      return respond("200 ok")
    }

    // /chain
    if starts_with(text, "/chain") then {
      let rest = substring(text, 7.0, length(text))
      // FO-026: mode prefix — parallel | debate. Без mode — прежний sequential 1-в-1.
      let mut mode = ""
      let mut rest2 = rest
      let trimmed_rest = trim(rest)
      if starts_with(trimmed_rest, "parallel ") then {
        let mode = "parallel"
        let rest2 = substring(trimmed_rest, 9.0, length(trimmed_rest))
      }
      if starts_with(trimmed_rest, "debate ") then {
        let mode = "debate"
        let rest2 = substring(trimmed_rest, 7.0, length(trimmed_rest))
      }
      if mode == "" then {
        if starts_with(trimmed_rest, "parallel") and length(trimmed_rest) == 8.0 then { let mode = "parallel" }
        if starts_with(trimmed_rest, "debate") and length(trimmed_rest) == 6.0 then { let mode = "debate" }
      }
      if mode != "" then {
        // Fan-out/debate: департаменты через запятую + query
        let parts2 = split(rest2, _sp)
        if length(parts2) > 1.0 then {
          let dept_list = trim(to_string(get(parts2, 0.0)))
          let query_fo = substring(rest2, length(dept_list) + 1.0, length(rest2))
          // CSV → JSON array строк (вручную: json_encode завёрнул бы как строку)
          let arr = "["
          let mut i = 0.0
          each dslug in split(dept_list, ",") {
            let dd = trim(to_string(dslug))
            if dd != "" then {
              if i > 0.0 then { let arr = arr + "," }
              let arr = arr + "\"" + dd + "\""
              let i = i + 1.0
            }
          }
          let arr = arr + "]"
          let _ = RecordUserMessage(chat_id, "chain", text)
          let _ = AuditLog("chain_start", "system", "chain " + mode + ": " + dept_list)
          let body_fo = "{\"mode\":\"" + mode + "\",\"chat_id\":\"" + chat_id + "\",\"depts\":" + arr + ",\"query\":\"" + JsonEscapeText(query_fo) + "\"}"
          // Таймаут группы: debate ≤ 2 раунда × шаг + судья
          let resp_fo = try http_post("http://127.0.0.1:4000/chain/fanout", body_fo, "application/json", 540.0)
          if to_string(resp_fo) == "()" then {
            let _ = SendTelegramReply(chat_id, "Chain " + mode + ": плоскость fan-out недоступна (proxy не отвечает). Fallback: /chain " + dept_list + " <query> — последовательно.")
          } else {
            let parsed_fo = try parse_json(resp_fo)
            if to_string(parsed_fo) == "()" then {
              let _ = SendTelegramReply(chat_id, "Chain " + mode + ": ошибка разбора ответа fan-out.")
            } else {
              let status_fo = to_string(json_get(parsed_fo, "status", "error"))
              if status_fo == "ok" then {
                let gid = to_string(json_get(parsed_fo, "group_id", ""))
                let judge = to_string(json_get(parsed_fo, "judge", ""))
                let mut out = substring(judge, 0.0, 3500.0)
                if length(judge) > 3500.0 then { let out = out + "\n…(обрезано — полное в отчёте)" }
                let _ = SendTelegramReply(chat_id, out)
                let _ = SendReport(judge, "chain", "Chain " + mode + " " + gid, "2.0", chat_id)
              } else {
                let msg_fo = to_string(json_get(parsed_fo, "message", "fan-out отказал"))
                let _ = SendTelegramReply(chat_id, "Chain " + mode + " отклонён: " + msg_fo)
              }
            }
          }
        } else {
          let _ = SendTelegramReply(chat_id, "Usage: /chain " + mode + " dept1,dept2 <query>")
        }
        return respond("200 ok")
      }
      // ── Sequential (без изменений, обратная совместимость 1-в-1) ──
      if length(parts) > 1.0 then {
        let dept_chain = trim(get(parts, 0.0))
        let query = substring(rest, length(dept_chain) + 1.0, length(rest))
        let _ = RecordUserMessage(chat_id, "chain", text)
        let _ = AuditLog("chain_start", "system", "chain: " + dept_chain)
        let result = ExecuteChain(dept_chain, query, chat_id)
        let _ = SendTelegramReply(chat_id, result)
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /chain dept1+dept2 <query>\nExample: /chain osp+legal test query\nMax 3 departments per chain.\nFO-026: /chain parallel qa,legal <query> | /chain debate qa,legal <query>")
      }
      return respond("200 ok")
    }

    // /factory
    if starts_with(text, "/factory") then {
      let query = substring(text, 9.0, length(text))
      let active = kv_get("active_order")
      if active != "" then {
        let result = HandleFactoryStep(active, query, chat_id)
        let _ = SendTelegramReply(chat_id, result)
        return respond("200 ok")
      }

      if starts_with(text, "/factory_review") then {
        let id = substring(text, 16.0, length(text))
        let _ = SendTelegramReply(chat_id, "Factory review for " + trim(id) + ": pending")
        return respond("200 ok")
      }
      if starts_with(text, "/factory_deploy") then {
        let id = substring(text, 16.0, length(text))
        db_execute("UPDATE factory_orders SET status = 'deployed' WHERE id = ?1", [trim(id)])
        let _ = AuditLog("factory_deploy", "factory", "deployed: " + trim(id))
        let _ = SendTelegramReply(chat_id, "Factory order " + trim(id) + " deployed.")
        return respond("200 ok")
      }
      if starts_with(text, "/factory_deliver") then {
        let id = substring(text, 17.0, length(text))
        db_execute("UPDATE factory_orders SET status = 'delivered', completed_at = datetime('now') WHERE id = ?1", [trim(id)])
        let _ = SendTelegramReply(chat_id, "Factory order " + trim(id) + " delivered.")
        return respond("200 ok")
      }
      if text == "/factory_list" then {
        let rows = query("SELECT id, client_name, status, created_at FROM factory_orders ORDER BY id DESC LIMIT 10", [])
        let _ = SendTelegramReply(chat_id, "Factory orders: see " + env("RENDER_URL") + "/office-dashboard")
        return respond("200 ok")
      }

      let order_id = "fo-" + to_string(now())
      kv_set("active_order", order_id)
      kv_set("order_step_" + order_id, "1")
      db_execute("INSERT INTO factory_orders (id, status) VALUES (?1, 'intake')", [order_id])
      let _ = AuditLog("factory_start", "factory", "new order: " + order_id)
      let _ = SendTelegramReply(chat_id, "Factory: Creating new office.\n\nStep 1/7: What is the client's name or company?")
      return respond("200 ok")
    }

    // /admin
    if starts_with(text, "/admin") then {
      let query = substring(text, 7.0, length(text))
      let _ = AuditLog("admin_cmd", "admin", text)

      if query == "" or query == " " then {
        let _ = SendTelegramReply(chat_id, "Admin commands:\n/status /build <task> /fix <bug>\n/analyze /scan /tour /docs\n/graph /impact <file>\n/proposals /narads /rollback <id>\n/report /health")
        return respond("200 ok")
      }
      if query == "status" then {
        let _ = SendTelegramReply(chat_id, AdminStatus())
        return respond("200 ok")
      }
      if starts_with(query, "build ") then {
        let task = substring(query, 6.0, length(query))
        let narad_id = AdminBuild(task, chat_id)
        return respond("200 ok")
      }
      if starts_with(query, "fix ") then {
        let bug = substring(query, 4.0, length(query))
        let reply = HandleDeptQuery("admin", "Fix bug: " + bug, chat_id)
        let _ = SendTelegramReply(chat_id, reply)
        return respond("200 ok")
      }
      if query == "analyze" then {
        let _ = SendTelegramReply(chat_id, AdminAnalyze())
        return respond("200 ok")
      }
      if query == "scan" then {
        let _ = SendTelegramReply(chat_id, AdminScan())
        return respond("200 ok")
      }
      if query == "tour" then {
        let _ = SendTelegramReply(chat_id, AdminTour())
        return respond("200 ok")
      }
      if query == "docs" then {
        let _ = SendTelegramReply(chat_id, AdminDocs())
        return respond("200 ok")
      }
      if query == "graph" then {
        let _ = SendTelegramReply(chat_id, AdminGraph())
        return respond("200 ok")
      }
      if starts_with(query, "impact ") then {
        let file = substring(query, 7.0, length(query))
        let _ = SendTelegramReply(chat_id, AdminImpact(file))
        return respond("200 ok")
      }
      if query == "proposals" then {
        let _ = SendTelegramReply(chat_id, AdminProposals())
        return respond("200 ok")
      }
      if query == "narads" then {
        let _ = SendTelegramReply(chat_id, AdminNarads())
        return respond("200 ok")
      }
      if starts_with(query, "rollback ") then {
        let narad_id = substring(query, 9.0, length(query))
        let _ = SendTelegramReply(chat_id, AdminRollback(narad_id))
        return respond("200 ok")
      }
      if query == "report" then {
        let _ = SendTelegramReply(chat_id, AdminReport())
        return respond("200 ok")
      }
      if query == "health" then {
        let _ = SendTelegramReply(chat_id, AdminHealth())
        return respond("200 ok")
      }
      let reply = HandleDeptQuery("admin", query, chat_id)
      let _ = SendTelegramReply(chat_id, reply)
      return respond("200 ok")
    }

    // /lz special commands (MEGA-4: Apodex deep research, compare, channels)
    if starts_with(text, "/lz") then {
      let query = substring(text, 4.0, length(text))
      let _ = RecordUserMessage(chat_id, "lz", text)

      // /lz deep <query> — Apodex verified research (2-5 min)
      if starts_with(query, " deep ") then {
        let deep_query = substring(query, 6.0, length(query))
        let reply = LZDeepResearcherProfile(deep_query, chat_id)
        let _ = SendReport(reply, "lz", "Deep research: " + deep_query, "4.0", chat_id)
        return respond("200 ok")
      }
      // /lz scan <query> — 9-source deep scan (30 sec)
      if starts_with(query, " scan ") then {
        let scan_query = substring(query, 6.0, length(query))
        let reply = LZDeepScan(scan_query, chat_id)
        let _ = SendReport(reply, "lz", "Scan: " + scan_query, "3.0", chat_id)
        return respond("200 ok")
      }
      // /lz all <query> — scan + deep (full pipeline)
      if starts_with(query, " all ") then {
        let all_query = substring(query, 5.0, length(query))
        let reply = LZAllScan(all_query, chat_id)
        let _ = SendReport(reply, "lz", "Full scan: " + all_query, "4.0", chat_id)
        return respond("200 ok")
      }
      // /lz compare <query> — LLM vs Apodex side-by-side
      if starts_with(query, " compare ") then {
        let compare_query = substring(query, 9.0, length(query))
        let reply = LZCompare(compare_query, chat_id)
        let _ = SendReport(reply, "lz", "Compare: " + compare_query, "3.0", chat_id)
        return respond("200 ok")
      }
      // /lz news [query] — news monitoring
      if starts_with(query, " news") then {
        let news_query = substring(query, 6.0, length(query))
        let _ = SendTelegramReply(chat_id, "Анализирую свежие события...")
        let body = json_encode({query: news_query, limit: 15, chat_id: chat_id})
        let result = try http_post("http://127.0.0.1:4000/lz/news", body, "application/json")
        if to_string(result) == "()" then {
          let _ = SendTelegramReply(chat_id, "Сервис новостей временно недоступен.")
          return respond("200 ok")
        } else {
          let parsed = parse_json(result)
          let analysis = json_get(parsed, "response", "Нет свежих событий")
          let mut news_title = "Мониторинг информпространства"
          if news_query != "" then { news_title = "События: " + news_query }
          let _ = SendReport(analysis, "lz", news_title, "2.0", chat_id)
        }
        return respond("200 ok")
      }

      // Default /lz handler — auto-detect scan intent
      let t = lower(query)
      let is_scan = contains(t, "скан") or contains(t, "развед") or contains(t, "новости") or contains(t, "событи") or contains(t, "что происход") or contains(t, "свеж") or contains(t, "монитор") or contains(t, "обзор") or contains(t, "дайджест") or contains(t, "что нового") or contains(t, "scan") or contains(t, "intelligence") or contains(t, "briefing")
      if is_scan then {
        let reply = try LZDeepScan(query, chat_id)
        if to_string(reply) == "()" or reply == "" then {
          let reply = HandleDeptQuery("lz", query, chat_id)
          let _ = SendReport(reply, "lz", query, "2.0", chat_id)
        } else {
          let _ = SendReport(reply, "lz", "Scan: " + query, "3.0", chat_id)
        }
      } else {
        let reply = HandleDeptQuery("lz", query, chat_id)
        let _ = SendReport(reply, "lz", query, "2.0", chat_id)
      }
      return respond("200 ok")
    }

    // /lz_channel — add Telegram channel to LZ monitoring (MEGA-4)
    if starts_with(text, "/lz_channel add ") then {
      let channel_params = substring(text, 15.0, length(text))
      let params = split(channel_params, _sp)
      let ch_id = trim(get(params, 0.0))
      let category = "general"
      if length(params) > 1.0 then { let category = trim(get(params, 1.0)) }
      let result = LZChannelAdd(ch_id, category)
      let _ = SendTelegramReply(chat_id, result)
      return respond("200 ok")
    }
    // /lz_channels — list monitored channels
    if text == "/lz_channels" then {
      let result = LZChannels()
      let _ = SendTelegramReply(chat_id, result)
      return respond("200 ok")
    }
    // /lz_monitor <topic> — add topic to daily monitoring
    if starts_with(text, "/lz_monitor ") then {
      let topic = substring(text, 12.0, length(text))
      let result = LZMonitor(topic)
      let _ = SendTelegramReply(chat_id, result)
      return respond("200 ok")
    }

    // /lz osint <username> — OSINT 840+ platforms (30-120 sec)
    if starts_with(text, "/lz osint ") then {
      let username = trim(substring(text, 10.0, length(text)))
      let _ = RecordUserMessage(chat_id, "lz", text)
      send_message(chat_id, "Сканирую " + username + " по 840+ платформам... (30-120 сек)")

      let body = json_encode({
        username: username,
        level: "basic",
        tor: false,
        chat_id: chat_id,
        caller_id: chat_id
      })
      let result = try http_post("http://127.0.0.1:4000/lz/osint", body, "application/json", 240.0)
      if to_string(result) == "()" then {
        let _ = SendReport("OSINT-сканирование недоступно (прокси не отвечает).", "lz", "OSINT: " + username, "3.0", chat_id)
        return respond("200 ok")
      } else {
        let parsed = parse_json(result)
        let analysis = json_get(parsed, "response", "Ошибка OSINT-сканирования")
        let found_count = json_get(parsed, "osint_data.found", "0")

        let title = "OSINT: " + username + " (" + to_string(found_count) + " платформ)"
        let _ = SendReport(analysis, "lz", title, "3.0", chat_id)
        let _ = AuditLog("lz_osint", "system", "lz", username, "ok")
      }
      return respond("200 ok")
    }

    // /lz osint advanced <username> — extended scan with name variations
    if starts_with(text, "/lz osint advanced ") then {
      let username = trim(substring(text, 19.0, length(text)))
      let _ = RecordUserMessage(chat_id, "lz", text)
      send_message(chat_id, "Расширенное сканирование " + username + " (вариации имени)... (60-180 сек)")

      let body = json_encode({
        username: username,
        level: "advanced",
        tor: false,
        chat_id: chat_id,
        caller_id: chat_id
      })
      let result = try http_post("http://127.0.0.1:4000/lz/osint", body, "application/json", 240.0)
      if to_string(result) == "()" then {
        let _ = SendReport("OSINT-сканирование недоступно (прокси не отвечает).", "lz", "OSINT Advanced: " + username, "4.0", chat_id)
        return respond("200 ok")
      } else {
        let parsed = parse_json(result)
        let analysis = json_get(parsed, "response", "Ошибка OSINT-сканирования")
        let _ = SendReport(analysis, "lz", "OSINT Advanced: " + username, "4.0", chat_id)
      }
      return respond("200 ok")
    }

    // /lz profile <name> — comprehensive profile (OSINT + Web + Social)
    if starts_with(text, "/lz profile ") then {
      let name = trim(substring(text, 12.0, length(text)))
      let _ = RecordUserMessage(chat_id, "lz", text)
      send_message(chat_id, "Строю комплексный профиль " + name + "... OSINT + Web + Social")

      // 1. OSINT scan
      let osint_body = json_encode({ username: name, level: "basic", chat_id: chat_id, caller_id: chat_id })
      let mut osint_result = try http_post("http://127.0.0.1:4000/lz/osint", osint_body, "application/json", 240.0)
      if to_string(osint_result) == "()" then { osint_result = "(OSINT-данные недоступны)" }

      // 2. Web search
      let web_result = web_search(name, 5.0)

      // 3. LLM builds profile
      let lz_profile = read_file("library/lz.md")
      let profile_prompt = lz_profile + "\n\nПостроить комплексный цифровой профиль на основе:\n1. OSINT (840+ платформ)\n2. Веб-поиск\n\nСтруктура:\n- Кто этот человек/бренд\n- Цифровой след (категории платформ)\n- Публичная активность\n- Профессиональный профиль\n- Аномалии и красные флаги\n- Оценка цифровой гигиены (1-10)"

      let combined = "OSINT:\n" + osint_result + "\n\nWeb:\n" + web_result
      let analysis = call_llm(profile_prompt, combined)

      let _ = SendReport(analysis, "lz", "Профиль: " + name, "4.0", chat_id)
      return respond("200 ok")
    }

    // /osp special commands
    if starts_with(text, "/osp") then {
      let query = substring(text, 5.0, length(text))
      // /osp profile <actor> — OSINT-based actor profiling
      if starts_with(query, "profile ") then {
        let actor = trim(substring(query, 8.0, length(query)))
        let _ = RecordUserMessage(chat_id, "osp", text)
        send_message(chat_id, "ОСП: профилирование актора " + actor + "...")

        // OSINT data from LZ proxy
        let osint_body = json_encode({ username: actor, level: "basic", chat_id: chat_id, caller_id: chat_id })
        let mut osint = try http_post("http://127.0.0.1:4000/lz/osint", osint_body, "application/json", 240.0)
        if to_string(osint) == "()" then { osint = "(OSINT-данные недоступны)" }

        // OSP analysis via LLM
        let osp_profile = read_file("library/osp.md")
        let profile_prompt = osp_profile + "\n\nПрофилирование актора по методологии ОСП:\n1. Цифровой след -> паттерн поведения\n2. Платформы присутствия -> social graph inference\n3. Отсутствие на платформах -> что скрывает?\n4. Временные паттерны -> когда активен\n5. Cross-reference -> противоречия между профилями\n6. Гипотезы мотивации (ACH)\n7. Используй [ФАКТ], [ИНТЕРПРЕТАЦИЯ], [СПЕКУЛЯЦИЯ]"

        let analysis = try call_llm(profile_prompt, "Актор: " + actor + "\n\nOSINT данные:\n" + osint)
        if to_string(analysis) == "()" then {
          let _ = SendTelegramReply(chat_id, "ОСП: не удалось получить анализ профиля (LLM недоступна).")
        } else {
          let _ = SendReport(analysis, "osp", "Профиль актора: " + actor, "3.0", chat_id)
        }
        return respond("200 ok")
      }
      let _ = RecordUserMessage(chat_id, "osp", text)
      let reply = try HandleDeptQuery("osp", query, chat_id)
      if to_string(reply) == "()" or reply == "" then {
        let _ = SendTelegramReply(chat_id, "ОСП: не удалось получить ответ. Попробуйте позже.")
      } else {
        let _ = SendReport(reply, "osp", "OSP: " + substring(query, 0.0, 50.0), "3.0", chat_id)
      }
      return respond("200 ok")
    }

    // /legal check <entity> — due diligence via OSINT
    if starts_with(text, "/legal check ") then {
      let entity = trim(substring(text, 13.0, length(text)))
      send_message(chat_id, "Юрист: due diligence — проверка " + entity + "...")

      let osint_body = json_encode({ username: entity, level: "advanced", chat_id: chat_id, caller_id: chat_id })
      let mut osint = try http_post("http://127.0.0.1:4000/lz/osint", osint_body, "application/json", 240.0)
      if to_string(osint) == "()" then { osint = "(OSINT-данные недоступны)" }

      let legal_profile = read_file("library/legal.md")
      let check_prompt = legal_profile + "\n\nDue Diligence проверка контрагента:\n1. Цифровой след — насколько прозрачен?\n2. Профессиональные платформы (LinkedIn, Crunchbase) — совпадают с заявлениями?\n3. Красные флаги — даркнет-форумы, фрод-платформы, NSFW\n4. Возраст аккаунтов — давно ли существуют?\n5. Согласованность информации между платформами\n6. Рекомендация: безопасно / требует внимания / высокий риск\n7. ДИСКЛЕЙМЕР обязателен: \"OSINT-данные собраны из открытых источников. Результаты не гарантируют принадлежность аккаунтов конкретному лицу.\""

      let analysis = call_llm(check_prompt, "Контрагент: " + entity + "\n\nOSINT:\n" + osint)
      let _ = SendReport(analysis, "legal", "Due Diligence: " + entity, "3.0", chat_id)
      return respond("200 ok")
    }

    // /marketing brand-check <brand> — brand availability across 840+ platforms
    if starts_with(text, "/marketing brand-check ") then {
      let brand = trim(substring(text, 22.0, length(text)))
      send_message(chat_id, "Маркетинг: проверка бренда " + brand + " на 840+ платформах...")

      let osint_body = json_encode({
        username: brand,
        level: "advanced",
        chat_id: chat_id,
        caller_id: chat_id
      })
      let mut osint = try http_post("http://127.0.0.1:4000/lz/osint", osint_body, "application/json", 240.0)
      if to_string(osint) == "()" then { osint = "(OSINT-данные недоступны)" }

      let marketing_profile = read_file("library/marketing.md")
      let brand_prompt = marketing_profile + "\n\nАнализ доступности бренда:\n1. На каких платформах имя уже занято?\n2. Кем занято — конкурент или просто тёзка?\n3. На каких ключевых платформах свободно?\n4. Рекомендация: использовать as-is / модифицировать / выбрать другое\n5. Если занято — варианты модификации (добавить _official, HQ, app...)\n6. Приоритетные платформы для регистрации (первые 48 часов после запуска)"

      let analysis = call_llm(brand_prompt, "Бренд: " + brand + "\n\nOSINT:\n" + osint)
      let _ = SendReport(analysis, "marketing", "Brand Check: " + brand, "2.0", chat_id)
      return respond("200 ok")
    }

    // ============================================================

    // ── FOIP-003.10: /marketing-context set|show ──
    if starts_with(text, "/marketing-context set ") then {
      let ctx_text = trim(substring(text, 23.0, length(text)))
      if ctx_text == "" then { send_message(chat_id, "Формат: /marketing-context set <текст продукта>")
return respond("200 ok") }
      let _ = kv_set("product_context:" + chat_id, ctx_text)
      send_message(chat_id, "Контекст продукта сохранён (" + to_string(length(ctx_text)) + " символов).")
      return respond("200 ok")
    }
    if text == "/marketing-context show" then {
      let mut pc = kv_get("product_context:" + chat_id)
      if pc == "" then { pc = kv_get("product_context:default") }
      if to_string(pc) == "()" or pc == "" then {
        send_message(chat_id, "Контекст продукта не задан. Используйте /marketing-context set <текст>")
      } else {
        send_message(chat_id, "Текущий контекст продукта:\n" + pc)
      }
      return respond("200 ok")
    }
    if starts_with(text, "/marketing-context default ") then {
      let def_text = trim(substring(text, 28.0, length(text)))
      if def_text == "" then { send_message(chat_id, "Формат: /marketing-context default <текст по умолчанию>")
return respond("200 ok") }
      let _ = kv_set("product_context:default", def_text)
      send_message(chat_id, "Контекст продукта по умолчанию сохранён.")
      return respond("200 ok")
    }

    // ── FOIP-003.11: /marketing-ideas <запрос> ──
    if starts_with(text, "/marketing-ideas ") then {
      let ideas_query = trim(substring(text, 17.0, length(text)))
      if ideas_query == "" then { send_message(chat_id, "Формат: /marketing-ideas <запрос, например: как привлечь первых пользователей>")
return respond("200 ok") }
      send_message(chat_id, "Подбираю релевантные маркетинговые идеи...")
      let ideas_result = GetRelevantIdeas(ideas_query, "5", chat_id)
      send_message(chat_id, ideas_result)
      return respond("200 ok")
    }

    // ── FOIP-003.12: /cro <текст страницы> ──
    if starts_with(text, "/cro ") then {
      let cro_text = trim(substring(text, 5.0, length(text)))
      if cro_text == "" then { send_message(chat_id, "Формат: /cro <текст страницы или описания для CRO-аудита>")
return respond("200 ok") }
      send_message(chat_id, "CRO-аудит: анализирую конверсионный потенциал...")
      let cro_result = CROAudit(cro_text, chat_id)
      send_message(chat_id, cro_result)
      return respond("200 ok")
    }

    // DEPARTMENT ROUTING (13 depts)
    // ============================================================

    let dept = DetectDepartment(text)
   let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','webhook',?,'ok')", ["step_0_after_detect_dept=" + dept])
    // FOIP-003.15: Classify query tier for model routing
    let tier = ClassifyQueryTier(text, dept)
    let _ = kv_set("query_tier", tier)
    let query = text
    let handled = 0.0

    if starts_with(text, "/") then {
      let parts = split(text, _sp)
      let cmd = get(parts, 0.0)
      if length(parts) > 1.0 then {
        let rest = substring(text, length(cmd) + 1.0, length(text))
        let query = rest
      } else {
        let query = ""
      }
    }

    let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','webhook','step_0b_before_yana_block','ok')")
    if dept == "yana" then {
      let _ = RecordUserMessage(chat_id, "yana", text)
      let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','webhook','step_0c_before_HandleYana','ok')")
      // Source fix: routing sets query="" when /command has no args (e.g. bare "/yana").
      // Fall back to full text so recall and LLM get a usable query.
      let mut yana_query = query
      if yana_query == "" then { yana_query = text }
      let reply = HandleYana(yana_query, chat_id)

      // Check if Yana delegated to another department
      // HandleYana returns dept name (e.g. "osp") if delegation detected
      let osp_list = ["osp", "lz", "expert", "marketing", "finance", "legal", "dev", "design", "qa", "visual", "engineering", "kavalnya"]
      let mut is_dept = 0.0
      each d in osp_list {
        if reply == d then { is_dept = 1.0 }
      }

      if is_dept == 1.0 then {
        // Delegate: re-route to the target department
        let delegate_dept = reply
        let delegate_body = json_encode({chat_id: chat_id, text: "/" + delegate_dept + " " + query})
        // Re-enter routing — the target dept handler will process
        if delegate_dept == "osp" then {
          let del_reply = HandleDeptQuery("osp", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "lz" then {
          let del_reply = HandleDeptQuery("lz", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "expert" then {
          let del_reply = HandleDeptQuery("expert", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "marketing" then {
          let del_reply = HandleDeptQuery("marketing", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "finance" then {
          let del_reply = HandleDeptQuery("finance", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "legal" then {
          let del_reply = HandleDeptQuery("legal", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "dev" then {
          let del_reply = HandleDeptQuery("dev", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "design" then {
          let is_img = IsImageRequest(query)
          if is_img == "true" then {
            let err = HandleDesignImage(query, chat_id)
            if length(err) > 0.0 then {
              let _ = SendVoiceReply(chat_id, err, delegate_dept)
            }
          } else {
            let del_reply = HandleDeptQuery("design", query, chat_id)
            let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
            let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
          }
        }
        if delegate_dept == "qa" then {
          let del_reply = HandleDeptQuery("qa", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "visual" then {
          let is_img = IsImageRequest(query)
          if is_img == "true" then {
            let err = HandleDesignImage(query, chat_id)
            if length(err) > 0.0 then {
              let _ = SendVoiceReply(chat_id, err, delegate_dept)
            }
          } else {
            let del_reply = HandleDeptQuery("visual", query, chat_id)
            let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
            let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
          }
        }
        if delegate_dept == "engineering" then {
          let del_reply = HandleDeptQuery("engineering", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "kavalnya" then {
          let del_reply = HandleDeptQuery("kavalnya", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        let _ = SendTelegramReply(chat_id, "Яна направила запрос в отдел " + DeptDisplayName(delegate_dept))
        let handled = 1.0
      } else {
        // Normal Yana reply — voice + text, no restrictions
        let voice_on = kv_get("voice_enabled")
        if voice_on == "true" then {
          let voice_name = kv_get("tts_voice")
          if length(voice_name) < 3.0 then { let voice_name = "ru-RU-SvetlanaNeural" }
          let tts_body = json_encode({text: reply, voice: voice_name, chat_id: chat_id})
          let _ = try http_post("http://127.0.0.1:4000/tts", tts_body, "application/json")
        }
        // Text: send via proxy (handles 4096 limit with splitting)
        let text_body = json_encode({chat_id: chat_id, text: "Яна\n\n" + reply})
        let _ = try http_post("http://127.0.0.1:4000/tg-send", text_body, "application/json")
        let handled = 1.0
      }
    }
    if dept == "osp" then {
      let _ = RecordUserMessage(chat_id, "osp", text)
      let reply = HandleOSP(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "osp")
      let _ = SendReport(reply, "osp", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "lz" then {
      let _ = RecordUserMessage(chat_id, "lz", text)
      let reply = HandleLZ(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "lz")
      let _ = SendReport(reply, "lz", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "expert" then {
      let _ = RecordUserMessage(chat_id, "expert", text)
      let reply = HandleExpert(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "expert")
      let _ = SendReport(reply, "expert", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "marketing" then {
      let _ = RecordUserMessage(chat_id, "marketing", text)
      let reply = HandleMarketing(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "marketing")
      let _ = SendReport(reply, "marketing", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "finance" then {
      let _ = RecordUserMessage(chat_id, "finance", text)
      let reply = HandleFinance(query, chat_id)
      let telegram_text = reply
      if contains(reply, "[[CHART]]") then {
        let chart_start = index_of(reply, "[[CHART]]")
        let telegram_text = substring(reply, 0.0, chart_start) + "\n\n📊 График приложен в полном отчёте."
      }
      let _ = SendVoiceReply(chat_id, telegram_text, "finance")
      let _ = SendReport(reply, "finance", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "legal" then {
      let _ = RecordUserMessage(chat_id, "legal", text)
      let reply = HandleLegal(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "legal")
      let _ = SendReport(reply, "legal", query, "2.0", chat_id)
      let handled = 1.0
    }
    if starts_with(text, "/dev-forge") then {
      let query_f = substring(text, 11.0, length(text))
      let reply_f = ForgeFromDevRequest(query_f, chat_id)
      let _ = SendReport(reply_f, "dev", query_f, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "dev" then {
      let _ = RecordUserMessage(chat_id, "dev", text)
      // FO-041 A.2: FORGE-контур включается сам на запросы сборки
      // (по совпадению с активным проектом); иначе — обычный dev-путь
      let forge_hint = ""
      let forge_rows_f = try query("SELECT COUNT(*) as c FROM forge_projects WHERE status = 'active'", [])
      if to_string(forge_rows_f) != "()" then {
        let n_active = to_float(json_get(get(forge_rows_f, 0), "c", "0"))
        if n_active > 0.0 and contains(lower(text), "сделай") then {
          let forge_hint = ForgeFromDevRequest(query, chat_id)
        }
      }
      let reply = HandleDev(query, chat_id)
      if forge_hint != "" then {
        let reply = reply + "\n\n── FORGE ──\n" + substring(forge_hint, 0.0, 1200.0)
      }
      let _ = SendVoiceReply(chat_id, reply, "dev")
      let _ = SendReport(reply, "dev", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "design-image" then {
      let _ = RecordUserMessage(chat_id, "design", text)
      // Extract prompt: everything after /design-image or the full text
      let img_prompt = substring(text, 14.0, 0.0)
      if length(trim(img_prompt)) < 3.0 then { let img_prompt = query }
      let err = HandleDesignImage(img_prompt, chat_id)
      if length(err) > 0.0 then {
        let _ = SendTelegramReply(chat_id, err)
      }
      let handled = 1.0
    }
    if dept == "design" then {
      let _ = RecordUserMessage(chat_id, "design", text)
      // Auto-detect image generation requests within design dept
      let is_img = IsImageRequest(query)
      if is_img == "true" then {
        let err = HandleDesignImage(query, chat_id)
        if length(err) > 0.0 then {
          let _ = SendTelegramReply(chat_id, err)
        }
      } else {
        let reply = HandleDesign(query, chat_id)
        let _ = SendVoiceReply(chat_id, reply, "design")
        let _ = SendReport(reply, "design", query, "2.0", chat_id)
      }
      let handled = 1.0
    }
    if dept == "qa" then {
      let _ = RecordUserMessage(chat_id, "qa", text)
      let reply = HandleQA(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "qa")
      let _ = SendReport(reply, "qa", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "visual-image" then {
      let _ = RecordUserMessage(chat_id, "visual", text)
      // Extract prompt: everything after /visual-image or the full text
      let img_prompt = substring(text, 14.0, 0.0)
      if length(trim(img_prompt)) < 3.0 then { let img_prompt = query }
      let err = HandleDesignImage(img_prompt, chat_id)
      if length(err) > 0.0 then {
        let _ = SendTelegramReply(chat_id, err)
      }
      let handled = 1.0
    }
    if dept == "visual" then {
      let _ = RecordUserMessage(chat_id, "visual", text)
      // Auto-detect image generation requests within visual dept
      let is_img = IsImageRequest(query)
      if is_img == "true" then {
        let err = HandleDesignImage(query, chat_id)
        if length(err) > 0.0 then {
          let _ = SendTelegramReply(chat_id, err)
        }
      } else {
        let reply = HandleVisual(query, chat_id)
        let _ = SendVoiceReply(chat_id, reply, "visual")
        let _ = SendReport(reply, "visual", query, "2.0", chat_id)
      }
      let handled = 1.0
    }
    if dept == "engineering" then {
      let _ = RecordUserMessage(chat_id, "engineering", text)
      let reply = HandleEngineering(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "engineering")
      let _ = SendReport(reply, "engineering", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "kavalnya" then {
      let _ = RecordUserMessage(chat_id, "kavalnya", text)
      let reply = HandleKavalnya(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "kavalnya")
      let _ = SendReport(reply, "kavalnya", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "admin" then {
      let _ = RecordUserMessage(chat_id, "admin", text)
      let reply = HandleAdmin(text, chat_id)
      let _ = SendTelegramReply(chat_id, reply)
      let handled = 1.0
    }

    // Default: route to Yana with voice + text, no restrictions
    if handled == 0.0 then {
      let _ = RecordUserMessage(chat_id, "yana", text)
      let reply = HandleYana(text, chat_id)
      let voice_on = kv_get("voice_enabled")
      if voice_on == "true" then {
        let voice_name = kv_get("tts_voice")
        if length(voice_name) < 3.0 then { let voice_name = "ru-RU-SvetlanaNeural" }
        let tts_body = json_encode({text: reply, voice: voice_name, chat_id: chat_id})
        let _ = try http_post("http://127.0.0.1:4000/tts", tts_body, "application/json")
      }
      let text_body = json_encode({chat_id: chat_id, text: reply})
      let _ = try http_post("http://127.0.0.1:4000/tg-send", text_body, "application/json")
    }

    return respond("200 ok")
  }

  // ============================================================
  // CRON ENDPOINTS (8) — all require CRON_SECRET
  // ============================================================

  // Morning Brief — 07:20 MSK (4:20 UTC) — Yana: дата, время, погода, офис, мировые события
  route "/cron/morning" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = MorningBrief()
    let _ = YanaSelfLearn()
    return respond("200 ok")
  }

  route "/cron/evening" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = EveningSummary()
    return respond("200 ok")
  }

  route "/cron/weekly" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = WeeklyDigest()
    return respond("200 ok")
  }

  route "/cron/monthly" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = MonthlyReview()
    return respond("200 ok")
  }

  route "/cron/control" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = ControlCheck()
    return respond("200 ok")
  }

  route "/cron/night" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()

    // Phase: FO-027 TTL chain_steps — очистка старше 14 дней; pending/failed
    // без прогресса >24 ч → expired + Telegram-алерт владельцу
    let _ = db_execute("DELETE FROM chain_steps WHERE created_at < datetime('now', '-14 days')")
    let expired_rows = query("SELECT chain_id, COUNT(*) AS c FROM chain_steps WHERE status IN ('pending','failed') AND updated_at < datetime('now', '-1 day') GROUP BY chain_id", [])
    let _ = db_execute("UPDATE chain_steps SET status='expired', updated_at=datetime('now') WHERE status IN ('pending','failed') AND updated_at < datetime('now', '-1 day')")
    each er in expired_rows {
      let exp_chain = to_string(json_get(er, "chain_id", "?"))
      let exp_count = to_string(json_get(er, "c", "?"))
      let _ = AuditLog("chain_expired", "system", exp_chain + " steps=" + exp_count)
      let _ = SendTelegramReply(env("OWNER_TELEGRAM_ID"), "FO-027: цепочка " + exp_chain + " истекла без прогресса >24 ч (" + exp_count + " степов) — resume: /chain continue " + exp_chain + " <query>")
    }

    // Phase 0: UA Night Cycle (Scanner → Analyzer → Grapher → Reviewer → Documenter)
    let _ = AuditLog("night_ua_cycle", "admin", "triggering UA night cycle")
    let ua_body = "{}"
    let mut ua_result = try http_post("http://127.0.0.1:4000/admin-ua/night-cycle", ua_body, "application/json")
    if to_string(ua_result) == "()" then { ua_result = "{}" }
    let ua_summary = json_get(parse_json(ua_result), "summary", "UA cycle failed")

    // Phase 1: LZ Daily Report (GitHub scan → Admin)
    let _ = AuditLog("night_lz_daily", "lz", "triggering lz-daily from night cycle")
    let lz_body = json_encode({owner_id: env("OWNER_TELEGRAM_ID")})
    let mut lz_result = try http_post("http://127.0.0.1:4000/scheduler/lz-daily", lz_body, "application/json", 240.0)
    if to_string(lz_result) == "()" then { lz_result = "{}" }
    let lz_summary = json_get(parse_json(lz_result), "report", "LZ daily failed")

    // Phase 2: Memory Maintenance
    let mem_body = "{}"
    let mut mem_result = try http_post("http://127.0.0.1:4000/memory/maintenance", mem_body, "application/json")
    if to_string(mem_result) == "()" then { mem_result = "{}" }
    let mem_summary = json_get(parse_json(mem_result), "result", "Memory maintenance failed")

    // Phase 3: Original AdminNightCycle
    let result = AdminNightCycle()
    // Phase 4: Устаревшие отделы (hermes-agent lifecycle, адаптировано под use-based сигнал)
    let stale_result = try AdminCheckStaleDepts()
    if to_string(stale_result) == "()" then { let stale_result = "проверка не выполнена" }
    let result = "Phase 0: UA Analysis\n" + ua_summary + "\n\n" + result + "\n\nPhase 1-2: LZ + Memory\n" + substring(lz_summary, 0, 800) + "\n\n" + substring(mem_summary, 0, 400) + "\n\nPhase 4: Устаревшие отделы\n" + stale_result
    kv_set("admin_night_summary", result)
    return respond("200 ok")
  }

  route "/cron/lz-daily" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = AuditLog("cron_lz_daily", "lz", "LZ daily scan triggered by cron")
    let body = json_encode({owner_id: env("OWNER_TELEGRAM_ID")})
    let result = try http_post("http://127.0.0.1:4000/scheduler/lz-daily", body, "application/json", 240.0)
  }

  // F-2: Reminder delivery cron — called every 5 minutes by external scheduler
  route "/cron/reminders" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let result = DeliverDueReminders()
    return respond("200 " + result)
  }

  // Diagnostic: read last checkpoint trail from trace_log (FO-007: чекпоинты больше не в audit_log)
  // After a Block C crash, curl this to see exactly which step failed
  // FO-039 B.3: sweep живых превью — гашение по 30 минутам тишины
  route "/cron/preview-sweep" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let result = ForgePreviewSweep()
    let _ = AuditLog("cron_preview_sweep", "scheduler", result)
    return respond("200 ok: " + result)
  }

  route "/cron/last-checkpoints" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let rows = query("SELECT id, timestamp, details FROM trace_log WHERE action = 'checkpoint' ORDER BY id DESC LIMIT 20", [])
    let out = ""
    each row in rows {
      let rid = to_string(json_get(row, "id", "?"))
      let rts = json_get(row, "timestamp", "?")
      let rdt = json_get(row, "details", "?")
      let out = out + "[" + rid + "] " + rts + " — " + rdt + "\n"
    }
    if out == "" then { return respond("200 No checkpoints found") }
    return respond("200 " + out)
  }

  // Admin morning reply — 7:25 MSK (4:25 UTC) — response to Yana's morning brief
  route "/cron/admin-reply" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = AuditLog("cron_admin_reply", "admin", "admin morning reply triggered by cron")
    let body = json_encode({owner_id: env("OWNER_TELEGRAM_ID")})
    let result = try http_post("http://127.0.0.1:4000/scheduler/admin-morning-reply", body, "application/json", 240.0)
    return respond("200 ok")
  }
}
