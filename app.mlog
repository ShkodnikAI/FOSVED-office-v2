      let _ = RecordUserMessage(chat_id, "yana", text)
      let reply = HandleYana(text, chat_id)
      let voice_on = kv_get("voice_enabled")
      if voice_on == "true" then {
        let voice_name = kv_get("tts_voice")
        if len(voice_name) < 3.0 then { let voice_name = "ru-RU-SvetlanaNeural" }
        let tts_body = json_encode({text: reply, voice: voice_name, chat_id: chat_id})
        let _ = try http_post("http://127.0.0.1:4000/tts", tts_body, "application/json")
      }
      let text_body = json_encode({chat_id: chat_id, text: reply})
      let _ = try http_post("http://127.0.0.1:4000/tg-send", text_body, "application/json")
    }

    return respond("200 ok")
  }

  // ============================================================
  // CRON ENDPOINTS (8) — all require CRON_SECRET
  // ============================================================

  // Morning Brief — 07:20 MSK (4:20 UTC) — Yana: дата, время, погода, офис, мировые события
  route "/cron/morning" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = MorningBrief()
    let _ = YanaSelfLearn()
    return respond("200 ok")
  }

  route "/cron/evening" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = EveningSummary()
    return respond("200 ok")
  }

  route "/cron/weekly" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = WeeklyDigest()
    return respond("200 ok")
  }

  route "/cron/monthly" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = MonthlyReview()
    return respond("200 ok")
  }

  route "/cron/control" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = ControlCheck()
    return respond("200 ok")
  }

  route "/cron/night" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()

    // Phase 0: UA Night Cycle (Scanner → Analyzer → Grapher → Reviewer → Documenter)
    let _ = AuditLog("night_ua_cycle", "admin", "triggering UA night cycle")
    let ua_body = "{}"
    let ua_result = try http_post("http://127.0.0.1:4000/admin-ua/night-cycle", ua_body, "application/json")
    if to_string(ua_result) == "()" then { let ua_result = "{}" }
    let ua_summary = json_get(parse_json(ua_result), "summary", "UA cycle failed")

    // Phase 1: LZ Daily Report (GitHub scan → Admin)
    let _ = AuditLog("night_lz_daily", "lz", "triggering lz-daily from night cycle")
    let lz_body = json_encode({owner_id: env("OWNER_TELEGRAM_ID")})
    let lz_result = try http_post("http://127.0.0.1:4000/scheduler/lz-daily", lz_body, "application/json", 240.0)
    if to_string(lz_result) == "()" then { let lz_result = "{}" }
    let lz_summary = json_get(parse_json(lz_result), "report", "LZ daily failed")

    // Phase 2: Memory Maintenance
    let mem_body = "{}"
    let mem_result = try http_post("http://127.0.0.1:4000/memory/maintenance", mem_body, "application/json")
    if to_string(mem_result) == "()" then { let mem_result = "{}" }
    let mem_summary = json_get(parse_json(mem_result), "result", "Memory maintenance failed")

    // Phase 3: Original AdminNightCycle
    let result = AdminNightCycle()
    let result = "Phase 0: UA Analysis\n" + ua_summary + "\n\n" + result + "\n\nPhase 1-2: LZ + Memory\n" + substring(lz_summary, 0, 800) + "\n\n" + substring(mem_summary, 0, 400)
    kv_set("admin_night_summary", result)
    return respond("200 ok")
  }

  route "/cron/lz-daily" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = AuditLog("cron_lz_daily", "lz", "LZ daily scan triggered by cron")
    let body = json_encode({owner_id: env("OWNER_TELEGRAM_ID")})
    let result = try http_post("http://127.0.0.1:4000/scheduler/lz-daily", body, "application/json", 240.0)
  }

  // F-2: Reminder delivery cron — called every 5 minutes by external scheduler
  route "/cron/reminders" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let result = DeliverDueReminders()
    return respond("200 " + result)
  }

  // Diagnostic: read last checkpoint trail from audit_log
  // After a Block C crash, curl this to see exactly which step failed
  route "/cron/last-checkpoints" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = InitDB()
    let rows = query("SELECT id, timestamp, details FROM audit_log WHERE action = 'checkpoint' ORDER BY id DESC LIMIT 20", [])
    let out = ""
    each row in rows {
      let rid = to_string(json_get(row, "id", "?"))
      let rts = json_get(row, "timestamp", "?")
      let rdt = json_get(row, "details", "?")
      let out = out + "[" + rid + "] " + rts + " — " + rdt + "\n"
    }
    if out == "" then { return respond("200 No checkpoints found") }
    return respond("200 " + out)
  }

  // Admin morning reply — 7:25 MSK (4:25 UTC) — response to Yana's morning brief
  route "/cron/admin-reply" method=GET {
    let secret = query_param("secret")
    let cron_secret = env("CRON_SECRET")
    if cron_secret == "" then { return respond("403 Forbidden") }
    if secret != cron_secret then { return respond("403 Forbidden") }
    let _ = AuditLog("cron_admin_reply", "admin", "admin morning reply triggered by cron")
    let body = json_encode({owner_id: env("OWNER_TELEGRAM_ID")})
    let result = try http_post("http://127.0.0.1:4000/scheduler/admin-morning-reply", body, "application/json", 240.0)
    return respond("200 ok")
  }
}
