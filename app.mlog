  db_execute("CREATE TABLE IF NOT EXISTS dev_rule_violations (id INTEGER PRIMARY KEY AUTOINCREMENT, rule_number INTEGER, task_id TEXT, description TEXT, created_at TEXT DEFAULT (datetime('now')))")
  // Design (4) — dept/design.mlog: design_artifacts, design_decisions,
  //   user_research_sessions, design_verification.
  db_execute("CREATE TABLE IF NOT EXISTS design_artifacts (id INTEGER PRIMARY KEY AUTOINCREMENT, a11y_score REAL, artifact_type TEXT, content TEXT, created_at TEXT DEFAULT (datetime('now')), design_tokens TEXT, has_mobile TEXT, has_responsive TEXT, interaction_states TEXT, iteration_count REAL, name TEXT, parent_artifact_id TEXT, status TEXT, updated_at TEXT DEFAULT (datetime('now')), user_tasks TEXT, a11y_issues TEXT, a11y_level TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS design_decisions (id INTEGER PRIMARY KEY AUTOINCREMENT, artifact_id TEXT, created_at TEXT DEFAULT (datetime('now')), decision_type TEXT, new_value TEXT, old_value TEXT, rationale TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS user_research_sessions (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), domain TEXT, findings TEXT, pain_points TEXT, research_type TEXT, segments TEXT, status TEXT, tasks TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS design_verification (id INTEGER PRIMARY KEY AUTOINCREMENT, artifact_id TEXT, design_hash TEXT, drift_score REAL, implemented_hash TEXT, verdict TEXT, verified_at TEXT)")
  // ── конец DDL-пачки №376 ──

  // ── Наряд #377: DDL Expert+ЛЗ — 3 таблицы (тот же паттерн; схема с живой БД,
  // нулевой дрейф). dept/expert.mlog: expert_briefings (:748 INSERT), 
  // expert_automotive_kb (:81 SELECT); dept/lz.mlog: lz_channels (:885 INSERT).
  db_execute("CREATE TABLE IF NOT EXISTS expert_briefings (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT, created_at TEXT DEFAULT (datetime('now')), depth_level TEXT, status TEXT, topic TEXT, content TEXT)")
  db_execute("CREATE TABLE IF NOT EXISTS expert_automotive_kb (id INTEGER PRIMARY KEY AUTOINCREMENT, brand TEXT, model TEXT, content TEXT, updated_at TEXT DEFAULT (datetime('now')))")
  db_execute("CREATE TABLE IF NOT EXISTS lz_channels (id INTEGER PRIMARY KEY AUTOINCREMENT, category TEXT, channel_id TEXT, status TEXT)")
  // ── конец DDL-пачки #377 ──


  return "ok"
}

