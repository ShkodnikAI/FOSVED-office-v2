  let _ = TryVal(try db_execute("ALTER TABLE yana_events ADD COLUMN fire_weekday TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE yana_events ADD COLUMN next_fire_at TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE yana_events ADD COLUMN reminded_at TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE yana_events ADD COLUMN rrule_kind TEXT"))
  // ── конец ALTER-хвоста naryad-363 ──

  // ── Наряд №376 (P2): DDL-пачка QA/Dev/Design — 16 таблиц. Схема снята с
  // живой БД (data/fosved.db, sqlite_master) 2026-09-25 — гарантия совпадения
  // с исторически созданными таблицами (нулевой дрейф). До этого пачки
  // писались/читались кодом (dept/qa.mlog, dept/dev.mlog, dept/design.mlog),
  // но не создавались нигде — свежий деплой с пустой БД падал на первом
  // INSERT. CREATE TABLE IF NOT EXISTS идемпотентен: живая БД не трогается.
  // QA (7) — dept/qa.mlog: test_runs, defect_records, incidents,
  //   ai_eval_runs, security_audits, qa_assessments, cross_dept_tasks.
  db_execute("CREATE TABLE IF NOT EXISTS test_runs (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), environment TEXT, project TEXT, started_at TEXT, status TEXT, test_type TEXT, triggered_by TEXT, updated_at TEXT DEFAULT (datetime('now')), completed_at TEXT, coverage_pct TEXT, failed TEXT, passed REAL, skipped TEXT, total_tests TEXT, verdict TEXT)")
