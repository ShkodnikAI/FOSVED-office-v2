// ── OSP archive helpers (interpreter-only, confirmed 2026-06-22) ──



// ── Factory ──

pattern HandleFactoryStep(order_id: String, input: String, chat_id: String) -> String {
  let step = kv_get("order_step_" + order_id)
  let step_num = to_float(step)

  if step_num == 1.0 then {
    kv_set("order_step_" + order_id, "2")
    kv_set("order_client_" + order_id, input)
    db_execute("UPDATE factory_orders SET client_name = ?1 WHERE id = ?2", [input, order_id])
    return "Step 2/7: What tasks should the office handle?"
  }
  if step_num == 2.0 then {
    kv_set("order_step_" + order_id, "3")
    kv_set("order_tasks_" + order_id, input)
    db_execute("UPDATE factory_orders SET requirements = ?1 WHERE id = ?2", [input, order_id])
    return "Step 3/7: Which departments? (yana, osp, lz, expert, marketing, finance, legal, dev, design, qa, visual, engineering, kavalnya)"
  }
  if step_num == 3.0 then {
    kv_set("order_step_" + order_id, "4")
    kv_set("order_depts_" + order_id, input)
    db_execute("UPDATE factory_orders SET departments = ?1 WHERE id = ?2", [input, order_id])
    return "Step 4/7: Branding? (name, language, style preferences)"
  }
  if step_num == 4.0 then {
    kv_set("order_step_" + order_id, "5")
    kv_set("order_branding_" + order_id, input)
    db_execute("UPDATE factory_orders SET branding = ?1 WHERE id = ?2", [input, order_id])
    return "Step 5/7: Which LLM providers/keys are available?"
  }
  if step_num == 5.0 then {
    kv_set("order_step_" + order_id, "6")
    kv_set("order_llm_" + order_id, input)
    db_execute("UPDATE factory_orders SET llm_config = ?1 WHERE id = ?2", [input, order_id])
    let summary = "Order summary:\n"
    let summary = summary + "Client: " + kv_get("order_client_" + order_id) + "\n"
    let summary = summary + "Tasks: " + kv_get("order_tasks_" + order_id) + "\n"
    let summary = summary + "Departments: " + kv_get("order_depts_" + order_id) + "\n"
    let summary = summary + "Branding: " + kv_get("order_branding_" + order_id) + "\n"
    let summary = summary + "LLM: " + input + "\n\nConfirm? Send 'yes' or 'no'."
    kv_set("order_summary_" + order_id, summary)
    return summary
  }
  if step_num == 6.0 then {
    if lower(input) == "yes" or lower(input) == "ok" then {
      kv_set("order_step_" + order_id, "7")
      db_execute("UPDATE factory_orders SET status = 'building' WHERE id = ?1", [order_id])
      let _ = AuditLog("factory_build", "factory", "building: " + order_id)
      kv_set("active_order", "")
      return "Order confirmed. Building office...\nStatus: building\nTrack: /factory_list"
    } else {
      kv_set("active_order", "")
      db_execute("UPDATE factory_orders SET status = 'cancelled' WHERE id = ?1", [order_id])
      return "Order cancelled."
    }
  }
  return "Factory flow completed."
}

// LZDeepScan, LZAllScan are defined in dept/lz.mlog (imported above) — they call real scanners (ScanWeb, ScanGitHub, etc.)
// Do NOT re-define them here or they will shadow the real implementations.

pattern RecordUserMessage(chat_id: String, dept: String, text: String) -> String {
  db_execute("INSERT INTO dialog_history (chat_id, role, dept, content) VALUES (?1, 'user', ?2, ?3)", [chat_id, dept, text])
  let _ = SaveDialogV2(chat_id, "user", dept, text)
  let _ = TryVal(try db_execute("INSERT INTO dept_activity (dept, last_used_at, use_count) VALUES (?1, datetime('now'), 1) ON CONFLICT(dept) DO UPDATE SET last_used_at = datetime('now'), use_count = use_count + 1", [dept]))
  return "ok"
}

pattern RecordAssistantMessage(chat_id: String, dept: String, text: String) -> String {
  db_execute("INSERT INTO dialog_history (chat_id, role, dept, content) VALUES (?1, 'assistant', ?2, ?3)", [chat_id, dept, text])
  let _ = SaveDialogV2(chat_id, "assistant", dept, text)
  return "ok"
}

// ── FO-017: Dialog v2 — Parts + event-log (python-side) ──
// Best-effort зеркалирование реплик в Dialog v2 (/dialog/message):
// dialog_history остаётся источником истины до ревизии FM3 (наряд #83);
// отказ/таймаут прокси молча игнорируется — диалог не блокируется.
pattern SaveDialogV2(session_id: String, role: String, dept: String, content: String) -> String {
  let body = json_encode({session_id: session_id, role: role, dept: dept, content: content, source: "app.mlog"})
  let result = TryVal(try http_post("http://127.0.0.1:4000/dialog/message", body, "application/json", 3.0))
  if to_string(result) == "()" then { return "" }
  return result
}

pattern SendTelegramReply(chat_id: String, text: String) -> String {
  let token = TgToken()
  let body = json_encode({chat_id: to_float(chat_id), text: text})
  let result = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json"))
  return result
}

// Send Telegram reply with MarkdownV2 formatting + fallback to plain text.
// Escapes text via EscapeMarkdownV2Simple, sends with parse_mode: "MarkdownV2".
// If Telegram rejects the formatting (ok != true), resends original text without parse_mode.
// Used for yana/admin departments where bold/italic formatting matters.
pattern SendTelegramReplyMDV2(chat_id: String, text: String) -> String {
  let token = TgToken()
  let escaped = EscapeMarkdownV2Simple(text)
  let body = json_encode({chat_id: to_float(chat_id), text: escaped, parse_mode: "MarkdownV2"})
  let result = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json"))
  if to_string(result) == "()" then {
    // Network error caught by try — fallback to plain text directly
    let body2 = json_encode({chat_id: to_float(chat_id), text: text})
    let result2 = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body2, "application/json"))
    return result2
  }
  let parsed = parse_json(result)
  let ok = redact(to_string(json_get(parsed, "ok", "")), "all")
  if ok != "true" then {
    // Telegram rejected MarkdownV2 formatting — fallback to plain text
    let body2 = json_encode({chat_id: to_float(chat_id), text: text})
    let result2 = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body2, "application/json"))
    return result2
  }
  return result
}

pattern SendTyping(chat_id: String) -> String {
  let token = TgToken()
  let body = json_encode({chat_id: to_float(chat_id), action: "typing"})
  let result = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendChatAction", body, "application/json"))
  return result
}

// ── FO-020: карточка review-очереди (inference review, наряд #86) ──
// /review → топ-8 невыверенного (parent_count DESC) с кнопками
// approve/decline/undo; решения через /review/decide, всё в audit_log.
pattern JsonEscapeText(s: String) -> String {
  let r = replace(s, "\\", "/")
  let r = replace(r, "\"", "'")
  let r = replace(r, "\n", "\\n")
  return r
}

pattern ReviewQueueCard(chat_id: String) -> String {
  let body = json_encode({limit: 8.0})
  let resp = TryVal(try http_post("http://127.0.0.1:4000/review/queue", body, "application/json", 5.0))
  if to_string(resp) == "()" then {
    let _ = SendTelegramReply(chat_id, "Review-очередь недоступна (proxy не отвечает).")
    return ""
  }
  let parsed = TryVal(try parse_json(resp))
  if to_string(parsed) == "()" then {
    let _ = SendTelegramReply(chat_id, "Review-очередь: ошибка разбора ответа.")
    return ""
  }
  let depth = redact(to_string(json_get(parsed, "depth", "0")), "all")
  let items = redact(to_string(json_get(parsed, "items", "[]")), "all")
  let count = to_float(json_get(parsed, "count", "0"))
  if count == 0.0 then {
    let _ = SendTelegramReply(chat_id, "🔍 Review-очередь пуста — всё выведенное подтверждено (глубина: " + depth + ").")
    return "ok"
  }
  let mut text = "🔍 Review-очередь (" + depth + " невыверенных, топ по числу источников):\n\n"
  let mut kb = ""
  each it in items {
    let sid = redact(to_string(json_get(it, "source", "")), "all")
    let iid = redact(to_string(json_get(it, "id", "")), "all")
    let pc = redact(to_string(json_get(it, "parent_count", "1")), "all")
    let content = redact(to_string(json_get(it, "content", "")), "all")
    let text = text + "• [" + sid + "#" + iid + " x" + pc + "] " + substring(content, 0.0, 140.0) + "\n"
    let kb = kb + "[{text: \"ОК\", callback_data: \"rv_approve_" + sid + "_" + iid + "\"},{text: \"NO\", callback_data: \"rv_decline_" + sid + "_" + iid + "\"},{text: \"UNDO\", callback_data: \"rv_undo_" + sid + "_" + iid + "\"}],"
  }
  if length(kb) > 0.0 then { let kb = substring(kb, 0.0, length(kb) - 1.0) }
  let token = TgToken()
  let text_esc = JsonEscapeText(text)
  let body2 = "{\"chat_id\": " + to_string(to_float(chat_id)) + ", \"text\": \"" + text_esc + "\", \"reply_markup\": {\"inline_keyboard\": [" + kb + "]}}"
  let _ = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body2, "application/json"))
  return "ok"
}

pattern CallLLMProxy(dept: String, messages: String) -> String {
  let body = json_encode({dept: dept, messages: parse_json(messages)})
  let result = TryVal(try http_post("http://127.0.0.1:4000/ask", body, "application/json", 240.0))
  if to_string(result) == "()" then { return "" }
  return result
}

// ── FOIP-003.1: Session Log ──
pattern LogSessionEvent(chat_id: String, event_type: String, dept: String, data: String, model: String, tokens_in: String, tokens_out: String) -> String {
  db_execute("INSERT INTO session_log (chat_id, session_seq, event_type, dept, data, model, tokens_in, tokens_out, created_at) VALUES (?, (SELECT COALESCE(MAX(session_seq),0)+1 FROM session_log WHERE chat_id=?), ?, ?, ?, ?, ?, ?, datetime('now'))", [chat_id, chat_id, event_type, dept, data, model, tokens_in, tokens_out])
  return "ok"
}

// ── FOIP-003.2: Resilient LLM Calling with fallback + cooldown ──
// ── FOIP-003.15: Model-Tier Routing ──
// Priority: tier-specific > dept-specific > global > default
pattern GetModelFallbackChain(dept: String) -> String {
  // FOIP-003.15: Check tier-specific override first
  let tier = kv_get("query_tier")
  if tier != "" then {
    let tier_file = "config/tier_" + tier + ".txt"
    let tier_content = redact(read_file(tier_file), "all")
    if tier_content != "" then {
      let tier_lines = split(tier_content, "\n")
      let mut tier_models = ""
      each tl in tier_lines {
        let trimmed = trim(tl)
        if length(trimmed) > 0 and starts_with(trimmed, "#") == false then {
          if tier_models != "" then { tier_models = tier_models + "," }
          tier_models = tier_models + trimmed
        }
      }
      if tier_models != "" then {
        let _ = AuditLog("tier_routing", "system", "tier=" + tier + " models=" + tier_models)
        return tier_models
      }
    }
  }
  // Read dept-specific override, fallback to global priority_model
  let override_file = "config/override_" + dept + ".txt"
  let override_content = redact(read_file(override_file), "all")
  if override_content != "" then {
    // Extract model lines (skip comments and empty)
    let ov_lines = split(override_content, "\n")
    let mut ov_models = ""
    each ov_line in ov_lines {
      let trimmed = trim(ov_line)
      if length(trimmed) > 0 and starts_with(trimmed, "#") == false then {
        if ov_models != "" then { ov_models = ov_models + "," }
        ov_models = ov_models + trimmed
      }
    }
    if ov_models != "" then { return ov_models }
  }
  let global = redact(read_file("config/priority_model.txt"), "all")
  if global != "" then { return trim(global) }
  return "glm-4.6"
}


pattern IsModelCooled(model: String) -> String {
  let fails = kv_get("fails:" + model)
  if fails == "" then { return "available" }
  if to_int(fails) >= 3 then { return "cooled" }
  return "available"
}

pattern MarkModelFail(model: String) -> String {
  let fails = kv_get("fails:" + model)
  let mut count = 0
  if fails != "" then { count = to_int(fails) }
  let _ = kv_set("fails:" + model, to_string(count + 1))
  return "ok"
}

pattern ClearModelFails(model: String) -> String {
  let _ = kv_set("fails:" + model, "")
  return "ok"
}

// ============================================================
// FOIP-003.14: Internal Endpoint Auth
// ============================================================
// ============================================================
// #546 A.1: единое сравнение секретов — рецепт Metalogos-#1317.
// redact(x, "all") прогоняет значение через энтропийную сеть (ADR-0136)
// и маскирует токен-подобные строки — сравнение сырого секрета после
// "all" молча ломается (класс 401/403 #536; подтверждено аудитором на
// 0.32.0). Рецепт: hash_only с ОБЕИХ сторон — односторонний SHA-256
// фингерпринт, детерминирован (проба на 0.32.0: двойной вызов равен),
// значение уничтожает, сравнимость сохраняет.
// Taint (Wave 15): результат паттерна, вызванного с untrusted-аргументом,
// сам untrusted — one-way-redact обязан стоять на call-site (наряд A.1:
// «применять redact(..., "hash_only"), а не "all"»). received приходит
// УЖЕ обёрнутым hash_only, сравнение — двойной фингерпринт
// H(H(received)) == H(H(env)) <=> received == env: сырой секрет любого
// вида (буквенный/токен-подобный) и его hash-форма (канал моста №318)
// проходят одним сравнением; неверный/пустой — нет.
// Пустой env -> false (отказ, как сейчас). Значения и хеши не печатаются.
// ============================================================
pattern SecretMatches(received: String, env_name: String) -> Bool {
  let expected_raw = env(env_name)
  if expected_raw == "" then { return false }
  let expected = to_string(redact(redact(expected_raw, "hash_only"), "hash_only"))
  if redact(received, "hash_only") == expected then { return true }
  return false
}

pattern RequireInternalAuth() -> String {
  // #536 A.1: токен — в заголовке X-Internal-Token, не в URL. Query-токен
  // утекал: исключение requests содержит URL целиком → _log_error писал
  // значение в журнал (401-лог Render 02:46:55 UTC).
  // #546 A.1: сравнение — SecretMatches (hash_only с обеих сторон, рецепт
  // Metalogos-#1317): ct_eq по сырой строке заголовка молча ломался на
  // токен-подобных значениях (gh#1317). Пустой env — auth-off, как раньше.
  let token = redact(request_header("X-Internal-Token"), "hash_only")
  let expected = env("INTERNAL_API_TOKEN")
  if expected == "" then { return "ok" }
  if SecretMatches(token, "INTERNAL_API_TOKEN") then { return "ok" }
  return "unauthorized"
}

// ============================================================
// FOIP-003.15: Model-Tier Classification
// Tiers: "quick" (cheap/fast), "standard" (default), "deep" (powerful)
// ============================================================
pattern ClassifyQueryTier(text: String, dept: String) -> String {
  let t = lower(trim(text))
  let quick_cmds = ["/start", "/help", "/status", "/office", "/dept", "/stats", "/cost", "/costs", "/budget", "/model", "/learning", "/\u043d\u0430\u0440\u044f\u0434\u044b", "/rate", "/yana"]
  each cmd in quick_cmds {
    if t == cmd then { return "quick" }
  }
  if t == "\u043f\u0440\u0438\u0432\u0435\u0442" or t == "\u0437\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439" or t == "\u0441\u043f\u0430\u0441\u0438\u0431\u043e" or t == "\u043e\u043a" or t == "ok" or t == "hello" then { return "quick" }
  if length(t) < 20.0 then { return "quick" }
  if starts_with(text, "/osp deep") then { return "deep" }
  if starts_with(text, "/osp full") then { return "deep" }
  if starts_with(text, "/osp wargame") then { return "deep" }
  // Наряд #385: dept-заявленные каскады глубины (промпты отделов) — команды
  // уровня теперь задают и tier модели (каскад применялся не везде)
  if starts_with(text, "/quickexpert") then { return "quick" }
  if starts_with(text, "/quickanalyze") then { return "quick" }
  if starts_with(text, "/deepexpert") then { return "deep" }
  if starts_with(text, "/lz deep") then { return "deep" }
  if starts_with(text, "/chain") then { return "deep" }
  if starts_with(text, "/debrief") then { return "deep" }
  let deep_kw = ["\u0430\u043d\u0430\u043b\u0438\u0437", "\u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u0438\u0435", "wargame", "\u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u044f", "\u043f\u0440\u043e\u0433\u043d\u043e\u0437", "\u043c\u043e\u0434\u0435\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435", "\u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439", "\u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0439", "\u043f\u043e\u0434\u0440\u043e\u0431\u043d\u044b\u0439", "\u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b\u0439", "\u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0441\u043d\u044b\u0439", "\u0441\u0440\u0430\u0432\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439", "\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0439", "\u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0439", "\u0441\u043f\u0440\u043e\u0433\u043d\u043e\u0437\u0438\u0440\u0443\u0439", "\u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0439", "research"]
  each kw in deep_kw {
    if contains(t, kw) then { return "deep" }
  }
  return "standard"
}

// ============================================================
// FOIP-003.16: Per-Provider Rate Limiting
// ============================================================
pattern GetProviderRateLimit(provider: String) -> String {
  let key = "rate_limit:" + provider
  let val = kv_get(key)
  if val != "" then { return val }
  return "20"
}

pattern CheckRateLimit(provider: String) -> String {
  let limit = to_float(GetProviderRateLimit(provider))
  let rows = query("SELECT COUNT(*) as c FROM rate_limits WHERE provider = ? AND created_at > datetime('now', '-1 minute')", [provider])
  if to_string(rows) == "()" then { return "ok" }
  let count = to_float(json_get(rows[0], "c", "0"))
  if count >= limit then { return "limited" }
  return "ok"
}

pattern RecordRateLimitCall(provider: String) -> String {
  let _ = db_execute("INSERT INTO rate_limits (provider, created_at) VALUES (?, datetime('now'))", [provider])
  let _ = TryVal(try db_execute("DELETE FROM rate_limits WHERE created_at < datetime('now', '-2 minutes')", []))
  return "ok"
}


pattern CallLLMResilient(dept: String, messages: String) -> String {
  let chain = TryVal(try GetModelFallbackChain(dept))
  if to_string(chain) == "()" then { return json_encode({reply: "Error: GetModelFallbackChain crashed", model: "", tokens_in: "0", tokens_out: "0", error: "GetModelFallbackChain"}) }
  let models = TryVal(try split(chain, ","))
  if to_string(models) == "()" then { return json_encode({reply: "Error: split chain crashed", model: "", tokens_in: "0", tokens_out: "0", error: "split"}) }
  let mut last_error = ""
  let mut reply = ""
  let mut used_model = ""
  let mut tokens_in = "0"
  let mut tokens_out = "0"
  let mut found = ""

  each raw_model in models {
    let model = trim(raw_model)
    if model != "" and found == "" then {
      let mut status = TryVal(try IsModelCooled(model))
      if to_string(status) == "()" then { status = "available" }
      if status == "cooled" then {
        last_error = "model " + model + " cooled (3+ fails)"
      } else {
        // FOIP-003.16: Rate limit check
        let mut rl_status = TryVal(try CheckRateLimit(model))
        if to_string(rl_status) == "()" then { rl_status = "ok" }
        if rl_status == "limited" then {
          last_error = "model " + model + " rate-limited"
        } else {
          let _ = TryVal(try RecordRateLimitCall(model))
          let msgs_parsed = TryVal(try parse_json(messages))
          if to_string(msgs_parsed) == "()" then {
            last_error = "parse_json(messages) crashed"
          } else {
            let body = TryVal(try json_encode({dept: dept, messages: msgs_parsed, model_override: model}))
            if to_string(body) == "()" then {
              last_error = "json_encode body crashed"
            } else {
              let result = TryVal(try http_post("http://127.0.0.1:4000/ask", body, "application/json", 240.0))
              if to_string(result) == "()" then {
                last_error = "no response from " + model
                let _ = TryVal(try MarkModelFail(model))
              } else {
                let parsed = TryVal(try parse_json(result))
                if to_string(parsed) == "()" then {
                  last_error = "parse error from " + model
                  let _ = TryVal(try MarkModelFail(model))
                } else {
                  let r = redact(to_string(TryVal(try json_get(parsed, "reply", ""))), "all")
                  if r == "" or r == "()" then {
                    last_error = "empty reply from " + model
                    let _ = TryVal(try MarkModelFail(model))
                  } else {
                    reply = r
                    used_model = to_string(TryVal(try json_get(parsed, "model", model)))
                    tokens_in = to_string(TryVal(try json_get(parsed, "tokens_in", "0")))
                    tokens_out = to_string(TryVal(try json_get(parsed, "tokens_out", "0")))
                    let _ = TryVal(try ClearModelFails(model))
                    found = "yes"
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  // Clear tier after use
  let _ = kv_set("query_tier", "")

  if reply == "" then {
    return json_encode({reply: "Error: all models failed (" + last_error + "). Try again later.", model: "", tokens_in: "0", tokens_out: "0", error: last_error})
  }
  return json_encode({reply: reply, model: used_model, tokens_in: tokens_in, tokens_out: tokens_out})
}

// ── FOIP-003.3: Token Metering ──
pattern LogTokenUsage(chat_id: String, dept: String, model: String, tokens_in: String, tokens_out: String) -> String {
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let _ = LogSessionEvent(chat_id, "token_usage", dept, "", model, tokens_in, tokens_out)
  let _ = db_execute("INSERT INTO daily_stats (date, dept, model, total_calls, total_tokens_in, total_tokens_out) VALUES (?, ?, ?, 1, ?, ?) ON CONFLICT(date, dept, model) DO UPDATE SET total_calls = total_calls + 1, total_tokens_in = total_tokens_in + ?, total_tokens_out = total_tokens_out + ?", [today, dept, model, tokens_in, tokens_out, tokens_in, tokens_out])
  return "ok"
}

pattern LogModelSuccess(chat_id: String, dept: String, model: String, tokens_in: String, tokens_out: String) -> String {
  let _ = LogTokenUsage(chat_id, dept, model, tokens_in, tokens_out)
  return "ok"
}

pattern LogModelFailure(chat_id: String, dept: String, model: String, error: String) -> String {
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let _ = LogSessionEvent(chat_id, "model_error", dept, error, model, "0", "0")
  let _ = db_execute("INSERT INTO daily_stats (date, dept, model, total_errors) VALUES (?, ?, ?, 1) ON CONFLICT(date, dept, model) DO UPDATE SET total_errors = total_errors + 1", [today, dept, model])
  return "ok"
}

// ── FOIP-003.13: Enhanced Analytics ──
pattern GetModelCostPer1M(model: String, direction: String) -> String {
  // direction: "in" or "out"
  let key = "model_cost:" + model + ":" + direction
  let val = kv_get(key)
  if val == "" then {
    if direction == "in" then { return "0.000002" }
    return "0.000006"
  }
  return val
}

pattern AggregateDailyStats() -> String {
  let rows = query("SELECT id, model, total_tokens_in, total_tokens_out FROM daily_stats WHERE estimated_cost_usd = 0.0", [])
  let updated = "0"
  each row in rows {
    let rid = redact(to_string(json_get(row, "id", "0")), "all")
    let m = redact(to_string(json_get(row, "model", "")), "all")
    let ti = to_float(json_get(row, "total_tokens_in", "0"))
    let to_ = to_float(json_get(row, "total_tokens_out", "0"))
    let cost_in_rate = to_float(GetModelCostPer1M(m, "in"))
    let cost_out_rate = to_float(GetModelCostPer1M(m, "out"))
    let cost = ti * cost_in_rate + to_ * cost_out_rate
    let _ = db_execute("UPDATE daily_stats SET estimated_cost_usd = ? WHERE id = ?", [to_string(cost), rid])
    let updated = to_string(to_float(updated) + 1.0)
  }
  return "Пересчитано строк: " + updated
}

pattern ShowStats(chat_id: String) -> String {
  let _ = InitDB()
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let _ = AggregateDailyStats()
  let rows = query("SELECT dept, SUM(total_calls) as calls, SUM(total_tokens_in) as ti, SUM(total_tokens_out) as to_, SUM(total_errors) as errs, SUM(estimated_cost_usd) as cost FROM daily_stats WHERE date = ? GROUP BY dept ORDER BY calls DESC", [today])
  if length(rows) == 0.0 then { return "Статистика за сегодня (" + today + ") пуста." }
  let out = "Статистика за " + today + "\n"
  let out = out + "==============================\n"
  let grand_calls = 0.0
  let grand_ti = 0.0
  let grand_to = 0.0
  let grand_errs = 0.0
  let grand_cost = 0.0
  each row in rows {
    let d = redact(to_string(json_get(row, "dept", "?")), "all")
    let c = to_float(json_get(row, "calls", "0"))
    let ti = to_float(json_get(row, "ti", "0"))
    let to_ = to_float(json_get(row, "to_", "0"))
    let e = to_float(json_get(row, "errs", "0"))
    let cost = to_float(json_get(row, "cost", "0"))
    let grand_calls = grand_calls + c
    let grand_ti = grand_ti + ti
    let grand_to = grand_to + to_
    let grand_errs = grand_errs + e
    let grand_cost = grand_cost + cost
    let err_str = to_string(to_int(e))
    if e > 0.0 then { let err_str = "! " + err_str }
    let out = out + d + ": " + to_string(to_int(c)) + " calls | " + to_string(to_int(ti)) + "+" + to_string(to_int(to_)) + " tokens | " + err_str + " errors\n"
  }
  let out = out + "==============================\n"
  let out = out + "TOTAL: " + to_string(to_int(grand_calls)) + " calls | " + to_string(to_int(grand_ti)) + "+" + to_string(to_int(grand_to)) + " tokens | " + to_string(to_int(grand_errs)) + " errors\n"
  return out
}

pattern ShowCosts(chat_id: String) -> String {
  let _ = InitDB()
  let _ = AggregateDailyStats()
  let date_rows = query("SELECT date('now') as d", [])
  let today = ""
  each dr in date_rows { let today = to_string(json_get(dr, "d", "")) }
  let rows = query("SELECT model, SUM(total_calls) as calls, SUM(total_tokens_in) as ti, SUM(total_tokens_out) as to_, SUM(estimated_cost_usd) as cost FROM daily_stats WHERE date = ? GROUP BY model ORDER BY cost DESC", [today])
  if length(rows) == 0.0 then { return "Данных о расходах за сегодня нет." }
  let out = "Расходы за " + today + "\n"
  let out = out + "==============================\n"
  let total_cost = 0.0
  let total_calls = 0.0
  let total_tokens = 0.0
  each row in rows {
    let m = redact(to_string(json_get(row, "model", "?")), "all")
    let c = to_float(json_get(row, "calls", "0"))
    let ti = to_float(json_get(row, "ti", "0"))
    let to_ = to_float(json_get(row, "to_", "0"))
    let cost = to_float(json_get(row, "cost", "0"))
    let total_cost = total_cost + cost
    let total_calls = total_calls + c
    let total_tokens = total_tokens + ti + to_
    let out = out + m + ": " + to_string(to_int(c)) + " calls | " + to_string(to_int(ti + to_)) + " tokens | ~$" + to_string(cost) + "\n"
  }
  let out = out + "==============================\n"
  let out = out + "TOTAL: ~$" + to_string(total_cost) + " | " + to_string(to_int(total_calls)) + " calls | " + to_string(to_int(total_tokens)) + " tokens\n"
  // Last 7 days trend
  let trend_rows = query("SELECT date, SUM(estimated_cost_usd) as cost, SUM(total_calls) as calls FROM daily_stats GROUP BY date ORDER BY date DESC LIMIT 7", [])
  if length(trend_rows) > 0.0 then {
    let out = out + "\nLast 7 days:\n"
    each tr in trend_rows {
      let td = redact(to_string(json_get(tr, "date", "?")), "all")
      let tc = redact(to_string(json_get(tr, "cost", "0")), "all")
      let tcl = redact(to_string(to_int(to_float(json_get(tr, "calls", "0")))), "all")
      let out = out + "  " + td + ": ~$" + tc + " (" + tcl + " calls)\n"
    }
  }
  return out
}


pattern RecordModelResult(dept: String, model: String, success: String) -> String {
  if success != "ok" then {
    let _ = LogModelFailure(dept, dept, model, "fallback triggered")
  }
  return "ok"
}

// ── FOIP-003.5: Context Compaction ──
pattern EstimateTokens(text: String) -> String {
  return to_string(length(text) / 4.0)
}

pattern GetCompactedHistory(chat_id: String, limit: String, dept: String) -> String {
  let total_rows = query("SELECT COUNT(*) as cnt FROM dialog_history WHERE chat_id = ? AND dept = ?", [chat_id, dept])
  let total = to_int(json_get(total_rows[0], "cnt", "0"))
  let lim = to_int(limit)
  if total <= lim * 2 then {
    return GetRecentDialog(chat_id, limit, dept)
  }
  let early_rows = query("SELECT role, content FROM dialog_history WHERE chat_id = ? AND dept = ? ORDER BY created_at ASC LIMIT 3", [chat_id, dept])
  let recent_rows = query("SELECT role, content FROM dialog_history WHERE chat_id = ? AND dept = ? ORDER BY created_at DESC LIMIT ?", [chat_id, dept, limit])
  let out = ""
  each row in early_rows {
    let role = redact(to_string(json_get(row, "role", "")), "all")
    let content = redact(to_string(json_get(row, "content", "")), "all")
    if length(content) > 300.0 then { let content = substring(content, 0.0, 300.0) + "..." }
    let out = out + role + ": " + content + "\n"
  }
  let skipped = total - 3 - lim
  if skipped > 0 then {
    let out = out + "\n[... " + to_string(skipped) + " messages skipped for context economy ...]\n\n"
  }
  each row in recent_rows {
    let role = redact(to_string(json_get(row, "role", "")), "all")
    let content = redact(to_string(json_get(row, "content", "")), "all")
    let out = out + role + ": " + content + "\n"
  }
  return out
}

// ── FOIP-003.6: Three input channels (followup/steer/inject) ──
pattern InjectContext(target_dept: String, context_text: String) -> String {
  // TEAM-3 #482 A.4: /inject переведён на доску находок. Было: ячейка KV
  // "inject:<dept>" — конкатенация без источника, затирание следующей записью.
  // Стало: публикация от from_dept="owner" (delivered=0, тег = отдел, ttl 24 ч).
  // Дедуп TeamPublish НЕ применяется — повторный /inject в тот же день не
  // теряется; one-shot чтение сохранено в GetInjectedContext.
  let _ = TeamBoardInsert("owner", "fact", substring(context_text, 0.0, 60.0), "[\"" + target_dept + "\"]", context_text, "", 24.0, 0.0)
  return "ok"
}

pattern GetInjectedContext(dept: String) -> String {
  // TEAM-3 #482 A.4: чтение инъекций владельца с доски (from_dept='owner',
  // delivered=0, тег отдела), one-shot: прочитанное помечается delivered=1.
  let rows = TryVal(try query("SELECT GROUP_CONCAT(payload, '\n---\n') AS merged FROM team_board WHERE from_dept = 'owner' AND delivered = 0 AND tags LIKE ?1", ["%\"" + dept + "\"%"]))
  if to_string(rows) == "()" then { return "" }
  let merged = to_string(json_get(parse_json(to_string(rows)), "[0].merged", ""))
  if merged == "" then { return "" }
  let _ = TryVal(try db_execute("UPDATE team_board SET delivered = 1 WHERE from_dept = 'owner' AND delivered = 0 AND tags LIKE ?1", ["%\"" + dept + "\"%"]))
  return merged
}

pattern SteerDept(dept: String, correction: String) -> String {
  let _ = kv_set("steer:" + dept, correction)
  return "ok"
}

pattern GetSteerContext(dept: String) -> String {
  let ctx = kv_get("steer:" + dept)
  if ctx != "" then {
    let _ = kv_set("steer:" + dept, "")
  }
  return ctx
}


pattern IsImageRequest(text: String) -> String {
  // Returns "true" if text asks for image generation, "" otherwise
  let t = lower(text)
  if contains(t, "сгенерируй изображен") then { return "true" }
  if contains(t, "сгенерируй картинк") then { return "true" }
  if contains(t, "нарисуй") then { return "true" }
  if contains(t, "создай изображен") then { return "true" }
  if contains(t, "создай картинк") then { return "true" }
  if contains(t, "generate image") then { return "true" }
  if contains(t, "create image") then { return "true" }
  if contains(t, "нарисуй логотип") then { return "true" }
  if contains(t, "сделай иллюстрац") then { return "true" }
  if contains(t, "сгенерируй логотип") then { return "true" }
  if contains(t, "generate logo") then { return "true" }
  if contains(t, "create logo") then { return "true" }
  if contains(t, "нарисуй иконк") then { return "true" }
  if contains(t, "нарисуй постер") then { return "true" }
  if contains(t, "сделай обложк") then { return "true" }
  return ""
}

pattern HandleDesignImage(prompt: String, chat_id: String) -> String {
  // Call /generate-image endpoint — it generates and sends photo to Telegram
  let body = json_encode({prompt: prompt, chat_id: to_float(chat_id)})
  let result = TryVal(try http_post("http://127.0.0.1:4000/generate-image", body, "application/json", 180.0))
  if to_string(result) == "()" then {
    let _ = SendTelegramReply(chat_id, "Ошибка: генерация изображений недоступна.")
    return ""
  }
  let parsed = parse_json(result)
  let status = redact(to_string(json_get(parsed, "status", "error")), "all")
  if status == "ok" then {
    return ""
  } else {
    let err = redact(to_string(json_get(parsed, "error", "Unknown error")), "all")
    return "Ошибка генерации: " + err
  }
}

// Context Manager: восстановлен как import dept/context (расинлайнинг 0.23.0,
// верификация импортов — PR #352; состав см. dept/context.mlog)
// ============================================================

// ============================================================
// GENERIC ARCHIVE (narad 3/6) — save/verify/score for generic depts
// ============================================================


// Narad 8 — structured verify: /verify finance <id> actual=<число> or /verify legal <id> outcome=clean|rewrite_required
// Falls back to legacy VerifyArchiveEntry for free-text outcome (marketing, etc.)
pattern VerifyArchiveEntryStructured(dept: String, entry_id: Int, raw_args: String) -> String {
  // Check: is this a structured actual=<number> call (Finance)?
  if starts_with(raw_args, "actual=") then {
    let val_str = substring(raw_args, 7.0, length(raw_args))
    let actual_val = to_float(val_str)
    let existing = query("SELECT * FROM dept_archive WHERE id = ? AND dept = ?", [to_string(entry_id), dept])
    if length(existing) == 0.0 then {
      return "Запись #" + to_string(entry_id) + " для " + dept + " не найдена"
    }
    db_execute("UPDATE dept_archive SET status = 'verified', verification_date = datetime('now') WHERE id = ?1", [to_string(entry_id)])
    db_insert("dept_verification", {archive_id: entry_id, actual_value: actual_val, actual_outcome: "actual=" + val_str})
    return "Запись #" + to_string(entry_id) + " верифицирована: actual=" + val_str
  }

  // Check: is this a structured outcome=<flag> call (Legal)?
  if starts_with(raw_args, "outcome=") then {
    let flag = substring(raw_args, 8.0, length(raw_args))
    if flag != "clean" and flag != "rewrite_required" then {
      return "outcome должен быть 'clean' или 'rewrite_required', получено: " + flag
    }
    let existing = query("SELECT * FROM dept_archive WHERE id = ? AND dept = ?", [to_string(entry_id), dept])
    if length(existing) == 0.0 then {
      return "Запись #" + to_string(entry_id) + " для " + dept + " не найдена"
    }
    db_execute("UPDATE dept_archive SET status = 'verified', verification_date = datetime('now') WHERE id = ?1", [to_string(entry_id)])
    db_insert("dept_verification", {archive_id: entry_id, outcome_flag: flag, actual_outcome: "outcome=" + flag})
    return "Запись #" + to_string(entry_id) + " верифицирована: outcome=" + flag
  }

  // Fallback — legacy free-text (marketing and all other cases)
  return VerifyArchiveEntry(dept, entry_id, raw_args)
}

pattern VerifyArchiveEntry(dept: String, entry_id: Int, outcome: String) -> String {
  let existing = query("SELECT * FROM dept_archive WHERE id = ? AND dept = ?", [to_string(entry_id), dept])
  if length(existing) == 0.0 then {
    return "Запись #" + to_string(entry_id) + " для " + dept + " не найдена"
  }
  db_execute("UPDATE dept_archive SET status = 'verified', verification_date = datetime('now') WHERE id = ?1", [to_string(entry_id)])
  db_insert("dept_verification", {archive_id: entry_id, actual_outcome: outcome})
  return "Запись #" + to_string(entry_id) + " (" + dept + ") верифицирована: " + outcome
}

// Narad 8 — Finance MAPE: requires min 10 verified pairs (forecast_value + actual_value)
pattern ComputeFinanceMAPE() -> String {
  let rows = query("SELECT a.forecast_value, v.actual_value FROM dept_archive a JOIN dept_verification v ON v.archive_id = a.id WHERE a.dept = 'finance' AND a.forecast_value IS NOT NULL AND v.actual_value IS NOT NULL")
  if length(rows) == 0.0 then {
    return "MAPE: недостаточно данных для калибровки (0/10 записей)"
  }
  let n = 0.0
  let sum_error = 0.0
  each row in rows {
    let n = n + 1.0
    let forecast = to_float(json_get(row, "forecast_value", "0"))
    let actual = to_float(json_get(row, "actual_value", "0"))
    if actual != 0.0 then {
      let error = abs(forecast - actual) / abs(actual)
      let sum_error = sum_error + error
    }
  }
  if n < 10.0 then {
    return "MAPE: недостаточно данных для калибровки (" + to_string(to_int(n)) + "/10 записей)"
  }
  let mape = (sum_error / n) * 100.0
  return "MAPE (калиброванная): " + to_string(mape) + "% (n=" + to_string(to_int(n)) + ")"
}

// Narad 8 — Legal % без rewrites: requires min 10 verified entries with outcome_flag
pattern ComputeLegalCleanRate() -> String {
  let rows = query("SELECT v.outcome_flag FROM dept_archive a JOIN dept_verification v ON v.archive_id = a.id WHERE a.dept = 'legal' AND v.outcome_flag IS NOT NULL")
  if length(rows) == 0.0 then {
    return "% без rewrites: недостаточно данных для калибровки (0/10 записей)"
  }
  let n = 0.0
  let clean_count = 0.0
  each row in rows {
    let n = n + 1.0
    let flag = redact(to_string(json_get(row, "outcome_flag", "")), "all")
    if flag == "clean" then {
      let clean_count = clean_count + 1.0
    }
  }
  if n < 10.0 then {
    return "% без rewrites: недостаточно данных для калибровки (" + to_string(to_int(n)) + "/10 записей)"
  }
  let rate = (clean_count / n) * 100.0
  return "% без rewrites (калиброванная): " + to_string(rate) + "% (n=" + to_string(to_int(n)) + ", clean=" + to_string(to_int(clean_count)) + ")"
}

pattern ScoreDept(dept: String) -> String {
  let d1 = TryVal(try query("SELECT COUNT(*) as cnt FROM dept_archive WHERE dept = ?", [dept]))
  if to_string(d1) == "()" then { return "Score: " + dept + "\n[Ошибка запроса к БД]" }
  let d2 = TryVal(try query("SELECT COUNT(*) as cnt FROM dept_archive WHERE dept = ? AND status = 'verified'", [dept]))
  let d3 = TryVal(try query("SELECT COUNT(*) as cnt FROM dept_archive WHERE dept = ? AND status = 'drafted'", [dept]))
  // №422: COUNT(*) приходит числом — redact(число) = рантайм-ошибка; to_string до мойки
  let g1 = redact(to_string(TryVal(try json_get(d1[0], "cnt", "0"))), "all")
  let mut g2 = "0"
  if to_string(d2) != "()" then { g2 = to_string(TryVal(try json_get(d2[0], "cnt", "0"))) }
  let mut g3 = "0"
  if to_string(d3) != "()" then { g3 = to_string(TryVal(try json_get(d3[0], "cnt", "0"))) }
  let total = to_string(g1)
  let verified = to_string(g2)
  let drafted = to_string(g3)
  let base = "Score: " + dept + "\nВсего записей: " + total + "\nВерифицировано: " + verified + "\nВ ожидании: " + drafted

  // Narad 8 — append calibrated metric for Finance and Legal
  if dept == "finance" then {
    let mape = TryVal(try ComputeFinanceMAPE())
    if to_string(mape) == "()" then { return base + "\n\n[MAPE: ошибка вычисления]" }
    return base + "\n\n" + mape
  }
  if dept == "legal" then {
    let clean_rate = TryVal(try ComputeLegalCleanRate())
    if to_string(clean_rate) == "()" then { return base + "\n\n[Clean rate: ошибка вычисления]" }
    return base + "\n\n" + clean_rate
  }

  return base + "\n\n[Базовая метрика активности. Калиброванная domain-метрика — после наполнения content-скиллов]"
}

pattern ArchiveSearch(dept: String, filter_text: String) -> String {
  if filter_text != "" then {
    return query("SELECT id, topic, status, created_at FROM dept_archive WHERE dept = ? AND topic LIKE ? ORDER BY created_at DESC LIMIT 10", [dept, "%" + filter_text + "%"])
  } else {
    return query("SELECT id, topic, status, created_at FROM dept_archive WHERE dept = ? ORDER BY created_at DESC LIMIT 10", [dept])
  }
}

pattern FormatArchiveRows(rows: Any) -> String {
  if length(rows) == 0.0 then { return "Нет записей в архиве." }
  let output = ""
  each item in rows {
    let id = redact(to_string(json_get(item, "id", "?")), "all")
    let topic = redact(to_string(json_get(item, "topic", "?")), "all")
    let status = redact(to_string(json_get(item, "status", "?")), "all")
    let created = redact(to_string(json_get(item, "created_at", "?")), "all")
    let output = output + "#" + id + " [" + status + "] " + topic + " (" + created + ")\n"
  }
  return output
}

// ============================================================
// END GENERIC ARCHIVE
// ============================================================

// ============================================================
// IDEA-1: Consensus Memory (from Auto-Company)
// Single baton file read before query, updated after.
// ============================================================

pattern ReadConsensus() -> String {
  let content = redact(read_file("memories/consensus.mlog"), "all")
  if content == "" then { return "" }
  // Extract only the section between === CONSENSUS === markers
  let start_marker = "=== CONSENSUS ==="
  let end_marker = "=== END CONSENSUS ==="
  if contains(content, start_marker) == false then { return "" }
  let si = index_of(content, start_marker)
  let si = si + length(start_marker)
  if contains(content, end_marker) then {
    let ei = index_of(content, end_marker)
    if ei > si then {
      let section = substring(content, si, ei)
      return trim(section)
    }
  }
  return ""
}

pattern UpdateConsensus(dept: String, query: String, result_summary: String) -> String {
  let now_ts = to_string(now())
  let date_rows = query("SELECT datetime('now') as d", [])
  let mut now_str = ""
  each dr in date_rows { let now_str = to_string(json_get(dr, "d", "")) }
  // Append new entry before === END CONSENSUS ===
  let entry = "\n[" + now_str + "] " + dept + ": " + substring(query, 0.0, 80.0) + "\n  result: " + substring(result_summary, 0.0, 200.0) + "\n"
  let content = redact(read_file("memories/consensus.mlog"), "all")
  if content == "" then { return "" }
  // Replace "Last updated: never" with current timestamp
  let content = replace(content, "Last updated: never", "Last updated: " + now_str)
  let content = replace(content, "Last updated: initialized", "Last updated: " + now_str)
  // Insert before END CONSENSUS
  let content = replace(content, "=== END CONSENSUS ===", entry + "=== END CONSENSUS ===")
  let _ = write_file("memories/consensus.mlog", content)
  return "ok"
}

// ============================================================
// IDEA-2: Continuous Learning — record successful patterns
// After each dept query, extract and store what worked.
// ============================================================

pattern RecordLearning(dept: String, query: String, reply: String, verify_score: String) -> String {
  // Only record if verification passed (score >= 0.7) and reply is substantive
  let score = to_float(verify_score)
  if score < 0.7 then { return "" }
  if length(reply) < 50.0 then { return "" }
  // Build a learning pattern: query category -> what approach worked
  let body = json_encode({dept: dept, query: substring(query, 0.0, 500.0), approach: substring(reply, 0.0, 500.0), score: verify_score})
  let _ = TryVal(try http_post("http://127.0.0.1:4000/learning/record", body, "application/json"))
  return "ok"
}

pattern RecallLearnings(dept: String, query: String) -> String {
  let body = json_encode({dept: dept, query: query, limit: 3})
  let resp = TryVal(try http_post("http://127.0.0.1:4000/learning/recall", body, "application/json"))
  if to_string(resp) == "()" then { return "" }
  let parsed = TryVal(try parse_json(resp))
  if to_string(parsed) == "()" then { return "" }
  let count = to_float(json_get(parsed, "count", "0"))
  if count == 0.0 then { return "" }
  // №422: results — массив (each по нему); redact(массив) = рантайм-ошибка.
  // Контейнер без мойки — все поля еgress-а моются ниже (approach/score).
  let results = TryVal(try json_get(parsed, "results", "[]"))
  if to_string(results) == "()" then { return "" }
  let mut learnings_text = ""
  each r in results {
    let approach = redact(to_string(json_get(r, "approach", "")), "all")
    let sc = redact(to_string(json_get(r, "score", "")), "all")
    if approach != "" then {
      let learnings_text = learnings_text + "- [score:" + sc + "] " + approach + "\n"
    }
  }
  if learnings_text != "" then {
    return "=== Что сработало ранее (Continuous Learning) ===\n" + learnings_text
  }
  return ""
}

// ============================================================
// IDEA-3: Verify Step — self-check before sending (non-blocking)
// Uses existing llm_verifier.py, only for substantive queries.
// ============================================================

pattern VerifyReply(query: String, reply: String, dept: String) -> String {
  // Skip verification for short/trivial queries
  if length(query) < 30.0 then { return "0.9" }
  if length(reply) < 50.0 then { return "0.9" }
  // Skip for yana — already has its own verify at line 1552
  if dept == "yana" then { return "0.9" }
  let v_resp = TryVal(try call_python("llm_verifier", "score", json_encode([query, reply, "Accuracy: Correct information? Relevance: Addresses question? No hallucination?"])))
  if to_string(v_resp) == "()" then { return "0.8" }
  // v_resp may be a bare float or a JSON string
  let v_str = to_string(v_resp)
  // If it looks like a number directly
  if contains(v_str, "error") then { return "0.8" }
  return v_str
}

// ============================================================
// IDEA-4: Context Budget — enforce max tokens on dialog history
// ============================================================

pattern GetBudgetedHistory(chat_id: String, limit: String, max_tokens_str: String, dept: String) -> String {
  let mut max_tokens = to_float(max_tokens_str)
  if max_tokens <= 0.0 then { max_tokens = 4000.0 }
  let raw = GetCompactedHistory(chat_id, limit, dept)
  // Estimate tokens: ~4 chars per token
  let est = length(raw) / 4.0
  if est <= max_tokens then { return raw }
  // Trim from the beginning (keep recent messages)
  let mut trimmed = raw
  while length(trimmed) / 4.0 > max_tokens {
    let nl = index_of(trimmed, "\n")
    if nl < 0.0 then { break }
    let trimmed = substring(trimmed, nl + 1.0, length(trimmed))
  }
  let trimmed = trim(trimmed)
  let cut_note = "\n[... context trimmed to ~" + to_string(to_int(max_tokens)) + " token budget ...]\n"
  return cut_note + trimmed
}

// ============================================================
// IDEA-5: Expert Persona Injection
// Reads library/personas.mlog and injects the relevant expert mental model.
// ============================================================

pattern GetExpertPersona(dept: String) -> String {
  let content = redact(read_file("library/personas.mlog"), "all")
  if content == "" then { return "" }
  // Find the section for this department: "## dept"
  let marker = "## " + dept
  if contains(content, marker) == false then { return "" }
  let si = index_of(content, marker)
  // Find the end: next "## " or end of file
  let rest = substring(content, si + length(marker), length(content))
  let mut ei = length(rest)
  let next_section = index_of(rest, "\n## ")
  if next_section > 0.0 then { let ei = next_section }
  let section = substring(rest, 0.0, ei)
  // Trim to max 1500 chars to avoid bloating context
  if length(section) > 1500.0 then {
    let section = substring(section, 0.0, 1500.0) + "\n... (persona truncated)"
  }
  return "=== Expert Persona (Mental Model) ===\n" + section
}

// ============================================================
// IDEA-6: Brand Contract — inject brand.mlog into design dept context
// ============================================================

pattern GetBrandContract() -> String {
  let content = redact(read_file("library/brand.mlog"), "all")
  if content == "" then { return "" }
  // Trim to 2000 chars max
  if length(content) > 2000.0 then {
    let content = substring(content, 0.0, 2000.0) + "\n... (brand contract truncated)"
  }
  return "=== Brand Contract ===\n" + content
}

// ============================================================
// IDEA-7: Sub-Agent Routing — route to specialized sub-role within dept
// ============================================================

pattern ResolveSubAgent(dept: String, query: String) -> String {
  // Each dept maps query keywords to a sub-role specialization
  let t = lower(query)
  if dept == "finance" then {
    if contains(t, "cashflow") or contains(t, "кэшфло") or contains(t, "cash flow") then { return "cashflow" }
    if contains(t, "инвойс") or contains(t, "invoice") or contains(t, "платёж") or contains(t, "оплата") then { return "invoicing" }
    if contains(t, "налог") or contains(t, "tax") or contains(t, "ндс") then { return "tax" }
    if contains(t, "unit economics") or contains(t, "unit") or contains(t, "cac") or contains(t, "ltv") or contains(t, "mrr") or contains(t, "arr") then { return "unit-economics" }
    return "general"
  }
  if dept == "osp" then {
    if contains(t, "препар") or contains(t, "analys") or contains(t, "анализ") then { return "analysis" }
    if contains(t, "прогноз") or contains(t, "forecast") or contains(t, "scenario") then { return "forecasting" }
    if contains(t, "риск") or contains(t, "risk") or contains(t, "wargame") then { return "risk" }
    return "strategic"
  }
  if dept == "marketing" then {
    if contains(t, "кампан") or contains(t, "campaign") then { return "campaigns" }
    if contains(t, "конкурент") or contains(t, "competitor") then { return "competitive" }
    if contains(t, "цифр") or contains(t, "cac") or contains(t, "воронк") or contains(t, "funnel") then { return "digital" }
    return "strategy"
  }
  if dept == "legal" then {
    if contains(t, "договор") or contains(t, "контракт") or contains(t, "contract") then { return "contracts" }
    if contains(t, "нда") or contains(t, "nda") or contains(t, "конфиденц") then { return "nda" }
    if contains(t, "gdpr") or contains(t, "персональн") or contains(t, "комплаенс") then { return "compliance" }
    return "general-counsel"
  }
  if dept == "expert" then {
    if contains(t, "встреч") or contains(t, "переговор") or contains(t, "negotiat") then { return "negotiation" }
    if contains(t, "интервью") or contains(t, "interview") then { return "interview" }
    return "briefing"
  }
  if dept == "engineering" then {
    if contains(t, "расчёт") or contains(t, "calculation") or contains(t, "моделирован") then { return "calculation" }
    if contains(t, "simulat") or contains(t, "симуляц") then { return "simulation" }
    return "analysis"
  }
  // Default: no sub-agent specialization
  return ""
}

// ============================================================
// END: OFFICE INTELLIGENCE — 7 IDEAS
// ============================================================

pattern HandleDeptQuery(dept: String, query: String, chat_id: String) -> String {
  let context = BuildContext(dept, query, chat_id)
  // TEAM-2 #481: бриф коллег и правило ASK (A.3) + карта потребностей (A.2)
  let team_block = TeamAskBlock(dept)
  if team_block != "" then { let context = context + "\n\n" + team_block }
  let auto_block = TeamAutoConsult(dept, query)
  if auto_block != "" then { let context = context + "\n\n" + auto_block }
  let messages = json_encode([{role: "system", content: context}, {role: "user", content: query}])
  // FOIP-003.1: Log user message to session
  let _ = LogSessionEvent(chat_id, "user_message", dept, substring(query, 0.0, 2000.0), "", "0", "0")
  // FOIP-003.2: Use resilient LLM with fallback
  let proxy_result = TryVal(try CallLLMResilient(dept, messages))
  if to_string(proxy_result) == "()" then {
    let _ = AuditLog("llm_fail", dept, "CallLLMResilient crashed")
    return ""
  }
  let parsed = TryVal(try parse_json(proxy_result))
  if to_string(parsed) == "()" then {
    let _ = AuditLog("llm_fail", dept, "parse_json on proxy_result failed: " + substring(to_string(proxy_result), 0.0, 100.0))
    return ""
  }
  let reply = redact(to_string(json_get(parsed, "reply", "Error: empty reply")), "all")
  // TEAM-2 #481 A.3: маркеры ASK — консультации коллег и второй проход;
  // маркеры не доходят владельцу, не более одного доп. прохода
  let enhanced = TeamSecondPass(dept, query, context, reply)
  if enhanced != "" then { let reply = enhanced }
  let used_model = redact(to_string(json_get(parsed, "model", "")), "all")
  let tokens_in = redact(to_string(json_get(parsed, "tokens_in", "0")), "all")
  let tokens_out = redact(to_string(json_get(parsed, "tokens_out", "0")), "all")
  // FOIP-003.3: Log token usage
  if used_model != "" then {
    let _ = LogModelSuccess(chat_id, dept, used_model, tokens_in, tokens_out)
  }
  // FOIP-003.1: Log assistant message to session
  let _ = LogSessionEvent(chat_id, "assistant_message", dept, substring(reply, 0.0, 2000.0), used_model, tokens_in, tokens_out)
  // IDEA-3: Verify step — self-check before sending (non-blocking)
  let verify_score = VerifyReply(query, reply, dept)
  let _ = AuditLog("dept_verify", dept, "score=" + verify_score + " query: " + substring(query, 0.0, 50.0))
  // Store model info for SendReport meta section
  if used_model != "" then { let _ = kv_set("last_model_" + dept, used_model) }
  let _ = kv_set("last_tokens_" + dept, tokens_in + "+" + tokens_out)
  // Append model/token footer to reply
  let mut footer = ""
  if used_model != "" then {
    let footer = "\n\n. " + used_model + " | " + tokens_in + "+" + tokens_out + " tokens"
  }
  let final_reply = reply + footer
  // TEAM-2 #481 A.5: источники — консультации по карте потребностей
  if auto_block != "" then { let final_reply = final_reply + TeamFooterFromBlock(auto_block) }
  let _ = RecordAssistantMessage(chat_id, dept, final_reply)
  let _ = YanaAutoMemorize(query, reply, chat_id)
  // IDEA-1: Update consensus with this interaction
  let _ = UpdateConsensus(dept, query, reply)
  // IDEA-2: Record learning if verify score is high
  let _ = RecordLearning(dept, query, reply, verify_score)
  let _ = AuditLog("dept_query", dept, "model=" + used_model + " tokens=" + tokens_in + "+" + tokens_out + " verify=" + verify_score + " query: " + substring(query, 0.0, 100.0))
  return final_reply
}

pattern DetectDepartment(text: String) -> String {
  if starts_with(text, "/yana") then { return "yana" }
  if starts_with(text, "/osp") then { return "osp" }
  if starts_with(text, "/lz") then { return "lz" }
  // #566: /lab-watch — команды watchlist ЛЗ по уставу (library/lz.md:119)
  if starts_with(text, "/lab-watch") then { return "lz" }
  // #559: /lab-score, /lab-recalibrate — метрики ЛЗ по уставу (library/lz.md:123)
  if starts_with(text, "/lab-score") then { return "lz" }
  if starts_with(text, "/lab-recalibrate") then { return "lz" }
  // №376: /quickexpert (depth 1) и /deepexpert (depth 3) — промпт Эксперта
  // заявляет, dept/expert.mlog:159-164 парсит оба, но диспетчер раньше их
  // не мапил (не матчатся префиксом "/expert") — команды молча уходили в Яну.
  if starts_with(text, "/quickexpert") then { return "expert" }
  if starts_with(text, "/deepexpert") then { return "expert" }
  if starts_with(text, "/expert") then { return "expert" }
  if starts_with(text, "/marketing") then { return "marketing" }
  if starts_with(text, "/finance") then { return "finance" }
  if starts_with(text, "/legal") then { return "legal" }
  if starts_with(text, "/dev") then { return "dev" }
  if starts_with(text, "/design-image") then { return "design-image" }
  if starts_with(text, "/design") then { return "design" }
  if starts_with(text, "/qa") then { return "qa" }
  if starts_with(text, "/visual") then { return "visual" }
  if starts_with(text, "/engineering") then { return "engineering" }
  if starts_with(text, "/forge") then { return "kavalnya" }
  if starts_with(text, "/admin") then { return "admin" }

  // Extended commands
  if starts_with(text, "/analyze") then { return "osp" }
  if starts_with(text, "/scan") then { return "lz" }
  if starts_with(text, "/deep") then { return "osp" }
  if starts_with(text, "/quickanalyze") then { return "osp" }
  if starts_with(text, "/wargame") then { return "osp" }
  if starts_with(text, "/market-research") then { return "marketing" }
  if starts_with(text, "/segment") then { return "marketing" }
  if starts_with(text, "/competitors") then { return "marketing" }
  if starts_with(text, "/campaign") then { return "marketing" }
  if starts_with(text, "/cro") then { return "marketing" }
  if starts_with(text, "/marketing-context") then { return "marketing" }
  if starts_with(text, "/marketing-ideas") then { return "marketing" }
  if starts_with(text, "/calc") then { return "engineering" }
  if starts_with(text, "/simulate") then { return "engineering" }

  // FO-014: MCP-команды dev-департамента (GitHub + filesystem)
  if starts_with(text, "/issue") then { return "dev" }
  if starts_with(text, "/ci") then { return "dev" }
  if starts_with(text, "/docs") then { return "dev" }

  // Bare keyword shortcuts (no slash)
  let lower_text = lower(text)
  if lower_text == "админ" or lower_text == "admin" then { return "admin" }

  // Russian keyword detection via proxy
  let body = json_encode({text: lower_text})
  let result = TryVal(try http_post("http://127.0.0.1:4000/detect-dept", body, "application/json"))
  if to_string(result) == "()" then { return "" }
  let detected = redact(to_string(json_get(parse_json(result), "dept", "")), "all")
  if detected != "" then { return detected }

  return ""
}

// Yana Handler v7.0: восстановлен как import dept/yana (расинлайнинг 0.23.0,
// верификация импортов — PR #352; состав см. dept/yana.mlog)

// ============================================================
// call_python — universal mlog->Python bridge (Variant B)
// Delegates to llm_proxy.py /call-python endpoint via http_post
// Whitelisted modules only — security enforced server-side
// ============================================================
pattern call_python(module: String, function: String, args_json: String) -> String {
  let body = json_encode({module: module, function: function, args: parse_json(args_json)})
  let resp = TryVal(try http_post("http://127.0.0.1:4000/call-python", body, "application/json"))
  if to_string(resp) == "()" then { return "{\"error\": \"call_python endpoint unavailable\"}" }
  return resp
}

// ============================================================
// SERVER
// ============================================================

// ── Наряд №419: нативный cron-слот ночного цикла ───────────────────────────
// Тело /cron/night переехало дословно в zero-arg паттерн NightSlot — единый
// источник для HTTP-роута (ручной/аварийный триггер) и нативного файра.
// ВНИМАНИЕ: тело содержит деструктивный SQL (chain_steps TTL/expired) —
// на 0.21 это объект грант-миграции (ценз в отчёте №419); на 0.19 легально.
pattern NightLzPhase() -> String {
  // №588 A.3/B.1: ночная фаза ЛЗ — at-most-once за дату, без доставки.
  // Ранние return вместо присваиваний в no-else if (не пробрасываются).
  // Возвращает json {line: String, failed: Float}.
  let begin = NightPhaseBegin("lz")
  if begin == "done" then {
    return json_encode({line: "ЛЗ: уже выполнялась ночью — полный отчёт в 09:10", failed: 0.0})
  }
  let _ = AuditLog("night_lz_daily", "lz", "triggering lz-daily from night cycle")
  let lz_body = json_encode({owner_id: env("OWNER_TELEGRAM_ID"), deliver: "none"})
  let lz_raw = TryVal(try http_post("http://127.0.0.1:4000/scheduler/lz-daily", lz_body, "application/json", 240.0))
  let _ = NightPhaseMark("lz")
  let lz_val = to_string(lz_raw)
  if lz_val == "()" then {
    return json_encode({line: "ЛЗ: скан недоступен — полный отчёт в 09:10", failed: 1.0})
  }
  if lz_val == "{}" then {
    return json_encode({line: "ЛЗ: скан недоступен — полный отчёт в 09:10", failed: 1.0})
  }
  let lz_scan = parse_json(to_string(json_get(parse_json(lz_val), "scan", "{}")))
  let lz_n = to_string(json_get(lz_scan, "repos_found", "?"))
  let lz_m = to_string(json_get(lz_scan, "releases_found", "?"))
  return json_encode({line: "ЛЗ: " + lz_n + " репозиториев, " + lz_m + " релизов — полный отчёт в 09:10", failed: 0.0})
}

pattern NightSlot() -> String {
  let _ = InitDB()

  // Phase: FO-027 TTL chain_steps — очистка старше 14 дней; pending/failed
  // без прогресса >24 ч → expired + Telegram-алерт владельцу
  let _ = db_execute_with_grant(grant_issue("db:delete:chain_steps", 3600.0, "once"), "DELETE FROM chain_steps WHERE created_at < datetime('now', '-14 days')")
  let expired_rows = query("SELECT chain_id, COUNT(*) AS c FROM chain_steps WHERE status IN ('pending','failed') AND updated_at < datetime('now', '-1 day') GROUP BY chain_id", [])
  let _ = db_execute("UPDATE chain_steps SET status='expired', updated_at=datetime('now') WHERE status IN ('pending','failed') AND updated_at < datetime('now', '-1 day')")
  each er in expired_rows {
    let exp_chain = redact(to_string(json_get(er, "chain_id", "?")), "all")
    let exp_count = redact(to_string(json_get(er, "c", "?")), "all")
    let _ = AuditLog("chain_expired", "system", exp_chain + " steps=" + exp_count)
    // #550 A.1: алерт — в outbox (доставка 07:15 MSK), ночью тишина
    let _ = OutboxPut("fo027", "FO-027: цепочка " + exp_chain + " истекла без прогресса >24 ч (" + exp_count + " степов) — resume: /chain continue " + exp_chain + " <query>")
  }

  // Phase 0: UA Night Cycle (Scanner → Analyzer → Grapher → Reviewer → Documenter)
  // #485 A.3: счётчик недоступных фаз — основа честного статуса в итоге
  // #550 A.2: доступ — только с внутренним hash-токеном (itok)
  // #569 A.3: явный таймаут. Замер (бенч на клоне дерева, scripts вне репо):
  // Phase 1-4 ≈ 34 с локально (доминирует cross-file calls-скан фазы 3 —
  // тысячи read_text); прод-наблюдение 19.10: Phase 3 шла 02:00:10→02:03:14
  // (~3 мин, Render CPU + INSERT'ы в транзакции). Прежний дефолт 30 с обрывал
  // mlog-клиент, пока Python-цикл ещё писал — mlog шёл к своим записям под
  // чужим локом (02:00:39 database is locked, слот упал).
  // #596 A.1: числовые таймауты http_* ограничены бинарем 1..300 с
  // (HTTP_TIMEOUT_RANGE на 600 — фаза честно падала в проде 22.10).
  // #596 A.2: UA-цикл длиннее 300 с — фоном: async=1 отвечает {"job_id"}
  // сразу, итог фазы — по статусу задания (поллинг до 25 мин), не по таймауту.
  let mut phase_fail = 0.0
  let _ = AuditLog("night_ua_cycle", "admin", "triggering UA night cycle")
  let ua_body = "{}"
  let mut ua_result = "{}"
  let ua_start = TryVal(try http_post("http://127.0.0.1:4000/admin-ua/night-cycle?itok=" + AdminUaToken() + "&async=1", ua_body, "application/json", 300.0))
  let ua_job = to_string(json_get(TryVal(try parse_json(to_string(ua_start))), "job_id", ""))
  // решения на недоверенных данных — через redact-fingerprint (№327-класс,
  // идиома dept/utils.mlog:343-352; унифицировано с PollJobStatus)
  if redact(ua_job, "hash_only") != redact("", "hash_only") and redact(ua_job, "hash_only") != redact("null", "hash_only") then {
    let ua_poll = PollJobStatus("http://127.0.0.1:4000/admin-ua/night-cycle/status", "job=" + ua_job + "&itok=" + AdminUaToken())
    let ua_state = to_string(json_get(TryVal(try parse_json(ua_poll)), "state", ""))
    if redact(ua_state, "hash_only") == redact("done", "hash_only") then {
      ua_result = to_string(json_get(TryVal(try parse_json(ua_poll)), "result", "{}"))
      if redact(ua_result, "hash_only") == redact("()", "hash_only") or redact(ua_result, "hash_only") == redact("null", "hash_only") then { ua_result = "{}" }
    }
  }
  if to_string(ua_result) == "{}" then { phase_fail = phase_fail + 1.0 }
  let ua_summary = redact(to_string(json_get(parse_json(ua_result), "summary", "UA cycle failed")), "all")

  // Phase 1: LZ Daily Report (GitHub scan → Admin)
  // №588 A.3: ЛЗ в ночи — НЕ БОЛЬШЕ ОДНОГО РАЗА за дату (NightPhaseBegin,
  // at-most-once: даже при сбое повторной попытки до завтра не будет —
  // полный отчёт всё равно приходит слотом 09:10).
  // №588 B.1: ночной прогон НЕ доставляет отчёт вообще (deliver:"none" —
  // ни outbox, ни Telegram): в ночном блоке — одна строка со счётчиками
  // скана, полный текст ЛЗ остаётся слоту 09:10 (LzDailySlot).
  // Фаза вынесена в паттерн NightLzPhase с ранними return: присваивание в
  // no-else if на уровне паттерна НЕ пробрасывает связку (семантика бинаря
  // 0.33.2, проба n588) — json-результат паттерна пробрасывается надёжно.
  let lz_phase = parse_json(NightLzPhase())
  let lz_line = to_string(json_get(lz_phase, "line", "ЛЗ: скан недоступен — полный отчёт в 09:10"))
  let phase_fail = phase_fail + to_float(json_get(lz_phase, "failed", "0"))

  // Phase 2: Memory Maintenance
  let mem_body = "{}"
  let mut mem_result = TryVal(try http_post("http://127.0.0.1:4000/memory/maintenance", mem_body, "application/json"))
  if to_string(mem_result) == "()" then { mem_result = "{}" }
  if to_string(mem_result) == "{}" then { phase_fail = phase_fail + 1.0 }
  let mem_summary = redact(to_string(json_get(parse_json(mem_result), "result", "Memory maintenance failed")), "all")

  // Phase 3: Original AdminNightCycle
  // #485 A.2: фаза под try — сбой AdminNightCycle (call_llm-фазы 3-5 внутри него
  // остаются незащищёнными по составу наряда) не убивает весь NightSlot
  let mut result = TryVal(try AdminNightCycle())
  if to_string(result) == "()" then {
    phase_fail = phase_fail + 1.0
    result = "Phase 3: недоступна (AdminNightCycle упал — детали в audit_log)"
  }
  // Phase 4: Устаревшие отделы (hermes-agent lifecycle, адаптировано под use-based сигнал)
  let stale_result = TryVal(try AdminCheckStaleDepts())
  if to_string(stale_result) == "()" then { phase_fail = phase_fail + 1.0 }
  if to_string(stale_result) == "()" then { let stale_result = "проверка не выполнена" }
  // Phase 5: Ключи и провайдеры (#486 A.3): валидность всех ключей манифеста
  // (proxy/key_health.py, дешёвые вызовы без расхода токенов); итог — в ночной отчёт
  let keys_body = "{}"
  let mut keys_result = TryVal(try http_post("http://127.0.0.1:4000/admin/keys/night-check", keys_body, "application/json", 120.0))
  let mut keys_summary = "недоступна (нет ответа от admin/keys/night-check)"
  if to_string(keys_result) == "()" then {
    phase_fail = phase_fail + 1.0
  } else {
    let keys_status = redact(to_string(json_get(parse_json(keys_result), "status", "?")), "all")
    let keys_line = redact(to_string(json_get(parse_json(keys_result), "problems_line", "")), "all")
    let keys_ok = to_string(json_get(parse_json(keys_result), "ok_count", "0"))
    let keys_total = to_string(json_get(parse_json(keys_result), "total", "0"))
    if keys_status == "ok" then {
      keys_summary = "ok (" + keys_ok + "/" + keys_total + ")"
    } else {
      keys_summary = keys_line + " — ok " + keys_ok + "/" + keys_total
    }
  }
  let result = "Phase 0: UA Analysis\n" + ua_summary + "\n\n" + result + "\n\nPhase 1-2: LZ + Memory\n" + lz_line + "\n\n" + substring(mem_summary, 0, 400) + "\n\nPhase 4: Устаревшие отделы\n" + stale_result + "\n\nPhase 5: Ключи и провайдеры\n" + keys_summary

  // ── #485 A.3: итог ночного цикла — сохранение, аудит и Telegram ──
  // Статус честный: "ok" только если все фазы ответили; иначе partial с числом.
  let mut night_status = "ok"
  if phase_fail > 0.0 then {
    night_status = "partial (недоступно фаз: " + to_string(to_int(phase_fail)) + ")"
  }
  kv_set("admin_night_summary", result)

  let frows = TryVal(try query("SELECT COUNT(*) as cnt FROM admin_findings WHERE status='open'", []))
  let mut findings_open = 0.0
  if to_string(frows) != "()" and length(frows) > 0.0 then {
    findings_open = to_float(TryVal(try json_get(get(frows, 0.0), "cnt", "0")))
  }
  let mut health_last = redact(kv_get("admin_last_health"), "all")
  if health_last == "" then {
    health_last = "?"
  }
  let mut health_num = 0.0
  let htry = TryVal(try to_int(health_last))
  if to_string(htry) != "()" then {
    health_num = to_float(htry)
  }
  let review_json = json_encode({status: night_status, summary: substring(result, 0, 400), health: health_last, findings_open: findings_open})
  let save_res = TryVal(try db_execute("INSERT INTO admin_night_reports (scan_data, review_data, health_score, findings_count) VALUES (?1, ?2, ?3, ?4)", ["night-slot", review_json, health_num, findings_open]))
  let _ = AuditLog("night_slot_done", "admin", "status=" + night_status + " health=" + health_last + " findings=" + to_string(to_int(findings_open)) + " saved=" + to_string(save_res))
  let _ = TryVal(try OutboxPut("night", "Ночная проверка: " + night_status + ", здоровье " + health_last + "/10, открытых находок: " + to_string(to_int(findings_open)) + "\n\n" + substring(result, 0, 2800)))
  return result
}

// ============================================================
// Наряд #442: веб-гвард FORGE-панели /repos/* — stateless токен ?t=.
// Токен = первые 16 hex-символов sha256(CRON_SECRET + ":repos") —
// это redact(..., "hash_only") без обёртки "[HASH:...] hex": чистый
// hex URL-safe и не задевает VM-вывод строк (проба 0.27.0: строки с
// "[HASH:" и "<" в respond режутся — substring 6..22 обходной путь).
// Один секрет с cron-роутами, но scope ":repos" делает токены
// невзаимозаменяемыми: H(CRON_SECRET) из cron-гварда панель не
// открывает, и наоборот. Raw-секрет по сети не ходит.
// Fail-closed: секрет не настроен → "fail" → 403 на все 8 роутов.
// Куда ходит токен: владелец строит ссылку однострочником (отчёт
// #442); проброс t в href-ссылки страниц не делается нарочно —
// страницы /repos/* падали в respond_html (регрессия 0.27.x,
// Metalogos-#966) — ЗАКРЫТА в 0.28.0 (№565): 1-арг форма — SSOT,
// страницы строятся (пере-пробовано при переходе, ADR-0015).
// ============================================================
pattern ReposAccessToken() -> String {
  let s = env("CRON_SECRET")
  if s == "" then { return "" }
  return substring(to_string(redact(s + ":repos", "hash_only")), 6.0, 22.0)
}

pattern ReposAccessGuard() -> String {
  let t = redact(query_param("t"), "all")
  let expected = ReposAccessToken()
  if expected == "" then { return "fail" }
  if t == expected then { return "ok" }
  return "fail"
}

mlogserver {
  port: 10001
  host: "127.0.0.1"
  middleware: [rate_limit]

  // Health
  // №422: коммит в ответе — из VERSION-файла (пишется entrypoint из RENDER_GIT_COMMIT),
  // а не захардкожен: захардкоженный хеш уводил диагностику бут-логов в сторону.
  route "/" method=GET {
    // №422: чтение как в /version — без try (try оборачивает в TryResult,
    // to_string которого замусоривает ответ); VERSION пишет entrypoint до старта
    return respond("200 Fosved Office v2 alive [" + trim(read_file("VERSION")) + "]")
  }

  route "/health" method=GET {
    let _ = InitDB()
    return respond("200 ok " + trim(read_file("VERSION")))
  }

  // Version check — call /version to verify deployed code matches git
  route "/version" method=GET {
    let auth = RequireInternalAuth()
    if auth == "unauthorized" then { return respond("401 Unauthorized") }
    let yana_src = redact(read_file("dept/yana.mlog"), "all")
    let has_anti_format = "0"
    if contains(yana_src, "КРИТИЧЕСКОЕ ПРАВИЛО ФОРМАТА") then { let has_anti_format = "1" }
    if contains(yana_src, "has_layers") then { let has_anti_format = "1" }
    return respond("200 version=" + trim(read_file("VERSION")) + " anti_format=" + has_anti_format)
  }

  // ============================================================
  // FO-026: один шаг fan-out/debate — вызывает Python-плоскость
  // /chain/fanout (ThreadPoolExecutor, параллельность по прецеденту
  // race-first-2). Диспетчеризация — ChainDispatchDept из dept/chain.mlog.
  // ============================================================
  route "/chain/step" method=POST {
    let auth = RequireInternalAuth()
    if auth == "unauthorized" then { return respond("401 Unauthorized") }
    let data = json_body()
    let dept = redact(to_string(json_get(data, "dept", "")), "all")
    let query = redact(to_string(json_get(data, "query", "")), "all")
    let chat_id = redact(to_string(json_get(data, "chat_id", "0")), "all")
    let group_id = redact(to_string(json_get(data, "group_id", "")), "all")
    let round_no = redact(to_string(json_get(data, "round", "1")), "all")
    let peer = redact(to_string(json_get(data, "peer_context", "")), "all")
    let q = query
    if peer != "" then {
      let q = query + "\n\n=== РАУНД " + round_no + ": ответ коллеги — внеси поправки или подтверди ===\n" + peer
    }
    let _ = AuditLog("chain_step", dept, "fanout group=" + group_id + " round=" + round_no)
    let result = ChainDispatchDept(dept, q, chat_id)
    // #542 A.1: контракт JSON — Python-вызыватели (routes_core:487,
    // chain_parallel:63, narad_queue:122) читают resp.json()["result"].
    // Сырой текст отдела давал «Expecting value» на проде (#542 факт 1:
    // 33d61ad, 17.10 07:04:15 UTC). json_encode поверх redact-меток —
    // прецедент соседнего JSON-маршрута /lz/telegram (аудит чист).
    return respond("200 " + json_encode({result: result}))
  }

  // ── №318: LZ→OSP мост — POST /osp/analyze ──────────────────────────────
  // Роут обещан LZ Native v2.0 (dept/lz.mlog:129,290), ранее не существовал:
  // обе стороны глотали 404 через TryVal, OSP-обогащение молча отсутствовало.
  // №376: принимаются ОБЕ формы секрета:
  //   (а) hash-form "[HASH:x16] hex" — конвенция №327/№318, так шлёт мост LZ→ОСП
  //       (dept/lz.mlog: redact(env("CRON_SECRET"),"hash_only"));
  //   (б) raw-секрет — cron-стиль (cron-job.org, serve-батарея /schedules/*).
  // История: до №376 expected строился как H(secret) и затем сравнивался как
  // H(received) vs H(expected)=H(H(secret)) — двойной хэш при неидемпотентном
  // redact (0.24/0.25) делал raw-форму непроходимой всегда (403; hash-form
  // продолжала проходить — матрица scripts/fo376_probe_auth.sh). Фикс №376:
  // сравнение против ОДНОГО H(secret): сырой секрет или его hash-форма —
  // оба вида принимает SecretMatches (одним сравнением двойных фингерпринтов).
  // #546 A.1: на call-site received обёрнут redact(..., "hash_only") —
  // one-way-redact требуется taint-валидатором (untrusted query_param не
  // решает 'if' без него, Wave 15), а "hash_only" (в отличие от "all") не
  // маскирует токен-подобные значения — рецепт Metalogos-#1317, проба 0.32.0.
  // Секрет по сети в raw-форме не ходит у моста №318; hex-тело URL-safe
  // (нет '+'/' ' — не ломается на декоде и перекодировке прокси).
  // Проба: scripts/probe318qp.{mlog,sh} (/qp2 — фиксированный паттерн) +
  // scripts/fo376_probe_auth.sh (матрица обеих форм на обоих бинарях).
  // Анализ выполняется ДО respond (может занять минуты) — вызывающая
  // сторона ставит короткий таймаут и не читает ответ; доставка результата —
  // SendTelegramReply владельцу (или chat_id из тела).
  // query="ping" — проба живости без LLM-расхода (контракт №318).
  route "/osp/analyze" method=POST {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let data = json_body()
    let query = redact(to_string(json_get(data, "query", "")), "all")
    if redact(query, "hash_only") == redact("", "hash_only") then { return respond("400 empty query") }
    if redact(query, "hash_only") == redact("ping", "hash_only") then { return respond("200 osp-analyze: ok") }
    let mut chat_id = redact(to_string(json_get(data, "chat_id", "")), "all")
    if redact(chat_id, "hash_only") == redact("", "hash_only") then { let chat_id = redact(env("OWNER_TELEGRAM_ID"), "all") }
    if redact(chat_id, "hash_only") == redact("", "hash_only") then { return respond("400 no chat_id") }
    let _ = InitDB()
    let _ = AuditLog("osp_analyze", "osp", "bridge source=" + redact(to_string(json_get(data, "source", "?")), "all") + " type=" + redact(to_string(json_get(data, "type", "")), "all") + " domain=" + redact(to_string(json_get(data, "domain", "")), "all"))
    let reply = HandleOSP(query, chat_id)
    // #401 A.1: отчёт ОСП уходит через SendReport — как у прямых запросов ОСП
    // (архив miniapp_responses + превью с кнопкой). Прямая отправка полным
    // текстом не делит сообщение: >4096 символов Telegram отклонил бы — длинный
    // отчёт через мост ЛЗ→ОСП терялся бы целиком (раньше это маскировал лимит
    // 1024 токена, #399). Остальные прямые отправки разобраны (A.2): app.mlog —
    // только блоки /admin (служебные ответы Админа; Админ по дизайну мимо
    // miniapp), dept/miniapp.mlog — собственный short-путь SendReport.
    let _ = SendReport(reply, "osp", query, "3.0", chat_id)
    return respond("200 analysis complete")
  }

  // ── #446 A.1: OSP→LZ мост — POST /lz/telegram ─────────────────────────
  // Решение владельца 2026-10-02: построить. «/osp tg» (dept/osp.mlog
  // OSPTelegramSearch) раньше ходил на несуществующий Flask-роут
  // :4000/lz/telegram — TG-поиск молча терялся (класс ошибок №1, #381).
  // Внутри — живой LZTelegramSearch (dept/lz.mlog, поиск по отслеживаемым
  // TG-каналам; база скана — lz_channels/telegram_monitor, MON-1).
  // Секрет-контракт №318 — тот же, что у /osp/analyze: hash-form
  // (redact(..., "hash_only"), URL-safe hex) или raw (cron-стиль),
  // сравнение против ОДНОГО H(secret).
  // LLM-вызов внутри LZTelegramSearch синхронный — вызывающая сторона
  // ставит таймаут 90с и читает ответ (JSON {"response": ...}).
  route "/lz/telegram" method=POST {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let data = json_body()
    let q = redact(to_string(json_get(data, "query", "")), "all")
    if redact(q, "hash_only") == redact("", "hash_only") then { return respond("400 empty query") }
    let chat_id = redact(to_string(json_get(data, "chat_id", "0")), "all")
    let _ = InitDB()
    let _ = AuditLog("lz_telegram_bridge", "lz", "osp tg-search bridge (naryad #446 A.1)")
    let result = LZTelegramSearch(q, chat_id)
    return respond(json_encode({response: result}))
  }

  // ── №376: REST /api/expert/* — восстановление обёрток (TODO dept/expert.mlog:804) ──
  // route допустим только в главном файле (в импортируемом модуле — parse
  // error, проверено пробой 25.09), поэтому обёртки живут здесь тонкими
  // диспетчерами; вся логика — в dept/expert.mlog (паттерны Expert*).
  // Auth — CRON_SECRET, обе формы (конвенция №376, как /osp/analyze).
  // reverse_proxy форвардит префикс /api/expert/ сюда (MLOG_ROUTES_PREFIXES).
  route "/api/expert/automotive" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    return respond(ExpertAutomotiveLookup(redact(query_param("query"), "all"), redact(env("OWNER_TELEGRAM_ID"), "all")))
  }

  route "/api/expert/compare" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    return respond(ExpertCompareVehicles(redact(query_param("vehicles"), "all"), redact(env("OWNER_TELEGRAM_ID"), "all")))
  }

  route "/api/expert/residual-value" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    return respond(ExpertResidualValueData(redact(query_param("vehicle"), "all"), redact(env("OWNER_TELEGRAM_ID"), "all")))
  }

  route "/api/expert/operation-cost" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    return respond(ExpertOperationCostData(redact(query_param("vehicle"), "all"), redact(env("OWNER_TELEGRAM_ID"), "all")))
  }

  route "/api/expert/chart" method=POST {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let data = json_body()
    let _ = InitDB()
    return respond(ExpertGenerateChart(redact(to_string(json_get(data, "chart_type", "")), "all"), redact(to_string(json_get(data, "vehicle", "")), "all"), redact(env("OWNER_TELEGRAM_ID"), "all")))
  }

  route "/api/expert/briefings" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    return respond(ExpertListBriefings(redact(env("OWNER_TELEGRAM_ID"), "all")))
  }

  route "/api/expert/briefing" method=POST {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let data = json_body()
    let _ = InitDB()
    return respond(ExpertCreateBriefing(redact(to_string(json_get(data, "topic", "")), "all"), redact(to_string(json_get(data, "depth", "2")), "all"), redact(env("OWNER_TELEGRAM_ID"), "all")))
  }

  // ============================================================
  // FO-035 D: веб /repos — панель проектов (стиль «Диспетчерская»,
  // узкий экран, query-роуты exact-match, ForgeEscape на всё)
  // ============================================================
  route "/repos" method=GET {
    // №442 A.2: гвард владельца — только владелец читает FORGE
    let auth = ReposAccessGuard()
    if auth != "ok" then { return respond("403 Forbidden") }
    let rows = query("SELECT slug, name, project_type, status, gate_policy, updated_at FROM forge_projects ORDER BY updated_at DESC LIMIT 50", [])
    let mut items = ""
    each r in rows {
      let slug = redact(ForgeEscape(to_string(json_get(r, "slug", ""))), "all")
      let nm = redact(ForgeEscape(to_string(json_get(r, "name", ""))), "all")
      let st = redact(ForgeEscape(to_string(json_get(r, "status", ""))), "all")
      let pt = redact(ForgeEscape(to_string(json_get(r, "project_type", ""))), "all")
      let items = items + "<li><a href='/repos/project?slug=" + slug + "'>" + nm + "</a> — " + pt + " [" + st + "]</li>"
    }
    let html = "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>Репозитории — FORGE</title><style>body{background:#EFEAE0;color:#1C1B18;font-family:'IBM Plex Sans',sans-serif;margin:0;padding:16px;max-width:480px;margin-left:auto}h1{font-family:Newsreader,serif;color:#1C1B18}.panel{background:#FBF8F2;border-radius:8px;padding:12px;margin-bottom:8px}a{color:#A8321E}ul{list-style:none;padding:0}</style></head><body><h1>Проекты FORGE</h1><div class='panel'><ul>" + items + "</ul></div></body></html>"
    return respond_html(html)
  }

  route "/repos/project" method=GET {
    // №442 A.2: гвард владельца — только владелец читает FORGE
    let auth = ReposAccessGuard()
    if auth != "ok" then { return respond("403 Forbidden") }
    let slug = redact(query_param("slug"), "all")
    let rows = query("SELECT slug, name, description, goal, project_type, gate_policy, model_combo, departments, status, updated_at FROM forge_projects WHERE slug = ? LIMIT 1", [slug])
    if length(rows) == 0.0 then { return respond("404 project not found") }
    let repos = query("SELECT name, description, github_url, commits_count, last_commit_at FROM forge_repos WHERE project_slug = ? ORDER BY created_at DESC", [slug])
    let mut rep_html = ""
    each r in repos {
      let rn = redact(ForgeEscape(to_string(json_get(r, "name", ""))), "all")
      let rep_html = redact(rep_html + "<li><a href='/repos/repo?name=" + rn + "'>" + rn + "</a> — коммитов: " + to_string(json_get(r, "commits_count", "0")) + "</li>", "all")
    }
    let html = redact("<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" + ForgeEscape(to_string(json_get(rows[0], "name", ""))) + "</title><style>body{background:#EFEAE0;color:#1C1B18;font-family:'IBM Plex Sans',sans-serif;padding:16px;max-width:480px;margin-left:auto}h1,h2{font-family:Newsreader,serif}.panel{background:#FBF8F2;border-radius:8px;padding:12px;margin-bottom:8px}a{color:#A8321E}pre{background:#FBF8F2;padding:8px;overflow-x:auto}ul{list-style:none;padding:0}</style></head><body><h1>" + ForgeEscape(to_string(json_get(rows[0], "name", ""))) + "</h1><div class='panel'><p>" + ForgeEscape(to_string(json_get(rows[0], "goal", ""))) + "</p><p>Тип: " + ForgeEscape(to_string(json_get(rows[0], "project_type", ""))) + " · Гейты: " + ForgeEscape(to_string(json_get(rows[0], "gate_policy", ""))) + " · Статус: " + ForgeEscape(to_string(json_get(rows[0], "status", ""))) + "</p></div><h2>Репозитории</h2><div class='panel'><ul>" + rep_html + "</ul></div></body></html>", "all")
    return respond_html(html)
  }

  // ── FO-038 C.1: страница задачи — гейты, этапы, прогоны, замечания, история ──
  route "/repos/task" method=GET {
    // №442 A.2: гвард владельца — только владелец читает FORGE
    let auth = ReposAccessGuard()
    if auth != "ok" then { return respond("403 Forbidden") }
    // №422: тело в ReposTaskPage() — route-исполнитель 0.21 (execute_route_body)
    // выполняет ветвления через eval_statements с чистым mut-контекстом:
    // присваивание в if/each внутри route-тела = 500. Паттерн-контур
    // исполняется штатным eval_statements_cf — семантика корректна.
    ReposTaskPage()
  }

  // решение по гейту из веба (дубль Telegram-кнопок)
  // FO-039: подъём/гашение живого превью из веба
  route "/repos/task/preview-up" method=GET {
    // №442 A.1: гвард владельца — первым делом, до любого эффекта
    let auth = ReposAccessGuard()
    if auth != "ok" then { return respond("403 Forbidden") }
    let task_id = redact(query_param("task_id"), "all")
    let rows = query("SELECT t.project_slug, p.project_type, (SELECT name FROM forge_repos WHERE project_slug = t.project_slug LIMIT 1) as repo_name, (SELECT COUNT(*) FROM forge_repos r WHERE r.project_slug = t.project_slug AND r.name LIKE '%package%') as has_pkg FROM forge_tasks t JOIN forge_projects p ON p.slug = t.project_slug WHERE t.id = ? LIMIT 1", [task_id])
    if length(rows) < 1.0 then { return respond("404 task not found") }
    let r = get(rows, 0)
    let project_slug = redact(to_string(json_get(r, "project_slug", "")), "all")
    let repo_name = redact(to_string(json_get(r, "repo_name", "")), "all")
    let ptype = redact(to_string(json_get(r, "project_type", "")), "all")
    let cmd = "python3 -m http.server"
    if ptype == "ai_office" then { let cmd = "python3 app.py" }
    let result = ForgePreviewUp(project_slug, repo_name, cmd)
    return respond("<html><head><meta charset='utf-8'></head><body style='font-family:sans-serif;background:#1a1a2e;color:#eee'>" + ForgeEscape(substring(result, 0.0, 500)) + " <a href='/repos/task?task_id=" + task_id + "' style='color:#8ab'>← задача</a></body></html>")
  }

  route "/repos/task/preview-down" method=GET {
    // №442 A.1: гвард владельца — первым делом, до любого эффекта
    let auth = ReposAccessGuard()
    if auth != "ok" then { return respond("403 Forbidden") }
    let slug = redact(query_param("slug"), "all")
    let result = ForgePreviewDown(slug)
    return respond("<html><head><meta charset='utf-8'></head><body style='font-family:sans-serif;background:#1a1a2e;color:#eee'>" + ForgeEscape(result) + "</body></html>")
  }

  route "/repos/task/decide" method=GET {
    // №442 A.1: гвард владельца — первым делом, до любого эффекта
    let auth = ReposAccessGuard()
    if auth != "ok" then { return respond("403 Forbidden") }
    let gate = redact(query_param("gate"), "all")
    let idx = redact(query_param("idx"), "all")
    let result = ForgeGateDecide(gate, idx, "owner-web")
    return respond("<html><head><meta charset='utf-8'></head><body style='font-family:sans-serif;background:#1a1a2e;color:#eee'>" + ForgeEscape(substring(result, 0.0, 400)) + "</body></html>")
  }

  route "/repos/repo" method=GET {
    // №442 A.2: гвард владельца — только владелец читает FORGE
    let auth = ReposAccessGuard()
    if auth != "ok" then { return respond("403 Forbidden") }
    let name = redact(query_param("name"), "all")
    let files_out = ForgeRepoFiles(name, "main")
    let commits_out = ForgeCommits(name, "20")
    let html = "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" + ForgeEscape(name) + "</title><style>body{background:#EFEAE0;color:#1C1B18;font-family:'IBM Plex Sans',sans-serif;padding:16px;max-width:480px;margin-left:auto}h1,h2{font-family:Newsreader,serif}.panel{background:#FBF8F2;border-radius:8px;padding:12px;margin-bottom:8px}pre{background:#FBF8F2;padding:8px;overflow-x:auto;font-size:12px}</style></head><body><h1>" + ForgeEscape(name) + "</h1><h2>Дерево (main)</h2><div class='panel'><pre>" + ForgeEscape(files_out) + "</pre></div><h2>Коммиты</h2><div class='panel'><pre>" + ForgeEscape(commits_out) + "</pre></div></body></html>"
    return respond_html(html)
  }

  route "/repos/file" method=GET {
    // №442 A.2: гвард владельца — только владелец читает FORGE
    let auth = ReposAccessGuard()
    if auth != "ok" then { return respond("403 Forbidden") }
    let name = redact(query_param("name"), "all")
    let refv = redact(query_param("ref"), "all")
    let path = redact(query_param("path"), "all")
    let rv = ForgeValidRef(refv)
    if rv != "ok" then { return respond("400 " + rv) }
    let vp = ForgeValidPath(path)
    if vp != "ok" then { return respond("400 " + vp) }
    let content = ForgeReadFile(name, refv, path)
    let html = "<!doctype html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width, initial-scale=1'><title>" + ForgeEscape(path) + "</title><style>body{background:#EFEAE0;color:#1C1B18;font-family:'IBM Plex Sans',sans-serif;padding:16px;max-width:480px;margin-left:auto}h1{font-family:Newsreader,serif}pre{background:#FBF8F2;padding:8px;overflow-x:auto;font-size:12px;white-space:pre-wrap}</style></head><body><h1>" + ForgeEscape(path) + " @" + ForgeEscape(refv) + "</h1><pre>" + ForgeEscape(content) + "</pre></body></html>"
    return respond_html(html)
  }

  // ============================================================
  // WEBHOOK — Telegram
  // ============================================================

  route "/webhook/telegram" method=POST {
    // №422: тело в WebhookBody() — причина та же, см. /repos/task;
    // respond()-ответы перехватываются ExprStmt-рукой route-исполнителя.
    WebhookBody()
  }

  // ============================================================
  // CRON ENDPOINTS (8) — all require CRON_SECRET
  // ============================================================

  // Morning Brief — 07:20 MSK (4:20 UTC) — Yana: дата, время, погода, офис, мировые события
  route "/cron/morning" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = MorningBrief()
    let _ = YanaSelfLearn()
    return respond("200 ok")
  }

  route "/cron/evening" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = EveningSummary()
    return respond("200 ok")
  }

  route "/cron/weekly" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = WeeklyDigest()
    return respond("200 ok")
  }

  route "/cron/monthly" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = MonthlyReview()
    return respond("200 ok")
  }

  route "/cron/control" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let _ = ControlCheck()
    return respond("200 ok")
  }

  route "/cron/night" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    // №419: логика переехала дословно в паттерн NightSlot (нативный cron-слот,
    // реестр dept/schedules.mlog). Роут остаётся ручным/аварийным триггером —
    // дедуп окон №418 делает двойной запуск безопасным.
    let _ = NightSlot()
    return respond("200 ok")
  }

  route "/cron/lz-daily" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = AuditLog("cron_lz_daily", "lz", "LZ daily scan triggered by cron")
    let body = json_encode({owner_id: env("OWNER_TELEGRAM_ID")})
    let result = TryVal(try http_post("http://127.0.0.1:4000/scheduler/lz-daily", body, "application/json", 240.0))
  }

  // F-2: Reminder delivery cron — called every 5 minutes by external scheduler
  route "/cron/reminders" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let result = DeliverDueReminders()
    return respond("200 " + result)
  }

  // Diagnostic: read last checkpoint trail from trace_log (FO-007: чекпоинты больше не в audit_log)
  // After a Block C crash, curl this to see exactly which step failed
  // FO-039 B.3: sweep живых превью — гашение по 30 минутам тишины
  route "/cron/preview-sweep" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let result = ForgePreviewSweep()
    let _ = AuditLog("cron_preview_sweep", "scheduler", result)
    return respond("200 ok: " + result)
  }

  route "/cron/last-checkpoints" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let rows = query("SELECT id, timestamp, details FROM trace_log WHERE action = 'checkpoint' ORDER BY id DESC LIMIT 20", [])
    let out = ""
    each row in rows {
      let rid = redact(to_string(json_get(row, "id", "?")), "all")
      let rts = redact(to_string(json_get(row, "timestamp", "?")), "all")
      let rdt = redact(to_string(json_get(row, "details", "?")), "all")
      let out = out + "[" + rid + "] " + rts + " — " + rdt + "\n"
    }
    if out == "" then { return respond("200 No checkpoints found") }
    return respond("200 " + out)
  }

  // Admin morning reply — 7:25 MSK (4:25 UTC) — response to Yana's morning brief
  route "/cron/admin-reply" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = AuditLog("cron_admin_reply", "admin", "admin morning reply triggered by cron")
    let body = json_encode({owner_id: env("OWNER_TELEGRAM_ID")})
    let result = TryVal(try http_post("http://127.0.0.1:4000/scheduler/admin-morning-reply", body, "application/json", 240.0))
    return respond("200 ok")
  }

  // ── #255: недостающие cron-роуты (исполнитель — внешний крон cron-job.org) ──

  // SHOP-4 tick: WB/Ozon вотчи каждые 6 ч (покрывает и daily watch-sweep из старой
  // спецификации). Kill-switch SHOP_ENABLED=0 — роут молча отвечает ok.
  route "/cron/shop-tick" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    if env("SHOP_ENABLED") != "1" then { return respond("200 ok (SHOP_ENABLED != 1 — skip)") }
    let _ = AuditLog("cron_shop_tick", "shop", "shop-tick triggered by cron")
    let result = TryVal(try http_post("http://127.0.0.1:4000/scheduler/watch-sweep", "{}", "application/json", 240.0))
    return respond("200 ok")
  }

  // FO-005: golden evals — ночная регрессия качества → алерт при деградации
  route "/cron/golden-evals" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = AuditLog("cron_golden_evals", "qa", "golden evals triggered by cron")
    let result = TryVal(try http_post("http://127.0.0.1:4000/scheduler/golden-evals", "{}", "application/json", 240.0))
    return respond("200 ok")
  }

  // Индикаторы с verifyDate ≤ 7 дней — превентивное напоминание до утреннего брифа
  route "/cron/indicator-reminders" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = AuditLog("cron_indicator_reminders", "system", "indicator pre-reminders triggered by cron")
    let body = json_encode({days_ahead: 7})
    let result = TryVal(try http_post("http://127.0.0.1:4000/scheduler/indicator-pre-reminders", body, "application/json", 240.0))
    return respond("200 ok")
  }

  // FO-001: ежедневный cron-бэкап главной БД. VACUUM INTO требует несуществующий
  // файл — уникальное имя через strftime; ретеншн по-прежнему на startup (entrypoint).
  route "/cron/backup" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let _ = InitDB()
    let ts_rows = query("SELECT strftime('%Y%m%dT%H%M%SZ', 'now') AS t", [])
    let ts = "unknown"
    each r in ts_rows {
      let ts = redact(to_string(json_get(r, "t", "unknown")), "all")
    }
    let path = "/var/data/backups/fosved.db." + ts
    let _ = db_execute("VACUUM INTO ?", [path])
    let check_rows = query("PRAGMA integrity_check", [])
    let integrity = "no-result"
    each cr in check_rows {
      let integrity = redact(to_string(json_get(cr, "integrity_check", "no-result")), "all")
    }
    let _ = AuditLog("cron_backup", "system", path + " integrity=" + integrity)
    return respond("200 backup ok: " + path)
  }

  // ── #255, консолидация 2026-09-21: ночная корзина ──
  // cron-job.org (free) ограничивает число задач → вместо шести отдельных задач
  // владелец держит ОДНУ на /cron/night-tick. Диспетчер сам обходит существующие
  // /cron/* роуты по порядку: backup → indicator-reminders → shop-tick →
  // golden-evals → night (UA + lz-daily + memory + AdminNightCycle).
  // Тайм-аут cron-job.org (~30 c) безвреден: сервер доделывает цепочку в фоне
  // (прецедент — Morning Brief). Итог цепочки — одним сообщением в Telegram.
  route "/cron/night-tick" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    // #546 A.1: let cron_secret возвращён — NightTickCore(cron_secret) ниже
    // по сигнатуре требует аргумент (сам паттерн читает env, см. №485).
    let cron_secret = env("CRON_SECRET")
    // №422: хвост в NightTickCore() — причина та же, см. /repos/task.
    NightTickCore(cron_secret)
  }

  // ── Наряд №419: живая поверхность реестра заданий (нативный стор cron) ──
  // Авторизация — тот же CRON_SECRET-гвард, что у /cron/* (существующее
  // доверенное домено планирования; ротация секрета накрывает и эти роуты).
  // На 0.19-фолбэке роуты парсятся, но 4-аргументный cron_add/таймзоны —
  // контракт 0.21: create/bootstrap ответят ошибкой времени исполнения.
  // list/remove/чтение — безопасны на обоих бинарях.
  route "/schedules/list" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let jobs = cron_list()
    let registry = SchedulesRegistry()
    return respond("200 " + json_encode({jobs: jobs, registry: registry}))
  }

  // Ручной ре-запуск бутстрапа реестра (идемпотентен по target; громкий
  // отчёт: ADD/REPLACE/KEEP/REMOVE/ONESHOT/EXTERNAL/FAIL — entrypoint
  // громко ругается на FAIL(...), AuditLog пишет отчёт всегда).
  route "/schedules/bootstrap" method=GET {
    let secret = redact(query_param("secret"), "hash_only")
    // #428 A.1: две разные причины отказа были неразличимы в бут-логе
    // (одинаковое 403 Forbidden). Код причины — литерал, значение секрета
    // в ответ не попадает ни в каком виде. Имена кодов — без слова secret:
    // аудитор 0.27.0 помечает respond-литералы со словом secret как
    // секретоподобные (sink clearance violation), проверено бисекцией.
    // #546 A.1: сравнение — SecretMatches (hash_only, рецепт Metalogos-#1317).
    if env("CRON_SECRET") == "" then { return respond("403 cron_key_unset") }
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 key_mismatch") }
    let _ = InitDB()
    let report = BootstrapSchedules()
    return respond("200 " + report)
  }

  // Создать задание поверх нативного стора (без рестарта). Новые задания
  // через этот роут — сознательное действие владельца (админ-домен).
  // Валидация: target обязан быть известным zero-arg паттерном (inspect),
  // cron-выражение обязано быть непустым; битое выражение громко отвергнет
  // сам cron_add (CRON_JOB_FAILED-контракт №418/№413).
  route "/schedules/create" method=POST {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let data = json_body()
    let cron_expr = redact(to_string(json_get(data, "cron", "")), "all")
    let target = redact(to_string(json_get(data, "target", "")), "all")
    let tz = redact(to_string(json_get(data, "tz", "Europe/Moscow")), "all")
    let catch_up = redact(to_string(json_get(data, "catch_up", "run_once")), "all")
    let probe = inspect(target)
    // №327: решения на недоверенных данных (json_body/inspect) — через
    // one-way redact-hash (ADR-0161 sanctioned path); детерминированный хеш
    // сохраняет семантику равенства.
    if redact(to_string(probe), "hash_only") == redact("()", "hash_only") then { return respond("400 unknown target pattern") }
    if redact(cron_expr, "hash_only") == redact("", "hash_only") then { return respond("400 empty cron expression") }
    let _ = InitDB()
    let created_job = cron_add(cron_expr, target, tz, catch_up)
    let job_id = redact(to_string(json_get(created_job, "id", "?")), "all")
    let _ = AuditLog("schedules_create", "scheduler", target + " -> " + job_id)
    return respond("200 created " + job_id)
  }

  route "/schedules/remove" method=POST {
    let secret = redact(query_param("secret"), "hash_only")
    if SecretMatches(secret, "CRON_SECRET") == false then { return respond("403 Forbidden") }
    let data = json_body()
    let job_id = redact(to_string(json_get(data, "id", "")), "all")
    if redact(job_id, "hash_only") == redact("", "hash_only") then { return respond("400 missing id") }
    let _ = InitDB()
    let rm = cron_remove(job_id)
    let n = to_float(redact(to_string(json_get(rm, "removed", 0.0)), "all"))
    let _ = AuditLog("schedules_remove", "scheduler", job_id + " -> removed=" + to_string(n))
    if redact(to_string(n), "hash_only") == redact(to_string(0.0), "hash_only") then { return respond("404 job not found") }
    return respond("200 removed " + job_id)
  }
}

// ── №422: тела route-ов перенесены в паттерны ─────────────────────
// Причина: execute_route_body (server.rs, 0.21.0) исполняет statement-ы
// тела роута самодельным циклом и ветвления (if/each) — через
// eval_statements с НОВЫМ mutable_vars на каждый вызов: let mut из тела
// роута теряется, присваивание в ветке даёт "cannot assign to immutable
// variable" => 500. В паттерн-контуре семантика штатная (eval_statements_cf,
// mut-контекст сквозной). Апстрим-репорт: bugs «route executor mut context».

pattern ReposTaskPage() -> String {
    let task_id = redact(query_param("task_id"), "all")
    let rows = query("SELECT t.title, t.status, t.project_slug, p.name FROM forge_tasks t JOIN forge_projects p ON p.slug = t.project_slug WHERE t.id = ? LIMIT 1", [task_id])
    if length(rows) < 1.0 then { return respond("404 task not found") }
    let t = get(rows, 0)
    let mut html = "<html><head><meta charset='utf-8'><title>Задача " + task_id + "</title></head><body style='font-family:sans-serif;background:#1a1a2e;color:#eee;padding:16px'>"
    html = html + "<h1>" + ForgeEscape(to_string(json_get(t, "name", ""))) + " — задача " + task_id + "</h1>"
    html = html + "<p>" + ForgeEscape(to_string(json_get(t, "title", ""))) + " [" + ForgeEscape(to_string(json_get(t, "status", ""))) + "]</p>"
    // активный гейт с кнопками-ссылками (дубль Telegram)
    let gates = query("SELECT id, kind, question, options_json, decision FROM forge_gates WHERE task_id = ? ORDER BY id DESC LIMIT 10", [task_id])
    html = html + "<h2>Гейты</h2><ul>"
    each g in gates {
      let gid = redact(to_string(json_get(g, "id", "")), "all")
      let dec = redact(to_string(json_get(g, "decision", "")), "all")
      let dec_mark = "<b>ждёт решения</b> "
      if dec != "" then { let dec_mark = "решён: " + ForgeEscape(dec) + " " }
      html = html + "<li>#" + gid + " [" + ForgeEscape(to_string(json_get(g, "kind", ""))) + "] " + ForgeEscape(substring(to_string(json_get(g, "question", "")), 0, 120)) + " — " + dec_mark
      if dec == "" then {
        let opts = parse_json(to_string(json_get(g, "options_json", "[]")))
        each o in opts {
          let html = redact(html + "<a href='/repos/task/decide?task_id=" + task_id + "&gate=" + gid + "&idx=" + to_string(json_get(o, "idx", "")) + "'>[" + ForgeEscape(to_string(json_get(o, "label", ""))) + "]</a> ", "all")
        }
      }
      let html = html + "</li>"
    }
    html = html + "</ul>"
    // план этапов с отметками
    let stages = query("SELECT id, seq, title, status, commit_tag FROM forge_stages WHERE task_id = ? ORDER BY seq", [task_id])
    html = html + "<h2>Этапы</h2><ul>"
    each st in stages {
      html = html + "<li>" + to_string(json_get(st, "seq", "")) + ". " + ForgeEscape(to_string(json_get(st, "title", ""))) + " [" + ForgeEscape(to_string(json_get(st, "status", ""))) + "] " + ForgeEscape(to_string(json_get(st, "commit_tag", ""))) + "</li>"
    }
    html = html + "</ul>"
    // логи прогонов (последние 5)
    let runs = query("SELECT command, exit_code, output, created_at FROM forge_runs WHERE stage_id IN (SELECT id FROM forge_stages WHERE task_id = ?) ORDER BY id DESC LIMIT 5", [task_id])
    html = html + "<h2>Прогоны</h2><ul>"
    each r in runs {
      html = html + "<li><code>" + ForgeEscape(substring(to_string(json_get(r, "command", "")), 0, 60)) + "</code> → exit " + ForgeEscape(to_string(json_get(r, "exit_code", ""))) + " <small>" + ForgeEscape(substring(to_string(json_get(r, "output", "")), 0, 100)) + "</small></li>"
    }
    html = html + "</ul>"
    // замечания + история решений по находкам
    let remarks = query("SELECT id, text, kind, status, resolved_by_commit FROM forge_remarks WHERE task_id = ? ORDER BY id DESC LIMIT 10", [task_id])
    html = html + "<h2>Замечания</h2><ul>"
    each r in remarks {
      html = html + "<li>#" + to_string(json_get(r, "id", "")) + " [" + ForgeEscape(to_string(json_get(r, "kind", ""))) + "/" + ForgeEscape(to_string(json_get(r, "status", ""))) + "] " + ForgeEscape(substring(to_string(json_get(r, "text", "")), 0, 140)) + " " + ForgeEscape(to_string(json_get(r, "resolved_by_commit", ""))) + "</li>"
    }
    html = html + "</ul>"
    let decs = query("SELECT finding_text, decision, decided_at FROM forge_finding_decisions WHERE task_id = ? ORDER BY id DESC LIMIT 15", [task_id])
    html = html + "<h2>История решений по находкам</h2><ul>"
    each d in decs {
      html = html + "<li>[" + ForgeEscape(to_string(json_get(d, "decision", ""))) + "] " + ForgeEscape(substring(to_string(json_get(d, "finding_text", "")), 0, 140)) + " <small>" + ForgeEscape(to_string(json_get(d, "decided_at", ""))) + "</small></li>"
    }
    html = html + "</ul>"
    // FO-039: живое превью по требованию
    let prevs = query("SELECT slug, status, port FROM forge_previews WHERE repo_name IN (SELECT name FROM forge_repos WHERE project_slug = (SELECT project_slug FROM forge_tasks WHERE id = ? LIMIT 1)) ORDER BY started_at DESC LIMIT 3", [task_id])
    html = html + "<h2>Живое превью</h2><ul>"
    each pv in prevs {
      let pv_slug = redact(to_string(json_get(pv, "slug", "")), "all")
      let pv_status = redact(to_string(json_get(pv, "status", "")), "all")
      if pv_status == "running" then {
        html = html + "<li><a href='/preview-live/" + pv_slug + "/' style='color:#8f8'>открыть</a> [" + pv_status + "] порт " + to_string(json_get(pv, "port", "")) + " <a href='/repos/task/preview-down?slug=" + pv_slug + "'>погасить</a></li>"
      } else {
        html = html + "<li>[" + pv_status + "] — поднять снова кнопкой</li>"
      }
    }
    let html = html + "</ul><p><a href='/repos/task/preview-up?task_id=" + task_id + "' style='color:#fc6'>▶ Поднять превью</a> (команда из белого списка по типу проекта)</p>"
    html = html + "<p><a href='/repos/project?slug=" + ForgeEscape(to_string(json_get(t, "project_slug", ""))) + "' style='color:#8ab'>← проект</a></p></body></html>"
    return respond(html)
}

pattern WebhookBody() -> String {
    let data = json_body()
    let _sp = " "
    let chat_id = redact(to_string(json_get(data, "message.chat.id", "0")), "all")
    let user_id = redact(to_string(json_get(data, "message.from.id", "0")), "all")
    let owner_id = env("OWNER_TELEGRAM_ID")
    // Owner check — ignore non-owner
    if user_id != owner_id then { return respond("200 ok") }

    // Idempotency: игнорируем быстрый повтор (в пределах 90 с), пропускаем медленный ретрай (WH-3)
    let update_id = redact(to_string(json_get(data, "update_id", "")), "all")
    if update_id != "" then {
      let recent = query("SELECT COUNT(*) AS c FROM webhook_dedup WHERE update_id = ? AND seen_at > datetime('now', '-90 seconds')", [update_id])
      let recent_count = to_float(json_get(recent[0], "c", "0"))
      if recent_count > 0.0 then { return respond("200 ok") }
      let _ = TryVal(try db_execute("INSERT OR REPLACE INTO webhook_dedup (update_id, seen_at) VALUES (?, datetime('now'))", [update_id]))
      let _ = TryVal(try db_execute_with_grant(grant_issue("db:delete:webhook_dedup", 3600.0, "once"), "DELETE FROM webhook_dedup WHERE seen_at < datetime('now', '-1 day')"))
    }

    // №421: сырой текст — ТОЛЬКО для извлечения пароля (/lockdown, /unlock);
    // пароль сравнивается через hash_only (равенство хешей ⟺ равенство строк,
    // immune к redact-маскированию ввода). Во все остальные ветки идёт
    // вымытый text.
    let raw_text = to_string(json_get(data, "message.text", ""))
    // Lockdown check
    let locked = kv_get("system_lockdown")
    if locked == "true" then {
      let mut text = redact(to_string(json_get(data, "message.text", "")), "all")
      if starts_with(text, "/unlock") then {
        let parts = split(raw_text, _sp)
        let password = ""
        // №421: счётчик токенов — по вымытой копии (маски без пробелов →
        // количество частей идентично); сам пароль — из сырого текста
        if length(split(redact(raw_text, "all"), _sp)) > 1.0 then { let password = get(parts, 1.0) }
        let stored_pwd = kv_get("lockdown_password")
        if redact(password, "hash_only") == redact(stored_pwd, "hash_only") or redact(password, "hash_only") == redact(env("LOCKDOWN_PASSWORD"), "hash_only") then {
          kv_set("system_lockdown", "false")
          let _ = SendTelegramReply(chat_id, "Lockdown disabled. Office is operational.")
          let _ = AuditLog("unlock", "system", "owner unlocked office")
          return respond("200 ok")
        }
      }
      return respond("200 ok")
    }

    // Voice check — STT via Python proxy
    // Detect voice via json_get (dot notation works reliably), not has_field
    let text = ""
    let voice_file_id = redact(to_string(json_get(data, "message.voice.file_id", "")), "all")
    if voice_file_id != "" then {
      let _ = AuditLog("voice_received", "voice", "file_id: " + voice_file_id)
      let stt_body = json_encode({file_id: voice_file_id})
      let stt_result = TryVal(try http_post("http://127.0.0.1:4000/stt", stt_body, "application/json"))
      if redact(to_string(stt_result), "hash_only") == redact("()", "hash_only") then {
        let _ = SendTelegramReply(chat_id, "Ошибка распознавания: STT-прокси недоступен.")
        return respond("200 ok")
      } else {
        let _ = AuditLog("stt_raw_response", "voice", substring(stt_result, 0.0, 300.0))
        let stt_parsed = parse_json(stt_result)
        let stt_status = redact(to_string(json_get(stt_parsed, "status", "error")), "all")
        if stt_status == "ok" then {
          let transcribed = redact(to_string(json_get(stt_parsed, "text", "")), "all")
          if transcribed != "" then {
            let _ = SendTelegramReply(chat_id, "Распознано: " + transcribed)
            let text = transcribed
          } else {
            let _ = SendTelegramReply(chat_id, "Не удалось распознать голосовое сообщение. Пустой результат от STT.")
            return respond("200 ok")
          }
        } else {
          let stt_err = redact(to_string(json_get(stt_parsed, "message", "неизвестная ошибка")), "all")
          let _ = SendTelegramReply(chat_id, "Ошибка распознавания: " + stt_err)
          return respond("200 ok")
        }
      }
    } else {
      let doc_file_id = redact(to_string(json_get(data, "message.document.file_id", "")), "all")
      if doc_file_id != "" then {
        let doc_name = redact(to_string(json_get(data, "message.document.file_name", "file")), "all")
        let doc_mime = redact(to_string(json_get(data, "message.document.mime_type", "")), "all")
        let caption = redact(to_string(json_get(data, "message.caption", "")), "all")
        let _ = AuditLog("document_received", "document", "name=" + doc_name + " mime=" + doc_mime)

        // НАРЯД №48: PDF-роутинг через нативный pdf_classify
        if contains(doc_mime, "application/pdf") or ends_with(lower(doc_name), ".pdf") then {
          let _ = SendTelegramReply(chat_id, "PDF получен: " + doc_name + ". Классифицирую и извлекаю текст.")
          // Скачиваем файл через Telegram File API → proxy
          let token = TgToken()
          let file_info = TryVal(try http_post("https://api.telegram.org/bot" + token + "/getFile", json_encode({file_id: doc_file_id}), "application/json"))
          if redact(to_string(file_info), "hash_only") == redact("()", "hash_only") then {
            let _ = SendTelegramReply(chat_id, "Ошибка: не удалось получить информацию о файле.")
            return respond("200 ok")
          }
          let file_parsed = parse_json(file_info)
          let file_path = redact(to_string(json_get(file_parsed, "result.file_path", "")), "all")
          if file_path == "" then {
            let _ = SendTelegramReply(chat_id, "Ошибка: файл недоступен (истёк срок).")
            return respond("200 ok")
          }
          // Скачиваем binary через proxy (base64-кодированный)
          let dl_body = json_encode({file_path: file_path})
          let dl_result = TryVal(try http_post("http://127.0.0.1:4000/download-telegram-file", dl_body, "application/json", 120.0))
          // НАРЯД #365 A.2: неудача скачивания — не выход, а запасной путь
          // /extract-document. «Не удалось» — только если отказал и он.
          let mut pdf_b64 = ""
          if redact(to_string(dl_result), "hash_only") != redact("()", "hash_only") then {
            let dl_parsed = parse_json(dl_result)
            pdf_b64 = redact(to_string(json_get(dl_parsed, "data", "")), "all")
          }
          if pdf_b64 == "" then {
            // Fallback: используем старый extract-document
            let _ = SendTelegramReply(chat_id, "PDF получен. Извлекаю текст через прокси...")
            let doc_body = json_encode({file_id: doc_file_id, file_name: doc_name})
            let doc_result = TryVal(try http_post("http://127.0.0.1:4000/extract-document", doc_body, "application/json", 120.0))
            if redact(to_string(doc_result), "hash_only") == redact("()", "hash_only") then {
              let _ = SendTelegramReply(chat_id, "Ошибка: сервис извлечения текста недоступен.")
              return respond("200 ok")
            }
            let doc_parsed = parse_json(doc_result)
            let extracted = redact(to_string(json_get(doc_parsed, "text", "")), "all")
            text = caption + "\n\n=== PDF: " + doc_name + " ===\n" + extracted
            // text устанавливается, продолжаем к маршрутизации департамента
          } else {
            // Нативная классификация через pdf_classify builtin
            let pdf_info = TryVal(try pdf_classify(pdf_b64))
            let pdf_type = redact(to_string(json_get(pdf_info, "type", "unknown")), "all")
            let pdf_needs_ocr = redact(to_string(json_get(pdf_info, "needs_ocr", "0")), "all")
            let pdf_pages = redact(to_string(json_get(pdf_info, "pages", "0")), "all")

            let _ = AuditLog("pdf_classified", "document", "type=" + pdf_type + " pages=" + pdf_pages + " needs_ocr=" + pdf_needs_ocr)

            // Извлекаем текст нативно
            let md_result = TryVal(try pdf_to_markdown(pdf_b64))
            let md_text = redact(to_string(json_get(md_result, "markdown", "")), "all")
            let ocr_pages_count = redact(to_string(json_get(md_result, "pages_needing_ocr", "0")), "all")

            // Если есть страницы требующие OCR — пробуем pdf_ocr
            if pdf_needs_ocr == "1" then {
              let ocr_result = TryVal(try pdf_ocr(pdf_b64))
              let ocr_markdown = redact(to_string(json_get(ocr_result, "markdown", "")), "all")
              let ocr_confidence = redact(to_string(json_get(ocr_result, "ocr_confidence", "0")), "all")
              let _ = SendTelegramReply(chat_id, "PDF: " + pdf_type + ", " + pdf_pages + " стр. OCR: " + ocr_pages_count + " стр. (confidence: " + ocr_confidence + "%)")
              // Заменяем [OCR_NEEDED] плейсхолдеры на OCR-результат
              text = caption + "\n\n=== PDF: " + doc_name + " ===\n" + md_text + "\n\n--- OCR ---\n" + ocr_markdown
            } else {
              let _ = SendTelegramReply(chat_id, "PDF: " + pdf_type + ", " + pdf_pages + " стр. Текст извлечён.")
              text = caption + "\n\n=== PDF: " + doc_name + " ===\n" + md_text
            }
          }
        } else {
          // Не PDF — используем старый extract-document прокси
          let _ = SendTelegramReply(chat_id, "Файл получен: " + doc_name + ". Извлекаю текст.")
          let doc_body = json_encode({file_id: doc_file_id, file_name: doc_name})
          let doc_result = TryVal(try http_post("http://127.0.0.1:4000/extract-document", doc_body, "application/json", 120.0))
          if redact(to_string(doc_result), "hash_only") == redact("()", "hash_only") then {
            let _ = SendTelegramReply(chat_id, "Ошибка: сервис извлечения текста недоступен.")
            return respond("200 ok")
          } else {
            let doc_parsed = parse_json(doc_result)
            let doc_status = redact(to_string(json_get(doc_parsed, "status", "error")), "all")
            if doc_status == "ok" then {
              let extracted = redact(to_string(json_get(doc_parsed, "text", "")), "all")
              let was_cut = redact(to_string(json_get(doc_parsed, "truncated", "false")), "all")
              if was_cut == "true" then {
                let _ = SendTelegramReply(chat_id, "Файл длинный, взяты первые 60000 символов.")
              }
              if caption != "" then {
                text = caption + "\n\n=== Вложенный файл: " + doc_name + " ===\n" + extracted
              } else {
                let text = extracted
              }
            } else {
              let doc_err = redact(to_string(json_get(doc_parsed, "message", "неизвестная ошибка")), "all")
              let _ = SendTelegramReply(chat_id, "Не удалось прочитать файл: " + doc_err)
              return respond("200 ok")
            }
          }
        }
      } else {
        let text = redact(to_string(json_get(data, "message.text", "")), "all")
      }
    }

    // web_app_data handler (Mini App actions) — detect via json_get, not has_field
    // MUST be before empty-text guard: web_app_data payloads have empty message.text
    let payload_raw = redact(to_string(json_get(data, "message.web_app_data.data", "")), "all")
    if payload_raw != "" then {
      let _ = HandleMiniAppAction(payload_raw, chat_id)
      let _ = AuditLog("web_app_data", "miniapp", payload_raw)
      return respond("200 ok")
    }

    if text == "" then { return respond("200 ok") }

    // FO-038 B.1: ответ владельца на сообщение гейта/показа = замечание
    let reply_id = redact(to_string(json_get(data, "message.reply_to_message.message_id", "0")), "all")
    if reply_id != "0" then {
      // №587 A.3: ответ на force_reply-промпт оценки — комментарий к «−»
      let rt_rows = query("SELECT id, dept, ref, chat_id FROM reply_ratings WHERE prompt_message_id = ?1 AND vote = -1 AND comment IS NULL", [reply_id])
      if redact(to_string(rt_rows), "hash_only") != redact("()", "hash_only") and length(rt_rows) > 0.0 then {
        let rt_r = get(rt_rows, 0)
        let rt_rid = redact(to_string(json_get(rt_r, "id", "0")), "all")
        let rt_dept = redact(to_string(json_get(rt_r, "dept", "global")), "all")
        let rt_ref = redact(to_string(json_get(rt_r, "ref", "")), "all")
        let rt_chat = redact(to_string(json_get(rt_r, "chat_id", "")), "all")
        let rt_comment = ""
        if text != "-" then { let rt_comment = substring(text, 0.0, 2000.0) }
        let _ = db_execute("UPDATE reply_ratings SET comment = ?1, voted_at = datetime('now') WHERE id = ?2", [rt_comment, rt_rid])
        // коррекция — как /fix, но привязанная к конкретному ответу (№587 A.3)
        let rt_query = ""
        if rt_ref != "" then {
          let qrows = query("SELECT query FROM miniapp_responses WHERE id = ?1", [rt_ref])
          each qr in qrows { let rt_query = redact(to_string(json_get(qr, "query", "")), "all") }
        }
        if rt_query == "" then {
          let uq = query("SELECT content FROM dialog_history WHERE chat_id = ?1 AND role = 'user' ORDER BY id DESC LIMIT 1", [rt_chat])
          each ur in uq { let rt_query = redact(to_string(json_get(ur, "content", "")), "all") }
        }
        let _ = db_execute("INSERT INTO adapt_corrections (dept, original_query, original_response, correction, corr_type) VALUES (?1, ?2, ?3, ?4, 'manual')", [rt_dept, substring(rt_query, 0.0, 2000.0), substring(rt_ref, 0.0, 200.0), substring(rt_comment, 0.0, 2000.0)])
        let _ = AuditLog("rating_comment", rt_dept, "rating=" + rt_rid + " comment=" + substring(rt_comment, 0.0, 80.0))
        let _ = SendTelegramReply(chat_id, "Коррекция записана для " + rt_dept + " (оценка №" + rt_rid + ").")
        return respond("200 ok")
      }
      let remark_check = TryVal(try query("SELECT id FROM forge_gates WHERE telegram_message_id = ? LIMIT 1", [reply_id]))
      // №421: remark_check (результат query) не моется целиком — List;
      // пустота проверяется hash-сравнением канонической формы "()" (то же
      // множество значений, что и length()>0: rows непуст ⟺ to_string ≠ "()")
      if redact(to_string(remark_check), "hash_only") != redact("()", "hash_only") and length(redact(to_string(remark_check), "all")) > 2.0 then {
        let attachment = redact(to_string(json_get(data, "message.photo.0.file_id", "")), "all")
        let _ = ForgeRemarkFromReply(reply_id, text, attachment)
        let _ = AuditLog("forge_remark_reply", "owner", "reply_to=" + reply_id)
        return respond("200 ok")
      }
    }

    // Callback query handler
    // №421: has_field(data,...) — решение на сыром Dict (json_body) гасим
    // строковой проверкой через обёрнутый json_get (probe-проверено)
    if redact(to_string(json_get(data, "callback_query", "")), "all") != "" then {
      let cb_data = redact(to_string(json_get(data, "callback_query.data", "")), "all")
      let cb_id = redact(to_string(json_get(data, "callback_query.id", "")), "all")
      let cb_chat_id = redact(to_string(json_get(data, "callback_query.message.chat.id", "0")), "all")
      let token = TgToken()
      let _ = TryVal(try http_post("https://api.telegram.org/bot" + token + "/answerCallbackQuery", json_encode({callback_query_id: cb_id}), "application/json"))

      // FO-038 A.3: гейты FORGE — callback_data fg:<gate_id>:<option_idx>
      if starts_with(cb_data, "fg:") then {
        let rest_cb = substring(cb_data, 3.0, length(cb_data))
        let cb_parts = split(rest_cb, ":")
        if length(cb_parts) >= 2.0 then {
          let fg_gate = trim(to_string(get(cb_parts, 0)))
          let fg_idx = trim(to_string(get(cb_parts, 1)))
          let fg_result = ForgeGateDecide(fg_gate, fg_idx, "owner")
          let _ = TryVal(try http_post("https://api.telegram.org/bot" + token + "/answerCallbackQuery", json_encode({callback_query_id: cb_id, text: substring(fg_result, 0.0, 180.0), show_alert: false}), "application/json"))
          let _ = SendTelegramReply(cb_chat_id, substring(fg_result, 0.0, 3500.0))
        }
        return respond("200 ok")
      }
      // №587 A.3: оценка владельца «+»/«−» — rt:<vote>:<id>; жмёт только владелец
      if starts_with(cb_data, "rt:") then {
        let cb_user = redact(to_string(json_get(data, "callback_query.from.id", "0")), "all")
        if cb_user != redact(env("OWNER_TELEGRAM_ID"), "all") then {
          let _ = TryVal(try http_post("https://api.telegram.org/bot" + token + "/answerCallbackQuery", json_encode({callback_query_id: cb_id, text: "Оценивать может только владелец офиса", show_alert: false}), "application/json"))
          return respond("200 ok")
        }
        let rt_parts = split(substring(cb_data, 3.0, length(cb_data)), ":")
        if length(rt_parts) == 2.0 then {
          let rt_vote = trim(to_string(get(rt_parts, 0)))
          let rt_id = trim(to_string(get(rt_parts, 1)))
          let rt_rows = query("SELECT dept, ref, chat_id FROM reply_ratings WHERE id = ?1", [rt_id])
          if length(rt_rows) > 0.0 then {
            let rt_r = get(rt_rows, 0)
            let rt_dept = redact(to_string(json_get(rt_r, "dept", "global")), "all")
            let rt_ref = redact(to_string(json_get(rt_r, "ref", "")), "all")
            let rt_chat = redact(to_string(json_get(rt_r, "chat_id", "")), "all")
            let mut vote_val = "0"
            if rt_vote == "+" then { let vote_val = "1" }
            if rt_vote == "-" then { let vote_val = "-1" }
            let _ = db_execute("UPDATE reply_ratings SET vote = ?1, voted_at = datetime('now') WHERE id = ?2", [vote_val, rt_id])
            let _ = AuditLog("rating_vote", rt_dept, "rating=" + rt_id + " vote=" + vote_val)
            let vote_txt = "Записано: −"
            if rt_vote == "+" then { let vote_txt = "Записано: +" }
            let _ = TryVal(try http_post("https://api.telegram.org/bot" + token + "/answerCallbackQuery", json_encode({callback_query_id: cb_id, text: vote_txt, show_alert: false}), "application/json"))
            // клавиатура → [✓ +][−] / [+][✓ −] (№587 A.3)
            let cb_mid = redact(to_string(json_get(data, "callback_query.message.message_id", "0")), "all")
            let _ = TryVal(try http_post("https://api.telegram.org/bot" + token + "/editMessageReplyMarkup", json_encode({chat_id: to_float(rt_chat), message_id: to_float(cb_mid), reply_markup: RatingKeyboard(rt_id, rt_vote)}), "application/json"))
            if rt_vote == "+" then {
              // то же, что /good, но для конкретного ответа (№587 A.3)
              let pos_query = ""
              let pos_reply = ""
              if rt_ref != "" then {
                let drows = query("SELECT query, raw_text FROM miniapp_responses WHERE id = ?1", [rt_ref])
                each dr in drows {
                  let pos_query = redact(to_string(json_get(dr, "query", "")), "all")
                  let pos_reply = redact(to_string(json_get(dr, "raw_text", "")), "all")
                }
              }
              if pos_query == "" then {
                let dq = query("SELECT content FROM dialog_history WHERE chat_id = ?1 AND role = 'user' ORDER BY id DESC LIMIT 1", [rt_chat])
                each qr in dq { let pos_query = redact(to_string(json_get(qr, "content", "")), "all") }
                let da = query("SELECT content FROM dialog_history WHERE chat_id = ?1 AND role = 'assistant' AND dept = ?2 ORDER BY id DESC LIMIT 1", [rt_chat, rt_dept])
                each ar in da { let pos_reply = redact(to_string(json_get(ar, "content", "")), "all") }
              }
              let _ = RecordPositiveExample(rt_dept, pos_query, pos_reply)
            }
            if rt_vote == "-" then {
              // force_reply: одна фраза «что не так» → коррекция (№587 A.3)
              let prompt_body = json_encode({chat_id: to_float(rt_chat), text: "Что не так? Одной фразой (или «-» — без комментария)", reply_markup: {force_reply: true, input_field_placeholder: "Что не так?"}})
              let prompt_res = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", prompt_body, "application/json"))
              let prompt_mid = to_float(json_get(parse_json(to_string(prompt_res)), "result.message_id", "0"))
              let _ = db_execute("UPDATE reply_ratings SET prompt_message_id = ?1 WHERE id = ?2", [prompt_mid, rt_id])
            }
          }
        }
        return respond("200 ok")
      }
      // Handle approve/reject narads
      if starts_with(cb_data, "approve_") then {
        let narad_id = substring(cb_data, 8.0, length(cb_data))
        db_execute("UPDATE narads SET status = 'approved', approved_at = datetime('now') WHERE id = ?1", [narad_id])
        let _ = AuditLog("narad_approve", "admin", "approved narad: " + narad_id)
        let _ = SendTelegramReply(cb_chat_id, "Narad " + narad_id + " approved.")
      }
      if starts_with(cb_data, "reject_") then {
        let narad_id = substring(cb_data, 7.0, length(cb_data))
        db_execute("UPDATE narads SET status = 'rejected' WHERE id = ?1", [narad_id])
        let _ = AuditLog("narad_reject", "admin", "rejected narad: " + narad_id)
        let _ = SendTelegramReply(cb_chat_id, "Narad " + narad_id + " rejected.")
      }
      // Handle naryad quick-action callbacks (do/skip/done)
      if starts_with(cb_data, "do_naryad_") then {
        let narad_id = substring(cb_data, 11.0, length(cb_data))
        db_execute("UPDATE narads SET status = 'approved', approved_at = datetime('now') WHERE id = ?1", [narad_id])
        let _ = AuditLog("naryad_do", "admin", "approved naryad: " + narad_id)
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + " одобрен (approved). Диспетчер возьмёт его в работу.")
      }
      if starts_with(cb_data, "skip_naryad_") then {
        let narad_id = substring(cb_data, 13.0, length(cb_data))
        db_execute("UPDATE narads SET status = 'rejected' WHERE id = ?1", [narad_id])
        let _ = AuditLog("naryad_skip", "admin", "skipped naryad: " + narad_id)
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + " пропущен.")
      }
      if starts_with(cb_data, "done_naryad_") then {
        let narad_id = substring(cb_data, 12.0, length(cb_data))
        // FO-048: тот же гейт приёмки, что и у команды /наряд готов
        let res = NaradDone(narad_id, cb_chat_id)
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + ": " + res)
      }
      if starts_with(cb_data, "na_fail_") then {
        let narad_id = substring(cb_data, 8.0, length(cb_data))
        let res = NaradAccept(narad_id, "fail", cb_chat_id, "по кнопке")
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + ": " + res)
      }
      if starts_with(cb_data, "na_ok_") then {
        let narad_id = substring(cb_data, 6.0, length(cb_data))
        let res = NaradAccept(narad_id, "ok", cb_chat_id, "по кнопке")
        let _ = SendTelegramReply(cb_chat_id, "Наряд " + narad_id + ": " + res)
      }
      // FO-020: review-очередь выведенного (approve/decline/undo)
      // callback_data: rv_<decision>_<source>_<id>, напр. rv_approve_fact_12
      if starts_with(cb_data, "rv_approve_") or starts_with(cb_data, "rv_decline_") or starts_with(cb_data, "rv_undo_") then {
        let mut decision = "approve"
        if starts_with(cb_data, "rv_decline_") then { let decision = "decline" }
        if starts_with(cb_data, "rv_undo_") then { let decision = "undo" }
        let mut target = ""
        if starts_with(cb_data, "rv_approve_") then { let target = substring(cb_data, 11.0, length(cb_data)) }
        if starts_with(cb_data, "rv_decline_") then { let target = substring(cb_data, 11.0, length(cb_data)) }
        if starts_with(cb_data, "rv_undo_") then { let target = substring(cb_data, 8.0, length(cb_data)) }
        let uscore = index_of(target, "_")
        if uscore > 0.0 then {
          let src = substring(target, 0.0, uscore)
          let iid = substring(target, uscore + 1.0, length(target))
          let body = json_encode({item_id: to_float(iid), source: src, decision: decision})
          let resp = TryVal(try http_post("http://127.0.0.1:4000/review/decide", body, "application/json"))
          let _ = AuditLog("review_" + decision, "owner", "review " + target)
          if to_string(resp) == "()" then {
            let _ = SendTelegramReply(cb_chat_id, "Ревью не применено — proxy недоступен.")
          } else {
            if decision == "approve" then {
              let _ = SendTelegramReply(cb_chat_id, "✅ Вывод " + target + " одобрен — полный вес в выдаче.")
            }
            if decision == "decline" then {
              let _ = SendTelegramReply(cb_chat_id, "❌ Вывод " + target + " отклонён (soft-delete, из выдачи убран).")
            }
            if decision == "undo" then {
              let _ = SendTelegramReply(cb_chat_id, "↩️ Вывод " + target + " возвращён в очередь.")
            }
          }
        }
        return respond("200 ok")
      }
      // Handle cost-dept callback
      if starts_with(cb_data, "cost_") then {
        let cost_dept = substring(cb_data, 5.0, length(cb_data))
        let _ = SendTelegramReply(cb_chat_id, "Cost details for " + cost_dept + ": see office dashboard")
        let _ = AuditLog("cost_detail", "system", "dept: " + cost_dept)
      }
      return respond("200 ok")
    }

    // Forwarded messages to LZ index — detect via json_get, not has_field
    let fwd_chat_id = redact(to_string(json_get(data, "message.forward_from_chat.id", "")), "all")
    if fwd_chat_id != "" then {
      let fwd_text = redact(to_string(json_get(data, "message.text", "")), "all")
      if fwd_text != "" then {
        let _ = AuditLog("forward_received", "lz", "forward indexed, len=" + to_string(length(fwd_text)))
      }
      return respond("200 ok")
    }

    // Send typing
    let _ = SendTyping(chat_id)
    let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','webhook','step_0_after_text_and_typing','ok')")

    // ============================================================
    // COMMAND ROUTING
    // ============================================================

    // /start
    if text == "/start" then {
      let _ = SendTelegramReply(chat_id, "Fosved Office v2\n\n14 departments at your service.\nType /help for commands.")
      let _ = AuditLog("start", "system", "user started bot")
      return respond("200 ok")
    }

    // /help
    if text == "/help" then {
      let _ = SendTelegramReply(chat_id, "Commands:\n\nDepartments: /yana /osp /lz /expert /marketing /finance /legal /dev /design /design-image /qa /visual /visual-image /engineering /forge\n\nImage: /design-image <prompt> — generate an image via design dept\n  /visual-image <prompt> — generate an image via visual dept\n  Or say: нарисуй, сгенерируй изображение, создай картинку (auto-detected in design & visual)\n\nOSP modes: /osp quick | /osp deep | /osp full | /osp wargame\nOSP domains: /osp regime | /osp cantillon | /osp narrative\nOSP tools: /osp tavily | /osp tg /osp profile <actor>\nOSP verification: /osp verify | /osp score | /osp recalibrate\nOSP actions: /osp redteam /osp bet /osp watch /osp unwatch\n\nLZ modes: /lz <query> | /lz scan | /lz deep | /lz all\nLZ domains: /lz politics | /lz economics | /lz geopolitics | /lz event\nLZ tools: /lz tavily | /lz tg | /lz digest [часы]\nLZ channels: /lz_channel add <id> [cat] | /lz_channels | /lz_monitor <topic>\n\nGeneral: /status /office /lockdown /unlock\n\nVoice: /voice on|off|male|female\n\nLearning: /fix <text> /good /learning /debrief <dept> /yana-metrics\n\nEconomy: /stats /cost /costs /budget /model\nAnalytics: /stats-aggregate /model-cost\n\nChain: /chain dept1+dept2 <query>\n\nArchive: /archive [doc_id|<dept> [filter]] /verify <dept> <id> <исход> /score <dept> /autoarchive on|off /search <query>\n  Structured verify: /verify finance <id> actual=<число> | /verify legal <id> outcome=clean|rewrite_required\n\nScheduler: /brief /digest /review\n\nOther: /dept /audit /rate /remember /narads\n\nНаряды: /наряд <описание> — записать баг/задачу\n  /наряды — нарядная очередь\n  /наряд готов <ID> — закрыть (только после приёмки) | /наряд отмена <ID>\n  /наряд план|критерии|исполнитель|приоритет <ID> <значение>\n  /наряд в-очередь|в-работу|в-тест|разблок <ID> | /наряд блок <ID> <причина>\n  /наряд приёмка <ID> ok|fail <комментарий> — вердикт приёмки (гейт done)\n\nAdmin: /admin [status|build|fix|analyze|scan|tour|docs|graph|impact|proposals|narads|rollback|report|health]\nFactory: /factory\n\nDev-MCP (FO-014): /issue <repo> <текст> — открыть issue через MCP\n  /ci <repo> [ветка] — CI-статус через MCP\n  /docs list | /docs read <path> | /docs write <path> <текст> — документы (песочница)\n\nSend any message and it will be routed automatically.")
      return respond("200 ok")
    }

    // /status
    if text == "/status" then {
      // №376: «All 14 online» был захардкожен — офис не пингует отделы из этого
      // роута, утверждение было ложным. Честная формулировка: перечень
      // зарегистрированных отделов + живая телеметрия того, что реально известно.
      let _ = SendTelegramReply(chat_id, "Fosved Office v2 — Status\n\nDepartments (registered): yana, osp, lz, expert, marketing, finance, legal, dev, design, qa, visual, engineering, kavalnya, admin\nVoice: " + kv_get("voice_enabled") + "\nArchive: " + kv_get("auto_archive"))
      let _ = AuditLog("status_check", "system", "status requested")
      return respond("200 ok")
    }

    // /office — open canonical SPA via WebApp inline button
    if text == "/office" or text == "/dept" then {
      let render_url = env("RENDER_URL")
      let token = TgToken()
      let spa_url = render_url + "/miniapp-spa"
      let body = json_encode({
        chat_id: to_float(chat_id),
        text: "Офис Fosved",
        reply_markup: {
          inline_keyboard: [[{
            text: "Открыть офис",
            web_app: {url: spa_url}
          }]]
        }
      })
      let _ = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json"))
      return respond("200 ok")
    }

    // /lockdown
    if starts_with(text, "/lockdown") then {
      let parts = split(raw_text, _sp)
      let password = ""
      if length(split(redact(raw_text, "all"), _sp)) > 1.0 then { let password = get(parts, 1.0) }
      if redact(password, "hash_only") == redact(env("LOCKDOWN_PASSWORD"), "hash_only") or redact(password, "hash_only") == redact(kv_get("lockdown_password"), "hash_only") then {
        kv_set("system_lockdown", "true")
        let _ = AuditLog("lockdown", "system", "owner locked office")
        let _ = SendTelegramReply(chat_id, "LOCKDOWN activated. Only /unlock available.")
      } else {
        let _ = SendTelegramReply(chat_id, "Wrong password.")
      }
      return respond("200 ok")
    }

    // №587 A.2: выключатель кнопок оценки — /rate_buttons on|off
    if starts_with(text, "/rate_buttons") then {
      let arg = trim(substring(text, 13.0, length(text)))
      if arg == "off" then {
        kv_set("rate_buttons", "off")
        let _ = SendTelegramReply(chat_id, "Кнопки оценки выключены. Обработка уже отправленных продолжается.")
      } else {
        kv_set("rate_buttons", "on")
        let _ = SendTelegramReply(chat_id, "Кнопки оценки включены (режим настройки офиса).")
      }
      return respond("200 ok")
    }

    // /fix — record correction (MEGA-3, native Metalogos)
    if starts_with(text, "/fix") then {
      let correction_text = substring(text, 5.0, length(text))
      if length(correction_text) > 1.0 then {
        let recent_rows = query("SELECT dept, content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' ORDER BY id DESC LIMIT 1", [chat_id])
        let recent_dept = "global"
        each r in recent_rows {
          let recent_dept = redact(to_string(json_get(r, "dept", "global")), "all")
        }
        let user_rows = query("SELECT content FROM dialog_history WHERE chat_id = ? AND role = 'user' ORDER BY id DESC LIMIT 1", [chat_id])
        let recent_query = ""
        each r in user_rows {
          let recent_query = redact(to_string(json_get(r, "content", "")), "all")
        }
        let _ = db_execute("INSERT INTO adapt_corrections (dept, original_query, correction, corr_type) VALUES (?1, ?2, ?3, 'manual')", [recent_dept, substring(recent_query, 0.0, 2000.0), substring(correction_text, 0.0, 2000.0)])
        let _ = AuditLog("correction_fix", recent_dept, "type=manual text=" + substring(correction_text, 0.0, 80.0))
        if recent_dept == "yana" then {
          let yana_rows = query("SELECT content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' AND dept = 'yana' ORDER BY id DESC LIMIT 1", [chat_id])
          let yana_answer = ""
          each r in yana_rows {
            let yana_answer = redact(to_string(json_get(r, "content", "")), "all")
          }
          let _ = YanaRecordForgetting(chat_id, recent_query, yana_answer, correction_text)
        }
        let _ = SendTelegramReply(chat_id, "Correction saved for " + recent_dept + ".")
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /fix <your correction>")
      }
      return respond("200 ok")
    }

    // /good — positive example (MEGA-3)
    if text == "/good" then {
      let recent_rows = query("SELECT dept, content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' ORDER BY id DESC LIMIT 1", [chat_id])
      let recent_dept = "global"
      let recent_reply = ""
      each r in recent_rows {
        let recent_dept = redact(to_string(json_get(r, "dept", "global")), "all")
        let recent_reply = redact(to_string(json_get(r, "content", "")), "all")
      }
      let user_rows = query("SELECT content FROM dialog_history WHERE chat_id = ? AND role = 'user' ORDER BY id DESC LIMIT 1", [chat_id])
      let user_query = ""
      each r in user_rows {
        let user_query = redact(to_string(json_get(r, "content", "")), "all")
      }
      let _ = RecordPositiveExample(recent_dept, user_query, recent_reply)
      let _ = SendTelegramReply(chat_id, "Positive feedback recorded for " + recent_dept + ".")
      return respond("200 ok")
    }

    // /наряды — нарядная очередь (FO-046, must be before /наряд to avoid prefix match):
    // счётчики по статусам + открытые наряды (паттерн NaradQueueView в dept/narad.mlog)
    if text == "/наряды" then {
      let queue_msg = NaradQueueView()
      let _ = SendTelegramReply(chat_id, queue_msg)
      return respond("200 ok")
    }

    // /наряд готов N — закрыть наряд (FO-048: гейт — только после пройденной приёмки)
    if starts_with(text, "/наряд готов ") then {
      let narad_id = trim(substring(text, 13.0, length(text)))
      let res = NaradDone(narad_id, chat_id)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    // /наряд приёмка <ID> ok|fail <комментарий> — вердикт приёмки (FO-048)
    if starts_with(text, "/наряд приёмка ") then {
      let _sp = " "
      let parsed = parse_json(NaradSplitArgs(substring(text, 15.0, length(text))))
      let nid = redact(to_string(json_get(parsed, "id", "")), "all")
      let tail = redact(to_string(json_get(parsed, "tail", "")), "all")
      let tparts = split(tail, _sp)
      let verdict = ""
      if length(tparts) > 0.0 then { let verdict = trim(to_string(get(tparts, 0))) }
      let cmt = ""
      if (verdict == "ok" or verdict == "fail") and length(tail) > length(verdict) then {
        let cmt = trim(substring(tail, length(verdict) + 1.0, length(tail)))
      }
      if nid == "" or (verdict != "ok" and verdict != "fail") then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд приёмка <ID> ok|fail <комментарий>")
        return respond("200 ok")
      }
      let res = NaradAccept(nid, verdict, chat_id, cmt)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }

    // /наряд отмена N — cancel naryad
    if starts_with(text, "/наряд отмена ") then {
      let narad_id = trim(substring(text, 14.0, length(text)))
      db_execute("UPDATE narads SET status = 'rejected' WHERE id = ?1", [narad_id])
      let _ = AuditLog("naryad_cancel_cmd", "admin", "cancelled: " + narad_id)
      let _ = SendTelegramReply(chat_id, "Наряд " + narad_id + " отменён.")
      return respond("200 ok")
    }

    // ── FO-046 (#161): нарядный контур 2.0 — поля и переходы ─────────────
    // Поля: план, критерии, исполнитель, приоритет. Переходы: в-очередь,
    // в-работу, в-тест, блок, разблок. Логика — dept/narad.mlog.
    if starts_with(text, "/наряд план ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 12.0, length(text))))
      let nid = redact(to_string(json_get(parsed, "id", "")), "all")
      let body_text = redact(to_string(json_get(parsed, "tail", "")), "all")
      if nid == "" or body_text == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд план <ID> <шаги работ>")
        return respond("200 ok")
      }
      let res = NaradSetField(nid, "plan", body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд критерии ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 16.0, length(text))))
      let nid = redact(to_string(json_get(parsed, "id", "")), "all")
      let body_text = redact(to_string(json_get(parsed, "tail", "")), "all")
      if nid == "" or body_text == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд критерии <ID> <сделано, когда...>")
        return respond("200 ok")
      }
      let res = NaradSetField(nid, "acceptance", body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд исполнитель ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 19.0, length(text))))
      let nid = redact(to_string(json_get(parsed, "id", "")), "all")
      let body_text = redact(to_string(json_get(parsed, "tail", "")), "all")
      if nid == "" or body_text == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд исполнитель <ID> <отдел>")
        return respond("200 ok")
      }
      let res = NaradSetField(nid, "dept", body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд приоритет ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 17.0, length(text))))
      let nid = redact(to_string(json_get(parsed, "id", "")), "all")
      let body_text = redact(to_string(json_get(parsed, "tail", "")), "all")
      if nid == "" or body_text == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд приоритет <ID> <high|normal|low>")
        return respond("200 ok")
      }
      let res = NaradSetField(nid, "priority", body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд в-очередь ") then {
      let nid = trim(substring(text, 17.0, length(text)))
      let res = NaradTransition(nid, "queue", chat_id, "")
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд в-работу ") then {
      let nid = trim(substring(text, 16.0, length(text)))
      let res = NaradTransition(nid, "work", chat_id, "")
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд в-тест ") then {
      let nid = trim(substring(text, 14.0, length(text)))
      let res = NaradTransition(nid, "test", chat_id, "")
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд блок ") then {
      let parsed = parse_json(NaradSplitArgs(substring(text, 12.0, length(text))))
      let nid = redact(to_string(json_get(parsed, "id", "")), "all")
      let body_text = redact(to_string(json_get(parsed, "tail", "")), "all")
      if nid == "" then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд блок <ID> <причина>")
        return respond("200 ok")
      }
      let res = NaradTransition(nid, "block", chat_id, body_text)
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }
    if starts_with(text, "/наряд разблок ") then {
      let nid = trim(substring(text, 15.0, length(text)))
      let res = NaradTransition(nid, "unblock", chat_id, "")
      let _ = SendTelegramReply(chat_id, res)
      return respond("200 ok")
    }

    // /наряд <text> — quick bug/task recording for admin
    if starts_with(text, "/наряд ") then {
      let naryad_text = trim(substring(text, 7.0, length(text)))
      if length(naryad_text) < 3.0 then {
        let _ = SendTelegramReply(chat_id, "Формат: /наряд <описание бага/задачи>")
        return respond("200 ok")
      }
      // Generate short ID: N + counter
      let counter = kv_get("naryad_counter")
      let mut count = 1
      if counter != "" then { count = to_int(counter) + 1 }
      let _ = kv_set("naryad_counter", to_string(count))
      let naryad_id = "N" + to_string(count)
      // Get context: last assistant reply for reference
      let recent_rows = query("SELECT dept, content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' ORDER BY id DESC LIMIT 1", [chat_id])
      let context_line = ""
      if length(recent_rows) > 0.0 then {
        let first_row = TryVal(try get(recent_rows, 0.0))
        if to_string(first_row) != "()" then {
          let recent_dept = redact(to_string(TryVal(try json_get(first_row, "dept", ""))), "all")
          if recent_dept != "" then {
            let context_line = "Контекст: ответ отдела " + recent_dept
          }
        }
      }
      // Save to narads table
      db_execute("INSERT INTO narads (id, title, description, requested_by, risk_level, status) VALUES (?1, ?2, ?3, ?4, ?5, 'pending')", [naryad_id, substring(naryad_text, 0.0, 100.0), naryad_text, chat_id, "low"])
      let _ = AuditLog("naryad_created", "admin", "id=" + naryad_id + " text=" + substring(naryad_text, 0.0, 80.0))
      // FO-046: подтверждение с кнопками Принять/Пропустить (do_naryad_/skip_naryad_)
      let confirm = "Наряд " + naryad_id + " записан:\n" + naryad_text + "\n" + context_line
      let _ = NaradSendButtons(chat_id, confirm, naryad_id)
      return respond("200 ok")
    }


    // /learning — stats (MEGA-3)
    if text == "/learning" then {
      let stats_result = GetLearningStats()
      let stats_json = parse_json(stats_result)
      let corrections_7d = redact(to_string(json_get(stats_json, "corrections_7d", "0")), "all")
      let positive_count = redact(to_string(json_get(stats_json, "positive_count", "0")), "all")
      let msg = "Learning stats (7 days):\n"
      let msg = msg + "- Corrections: " + corrections_7d + "\n"
      let msg = msg + "- Positive examples: " + positive_count + "\n"
      let msg = msg + "- Error types: see office dashboard"
      let _ = SendTelegramReply(chat_id, msg)
      return respond("200 ok")
    }

    // /yana-metrics — delegation accuracy & forgetting incidents
    if text == "/yana-metrics" then {
      let metrics = YanaGetMetrics()
      let _ = SendTelegramReply(chat_id, metrics)
      return respond("200 ok")
    }

    // /debrief — LLM analysis of errors per dept (MEGA-3)
    if starts_with(text, "/debrief") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let dept = trim(get(parts, 1.0))
        let debrief_result = TryVal(try DebriefDepartment(dept))
        if to_string(debrief_result) == "()" then {
          let _ = SendTelegramReply(chat_id, "Debrief " + dept + ": недостаточно данных или функция недоступна.")
        } else {
          let _ = SendTelegramReply(chat_id, "Debrief " + dept + ":\n\n" + substring(debrief_result, 0.0, 2000.0))
        }
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /debrief <dept>\nExample: /debrief osp")
      }
      return respond("200 ok")
    }

    // /digest
    if text == "/digest" then {
      let result = TryVal(try EveningSummary())
      if to_string(result) == "()" then {
        let _ = SendTelegramReply(chat_id, "Evening summary error — check logs.")
      } else {
        let _ = SendTelegramReply(chat_id, "Evening digest sent.")
      }
      return respond("200 ok")
    }

    // /review
    if text == "/review" then {
      // FO-020: review-очередь выведенного — approve/decline/undo кнопками
      let _ = ReviewQueueCard(chat_id)
      return respond("200 ok")
    }

    // /brief — manual morning brief (MEGA-3)
    if text == "/brief" then {
      let _ = MorningBrief()
      let _ = SendTelegramReply(chat_id, "Morning brief sent.")
      let _ = AuditLog("manual_brief", "yana", "manual morning brief triggered")
      return respond("200 ok")
    }

    // ── /quest — dossier/task management (QUEST-1) ──
    if starts_with(text, "/quest") then {
      // /quest list
      if starts_with(text, "/quest list") then {
        let info = QuestList(chat_id)
        let _ = SendTelegramReply(chat_id, info)
        return ""
      }
      // /quest new <title> | <type> | <steps> | <deadline>
      // Example: /quest new Grant FondX | grant | 6 | 2026-09-15
      if starts_with(text, "/quest new ") then {
        let rest = substring(text, 11.0, length(text))
        let parts = split(rest, "|")
        let qtitle = trim(get(parts, 0.0))
        let qtype = "general"
        let qsteps = "5"
        let qdeadline = ""
        if length(parts) > 1.0 then { let qtype = trim(get(parts, 1.0)) }
        if length(parts) > 2.0 then { let qsteps = trim(get(parts, 2.0)) }
        if length(parts) > 3.0 then { let qdeadline = trim(get(parts, 3.0)) }
        let qid = QuestCreate(qtitle, qtype, qsteps, qdeadline, chat_id)
        let status = QuestStatus(qid)
        let _ = SendTelegramReply(chat_id, "Dosse sozdano: " + qid + "\n\n" + status)
        return ""
      }
      // /quest status <id>
      if starts_with(text, "/quest status ") then {
        let qid = trim(substring(text, 14.0, length(text)))
        let info = QuestStatus(qid)
        let _ = SendTelegramReply(chat_id, info)
        return ""
      }
      // /quest approve <id> [step_num]
      if starts_with(text, "/quest approve ") then {
        let rest = trim(substring(text, 15.0, length(text)))
        let parts = split(rest, _sp)
        let qid = get(parts, 0.0)
        let result = QuestApproveStep(qid, "owner")
        let _ = SendTelegramReply(chat_id, result)
        return ""
      }
      // /quest next <id> — advance to next step
      if starts_with(text, "/quest next ") then {
        let qid = trim(substring(text, 12.0, length(text)))
        let result = QuestAdvanceStep(qid)
        let _ = SendTelegramReply(chat_id, result)
        return ""
      }
      // /quest close <id>
      if starts_with(text, "/quest close ") then {
        let qid = trim(substring(text, 13.0, length(text)))
        let result = QuestClose(qid)
        let _ = SendTelegramReply(chat_id, result)
        return ""
      }
      // /quest send <id> | <recipient> | <subject>
      if starts_with(text, "/quest send ") then {
        let rest = trim(substring(text, 12.0, length(text)))
        let parts = split(rest, "|")
        let qid = trim(get(parts, 0.0))
        let recipient = ""
        let subject = ""
        if length(parts) > 1.0 then { let recipient = trim(get(parts, 1.0)) }
        if length(parts) > 2.0 then { let subject = trim(get(parts, 2.0)) }
        let result = QuestSendPackage(qid, recipient, subject)
        let _ = SendTelegramReply(chat_id, result)
        return ""
      }
      // /quest help — #366: send помечен честно (почтового контура нет)
      let _ = SendTelegramReply(chat_id, "Komandy dosse:\n/quest new <title> | <type> | <steps> | <deadline>\n/quest list\n/quest status <id>\n/quest next <id> — advance step\n/quest approve <id> — approve current step\n/quest close <id>\n/quest send <id> | <email> | <subject> (ne realizovano — net pochty)")
      return ""
    }

    // /rate
    if starts_with(text, "/rate") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let rating = get(parts, 1.0)
        db_execute("INSERT INTO dept_metrics (dept, metric_name, metric_value, period) VALUES ('global', 'satisfaction', ?1, 'daily')", [rating])
        let _ = AuditLog("rating", "system", "rating=" + rating)
        let _ = SendTelegramReply(chat_id, "Rating " + rating + " recorded.")
      }
      return respond("200 ok")
    }

    // /rate-yana — owner feedback for Yana metrics
    if starts_with(text, "/rate-yana") then {
      let parts = split(text, _sp)
      let score = get(parts, 1.0)
      let comment = join(slice(parts, 2.0, length(parts)), _sp)
      db_execute("INSERT INTO dept_metrics (dept, metric_name, metric_value, period, created_at) VALUES ('yana', 'owner_feedback', ?1, 'manual', datetime('now'))", [score])
      if length(comment) > 0.0 then {
        db_execute("INSERT INTO dept_metrics (dept, metric_name, metric_value, period, created_at) VALUES ('yana', 'owner_comment', ?1, 'manual', datetime('now'))", [comment])
      }
      let _ = AuditLog("rate_yana", "owner", "score=" + score)
      let _ = SendTelegramReply(chat_id, "Yana feedback recorded: " + score + "/10")
      return ""
    }

    // /quarterly-review — methodology compliance review for a department
    if starts_with(text, "/quarterly-review") then {
      let parts = split(text, _sp)
      let target_dept = get(parts, 1.0)
      if length(target_dept) < 2.0 then {
        let _ = SendTelegramReply(chat_id, "Usage: /quarterly-review <dept>\nReviews methodology compliance for the department.")
        return ""
      }
      let profile = redact(read_file("library/" + target_dept + ".md"), "all")
      let methodology = redact(read_file("METHODOLOGY.md"), "all")
      let metrics = query("SELECT metric_name, metric_value, created_at FROM dept_metrics WHERE dept = ? ORDER BY id DESC LIMIT 20", [target_dept])
      let corrections = query("SELECT original_query, correction, created_at FROM adapt_corrections WHERE dept = ? ORDER BY id DESC LIMIT 10", [target_dept])
      let context = "QUARTERLY METHODOLOGY REVIEW for department: " + target_dept + "\n\nMETHODOLOGY.md (relevant sections):\n" + substring(methodology, 0.0, 3000.0) + "\n\nDepartment profile:\n" + profile + "\n\nRecent metrics:\n" + to_string(metrics) + "\n\nRecent corrections:\n" + to_string(corrections) + "\n\nTask: Review this department against the methodology. Check: (1) hard rules compliance, (2) metrics health, (3) anti-patterns, (4) skills coverage. Output a structured review."
      let dept = "kavalnya"
      // naryad-360: было HandleDeptQuery(chat_id, dept, context) — все три
      // аргумента перепутаны (сигнатура: dept, query, chat_id); запрос уходил
      // в несуществующий отдел-«chat_id» с query=«kavalnya»
      let _ = HandleDeptQuery(dept, context, chat_id)
      return ""
    }

    // /remind — scheduled reminders (F-1)
    if starts_with(text, "/remind") then {
      // B.5 — /remind list
      if text == "/remind list" then {
        let rows = query("SELECT id, COALESCE(event_text,'') AS event_text, COALESCE(rrule_kind,'') AS rrule_kind, COALESCE(fire_time,'') AS fire_time, COALESCE(fire_weekday,'') AS fire_weekday, COALESCE(fire_monthday,'') AS fire_monthday, COALESCE(datetime(next_fire_at,'+3 hours'),'') AS next_local FROM yana_events WHERE active = 1 AND rrule_kind IS NOT NULL AND chat_id = ? ORDER BY next_fire_at ASC LIMIT 30", [chat_id])
        if length(rows) == 0.0 then {
          let _ = SendTelegramReply(chat_id, "Напоминаний нет.")
        } else {
          let output = ""
          each row in rows {
            let rid = redact(to_string(json_get(row, "id", "")), "all")
            let rkind = redact(to_string(json_get(row, "rrule_kind", "")), "all")
            let rlocal = redact(to_string(json_get(row, "next_local", "")), "all")
            let rtext = redact(to_string(json_get(row, "event_text", "")), "all")
            let when = rlocal
            if when == "" then {
              let mut when = to_string(json_get(row, "fire_time", ""))
              if when == "" then { when = "время не указано" }
            }
            let output = output + to_string(rid) + ". " + rtext + " \u2014 " + when + " (" + rkind + ")\n"
          }
          let _ = SendTelegramReply(chat_id, output)
        }
        return respond("200 ok")
      }
      // B.5b — /remind clear
      if text == "/remind clear" then {
        let cnt = query("SELECT COUNT(*) AS c FROM yana_events WHERE active = 1 AND chat_id = ?", [chat_id])
        let n = redact(to_string(json_get(cnt[0], "c", "0")), "all")
        let _ = query("UPDATE yana_events SET active = 0 WHERE chat_id = ?", [chat_id])
        let _ = AuditLog("remind_clear", "yana", "cleared=" + n)
        let _ = SendTelegramReply(chat_id, "Удалено напоминаний: " + n + ". Список пуст.")
        return respond("200 ok")
      }
      // B.6 — /remind del <id>
      if starts_with(text, "/remind del ") then {
        let del_id = substring(text, 12.0, length(text))
        let existing = query("SELECT id FROM yana_events WHERE id = ? AND active = 1", [del_id])
        if length(existing) > 0.0 then {
          let _ = query("UPDATE yana_events SET active = 0 WHERE id = ?", [del_id])
          let _ = SendTelegramReply(chat_id, "Удалила напоминание " + del_id)
        } else {
          let _ = SendTelegramReply(chat_id, "Не нашла напоминание с таким номером.")
        }
        return respond("200 ok")
      }
      // B.1 — /remind daily HH:MM текст
      if starts_with(text, "/remind daily ") then {
        if length(text) > 20.0 and substring(text, 16.0, 17.0) == ":" then {
          let fire_time = substring(text, 14.0, 19.0)
          let reminder_text = substring(text, 20.0, length(text))
          if reminder_text != "" then {
            let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'daily', ?, ?, 1, datetime('now'), CASE WHEN datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours') ELSE datetime(date(datetime('now','+3 hours')) || ' ' || ? || ':00', '-3 hours', '+1 day') END)", [reminder_text, fire_time, chat_id, fire_time, fire_time, fire_time])
            let _ = SendTelegramReply(chat_id, "Записала: каждый день в " + fire_time + " \u2014 " + reminder_text)
            return respond("200 ok")
          }
        }
        let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
        return respond("200 ok")
      }
      // B.2 — /remind once YYYY-MM-DD HH:MM текст
      if starts_with(text, "/remind once ") then {
        if length(text) > 29.0 and substring(text, 26.0, 27.0) == ":" then {
          let ev_date = substring(text, 13.0, 23.0)
          let fire_time = substring(text, 24.0, 29.0)
          let reminder_text = substring(text, 30.0, length(text))
          if reminder_text != "" then {
            let _ = query("INSERT INTO yana_events (event_text, event_type, event_date, rrule_kind, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', ?, 'once', ?, ?, 1, datetime('now'), datetime(? || ' ' || ? || ':00', '-3 hours'))", [reminder_text, ev_date, fire_time, chat_id, ev_date, fire_time])
            let _ = SendTelegramReply(chat_id, "Записала: " + ev_date + " в " + fire_time + " \u2014 " + reminder_text)
            return respond("200 ok")
          }
        }
        let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
        return respond("200 ok")
      }
      // B.3 — /remind weekly <day> HH:MM текст
      if starts_with(text, "/remind weekly ") then {
        let day_part = substring(text, 15.0, 18.0)
        let valid_day = (day_part == "mon" or day_part == "tue" or day_part == "wed" or day_part == "thu" or day_part == "fri" or day_part == "sat" or day_part == "sun")
        if valid_day and length(text) > 25.0 and substring(text, 21.0, 22.0) == ":" then {
          let fire_time = substring(text, 19.0, 24.0)
          let reminder_text = substring(text, 25.0, length(text))
          if reminder_text != "" then {
            let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_weekday, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'weekly', ?, ?, ?, 1, datetime('now'), CASE WHEN datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours') ELSE datetime(datetime(date(datetime('now','+3 hours'), CAST(((CASE ? WHEN 'mon' THEN 1 WHEN 'tue' THEN 2 WHEN 'wed' THEN 3 WHEN 'thu' THEN 4 WHEN 'fri' THEN 5 WHEN 'sat' THEN 6 WHEN 'sun' THEN 0 END) - CAST(strftime('%w', datetime('now','+3 hours')) AS INTEGER) + 7) % 7 AS TEXT) || ' days') || ' ' || ? || ':00', '-3 hours'), '+7 days') END)", [reminder_text, day_part, fire_time, chat_id, day_part, fire_time, day_part, fire_time, day_part, fire_time])
            let _ = SendTelegramReply(chat_id, "Записала: каждую " + day_part + " в " + fire_time + " \u2014 " + reminder_text)
            return respond("200 ok")
          }
        }
        let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
        return respond("200 ok")
      }
      // B.4 — /remind yearly MM-DD HH:MM текст
      if starts_with(text, "/remind yearly ") then {
        if length(text) > 27.0 and substring(text, 17.0, 18.0) == "-" then {
          let monthday = substring(text, 15.0, 20.0)
          let fire_time = substring(text, 21.0, 26.0)
          let reminder_text = substring(text, 27.0, length(text))
          if reminder_text != "" and substring(fire_time, 2.0, 3.0) == ":" then {
            let _ = query("INSERT INTO yana_events (event_text, event_type, rrule_kind, fire_monthday, fire_time, chat_id, active, created_at, next_fire_at) VALUES (?, 'reminder', 'yearly', ?, ?, ?, 1, datetime('now'), CASE WHEN datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours') > datetime('now') THEN datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours') ELSE datetime(strftime('%Y','now') || '-' || ? || ' ' || ? || ':00', '-3 hours', '+1 year') END)", [reminder_text, monthday, fire_time, chat_id, monthday, fire_time, monthday, fire_time, monthday, fire_time])
            let _ = SendTelegramReply(chat_id, "Записала: ежегодно " + monthday + " в " + fire_time + " \u2014 " + reminder_text)
            return respond("200 ok")
          }
        }
        let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
        return respond("200 ok")
      }
      // B.7 — hint for unknown /remind subcommand
      let _ = SendTelegramReply(chat_id, "Формат:\n/remind daily 09:00 текст\n/remind once 2026-07-25 09:00 текст\n/remind weekly mon 09:00 текст\n/remind yearly 03-15 09:00 текст\n/remind list\n/remind del 12\n/remind clear — удалить все\nВремя минское.")
      return respond("200 ok")
    }

    // /calendar — show Yana events
    if text == "/calendar" then {
      let rows = query("SELECT COALESCE(event_text,'') AS event_text, COALESCE(event_date,'') AS event_date, COALESCE(event_type,'напоминание') AS event_type FROM yana_events ORDER BY event_date ASC LIMIT 20", [])
      if length(rows) == 0.0 then {
        let _ = SendTelegramReply(chat_id, "Календарь пуст. Используй /remember <текст> [дата] чтобы добавить событие.")
      } else {
        let output = "Календарь Яны (" + to_string(length(rows)) + "):\n\n"
        let i = 0.0
        each row in rows {
          let i = i + 1.0
          let etext = redact(to_string(json_get(row, "event_text", "")), "all")
          let edate = redact(to_string(json_get(row, "event_date", "")), "all")
          let etype = redact(to_string(json_get(row, "event_type", "напоминание")), "all")
          let output = output + to_string(i) + ". [" + edate + "] " + etext + " (" + etype + ")\n"
        }
        let _ = SendTelegramReply(chat_id, output)
      }
      return respond("200 ok")
    }

    // /remember
    if starts_with(text, "/remember") then {
      let fact = substring(text, 10.0, length(text))
      if fact != "" then {
        let _ = query("INSERT INTO yana_events (event_text, event_type, created_at) VALUES (?, 'reminder', datetime('now'))", [fact])
        let _ = AuditLog("remember", "system", substring(fact, 0.0, 100.0))
        let _ = SendTelegramReply(chat_id, "Запомнила.")
      }
      return respond("200 ok")
    }

    // /model — OmniRoute combos
    if text == "/model" or text == "/model list" then {
      let provider = redact(read_file("config/priority_provider.txt"), "all")
      let model = redact(read_file("config/priority_model.txt"), "all")
      let _ = SendTelegramReply(chat_id, "OmniRoute Model Combos:\n\nAuto — route selects combo by dept/depth\n/model auto — reset to auto routing\n/model cheap — force fosved-free (groq→cerebras→deepseek)\n/model best — force fosved-deep (kimi→deepseek→zai→groq→cerebras→anthropic)\n/model fusion — force fosved-fusion (multi-provider consensus)\n\nDirect fallback:\nProvider: " + trim(provider) + "\nModel: " + trim(model) + "\n\n/model set <provider> <model>\n/model <dept> <provider> <model>\n/model reset")
      return respond("200 ok")
    }

    if text == "/model auto" then {
      kv_set("force_combo", "")
      let _ = AuditLog("model_auto", "system", "combo reset to auto")
      let _ = SendTelegramReply(chat_id, "Model routing: AUTO (OmniRoute selects combo by dept/depth)")
      return respond("200 ok")
    }

    if text == "/model cheap" then {
      kv_set("force_combo", "fosved-free")
      let _ = AuditLog("model_cheap", "system", "combo=fosved-free")
      let _ = SendTelegramReply(chat_id, "Model: fosved-free (groq → deepseek → cerebras, zero cost)")
      return respond("200 ok")
    }

    if text == "/model best" then {
      kv_set("force_combo", "fosved-deep")
      let _ = AuditLog("model_best", "system", "combo=fosved-deep")
      let _ = SendTelegramReply(chat_id, "Model: fosved-deep (zai → groq → deepseek → cerebras → anthropic)")
      return respond("200 ok")
    }

    if text == "/model fusion" then {
      kv_set("force_combo", "fosved-fusion")
      let _ = AuditLog("model_fusion", "system", "combo=fosved-fusion")
      let _ = SendTelegramReply(chat_id, "Model: fosved-fusion (zai + groq + deepseek + cerebras + anthropic consensus)")
      return respond("200 ok")
    }

    if starts_with(text, "/model set") then {
      let parts = split(text, _sp)
      if length(parts) > 2.0 then {
        let p = get(parts, 2.0)
        let m = get(parts, 3.0)
        let _ = write_file("config/priority_provider.txt", trim(p))
        let _ = write_file("config/priority_model.txt", trim(m))
        let _ = AuditLog("model_set", "system", "provider=" + trim(p) + " model=" + trim(m))
        let _ = SendTelegramReply(chat_id, "Model set: " + trim(p) + " / " + trim(m))
      }
      return respond("200 ok")
    }

    if text == "/model reset" then {
      let _ = write_file("config/priority_provider.txt", "zai")
      let _ = write_file("config/priority_model.txt", "glm-4.6")
      kv_set("force_combo", "")
      let _ = SendTelegramReply(chat_id, "Model reset to defaults: OmniRoute auto, zai / glm-4.6 fallback")
      return respond("200 ok")
    }

    if starts_with(text, "/model ") then {
      let parts = split(text, _sp)
      if length(parts) > 2.0 then {
        let dept_slug = trim(get(parts, 1.0))
        if length(parts) > 3.0 then {
          let m = get(parts, 3.0)
          // MINIAPP-5 (#292): override-файл = список МОДЕЛЕЙ (читает GetModelFallbackChain,
          // бюджет и legacy-fallback); провайдер выводится из префикса модели — пишем только модель
          let _ = write_file("config/override_" + dept_slug + ".txt", trim(m))
          let _ = AuditLog("model_override_set", "system", "dept=" + dept_slug + " model=" + trim(m))
          let _ = SendTelegramReply(chat_id, "Override " + dept_slug + ": " + trim(m))
        }
      }
      return respond("200 ok")
    }

    // /cost — token costs by department
    if text == "/cost" or text == "/costs" then {
      let _ = SendTelegramReply(chat_id, ShowCosts(chat_id))
      return respond("200 ok")
    }

    // /stats-aggregate — force recalculate costs
    if text == "/stats-aggregate" then {
      let result = AggregateDailyStats()
      let _ = SendTelegramReply(chat_id, "Recalculated: " + result)
      return respond("200 ok")
    }

    // /stats — daily usage statistics
    if text == "/stats" then {
      let _ = SendTelegramReply(chat_id, ShowStats(chat_id))
      return respond("200 ok")
    }

    // /model-cost — list configured pricing
    if text == "/model-cost" then {
      let known_models = ["deepseek-chat", "gpt-4o", "gpt-4o-mini", "glm-4.6", "kimi-chat", "groq-llama", "cerebras-llama"]
      let mut out = "Стоимость моделей (/1M tokens):"
      let mut found_any = "0"
      each m in known_models {
        let mut c_in = kv_get("model_cost:" + m + ":in")
        let mut c_out = kv_get("model_cost:" + m + ":out")
        if c_in == "" then { c_in = "-" }
        if c_out == "" then { c_out = "-" }
        if c_in == "-" and c_out == "-" then { } else {
          out = out + "\n  " + m + " | in: $" + c_in + " | out: $" + c_out
          found_any = "1"
        }
      }
      if found_any == "0" then { out = out + "\n  (не задано)" }
      out = out + "\n\n/model-cost set <model> <in|out> <price>"
      let _ = SendTelegramReply(chat_id, out)
      return respond("200 ok")
    }

    // /model-cost set <model> <in|out> <price_per_1M>
    if starts_with(text, "/model-cost set ") then {
      let rest = substring(text, 16.0, 10000.0)
      let parts = split(rest, " ")
      if length(parts) >= 3.0 then {
        let mc_model = trim(get(parts, 0.0))
        let mc_dir = trim(get(parts, 1.0))
        let mc_price = trim(get(parts, 2.0))
        if mc_dir == "in" or mc_dir == "out" then {
          let _ = kv_set("model_cost:" + mc_model + ":" + mc_dir, mc_price)
          let _ = SendTelegramReply(chat_id, "Model pricing: " + mc_model + " (" + mc_dir + ") = $" + mc_price + "/1M tokens")
        } else {
          let _ = SendTelegramReply(chat_id, "Direction: in or out. Example: /model-cost set gpt-4o in 2.5")
        }
      } else {
        let _ = SendTelegramReply(chat_id, "Format: /model-cost set <model> <in|out> <price per 1M>")
      }
      return respond("200 ok")
    }

    // /inject <dept> <text> — FOIP-003.6: inject cross-dept context
    if starts_with(text, "/inject ") then {
      let rest = substring(text, 8.0, 10000.0)
      let parts = split(rest, _sp)
      if length(parts) >= 2.0 then {
        let target_dept = get(parts, 0.0)
        let ctx_text = substring(rest, length(target_dept) + 1.0, 10000.0)
        let _ = InjectContext(target_dept, ctx_text)
        let _ = SendTelegramReply(chat_id, "Injected context into " + target_dept + ". Will be used on next query.")
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /inject <dept> <context text>")
      }
      return respond("200 ok")
    }


    // /budget
    if starts_with(text, "/budget") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let amount = get(parts, 1.0)
        kv_set("daily_budget", amount)
        let _ = SendTelegramReply(chat_id, "Daily budget set: $" + amount)
      } else {
        let mut budget = kv_get("daily_budget")
        if budget == "" then { budget = "not set" }
        // FO-024: срез бюджетов — spent/limit по департаментам + кто в эконом-режиме
        let resp = redact(to_string(TryVal(try http_get("http://127.0.0.1:4000/api/budget/status"))), "all")
        let mut extra = ""
        if to_string(resp) != "()" then {
          let parsed = TryVal(try parse_json(resp))
          if to_string(parsed) != "()" then {
            // №422: global — объект (json_get по полям); поля моются ниже.
            let g = TryVal(try json_get(parsed, "global", "{}"))
            let gspent = redact(to_string(json_get(g, "spent", "0")), "all")
            let glimit = redact(to_string(json_get(g, "limit", "-")), "all")
            let gstate = redact(to_string(json_get(g, "state", "?")), "all")
            let extra = "\n\nToday (UTC): spent $" + gspent + " / limit $" + glimit + " — " + gstate
            // №422: depts — массив (each); поля моются внутри each.
            let depts = TryVal(try json_get(parsed, "depts", "[]"))
            if to_string(depts) != "()" then {
              each d in depts {
                let dn = redact(to_string(json_get(d, "dept", "?")), "all")
                let dsp = redact(to_string(json_get(d, "spent", "0")), "all")
                let dst = redact(to_string(json_get(d, "state", "?")), "all")
                let dlim = redact(to_string(json_get(d, "limit", "-")), "all")
                let extra = extra + "\n  " + dn + ": $" + dsp + " / $" + dlim + " — " + dst
              }
            }
            // №422: econom — массив; в egress идёт только join-строка — моем её.
            let econom = TryVal(try json_get(parsed, "econom", "[]"))
            if to_string(econom) != "()" then {
              let econ_list = redact(join(econom, ", "), "all")
              if econ_list != "" then {
                let extra = extra + "\n\nЭконом-режим (hard/stop): " + econ_list
              }
            }
          }
        }
        let _ = SendTelegramReply(chat_id, "Daily budget: $" + budget + extra)
      }
      return respond("200 ok")
    }

    // /shadow — FO-025: канареечный роутинг (настройка без правки кода)
    // /shadow <dept> <model> <rate> | /shadow off <dept>
    if starts_with(text, "/shadow") then {
      let parts = split(text, _sp)
      if length(parts) > 3.0 then {
        let sdept = to_string(get(parts, 1.0))
        let smodel = to_string(get(parts, 2.0))
        let srate = to_string(get(parts, 3.0))
        kv_set("shadow_" + sdept, "{\"model\":\"" + smodel + "\",\"rate\":" + srate + "}")
        let _ = AuditLog("shadow_config", "admin", "dept=" + sdept + " model=" + smodel + " rate=" + srate)
        let _ = SendTelegramReply(chat_id, "Shadow включён: " + sdept + " → кандидат " + smodel + " при rate=" + srate)
      } else {
        if length(parts) > 2.0 and to_string(get(parts, 1.0)) == "off" then {
          let sdept = to_string(get(parts, 2.0))
          kv_set("shadow_" + sdept, "")
          let _ = AuditLog("shadow_config", "admin", "dept=" + sdept + " OFF")
          let _ = SendTelegramReply(chat_id, "Shadow выключен: " + sdept)
        } else {
          let _ = SendTelegramReply(chat_id, "Формат: /shadow <dept> <model> <rate> | /shadow off <dept>")
        }
      }
      return respond("200 ok")
    }

    // /voice commands (MEGA-3 — enhanced)
    if starts_with(text, "/voice") then {
      let parts = split(text, _sp)
      let cmd = text
      if length(parts) > 1.0 then { let cmd = get(parts, 1.0) }
      if cmd == "on" then {
        kv_set("voice_enabled", "true")
        let _ = AuditLog("voice_on", "voice", "voice enabled")
        let _ = SendTelegramReply(chat_id, "Voice replies ON. Short answers will be spoken.")
      }
      if cmd == "off" then {
        kv_set("voice_enabled", "false")
        let _ = AuditLog("voice_off", "voice", "voice disabled")
        let _ = SendTelegramReply(chat_id, "Voice replies OFF.")
      }
      if cmd == "male" then {
        kv_set("tts_voice", "ru-RU-DmitryNeural")
        let _ = AuditLog("voice_male", "voice", "voice set to male")
        let _ = SendTelegramReply(chat_id, "Voice: male (Dmitry)")
      }
      if cmd == "female" then {
        kv_set("tts_voice", "ru-RU-SvetlanaNeural")
        let _ = AuditLog("voice_female", "voice", "voice set to female")
        let _ = SendTelegramReply(chat_id, "Voice: female (Svetlana)")
      }
      return respond("200 ok")
    }

    // /audit — show last 20 entries (MEGA-3 enhanced)
    if text == "/audit" then {
      let audit_rows = query("SELECT action, dept, details, timestamp FROM audit_log ORDER BY id DESC LIMIT 20", [])
      let output = "Last 20 audit events:\n"
      let count = 0.0
      each row in audit_rows {
        let action = redact(to_string(json_get(row, "action", "")), "all")
        let dept = redact(to_string(json_get(row, "dept", "")), "all")
        let ts = redact(to_string(json_get(row, "timestamp", "")), "all")
        let output = output + "[" + ts + "] " + action + " (" + dept + ")\n"
        let count = count + 1.0
        if count >= 20.0 then { }
      }
      let _ = SendTelegramReply(chat_id, output)
      let _ = AuditLog("audit_view", "system", "audit log viewed")
      return respond("200 ok")
    }

    // /narads
    if text == "/narads" then {
      let narad_rows = query("SELECT id, title, status, risk_level, created_at FROM narads ORDER BY id DESC LIMIT 10", [])
      let output = "Open narads:\n"
      each row in narad_rows {
        let nid = redact(to_string(json_get(row, "id", "")), "all")
        let title = redact(to_string(json_get(row, "title", "")), "all")
        let status = redact(to_string(json_get(row, "status", "")), "all")
        let output = output + nid + " [" + status + "] " + title + "\n"
      }
      let _ = SendTelegramReply(chat_id, output)
      return respond("200 ok")
    }

    // /dept <slug>
    if starts_with(text, "/dept ") then {
      let slug = substring(text, 6.0, length(text))
      let render_url = env("RENDER_URL")
      let _ = SendTelegramReply(chat_id, render_url + "/dept-dashboard/" + trim(slug))
      return respond("200 ok")
    }

    // /archive — TWO modes (narad 3/6):
    //   /archive <doc_id> — legacy: publish MiniApp report to archive channel
    //   /archive (no args) — legacy: publish last MiniApp report
    //   /archive <dept> [filter] — NEW: search dept_archive for generic depts
    if starts_with(text, "/archive") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let arg1 = trim(get(parts, 1.0))
        if arg1 == "list" then {
          let render_url = env("RENDER_URL")
          let token = TgToken()
          let arch_body = json_encode({
            chat_id: to_float(chat_id),
            text: "Архив отчётов",
            reply_markup: {
              inline_keyboard: [[{
                text: "Открыть архив",
                web_app: { url: render_url + "/archive/browse" }
              }]]
            }
          })
          let _ = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", arch_body, "application/json"))
          return respond("200 ok")
        }
        // Check if arg1 is a generic dept name → dept_archive search
        if arg1 == "marketing" or arg1 == "finance" or arg1 == "legal" then {
          let filter_text = ""
          if length(parts) > 2.0 then {
            let filter_text = substring(text, 9.0 + length(arg1) + 1.0, length(text))
          }
          let rows_json = ArchiveSearch(arg1, trim(filter_text))
          let formatted = FormatArchiveRows(rows_json)
          let _ = SendTelegramReply(chat_id, "Архив " + arg1 + ":\n" + formatted)
        } else {
          // Legacy: publish specific MiniApp doc by doc_id
          let doc_id = arg1
          let doc_rows = query("SELECT dept, title, raw_text FROM miniapp_responses WHERE id = ?", [doc_id])
          let doc_dept = ""
          let doc_title = ""
          let doc_content = ""
          if length(doc_rows) > 0.0 then {
            let first = get(doc_rows, 0.0)
            let doc_dept = redact(to_string(json_get(first, "dept", "")), "all")
            let doc_title = redact(to_string(json_get(first, "title", "")), "all")
            let doc_content = redact(to_string(json_get(first, "raw_text", "")), "all")
          }
          if doc_dept != "" then {
            let msg_id = PublishToArchive(doc_id, doc_dept, doc_title, doc_content)
            let _ = SendTelegramReply(chat_id, "Archived: " + doc_title + " (msg_id: " + msg_id + ")")
          } else {
            let _ = SendTelegramReply(chat_id, "Report " + doc_id + " not found.")
          }
        }
      } else {
        // No args: show archive status
        let last_rows = TryVal(try query("SELECT id, dept, title FROM miniapp_responses ORDER BY created_at DESC LIMIT 1", []))
        if to_string(last_rows) == "()" or length(last_rows) == 0.0 then {
          let _ = SendTelegramReply(chat_id, "No reports to archive.")
        } else {
          let first = TryVal(try get(last_rows, 0.0))
          let last_title = redact(to_string(TryVal(try json_get(first, "title", "?"))), "all")
          let _ = SendTelegramReply(chat_id, "Last report: " + last_title + "\nUse /archive list to browse.")
        }
      }
      return respond("200 ok")
    }

    // /verify <dept> <id> <outcome> — verify an archived entry (narad 3/6, extended narad 8)
    // Structured: /verify finance <id> actual=<число> | /verify legal <id> outcome=clean|rewrite_required
    // Legacy: /verify <dept> <id> <free text> (marketing, etc.)
    if starts_with(text, "/verify ") then {
      let rest = substring(text, 8.0, length(text))
      let parts = split(rest, _sp)
      if length(parts) >= 3.0 then {
        let dept = trim(get(parts, 0.0))
        let entry_id = to_int(trim(get(parts, 1.0)))
        // outcome = everything after dept and id (may contain spaces, e.g. "actual=145200" or "outcome=clean")
        let prefix_len = length(dept) + length(trim(get(parts, 1.0))) + 2.0
        let mut outcome = substring(rest, prefix_len, length(rest))
        if outcome == "" then { outcome = "подтверждено" }
        // Narad 8: route to structured verify
        let result = VerifyArchiveEntryStructured(dept, entry_id, outcome)
        let _ = AuditLog("archive_verify", dept, "id=" + to_string(entry_id) + " outcome=" + substring(outcome, 0.0, 80.0))
        let _ = SendTelegramReply(chat_id, result)
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /verify <dept> <id> <исход>\nStructured: /verify finance 3 actual=145200\n           /verify legal 5 outcome=clean\nLegacy: /verify marketing 2 текст исхода\nDepts: marketing, finance, legal")
      }
      return respond("200 ok")
    }

    // /score <dept> — activity + calibrated metrics (narad 3/6 + narad 8)
    if starts_with(text, "/score ") then {
      let dept = trim(substring(text, 7.0, length(text)))
      if dept == "marketing" or dept == "finance" or dept == "legal" then {
        let result = TryVal(try ScoreDept(dept))
        if to_string(result) == "()" then {
          let _ = SendTelegramReply(chat_id, "ScoreDept error для " + dept)
        } else {
          let _ = SendTelegramReply(chat_id, result)
        }
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /score <dept>\nGeneric depts: marketing, finance, legal\nFinance: базовая активность + MAPE (при >=10 verified pairs)\nLegal: базовая активность + % без rewrites (при >=10 verified)")
      }
      return respond("200 ok")
    }

    // /autoarchive on/off (MEGA-3)
    if starts_with(text, "/autoarchive") then {
      let parts = split(text, _sp)
      if length(parts) > 1.0 then {
        let mode = trim(get(parts, 1.0))
        kv_set("auto_archive", mode)
        let _ = AuditLog("autoarchive_set", "archive", "mode=" + mode)
        if mode == "on" then {
          let _ = SendTelegramReply(chat_id, "Auto-archive ON. All reports > 800 chars will be published to archive channel.")
        } else {
          let _ = SendTelegramReply(chat_id, "Auto-archive OFF. Use /archive manually.")
        }
      } else {
        let mut current = kv_get("auto_archive")
        if current == "" then { current = "on" }
        let _ = SendTelegramReply(chat_id, "Auto-archive: " + current)
      }
      return respond("200 ok")
    }

    // /search — search archive + memories (MEGA-3)
    if starts_with(text, "/search") then {
      let query_text = substring(text, 8.0, length(text))
      if query_text != "" then {
        let search_result = SearchArchive(query_text)
        let results_json = parse_json(search_result)
        let results_raw = redact(to_string(json_get(results_json, "results", "[]")), "all")
        let mem_raw = redact(to_string(json_get(results_json, "memories", "[]")), "all")
        let results = to_string(results_raw)
        let mems = to_string(mem_raw)
        let _ = AuditLog("archive_search", "archive", "query=" + query_text)
        let out = ""
        if results != "[]" and results != "" then {
          let out = "Архив:\n" + substring(results, 0.0, 1500.0)
        }
        if mems != "[]" and mems != "" then {
          let out = out + "\nПамять:\n" + substring(mems, 0.0, 1500.0)
        }
        if out != "" then {
          let _ = SendTelegramReply(chat_id, out)
        } else {
          let _ = SendTelegramReply(chat_id, "Nothing found for: " + query_text)
        }
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /search <query>")
      }
      return respond("200 ok")
    }

    // FO-035 C.1: короткая форма проекта — активный диалог перехватывает ввод
    if kv_get("forge_form_step_" + chat_id) != "" and kv_get("forge_form_step_" + chat_id) != "done" then {
      if trim(text) == "/cancelform" then {
        kv_set("forge_form_step_" + chat_id, "done")
        let _ = SendTelegramReply(chat_id, "Форма проекта отменена.")
        return respond("200 ok")
      }
      let form_reply = ForgeShortFormStep(chat_id, text)
      if form_reply != "" then {
        if starts_with(form_reply, "done:") == false then { let _ = SendTelegramReply(chat_id, form_reply) }
        return respond("200 ok")
      }
    }

    // /newproject — FO-035 C.1: короткая форма (4 поля, с телефона)
    if starts_with(text, "/newproject") then {
      kv_set("forge_form_step_" + chat_id, "name")
      let _ = SendTelegramReply(chat_id, "Новый проект FORGE — короткая форма (4 вопроса). /cancelform — отмена.\n1/4. Название проекта?")
      return respond("200 ok")
    }

    // ── SHOP-5 (#172): /товар /вотч — досье товара + вотчлист ──────
    // UX единым блоком: питон-плоскость (/shop/*) сама снимает срез,
    // отправляет постер PNG + caption-ссылки + inline-кнопки «Купить»
    // и текст-выжимку; mlog даёт ack и пересылает только отказы.
    // Схема: /товар <запрос> → досье; /вотч [цель|скидка N|наличие] → слежение.
    if text == "/товар" then {
      let _ = SendTelegramReply(chat_id, "Usage: /товар <конкретный запрос или ссылка> — сразу соберу досье с площадок (WB, Ozon). Затем /вотч <цель BYN | скидка N | наличие> — поставлю на слежение 4 раза/сутки. Хочешь, уточню параметры сама — просто напиши без команды: хочу купить …")
      return respond("200 ok")
    }
    if starts_with(text, "/товар ") then {
      let rest_p = trim(substring(text, 7.0, length(text)))
      let _ = RecordUserMessage(chat_id, "shop", text)
      let _ = SendTelegramReply(chat_id, "Собираю досье по «" + rest_p + "» — WB/Ozon, минута.")
      let resp_p = TryVal(try http_post("http://127.0.0.1:4000/shop/product", json_encode({query: rest_p, chat_id: chat_id}), "application/json", 45.0))
      if to_string(resp_p) == "()" then {
        let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость недоступна (llm_proxy не отвечает).")
      } else {
        let parsed_p = TryVal(try parse_json(resp_p))
        if redact(to_string(parsed_p), "hash_only") == redact("()", "hash_only") then {
          let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость вернула нечитаемый ответ.")
        } else {
          if redact(to_string(json_get(parsed_p, "ok", "")), "all") != "True" and redact(to_string(json_get(parsed_p, "ok", "")), "all") != "true" then {
            let _ = SendTelegramReply(chat_id, "ОТКАЗ: досье не собрано: " + redact(to_string(json_get(parsed_p, "error", "нет деталей")), "all"))
          }
        }
      }
      return respond("200 ok")
    }
    if starts_with(text, "/вотч") then {
      let rest_w = ""
      if length(text) > 6.0 then { let rest_w = trim(substring(text, 6.0, length(text))) }
      let _ = RecordUserMessage(chat_id, "shop", text)
      let resp_w = TryVal(try http_post("http://127.0.0.1:4000/shop/watch", json_encode({args: rest_w, chat_id: chat_id}), "application/json", 20.0))
      if to_string(resp_w) == "()" then {
        let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость недоступна (llm_proxy не отвечает).")
      } else {
        let parsed_w = TryVal(try parse_json(resp_w))
        if redact(to_string(parsed_w), "hash_only") == redact("()", "hash_only") then {
          let _ = SendTelegramReply(chat_id, "ОТКАЗ: shop-плоскость вернула нечитаемый ответ.")
        } else {
          let reply_w = to_string(json_get(parsed_w, "reply", ""))
          if reply_w != "" then {
            let _ = SendTelegramReply(chat_id, reply_w)
          } else {
            if redact(to_string(json_get(parsed_w, "ok", "")), "all") == "True" or redact(to_string(json_get(parsed_w, "ok", "")), "all") == "true" then {
              let _ = SendTelegramReply(chat_id, "Вотч поставлен. Проверка 4 раза/сутки, события — в личку.")
            } else {
              let _ = SendTelegramReply(chat_id, "ОТКАЗ: " + redact(to_string(json_get(parsed_w, "error", "нет деталей")), "all"))
            }
          }
        }
      }
      return respond("200 ok")
    }

    // /forge-export — FO-042 B.2 (наряд #149): выгрузка состояния FORGE
    // (проекты, открытые задачи, гейты без решения, открытые замечания)
    // JSON-файлом документом. Та же выкладка, что идёт с утренним брифом.
    if starts_with(text, "/forge-export") then {
      let _ = RecordUserMessage(chat_id, "dev", text)
      let resp_x = TryVal(try http_post("http://127.0.0.1:4000/forge/export-state?secret=" + env("CRON_SECRET"), json_encode({chat_id: chat_id}), "application/json"))
      if to_string(resp_x) == "()" then {
        let _ = SendTelegramReply(chat_id, "ОТКАЗ: export-плоскость недоступна (llm_proxy не отвечает).")
      } else {
        let parsed_x = TryVal(try parse_json(resp_x))
        if redact(to_string(parsed_x), "hash_only") == redact("()", "hash_only") then {
          let _ = SendTelegramReply(chat_id, "ОТКАЗ: export-плоскость вернула нечитаемый ответ.")
        } else {
          if redact(to_string(json_get(parsed_x, "ok", "")), "all") == "True" or redact(to_string(json_get(parsed_x, "ok", "")), "all") == "true" then {
            let c = to_string(json_get(parsed_x, "counts", ""))
            let _ = redact(SendTelegramReply(chat_id, "Выгрузка FORGE отправлена документом: проектов " + to_string(json_get(c, "projects", "?")) + ", открытых задач " + to_string(json_get(c, "tasks_open", "?")) + ", гейтов без решения " + to_string(json_get(c, "gates_pending", "?")) + ", открытых замечаний " + to_string(json_get(c, "remarks_open", "?")) + "."), "all")
          } else {
            let _ = SendTelegramReply(chat_id, "ОТКАЗ: выгрузка не сработала: " + redact(to_string(json_get(parsed_x, "error", "нет деталей")), "all"))
          }
        }
      }
      return respond("200 ok")
    }

    // /chain continue — FO-027: возобновление цепочки с последней ok-степы
    if starts_with(text, "/chain continue ") then {
      let rest_c = substring(text, 16.0, length(text))
      let parts_c = split(rest_c, _sp)
      if length(parts_c) > 1.0 then {
        let chain_id_c = trim(to_string(get(parts_c, 0.0)))
        let query_c = substring(rest_c, length(chain_id_c) + 1.0, length(rest_c))
        let _ = RecordUserMessage(chat_id, "chain", text)
        let result_c = ResumeChainSteps(chain_id_c, "", query_c, chat_id)
        let _ = SendTelegramReply(chat_id, result_c)
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /chain continue <chain_id> <query>")
      }
      return respond("200 ok")
    }

    // /chain
    if starts_with(text, "/chain") then {
      let rest = substring(text, 7.0, length(text))
      // FO-026: mode prefix — parallel | debate. Без mode — прежний sequential 1-в-1.
      let mut mode = ""
      let mut rest2 = rest
      let trimmed_rest = trim(rest)
      if starts_with(trimmed_rest, "parallel ") then {
        let mode = "parallel"
        let rest2 = substring(trimmed_rest, 9.0, length(trimmed_rest))
      }
      if starts_with(trimmed_rest, "debate ") then {
        let mode = "debate"
        let rest2 = substring(trimmed_rest, 7.0, length(trimmed_rest))
      }
      if mode == "" then {
        if starts_with(trimmed_rest, "parallel") and length(trimmed_rest) == 8.0 then { let mode = "parallel" }
        if starts_with(trimmed_rest, "debate") and length(trimmed_rest) == 6.0 then { let mode = "debate" }
      }
      if mode != "" then {
        // Fan-out/debate: департаменты через запятую + query
        let parts2 = split(rest2, _sp)
        if length(parts2) > 1.0 then {
          let dept_list = trim(to_string(get(parts2, 0.0)))
          let query_fo = substring(rest2, length(dept_list) + 1.0, length(rest2))
          // CSV → JSON array строк (вручную: json_encode завёрнул бы как строку)
          let arr = "["
          let mut i = 0.0
          each dslug in split(dept_list, ",") {
            let dd = trim(to_string(dslug))
            if dd != "" then {
              if i > 0.0 then { let arr = arr + "," }
              let arr = arr + "\"" + dd + "\""
              let i = i + 1.0
            }
          }
          let arr = arr + "]"
          let _ = RecordUserMessage(chat_id, "chain", text)
          let _ = AuditLog("chain_start", "system", "chain " + mode + ": " + dept_list)
          let body_fo = "{\"mode\":\"" + mode + "\",\"chat_id\":\"" + chat_id + "\",\"depts\":" + arr + ",\"query\":\"" + JsonEscapeText(query_fo) + "\"}"
          // Таймаут группы: debate ≤ 2 раунда × шаг + судья
          // #596 A.1: лимит бинаря — 1..300 с (HTTP_TIMEOUT_RANGE): 540.0
          // отвергался ДО запроса, fan-out всегда падал в «недоступна».
          // 300.0 — максимум легала; для длинных групп — фоновый режим
          // (как #596 A.2), обходов лимита нет.
          let resp_fo = TryVal(try http_post("http://127.0.0.1:4000/chain/fanout", body_fo, "application/json", 300.0))
          if to_string(resp_fo) == "()" then {
            let _ = SendTelegramReply(chat_id, "Chain " + mode + ": плоскость fan-out недоступна (proxy не отвечает). Fallback: /chain " + dept_list + " <query> — последовательно.")
          } else {
            let parsed_fo = TryVal(try parse_json(resp_fo))
            if to_string(parsed_fo) == "()" then {
              let _ = SendTelegramReply(chat_id, "Chain " + mode + ": ошибка разбора ответа fan-out.")
            } else {
              let status_fo = redact(to_string(json_get(parsed_fo, "status", "error")), "all")
              if status_fo == "ok" then {
                let gid = redact(to_string(json_get(parsed_fo, "group_id", "")), "all")
                let judge = redact(to_string(json_get(parsed_fo, "judge", "")), "all")
                let mut out = substring(judge, 0.0, 3500.0)
                if length(judge) > 3500.0 then { let out = out + "\n…(обрезано — полное в отчёте)" }
                let _ = SendTelegramReply(chat_id, out)
                let _ = SendReport(judge, "chain", "Chain " + mode + " " + gid, "2.0", chat_id)
              } else {
                let msg_fo = redact(to_string(json_get(parsed_fo, "message", "fan-out отказал")), "all")
                let _ = SendTelegramReply(chat_id, "Chain " + mode + " отклонён: " + msg_fo)
              }
            }
          }
        } else {
          let _ = SendTelegramReply(chat_id, "Usage: /chain " + mode + " dept1,dept2 <query>")
        }
        return respond("200 ok")
      }
      // ── Sequential (без изменений, обратная совместимость 1-в-1) ──
      // №421: parts — шэдоу-биндинг (предсуществующий стиль); решение через
      // вымытую строковую форму длины (число redact не меняет)
      if to_float(redact(to_string(length(parts)), "all")) > 1.0 then {
        let dept_chain = trim(get(parts, 0.0))
        let query = substring(rest, length(dept_chain) + 1.0, length(rest))
        let _ = RecordUserMessage(chat_id, "chain", text)
        let _ = AuditLog("chain_start", "system", "chain: " + dept_chain)
        let result = ExecuteChain(dept_chain, query, chat_id)
        let _ = SendTelegramReply(chat_id, result)
      } else {
        let _ = SendTelegramReply(chat_id, "Usage: /chain dept1+dept2 <query>\nExample: /chain osp+legal test query\nMax 3 departments per chain.\nFO-026: /chain parallel qa,legal <query> | /chain debate qa,legal <query>")
      }
      return respond("200 ok")
    }

    // /factory
    if starts_with(text, "/factory") then {
      let query = substring(text, 9.0, length(text))
      let active = kv_get("active_order")
      if active != "" then {
        let result = HandleFactoryStep(active, query, chat_id)
        let _ = SendTelegramReply(chat_id, result)
        return respond("200 ok")
      }

      if starts_with(text, "/factory_review") then {
        let id = substring(text, 16.0, length(text))
        let _ = SendTelegramReply(chat_id, "Factory review for " + trim(id) + ": pending")
        return respond("200 ok")
      }
      if starts_with(text, "/factory_deploy") then {
        let id = substring(text, 16.0, length(text))
        db_execute("UPDATE factory_orders SET status = 'deployed' WHERE id = ?1", [trim(id)])
        let _ = AuditLog("factory_deploy", "factory", "deployed: " + trim(id))
        let _ = SendTelegramReply(chat_id, "Factory order " + trim(id) + " deployed.")
        return respond("200 ok")
      }
      if starts_with(text, "/factory_deliver") then {
        let id = substring(text, 17.0, length(text))
        db_execute("UPDATE factory_orders SET status = 'delivered', completed_at = datetime('now') WHERE id = ?1", [trim(id)])
        let _ = SendTelegramReply(chat_id, "Factory order " + trim(id) + " delivered.")
        return respond("200 ok")
      }
      if text == "/factory_list" then {
        let rows = query("SELECT id, client_name, status, created_at FROM factory_orders ORDER BY id DESC LIMIT 10", [])
        let _ = SendTelegramReply(chat_id, "Factory orders: see " + env("RENDER_URL") + "/office-dashboard")
        return respond("200 ok")
      }

      let order_id = "fo-" + to_string(now())
      kv_set("active_order", order_id)
      kv_set("order_step_" + order_id, "1")
      db_execute("INSERT INTO factory_orders (id, status) VALUES (?1, 'intake')", [order_id])
      let _ = AuditLog("factory_start", "factory", "new order: " + order_id)
      let _ = SendTelegramReply(chat_id, "Factory: Creating new office.\n\nStep 1/7: What is the client's name or company?")
      return respond("200 ok")
    }

    // /admin
    if starts_with(text, "/admin") then {
      let query = substring(text, 7.0, length(text))
      let _ = AuditLog("admin_cmd", "admin", text)

      if query == "" or query == " " then {
        let _ = SendTelegramReply(chat_id, "Admin commands:\n/status /build <task> /fix <bug>\n/analyze /scan /tour /docs\n/graph /impact <file>\n/proposals /narads /rollback <id>\n/report /health /errors [часы] /keys /board")
        return respond("200 ok")
      }
      // TEAM-3 #482 A.6: видимость доски находок — публикации за сутки + подписки
      if query == "board" then {
        let _ = SendTelegramReply(chat_id, TeamBoardAdminLine())
        return respond("200 ok")
      }
      // #486 A.5: проверка валидности ключей и провайдеров по запросу
      if query == "keys" then {
        // хотфикс 2026-10-06: ответ сети — недоверенные данные; 0.28.0 запрещает
        // решать if до одностороннего redact (UNTRUSTED_DECISION, как в c496dfa).
        let kr = redact(to_string(TryVal(try http_get("http://127.0.0.1:4000/admin/keys/run", 90.0))), "all")
        if kr == "()" then {
          let _ = SendTelegramReply(chat_id, "Проверка ключей недоступна (admin/keys/run не ответил — см. audit_log)")
        } else {
          let _ = SendTelegramReply(chat_id, kr)
        }
        return respond("200 ok")
      }
      if query == "status" then {
        let _ = SendTelegramReply(chat_id, AdminStatus())
        return respond("200 ok")
      }
      if starts_with(query, "build ") then {
        let task = substring(query, 6.0, length(query))
        let narad_id = AdminBuild(task, chat_id)
        return respond("200 ok")
      }
      if starts_with(query, "fix ") then {
        let bug = substring(query, 4.0, length(query))
        let reply = HandleDeptQuery("admin", "Fix bug: " + bug, chat_id)
        let _ = SendTelegramReply(chat_id, reply)
        return respond("200 ok")
      }
      if query == "analyze" then {
        let _ = SendTelegramReply(chat_id, AdminAnalyze())
        return respond("200 ok")
      }
      if query == "scan" then {
        let _ = SendTelegramReply(chat_id, AdminScan())
        return respond("200 ok")
      }
      if query == "tour" then {
        let _ = SendTelegramReply(chat_id, AdminTour())
        return respond("200 ok")
      }
      if query == "docs" then {
        let _ = SendTelegramReply(chat_id, AdminDocs())
        return respond("200 ok")
      }
      if query == "graph" then {
        let _ = SendTelegramReply(chat_id, AdminGraph())
        return respond("200 ok")
      }
      if starts_with(query, "impact ") then {
        let file = substring(query, 7.0, length(query))
        let _ = SendTelegramReply(chat_id, AdminImpact(file))
        return respond("200 ok")
      }
      if query == "proposals" then {
        let _ = SendTelegramReply(chat_id, AdminProposals())
        return respond("200 ok")
      }
      if query == "narads" then {
        let _ = SendTelegramReply(chat_id, AdminNarads())
        return respond("200 ok")
      }
      if starts_with(query, "rollback ") then {
        let narad_id = substring(query, 9.0, length(query))
        let _ = SendTelegramReply(chat_id, AdminRollback(narad_id))
        return respond("200 ok")
      }
      if query == "report" then {
        let _ = SendTelegramReply(chat_id, AdminReport())
        return respond("200 ok")
      }
      if query == "health" then {
        let _ = SendTelegramReply(chat_id, AdminHealth())
        return respond("200 ok")
      }
      // #405 A.2: журнал ошибок/сбоев по реальным записям (error_log/audit_log/trace_log)
      if query == "errors" or starts_with(query, "errors ") then {
        let hours = trim(substring(query, 7.0, length(query)))
        let _ = SendTelegramReply(chat_id, AdminLogDigest(hours))
        return respond("200 ok")
      }
      let reply = HandleDeptQuery("admin", query, chat_id)
      let _ = SendTelegramReply(chat_id, reply)
      return respond("200 ok")
    }

    // /lz special commands (deep research, compare, channels)
    if starts_with(text, "/lz") then {
      let query = substring(text, 4.0, length(text))
      let _ = RecordUserMessage(chat_id, "lz", text)

      // /lz deep <query> — исследование в глубину (2-5 мин)
      if starts_with(query, " deep ") then {
        let deep_query = substring(query, 6.0, length(query))
        let reply = LZDeepResearcherProfile(deep_query, chat_id)
        let _ = SendReport(reply, "lz", "Deep research: " + deep_query, "4.0", chat_id)
        return respond("200 ok")
      }
      // /lz scan <query> — 9-source deep scan (30 sec)
      if starts_with(query, " scan ") then {
        let scan_query = substring(query, 6.0, length(query))
        let reply = LZDeepScan(scan_query, chat_id)
        let _ = SendReport(reply, "lz", "Scan: " + scan_query, "3.0", chat_id)
        return respond("200 ok")
      }
      // /lz all <query> — scan + deep (full pipeline)
      if starts_with(query, " all ") then {
        let all_query = substring(query, 5.0, length(query))
        let reply = LZAllScan(all_query, chat_id)
        let _ = SendReport(reply, "lz", "Full scan: " + all_query, "4.0", chat_id)
        return respond("200 ok")
      }
      // Подкоманда compare удалена из /lz (решение владельца по #284, вариант 2:
      // была сломана с рождения — вызывала несуществующий паттерн; исходный замысел
      // умер вместе с Apodex #282; анализ конкурирующих альтернатив остаётся в Gate 7
      // LZGateCompetingCheck и в скилл-контексте LoadLZSkills)
      // /lz news [query] — news monitoring
      if starts_with(query, " news") then {
        let news_query = substring(query, 6.0, length(query))
        let _ = SendTelegramReply(chat_id, "Анализирую свежие события...")
        let body = json_encode({query: news_query, limit: 15, chat_id: chat_id})
        let result = TryVal(try http_post("http://127.0.0.1:4000/lz/news", body, "application/json"))
        if to_string(result) == "()" then {
          let _ = SendTelegramReply(chat_id, "Сервис новостей временно недоступен.")
          return respond("200 ok")
        } else {
          let parsed = parse_json(result)
          let analysis = redact(to_string(json_get(parsed, "response", "Нет свежих событий")), "all")
          let mut news_title = "Мониторинг информпространства"
          if news_query != "" then { news_title = "События: " + news_query }
          let _ = SendReport(analysis, "lz", news_title, "2.0", chat_id)
        }
        return respond("200 ok")
      }

      // Default /lz handler — auto-detect scan intent
      let t = lower(query)
      let is_scan = contains(t, "скан") or contains(t, "развед") or contains(t, "новости") or contains(t, "событи") or contains(t, "что происход") or contains(t, "свеж") or contains(t, "монитор") or contains(t, "обзор") or contains(t, "дайджест") or contains(t, "что нового") or contains(t, "scan") or contains(t, "intelligence") or contains(t, "briefing")
      if is_scan then {
        let reply = TryVal(try LZDeepScan(query, chat_id))
        if to_string(reply) == "()" or reply == "" then {
          // naryad-362: «остальное» — нативный HandleLZ (~24 подкоманды, 8
          // гейтов) с полным текстом команды (диспетчер ждёт префикс /lz)
          let reply = HandleLZ(text, chat_id)
          let _ = SendReport(reply, "lz", query, "2.0", chat_id)
        } else {
          let _ = SendReport(reply, "lz", "Scan: " + query, "3.0", chat_id)
        }
      } else {
        // naryad-362: было HandleDeptQuery — generic LLM в обход гейтов ЛЗ
        let reply = HandleLZ(text, chat_id)
        let _ = SendReport(reply, "lz", query, "2.0", chat_id)
      }
      return respond("200 ok")
    }

    // /lz_channel — add Telegram channel to LZ monitoring (MEGA-4)
    if starts_with(text, "/lz_channel add ") then {
      let channel_params = substring(text, 15.0, length(text))
      let params = split(channel_params, _sp)
      let ch_id = trim(get(params, 0.0))
      let category = "general"
      if length(params) > 1.0 then { let category = trim(get(params, 1.0)) }
      let result = LZChannelAdd(ch_id, category)
      let _ = SendTelegramReply(chat_id, result)
      return respond("200 ok")
    }
    // /lz_channels — list monitored channels
    if text == "/lz_channels" then {
      let result = LZChannels()
      let _ = SendTelegramReply(chat_id, result)
      return respond("200 ok")
    }
    // /lz_monitor <topic> — add topic to daily monitoring
    if starts_with(text, "/lz_monitor ") then {
      let topic = substring(text, 12.0, length(text))
      let result = LZMonitor(topic)
      let _ = SendTelegramReply(chat_id, result)
      return respond("200 ok")
    }

    // /lz osint <username> — OSINT 840+ platforms (30-120 sec)
    if starts_with(text, "/lz osint ") then {
      let username = trim(substring(text, 10.0, length(text)))
      let _ = RecordUserMessage(chat_id, "lz", text)
      send_message(chat_id, "Сканирую " + username + " по 840+ платформам... (30-120 сек)")

      let body = json_encode({
        username: username,
        level: "basic",
        tor: false,
        chat_id: chat_id,
        caller_id: chat_id
      })
      let result = TryVal(try http_post("http://127.0.0.1:4000/lz/osint", body, "application/json", 240.0))
      if to_string(result) == "()" then {
        let _ = SendReport("OSINT-сканирование недоступно (прокси не отвечает).", "lz", "OSINT: " + username, "3.0", chat_id)
        return respond("200 ok")
      } else {
        let parsed = parse_json(result)
        let analysis = redact(to_string(json_get(parsed, "response", "Ошибка OSINT-сканирования")), "all")
        let found_count = redact(to_string(json_get(parsed, "osint_data.found", "0")), "all")

        let title = "OSINT: " + username + " (" + to_string(found_count) + " платформ)"
        let _ = SendReport(analysis, "lz", title, "3.0", chat_id)
        let _ = AuditLog("lz_osint", "lz", "user=" + username + " result=ok")
      }
      return respond("200 ok")
    }

    // /lz osint advanced <username> — extended scan with name variations
    if starts_with(text, "/lz osint advanced ") then {
      let username = trim(substring(text, 19.0, length(text)))
      let _ = RecordUserMessage(chat_id, "lz", text)
      send_message(chat_id, "Расширенное сканирование " + username + " (вариации имени)... (60-180 сек)")

      let body = json_encode({
        username: username,
        level: "advanced",
        tor: false,
        chat_id: chat_id,
        caller_id: chat_id
      })
      let result = TryVal(try http_post("http://127.0.0.1:4000/lz/osint", body, "application/json", 240.0))
      if to_string(result) == "()" then {
        let _ = SendReport("OSINT-сканирование недоступно (прокси не отвечает).", "lz", "OSINT Advanced: " + username, "4.0", chat_id)
        return respond("200 ok")
      } else {
        let parsed = parse_json(result)
        let analysis = redact(to_string(json_get(parsed, "response", "Ошибка OSINT-сканирования")), "all")
        let _ = SendReport(analysis, "lz", "OSINT Advanced: " + username, "4.0", chat_id)
      }
      return respond("200 ok")
    }

    // /lz profile <name> — comprehensive profile (OSINT + Web + Social)
    if starts_with(text, "/lz profile ") then {
      let name = trim(substring(text, 12.0, length(text)))
      let _ = RecordUserMessage(chat_id, "lz", text)
      send_message(chat_id, "Строю комплексный профиль " + name + "... OSINT + Web + Social")

      // 1. OSINT scan
      let osint_body = json_encode({ username: name, level: "basic", chat_id: chat_id, caller_id: chat_id })
      let mut osint_result = TryVal(try http_post("http://127.0.0.1:4000/lz/osint", osint_body, "application/json", 240.0))
      if to_string(osint_result) == "()" then { osint_result = "(OSINT-данные недоступны)" }

      // 2. Web search
      let web_result = web_search(name, 5.0)

      // 3. LLM builds profile
      let lz_profile = redact(read_file("library/lz.md"), "all")
      let profile_prompt = lz_profile + "\n\nПостроить комплексный цифровой профиль на основе:\n1. OSINT (840+ платформ)\n2. Веб-поиск\n\nСтруктура:\n- Кто этот человек/бренд\n- Цифровой след (категории платформ)\n- Публичная активность\n- Профессиональный профиль\n- Аномалии и красные флаги\n- Оценка цифровой гигиены (1-10)"

      let combined = "OSINT:\n" + osint_result + "\n\nWeb:\n" + web_result
      let analysis = redact(call_llm(profile_prompt, combined), "all")

      let _ = SendReport(analysis, "lz", "Профиль: " + name, "4.0", chat_id)
      return respond("200 ok")
    }

    // /osp special commands
    if starts_with(text, "/osp") then {
      let query = substring(text, 5.0, length(text))
      // /osp profile <actor> — OSINT-based actor profiling
      if starts_with(query, "profile ") then {
        let actor = trim(substring(query, 8.0, length(query)))
        let _ = RecordUserMessage(chat_id, "osp", text)
        send_message(chat_id, "ОСП: профилирование актора " + actor + "...")

        // OSINT data from LZ proxy
        let osint_body = json_encode({ username: actor, level: "basic", chat_id: chat_id, caller_id: chat_id })
        let mut osint = TryVal(try http_post("http://127.0.0.1:4000/lz/osint", osint_body, "application/json", 240.0))
        if to_string(osint) == "()" then { osint = "(OSINT-данные недоступны)" }

        // OSP analysis via LLM
        let osp_profile = redact(read_file("library/osp.md"), "all")
        let profile_prompt = osp_profile + "\n\nПрофилирование актора по методологии ОСП:\n1. Цифровой след -> паттерн поведения\n2. Платформы присутствия -> social graph inference\n3. Отсутствие на платформах -> что скрывает?\n4. Временные паттерны -> когда активен\n5. Cross-reference -> противоречия между профилями\n6. Гипотезы мотивации (ACH)\n7. Используй [ФАКТ], [ИНТЕРПРЕТАЦИЯ], [СПЕКУЛЯЦИЯ]"

        let analysis = redact(to_string(TryVal(try call_llm(profile_prompt, "Актор: " + actor + "\n\nOSINT данные:\n" + osint))), "all")
        if to_string(analysis) == "()" then {
          let _ = SendTelegramReply(chat_id, "ОСП: не удалось получить анализ профиля (LLM недоступна).")
        } else {
          let _ = SendReport(analysis, "osp", "Профиль актора: " + actor, "3.0", chat_id)
        }
        return respond("200 ok")
      }
      let _ = RecordUserMessage(chat_id, "osp", text)
      // naryad-362: ветка «остальное» — нативный HandleOSP (~20 подкоманд, 12
      // гейтов). Было HandleDeptQuery — generic LLM в обход хард-гейтов ОСП;
      // прямые команды отдела не доходили до его диспетчера. HandleOSP ждёт
      // полный текст с префиксом /osp — передаём text, а не strip-нутый query.
      let reply = TryVal(try HandleOSP(text, chat_id))
      if to_string(reply) == "()" or reply == "" then {
        let _ = SendTelegramReply(chat_id, "ОСП: не удалось получить ответ. Попробуйте позже.")
      } else {
        let _ = SendReport(reply, "osp", "OSP: " + substring(query, 0.0, 50.0), "3.0", chat_id)
      }
      return respond("200 ok")
    }

    // /legal check <entity> — due diligence via OSINT
    if starts_with(text, "/legal check ") then {
      let entity = trim(substring(text, 13.0, length(text)))
      send_message(chat_id, "Юрист: due diligence — проверка " + entity + "...")

      let osint_body = json_encode({ username: entity, level: "advanced", chat_id: chat_id, caller_id: chat_id })
      let mut osint = TryVal(try http_post("http://127.0.0.1:4000/lz/osint", osint_body, "application/json", 240.0))
      if to_string(osint) == "()" then { osint = "(OSINT-данные недоступны)" }

      let legal_profile = redact(read_file("library/legal.md"), "all")
      let check_prompt = legal_profile + "\n\nDue Diligence проверка контрагента:\n1. Цифровой след — насколько прозрачен?\n2. Профессиональные платформы (LinkedIn, Crunchbase) — совпадают с заявлениями?\n3. Красные флаги — даркнет-форумы, фрод-платформы, NSFW\n4. Возраст аккаунтов — давно ли существуют?\n5. Согласованность информации между платформами\n6. Рекомендация: безопасно / требует внимания / высокий риск\n7. ДИСКЛЕЙМЕР обязателен: \"OSINT-данные собраны из открытых источников. Результаты не гарантируют принадлежность аккаунтов конкретному лицу.\""

      let analysis = redact(call_llm(check_prompt, "Контрагент: " + entity + "\n\nOSINT:\n" + osint), "all")
      let _ = SendReport(analysis, "legal", "Due Diligence: " + entity, "3.0", chat_id)
      return respond("200 ok")
    }

    // /marketing brand-check <brand> — brand availability across 840+ platforms
    if starts_with(text, "/marketing brand-check ") then {
      let brand = trim(substring(text, 22.0, length(text)))
      send_message(chat_id, "Маркетинг: проверка бренда " + brand + " на 840+ платформах...")

      let osint_body = json_encode({
        username: brand,
        level: "advanced",
        chat_id: chat_id,
        caller_id: chat_id
      })
      let mut osint = TryVal(try http_post("http://127.0.0.1:4000/lz/osint", osint_body, "application/json", 240.0))
      if to_string(osint) == "()" then { osint = "(OSINT-данные недоступны)" }

      let marketing_profile = redact(read_file("library/marketing.md"), "all")
      let brand_prompt = marketing_profile + "\n\nАнализ доступности бренда:\n1. На каких платформах имя уже занято?\n2. Кем занято — конкурент или просто тёзка?\n3. На каких ключевых платформах свободно?\n4. Рекомендация: использовать as-is / модифицировать / выбрать другое\n5. Если занято — варианты модификации (добавить _official, HQ, app...)\n6. Приоритетные платформы для регистрации (первые 48 часов после запуска)"

      let analysis = redact(call_llm(brand_prompt, "Бренд: " + brand + "\n\nOSINT:\n" + osint), "all")
      let _ = SendReport(analysis, "marketing", "Brand Check: " + brand, "2.0", chat_id)
      return respond("200 ok")
    }

    // ============================================================

    // ── FOIP-003.10: /marketing-context set|show ──
    if starts_with(text, "/marketing-context set ") then {
      let ctx_text = trim(substring(text, 23.0, length(text)))
      if ctx_text == "" then { send_message(chat_id, "Формат: /marketing-context set <текст продукта>")
return respond("200 ok") }
      let _ = kv_set("product_context:" + chat_id, ctx_text)
      send_message(chat_id, "Контекст продукта сохранён (" + to_string(length(ctx_text)) + " символов).")
      return respond("200 ok")
    }
    if text == "/marketing-context show" then {
      let mut pc = kv_get("product_context:" + chat_id)
      if pc == "" then { pc = kv_get("product_context:default") }
      if to_string(pc) == "()" or pc == "" then {
        send_message(chat_id, "Контекст продукта не задан. Используйте /marketing-context set <текст>")
      } else {
        send_message(chat_id, "Текущий контекст продукта:\n" + pc)
      }
      return respond("200 ok")
    }
    if starts_with(text, "/marketing-context default ") then {
      let def_text = trim(substring(text, 28.0, length(text)))
      if def_text == "" then { send_message(chat_id, "Формат: /marketing-context default <текст по умолчанию>")
return respond("200 ok") }
      let _ = kv_set("product_context:default", def_text)
      send_message(chat_id, "Контекст продукта по умолчанию сохранён.")
      return respond("200 ok")
    }

    // ── FOIP-003.11: /marketing-ideas <запрос> ──
    if starts_with(text, "/marketing-ideas ") then {
      let ideas_query = trim(substring(text, 17.0, length(text)))
      if ideas_query == "" then { send_message(chat_id, "Формат: /marketing-ideas <запрос, например: как привлечь первых пользователей>")
return respond("200 ok") }
      send_message(chat_id, "Подбираю релевантные маркетинговые идеи...")
      let ideas_result = GetRelevantIdeas(ideas_query, "5", chat_id)
      send_message(chat_id, ideas_result)
      return respond("200 ok")
    }

    // ── FOIP-003.12: /cro <текст страницы> ──
    if starts_with(text, "/cro ") then {
      let cro_text = trim(substring(text, 5.0, length(text)))
      if cro_text == "" then { send_message(chat_id, "Формат: /cro <текст страницы или описания для CRO-аудита>")
return respond("200 ok") }
      send_message(chat_id, "CRO-аудит: анализирую конверсионный потенциал...")
      let cro_result = CROAudit(cro_text, chat_id)
      send_message(chat_id, cro_result)
      return respond("200 ok")
    }

    // DEPARTMENT ROUTING (13 depts)
    // ============================================================

    let dept = DetectDepartment(text)
   let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','webhook',?,'ok')", ["step_0_after_detect_dept=" + dept])
    // FOIP-003.15: Classify query tier for model routing
    let tier = ClassifyQueryTier(text, dept)
    let _ = kv_set("query_tier", tier)
    let query = text
    let handled = 0.0

    if starts_with(text, "/") then {
      let parts = split(text, _sp)
      let cmd = get(parts, 0.0)
      if length(parts) > 1.0 then {
        let rest = substring(text, length(cmd) + 1.0, length(text))
        let query = rest
      } else {
        let query = ""
      }
    }

    let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','webhook','step_0b_before_yana_block','ok')")
    if dept == "yana" then {
      let _ = RecordUserMessage(chat_id, "yana", text)
      let _ = db_execute("INSERT INTO trace_log (action,actor,dept,details,status) VALUES ('checkpoint','system','webhook','step_0c_before_HandleYana','ok')")
      // Source fix: routing sets query="" when /command has no args (e.g. bare "/yana").
      // Fall back to full text so recall and LLM get a usable query.
      let mut yana_query = query
      if yana_query == "" then { yana_query = text }
      let reply = HandleYana(yana_query, chat_id)

      // Check if Yana delegated to another department
      // HandleYana returns dept name (e.g. "osp") if delegation detected
      let osp_list = ["osp", "lz", "expert", "marketing", "finance", "legal", "dev", "design", "qa", "visual", "engineering", "kavalnya"]
      let mut is_dept = 0.0
      each d in osp_list {
        if reply == d then { is_dept = 1.0 }
      }

      if is_dept == 1.0 then {
        // Delegate: re-route to the target department
        let delegate_dept = reply
        let delegate_body = json_encode({chat_id: chat_id, text: "/" + delegate_dept + " " + query})
        // Re-enter routing — the target dept handler will process
        if delegate_dept == "osp" then {
          let del_reply = HandleDeptQuery("osp", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "lz" then {
          let del_reply = HandleDeptQuery("lz", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "expert" then {
          let del_reply = HandleDeptQuery("expert", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "marketing" then {
          let del_reply = HandleDeptQuery("marketing", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "finance" then {
          let del_reply = HandleDeptQuery("finance", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "legal" then {
          let del_reply = HandleDeptQuery("legal", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "dev" then {
          let del_reply = HandleDeptQuery("dev", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "design" then {
          let is_img = IsImageRequest(query)
          if is_img == "true" then {
            let err = HandleDesignImage(query, chat_id)
            if length(err) > 0.0 then {
              let _ = SendVoiceReply(chat_id, err, delegate_dept)
            }
          } else {
            let del_reply = HandleDeptQuery("design", query, chat_id)
            let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
            let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
          }
        }
        if delegate_dept == "qa" then {
          let del_reply = HandleDeptQuery("qa", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "visual" then {
          let is_img = IsImageRequest(query)
          if is_img == "true" then {
            let err = HandleDesignImage(query, chat_id)
            if length(err) > 0.0 then {
              let _ = SendVoiceReply(chat_id, err, delegate_dept)
            }
          } else {
            let del_reply = HandleDeptQuery("visual", query, chat_id)
            let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
            let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
          }
        }
        if delegate_dept == "engineering" then {
          let del_reply = HandleDeptQuery("engineering", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        if delegate_dept == "kavalnya" then {
          let del_reply = HandleDeptQuery("kavalnya", query, chat_id)
          let _ = SendVoiceReply(chat_id, del_reply, delegate_dept)
          let _ = SendReport(del_reply, delegate_dept, query, "2.0", chat_id)
        }
        let _ = SendTelegramReply(chat_id, "Яна направила запрос в отдел " + DeptDisplayName(delegate_dept))
        let handled = 1.0
      } else {
        // Normal Yana reply — voice + text, no restrictions
        // #409: пустой ответ не отправляется (после [SHOP:]-обработки досье
        // уже ушло карточкой, текст Яны был бы дублем подтверждения)
        if length(reply) > 0.0 then {
          let voice_on = redact(kv_get("voice_enabled"), "all")
          if voice_on == "true" then {
            let voice_name = redact(kv_get("tts_voice"), "all")
            if length(voice_name) < 3.0 then { let voice_name = "ru-RU-SvetlanaNeural" }
            // MINIAPP-3 (#290): параметры голоса из kv; пустые kv → прежнее поведение (defaults /tts)
            let tts_body = json_encode({text: reply, voice: voice_name, chat_id: chat_id, speed: kv_get("voice_speed"), volume: kv_get("voice_volume"), pitch: kv_get("voice_pitch")})
            let _ = TryVal(try http_post("http://127.0.0.1:4000/tts", tts_body, "application/json"))
          }
          // Text: send via proxy (handles 4096 limit with splitting)
          let text_body = json_encode({chat_id: chat_id, text: "Яна\n\n" + reply})
          let _ = TryVal(try http_post("http://127.0.0.1:4000/tg-send", text_body, "application/json"))
        }
        let handled = 1.0
      }
    }
    if dept == "osp" then {
      let _ = RecordUserMessage(chat_id, "osp", text)
      let reply = HandleOSP(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "osp")
      let _ = SendReport(reply, "osp", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "lz" then {
      let _ = RecordUserMessage(chat_id, "lz", text)
      let reply = HandleLZ(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "lz")
      let _ = SendReport(reply, "lz", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "expert" then {
      let _ = RecordUserMessage(chat_id, "expert", text)
      let reply = HandleExpert(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "expert")
      let _ = SendReport(reply, "expert", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "marketing" then {
      let _ = RecordUserMessage(chat_id, "marketing", text)
      let reply = HandleMarketing(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "marketing")
      let _ = SendReport(reply, "marketing", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "finance" then {
      let _ = RecordUserMessage(chat_id, "finance", text)
      let reply = HandleFinance(query, chat_id)
      let telegram_text = reply
      if contains(reply, "[[CHART]]") then {
        let chart_start = index_of(reply, "[[CHART]]")
        let telegram_text = substring(reply, 0.0, chart_start) + "\n\n📊 График приложен в полном отчёте."
      }
      let _ = SendVoiceReply(chat_id, telegram_text, "finance")
      let _ = SendReport(reply, "finance", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "legal" then {
      let _ = RecordUserMessage(chat_id, "legal", text)
      let reply = HandleLegal(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "legal")
      let _ = SendReport(reply, "legal", query, "2.0", chat_id)
      let handled = 1.0
    }
    if starts_with(text, "/dev-forge") then {
      let query_f = substring(text, 11.0, length(text))
      let reply_f = ForgeFromDevRequest(query_f, chat_id)
      let _ = SendReport(reply_f, "dev", query_f, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "dev" then {
      let _ = RecordUserMessage(chat_id, "dev", text)
      // FO-041 A.2: FORGE-контур включается сам на запросы сборки
      // (по совпадению с активным проектом); иначе — обычный dev-путь
      let forge_hint = ""
      let forge_rows_f = TryVal(try query("SELECT COUNT(*) as c FROM forge_projects WHERE status = 'active'", []))
      if to_string(forge_rows_f) != "()" then {
        let n_active = to_float(json_get(get(forge_rows_f, 0), "c", "0"))
        if n_active > 0.0 and contains(lower(text), "сделай") then {
          let forge_hint = ForgeFromDevRequest(query, chat_id)
        }
      }
      let reply = HandleDev(query, chat_id)
      if forge_hint != "" then {
        let reply = reply + "\n\n── FORGE ──\n" + substring(forge_hint, 0.0, 1200.0)
      }
      let _ = SendVoiceReply(chat_id, reply, "dev")
      let _ = SendReport(reply, "dev", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "design-image" then {
      let _ = RecordUserMessage(chat_id, "design", text)
      // Extract prompt: everything after /design-image or the full text
      let img_prompt = substring(text, 14.0, 0.0)
      if length(trim(img_prompt)) < 3.0 then { let img_prompt = query }
      let err = HandleDesignImage(img_prompt, chat_id)
      if length(err) > 0.0 then {
        let _ = SendTelegramReply(chat_id, err)
      }
      let handled = 1.0
    }
    if dept == "design" then {
      let _ = RecordUserMessage(chat_id, "design", text)
      // Auto-detect image generation requests within design dept
      let is_img = IsImageRequest(query)
      if is_img == "true" then {
        let err = HandleDesignImage(query, chat_id)
        if length(err) > 0.0 then {
          let _ = SendTelegramReply(chat_id, err)
        }
      } else {
        let reply = HandleDesign(query, chat_id)
        let _ = SendVoiceReply(chat_id, reply, "design")
        let _ = SendReport(reply, "design", query, "2.0", chat_id)
      }
      let handled = 1.0
    }
    if dept == "qa" then {
      let _ = RecordUserMessage(chat_id, "qa", text)
      let reply = HandleQA(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "qa")
      let _ = SendReport(reply, "qa", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "visual-image" then {
      let _ = RecordUserMessage(chat_id, "visual", text)
      // Extract prompt: everything after /visual-image or the full text
      let img_prompt = substring(text, 14.0, 0.0)
      if length(trim(img_prompt)) < 3.0 then { let img_prompt = query }
      let err = HandleDesignImage(img_prompt, chat_id)
      if length(err) > 0.0 then {
        let _ = SendTelegramReply(chat_id, err)
      }
      let handled = 1.0
    }
    if dept == "visual" then {
      let _ = RecordUserMessage(chat_id, "visual", text)
      // Auto-detect image generation requests within visual dept
      let is_img = IsImageRequest(query)
      if is_img == "true" then {
        let err = HandleDesignImage(query, chat_id)
        if length(err) > 0.0 then {
          let _ = SendTelegramReply(chat_id, err)
        }
      } else {
        let reply = HandleVisual(query, chat_id)
        let _ = SendVoiceReply(chat_id, reply, "visual")
        let _ = SendReport(reply, "visual", query, "2.0", chat_id)
      }
      let handled = 1.0
    }
    if dept == "engineering" then {
      let _ = RecordUserMessage(chat_id, "engineering", text)
      let reply = HandleEngineering(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "engineering")
      let _ = SendReport(reply, "engineering", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "kavalnya" then {
      let _ = RecordUserMessage(chat_id, "kavalnya", text)
      let reply = HandleKavalnya(query, chat_id)
      let _ = SendVoiceReply(chat_id, reply, "kavalnya")
      let _ = SendReport(reply, "kavalnya", query, "2.0", chat_id)
      let handled = 1.0
    }
    if dept == "admin" then {
      let _ = RecordUserMessage(chat_id, "admin", text)
      let reply = HandleAdmin(text, chat_id)
      let _ = SendTelegramReply(chat_id, reply)
      let handled = 1.0
    }

    // Default: route to Yana with voice + text, no restrictions
    if handled == 0.0 then {
      let _ = RecordUserMessage(chat_id, "yana", text)
      let reply = HandleYana(text, chat_id)
      // #409: пустой ответ не отправляется (после [SHOP:]-обработки досье
      // уже ушло карточкой, текст Яны был бы дублем подтверждения)
      if length(reply) > 0.0 then {
        let voice_on = redact(kv_get("voice_enabled"), "all")
        if voice_on == "true" then {
          let voice_name = redact(kv_get("tts_voice"), "all")
          if length(voice_name) < 3.0 then { let voice_name = "ru-RU-SvetlanaNeural" }
          // MINIAPP-3 (#290): параметры голоса из kv; пустые kv → прежнее поведение (defaults /tts)
          let tts_body = json_encode({text: reply, voice: voice_name, chat_id: chat_id, speed: kv_get("voice_speed"), volume: kv_get("voice_volume"), pitch: kv_get("voice_pitch")})
          let _ = TryVal(try http_post("http://127.0.0.1:4000/tts", tts_body, "application/json"))
        }
        let text_body = json_encode({chat_id: chat_id, text: reply})
        let _ = TryVal(try http_post("http://127.0.0.1:4000/tg-send", text_body, "application/json"))
      }
    }

    return respond("200 ok")
}

pattern NightTickCore(cron_secret: String) -> String {
    // #485: тело диспетчера теперь одно на оба триггера — нативный слот 05:00
    // (dept/schedules.mlog, NightTickSlot) и внешний cron-job.org на /cron/night-tick.
    // Раньше близнецы дублировали логику, и ОБА били по несуществующему Flask
    // /cron/night. Секрет роут уже проверил (гвард выше); слот читает env сам.
    // Один формат отчёта, одна запись audit_log, одно сообщение в Telegram.
    let rep = NightTickSlot()
    return respond("200 " + rep)
}
