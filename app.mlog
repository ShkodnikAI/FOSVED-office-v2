  // ── конец DDL-пака naryad-363 ──
  // ── naryad-363: ALTER-хвост — дрейф схем существующих таблиц (код пишет, схемы нет) ──
  let _ = TryVal(try db_execute("ALTER TABLE analysis ADD COLUMN mode TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE analysis ADD COLUMN published_at TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE analysis ADD COLUMN superseded_by_id TEXT"))
