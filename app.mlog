  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN test_status TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN testing_at TEXT"))
  // #428 A.3: колонка без выражения по умолчанию. Форма с выражением в
  // DEFAULT отвергается частью движков SQLite на ALTER (прод-бут 2026-09-29:
  // non-constant default) — у базы на диске колонки могло не быть, а
  // dept/admin.mlog пишет updated_at при создании и смене статуса наряда.
  // Заполнение — отдельным идемпотентным UPDATE (при каждом старте дёшево:
  // после первого прогона WHERE updated_at IS NULL не находит строк).
  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN updated_at TEXT"))
  let _ = TryVal(try db_execute("UPDATE narads SET updated_at = datetime('now') WHERE updated_at IS NULL"))
  let _ = TryVal(try db_execute("ALTER TABLE training_sessions ADD COLUMN checklist_progress TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE training_sessions ADD COLUMN debrief_notes TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE yana_events ADD COLUMN active TEXT"))
