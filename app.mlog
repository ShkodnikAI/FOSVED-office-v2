  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN acceptance TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN dept TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN in_work_at TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN plan TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN priority TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN report TEXT"))
  let _ = TryVal(try db_execute("ALTER TABLE narads ADD COLUMN rework_count REAL"))
