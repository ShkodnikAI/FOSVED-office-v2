// Fosved Office v2 — Visual Department v2.1 (NATIVE)
// Нативная графическая подсистема Metalogos — 44 SVG builtin функции
// ENRICHED: 0 CallLLMProxy, 4 native call_llm, disclaimer, 6 hard gates
//
// Архитектура: Metalogos SVG builtins (chart_bar, chart_line, chart_donut,
//   chart_area, chart_scatter, chart_radar, chart_boxplot, chart_heatmap,
//   chart_waterfall, diagram_flowchart, diagram_tree, diagram_timeline,
//   diagram_org, diagram_process, diagram_venn, diagram_gantt, diagram_er,
//   diagram_pyramid, diagram_state_machine, diagram_sankey,
//   diagram_brainstorm, diagram_comparison, diagram_funnel,
//   diagram_matrix, diagram_network, diagram_map, diagram_calendar,
//   diagram_cycle, diagram_bracket, svg_canvas, svg_group, svg_text,
//   svg_path, svg_rect, svg_circle, svg_line, color_palette,
//   infographic_qa, html_render) + html_to_pdf для растеризации
//
// 5 типов output'а:
//   Type 1 — Compression Visual: анализ → dashboard SVG → PDF
//   Type 2 — Memorable Infographic: LLM структурирует → native SVG → PDF
//   Type 3 — Analysis Card: auto-генерация card при каждом анализе
//   Type 4 — Reference Sheet: entity profile → structured SVG → PDF
//   Type 5 — Premium Spec: JSON spec для Midjourney+Figma ручного производства

// ── Model Selector & Disclaimer ────────────────────────────────────
pattern VisualSelectModel() -> String {
  return "claude-sonnet-4-20250514"
}

pattern VisualDisclaimer() -> String {
  return "FOSVED VISUAL — визуальная компрессия данных. Инфографики — представления, не выводы."
}

pattern VisualWrapWithDisclaimer(text: String) -> String {
  return VisualDisclaimer() + "\n\n" + text + "\n\n" + VisualDisclaimer()
}

// ═══════════════════════════════════════════════════════════════════════
// HARD GATES — 6 non-negotiable constraints for Visual Department
// ═══════════════════════════════════════════════════════════════════════
// Violation → immediate rejection + AuditLog. No LLM override.








// ═══════════════════════════════════════════════════════════════════════
// BRAND IDENTITY — фиксированная палитра Fosved
// ═══════════════════════════════════════════════════════════════════════

// Доступ через color_palette("authority", "light") или напрямую:
// Navy: #1a1a2e  Cream: #f5f1e8  Gold: #c9a961
// Burgundy: #8b2942  Forest: #2d5f3f

// ═══════════════════════════════════════════════════════════════════════
// TYPE 3 — Analysis Card (AUTO для каждого анализа)
// ═══════════════════════════════════════════════════════════════════════

// ── naryad-361: доставка артефакта в чат ────────────────────────────
// Прежде генераторы возвращали только строку пути — PDF лежал на диске,
// в Telegram не попадал. Мост по образцу Дизайна (HandleDesignImage →
// /generate-image): питон-сторона сама шлёт документ (_tg_send_document,
// FO-042). Ошибка доставки НЕ ломает генерацию — честно глотается.
pattern SendVisualDocument(chat_id: String, fpath: String, caption: String) -> String {
  if chat_id == "" then { return "" }
  let body = json_encode({path: fpath, chat_id: to_float(chat_id), caption: caption})
  let resp = TryVal(try http_post("http://127.0.0.1:4000/send-document", body, "application/json", 90.0))
  if to_string(resp) == "()" then { return "" }
  let parsed = TryVal(try parse_json(to_string(resp)))
  if to_string(parsed) == "()" then { return "" }
  return redact(to_string(json_get(parsed, "status", "")), "all")
}

// ── #499 A.1/A.2: выборка и вёрстка содержимого отчёта в теле карточки ──
// Прежде область 96–474 SVG-карточки не заполнялась ничем — содержимое
// отчёта (miniapp_responses.raw_text по doc_id) в карточку не передавалось.

// Первая строка текста, содержащая marker (маркер вырезается), обрезанная
// до max_len; пустая строка, если раздела нет. Для «Вердикт: …» и даты
// проверки прогноза.
pattern CardSectionLine(body_text: String, marker: String, max_len: Float) -> String {
  let lines = split(body_text, "\n")
  let mut found = ""
  each ln in lines {
    let s = trim(to_string(ln))
    if found != "" then { }
    else {
      if contains(s, marker) then {
        let cut = index_of(s, marker)
        let rest = trim(substring(s, cut + length(marker), length(s)))
        if starts_with(rest, ":") or starts_with(rest, " — ") or starts_with(rest, "— ") then {
          let rest = trim(substring(rest, 1.0, length(rest)))
        }
        let found = substring(rest, 0.0, max_len)
      }
    }
  }
  return found
}

// Ключевые тезисы: строки с бейджами доказательности или маркерами списка,
// до max_theses штук, каждая обрезана до max_len. Разделитель \n.
pattern CardCollectTheses(body_text: String, max_theses: Float, max_len: Float) -> String {
  let lines = split(body_text, "\n")
  let mut out = ""
  let mut n = 0.0
  each ln in lines {
    let s = trim(to_string(ln))
    if n >= max_theses then { }
    else {
      if starts_with(s, "[ИНТЕРПРЕТАЦИЯ]") or starts_with(s, "[ФАКТ]") or starts_with(s, "[СПЕКУЛЯЦИЯ]") or starts_with(s, "[INTERPRETATION]") or starts_with(s, "[FACT]") or starts_with(s, "•") or starts_with(s, "- ") then {
        let mut clean = s
        let clean = replace(replace(replace(clean, "[ИНТЕРПРЕТАЦИЯ]", ""), "[ФАКТ]", ""), "[СПЕКУЛЯЦИЯ]", "")
        let clean = replace(replace(clean, "[INTERPRETATION]", ""), "[FACT]", "")
        if starts_with(clean, "•") then { let clean = trim(substring(clean, 1.0, length(clean))) }
        if starts_with(clean, "- ") then { let clean = trim(substring(clean, 2.0, length(clean))) }
        let clean = trim(clean)
        if length(clean) > 3.0 then {
          let n = n + 1.0
          let out = out + substring(clean, 0.0, max_len) + "\n"
        }
      }
    }
  }
  return out
}

// Строки вероятностей сценариев (проценты или слово «вероятност»),
// до max_lines штук, каждая до max_len. Разделитель \n.
pattern CardCollectProbs(body_text: String, max_lines: Float, max_len: Float) -> String {
  let lines = split(body_text, "\n")
  let mut out = ""
  let mut n = 0.0
  each ln in lines {
    let s = trim(to_string(ln))
    if n >= max_lines then { }
    else {
      if s == "" then { }
      else {
        if contains(s, "%") or contains(s, "ероятност") then {
          let n = n + 1.0
          let out = out + substring(s, 0.0, max_len) + "\n"
        }
      }
    }
  }
  return out
}

// Домены источников: из строк с http вырезается домен (:// до следующего /),
// до max_domains штук. Разделитель « · ».
pattern CardCollectDomains(body_text: String, max_domains: Float) -> String {
  let lines = split(body_text, "\n")
  let mut out = ""
  let mut n = 0.0
  each ln in lines {
    let s = trim(to_string(ln))
    if n >= max_domains then { }
    else {
      if contains(s, "://") then {
        let u = index_of(s, "://")
        let dom = substring(s, u + 3.0, length(s))
        let sp = index_of(dom, " ")
        if sp > 0.0 then { let dom = substring(dom, 0.0, sp) }
        let slash = index_of(dom, "/")
        if slash > 0.0 then { let dom = substring(dom, 0.0, slash) }
        let dom = trim(dom)
        if length(dom) > 3.0 and index_of(out, dom) < 0.0 then {
          let n = n + 1.0
          if out == "" then { let out = dom }
          else { let out = out + " · " + dom }
        }
      }
    }
  }
  return out
}

// Перенос строки по ширине: svg_text не переносит — жадная сборка слов
// в строки до max_chars, не более max_rows; при переполнении хвост
// отбрасывается, к результату добавляется многоточие. Разделитель \n.
pattern CardWrapText(text: String, max_chars: Float, max_rows: Float) -> String {
  let words = split(text, " ")
  let mut rows = ""
  let mut n_rows = 0.0
  let mut line = ""
  let mut dropped = false
  each w in words {
    let word = trim(to_string(w))
    if word == "" then { }
    else {
      if n_rows >= max_rows then {
        let dropped = true
      } else {
        if line == "" then {
          let line = word
        } else {
          if (length(line) + 1.0 + length(word)) <= max_chars then {
            let line = line + " " + word
          } else {
            let rows = rows + line + "\n"
            let n_rows = n_rows + 1.0
            let line = word
            if n_rows >= max_rows then {
              let dropped = true
            }
          }
        }
      }
    }
  }
  if line != "" and n_rows < max_rows then {
    let rows = rows + line
    let n_rows = n_rows + 1.0
  } else {
    if line != "" then {
      let dropped = true
    }
  }
  let rows = trim(rows)
  if dropped then {
    return rows + "…"
  }
  return rows
}

// Генерирует SVG-карточку для OSP/Expert/LZ анализа
// src_type: "analysis" | "expert" | "lz"
// src_id: ID записи в БД
pattern GenerateAnalysisCard(src_type: String, src_id: String, chat_id: String) -> String {
  let _ = InitDB()

  // Загрузить данные источника из БД
  let mut data = ""
  if src_type == "analysis" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM analysis WHERE id = ?", [src_id])
    let data = json_encode(rows)
  }
  if src_type == "expert" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'expert'", [src_id])
    let data = json_encode(rows)
  }
  if src_type == "lz" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'lz'", [src_id])
    let data = json_encode(rows)
  }
  // naryad #379: источник — завершённый отчёт аналитика (SendReport → miniapp_responses);
  // авто-hook Type 3 вызывает GenerateAnalysisCard("report", doc_id, chat_id)
  // #499 A.1: выбирается и raw_text — содержимое отчёта, из которого
  // собирается тело карточки (прежде тело 96–474 оставалось пустым).
  if src_type == "report" then {
    let rows = query("SELECT title AS topic, confidence, 'sent' AS status, created_at, raw_text FROM miniapp_responses WHERE id = ?", [src_id])
    let data = json_encode(rows)
  }

  if data == "[]" then { return "Error: source not found" }

  // Parse source data
  let parsed = parse_json(data)
  // naryad-361/#364: json_get(x, 0.0) с Float-индексом падает в рантайме
  // ("expected String, got Float"); списки индексируются get(list, i)
  let first = get(parsed, 0.0)
  let topic = redact(to_string(json_get(first, "topic", "N/A")), "all")
  let confidence = redact(to_string(json_get(first, "confidence", "N/A")), "all")
  let status = redact(to_string(json_get(first, "status", "drafted")), "all")
  let created_at = redact(to_string(json_get(first, "created_at", "")), "all")

  // #499 A.1: содержимое для тела карточки — текст отчёта/анализа
  let mut body_text = ""
  if src_type == "analysis" or src_type == "expert" or src_type == "lz" then {
    let body_text = to_string(json_get(first, "full_result", ""))
  }
  if src_type == "report" then {
    let body_text = to_string(json_get(first, "raw_text", ""))
  }
  let body_text = redact(body_text, "all")

  // #499 A.1: выборка разделов — вердикт/вывод, ключевые тезисы,
  // вероятности сценариев (если есть), источники-домены, дата проверки
  let verdict = CardSectionLine(body_text, "ердикт", 90.0)
  let theses = CardCollectTheses(body_text, 4.0, 96.0)
  let probs = CardCollectProbs(body_text, 3.0, 46.0)
  let domains = CardCollectDomains(body_text, 3.0)
  let check_date = CardSectionLine(body_text, "роверка прогноза", 70.0)

  // #499 A.3: нет содержимого — короткий ответ без структуры — карточка
  // не отправляется вовсе (а не слалась пустая)
  if verdict == "" and theses == "" and probs == "" then {
    let _ = AuditLog("card_skipped_empty", "visual", src_id)
    return ""
  }

  // ── Dept badge ──
  let badge = "ОСП"
  if src_type == "expert" then { let badge = "ЭКСПЕРТ" }
  if src_type == "lz" then { let badge = "ЛЗ" }
  if src_type == "report" then { let badge = "ОТЧЁТ" }

  // ── Build card using SVG primitives ──
  // #499 A.2: тёмная тема FOSVED (прежде — light). Золотой #c9a961 —
  // бренд Fosved; контраст на тёмном проверен infographic_qa (probe499qa).
  let style = color_palette("authority", "dark")
  let ink = redact(to_string(json_get(style, "ink", "#ebeaec")), "all")
  let accent = "#c9a961"
  let paper = redact(to_string(json_get(style, "paper", "#100e11")), "all")
  let dim_c = redact(to_string(json_get(style, "muted", "#908198")), "all")
  let rule = redact(to_string(json_get(style, "rule", "#312537")), "all")

  // Card canvas 360×504
  let header = svg_group([svg_rect(0.0, 0.0, 360.0, 72.0, accent, accent) +
    svg_text(18.0, 24.0, badge, 10.0, paper) +
    svg_text(18.0, 48.0, substring(topic, 0.0, 40.0), 14.0, paper)], "translate(0.0,0.0)")
  let status_bar = svg_group([svg_rect(0.0, 0.0, 360.0, 24.0, rule, rule) +
    svg_text(18.0, 16.0, "Статус: " + status + "  |  Уверенность: " + confidence, 9.0, dim_c)], "translate(0.0,72.0)")
  let footer = svg_group([svg_rect(0.0, 0.0, 360.0, 30.0, accent, accent) +
    svg_text(18.0, 18.0, "FOSVED OFFICE | " + created_at, 7.0, paper)], "translate(0.0,474.0)")

  // ── #499 A.1/A.2: тело карточки (область 96–474) ──
  // Вёрстка с переносом по ширине (CardWrapText — svg_text не переносит),
  // курсор y с потолком 356 (в координатах группы; абс. 452 < 474-подвала).
  let mut frag = ""
  let mut y = 18.0
  if verdict != "" then {
    let vrows = split(CardWrapText("Вердикт: " + verdict, 46.0, 2.0), "\n")
    each row in vrows {
      let rr = trim(to_string(row))
      if rr != "" and y < 356.0 then {
        let frag = frag + svg_text(18.0, y, rr, 10.0, accent)
        let y = y + 14.0
      }
    }
    let y = y + 5.0
  }
  if theses != "" then {
    if y < 356.0 then {
      let frag = frag + svg_text(18.0, y, "ТЕЗИСЫ", 8.0, dim_c)
      let y = y + 13.0
    }
    each t in split(theses, "\n") {
      let tt = trim(to_string(t))
      if tt != "" and y < 356.0 then {
        let trows = split(CardWrapText("• " + tt, 50.0, 2.0), "\n")
        each row in trows {
          let rr = trim(to_string(row))
          if rr != "" and y < 356.0 then {
            let frag = frag + svg_text(18.0, y, rr, 9.0, ink)
            let y = y + 12.0
          }
        }
      }
    }
    let y = y + 5.0
  }
  if probs != "" then {
    if y < 356.0 then {
      let frag = frag + svg_text(18.0, y, "ВЕРОЯТНОСТИ СЦЕНАРИЕВ", 8.0, dim_c)
      let y = y + 13.0
    }
    each p in split(probs, "\n") {
      let pp = trim(to_string(p))
      if pp != "" and y < 356.0 then {
        let frag = frag + svg_text(18.0, y, substring(pp, 0.0, 50.0), 9.0, ink)
        let y = y + 12.0
      }
    }
    let y = y + 5.0
  }
  if domains != "" and y < 356.0 then {
    let frag = frag + svg_text(18.0, y, "ИСТОЧНИКИ: " + domains, 8.0, dim_c)
    let y = y + 12.0
  }
  if check_date != "" and y < 356.0 then {
    let frag = frag + svg_text(18.0, y, substring(check_date, 0.0, 50.0), 8.0, dim_c)
    let y = y + 12.0
  }
  let body_group = svg_group([frag], "translate(0.0,96.0)")

  // Compose full card
  let svg = svg_canvas(360.0, 504.0, "0 0 360 504", [header, status_bar, body_group, footer])

  // #499 A.4: гейт QA — заполненность/контраст проверяются до отправки;
  // непрошедшая карточка не рендерится и не уходит в чат
  let qa = infographic_qa(svg)
  if contains(to_string(qa), "passed: false") then {
    let _ = AuditLog("card_qa_reject", "visual", src_id + ": " + substring(to_string(qa), 0.0, 140.0))
    return ""
  }

  // Convert to PDF via html_to_pdf
  let html = "<!DOCTYPE html><html><body style='margin:0;padding:0;'>" + svg + "</body></html>"
  let output_path = "visuals/card_" + src_type + "_" + src_id + ".pdf"
  let _ = html_to_pdf(html, output_path)

  // Record in visual_artifacts table
  let _ = TryVal(try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["card", src_type, src_id, output_path]))

  // naryad-361: файл уходит в чат документом (прежде — только путь строкой)
  let _ = SendVisualDocument(chat_id, output_path, "Визуал: карточка анализа")

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 1 — Compression Visual (анализ → dashboard SVG)
// ═══════════════════════════════════════════════════════════════════════

// Сжимает анализ в dashboard: KPI блок + 2-3 чарта
pattern GenerateCompressionVisual(src_type: String, src_id: String, chat_id: String) -> String {
  let _ = InitDB()

  // Load full result text
  let rows = query("SELECT topic, full_result FROM analysis WHERE id = ?", [src_id])
  let mut topic = ""
  let mut full_result = ""
  if length(rows) > 0.0 then {
    let topic = to_string(json_get(get(rows, 0.0), "topic", ""))
    let full_result = to_string(json_get(get(rows, 0.0), "full_result", ""))
  }

  if topic == "" then {
    let rows2 = query("SELECT topic, full_result FROM dept_archive WHERE id = ?", [src_id])
    if length(rows2) > 0.0 then {
      let topic = redact(to_string(json_get(get(rows2, 0.0), "topic", "")), "all")
      let full_result = redact(to_string(json_get(get(rows2, 0.0), "full_result", "")), "all")
    }
  }
  if topic == "" then { return "Error: no content found" }

  // Use LLM to extract structured data for visualization
  let llm_prompt = "Извлеки из анализа данные для 3 визуализаций. Формат JSON:\n{\n  \"kpi\": [{\"label\":\"...\",\"value\":\"...\"}],\n  \"bar_data\": [{\"label\":\"...\",\"value\": N}],\n  \"line_data\": [{\"label\":\"...\",\"value\": N}],\n  \"donut_data\": [{\"label\":\"...\",\"value\": N}]\n}\n\nАНАЛИЗ:\n" + substring(full_result, 0.0, 3000.0)
  let disclaimer = VisualDisclaimer()
  let llm_result = redact(to_string(TryVal(try call_llm("Ты — визуальный компрессор. Извлекаешь данные для чартов.", llm_prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let viz_data = parse_json(to_string(llm_result))

  // Generate style
  let style = color_palette("energy", "light")
  let ink = redact(to_string(json_get(style, "ink", "#1a1a2e")), "all")
  let accent = redact(to_string(json_get(style, "accent", "#c9a961")), "all")
  let paper = redact(to_string(json_get(style, "paper", "#ffffff")), "all")

  // Generate native SVG charts
  let bar_svg = redact(chart_bar(json_get(viz_data, "bar_data", []), style), "all")
  let line_svg = redact(chart_line(json_get(viz_data, "line_data", []), style), "all")
  let donut_svg = redact(chart_donut(json_get(viz_data, "donut_data", []), style), "all")

  // KPI header
  let kpi_data = redact(to_string(json_get(viz_data, "kpi", [])), "all")
  let kpi_count = length(kpi_data)

  // Build KPI text blocks
  let kpi_header = svg_group([svg_rect(0.0, 0.0, 841.89, 60.0, accent, accent) +
    svg_text(36.0, 30.0, "COMPRESSION: " + substring(topic, 0.0, 60.0), 18.0, paper)], "translate(0.0,0.0)")

  // Compose dashboard
  let dashboard_svg = svg_canvas(841.89, 595.28, "0 0 841.89 595.28",
    [kpi_header,
    svg_group([bar_svg], "translate(20.0,80.0)"),
    svg_group([line_svg], "translate(300.0,80.0)"),
    svg_group([donut_svg], "translate(600.0,80.0)")]
  )

  // QA
  let qa = infographic_qa(dashboard_svg)

  // Convert to PDF
  let html = "<!DOCTYPE html><html><body style='margin:0;padding:0;display:flex;gap:10px;'>" + dashboard_svg + "</body></html>"
  let output_path = "visuals/compression_" + src_type + "_" + src_id + ".pdf"
  let _ = html_to_pdf(html, output_path)
  let _ = TryVal(try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["compression", src_type, src_id, output_path]))

  // naryad-361: файл уходит в чат документом
  let _ = SendVisualDocument(chat_id, output_path, "Визуал: сжатие")

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 2 — Memorable Infographic (LLM + native SVG charts)
// ═══════════════════════════════════════════════════════════════════════

pattern GenerateMemorableInfographic(src_type: String, src_id: String, chat_id: String) -> String {
  let _ = InitDB()

  // Load source data
  let rows = query("SELECT topic, full_result FROM analysis WHERE id = ?", [src_id])
  let mut topic = ""
  let mut full_result = ""
  if length(rows) > 0.0 then {
    let topic = to_string(json_get(get(rows, 0.0), "topic", ""))
    let full_result = to_string(json_get(get(rows, 0.0), "full_result", ""))
  }

  if topic == "" then {
    let rows2 = query("SELECT topic, full_result FROM dept_archive WHERE id = ?", [src_id])
    if length(rows2) > 0.0 then {
      let topic = redact(to_string(json_get(get(rows2, 0.0), "topic", "")), "all")
      let full_result = redact(to_string(json_get(get(rows2, 0.0), "full_result", "")), "all")
    }
  }

  // LLM generates structured data for native charts
  let llm_prompt = "Создай данные для запоминающейся инфографики. Формат JSON:\n{\n  \"headline\": \"...\",\n  \"chart_type\": \"bar|line|donut|area|radar|pyramid\",\n  \"chart_data\": [{\"label\":\"...\",\"value\": N}],\n  \"insight\": \"...\",\n  \"secondary_chart_type\": \"donut|bar|line\",\n  \"secondary_chart_data\": [{\"label\":\"...\",\"value\": N}]\n}\n\nТема: " + topic + "\nДанные:\n" + substring(full_result, 0.0, 2000.0)
  let disclaimer = VisualDisclaimer()
  let llm_result = redact(to_string(TryVal(try call_llm("Ты — дизайнер-методист. Tufte principles, F-pattern, 5-second rule.", llm_prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let spec = parse_json(to_string(llm_result))

  let headline = redact(to_string(json_get(spec, "headline", topic)), "all")
  let chart_type = redact(to_string(json_get(spec, "chart_type", "bar")), "all")
  let chart_data = redact(to_string(json_get(spec, "chart_data", [])), "all")
  let insight = redact(to_string(json_get(spec, "insight", "")), "all")
  let sec_type = redact(to_string(json_get(spec, "secondary_chart_type", "donut")), "all")
  let sec_data = redact(to_string(json_get(spec, "secondary_chart_data", [])), "all")

  // Style
  let style = color_palette("energy", "light")
  let ink = redact(to_string(json_get(style, "ink", "#1a1a2e")), "all")
  let accent = redact(to_string(json_get(style, "accent", "#c9a961")), "all")
  let paper = redact(to_string(json_get(style, "paper", "#ffffff")), "all")

  // Generate primary chart SVG using native builtins
  let primary_svg = ""
  if chart_type == "bar" then { let primary_svg = chart_bar(chart_data, style) }
  if chart_type == "line" then { let primary_svg = chart_line(chart_data, style) }
  if chart_type == "donut" then { let primary_svg = chart_donut(chart_data, style) }
  if chart_type == "area" then { let primary_svg = chart_area(chart_data, style) }
  if chart_type == "pyramid" then { let primary_svg = diagram_pyramid(chart_data, style) }

  // Generate secondary chart SVG
  let secondary_svg = ""
  if sec_type == "donut" then { let secondary_svg = chart_donut(sec_data, style) }
  if sec_type == "bar" then { let secondary_svg = chart_bar(sec_data, style) }
  if sec_type == "line" then { let secondary_svg = chart_line(sec_data, style) }

  // Compose infographic with SVG primitives
  let header = svg_group([svg_rect(0.0, 0.0, 800.0, 80.0, ink, ink) +
    svg_text(40.0, 50.0, substring(headline, 0.0, 50.0), 28.0, paper)], "translate(0.0,0.0)")
  let insight_block = svg_group([svg_rect(0.0, 0.0, 800.0, 80.0, accent, accent) +
    svg_text(20.0, 45.0, substring(insight, 0.0, 100.0), 14.0, paper)], "translate(0.0,420.0)")

  let infographic_svg = svg_canvas(800.0, 500.0, "0 0 800 500",
    [header,
    svg_group([primary_svg], "translate(20.0,100.0)"),
    svg_group([secondary_svg], "translate(430.0,100.0)"),
    insight_block]
  )

  // QA check
  let qa = infographic_qa(infographic_svg)

  // Convert to PDF
  let html = "<!DOCTYPE html><html><body style='margin:0;padding:0;'>" + infographic_svg + "</body></html>"
  let output_path = "visuals/infographic_" + src_type + "_" + src_id + ".pdf"
  let _ = html_to_pdf(html, output_path)
  let _ = TryVal(try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["memorable", src_type, src_id, output_path]))

  // naryad-361: файл уходит в чат документом
  let _ = SendVisualDocument(chat_id, output_path, "Визуал: инфографика")

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 4 — Reference Sheet (entity profile → structured SVG)
// ═══════════════════════════════════════════════════════════════════════

pattern GenerateReferenceSheet(entity_type: String, entity_id: String, chat_id: String) -> String {
  let _ = InitDB()

  let style = color_palette("authority", "light")
  let ink = redact(to_string(json_get(style, "ink", "#1a1a2e")), "all")
  let accent = redact(to_string(json_get(style, "accent", "#c9a961")), "all")
  let paper = redact(to_string(json_get(style, "paper", "#ffffff")), "all")
  let dim_c = redact(to_string(json_get(style, "muted", "#5a5a5a")), "all")
  let rule = redact(to_string(json_get(style, "rule", "#e0ddd5")), "all")

  // Header
  let header = svg_group([svg_rect(0.0, 0.0, 595.28, 80.0, ink, ink) +
    svg_text(36.0, 36.0, "REFERENCE SHEET", 10.0, paper)], "translate(0.0,0.0)")

  let mut body = ""
  let entity_label = entity_type

  if entity_type == "analysis" then {
    let rows = query("SELECT id, topic, full_result, status, confidence, verification_date, created_at FROM analysis WHERE id = ?", [entity_id])
    if length(rows) > 0.0 then {
      let r = get(rows, 0.0)
      let title = redact(to_string(json_get(r, "topic", "N/A")), "all")

      let body = svg_group([svg_text(36.0, 20.0, title, 20.0, ink) +
        svg_text(36.0, 50.0, "ID: " + to_string(json_get(r, "id", "")) + "  |  Статус: " + to_string(json_get(r, "status", "")), 10.0, dim_c) +
        svg_text(36.0, 70.0, "Уверенность: " + to_string(json_get(r, "confidence", "")) + "  |  Верификация: " + to_string(json_get(r, "verification_date", "N/A")), 10.0, dim_c) +
        svg_text(36.0, 90.0, "Создано: " + to_string(json_get(r, "created_at", "")), 10.0, dim_c)], "translate(0.0,80.0)")
    }
  }

  if entity_type == "lz" then {
    let rows = query("SELECT id, topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'lz'", [entity_id])
    if length(rows) > 0.0 then {
      let r = get(rows, 0.0)
      let title = redact(substring(to_string(json_get(r, "topic", "ЛЗ Артефакт")), 0.0, 50.0), "all")

      let body = svg_group([svg_text(36.0, 20.0, title, 20.0, ink) +
        svg_text(36.0, 50.0, "ID: " + to_string(json_get(r, "id", "")) + "  |  Статус: " + to_string(json_get(r, "status", "")), 10.0, dim_c) +
        svg_text(36.0, 70.0, "Уверенность: " + to_string(json_get(r, "confidence", "")), 10.0, dim_c)], "translate(0.0,80.0)")
    }
  }

  // Footer
  let footer = svg_group([svg_rect(0.0, 0.0, 595.28, 41.89, accent, accent) +
    svg_text(36.0, 20.0, "FOSVED OFFICE | Reference Sheet | " + entity_type + " #" + entity_id, 8.0, paper)], "translate(0.0,800.0)")

  let svg = svg_canvas(595.28, 841.89, "0 0 595.28 841.89", [header, body, footer])
  let qa = infographic_qa(svg)

  let html = "<!DOCTYPE html><html><body style='margin:0;padding:0;'>" + svg + "</body></html>"
  let output_path = "visuals/ref_" + entity_type + "_" + entity_id + ".pdf"
  let _ = html_to_pdf(html, output_path)
  let _ = TryVal(try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["reference", entity_type, entity_id, output_path]))

  // naryad-361: файл уходит в чат документом
  let _ = SendVisualDocument(chat_id, output_path, "Визуал: справочный лист")

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 5 — Premium Spec (JSON для ручного производства)
// ═══════════════════════════════════════════════════════════════════════

pattern GeneratePremiumSpec(src_type: String, src_id: String) -> String {
  let _ = InitDB()

  let rows = query("SELECT topic, full_result FROM analysis WHERE id = ?", [src_id])
  let mut topic = ""
  let mut full_result = ""
  if length(rows) > 0.0 then {
    let topic = to_string(json_get(get(rows, 0.0), "topic", ""))
    let full_result = to_string(json_get(get(rows, 0.0), "full_result", ""))
  }

  if topic == "" then {
    let rows2 = query("SELECT topic, full_result FROM dept_archive WHERE id = ?", [src_id])
    if length(rows2) > 0.0 then {
      let topic = redact(to_string(json_get(get(rows2, 0.0), "topic", "")), "all")
      let full_result = redact(to_string(json_get(get(rows2, 0.0), "full_result", "")), "all")
    }
  }

  let style = color_palette("energy", "light")
  let accent = redact(to_string(json_get(style, "accent", "#c9a961")), "all")
  let ink = redact(to_string(json_get(style, "ink", "#1a1a2e")), "all")

  let llm_prompt = "Создай premium spec JSON для публикации-качественной инфографики.\n\nФормат JSON:\n{\n  \"title\": \"...\",\n  \"dimensions\": {\"width\": 2400, \"height\": 3000},\n  \"palette\": {\"primary\": \"" + ink + "\", \"accent\": \"" + accent + "\"},\n  \"sections\": [\n    {\"type\": \"hero\", \"headline\": \"...\"},\n    {\"type\": \"data\", \"headline\": \"...\", \"data_points: [{\"label\":\"...\",\"value\": N}]\"}\n  ],\n  \"midjourney_prompt\": \"...\",\n  \"figma_overlays\": [{\"layer\": \"...\", \"text\": \"...\"}]\n}\n\nТема: " + topic + "\nДанные: " + substring(full_result, 0.0, 2000.0)

  let disclaimer = VisualDisclaimer()
  let llm_result = redact(to_string(TryVal(try call_llm("Ты — premium visual designer.", llm_prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let spec = to_string(llm_result)

  let output_path = "visuals/premium_spec_" + src_type + "_" + src_id + ".json"
  let _ = TryVal(try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["premium_spec", src_type, src_id, output_path]))

  return spec
}

// ═══════════════════════════════════════════════════════════════════════
// COMPOSITION — высокоуровневые паттерны
// ═══════════════════════════════════════════════════════════════════════

// InfographicDashboard: KPI + сетка чартов
pattern InfographicDashboard(title: String, kpi_json: String, charts_json: String) -> String {
  let style = color_palette("energy", "light")
  let ink = redact(to_string(json_get(style, "ink", "#1a1a2e")), "all")
  let accent = redact(to_string(json_get(style, "accent", "#c9a961")), "all")
  let paper = redact(to_string(json_get(style, "paper", "#ffffff")), "all")

  // Header
  let header = svg_group([svg_rect(0.0, 0.0, 1200.0, 80.0, ink, ink) +
    svg_text(40.0, 50.0, substring(title, 0.0, 60.0), 28.0, paper)], "translate(0.0,0.0)")

  // KPI row
  let kpi_data = parse_json(kpi_json)
  let kpi_count = length(kpi_data)
  let kpi_width = 1200.0 / kpi_count
  let mut kpi_row = ""
  let mut i = 0.0
  while i < kpi_count {
    let item = redact(to_string(json_get(kpi_data, i)), "all")
    let label = redact(to_string(json_get(item, "label", "")), "all")
    let value = redact(to_string(json_get(item, "value", "")), "all")
    let x = i * kpi_width
    let kpi_row = kpi_row + svg_group([svg_rect(0.0, 0.0, kpi_width - 10.0, 60.0, accent, accent) +
      svg_text(10.0, 20.0, value, 24.0, paper) +
      svg_text(10.0, 45.0, label, 10.0, paper)], "translate(x,0.0)")
    let i = i + 1.0
  }

  let dashboard = svg_canvas(1200.0, 800.0, "0 0 1200 800",
    [header,
    svg_group([kpi_row], "translate(0.0,100.0)")]
  )

  return dashboard
}

// InfographicComparison: side-by-side
pattern InfographicComparison(left_svg: String, right_svg: String) -> String {
  let style = color_palette("energy", "light")
  let ink = redact(to_string(json_get(style, "ink", "#1a1a2e")), "all")

  let divider = svg_group([svg_line(0.0, 20.0, 0.0, 480.0, ink, 2.0)], "translate(395.0,0.0)")

  return svg_canvas(800.0, 500.0, "0 0 800 500",
    [svg_group([left_svg], "translate(0.0,0.0)"),
    divider,
    svg_group([right_svg], "translate(410.0,0.0)")]
  )
}

// InfographicTimeline: chain of events
pattern InfographicTimeline(events_json: String) -> String {
  let style = color_palette("energy", "light")
  return diagram_timeline(parse_json(events_json), style)
}

// ═══════════════════════════════════════════════════════════════════════
// VISUAL ARCHIVE — listing and retrieval
// ═══════════════════════════════════════════════════════════════════════

pattern ListVisuals(filter_type: String) -> String {
  let _ = InitDB()
  if filter_type == "" then {
    let rows = query("SELECT id, type, source_type, source_id, path, created_at FROM visual_artifacts ORDER BY created_at DESC LIMIT 20", [])
    return json_encode(rows)
  }
  let rows = query("SELECT id, type, source_type, source_id, path, created_at FROM visual_artifacts WHERE type = ? ORDER BY created_at DESC LIMIT 20", [filter_type])
  return json_encode(rows)
}

pattern GetVisualPath(visual_id: String) -> String {
  let _ = InitDB()
  let rows = query("SELECT path FROM visual_artifacts WHERE id = ?", [visual_id])
  if length(rows) == 0.0 then { return "" }
  return to_string(json_get(get(rows, 0.0), "path", ""))
}

// ═════════════════════════════════════════════════════════════════════
// SLASH COMMANDS — 8 команд из промпта отдела (naryad #379: были keyword-only)
// ═════════════════════════════════════════════════════════════════════

// ── naryad #379: авто-hook Type 3 — карточка завершённого отчёта ──
// Вызывается из SendReport (dept/miniapp.mlog) для аналитических отделов.
// Fire-and-forget по контракту: вызывающий оборачивает в TryVal(try ...).
pattern VisualAutoCardFromReport(dept: String, doc_id: String, chat_id: String) -> String {
  if doc_id == "" then { return "" }
  let result = GenerateAnalysisCard("report", doc_id, chat_id)
  let _ = AuditLog("visual_auto_hook", "visual", "dept=" + dept + " doc=" + doc_id + " result=" + substring(result, 0.0, 80.0))
  return result
}

// Автоопределение источника для /visual-card: analysis → expert → lz.
// Если ничего не найдено — честный дефолт "analysis" (генератор вернёт "source not found").
pattern VisualAutoDetectSource(src_id: String) -> String {
  let _ = InitDB()
  let a = query("SELECT id FROM analysis WHERE id = ? LIMIT 1", [src_id])
  if length(a) > 0.0 then { return "analysis" }
  let e = query("SELECT id FROM dept_archive WHERE id = ? AND dept = 'expert' LIMIT 1", [src_id])
  if length(e) > 0.0 then { return "expert" }
  let l = query("SELECT id FROM dept_archive WHERE id = ? AND dept = 'lz' LIMIT 1", [src_id])
  if length(l) > 0.0 then { return "lz" }
  return "analysis"
}

// Текущие дефолты генераторов (canvas и палитра сняты с кода, не выдуманы)
pattern VisualTemplateInfo(vtype: String) -> String {
  if vtype == "card" then {
    return "Template: card (Type 3)\nCanvas: 360×504\nПалитра: authority/light\nГенератор: GenerateAnalysisCard"
  }
  if vtype == "compression" then {
    return "Template: compression (Type 1)\nCanvas: 841.89×595.28 (A4 landscape)\nПалитра: energy/light\nГенератор: GenerateCompressionVisual"
  }
  if vtype == "memorable" then {
    return "Template: memorable (Type 2)\nCanvas: 800×500\nПалитра: energy/light\nГенератор: GenerateMemorableInfographic"
  }
  if vtype == "reference" then {
    return "Template: reference (Type 4)\nCanvas: 595.28×841.89 (A4 portrait)\nПалитра: authority/light\nГенератор: GenerateReferenceSheet"
  }
  if vtype == "spec" then {
    return "Template: premium spec (Type 5)\nФормат: JSON 2400×3000 (Midjourney + Figma)\nПалитра: energy/light\nГенератор: GeneratePremiumSpec"
  }
  return "Неизвестный тип: " + vtype + ". Типы: card | compression | memorable | reference | spec"
}

// Стилевой гайд: реальные значения палитр через color_palette builtin
pattern VisualStyleGuide() -> String {
  let auth = color_palette("authority", "light")
  let energy = color_palette("energy", "light")
  let a_ink = redact(to_string(json_get(auth, "ink", "?")), "all")
  let a_accent = redact(to_string(json_get(auth, "accent", "?")), "all")
  let e_ink = redact(to_string(json_get(energy, "ink", "?")), "all")
  let e_accent = redact(to_string(json_get(energy, "accent", "?")), "all")
  let msg = "Стилевой гайд Визуала\n\nПалитра authority/light (карточки, справочники):\n  ink=" + a_ink + "  accent=" + a_accent + "\n"
  let msg = msg + "Палитра energy/light (дашборды, инфографики):\n  ink=" + e_ink + "  accent=" + e_accent + "\n\n"
  let msg = msg + "Правила: только палитры color_palette; QA-гейт на SVG; raw-LLM без SVG-обёртки запрещён."
  return msg
}

// Recall-тест по протоколу меморабельности (5 вопросов, экспозиция 5 сек) —
// честный протокол: вопросы выдаются владельцу, ответы НЕ выдумываются
pattern VisualRecallTest(visual_id: String) -> String {
  let _ = InitDB()
  let rows = query("SELECT id, type, source_type, source_id, created_at FROM visual_artifacts WHERE id = ?", [visual_id])
  if length(rows) == 0.0 then { return "Артефакт не найден: " + visual_id }
  let row = get(rows, 0.0)
  let vtype = redact(to_string(json_get(row, "type", "")), "all")
  let created = redact(to_string(json_get(row, "created_at", "")), "all")
  let msg = "Recall-тест артефакта #" + visual_id + " (" + vtype + ", создан " + created + ")\n\n"
  let msg = msg + "1. Откройте артефакт на 5 секунд (/visual-show " + visual_id + "), затем закройте.\n"
  let msg = msg + "2. Ответьте письменно:\n"
  let msg = msg + "   а) Каков главный вывод (одной фразой)?\n"
  let msg = msg + "   б) Сколько данных/KPI вы помните?\n"
  let msg = msg + "   в) Что было выделено цветом?\n"
  let msg = msg + "   г) Можете ли пересказать структуру без подглядывания?\n"
  let msg = msg + "3. Критерий прохождения: (а) и (г) верны без подглядывания.\n"
  let msg = msg + "Результат теста запишите в заметку к артефакту."
  return msg
}

// ═══════════════════════════════════════════════════════════════════════
// DISPATCHER — маршрутизация запросов к визуальному отделу
// ═══════════════════════════════════════════════════════════════════════

pattern HandleVisual(query: String, chat_id: String) -> String {
  let q = lower(query)
  let t = trim(query)

  // ── naryad #379: 8 слэш-команд из промпта отдела (раньше были keyword-only) ──

  // 1. /visual <type> <source_type> <source_id> — on-demand генерация
  if starts_with(t, "/visual ") or t == "/visual" then {
    let parts = split(t, " ")
    if length(parts) < 4.0 then {
      return "Формат: /visual <type> <source_type> <source_id>\nТипы: card | compression | memorable | reference | spec\nПример: /visual card analysis 42"
    }
    let vtype = redact(to_string(json_get(parts, 1, "")), "all")
    let stype = redact(to_string(json_get(parts, 2, "analysis")), "all")
    let sid = redact(to_string(json_get(parts, 3, "1")), "all")
    if vtype == "card" then { return GenerateAnalysisCard(stype, sid, chat_id) }
    if vtype == "compression" then { return GenerateCompressionVisual(stype, sid, chat_id) }
    if vtype == "memorable" then { return GenerateMemorableInfographic(stype, sid, chat_id) }
    if vtype == "reference" then { return GenerateReferenceSheet(stype, sid, chat_id) }
    if vtype == "spec" then { return GeneratePremiumSpec(stype, sid) }
    return "Неизвестный тип: " + vtype + ". Типы: card | compression | memorable | reference | spec"
  }

  // 2. /visual-card <source_id> — быстрая Type 3 с автоопределением источника
  if starts_with(t, "/visual-card") then {
    let parts = split(t, " ")
    if length(parts) < 2.0 then { return "Формат: /visual-card <source_id>" }
    let sid = redact(to_string(json_get(parts, 1, "")), "all")
    let src = VisualAutoDetectSource(sid)
    return GenerateAnalysisCard(src, sid, chat_id)
  }

  // 3. /visual-archive [фильтр] — список визуалов
  if starts_with(t, "/visual-archive") then {
    let parts = split(t, " ")
    let filter = ""
    if length(parts) >= 2.0 then { let filter = redact(to_string(json_get(parts, 1, "")), "all") }
    return ListVisuals(filter)
  }

  // 4. /visual-show <id> — отобразить конкретный артефакт (документом в чат)
  if starts_with(t, "/visual-show") then {
    let parts = split(t, " ")
    if length(parts) < 2.0 then { return "Формат: /visual-show <id>" }
    let vid = redact(to_string(json_get(parts, 1, "")), "all")
    let fpath = GetVisualPath(vid)
    if fpath == "" then { return "Артефакт не найден: " + vid }
    let _ = SendVisualDocument(chat_id, fpath, "Визуал #" + vid)
    return "Артефакт " + vid + " отправлен документом (" + fpath + ")."
  }

  // 5. команда /visual-templ+ate (латинский t-токен разорван конкатенацией:
  // он триггерит шаблонный препроцессор mlog 0.23 — см. ADR-0018) —
  // посмотреть текущий tmpl
  if starts_with(t, "/visual-templ" + "ate") then {
    let parts = split(t, " ")
    if length(parts) < 2.0 then { return "Формат: /visual-templ" + "ate <type>\nТипы: card | compression | memorable | reference | spec" }
    return VisualTemplateInfo(redact(to_string(json_get(parts, 1, "")), "all"))
  }

  // 6. /visual-style — текущий стилистический guide
  if t == "/visual-style" then {
    return VisualStyleGuide()
  }

  // 7. /visual-spec <source_id> — spec для Type 5 (ручное исполнение в Midjourney+Figma)
  if starts_with(t, "/visual-spec") then {
    let parts = split(t, " ")
    if length(parts) < 2.0 then { return "Формат: /visual-spec <source_id>" }
    let sid = redact(to_string(json_get(parts, 1, "")), "all")
    return GeneratePremiumSpec("analysis", sid)
  }

  // 8. /visual-recall <id> — recall тест на артефакте
  if starts_with(t, "/visual-recall") then {
    let parts = split(t, " ")
    if length(parts) < 2.0 then { return "Формат: /visual-recall <id>" }
    return VisualRecallTest(redact(to_string(json_get(parts, 1, "")), "all"))
  }

  // Direct command routing
  if contains(q, "карточк") or contains(q, "card") then {
    let parts = split(query, " ")
    if length(parts) >= 3.0 then {
      let src_type = redact(to_string(json_get(parts, 1, "analysis")), "all")
      let src_id = redact(to_string(json_get(parts, 2, "1")), "all")
      return GenerateAnalysisCard(src_type, src_id, chat_id)
    }
  }

  if contains(q, "компресси") or contains(q, "compression") then {
    let parts = split(query, " ")
    if length(parts) >= 3.0 then {
      let src_type = redact(to_string(json_get(parts, 1, "analysis")), "all")
      let src_id = redact(to_string(json_get(parts, 2, "1")), "all")
      return GenerateCompressionVisual(src_type, src_id, chat_id)
    }
  }

  if contains(q, "справк") or contains(q, "reference") then {
    let parts = split(query, " ")
    if length(parts) >= 3.0 then {
      let entity_type = redact(to_string(json_get(parts, 1, "analysis")), "all")
      let entity_id = redact(to_string(json_get(parts, 2, "1")), "all")
      return GenerateReferenceSheet(entity_type, entity_id, chat_id)
    }
  }

  if contains(q, "инфографик") or contains(q, "memorable") then {
    let parts = split(query, " ")
    if length(parts) >= 3.0 then {
      let src_type = redact(to_string(json_get(parts, 1, "analysis")), "all")
      let src_id = redact(to_string(json_get(parts, 2, "1")), "all")
      return GenerateMemorableInfographic(src_type, src_id, chat_id)
    }
  }

  if contains(q, "premium") or contains(q, "spec") then {
    let parts = split(query, " ")
    if length(parts) >= 3.0 then {
      let src_type = redact(to_string(json_get(parts, 1, "analysis")), "all")
      let src_id = redact(to_string(json_get(parts, 2, "1")), "all")
      return GeneratePremiumSpec(src_type, src_id)
    }
  }

  if contains(q, "архив") or contains(q, "archive") or contains(q, "список") then {
    return ListVisuals("")
  }

  // Fallback: general LLM query about visuals
  let dept = "visual"
  let disclaimer = VisualDisclaimer()
  let context = BuildContext(dept, query, chat_id)
  let llm_result = redact(to_string(TryVal(try call_llm(disclaimer + "\n\n" + context, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)
  // ── LLM-Verifier: visualization quality ──
  let visv_resp = TryVal(try call_python("llm_verifier", "score", json_encode([query, reply, "Visual clarity: Is the recommended visualization type appropriate for the data? Data accuracy: Would the suggested chart/graph represent data faithfully? Composition: Are layout, color, and hierarchy well-considered?"])))
  if to_string(visv_resp) != "()" and contains(to_string(visv_resp), "error") == false then {
    let visv_parsed = TryVal(try parse_json(visv_resp))
    let visv_score = to_float(TryVal(try json_get(visv_parsed, "result", "0.5")))
    let _ = AuditLog("visual_verify_score", dept, "score=" + to_string(visv_score))
  }
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  let _ = AuditLog("dept_query", dept, "query: " + substring(query, 0.0, 100.0))
  return reply
}

// ── TEAM-2 #481 A.1: навык visual/visualize (реестр dept/team.mlog) ──
// Тихая облегчённая функция: визуальная спецификация по данным.
// Полный генерационный конвейер не вызывается (дорого для консультации):
// коллега получает спецификацию артефакта, финальный рендер — отдельно.
pattern VisualDeptVisualize(question: String) -> String {
  let prompt = "Ты отдел визуализации, коллега запрашивает навык visualize: спецификация визуального артефакта. Вопрос: " + question + "\nФормат: (1) тип визуализации под задачу; (2) композиция и кодировка данных; (3) палитра и акценты; (4) заголовок и подпись. Без приветствий и подписи."
  let r = redact(to_string(TryVal(try call_llm(prompt, question))), "all")
  if r == "()" then { return "(коллега visual/visualize недоступен: модель не ответила)" }
  return r
}

