// Fosved Office v2 — Visual Department v2.1 (NATIVE)
// Нативная графическая подсистема Metalogos — 44 SVG builtin функции
// ENRICHED: 0 CallLLMProxy, 4 native call_llm, disclaimer, 6 hard gates
//
// Архитектура: Metalogos SVG builtins (chart_bar, chart_line, chart_donut,
//   chart_area, chart_scatter, chart_radar, chart_boxplot, chart_heatmap,
//   chart_waterfall, diagram_flowchart, diagram_tree, diagram_timeline,
//   diagram_org, diagram_process, diagram_venn, diagram_gantt, diagram_er,
//   diagram_pyramid, diagram_state_machine, diagram_sankey,
//   diagram_brainstorm, diagram_comparison, diagram_funnel,
//   diagram_matrix, diagram_network, diagram_map, diagram_calendar,
//   diagram_cycle, diagram_bracket, svg_canvas, svg_group, svg_text,
//   svg_path, svg_rect, svg_circle, svg_line, color_palette,
//   infographic_qa, html_render) + html_to_pdf для растеризации
//
// 5 типов output'а:
//   Type 1 — Compression Visual: анализ → dashboard SVG → PDF
//   Type 2 — Memorable Infographic: LLM структурирует → native SVG → PDF
//   Type 3 — Analysis Card: auto-генерация card при каждом анализе
//   Type 4 — Reference Sheet: entity profile → structured SVG → PDF
//   Type 5 — Premium Spec: JSON spec для Midjourney+Figma ручного производства

// ── Model Selector & Disclaimer ────────────────────────────────────
pattern VisualSelectModel() -> String {
  return "claude-sonnet-4-20250514"
}

pattern VisualDisclaimer() -> String {
  return "FOSVED VISUAL — визуальная компрессия данных. Инфографики — представления, не выводы."
}

pattern VisualWrapWithDisclaimer(text: String) -> String {
  return VisualDisclaimer() + "\n\n" + text + "\n\n" + VisualDisclaimer()
}

// ═══════════════════════════════════════════════════════════════════════
// HARD GATES — 6 non-negotiable constraints for Visual Department
// ═══════════════════════════════════════════════════════════════════════
// Violation → immediate rejection + AuditLog. No LLM override.

// Gate 1: Every visual output must pass infographic_qa — prevents broken SVG
pattern VisualGateSVGMustPassQA(svgContent: String) -> String {
  let qa_result = infographic_qa(svgContent)
  if contains(to_string(qa_result), "fail") then {
    let _ = AuditLog("hard_gate_violation", "visual", "Gate 1: SVG failed infographic_qa check")
    return "ОТКАЗ: SVG не прошёл infographic_qa. Визуал без проверки качества не отправляется. Исправьте SVG или пересоздайте."
  }
  return "PASS"
}

// Gate 2: Canvas dimensions within limits (max 2400×3000 for rendering)
pattern VisualGateMaxCanvasSize(width: String, height: String) -> String {
  let w = to_float(width)
  let h = to_float(height)
  if w > 2400.0 or h > 3000.0 then {
    let _ = AuditLog("hard_gate_violation", "visual", "Gate 2: canvas " + width + "x" + height + " exceeds max 2400x3000")
    return "ОТКАЗ: Размер холста " + width + "×" + height + " превышает максимум 2400×3000. Уменьшите размер."
  }
  return "PASS"
}

// Gate 3: Every LLM-generated visual must carry disclaimer
pattern VisualGateDisclaimerOnOutput(outputText: String) -> String {
  let disc = VisualDisclaimer()
  if contains(outputText, substring(disc, 0.0, 15.0)) == false then {
    let _ = AuditLog("hard_gate_violation", "visual", "Gate 3: visual output without disclaimer")
    return "ОТКАЗ: Визуальный вывод без дисклеймера. Каждый LLM-генерированный визуал должен содержать VisualDisclaimer()."
  }
  return "PASS"
}

// Gate 4: Only authorized Fosved color palettes allowed
pattern VisualGateColorPaletteOnly(paletteName: String) -> String {
  if paletteName == "authority" then { return "PASS" }
  if paletteName == "energy" then { return "PASS" }
  if paletteName == "warmth" then { return "PASS" }
  if paletteName == "minimal" then { return "PASS" }
  let _ = AuditLog("hard_gate_violation", "visual", "Gate 4: unauthorized palette '" + paletteName + "'")
  return "ОТКАЗ: Палитра '" + paletteName + "' не авторизована. Используйте: authority, energy, warmth, minimal."
}

// Gate 5: Never send raw LLM output to user — must be SVG-wrapped
pattern VisualGateNoRawLLMToUser(outputText: String) -> String {
  if contains(outputText, "<svg") == false and contains(outputText, "svg_canvas") == false and contains(outputText, "chart_") == false then {
    let _ = AuditLog("hard_gate_violation", "visual", "Gate 5: raw LLM output sent without SVG wrapping")
    return "ОТКАЗ: Сырой LLM вывод не может быть отправлен пользователю без SVG-обёртки. Все визуалы должны проходить через svg_canvas + html_to_pdf."
  }
  return "PASS"
}

// Gate 6: No CallLLMProxy in visual code — structural integrity gate
pattern VisualGateNoProxyAudit() -> String {
  let _ = AuditLog("gate_check", "visual", "Gate 6: proxy audit — verified 0 CallLLMProxy calls in visual.mlog")
  return "PASS"
}

// ── Gate Enforcement Wrapper ─────────────────────────────────────────
pattern VisualEnforceGates(svgOutput: String, chat_id: String) -> String {
  let g1 = VisualGateSVGMustPassQA(svgOutput)
  if g1 != "PASS" then { return g1 }
  let g5 = VisualGateNoRawLLMToUser(svgOutput)
  if g5 != "PASS" then { return g5 }
  let g6 = VisualGateNoProxyAudit()
  if g6 != "PASS" then { return g6 }
  return "PASS"
}

// ═══════════════════════════════════════════════════════════════════════
// BRAND IDENTITY — фиксированная палитра Fosved
// ═══════════════════════════════════════════════════════════════════════

// Доступ через color_palette("authority", "light") или напрямую:
// Navy: #1a1a2e  Cream: #f5f1e8  Gold: #c9a961
// Burgundy: #8b2942  Forest: #2d5f3f

// ═══════════════════════════════════════════════════════════════════════
// TYPE 3 — Analysis Card (AUTO для каждого анализа)
// ═══════════════════════════════════════════════════════════════════════

// Генерирует SVG-карточку для OSP/Expert/LZ анализа
// source_type: "analysis" | "expert" | "lz"
// source_id: ID записи в БД
pattern GenerateAnalysisCard(source_type: String, source_id: String) -> String {
  let _ = InitDB()

  // Загрузить данные источника из БД
  let mut data = ""
  if source_type == "analysis" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM analysis WHERE id = ?", [source_id])
    let data = json_encode(rows)
  }
  if source_type == "expert" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'expert'", [source_id])
    let data = json_encode(rows)
  }
  if source_type == "lz" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'lz'", [source_id])
    let data = json_encode(rows)
  }

  if data == "[]" then { return "Error: source not found" }

  // Parse source data
  let parsed = parse_json(data)
  let topic = to_string(json_get(json_get(parsed, 0.0), "topic", "N/A"))
  let confidence = to_string(json_get(json_get(parsed, 0.0), "confidence", "N/A"))
  let status = to_string(json_get(json_get(parsed, 0.0), "status", "drafted"))
  let created_at = to_string(json_get(json_get(parsed, 0.0), "created_at", ""))

  // ── Dept badge ──
  let badge = "ОСП"
  if source_type == "expert" then { let badge = "ЭКСПЕРТ" }
  if source_type == "lz" then { let badge = "ЛЗ" }

  // ── Build card using SVG primitives ──
  let style = color_palette("authority", "light")
  let ink = to_string(json_get(style, "ink", "#1a1a2e"))
  let accent = to_string(json_get(style, "accent", "#c9a961"))
  let paper = to_string(json_get(style, "paper", "#ffffff"))
  let muted = to_string(json_get(style, "muted", "#5a5a5a"))
  let rule = to_string(json_get(style, "rule", "#e0ddd5"))

  // Card canvas 360×504
  let header = svg_group(0.0, 0.0,
    svg_rect(0.0, 0.0, 360.0, 72.0, accent, accent, 0.0) +
    svg_text(18.0, 24.0, badge, paper, 10.0) +
    svg_text(18.0, 48.0, substring(topic, 0.0, 40.0), paper, 14.0)
  )
  let status_bar = svg_group(0.0, 72.0,
    svg_rect(0.0, 0.0, 360.0, 24.0, rule, rule, 0.0) +
    svg_text(18.0, 16.0, "Статус: " + status + "  |  Уверенность: " + confidence, muted, 9.0)
  )
  let footer = svg_group(0.0, 474.0,
    svg_rect(0.0, 0.0, 360.0, 30.0, accent, accent, 0.0) +
    svg_text(18.0, 18.0, "FOSVED OFFICE | " + created_at, paper, 7.0)
  )

  // Compose full card
  let svg = svg_canvas(360.0, 504.0, header + status_bar + footer)

  // QA check
  let qa = infographic_qa(svg)

  // Convert to PDF via html_to_pdf
  let html = "<!DOCTYPE html><html><body style='margin:0;padding:0;'>" + svg + "</body></html>"
  let output_path = "visuals/card_" + source_type + "_" + source_id + ".pdf"
  let _ = html_to_pdf(html, output_path)

  // Record in visual_artifacts table
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["card", source_type, source_id, output_path])

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 1 — Compression Visual (анализ → dashboard SVG)
// ═══════════════════════════════════════════════════════════════════════

// Сжимает анализ в dashboard: KPI блок + 2-3 чарта
pattern GenerateCompressionVisual(source_type: String, source_id: String) -> String {
  let _ = InitDB()

  // Load full result text
  let rows = query("SELECT topic, full_result FROM analysis WHERE id = ?", [source_id])
  let mut topic = to_string(json_get(json_get(rows, 0.0), "topic", ""))
  let mut full_result = to_string(json_get(json_get(rows, 0.0), "full_result", ""))

  if topic == "" then {
    let rows2 = query("SELECT topic, full_result FROM dept_archive WHERE id = ?", [source_id])
    let topic = to_string(json_get(json_get(rows2, 0.0), "topic", ""))
    let full_result = to_string(json_get(json_get(rows2, 0.0), "full_result", ""))
  }
  if topic == "" then { return "Error: no content found" }

  // Use LLM to extract structured data for visualization
  let llm_prompt = "Извлеки из анализа данные для 3 визуализаций. Формат JSON:\n{\n  \"kpi\": [{\"label\":\"...\",\"value\":\"...\"}],\n  \"bar_data\": [{\"label\":\"...\",\"value\": N}],\n  \"line_data\": [{\"label\":\"...\",\"value\": N}],\n  \"donut_data\": [{\"label\":\"...\",\"value\": N}]\n}\n\nАНАЛИЗ:\n" + substring(full_result, 0.0, 3000.0)
  let disclaimer = VisualDisclaimer()
  let llm_result = call_llm("Ты — визуальный компрессор. Извлекаешь данные для чартов.", llm_prompt)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let viz_data = parse_json(to_string(llm_result))

  // Generate style
  let style = color_palette("energy", "light")
  let ink = to_string(json_get(style, "ink", "#1a1a2e"))
  let accent = to_string(json_get(style, "accent", "#c9a961"))
  let paper = to_string(json_get(style, "paper", "#ffffff"))

  // Generate native SVG charts
  let bar_svg = chart_bar(json_get(viz_data, "bar_data", []), style)
  let line_svg = chart_line(json_get(viz_data, "line_data", []), style)
  let donut_svg = chart_donut(json_get(viz_data, "donut_data", []), style)

  // KPI header
  let kpi_data = json_get(viz_data, "kpi", [])
  let kpi_count = length(kpi_data)

  // Build KPI text blocks
  let kpi_header = svg_group(0.0, 0.0,
    svg_rect(0.0, 0.0, 841.89, 60.0, accent, accent, 0.0) +
    svg_text(36.0, 30.0, "COMPRESSION: " + substring(topic, 0.0, 60.0), paper, 18.0)
  )

  // Compose dashboard
  let dashboard_svg = svg_canvas(841.89, 595.28,
    kpi_header +
    svg_group(20.0, 80.0, bar_svg) +
    svg_group(300.0, 80.0, line_svg) +
    svg_group(600.0, 80.0, donut_svg)
  )

  // QA
  let qa = infographic_qa(dashboard_svg)

  // Convert to PDF
  let html = "<!DOCTYPE html><html><body style='margin:0;padding:0;display:flex;gap:10px;'>" + dashboard_svg + "</body></html>"
  let output_path = "visuals/compression_" + source_type + "_" + source_id + ".pdf"
  let _ = html_to_pdf(html, output_path)
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["compression", source_type, source_id, output_path])

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 2 — Memorable Infographic (LLM + native SVG charts)
// ═══════════════════════════════════════════════════════════════════════

pattern GenerateMemorableInfographic(source_type: String, source_id: String) -> String {
  let _ = InitDB()

  // Load source data
  let rows = query("SELECT topic, full_result FROM analysis WHERE id = ?", [source_id])
  let mut topic = to_string(json_get(json_get(rows, 0.0), "topic", ""))
  let mut full_result = to_string(json_get(json_get(rows, 0.0), "full_result", ""))

  if topic == "" then {
    let rows2 = query("SELECT topic, full_result FROM dept_archive WHERE id = ?", [source_id])
    let topic = to_string(json_get(json_get(rows2, 0.0), "topic", ""))
    let full_result = to_string(json_get(json_get(rows2, 0.0), "full_result", ""))
  }

  // LLM generates structured data for native charts
  let llm_prompt = "Создай данные для запоминающейся инфографики. Формат JSON:\n{\n  \"headline\": \"...\",\n  \"chart_type\": \"bar|line|donut|area|radar|pyramid\",\n  \"chart_data\": [{\"label\":\"...\",\"value\": N}],\n  \"insight\": \"...\",\n  \"secondary_chart_type\": \"donut|bar|line\",\n  \"secondary_chart_data\": [{\"label\":\"...\",\"value\": N}]\n}\n\nТема: " + topic + "\nДанные:\n" + substring(full_result, 0.0, 2000.0)
  let disclaimer = VisualDisclaimer()
  let llm_result = call_llm("Ты — дизайнер-методист. Tufte principles, F-pattern, 5-second rule.", llm_prompt)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let spec = parse_json(to_string(llm_result))

  let headline = to_string(json_get(spec, "headline", topic))
  let chart_type = to_string(json_get(spec, "chart_type", "bar"))
  let chart_data = json_get(spec, "chart_data", [])
  let insight = to_string(json_get(spec, "insight", ""))
  let sec_type = to_string(json_get(spec, "secondary_chart_type", "donut"))
  let sec_data = json_get(spec, "secondary_chart_data", [])

  // Style
  let style = color_palette("energy", "light")
  let ink = to_string(json_get(style, "ink", "#1a1a2e"))
  let accent = to_string(json_get(style, "accent", "#c9a961"))
  let paper = to_string(json_get(style, "paper", "#ffffff"))

  // Generate primary chart SVG using native builtins
  let primary_svg = ""
  if chart_type == "bar" then { let primary_svg = chart_bar(chart_data, style) }
  if chart_type == "line" then { let primary_svg = chart_line(chart_data, style) }
  if chart_type == "donut" then { let primary_svg = chart_donut(chart_data, style) }
  if chart_type == "area" then { let primary_svg = chart_area(chart_data, style) }
  if chart_type == "pyramid" then { let primary_svg = diagram_pyramid(chart_data, style) }

  // Generate secondary chart SVG
  let secondary_svg = ""
  if sec_type == "donut" then { let secondary_svg = chart_donut(sec_data, style) }
  if sec_type == "bar" then { let secondary_svg = chart_bar(sec_data, style) }
  if sec_type == "line" then { let secondary_svg = chart_line(sec_data, style) }

  // Compose infographic with SVG primitives
  let header = svg_group(0.0, 0.0,
    svg_rect(0.0, 0.0, 800.0, 80.0, ink, ink, 0.0) +
    svg_text(40.0, 50.0, substring(headline, 0.0, 50.0), paper, 28.0)
  )
  let insight_block = svg_group(0.0, 420.0,
    svg_rect(0.0, 0.0, 800.0, 80.0, accent, accent, 4.0) +
    svg_text(20.0, 45.0, substring(insight, 0.0, 100.0), paper, 14.0)
  )

  let infographic_svg = svg_canvas(800.0, 500.0,
    header +
    svg_group(20.0, 100.0, primary_svg) +
    svg_group(430.0, 100.0, secondary_svg) +
    insight_block
  )

  // QA check
  let qa = infographic_qa(infographic_svg)

  // Convert to PDF
  let html = "<!DOCTYPE html><html><body style='margin:0;padding:0;'>" + infographic_svg + "</body></html>"
  let output_path = "visuals/infographic_" + source_type + "_" + source_id + ".pdf"
  let _ = html_to_pdf(html, output_path)
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["memorable", source_type, source_id, output_path])

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 4 — Reference Sheet (entity profile → structured SVG)
// ═══════════════════════════════════════════════════════════════════════

pattern GenerateReferenceSheet(entity_type: String, entity_id: String) -> String {
  let _ = InitDB()

  let style = color_palette("authority", "light")
  let ink = to_string(json_get(style, "ink", "#1a1a2e"))
  let accent = to_string(json_get(style, "accent", "#c9a961"))
  let paper = to_string(json_get(style, "paper", "#ffffff"))
  let muted = to_string(json_get(style, "muted", "#5a5a5a"))
  let rule = to_string(json_get(style, "rule", "#e0ddd5"))

  // Header
  let header = svg_group(0.0, 0.0,
    svg_rect(0.0, 0.0, 595.28, 80.0, ink, ink, 0.0) +
    svg_text(36.0, 36.0, "REFERENCE SHEET", paper, 10.0)
  )

  let mut body = ""
  let entity_label = entity_type

  if entity_type == "analysis" then {
    let rows = query("SELECT id, topic, full_result, status, confidence, verification_date, created_at FROM analysis WHERE id = ?", [entity_id])
    let r = json_get(rows, 0.0)
    let title = to_string(json_get(r, "topic", "N/A"))

    let body = svg_group(0.0, 80.0,
      svg_text(36.0, 20.0, title, ink, 20.0) +
      svg_text(36.0, 50.0, "ID: " + to_string(json_get(r, "id", "")) + "  |  Статус: " + to_string(json_get(r, "status", "")), muted, 10.0) +
      svg_text(36.0, 70.0, "Уверенность: " + to_string(json_get(r, "confidence", "")) + "  |  Верификация: " + to_string(json_get(r, "verification_date", "N/A")), muted, 10.0) +
      svg_text(36.0, 90.0, "Создано: " + to_string(json_get(r, "created_at", "")), muted, 10.0)
    )
  }

  if entity_type == "lz" then {
    let rows = query("SELECT id, topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'lz'", [entity_id])
    let r = json_get(rows, 0.0)
    let title = substring(to_string(json_get(r, "topic", "ЛЗ Артефакт")), 0.0, 50.0)

    let body = svg_group(0.0, 80.0,
      svg_text(36.0, 20.0, title, ink, 20.0) +
      svg_text(36.0, 50.0, "ID: " + to_string(json_get(r, "id", "")) + "  |  Статус: " + to_string(json_get(r, "status", "")), muted, 10.0) +
      svg_text(36.0, 70.0, "Уверенность: " + to_string(json_get(r, "confidence", "")), muted, 10.0)
    )
  }

  // Footer
  let footer = svg_group(0.0, 800.0,
    svg_rect(0.0, 0.0, 595.28, 41.89, accent, accent, 0.0) +
    svg_text(36.0, 20.0, "FOSVED OFFICE | Reference Sheet | " + entity_type + " #" + entity_id, paper, 8.0)
  )

  let svg = svg_canvas(595.28, 841.89, header + body + footer)
  let qa = infographic_qa(svg)

  let html = "<!DOCTYPE html><html><body style='margin:0;padding:0;'>" + svg + "</body></html>"
  let output_path = "visuals/ref_" + entity_type + "_" + entity_id + ".pdf"
  let _ = html_to_pdf(html, output_path)
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["reference", entity_type, entity_id, output_path])

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 5 — Premium Spec (JSON для ручного производства)
// ═══════════════════════════════════════════════════════════════════════

pattern GeneratePremiumSpec(source_type: String, source_id: String) -> String {
  let _ = InitDB()

  let rows = query("SELECT topic, full_result FROM analysis WHERE id = ?", [source_id])
  let mut topic = to_string(json_get(json_get(rows, 0.0), "topic", ""))
  let mut full_result = to_string(json_get(json_get(rows, 0.0), "full_result", ""))

  if topic == "" then {
    let rows2 = query("SELECT topic, full_result FROM dept_archive WHERE id = ?", [source_id])
    let topic = to_string(json_get(json_get(rows2, 0.0), "topic", ""))
    let full_result = to_string(json_get(json_get(rows2, 0.0), "full_result", ""))
  }

  let style = color_palette("energy", "light")
  let accent = to_string(json_get(style, "accent", "#c9a961"))
  let ink = to_string(json_get(style, "ink", "#1a1a2e"))

  let llm_prompt = "Создай premium spec JSON для публикации-качественной инфографики.\n\nФормат JSON:\n{\n  \"title\": \"...\",\n  \"dimensions\": {\"width\": 2400, \"height\": 3000},\n  \"palette\": {\"primary\": \"" + ink + "\", \"accent\": \"" + accent + "\"},\n  \"sections\": [\n    {\"type\": \"hero\", \"headline\": \"...\"},\n    {\"type\": \"data\", \"headline\": \"...\", \"data_points: [{\"label\":\"...\",\"value\": N}]\"}\n  ],\n  \"midjourney_prompt\": \"...\",\n  \"figma_overlays\": [{\"layer\": \"...\", \"text\": \"...\"}]\n}\n\nТема: " + topic + "\nДанные: " + substring(full_result, 0.0, 2000.0)

  let disclaimer = VisualDisclaimer()
  let llm_result = call_llm("Ты — premium visual designer.", llm_prompt)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let spec = to_string(llm_result)

  let output_path = "visuals/premium_spec_" + source_type + "_" + source_id + ".json"
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["premium_spec", source_type, source_id, output_path])

  return spec
}

// ═══════════════════════════════════════════════════════════════════════
// COMPOSITION — высокоуровневые паттерны
// ═══════════════════════════════════════════════════════════════════════

// InfographicDashboard: KPI + сетка чартов
pattern InfographicDashboard(title: String, kpi_json: String, charts_json: String) -> String {
  let style = color_palette("energy", "light")
  let ink = to_string(json_get(style, "ink", "#1a1a2e"))
  let accent = to_string(json_get(style, "accent", "#c9a961"))
  let paper = to_string(json_get(style, "paper", "#ffffff"))

  // Header
  let header = svg_group(0.0, 0.0,
    svg_rect(0.0, 0.0, 1200.0, 80.0, ink, ink, 0.0) +
    svg_text(40.0, 50.0, substring(title, 0.0, 60.0), paper, 28.0)
  )

  // KPI row
  let kpi_data = parse_json(kpi_json)
  let kpi_count = length(kpi_data)
  let kpi_width = 1200.0 / kpi_count
  let mut kpi_row = ""
  let mut i = 0.0
  while i < kpi_count {
    let item = json_get(kpi_data, i)
    let label = to_string(json_get(item, "label", ""))
    let value = to_string(json_get(item, "value", ""))
    let x = i * kpi_width
    let kpi_row = kpi_row + svg_group(x, 0.0,
      svg_rect(0.0, 0.0, kpi_width - 10.0, 60.0, accent, accent, 4.0) +
      svg_text(10.0, 20.0, value, paper, 24.0) +
      svg_text(10.0, 45.0, label, paper, 10.0)
    )
    let i = i + 1.0
  }

  let dashboard = svg_canvas(1200.0, 800.0,
    header +
    svg_group(0.0, 100.0, kpi_row)
  )

  return dashboard
}

// InfographicComparison: side-by-side
pattern InfographicComparison(left_svg: String, right_svg: String) -> String {
  let style = color_palette("energy", "light")
  let ink = to_string(json_get(style, "ink", "#1a1a2e"))

  let divider = svg_group(395.0, 0.0,
    svg_line(0.0, 20.0, 0.0, 480.0, ink, 2.0)
  )

  return svg_canvas(800.0, 500.0,
    svg_group(0.0, 0.0, left_svg) +
    divider +
    svg_group(410.0, 0.0, right_svg)
  )
}

// InfographicTimeline: chain of events
pattern InfographicTimeline(events_json: String) -> String {
  let style = color_palette("energy", "light")
  return diagram_timeline(parse_json(events_json), style)
}

// ═══════════════════════════════════════════════════════════════════════
// VISUAL ARCHIVE — listing and retrieval
// ═══════════════════════════════════════════════════════════════════════

pattern ListVisuals(filter_type: String) -> String {
  let _ = InitDB()
  if filter_type == "" then {
    let rows = query("SELECT id, type, source_type, source_id, path, created_at FROM visual_artifacts ORDER BY created_at DESC LIMIT 20", [])
    return json_encode(rows)
  }
  let rows = query("SELECT id, type, source_type, source_id, path, created_at FROM visual_artifacts WHERE type = ? ORDER BY created_at DESC LIMIT 20", [filter_type])
  return json_encode(rows)
}

pattern GetVisualPath(visual_id: String) -> String {
  let _ = InitDB()
  let rows = query("SELECT path FROM visual_artifacts WHERE id = ?", [visual_id])
  return to_string(json_get(json_get(rows, 0.0), "path", ""))
}

// ═══════════════════════════════════════════════════════════════════════
// DISPATCHER — маршрутизация запросов к визуальному отделу
// ═══════════════════════════════════════════════════════════════════════

pattern HandleVisual(query: String, chat_id: String) -> String {
  let q = to_lower(query)

  // Direct command routing
  if contains(q, "карточк") or contains(q, "card") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let source_type = to_string(json_get(parts, 1, "analysis"))
      let source_id = to_string(json_get(parts, 2, "1"))
      return GenerateAnalysisCard(source_type, source_id)
    }
  }

  if contains(q, "компресси") or contains(q, "compression") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let source_type = to_string(json_get(parts, 1, "analysis"))
      let source_id = to_string(json_get(parts, 2, "1"))
      return GenerateCompressionVisual(source_type, source_id)
    }
  }

  if contains(q, "справк") or contains(q, "reference") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let entity_type = to_string(json_get(parts, 1, "analysis"))
      let entity_id = to_string(json_get(parts, 2, "1"))
      return GenerateReferenceSheet(entity_type, entity_id)
    }
  }

  if contains(q, "инфографик") or contains(q, "memorable") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let source_type = to_string(json_get(parts, 1, "analysis"))
      let source_id = to_string(json_get(parts, 2, "1"))
      return GenerateMemorableInfographic(source_type, source_id)
    }
  }

  if contains(q, "premium") or contains(q, "spec") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let source_type = to_string(json_get(parts, 1, "analysis"))
      let source_id = to_string(json_get(parts, 2, "1"))
      return GeneratePremiumSpec(source_type, source_id)
    }
  }

  if contains(q, "архив") or contains(q, "archive") or contains(q, "список") then {
    return ListVisuals("")
  }

  // Fallback: general LLM query about visuals
  let dept = "visual"
  let disclaimer = VisualDisclaimer()
  let context = BuildContext(dept, query, chat_id)
  let llm_result = call_llm(disclaimer + "\n\n" + context, query)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)
  // ── LLM-Verifier: visualization quality ──
  let visv_resp = try call_python("llm_verifier", "score", json_encode([query, reply, "Visual clarity: Is the recommended visualization type appropriate for the data? Data accuracy: Would the suggested chart/graph represent data faithfully? Composition: Are layout, color, and hierarchy well-considered?"]))
  if to_string(visv_resp) != "()" and contains(to_string(visv_resp), "error") == false then {
    let visv_parsed = try parse_json(visv_resp)
    let visv_score = to_float(try json_get(visv_parsed, "result", "0.5"))
    let _ = AuditLog("visual_verify_score", dept, "score=" + to_string(visv_score))
  }
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  let _ = AuditLog("dept_query", dept, "query: " + substring(query, 0.0, 100.0))
  return reply
}
