// Fosved Office v2 — Visual Department (ENRICHED v1.0)
// Генерация визуальных артефактов 5 типов на PDF-примитивах Metalogos 0.17.0
//
// Архитектура: Metalogos PDF builtins (pdf_create, pdf_draw_rect, pdf_draw_line,
//   pdf_draw_table, pdf_write_text, pdf_save, html_to_pdf) + LLM для data extraction
//
// 5 типов output'а:
//   Type 1 — Compression Visual: многостраничный отчёт → одностраничный PDF
//   Type 2 — Memorable Infographic: LLM + HTML template → PDF (через html_to_pdf)
//   Type 3 — Analysis Card: template-driven PDF для каждого анализа (AUTO)
//   Type 4 — Reference Sheet: одностраничная справка (entity profile)
//   Type 5 — Premium Spec: JSON spec для ручного производства (Midjourney+Figma)

// ═══════════════════════════════════════════════════════════════════════
// BRAND IDENTITY — фиксированная палитра Fosved
// ═══════════════════════════════════════════════════════════════════════

// Цвета (RGB для PDF: 0-1 диапазон, hex для HTML)
// Navy:     #1a1a2e  → RGB 0.102, 0.102, 0.180
// Cream:    #f5f1e8  → RGB 0.961, 0.945, 0.910
// Gold:     #c9a961  → RGB 0.788, 0.663, 0.380
// Burgundy: #8b2942  → RGB 0.545, 0.161, 0.259
// Forest:   #2d5f3f  → RGB 0.176, 0.373, 0.247
// Grey:     #5a5a5a  → RGB 0.353, 0.353, 0.353
// LightGrey:#e0ddd5  → RGB 0.878, 0.867, 0.835

// ═══════════════════════════════════════════════════════════════════════
// PDF CONSTANTS
// ═══════════════════════════════════════════════════════════════════════

// A4: 595.28 × 841.89 pt
// Card: 360 × 504 pt (half A4)
// Margins: 36pt (0.5 inch)
// Grid: 12 columns × 26.67pt, 24pt gutters

// ── Типы карточек (ширина × высота в pt) ──
pattern VisualCanvasWidth() -> Float { return 595.28 }
pattern VisualCanvasHeight() -> Float { return 841.89 }
pattern VisualMargin() -> Float { return 36.0 }
pattern VisualCardWidth() -> Float { return 360.0 }
pattern VisualCardHeight() -> Float { return 504.0 }

// ═══════════════════════════════════════════════════════════════════════
// TYPE 3 — Analysis Card (AUTO для каждого анализа)
// ═══════════════════════════════════════════════════════════════════════

// Генерирует PDF-карточку для OSP/Expert/LZ анализа
// source_type: "analysis" | "expert" | "lz"
// source_id: ID записи в БД
pattern GenerateAnalysisCard(source_type: String, source_id: String) -> String {
  let _ = InitDB()

  // Загрузить данные источника из БД
  let data = ""
  if source_type == "analysis" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM analysis WHERE id = ?", [source_id])
    data = json_encode(rows)
  }
  if source_type == "expert" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'expert'", [source_id])
    data = json_encode(rows)
  }
  if source_type == "lz" then {
    let rows = query("SELECT topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'lz'", [source_id])
    data = json_encode(rows)
  }

  if data == "[]" then { return "Error: source not found" }

  // Parse source data
  let parsed = parse_json(data)
  let topic = to_string(json_get(json_get(parsed, 0.0), "topic", "N/A"))
  let result_text = to_string(json_get(json_get(parsed, 0.0), "full_result", ""))
  let status = to_string(json_get(json_get(parsed, 0.0), "status", "drafted"))
  let confidence = to_string(json_get(json_get(parsed, 0.0), "confidence", "N/A"))
  let created_at = to_string(json_get(json_get(parsed, 0.0), "created_at", ""))

  // Create PDF card
  let pdf_id = pdf_create()
  let _ = pdf_add_page(pdf_id, 360.0, 504.0)

  // ── Header bar (navy) ──
  let _ = pdf_draw_rect(pdf_id, 0.0, 0.0, 360.0, 72.0, false, true)

  // ── Dept badge ──
  let badge = "ОСП"
  if source_type == "expert" then { badge = "ЭКСПЕРТ" }
  if source_type == "lz" then { badge = "ЛЗ" }

  let _ = pdf_write_text(pdf_id, 18.0, 24.0, badge, "Courier-Bold", 10.0)
  let _ = pdf_write_text(pdf_id, 18.0, 48.0, substring(topic, 0.0, 40.0), "Helvetica-Bold", 14.0)

  // ── Status + Confidence bar ──
  let _ = pdf_draw_rect(pdf_id, 0.0, 72.0, 360.0, 24.0, false, true)
  let _ = pdf_write_text(pdf_id, 18.0, 84.0, "Статус: " + status + "  |  Уверенность: " + confidence, "Courier", 9.0)

  // ── Content area (key sections extracted from result) ──
  let y = 120.0
  // Extract first 10 lines of result as summary
  let lines = split_by(result_text, "\n")
  let max_lines = 20.0
  let line_count = to_float(to_string(length(lines)))
  let n = line_count
  if line_count > max_lines then { let n = max_lines }
  let i = 0.0
  // Render first N lines as body text
  while i < n {
    let line = to_string(json_get(lines, i, ""))
    if length(line) > 2.0 then {
      let _ = pdf_write_text(pdf_id, 18.0, y, substring(line, 0.0, 52.0), "Helvetica", 8.0)
      let y = y + 14.0
    }
    let i = i + 1.0
  }

  // ── Footer ──
  let _ = pdf_draw_rect(pdf_id, 0.0, 474.0, 360.0, 30.0, false, true)
  let _ = pdf_write_text(pdf_id, 18.0, 490.0, "FOSVED OFFICE | " + created_at, "Courier", 7.0)

  // Save
  let output_path = "visuals/card_" + source_type + "_" + source_id + ".pdf"
  let _ = pdf_save(pdf_id, output_path)

  // Record in visual_artifacts table
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["card", source_type, source_id, output_path])

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 1 — Compression Visual (многостраничный → одностраничный PDF)
// ═══════════════════════════════════════════════════════════════════════

// Сжимает длинный отчёт в одностраничный PDF с 4-6 секциями
pattern GenerateCompressionVisual(source_type: String, source_id: String) -> String {
  let _ = InitDB()

  // Load full result text
  let rows = query("SELECT full_result FROM analysis WHERE id = ?", [source_id])
  let full_text = to_string(json_get(json_get(rows, 0.0), "full_result", ""))
  if full_text == "" then {
    let rows2 = query("SELECT full_result FROM dept_archive WHERE id = ?", [source_id])
    let full_text = to_string(json_get(json_get(rows2, 0.0), "full_result", ""))
  }
  if full_text == "" then { return "Error: no content found" }

  // Use LLM to extract structured summary for compression
  let llm_prompt = "Извлеки из следующего анализа 6 ключевых секций для одностраничной визуализации. Формат: каждая секция — заголовок (макс 30 символов) + 2-3 строки сути. JSON: [{\"title\":\"...\",\"body\":\"...\"}]×6\n\nАНАЛИЗ:\n" + substring(full_text, 0.0, 3000.0)
  let messages = json_encode([{role: "system", content: "Ты — компрессор анализа. Извлекаешь суть."}, {role: "user", content: llm_prompt}])
  let proxy_result = CallLLMProxy("visual", messages)
  let reply = to_string(json_get(parse_json(proxy_result), "reply", "[]"))

  // Create compression visual PDF (A4 landscape)
  let pdf_id = pdf_create()
  let _ = pdf_add_page(pdf_id, 841.89, 595.28)

  // Header
  let topic_row = query("SELECT topic FROM analysis WHERE id = ?", [source_id])
  let topic = to_string(json_get(json_get(topic_row, 0.0), "topic", "Analysis"))
  let _ = pdf_draw_rect(pdf_id, 0.0, 0.0, 841.89, 60.0, false, true)
  let _ = pdf_write_text(pdf_id, 36.0, 30.0, "COMPRESSION: " + substring(topic, 0.0, 60.0), "Helvetica-Bold", 18.0)

  // Render 6 sections in 2×3 grid
  let sections = parse_json(reply)
  let col = 0.0
  let row = 0.0
  let s = 0.0
  while s < 6.0 {
    let sec_title = to_string(json_get(json_get(sections, s), "title", ""))
    let sec_body = to_string(json_get(json_get(sections, s), "body", ""))
    let x = 36.0 + col * 400.0
    let y = 84.0 + row * 170.0

    // Section box
    let _ = pdf_draw_rect(pdf_id, x, y, 370.0, 150.0, true, false)
    // Section title
    let _ = pdf_write_text(pdf_id, x + 12.0, y + 24.0, sec_title, "Helvetica-Bold", 11.0)
    // Section body (wrapped)
    let _ = pdf_write_text(pdf_id, x + 12.0, y + 44.0, substring(sec_body, 0.0, 120.0), "Helvetica", 8.0)

    let col = col + 1.0
    if col >= 2.0 then {
      let col = 0.0
      let row = row + 1.0
    }
    let s = s + 1.0
  }

  // Footer
  let _ = pdf_write_text(pdf_id, 36.0, 570.0, "FOSVED OFFICE | Compression Visual | " + to_string(datetime("now")), "Courier", 7.0)

  let output_path = "visuals/compression_" + source_type + "_" + source_id + ".pdf"
  let _ = pdf_save(pdf_id, output_path)
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["compression", source_type, source_id, output_path])

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 4 — Reference Sheet (одностраничная справка)
// ═══════════════════════════════════════════════════════════════════════

// Генерирует справочную карточку для entity (analysis, project, client)
pattern GenerateReferenceSheet(entity_type: String, entity_id: String) -> String {
  let _ = InitDB()

  let pdf_id = pdf_create()
  let _ = pdf_add_page(pdf_id, 595.28, 841.89)

  // ── Full-width header ──
  let _ = pdf_draw_rect(pdf_id, 0.0, 0.0, 595.28, 80.0, false, true)
  let _ = pdf_write_text(pdf_id, 36.0, 36.0, "REFERENCE SHEET", "Courier-Bold", 10.0)

  // Load entity data based on type
  let entity_label = entity_type
  let y = 108.0

  if entity_type == "analysis" then {
    let rows = query("SELECT id, topic, full_result, status, confidence, verification_date, created_at FROM analysis WHERE id = ?", [entity_id])
    let r = json_get(rows, 0.0)
    let _ = pdf_write_text(pdf_id, 36.0, 36.0, to_string(json_get(r, "topic", "N/A")), "Helvetica-Bold", 20.0)

    // Key-value table
    let fields = json_encode([
      ["ID", to_string(json_get(r, "id", ""))],
      ["Статус", to_string(json_get(r, "status", ""))],
      ["Уверенность", to_string(json_get(r, "confidence", ""))],
      ["Верификация", to_string(json_get(r, "verification_date", "N/A"))],
      ["Создано", to_string(json_get(r, "created_at", ""))]
    ])
    let _ = pdf_draw_table(pdf_id, 36.0, y, json_encode([80.0, 400.0]), fields)
    let y = y + 120.0

    // Research sources
    let sources = query("SELECT url, title, tier FROM research_source WHERE analysis_id = ? ORDER BY tier", [entity_id])
    let _ = pdf_write_text(pdf_id, 36.0, y, "ИСТОЧНИКИ (" + to_string(length(sources)) + ")", "Helvetica-Bold", 12.0)
    let y = y + 20.0
    let si = 0.0
    while si < to_float(to_string(length(sources))) {
      let src = json_get(sources, si)
      let _ = pdf_write_text(pdf_id, 48.0, y, "[" + to_string(json_get(src, "tier", "?")) + "] " + substring(to_string(json_get(src, "title", "")), 0.0, 60.0), "Helvetica", 8.0)
      let y = y + 14.0
      let si = si + 1.0
    }
  }

  if entity_type == "lz" then {
    let rows = query("SELECT id, topic, full_result, status, confidence, created_at FROM dept_archive WHERE id = ? AND dept = 'lz'", [entity_id])
    let r = json_get(rows, 0.0)
    let _ = pdf_write_text(pdf_id, 36.0, 36.0, substring(to_string(json_get(r, "topic", "ЛЗ Артефакт")), 0.0, 50.0), "Helvetica-Bold", 20.0)

    let fields = json_encode([
      ["ID", to_string(json_get(r, "id", ""))],
      ["Статус", to_string(json_get(r, "status", ""))],
      ["Уверенность", to_string(json_get(r, "confidence", ""))],
      ["Создано", to_string(json_get(r, "created_at", ""))]
    ])
    let _ = pdf_draw_table(pdf_id, 36.0, y, json_encode([80.0, 400.0]), fields)
  }

  // ── Footer ──
  let _ = pdf_draw_rect(pdf_id, 0.0, 800.0, 595.28, 41.89, false, true)
  let _ = pdf_write_text(pdf_id, 36.0, 820.0, "FOSVED OFFICE | Reference Sheet | " + entity_type + " #" + entity_id, "Courier", 8.0)

  let output_path = "visuals/ref_" + entity_type + "_" + entity_id + ".pdf"
  let _ = pdf_save(pdf_id, output_path)
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["reference", entity_type, entity_id, output_path])

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 2 — Memorable Infographic (через HTML template → PDF)
// ═══════════════════════════════════════════════════════════════════════

// Генерирует запоминающуюся инфографику: LLM создаёт HTML/SVG, html_to_pdf конвертирует
pattern GenerateMemorableInfographic(source_type: String, source_id: String) -> String {
  let _ = InitDB()

  // Load source data
  let rows = query("SELECT topic, full_result FROM analysis WHERE id = ?", [source_id])
  let topic = to_string(json_get(json_get(rows, 0.0), "topic", ""))
  let full_result = to_string(json_get(json_get(rows, 0.0), "full_result", ""))

  if topic == "" then {
    let rows2 = query("SELECT topic, full_result FROM dept_archive WHERE id = ?", [source_id])
    let topic = to_string(json_get(json_get(rows2, 0.0), "topic", ""))
    let full_result = to_string(json_get(json_get(rows2, 0.0), "full_result", ""))
  }

  // LLM generates HTML with inline SVG for the infographic
  let llm_prompt = "Создай HTML-инфографику для анализа. Требования:\n1. Inline SVG, 800x1000px viewport\n2. Brand palette: navy #1a1a2e, cream #f5f1e8, gold #c9a961, burgundy #8b2942, forest #2d5f3f\n3. F-pattern reading flow (important top-left)\n4. Max 5 key data points visualized\n5. Font: system-ui sans-serif\n6. Each visual element must carry information (anti-chartjunk)\n7. Include: header, 2-3 chart sections, key takeaway, footer\n\nТема: " + topic + "\n\nДанные:\n" + substring(full_result, 0.0, 2000.0) + "\n\nВерни ТОЛЬКО HTML код (no markdown, no code fences)."

  let messages = json_encode([{role: "system", content: "Ты — дизайнер-методист инфографик. SVG-first, Tufte principles, F-pattern."}, {role: "user", content: llm_prompt}])
  let proxy_result = CallLLMProxy("visual", messages)
  let html_content = to_string(json_get(parse_json(proxy_result), "reply", "<html><body>Error</body></html>"))

  // Convert HTML to PDF
  let output_path = "visuals/infographic_" + source_type + "_" + source_id + ".pdf"
  let result = html_to_pdf(html_content, output_path)

  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["memorable", source_type, source_id, output_path])

  return output_path
}

// ═══════════════════════════════════════════════════════════════════════
// TYPE 5 — Premium Spec (JSON для ручного производства)
// ═══════════════════════════════════════════════════════════════════════

// Генерирует JSON spec для Midjourney + Figma ручного производства
pattern GeneratePremiumSpec(source_type: String, source_id: String) -> String {
  let _ = InitDB()

  let rows = query("SELECT topic, full_result FROM analysis WHERE id = ?", [source_id])
  let topic = to_string(json_get(json_get(rows, 0.0), "topic", ""))
  let full_result = to_string(json_get(json_get(rows, 0.0), "full_result", ""))

  if topic == "" then {
    let rows2 = query("SELECT topic, full_result FROM dept_archive WHERE id = ?", [source_id])
    let topic = to_string(json_get(json_get(rows2, 0.0), "topic", ""))
    let full_result = to_string(json_get(json_get(rows2, 0.0), "full_result", ""))
  }

  // LLM generates premium spec
  let llm_prompt = "Создай premium spec JSON для публикации-качественной инфографики.\n\nФормат JSON:\n{\n  \"title\": \"...\",\n  \"dimensions\": {\"width\": 2400, \"height\": 3000},\n  \"palette\": {\"primary\": \"#1a1a2e\", \"accent\": \"#c9a961\", \"alert\": \"#8b2942\", \"positive\": \"#2d5f3f\"},\n  \"sections\": [\n    {\"type\": \"hero\", \"headline\": \"...\", \"subheadline\": \"...\", \"visual\": \"chart|map|icon|comparison\"},\n    {\"type\": \"data\", \"headline\": \"...\", \"data_points\": [{\"label\": \"...\", \"value\": \"...\", \"visual_treatment\": \"bar|gauge|sparkline|icon\"}]},\n    {\"type\": \"insight\", \"headline\": \"...\", \"body\": \"...\"}\n  ],\n  \"midjourney_prompt\": \"...\",\n  \"figma_overlays\": [{\"layer\": \"...\", \"text\": \"...\", \"position\": \"...\"}]\n}\n\nТема: " + topic + "\nДанные: " + substring(full_result, 0.0, 2000.0)

  let messages = json_encode([{role: "system", content: "Ты — premium visual designer. Генерируешь JSON spec для Midjourney+Figma."}, {role: "user", content: llm_prompt}])
  let proxy_result = CallLLMProxy("visual", messages)
  let spec = to_string(json_get(parse_json(proxy_result), "reply", "{}"))

  // Save spec as text record
  let output_path = "visuals/premium_spec_" + source_type + "_" + source_id + ".json"
  let _ = try db_execute("INSERT INTO visual_artifacts (type, source_type, source_id, path, created_at) VALUES (?, ?, ?, ?, datetime('now'))", ["premium_spec", source_type, source_id, output_path])

  return spec
}

// ═══════════════════════════════════════════════════════════════════════
// BAR CHART — рисует bar chart на существующем PDF
// ═══════════════════════════════════════════════════════════════════════

// Рисует bar chart на активной странице PDF
// id: PDF handle, x/y: top-left corner, w/h: chart area
// categories_json: ["Cat1","Cat2",...], values_json: [10,25,...]
pattern DrawBarChart(id: String, x: Float, y: Float, w: Float, h: Float, categories_json: String, values_json: String) -> String {
  let categories = parse_json(categories_json)
  let values = parse_json(values_json)
  let n = length(values)

  if n < 1.0 then { return "Error: empty data" }

  // Find max value for scaling
  let max_val = 0.0
  let i = 0.0
  while i < n {
    let v = to_float(to_string(json_get(values, i, 0.0)))
    if v > max_val then { let max_val = v }
    let i = i + 1.0
  }
  if max_val == 0.0 then { let max_val = 1.0 }

  // Draw axes
  let _ = pdf_draw_line(id, x, y, x, y + h, 1.0)       // Y axis
  let _ = pdf_draw_line(id, x, y + h, x + w, y + h, 1.0) // X axis

  // Draw bars
  let bar_width = (w - 20.0) / to_float(to_string(n))
  let i = 0.0
  while i < n {
    let v = to_float(to_string(json_get(values, i, 0.0)))
    let bar_h = (v / max_val) * (h - 30.0)
    let bar_x = x + 10.0 + to_float(to_string(i)) * bar_width
    let bar_y = y + h - bar_h

    // Bar (filled rect)
    let _ = pdf_draw_rect(id, bar_x, bar_y, bar_width - 4.0, bar_h, false, true)

    // Value label on top
    let _ = pdf_write_text(id, bar_x, bar_y - 12.0, to_string(json_get(values, i, "")), "Courier", 7.0)

    // Category label below
    let cat = substring(to_string(json_get(categories, i, "")), 0.0, 8.0)
    let _ = pdf_write_text(id, bar_x, y + h + 10.0, cat, "Helvetica", 6.0)

    let i = i + 1.0
  }

  return "ok"
}

// ═══════════════════════════════════════════════════════════════════════
// VISUAL ARCHIVE — listing and retrieval
// ═══════════════════════════════════════════════════════════════════════

pattern ListVisuals(filter_type: String) -> String {
  let _ = InitDB()
  if filter_type == "" then {
    let rows = query("SELECT id, type, source_type, source_id, path, created_at FROM visual_artifacts ORDER BY created_at DESC LIMIT 20", [])
    return json_encode(rows)
  }
  let rows = query("SELECT id, type, source_type, source_id, path, created_at FROM visual_artifacts WHERE type = ? ORDER BY created_at DESC LIMIT 20", [filter_type])
  return json_encode(rows)
}

pattern GetVisualPath(visual_id: String) -> String {
  let _ = InitDB()
  let rows = query("SELECT path FROM visual_artifacts WHERE id = ?", [visual_id])
  return to_string(json_get(json_get(rows, 0.0), "path", ""))
}

// ═══════════════════════════════════════════════════════════════════════
// DISPATCHER — маршрутизация запросов к визуальному отделу
// ═══════════════════════════════════════════════════════════════════════

pattern HandleVisual(query: String, chat_id: String) -> String {
  let q = to_lower(query)

  // Direct command routing
  if contains(q, "карточк") or contains(q, "card") then {
    // /visual-card <source_type> <source_id>
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let source_type = to_string(json_get(parts, 1, "analysis"))
      let source_id = to_string(json_get(parts, 2, "1"))
      return GenerateAnalysisCard(source_type, source_id)
    }
  }

  if contains(q, "компресси") or contains(q, "compression") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let source_type = to_string(json_get(parts, 1, "analysis"))
      let source_id = to_string(json_get(parts, 2, "1"))
      return GenerateCompressionVisual(source_type, source_id)
    }
  }

  if contains(q, "справк") or contains(q, "reference") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let entity_type = to_string(json_get(parts, 1, "analysis"))
      let entity_id = to_string(json_get(parts, 2, "1"))
      return GenerateReferenceSheet(entity_type, entity_id)
    }
  }

  if contains(q, "инфографик") or contains(q, "memorable") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let source_type = to_string(json_get(parts, 1, "analysis"))
      let source_id = to_string(json_get(parts, 2, "1"))
      return GenerateMemorableInfographic(source_type, source_id)
    }
  }

  if contains(q, "premium") or contains(q, "spec") then {
    let parts = split_by(query, " ")
    if length(parts) >= 3.0 then {
      let source_type = to_string(json_get(parts, 1, "analysis"))
      let source_id = to_string(json_get(parts, 2, "1"))
      return GeneratePremiumSpec(source_type, source_id)
    }
  }

  if contains(q, "архив") or contains(q, "archive") or contains(q, "список") then {
    return ListVisuals("")
  }

  // Fallback: general LLM query about visuals
  let dept = "visual"
  let context = BuildContext(dept, query, chat_id)
  let messages = json_encode([{role: "system", content: context}, {role: "user", content: query}])
  let proxy_result = CallLLMProxy(dept, messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error: empty reply")
  let _ = RecordAssistantMessage(chat_id, dept, to_string(reply))
  let _ = AuditLog("dept_query", dept, "query: " + substring(query, 0.0, 100.0))
  return to_string(reply)
}
