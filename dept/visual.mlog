// Fosved Office v2 — Visual Department v2.1 (NATIVE)
// Нативная графическая подсистема Metalogos — 44 SVG builtin функции
// ENRICHED: 0 CallLLMProxy, 4 native call_llm, disclaimer, 6 hard gates
//
// Архитектура: Metalogos SVG builtins (chart_bar, chart_line, chart_donut,
//   chart_area, chart_scatter, chart_radar, chart_boxplot, chart_heatmap,
//   chart_waterfall, diagram_flowchart, diagram_tree, diagram_timeline,
//   diagram_org, diagram_process, diagram_venn, diagram_gantt, diagram_er,
//   diagram_pyramid, diagram_state_machine, diagram_sankey,
//   diagram_brainstorm, diagram_comparison, diagram_funnel,
//   diagram_matrix, diagram_network, diagram_map, diagram_calendar,
//   diagram_cycle, diagram_bracket, svg_canvas, svg_group, svg_text,
//   svg_path, svg_rect, svg_circle, svg_line, color_palette,
//   infographic_qa, html_render). Растеризация PDF — python-сторона
//   (/render-card-pdf, /render-svg-pdf; #499 A.5 и #515 — движковый
//   html_to_pdf теряет кириллицу и срезает вёрстку)
//
// 5 типов output'а:
//   Type 1 — Compression Visual: анализ → dashboard SVG → PDF
//   Type 2 — Memorable Infographic: LLM структурирует → native SVG → PDF
//   Type 3 — Analysis Card: auto-генерация card при каждом анализе
//   Type 4 — Reference Sheet: entity profile → structured SVG → PDF
//   Type 5 — Premium Spec: JSON spec для Midjourney+Figma ручного производства

// ── Model Selector & Disclaimer ────────────────────────────────────
pattern VisualSelectModel() -> String {
  return "claude-sonnet-4-20250514"
}

pattern VisualDisclaimer() -> String {
  return "FOSVED VISUAL — визуальная компрессия данных. Инфографики — представления, не выводы."
}

pattern VisualWrapWithDisclaimer(text: String) -> String {
  return VisualDisclaimer() + "\n\n" + text + "\n\n" + VisualDisclaimer()
}

