// АРХИВ неимпортируемого файла (#449 A.3, решение владельца 2026-10-02):
// dept/forge_create_bridge.mlog не входил в прод-замыкание app.mlog (0 import).
// Перенесён из dept/ целиком; оживёт потребность — переносить назад осознанно.
// ═══════════════════════════════════════════════════════════════════════

// FORGE-UI-12 (#215): тонкий мост python→mlog для создания проекта FORGE.
// Вызывается python-роутом POST /api/forge/projects (proxy/routes_admin.py):
//   FNP_SLUG, FNP_NAME, FNP_GOAL, FNP_CUSTOMER, FNP_TYPE ./bin/mlog run dept/forge_create_bridge.mlog
// Вся логика создания — только в существующем паттерне ForgeCreateProject
// (dept/forge.mlog): валидация slug/типа, уникальность slug,
// INSERT INTO forge_projects ... status='active', AuditLog.
// Здесь НЕТ собственного SQL и НЕТ дублирования — только вызов.
// Значения по умолчанию повторяют Telegram-контур создания (dept/forge.mlog,
// форма диалога): description="", template_id=project_type, gate_policy=key_stages,
// model_combo=fosved-standard, departments=dev.
import dept/forge

db { url: env("DATABASE_URL") }

pattern BridgeCreate(inp: String) -> String {
  return ForgeCreateProject(env("FNP_SLUG"), env("FNP_NAME"), "", env("FNP_GOAL"), env("FNP_TYPE"), env("FNP_TYPE"), env("FNP_CUSTOMER"), "key_stages", "fosved-standard", "dev")
}

flow Main {
  input: String = "" -> BridgeCreate -> output
}
