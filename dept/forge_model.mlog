// Fosved Office v2 — dept/forge_model.mlog — FO-036 D: протокол ответа модели (§5.7 ТЗ v3)
// Источник паттернов: Fosved-coder core/response_parser.py (RE_FILE_TAG, RE_MKDIR_TAG,
// RE_READ_TAG, RE_DIFF_BLOCK, _safe_resolve, _patch_lines).
//
// Распознаются 5 форм: <file path="...">, <mkdir path="..."/>, <read file="..."/>,
// ```lang:path, ```diff path="...". Теги <command> и <git> НЕ берём — исполнение
// только через ForgeRun (FO-037), git только через ForgeWriteFiles.
//
// Безопасность: ModelSafePath (только [a-zA-Z0-9._/-], без "/", "..", "$", "`" и
// пр.) ДО любой файловой операции. Читающий цикл: ≤5 файлов и ≤100 КБ за запрос.
// Diff (§5.7 v3): точное совпадение → нечёткое (пробелы/отступы, ровно одно
// близкое место — применить с меткой) → отказ только при неоднозначности.
// Содержимое тегов уходит в ForgeWriteFiles — рубеж ForgeCheckPipeline применяется
// автоматически, обходного пути нет (D.5).
//
// Builtins (проверено исполнением): regex_captures(pattern, string) → [full, g1, ..]
// первого совпадения (не анкерирован, [\s\S] и *? работают); split(s, sep) —
// режет по первому вхождению sep для итерации; escape_json — для payload.

import dept/forge

// ── D.2: _safe_resolve-эквивалент (путь внутри рабочей зоны) ────────────
pattern ModelSafePath(path: String) -> String {
  let trimmed = trim(to_string(path))
  if length(trimmed) < 1.0 or length(trimmed) > 400.0 then { return "" }
  if starts_with(trimmed, "/") then { return "" }          // абсолютный — отказ
  if contains(trimmed, "..") then { return "" }            // эскейп — отказ
  if contains(trimmed, "\\") or contains(trimmed, "`") or contains(trimmed, "$") then { return "" }
  if contains(trimmed, "\"") or contains(trimmed, " ") then { return "" }
  // regex_match(PATTERN, string) — полный матч (проверено раном)
  if regex_match("[a-zA-Z0-9._/-]+", trimmed) == false then { return "" }
  return trimmed
}


// ── D.1: <file path="...">...</file> → JSON-массив [{path, content}] ────
pattern ModelParseFiles(response: String) -> String {
  let mut files = "["
  let mut first = true
  let mut rest = response
  let mut guard = 0.0
  let mut caps = regex_captures("<file path=\"([^\"]+)\">([\\s\\S]*?)</file>", rest)
  while length(caps) >= 3.0 and guard < 50.0 {
    let path = ModelSafePath(to_string(get(caps, 1)))
    if path == "" then { return "ОТКАЗ: путь <file> вне рабочей зоны: " + to_string(get(caps, 1)) }
    let content = to_string(get(caps, 2))
    let files = _Comma(files, first) + "{\"path\":\"" + escape_json(path) + "\",\"content\":\"" + escape_json(content) + "\"}"
    let first = false
    let parts = split(rest, to_string(get(caps, 0)))
    if length(parts) < 2.0 then { let guard = 50.0 } else { let rest = to_string(get(parts, 1)) }
    let guard = guard + 1.0
    let caps = regex_captures("<file path=\"([^\"]+)\">([\\s\\S]*?)</file>", rest)
  }
  if guard >= 50.0 and length(caps) >= 3.0 then { return "ОТКАЗ: слишком много <file>-тегов (>50)" }
  let files = files + "]"
  return files
}

// ── D.1: ```lang:path fenced blocks — то же, что <file> ─────────────────
// Форма: ```python:src/main.py\n...тело...\n``` (путь до перевода строки).
pattern ModelParseFenced(response: String) -> String {
  let mut files = "["
  let mut first = true
  let mut rest = response
  let mut guard = 0.0
  let mut caps = regex_captures("```[a-zA-Z0-9_+.#-]*:([^\\n]+)\\n([\\s\\S]*?)```", rest)
  while length(caps) >= 3.0 and guard < 50.0 {
    let raw = trim(to_string(get(caps, 1)))
    let path = ModelSafePath(raw)
    if path == "" then { return "ОТКАЗ: путь fenced-блока вне рабочей зоны: " + raw }
    let content = to_string(get(caps, 2))
    let files = _Comma(files, first) + "{\"path\":\"" + escape_json(path) + "\",\"content\":\"" + escape_json(content) + "\"}"
    let first = false
    let parts = split(rest, to_string(get(caps, 0)))
    if length(parts) < 2.0 then { let guard = 50.0 } else { let rest = to_string(get(parts, 1)) }
    let guard = guard + 1.0
    let caps = regex_captures("```[a-zA-Z0-9_+.#-]*:([^\\n]+)\\n([\\s\\S]*?)```", rest)
  }
  if guard >= 50.0 and length(caps) >= 3.0 then { return "ОТКАЗ: слишком много fenced-блоков (>50)" }
  let files = files + "]"
  return files
}

// ── D.1: <mkdir path="..."/> — объявление каталогов (валидация) ─────────
pattern ModelParseMkdirs(response: String) -> String {
  let mut dirs = "["
  let mut first = true
  let mut rest = response
  let mut guard = 0.0
  let mut caps = regex_captures("<mkdir path=\"([^\"]+)\"\\s*/>", rest)
  while length(caps) >= 2.0 and guard < 50.0 {
    let d = ModelSafePath(to_string(get(caps, 1)))
    if d == "" then { return "ОТКАЗ: путь <mkdir> вне рабочей зоны: " + to_string(get(caps, 1)) }
    let dirs = _Comma(dirs, first) + "\"" + escape_json(d) + "\""
    let first = false
    let parts = split(rest, to_string(get(caps, 0)))
    if length(parts) < 2.0 then { let guard = 50.0 } else { let rest = to_string(get(parts, 1)) }
    let guard = guard + 1.0
    let caps = regex_captures("<mkdir path=\"([^\"]+)\"\\s*/>", rest)
  }
  let dirs = dirs + "]"
  return dirs
}

// ── D.3: <read file="..."/> — запросы на чтение ─────────────────────────
// FO-043 C.1: необязательные from/to (1-based, включительно):
//   <read file="src/app.py" from="40" to="90"/>
// Полный текст больших файлов — ТОЛЬКО по явному диапазону (см. ModelServeReads).
pattern ModelParseReads(response: String) -> String {
  let mut reads = "["
  let mut first = true
  let mut rest = response
  let mut guard = 0.0
  let mut caps = regex_captures("<read file=\"([^\"]+)\"([^/>]*)/>", rest)
  while length(caps) >= 3.0 and guard < 50.0 {
    let f = ModelSafePath(to_string(get(caps, 1)))
    if f == "" then { return "ОТКАЗ: путь <read> вне рабочей зоны: " + to_string(get(caps, 1)) }
    let attrs = to_string(get(caps, 2))
    let from_m = regex_captures("from=\"([0-9]+)\"", attrs)
    let to_m = regex_captures("to=\"([0-9]+)\"", attrs)
    let from_v = ""
    if length(from_m) >= 2.0 then { let from_v = trim(to_string(get(from_m, 1))) }
    let to_v = ""
    if length(to_m) >= 2.0 then { let to_v = trim(to_string(get(to_m, 1))) }
    let reads = _Comma(reads, first) + "{\"path\":\"" + escape_json(f) + "\",\"from\":\"" + from_v + "\",\"to\":\"" + to_v + "\"}"
    let first = false
    let parts = split(rest, to_string(get(caps, 0)))
    if length(parts) < 2.0 then { let guard = 50.0 } else { let rest = to_string(get(parts, 1)) }
    let guard = guard + 1.0
    let caps = regex_captures("<read file=\"([^\"]+)\"([^/>]*)/>", rest)
  }
  let reads = reads + "]"
  return reads
}

// ── D.3: читающий цикл — ≤5 файлов и ≤100 КБ суммарно за запрос ─────────
// FO-043 C.1 (§5.7 «чтение со сводкой»): файл > 400 строк БЕЗ явного
// диапазона отдаётся структурой (объявления + номера строк) с инструкцией;
// полный текст — только по <read file="..." from="X" to="Y"/> (срез, до 400
// строк). Отказы — инструкцией модели: что делать, а не только что не так.
pattern _ServeReadRange(content: String, from_v: String, to_v: String) -> String {
  let lines = split(content, "\n")
  let n = length(lines)
  // нормализация границ: from пуст → 1; to пуст → from+399 (срез ≤400 строк)
  // №312: 0.21 не парсит присваивание в однострочной ветке, если mut-переменная
  // инициализирована выражением (проба fm_p*: init-литерал + ident-RHS —
  // единственная форма, парсящаяся). Дефолт "1" → переопределение из from_v.
  let mut f = "1"
  if from_v != "" then { f = from_v }
  let mut fpage_n = to_float(f)
  if fpage_n < 1.0 then { let fpage_n = 1.0 }
  let mut tpage_n = to_float(n)
  if to_v != "" then { let tpage_n = to_float(to_v) }
  if to_v == "" then { let tpage_n = fpage_n + 399.0 }
  if fpage_n > n then { return "ОТКАЗ: from=" + from_v + " за пределами файла (" + to_string(n) + " строк) — перечитайте сводку и укажите корректный диапазон" }
  if tpage_n > n then { let tpage_n = to_float(n) }
  if tpage_n < fpage_n then { return "ОТКАЗ: диапазон from=" + from_v + " to=" + to_v + " пуст — проверьте границы (файл " + to_string(n) + " строк)" }
  // срез > 400 строк режется — полный файл читается несколькими запросами
  if tpage_n - fpage_n + 1.0 > 400.0 then { let tpage_n = fpage_n + 399.0 }
  return join(slice(lines, fpage_n - 1.0, tpage_n), "\n")
}

// сводка: объявления (ключевые слова/заголовки/теги) с номерами строк + инструкция
pattern _ServeReadOutline(content: String) -> String {
  let lines = split(content, "\n")
  let n = length(lines)
  let mut out = "СВОДКА ФАЙЛА (" + to_string(n) + " строк, показаны объявления):\n"
  let mut i = 0.0
  let mut found = 0.0
  while i < n {
    let line = to_string(get(lines, i))
    if length(line) > 0.0 and length(line) < 300.0 then {
      let hit = regex_captures("^\\s*(def |class |function |const |let |var |async |import |from |export |func |fn |struct |impl |type |interface |public |private |protected )|^#{1,6} |^<(h[1-3]|section|div|header|footer|nav|main|article|body|head|script|style)", line)
      if length(hit) >= 1.0 and found < 100.0 then {
        let out = out + to_string(i + 1.0) + ": " + trim(substring(line, 0.0, 150.0)) + "\n"
        let found = found + 1.0
      }
    }
    let i = i + 1.0
  }
  let out = out + "Инструкция: полный текст читается по диапазону — <read file=\"...\" from=\"" + to_string(1.0) + "\" to=\"400\"/> (до 400 строк за запрос), затем следующие диапазоны. Правка — только по реально прочитанному контексту."
  return out
}

pattern ModelServeReads(repo_name: String, refv: String, reads_json: String) -> String {
  let paths = parse_json(reads_json)
  if to_string(paths) == "()" then { return "ОТКАЗ: reads не разбираются" }
  let n = length(paths)
  if n > 5.0 then { return "ОТКАЗ: запрошено " + to_string(n) + " файлов за запрос — лимит 5 (защита контекста). Инструкция: разбейте чтение на несколько ходов по ≤5 файлов." }
  let mut out = "{"
  let mut first = true
  let mut total = 0.0
  each p in paths {
    let f = redact(to_string(json_get(p, "path", "")), "all")
    let from_v = redact(to_string(json_get(p, "from", "")), "all")
    let to_v = redact(to_string(json_get(p, "to", "")), "all")
    let content = ForgeReadFile(repo_name, refv, f)
    if starts_with(content, "ОТКАЗ") then { return content }
    // режим (диапазон / сводка / полный) — через паттерн: условные значения
    // в each только через паттерны (ловушка mlog)
    let served = _ServeOne(content, from_v, to_v)
    if starts_with(served, "ОТКАЗ") then { return served }
    let total = total + to_float(length(served))
    let out = _Comma(out, first) + "\"" + escape_json(f) + "\":\"" + escape_json(substring(served, 0.0, 20000.0)) + "\""
    let first = false
  }
  if total > 100000.0 then { return "ОТКАЗ: суммарно " + to_string(total) + " байт — лимит 100 КБ за запрос. Инструкция: читайте файлы диапазонами (<read file=\"...\" from=\"X\" to=\"Y\"/>) и ходами по ≤5 файлов." }
  return out + "}"
}

// выбор режима отдачи: явный диапазон → срез; большой файл без диапазона → сводка
pattern _ServeOne(content: String, from_v: String, to_v: String) -> String {
  if from_v != "" or to_v != "" then { return _ServeReadRange(content, from_v, to_v) }
  if length(split(content, "\n")) > 400.0 then { return _ServeReadOutline(content) }
  return content
}

// ── D.4: ```diff path="..." — точечная правка по строкам ────────────────
// Внутри fence: строки "- X" (удалить) и "+ Y" (добавить). Удалённые строки
// ищутся подряд: точное совпадение → нечёткое (§5.7) → отказ только при
// неоднозначности. Возвращает JSON-массив файлов [{path, removed, added}].
pattern ModelParseDiffs(response: String) -> String {
  let mut files = "["
  let mut first = true
  let mut rest = response
  let mut guard = 0.0
  let mut caps = regex_captures("```diff[ \\t]+path=\"([^\"]+)\"\\n([\\s\\S]*?)```", rest)
  while length(caps) >= 3.0 and guard < 50.0 {
    let path = ModelSafePath(to_string(get(caps, 1)))
    if path == "" then { return "ОТКАЗ: путь diff вне рабочей зоны: " + to_string(get(caps, 1)) }
    let body = to_string(get(caps, 2))
    let lines = split(body, "\n")
    let mut removed = "["
    let mut added = "["
    let mut fr = true
    let mut fa = true
    each line in lines {
      let l = to_string(line)
      // формы «- X» и «-X» (и +) внутри ```diff fence; остальное — контекст/шум
      if starts_with(l, "-") and length(l) >= 2.0 then {
        if fr == false then { let removed = removed + "," }
        let removed = removed + "\"" + escape_json(trim(substring(l, 1.0, length(l)))) + "\""
        let fr = false
      }
      if starts_with(l, "+") and length(l) >= 2.0 then {
        if fa == false then { let added = added + "," }
        let added = added + "\"" + escape_json(trim(substring(l, 1.0, length(l)))) + "\""
        let fa = false
      }
    }
    let removed = removed + "]"
    let added = added + "]"
    if fr == true and fa == true then { return "ОТКАЗ: пустой diff-блок в " + path }
    // Точечное применение выполнит вызывающий через ModelApplyDiff (нужен ref)
    // removed/added — СТРОКИ, склеенные \n (json_get отдаёт Value, не List —
    // конкатенация/срезы списков напрямую недоступны)
    let rem_list = parse_json(removed)
    let add_list = parse_json(added)
    let files = _Comma(files, first) + "{\"path\":\"" + escape_json(path) + "\",\"removed\":\"" + escape_json(join(rem_list, "\n")) + "\",\"added\":\"" + escape_json(join(add_list, "\n")) + "\"}"
    let first = false
    let parts = split(rest, to_string(get(caps, 0)))
    if length(parts) < 2.0 then { let guard = 50.0 } else { let rest = to_string(get(parts, 1)) }
    let guard = guard + 1.0
    let caps = regex_captures("```diff[ \\t]+path=\"([^\"]+)\"\\n([\\s\\S]*?)```", rest)
  }
  let files = files + "]"
  return files
}

// ── D.4: _patch_lines-эквивалент: один diff → содержимое файла ──────────
// diff_json: {"path", "removed": "строка1\nстрока2", "added": "..."} —
// порядок применения (§5.7 v3): точное совпадение → нечёткое (нормализация
// пробелов/отступов; ровно одно близкое место — применить с меткой) → отказ
// ТОЛЬКО при неоднозначности/отсутствии. Возврат-маркер: "EXACT:<файл>" /
// "FUZZY:<файл>" / "ОТКАЗ: …" — вызывающий (ForgeModelStageWrite) пишет
// исход в forge_edit_stats и снимает маркер.
//
// FO-043 (наряд #150): regex_replace в mlog нестабилен (проверено раном,
// dept/forge.mlog:_CollapseSpaces) — нормализация строится на replace/trim,
// не на регэкспах.

// ── нормализация строки: табы → пробел, CR срезается, прогоны пробелов
// схлопываются, края обрезаются. Игнорирует расхождения в пробелах/отступах.
pattern _NormLine(line: String) -> String {
  let mut out = replace(line, "\t", " ")
  let out = replace(out, "\r", "")
  let mut guard = 0.0
  while contains(out, "  ") and guard < 100.0 {
    let out = replace(out, "  ", " ")
    let guard = guard + 1.0
  }
  return trim(out)
}

// склейка нормализованного окна [from_i, from_i+n) списка строк
pattern _NormWindow(lines: List, from_i: Float, n: Float) -> String {
  let mut out = ""
  let mut k = 0.0
  while k < n {
    let out = out + _NormLine(to_string(get(lines, from_i + k)))
    let k = k + 1.0
    if k < n then { let out = out + "\n" }
  }
  return out
}

// исход записи статистики по маркеру (условные значения — только через паттерны)
pattern _OutcomeFor(marker: String) -> String {
  if marker == "FUZZY" then { return "fuzzy" }
  return "first_try"
}

// маркер применения: "FUZZY:" или "EXACT:" (ОТКАЗ отсечён вызывающим)
pattern _MarkerFor(applied: String) -> String {
  if starts_with(applied, "FUZZY:") then { return "FUZZY" }
  return "EXACT"
}

// снять маркер ("EXACT:" и "FUZZY:" — ровно 6 символов)
pattern _StripMarker(applied: String) -> String {
  return substring(applied, 6.0, length(applied))
}

pattern ModelApplyDiff(current_content: String, diff_json: String) -> String {
  let d = parse_json(diff_json)
  if to_string(d) == "()" then { return "ОТКАЗ: diff не разбирается" }
  let path = redact(to_string(json_get(d, "path", "")), "all")
  // removed/added — СТРОКИ, склеенные \n (json_get отдаёт Value, не List)
  let rem_str = redact(to_string(json_get(d, "removed", "")), "all")
  let add_str = redact(to_string(json_get(d, "added", "")), "all")
  if rem_str == "" and add_str == "" then { return "ОТКАЗ: removed/added пусты" }
  let removed = split(rem_str, "\n")
  let added = split(add_str, "\n")
  let lines = split(current_content, "\n")
  let n_removed = length(removed)
  let n_lines = length(lines)

  // ── 1. точное совпадение подряд (§5.7: несколько мест — тоже неоднозначность)
  let mut found_at = -1.0
  let mut exact_count = 0.0
  let mut i = 0.0
  each line in lines {
    if i + n_removed <= n_lines then {
      let window = slice(lines, i, i + n_removed)
      if join(window, "\n") == join(removed, "\n") then {
        let exact_count = exact_count + 1.0
        if found_at < 0.0 then { let found_at = i }
      }
    }
    let i = i + 1.0
  }
  if exact_count == 1.0 then {
    let applied = _AssemblePatch(lines, found_at, n_removed, added, current_content)
    return "EXACT:" + applied
  }
  if exact_count > 1.0 then {
    return "ОТКАЗ: контекст diff совпал в " + to_string(exact_count) + " местах файла " + path + " — место неоднозначно. Инструкция: включите в diff БОЛЬШЕ строк уникального контекста (соседние строки до/после) или перечитайте файл через <read file=\"" + path + "\"/> и повторите правку с обновлённым контекстом."
  }

  // ── 2. нечёткое сопоставление (§5.7): игнор пробелов/отступов ────────
  // Предфильтр точный: кандидаты начинаются только там, где ПЕРВАЯ строка
  // окна совпала нормализованно (полная последовательность должна совпасть
  // целиком, включая первую строку) — нормализуем окно лишь у кандидатов.
  let rem_norm = _NormWindow(removed, 0.0, n_removed)
  let first_norm = _NormLine(to_string(get(removed, 0)))
  let mut count = 0.0
  let mut fuzzy_at = -1.0
  let mut j = 0.0
  while j + n_removed <= n_lines {
    if _NormLine(to_string(get(lines, j))) == first_norm then {
      if _NormWindow(lines, j, n_removed) == rem_norm then {
        let count = count + 1.0
        if fuzzy_at < 0.0 then { let fuzzy_at = j }
      }
    }
    let j = j + 1.0
  }
  if count == 1.0 {
    // ровно одно близкое место с высокой уверенностью → применить с меткой
    let applied = _AssemblePatch(lines, fuzzy_at, n_removed, added, current_content)
    return "FUZZY:" + applied
  }
  if count > 1.0 {
    return "ОТКАЗ: контекст diff совпал в " + to_string(count) + " местах файла " + path + " (с точностью до пробелов/отступов) — место неоднозначно. Инструкция: включите в diff БОЛЬШЕ строк уникального контекста (соседние строки до/после) или перечитайте файл через <read file=\"" + path + "\"/> и повторите правку с обновлённым контекстом."
  }
  return "ОТКАЗ: контекст diff не найден в файле " + path + " ни точно, ни с точностью до пробелов/отступов (первая строка искомого: «" + substring(to_string(get(removed, 0)), 0.0, 80.0) + "»). Файл устарел или контекст выдуман. Инструкция: перечитайте файл через <read file=\"" + path + "\"/>, найдите актуальное место и повторите diff по нему; если правка больше не нужна — объясните текстом."
}

// сборка результата: head + added + tail (списки через join — не конкатенируются)
pattern _AssemblePatch(lines: List, found_at: Float, n_removed: Float, added: List, current_content: String) -> String {
  let head = join(slice(lines, 0.0, found_at), "\n")
  let tail = join(slice(lines, found_at + n_removed, length(lines)), "\n")
  let middle = join(added, "\n")
  let mut out = head
  if head != "" then { let out = out + "\n" }
  let out = out + middle
  if tail != "" then { let out = out + "\n" + tail }
  if ends_with(current_content, "\n") then { let out = out + "\n" }
  return out
}

// ── D.5: исполнение ответа модели: reads → diffs+files → ForgeWriteFiles ─
// Приоритет: <read>-запросы (если есть и нет правок) → "READS:{...}".
// Иначе: diff-блоки применяются к текущему содержимому (через ForgeReadFile),
// соединяются с <file>/fenced-блоками и уходят ОДНИМ вызовом ForgeWriteFiles —
// рубеж ForgeCheckPipeline применяется автоматически.
pattern ForgeModelStageWrite(repo_name: String, refv: String, response: String, message: String, author_dept: String) -> String {
  // 1. Запросы на чтение — читающий цикл (обязателен для правок)
  let reads = ModelParseReads(response)
  if starts_with(reads, "ОТКАЗ") then { return reads }
  let reads_list = parse_json(reads)
  let n_reads = length(reads_list)

  // 2. Diff-запросы: читаем каждый файл, применяем патч по строкам.
  // FO-043: исход применения (first_try / fuzzy / reject) — в forge_edit_stats
  let diffs = ModelParseDiffs(response)
  if starts_with(diffs, "ОТКАЗ") then { return diffs }
  let diffs_list = parse_json(diffs)
  let mut combined = "["
  let mut first = true
  each d in diffs_list {
    let path = redact(to_string(json_get(d, "path", "")), "all")
    if path == "" then { return "ОТКАЗ: diff без path" }
    let current = ForgeReadFile(repo_name, refv, path)
    if starts_with(current, "ОТКАЗ") then { return "ОТКАЗ: diff для отсутствующего/нечитаемого файла " + path }
    let applied = ModelApplyDiff(current, json_encode(d))
    if starts_with(applied, "ОТКАЗ") then {
      let _ = ForgeEditStatsRecord(repo_name, path, "reject", "")
      return applied
    }
    // маркер исхода → статистика + чистое содержимое (условные значения в
    // each — только через паттерны: ловушка mlog)
    let marker = _MarkerFor(applied)
    let content = _StripMarker(applied)
    let _ = ForgeEditStatsRecord(repo_name, path, _OutcomeFor(marker), marker)
    let combined = _Comma(combined, first) + "{\"path\":\"" + escape_json(path) + "\",\"content\":\"" + escape_json(content) + "\"}"
    let first = false
  }

  // 3. Прямые файлы: <file> + fenced-блоки
  let direct = ModelParseFiles(response)
  if starts_with(direct, "ОТКАЗ") then { return direct }
  let fenced = ModelParseFenced(response)
  if starts_with(fenced, "ОТКАЗ") then { return fenced }
  each lst in [direct, fenced] {
    let items = parse_json(to_string(lst))
    if to_string(items) != "()" then {
      each f in items {
        let combined = redact(_Comma(combined, first) + "{\"path\":\"" + escape_json(to_string(json_get(f, "path", ""))) + "\",\"content\":\"" + escape_json(to_string(json_get(f, "content", ""))) + "\"}", "all")
        let first = false
      }
    }
  }
  let combined = combined + "]"

  // 4. Ничего содержательного? <mkdir> валидируем, но сами по себе записи не создают
  let mkdirs = ModelParseMkdirs(response)
  if starts_with(mkdirs, "ОТКАЗ") then { return mkdirs }

  let n_items = length(parse_json(combined))
  if n_items == 0.0 {
    if n_reads > 0.0 then {
      // FO-043: ОТКАЗ чтения больше не глотается под маркером READS —
      // уходит вызывающему как есть (громкая неудача)
      let served = ModelServeReads(repo_name, refv, reads)
      if starts_with(served, "ОТКАЗ") then { return served }
      return "READS:" + served
    }
    return "ОТКАЗ: в ответе модели нет файлов, diff-блоков или <read>-запросов"
  }
  if n_reads > 0.0 then {
    // Файлы и <read> в одном ответе: сначала отдаём чтение (модель могла
    // запросить контекст для следующей правки), правки не теряются —
    // возвращаем оба маркера: READS приоритетен, caller сохранит ответ.
    let served2 = ModelServeReads(repo_name, refv, reads)
    if starts_with(served2, "ОТКАЗ") then { return served2 }
    return "READS:" + served2 + "\nFILES_PENDING:" + combined
  }
  return ForgeWriteFiles(repo_name, combined, message, author_dept)
}
