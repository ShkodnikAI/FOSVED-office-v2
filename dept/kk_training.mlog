test "n684: строка сводки — формат 24ч, разбивка, ожидают исхода, недобор с причиной" {
  let _ = KKEnsureSchema()
  let _ = KKTestCleanup()
  let _ = db_execute("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('kk_enabled', 'on')", [])
  // сценарий 07.11: ОСП 3, финансы 3, юристы 3, ЛЗ 0 — задано 9 из плана 12
  let q1 = KKInsertQuestion("osp", "n684line вопрос ОСП один", "binary", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let q2 = KKInsertQuestion("osp", "n684line вопрос ОСП два", "binary", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let q3 = KKInsertQuestion("osp", "n684line вопрос ОСП три", "number", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let q4 = KKInsertQuestion("finance", "n684line вопрос фин один", "number", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let q5 = KKInsertQuestion("finance", "n684line вопрос фин два", "number", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let q6 = KKInsertQuestion("finance", "n684line вопрос фин три", "binary", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let q7 = KKInsertQuestion("legal", "n684line вопрос юр один", "date", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let q8 = KKInsertQuestion("legal", "n684line вопрос юр два", "binary", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let q9 = KKInsertQuestion("legal", "n684line вопрос юр три", "binary", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  // ответы: 8 валидных карточек, 1 провал формы
  let _ = KKAnswerRecord(q1, "osp", 0.5, "{}", "{}", "")
  let _ = KKAnswerRecord(q2, "osp", 0.5, "{}", "{}", "")
  let _ = KKAnswerRecord(q3, "osp", 100.0, "{}", "{}", "")
  let _ = KKAnswerRecord(q4, "finance", 42.0, "{}", "{}", "")
  let _ = KKAnswerRecord(q5, "finance", 17.0, "{}", "{}", "")
  let _ = KKAnswerRecord(q6, "finance", 0.7, "{}", "{}", "")
  let _ = KKAnswerRecord(q7, "legal", 3.0, "{}", "{}", "")
  let _ = KKAnswerRecord(q8, "legal", 0.9, "{}", "{}", "")
  let _ = KKAnswerRecord(q9, "legal", 0.0, "{}", "{}", "провал формы — нет claim")
  // причина недобора ЛЗ: валидатор отклонил 3 раза — нет source_url
  let _ = kv_set("kk_rej_flat:lz:" + KKDayUtc(), "нет source_url,нет source_url,нет source_url")
  let line = KKLine24h()
  assert_contains(line, "Кавальня (24ч): задано 9 — ОСП 3, финансы 3, юристы 3, ЛЗ 0")
  assert_contains(line, "ответов с валидной карточкой 8, провал формы 1")
  assert_contains(line, "ожидают исхода 9 (ближайшие — ")
  assert_contains(line, "разрешено 0, спорных 0")
  // недобор с причиной из записи слота (наряд #684 A.2.3); мутация «убрать
  // причину пропуска» красит этот тест
  assert_contains(line, "ЛЗ 0 из 3 — валидатор отклонил 3 раза: нет source_url (3)")
  // окно честное: слово «вчера» в строке не появляется
  assert_eq(KKCountIn(line, "вчера"), 0.0)
  let _ = KKTestCleanup()
  let _ = db_execute("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('kk_enabled', 'off')", [])
}

test "n684: KKSelectValid — итог по отделу в audit_log и накопителе" {
  let _ = KKEnsureSchema()
  let _ = KKTestCleanup()
  let _ = kv_set("kk_ask_dept", "n671dept")
  // план 3 — на завтра 2, на неделю 1: 1 валидный, 3 отклонения — нет source_url,
  // дубль, нет правила (объект без rule)
  let _ = KKInsertQuestion("n671dept", "n684sel существующий вопрос для дедупа", "binary", 1.0, time() + 86400.0, "{\"desc\":\"правило\"}", "https://example.org/a")
  let raw = "[{\"text\":\"n684sel валидный вопрос про курс\",\"kind\":\"binary\",\"horizon_days\":1,\"rule\":{\"desc\":\"правило\"},\"source_url\":\"https://example.org/b\"},{\"text\":\"n684sel без источника\",\"kind\":\"binary\",\"horizon_days\":1,\"rule\":{\"desc\":\"правило\"},\"source_url\":\"\"},{\"text\":\"n684sel существующий вопрос для дедупа\",\"kind\":\"binary\",\"horizon_days\":1,\"rule\":{\"desc\":\"правило\"},\"source_url\":\"https://example.org/a\"},{\"text\":\"n684sel без правила\",\"kind\":\"binary\",\"horizon_days\":1,\"source_url\":\"https://example.org/c\"}]"
  let sel = KKSelectValid(raw, 2.0, 1.0, 0.0)
  assert_contains(sel, "\"missing\":2")
  let flat = kv_get("kk_rej_flat:n671dept:" + KKDayUtc())
  assert_eq(KKCountIn(flat, "нет source_url"), 1.0)
  assert_eq(KKCountIn(flat, "дубль"), 1.0)
  assert_eq(KKCountIn(flat, "нет правила"), 1.0)
  let arows = query("SELECT details FROM audit_log WHERE action = 'kk_validate' AND dept = 'n671dept' ORDER BY id DESC LIMIT 1", [])
  let details = to_string(json_get(get(arows, 0.0), "details", ""))
  assert_contains(details, "план 3")
  assert_contains(details, "принято 1")
  assert_contains(details, "отклонено 3")
  assert_contains(details, "нет source_url (1)")
  assert_contains(details, "дубль (1)")
  assert_contains(details, "нет правила (1)")
  assert_contains(details, "ошибка ИИ: нет")
  // сбой ИИ: нечитаемый ответ — kk_ai_fail растёт, в audit честное «да»
  let sel2 = KKSelectValid("совсем не JSON", 2.0, 1.0, 0.0)
  let ai_n = kv_get("kk_ai_fail:n671dept:" + KKDayUtc())
  assert_eq(to_float(ai_n), 1.0)
  let arows2 = query("SELECT details FROM audit_log WHERE action = 'kk_validate' AND dept = 'n671dept' ORDER BY id DESC LIMIT 1", [])
  assert_contains(to_string(json_get(get(arows2, 0.0), "details", "")), "ошибка ИИ: да")
  let _ = KKTestCleanup()
}

test "n684: KKResolveSlot — итог разрешено, спорных, отложено в audit_log" {
  let _ = KKEnsureSchema()
  let _ = KKTestCleanup()
  let _ = db_execute("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('kk_enabled', 'on')", [])
  // нет вопросов к разрешению — нули без сети
  let rep = KKResolveSlot()
  assert_contains(rep, "разрешено=0")
  assert_contains(rep, "спорных=0")
  assert_contains(rep, "отложено=0")
  let arows = query("SELECT details FROM audit_log WHERE action = 'kk_resolve' ORDER BY id DESC LIMIT 1", [])
  let details = to_string(json_get(get(arows, 0.0), "details", ""))
  assert_contains(details, "разрешено=0")
  assert_contains(details, "спорных=0")
  assert_contains(details, "отложено=0")
  let _ = KKTestCleanup()
  let _ = db_execute("INSERT OR REPLACE INTO system_settings (key, value) VALUES ('kk_enabled', 'off')", [])
}

