test "n671: срез кодовых блоков и ISO-дата" {
  assert_eq(KKStripFences("```json\n{\"outcome\": \"yes\"}\n```"), "{\"outcome\": \"yes\"}")
  assert_eq(KKStripFences("{\"outcome\": \"no\"}"), "{\"outcome\": \"no\"}")
  assert_eq(KKIsoDateOk("2026-11-11"), "yes")
  assert_eq(KKIsoDateOk("2026-1-11"), "no")
  assert_eq(KKIsoDateOk("завтра"), "no")
}

test "n671: XmlEsc — атрибуты SVG безопасны" {
