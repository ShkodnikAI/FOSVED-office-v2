}

// ═══════════════════════════════════════════════════════════════════════
// /admin tour — guided architecture tour (NATIVE call_llm)
// ═══════════════════════════════════════════════════════════════════════
pattern AdminTour() -> String {
  let _ = AuditLog("admin_tour", "admin", "tour started")

  let admin_profile = read_file("library/admin.md")
  let disclaimer = AdminDisclaimer()

  // Get scan data for context
  let scan_result = http_get("http://127.0.0.1:4000/admin-ua/scan")
  let scan_data = json_get(parse_json(scan_result), "summary", "")

  let tour_prompt = disclaimer + "\n\nGenerate a guided architecture tour of Fosved Office based on scan data.\nStructure:\n1. Overview (total files, lines, departments)\n2. Core: app.mlog and routing\n3. Departments: each dept with patterns count\n4. Infrastructure: proxy, scheduler, utils\n5. Key metrics: graph nodes/edges, health score\n6. Notable: largest files, most connected, potential issues\n\nBe technical, concise, informative."

  let model = AdminSelectModel(2)
  let messages = json_encode([{role: "system", content: admin_profile + "\n\n" + tour_prompt}, {role: "user", content: "Scan data:\n" + scan_data}])
  let llm_result = call_llm(model, messages, 0.7, 6000)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }

  let _ = AuditLog("admin_tour", "admin", "tour done")
  return to_string(llm_result)
}

// ═══════════════════════════════════════════════════════════════════════
// /admin docs — auto-documentation
// ═══════════════════════════════════════════════════════════════════════
pattern AdminDocs() -> String {
  let _ = AuditLog("admin_docs", "admin", "UA docs started")
  let result = http_get("http://127.0.0.1:4000/admin-ua/docs")
  let structure = json_get(parse_json(result), "structure", "Docs failed")
  let _ = AuditLog("admin_docs", "admin", "UA docs done")
  return substring(structure, 0.0, 3000.0)
}

// ═══════════════════════════════════════════════════════════════════════
// /admin graph — Python UA Grapher (Scanner→Analyzer→Graph→SQLite)
// ═══════════════════════════════════════════════════════════════════════
pattern AdminGraph() -> String {
  let _ = AuditLog("admin_graph", "admin", "UA graph build started")
  let result = http_get("http://127.0.0.1:4000/admin-ua/graph")
  let summary = json_get(parse_json(result), "summary", "Graph build failed")
  let nodes = json_get(parse_json(result), "nodes", "0")
  let edges = json_get(parse_json(result), "edges", "0")
  let _ = AuditLog("admin_graph", "admin", "graph done: " + to_string(nodes) + " nodes, " + to_string(edges) + " edges")
  return summary
}

// ═══════════════════════════════════════════════════════════════════════
// /admin impact <file> — Python UA Differ
// ═══════════════════════════════════════════════════════════════════════
pattern AdminImpact(file_path: String) -> String {
  // HARD GATE: check immutable
  if AdminGateImmutable(file_path) == "BLOCK" then {
    return "BLOCKED: " + file_path + " is in immutable zone. No impact analysis needed — changes forbidden."
  }

  let _ = AuditLog("admin_impact", "admin", "UA impact: " + file_path)
  let encoded_path = replace(file_path, " ", "%20")
  let result = http_get("http://127.0.0.1:4000/admin-ua/impact?file=" + encoded_path)
  let summary = json_get(parse_json(result), "summary", "Impact analysis failed")
  let risk = json_get(parse_json(result), "risk", "unknown")
  let _ = AuditLog("admin_impact", "admin", "impact done: " + file_path + " risk=" + risk)
  return summary
}

// ═══════════════════════════════════════════════════════════════════════
// /admin proposals
// ═══════════════════════════════════════════════════════════════════════
pattern AdminProposalsView() -> String {
  let rows = query("SELECT content, status, created_at FROM admin_proposals WHERE status = 'pending' ORDER BY id DESC LIMIT 5", [])
  let result = to_string(rows)
  if len(result) > 10 then {
    let _ = AuditLog("admin_proposals_view", "admin", "proposals viewed")
    return "Pending proposals:\n\n" + result
  }
  return "No active proposals."
}

// ═══════════════════════════════════════════════════════════════════════
// /admin narads
// ═══════════════════════════════════════════════════════════════════════
pattern AdminNarads() -> String {
  let rows = query("SELECT id, title, status, risk_level, created_at FROM narads ORDER BY id DESC LIMIT 10", [])
  let output = "Narads:\n"
  each row in rows {
    let nid = json_get(to_string(row), "id", "")
    let title = json_get(to_string(row), "title", "")
    let status = json_get(to_string(row), "status", "")
    let risk = json_get(to_string(row), "risk_level", "")
    let output = output + nid + " [" + status + "|" + risk + "] " + substring(title, 0, 60) + "\n"
  }
  let _ = AuditLog("admin_narads_view", "admin", "narads viewed")
  return output
}

// ═══════════════════════════════════════════════════════════════════════
// /admin rollback <id> — with lifecycle state machine
// ═══════════════════════════════════════════════════════════════════════
pattern AdminRollback(narad_id: String) -> String {
  // Get current status
  let current = query("SELECT status FROM narads WHERE id = ?1", [narad_id])
  let current_status = json_get(to_string(current), "[0].status", "unknown")

  // Lifecycle gate
  let new_status = AdminGateNaradTransition(current_status, "rollback")
  if new_status == "DENY" then {
    return "BLOCKED: Cannot rollback narad " + narad_id + " from status '" + current_status + "'"
  }

  db_execute("UPDATE narads SET status = ?1, updated_at = datetime('now') WHERE id = ?2", [new_status, narad_id])
  let _ = AuditLog("admin_rollback", "admin", "rolled back: " + narad_id + " " + current_status + " → " + new_status)
  return "Narad " + narad_id + " rolled back (" + current_status + " → " + new_status + ")."
}

// ═══════════════════════════════════════════════════════════════════════
// /admin report
// ═══════════════════════════════════════════════════════════════════════
pattern AdminReport() -> String {
  let summary = kv_get("admin_night_summary")
  if summary == "" then {
    return "No night report available yet."
  }
  let disclaimer = AdminDisclaimer()
  return "Last night report:\n\n" + substring(summary, 0, 2000) + "\n\n" + disclaimer
}

// ═══════════════════════════════════════════════════════════════════════
// /admin health — real health score from UA
// ═══════════════════════════════════════════════════════════════════════
pattern AdminHealth() -> String {
  let review_result = http_get("http://127.0.0.1:4000/admin-ua/review")
  let health = json_get(parse_json(review_result), "health_score", "?")
  let review_summary = json_get(parse_json(review_result), "summary", "")

  let disclaimer = AdminDisclaimer()
  let health_msg = "Code health: " + to_string(health) + "/10\n"
  let health_msg = health_msg + review_summary + "\n\n" + disclaimer
  let _ = AuditLog("admin_health", "admin", "health=" + to_string(health))
  return health_msg
}

// ═══════════════════════════════════════════════════════════════════════
// /admin approve <narad_id> — lifecycle transition
// ═══════════════════════════════════════════════════════════════════════
pattern AdminApproveNarad(narad_id: String) -> String {
  let current = query("SELECT status FROM narads WHERE id = ?1", [narad_id])
  let current_status = json_get(to_string(current), "[0].status", "unknown")

  let new_status = AdminGateNaradTransition(current_status, "approve")
  if new_status == "DENY" then {
    return "BLOCKED: Cannot approve narad " + narad_id + " from status '" + current_status + "'"
  }

  db_execute("UPDATE narads SET status = ?1, updated_at = datetime('now') WHERE id = ?2", [new_status, narad_id])
  let _ = AuditLog("narad_approved", "admin", narad_id + " " + current_status + " → " + new_status)
  return "Narad " + narad_id + " approved (" + current_status + " → " + new_status + ")."
}

// ═══════════════════════════════════════════════════════════════════════
// /admin reject <narad_id> — lifecycle transition
// ═══════════════════════════════════════════════════════════════════════
pattern AdminRejectNarad(narad_id: String) -> String {
  let current = query("SELECT status FROM narads WHERE id = ?1", [narad_id])
  let current_status = json_get(to_string(current), "[0].status", "unknown")

  let new_status = AdminGateNaradTransition(current_status, "reject")
  if new_status == "DENY" then {
    return "BLOCKED: Cannot reject narad " + narad_id + " from status '" + current_status + "'"
  }

  db_execute("UPDATE narads SET status = ?1, updated_at = datetime('now') WHERE id = ?2", [new_status, narad_id])
  let _ = AuditLog("narad_rejected", "admin", narad_id + " " + current_status + " → " + new_status)
  return "Narad " + narad_id + " rejected (" + current_status + " → " + new_status + ")."
}

// ═══════════════════════════════════════════════════════════════════════
// HandleAdmin — generic admin query via NATIVE call_llm
// ═══════════════════════════════════════════════════════════════════════
pattern HandleAdmin(query: String, chat_id: String) -> String {
  let dept = "admin"
  let context = BuildContext(dept, query, chat_id)
  let disclaimer = AdminDisclaimer()
  let model = AdminSelectModel(2)
  let messages = json_encode([{role: "system", content: disclaimer + "\n\n" + context}, {role: "user", content: query}])
  let llm_result = call_llm(model, messages, 0.7, 4000)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)

  kv_set("last_model_" + dept, model)
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  let _ = AuditLog("admin_query", dept, "query: " + substring(query, 0, 100))

  // FINAL SAFETY CHECK: never return without disclaimer
  return reply + "\n\n" + disclaimer
}

// ═══════════════════════════════════════════════════════════════════════
// Cron endpoint: /cron/night
// ═══════════════════════════════════════════════════════════════════════
route "/cron/night" method=GET {
  let secret = query_param("secret")
  let expected = env("CRON_SECRET")
  if secret != expected then { return respond("403 Forbidden") }
  let _ = AdminNightCycle()
  return respond("200 ok")
}
