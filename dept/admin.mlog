// ═══════════════════════════════════════════════════════════════════════
// /admin graph — Python UA Grapher (Scanner→Analyzer→Graph→SQLite)
// ═══════════════════════════════════════════════════════════════════════
pattern AdminGraph() -> String {
  let _ = AuditLog("admin_graph", "admin", "UA graph build started")
  let result = redact(http_get("http://127.0.0.1:4000/admin-ua/graph"), "all")
  let summary = redact(to_string(json_get(parse_json(result), "summary", "Graph build failed")), "all")
  let nodes = redact(to_string(json_get(parse_json(result), "nodes", "0")), "all")
  let edges = redact(to_string(json_get(parse_json(result), "edges", "0")), "all")
  let _ = AuditLog("admin_graph", "admin", "graph done: " + to_string(nodes) + " nodes, " + to_string(edges) + " edges")
  return summary
}

// ═══════════════════════════════════════════════════════════════════════
// /admin impact <file> — Python UA Differ
// ═══════════════════════════════════════════════════════════════════════
pattern AdminImpact(file_path: String) -> String {
  // HARD GATE: check immutable
  if AdminGateImmutable(file_path) == "BLOCK" then {
    return "BLOCKED: " + file_path + " is in immutable zone. No impact analysis needed — changes forbidden."
  }

  let _ = AuditLog("admin_impact", "admin", "UA impact: " + file_path)
  let encoded_path = replace(file_path, " ", "%20")
  let result = redact(http_get("http://127.0.0.1:4000/admin-ua/impact?file=" + encoded_path), "all")
  let summary = redact(to_string(json_get(parse_json(result), "summary", "Impact analysis failed")), "all")
  let risk = redact(to_string(json_get(parse_json(result), "risk", "unknown")), "all")
  let _ = AuditLog("admin_impact", "admin", "impact done: " + file_path + " risk=" + risk)
  return summary
}

// ═══════════════════════════════════════════════════════════════════════
// /admin proposals
// ═══════════════════════════════════════════════════════════════════════
pattern AdminProposalsView() -> String {
  let rows = query("SELECT content, status, created_at FROM admin_proposals WHERE status = 'pending' ORDER BY id DESC LIMIT 5", [])
  let result = to_string(rows)
  if length(result) > 10 then {
    let _ = AuditLog("admin_proposals_view", "admin", "proposals viewed")
    return "Pending proposals:\n\n" + result
  }
  return "No active proposals."
}

// ═══════════════════════════════════════════════════════════════════════
// /admin narads
// ═══════════════════════════════════════════════════════════════════════
pattern AdminNarads() -> String {
  let rows = query("SELECT id, title, status, risk_level, created_at FROM narads ORDER BY id DESC LIMIT 10", [])
  let mut output = "Narads:\n"
  each row in rows {
    let nid = redact(to_string(TryVal(try json_get(row, "id", ""))), "all")
    let title = redact(to_string(TryVal(try json_get(row, "title", ""))), "all")
    let status = redact(to_string(TryVal(try json_get(row, "status", ""))), "all")
    let risk = redact(to_string(TryVal(try json_get(row, "risk_level", ""))), "all")
    let output = output + nid + " [" + status + "|" + risk + "] " + substring(title, 0, 60) + "\n"
  }
  let _ = AuditLog("admin_narads_view", "admin", "narads viewed")
  return output
}

// ═══════════════════════════════════════════════════════════════════════
// /admin rollback <id> — with lifecycle state machine
// ═══════════════════════════════════════════════════════════════════════
pattern AdminRollback(narad_id: String) -> String {
  // Get current status
  let current = query("SELECT status FROM narads WHERE id = ?1", [narad_id])
  let current_status = redact(to_string(TryVal(try json_get(current[0], "status", "unknown"))), "all")

  // Lifecycle gate
  let new_status = AdminGateNaradTransition(current_status, "rollback")
  if new_status == "DENY" then {
    return "BLOCKED: Cannot rollback narad " + narad_id + " from status '" + current_status + "'"
  }

  db_execute("UPDATE narads SET status = ?1, updated_at = datetime('now') WHERE id = ?2", [new_status, narad_id])
  let _ = AuditLog("admin_rollback", "admin", "rolled back: " + narad_id + " " + current_status + " → " + new_status)
  return "Narad " + narad_id + " rolled back (" + current_status + " → " + new_status + ")."
}

// ═══════════════════════════════════════════════════════════════════════
// /admin report
// ═══════════════════════════════════════════════════════════════════════
pattern AdminReport() -> String {
  let summary = kv_get("admin_night_summary")
  if summary == "" then {
    return "No night report available yet."
  }
  let disclaimer = AdminDisclaimer()
  return "Last night report:\n\n" + substring(summary, 0, 2000) + "\n\n" + disclaimer
}

// ═══════════════════════════════════════════════════════════════════════
// /admin health — native health check (no external deps)
// ═══════════════════════════════════════════════════════════════════════
pattern AdminHealth() -> String {
  let mut score = 10.0
  let mut issues = ""

  // 1. DB tables exist?
  let tables_check = TryVal(try query("SELECT name FROM sqlite_master WHERE type='table'", []))
  if to_string(tables_check) == "()" then {
    let score = score - 3.0
    let issues = issues + "- DB query failed\n"
  }

  // 2. Key tables present
  let mut tables_found = 0.0
  let key_tables = ["dialog_history", "audit_log", "knowledge_graph", "admin_findings", "narads"]
  each kt in key_tables {
    let tr = TryVal(try query("SELECT name FROM sqlite_master WHERE type='table' AND name=?", [kt]))
    if to_string(tr) != "()" and length(tr) > 0.0 then { let tables_found = tables_found + 1.0 }
  }
  if tables_found < 5.0 then {
    let score = score - 2.0
    let issues = issues + "- Missing tables: " + to_string(to_int(tables_found)) + "/5\n"
  }

  // 3. Recent audit activity
  let audit_check = TryVal(try query("SELECT COUNT(*) as c FROM audit_log WHERE timestamp > datetime('now', '-1 hour')", []))
  if to_string(audit_check) == "()" then {
    let score = score - 1.0
    let issues = issues + "- audit_log unreachable\n"
  }

  // 4. LLM proxy reachable?
  let proxy_check = redact(to_string(TryVal(try http_get("http://127.0.0.1:4000/health"))), "all")
  if to_string(proxy_check) == "()" then {
    let score = score - 2.0
    let issues = issues + "- LLM proxy (port 4000) unreachable\n"
  }

  // 5. Open findings
  let findings_check = TryVal(try query("SELECT COUNT(*) as c FROM admin_findings WHERE status = 'open'", []))
  let mut open_findings = 0.0
  if to_string(findings_check) != "()" and length(findings_check) > 0.0 then {
    let open_findings = to_float(json_get(findings_check[0], "c", "0"))
  }
  if open_findings > 0.0 then {
    let score = score - 1.0
    let issues = issues + "- Open findings: " + to_string(to_int(open_findings)) + "\n"
  }

  if score < 0.0 then { let score = 0.0 }

  let mut proxy_status = "UP"
  if to_string(proxy_check) == "()" then { let proxy_status = "DOWN" }

  let mut health_msg = "Admin health: " + to_string(to_int(score)) + "/10"
  if issues != "" then {
    let health_msg = health_msg + "\n\nIssues:\n" + issues
  } else {
    let health_msg = health_msg + " — all systems nominal"
  }
  let health_msg = health_msg + "\nTables: " + to_string(to_int(tables_found)) + "/5"
  let health_msg = health_msg + "\nOpen findings: " + to_string(to_int(open_findings))
  let health_msg = health_msg + "\nLLM proxy: " + proxy_status

  let _ = AuditLog("admin_health", "admin", "score=" + to_string(to_int(score)))
  return health_msg
}

// ═══════════════════════════════════════════════════════════════════════
// /admin approve <narad_id> — lifecycle transition
// ═══════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// /admin reject <narad_id> — lifecycle transition
// ═══════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════════════
// #405 A.1: чтение журналов офиса (error_log / audit_log / trace_log)
// ═══════════════════════════════════════════════════════════════════════
// Схемы (proxy/core.py InitDB): error_log(id, ts, source, dept, kind, detail),
// audit_log(id, timestamp, action, actor, dept, details, status),
// trace_log(id, timestamp, action, actor, dept, details, status).
// Только ЧТЕНИЕ: immutable-зона (AdminGateImmutable) не затрагивается.
// detail/details прогоняются через redact(..., "all") — в журналах могут
// быть фрагменты запросов/ключей. Честное «записей нет» на пустоте.
pattern AdminLogDigest(hours_text: String) -> String {
  let mut h = to_float(hours_text)
  if h <= 0.0 then { let h = 24.0 }
  if h > 168.0 then { let h = 168.0 }
  let hs = to_string(to_int(h))
  let mut out = "Журналы офиса за " + hs + " ч:"
  let mut found = 0.0

  // error_log: группировка по dept, kind
  let errs = query("SELECT dept, kind, COUNT(*) as c FROM error_log WHERE ts > datetime('now', '-' || ?1 || ' hours') GROUP BY dept, kind ORDER BY c DESC LIMIT 8", [hs])
  if to_string(errs) != "()" and length(errs) > 0.0 then {
    let out = out + "\nОшибки (error_log):"
    each row in errs {
      let out = out + "\n· " + to_string(json_get(row, "dept", "?")) + "/" + to_string(json_get(row, "kind", "?")) + " × " + to_string(json_get(row, "c", "0"))
      let found = found + 1.0
    }
    // последние 10 записей с detail (усечено, redact)
    let last = query("SELECT ts, source, dept, kind, detail FROM error_log WHERE ts > datetime('now', '-' || ?1 || ' hours') ORDER BY id DESC LIMIT 10", [hs])
    each row in last {
      let detail = redact(substring(to_string(json_get(row, "detail", "")), 0.0, 120.0), "all")
      let out = out + "\n  [" + substring(to_string(json_get(row, "ts", "")), 0.0, 16.0) + " " + to_string(json_get(row, "source", "?")) + "] " + detail
    }
  }

  // audit_log: отказы и сбои
  // #431 A.1: не-ошибочные статусы (очередь снабженца pending/dispatched/done,
  // отложенные queued/skipped, живые процессы) — НЕ ошибки, из выборки
  // исключены (досье #9: pending/dispatched ×7 каждый Админ счёл техдолгом).
  let audits = query("SELECT action, dept, status, COUNT(*) as c FROM audit_log WHERE timestamp > datetime('now', '-' || ?1 || ' hours') AND status IS NOT NULL AND status != 'ok' AND status NOT IN ('pending','dispatched','done','queued','skipped','in_work','running','started','collector_not_implemented') GROUP BY action, dept, status ORDER BY c DESC LIMIT 5", [hs])
  if to_string(audits) != "()" and length(audits) > 0.0 then {
    let out = out + "\nОтказы и сбои (audit_log):"
    each row in audits {
      let out = out + "\n· " + to_string(json_get(row, "action", "?")) + " (" + to_string(json_get(row, "dept", "?")) + ", status=" + to_string(json_get(row, "status", "?")) + ") × " + to_string(json_get(row, "c", "0"))
      let found = found + 1.0
    }
    // #431 A.2: причина отказа — details последних записей (усечено, redact)
    let audit_last = query("SELECT timestamp, action, dept, status, details FROM audit_log WHERE timestamp > datetime('now', '-' || ?1 || ' hours') AND status IS NOT NULL AND status != 'ok' AND status NOT IN ('pending','dispatched','done','queued','skipped','in_work','running','started','collector_not_implemented') ORDER BY id DESC LIMIT 10", [hs])
    each row in audit_last {
      let adetail = redact(substring(to_string(json_get(row, "details", "")), 0.0, 120.0), "all")
      if adetail != "" then {
        let out = out + "\n  [" + substring(to_string(json_get(row, "timestamp", "")), 0.0, 16.0) + " " + to_string(json_get(row, "action", "?")) + " " + to_string(json_get(row, "dept", "?")) + " " + to_string(json_get(row, "status", "?")) + "] " + adetail
      }
    }
  }

  // #431 A.3: задания, ждущие снабженца, — не ошибки, отдельная строка.
  // Очередь снабженца (action=shop_supply, pending/dispatched) и
  // исторический статус collector_not_implemented, если встречался.
  let waiting = query("SELECT COUNT(*) as c FROM audit_log WHERE timestamp > datetime('now', '-' || ?1 || ' hours') AND ((action = 'shop_supply' AND status IN ('pending','dispatched')) OR status = 'collector_not_implemented')", [hs])
  if to_string(waiting) != "()" and length(waiting) > 0.0 {
    let wn = to_float(json_get(waiting[0], "c", "0"))
    if wn > 0.0 then {
      let out = out + "\nЖдут снабженца: " + to_string(wn)
    }
  }

  // trace_log: чекпоинты со сбоем (не-ошибочные статусы исключены так же)
  let traces = query("SELECT action, dept, status, COUNT(*) as c FROM trace_log WHERE timestamp > datetime('now', '-' || ?1 || ' hours') AND status IS NOT NULL AND status != 'ok' AND status NOT IN ('pending','dispatched','done','queued','skipped','in_work','running','started','collector_not_implemented') GROUP BY action, dept, status ORDER BY c DESC LIMIT 5", [hs])
  if to_string(traces) != "()" and length(traces) > 0.0 then {
    let out = out + "\nТрейсы со сбоем (trace_log, status != ok):"
    each row in traces {
      let out = out + "\n· " + to_string(json_get(row, "action", "?")) + " (" + to_string(json_get(row, "dept", "?")) + ", status=" + to_string(json_get(row, "status", "?")) + ") × " + to_string(json_get(row, "c", "0"))
      let found = found + 1.0
    }
    // #431 A.2: детали сбоев трейсов — усечено, redact
    let trace_last = query("SELECT timestamp, action, dept, status, details FROM trace_log WHERE timestamp > datetime('now', '-' || ?1 || ' hours') AND status IS NOT NULL AND status != 'ok' AND status NOT IN ('pending','dispatched','done','queued','skipped','in_work','running','started','collector_not_implemented') ORDER BY id DESC LIMIT 10", [hs])
    each row in trace_last {
      let tdetail = redact(substring(to_string(json_get(row, "details", "")), 0.0, 120.0), "all")
      if tdetail != "" then {
        let out = out + "\n  [" + substring(to_string(json_get(row, "timestamp", "")), 0.0, 16.0) + " " + to_string(json_get(row, "action", "?")) + " " + to_string(json_get(row, "dept", "?")) + " " + to_string(json_get(row, "status", "?")) + "] " + tdetail
      }
    }
  }

  if found == 0.0 then { return "Журналы офиса за " + hs + " ч: записей нет (ошибок, сбоев и нестатусных действий не зафиксировано)." }
  return out
}

// A.3: подмешивание в свободный вопрос — реальные журналы в контекст
pattern AdminLogsIfRelevant(query: String) -> String {
  let t = lower(query)
  if contains(t, "ошибк") or contains(t, "сбой") or contains(t, "лог") or contains(t, "упал") or contains(t, "не работает") then {
    return "\n\n[Журналы офиса — РЕАЛЬНАЯ выборка за 24 ч. Отвечай ТОЛЬКО по этим данным; не называй пути, сервисы и компоненты, которых здесь нет. Если выборка пуста — прямо скажи, что записей нет.]\n" + AdminLogDigest("24")
  }
  return ""
}

// HandleAdmin — generic admin query via NATIVE call_llm
// ═══════════════════════════════════════════════════════════════════════
pattern HandleAdmin(query: String, chat_id: String) -> String {
  let dept = "admin"
  let context = BuildContext(dept, query, chat_id)
  // #405 A.3/A.4: журналы — при вопросах про ошибки/сбои; запрет выдумывать
  // пути и компоненты (инцидент 2026-09-27: Админ выдумал /var/log/fosved/
  // и «OmniRoute»). Данные — только из контекста; нет данных — сказать честно.
  let logs = AdminLogsIfRelevant(query)
  let disclaimer = AdminDisclaimer()
  let llm_result = redact(to_string(TryVal(try call_llm(disclaimer + "\n\nЗАПРЕТ ВЫДУМЫВАТЬ ИНФРАСТРУКТУРУ: не называй пути, сервисы и компоненты, которых нет в контексте. Если данных нет — прямо скажи «в журналах за период записей нет» или «журнал недоступен».\n\n" + context + logs, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)

  kv_set("last_model_" + dept, "native-call-llm")
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  let _ = AuditLog("admin_query", dept, "query: " + substring(query, 0, 100))

  // FINAL SAFETY CHECK: never return without disclaimer
  return reply + "\n\n" + disclaimer
}

