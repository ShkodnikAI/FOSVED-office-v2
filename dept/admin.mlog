// ═══════════════════════════════════════════════════════════════════════
// /admin tour — guided architecture tour (NATIVE call_llm)
// ═══════════════════════════════════════════════════════════════════════
pattern AdminTour() -> String {
  let _ = AuditLog("admin_tour", "admin", "tour started")

  let admin_profile = redact(read_file("library/admin.md"), "all")
  let disclaimer = AdminDisclaimer()

  // Get scan data for context
  let scan_result = redact(http_get("http://127.0.0.1:4000/admin-ua/scan"), "all")
  let scan_data = redact(to_string(json_get(parse_json(scan_result), "summary", "")), "all")

  let tour_prompt = disclaimer + "\n\nGenerate a guided architecture tour of Fosved Office based on scan data.\nStructure:\n1. Overview (total files, lines, departments)\n2. Core: app.mlog and routing\n3. Departments: each dept with patterns count\n4. Infrastructure: proxy, scheduler, utils\n5. Key metrics: graph nodes/edges, health score\n6. Notable: largest files, most connected, potential issues\n\nBe technical, concise, informative."

  let llm_result = redact(to_string(TryVal(try call_llm(admin_profile + "\n\n" + tour_prompt, "Scan data:\n" + scan_data))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }

  let _ = AuditLog("admin_tour", "admin", "tour done")
  return to_string(llm_result)
}

