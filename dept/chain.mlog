// ============================================================
// NARAD #10: Составные запросы — flow через несколько отделов
// Файл: dept/chain.mlog
// Импортируется в app.mlog через: import ./dept/chain
// ============================================================


// --- Имя отдела по slug ---

pattern DeptName(slug: String) -> String {
  if slug == "osp" { return "OSP (strategicheskij analiz)" }
  if slug == "lz" { return "LZ (laboratoriya znanij)" }
  if slug == "expert" { return "Ekspert" }
  if slug == "marketing" { return "Marketing" }
  if slug == "finance" { return "Finansy" }
  if slug == "legal" { return "Yurist" }
  if slug == "dev" { return "Dev" }
  if slug == "design" { return "Design" }
  if slug == "qa" { return "QA" }
  if slug == "visual" { return "Visual" }
  if slug == "engineering" { return "Engineering" }
  if slug == "kavalnya" { return "Kaval'nya" }
  if slug == "hr" { return "HR" }
  if slug == "operations" { return "Operations" }
  if slug == "product" { return "Product" }
  return slug
}


// --- Вызов одного отдела с полным контекстом (переиспользуем BuildContext из context.mlog) ---

pattern CallDepartment(dept: String, query_text: String, chat_id: String) -> String {
  let context = BuildContext(dept, query_text, chat_id)

  // Provider/model — проверяем override для конкретного отдела
  let provider = trim(read_file("config/priority_provider.txt"))
  let model = trim(read_file("config/priority_model.txt"))
  let override_path = "config/override_" + dept + ".txt"
  let override_content = read_file(override_path)
  if len(trim(override_content)) > 2.0 {
    let osp_parts = split(trim(override_content), " ")
    if len(osp_parts) > 1.0 {
      provider = get(osp_parts, 0.0)
      model = get(osp_parts, 1.0)
    }
  }

  let api_key = GetApiKey(provider)
  let reply = call_claude(api_key, model, context, query_text)

  RecordMessage(chat_id, "assistant", dept, reply)
  return reply
}


// --- Разбор цепочки: "dept1+dept2+dept3" -> три переменные ---

pattern ParseChain(chain: String) -> String {
  // Возвращает строку вида "dept1|dept2|dept3" (пустые элементы = "")
  let dept1 = ""
  let dept2 = ""
  let dept3 = ""

  let plus_pos = index_of(chain, "+")
  if plus_pos > 0.0 {
    dept1 = substring(chain, 0.0, plus_pos)
    let rest = substring(chain, plus_pos + 1.0, len(chain))
    let plus_pos2 = index_of(rest, "+")
    if plus_pos2 > 0.0 {
      dept2 = substring(rest, 0.0, plus_pos2)
      dept3 = substring(rest, plus_pos2 + 1.0, len(rest))
    } else {
      dept2 = rest
    }
  } else {
    dept1 = chain
  }

  return dept1 + "|" + dept2 + "|" + dept3
}


// --- Последовательное выполнение цепочки отделов ---

pattern ExecuteChain(chain: String, query_text: String, chat_id: String) -> String {
  let parsed = ParseChain(chain)
  let parts = split(parsed, "|")

  let dept1 = get(parts, 0.0)
  let dept2 = ""
  let dept3 = ""
  if len(parts) > 1.0 { dept2 = get(parts, 1.0) }
  if len(parts) > 2.0 { dept3 = get(parts, 2.0) }

  // Первый отдел — оригинальный запрос
  let result1 = CallDepartment(dept1, query_text, chat_id)
  let results = "=== " + DeptName(dept1) + " ===\n" + result1

  // Второй отдел — получает результат первого как контекст
  if len(trim(dept2)) > 0.0 {
    let enriched_query = query_text + "\n\nKontekst ot predydushchego otdela (" + DeptName(dept1) + "):\n" + result1
    let result2 = CallDepartment(dept2, enriched_query, chat_id)
    results = results + "\n\n=== " + DeptName(dept2) + " ===\n" + result2
  }

  // Третий отдел — получает все предыдущие результаты
  if len(trim(dept3)) > 0.0 {
    let enriched_query = query_text + "\n\nKontekst ot predydushchikh otdelov:\n" + results
    let result3 = CallDepartment(dept3, enriched_query, chat_id)
    results = results + "\n\n=== " + DeptName(dept3) + " ===\n" + result3
  }

  return results
}


// --- Автоопределение цепочки через LLM (только для составных запросов) ---

pattern DetectChain(text: String) -> String {
  let provider = trim(read_file("config/priority_provider.txt"))
  let model = trim(read_file("config/priority_model.txt"))
  let api_key = GetApiKey(provider)

  let prompt = "Proanaliziruj zapros pol'zovatelya. Opredeli kakie otdely nuzhny dlya otveta. Otdely: osp, lz, expert, marketing, finance, legal, dev, design, qa, visual, engineering, kavalnya, hr, operations, product. Esli nuzhen odin otdel - verni ego slug. Esli nuzhno neskol'ko - verni cherez plus v poryadke vypolneniya. Primery: 'osp', 'marketing+legal', 'lz+engineering'. Verni TOL'KO slugs, bez poyasnenij."

  let result = call_claude(api_key, model, prompt, text)
  let cleaned = trim(result)

  // Защита: если LLM вернул что-то лишнее, берём первую строку
  let newline_pos = index_of(cleaned, "\n")
  if newline_pos > 0.0 {
    cleaned = substring(cleaned, 0.0, newline_pos)
  }

  return trim(cleaned)
}


// --- Финальная сборка ответа Яной из результатов цепочки ---

pattern YanaSummarizeChain(chain_result: String, original_query: String, chat_id: String) -> String {
  let provider = trim(read_file("config/priority_provider.txt"))
  let model = trim(read_file("config/priority_model.txt"))
  let api_key = GetApiKey(provider)

  let yana_context = BuildContext("osp", original_query, chat_id)
  let system_prompt = yana_context + "\n\nTebe nuzhno sobrat' final'nyj otvet iz rezul'tatov neskol'kih otdelov. Bud' kratkoj, vydeli glavnoe, ukazhi esli otdely protivorechat drug drugu."

  let user_msg = "Zapros: " + original_query + "\n\nRezul'taty otdelov:\n" + chain_result

  let summary = call_claude(api_key, model, system_prompt, user_msg)
  return summary
}