// Fosved Office v2 — Chain Execution (MEGA-3)
// ExecuteChain: sequential multi-department queries (max 3)
// BuildChainReport, SendChainReport helpers

// FO-026: единая диспетчеризация департаментов для chain (sequential,
// parallel fan-out, debate — один и тот же вызов обработчика).
pattern ChainDispatchDept(dept: String, query: String, chat_id: String) -> String {
  let step_result = ""
  if dept == "yana" then { let step_result = HandleYana(query, chat_id) }
  if dept == "osp" then { let step_result = HandleOSP(query, chat_id) }
  if dept == "lz" then { let step_result = HandleLZ(query, chat_id) }
  if dept == "expert" then { let step_result = HandleExpert(query, chat_id) }
  if dept == "marketing" then { let step_result = HandleMarketing(query, chat_id) }
  if dept == "finance" then { let step_result = HandleFinance(query, chat_id) }
  if dept == "legal" then { let step_result = HandleLegal(query, chat_id) }
  if dept == "dev" then { let step_result = HandleDev(query, chat_id) }
  if dept == "design" then { let step_result = HandleDesign(query, chat_id) }
  if dept == "qa" then { let step_result = HandleQA(query, chat_id) }
  if dept == "visual" then { let step_result = HandleVisual(query, chat_id) }
  if dept == "engineering" then { let step_result = HandleEngineering(query, chat_id) }
  if dept == "kavalnya" then { let step_result = HandleKavalnya(query, chat_id) }
  if dept == "admin" then { let step_result = HandleAdmin(query, chat_id) }
  if step_result == "" then { let step_result = "Department not found: " + dept }
  return step_result
}

pattern ExecuteChain(dept_chain: String, query: String, chat_id: String) -> String {
  // FO-027: авто-resume — цепочка тех же департаментов, стартовавшая <1 ч назад
  // и имеющая незавершённые степы, продолжается вместо нового запуска
  let resume_rows = query("SELECT chain_id FROM chain_steps WHERE dept_chain = ? AND mode = 'sequential' AND status IN ('pending','failed') AND created_at > datetime('now', '-1 hour') ORDER BY id DESC LIMIT 1", [dept_chain])
  if to_string(resume_rows) != "()" and length(resume_rows) > 0.0 then {
    let old_chain_id = redact(to_string(json_get(resume_rows[0], "chain_id", "")), "all")
    let _ = AuditLog("chain_auto_resume", "system", old_chain_id)
    let _ = SendTelegramReply(chat_id, "Обнаружена незавершённая цепочка <1 ч — авто-resume " + old_chain_id)
    return ResumeChainSteps(old_chain_id, dept_chain, query, chat_id)
  }

  // FO-027: durable chain_id для чекпоинтов степов
  let chain_id = "seq_" + to_string(sha256(dept_chain + query + to_string(now())))
  // Parse "dept1+dept2+dept3" format
  let _plus = "+"
  let depts = split(dept_chain, _plus)
  let max_depts = 3.0
  let mut total = to_float(length(depts))
  let mut truncated = 0.0

  // Limit to 3 departments
  if total > max_depts then {
    let truncated = 1.0
    let total = max_depts
  }

  let mut results = ""
  let mut count = 0.0

  each dept_slug in depts {
    if count >= max_depts then { }
    else {
      let dept = trim(to_string(dept_slug))
      if dept != "" then {
        let count = count + 1.0
        let _ = AuditLog("chain_step", dept, "step " + to_string(count) + " of " + to_string(total))

        // FO-027: чекпоинт ДО вызова (Temporal-паттерн: persist before run)
        let step_hash = to_string(sha256(chain_id + to_string(count) + dept + query))
        let _ = db_execute("INSERT INTO chain_steps (chain_id, chat_id, step_num, dept, mode, input_hash, status, dept_chain, query) VALUES (?, ?, ?, ?, 'sequential', ?, 'pending', ?, ?)", [chain_id, chat_id, count, dept, step_hash, dept_chain, query])

        // Call the appropriate handler (FO-026: единая диспетчеризация —
        // тот же паттерн используется HTTP-роутом /chain/step для fan-out)
        let step_result = ChainDispatchDept(dept, query, chat_id)

        // FO-027: результат ПОСЛЕ вызова (крах между ними возобновляем)
        let _ = db_execute("UPDATE chain_steps SET status='ok', reply=?, updated_at=datetime('now') WHERE chain_id=? AND step_num=? AND dept=? AND status='pending'", [substring(step_result, 0.0, 20000.0), chain_id, count, dept])

        // If individual result is long, send as separate report
        if length(step_result) > 800.0 then {
          let _ = SendReport(step_result, dept, query, "2.0", chat_id)
          let results = results + "\n\n=== " + dept + " === [Report sent as Mini App]"
        } else {
          let results = results + "\n\n=== " + dept + " ===\n" + step_result
        }
      }
    }
  }

  // Build and send summary
  let mut summary = "Chain: " + to_string(count) + " departments"
  if truncated == 1.0 then {
    let summary = summary + " (truncated from " + to_string(to_float(length(depts))) + ")"
  }

  // If combined results are long enough, use SendReport
  if length(results) > 800.0 then {
    let _ = SendReport(results, "chain", summary, "2.0", chat_id)
  } else {
    let _ = SendTelegramReply(chat_id, summary + results)
  }

  let _ = AuditLog("chain_complete", "system", "chain: " + dept_chain + " steps: " + to_string(count))
  return results
}

// Format chain report body with badges
pattern FormatChainBody(dept: String, text: String) -> String {
  let body = replace(text, "[ФАКТ]", "<span class=\"badge badge-fact\">ФАКТ</span>")
  let body = replace(body, "[ИНТЕРПРЕТАЦИЯ]", "<span class=\"badge badge-interp\">ИНТЕРПРЕТАЦИЯ</span>")
  let body = replace(body, "[СПЕКУЛЯЦИЯ]", "<span class=\"badge badge-spec\">СПЕКУЛЯЦИЯ</span>")
  let body = replace(body, "[FACT]", "<span class=\"badge badge-fact\">FACT</span>")
  let body = replace(body, "[FACT verified]", "<span class=\"badge badge-verified\">FACT verified</span>")
  return body
}

// ═══════════════════════════════════════════════════════════════════════
// FO-027: Resume — возобновление цепочки с последней ok-степы.
// Идемпотентность по input_hash: ok + совпал hash → reply из кэша
// (LLM-вызовов ноль); hash разошёлся → степа инвалидна, исполняется заново.
// Используется авто-resume (<1 ч, ExecuteChain) и /chain continue <chain_id>.
// ═══════════════════════════════════════════════════════════════════════
pattern ResumeChainSteps(chain_id: String, dept_chain: String, query: String, chat_id: String) -> String {
  let _ = AuditLog("chain_resume", "system", "chain: " + chain_id)
  let rows = query("SELECT step_num, dept, status, reply, input_hash FROM chain_steps WHERE chain_id = ? ORDER BY step_num", [chain_id])
  if to_string(rows) == "()" or length(rows) == 0.0 then {
    return "Цепочка " + chain_id + " не найдена или пуста."
  }
  let mut results = ""
  let mut reused = 0.0
  let mut reran = 0.0
  each row in rows {
    let dept = redact(trim(to_string(json_get(row, "dept", ""))), "all")
    let step_num = to_float(json_get(row, "step_num", "0"))
    let st = redact(to_string(json_get(row, "status", "")), "all")
    let stored_hash = redact(to_string(json_get(row, "input_hash", "")), "all")
    let h = to_string(sha256(chain_id + to_string(step_num) + dept + query))
    if st == "ok" and stored_hash == h then {
      let reused = reused + 1.0
      let results = redact(results + "\n\n=== " + dept + " === (из кэша, без LLM)\n" + to_string(json_get(row, "reply", "")), "all")
    } else {
      if st == "ok" then {
        // hash разошёлся — степа инвалидна (детерминизм против молчаливой неактуальности)
        let _ = SendTelegramReply(chat_id, "FO-027: степа " + dept + " инвалидна (query изменился) — переисполнение.")
      }
      let reran = reran + 1.0
      let _ = db_execute("UPDATE chain_steps SET status='pending', input_hash=?, updated_at=datetime('now') WHERE chain_id=? AND step_num=? AND dept=?", [h, chain_id, step_num, dept])
      let rerun_result = ChainDispatchDept(dept, query, chat_id)
      let _ = db_execute("UPDATE chain_steps SET status='ok', reply=?, updated_at=datetime('now') WHERE chain_id=? AND step_num=? AND dept=? AND status='pending'", [substring(rerun_result, 0.0, 20000.0), chain_id, step_num, dept])
      let results = results + "\n\n=== " + dept + " === (переисполнено)\n" + rerun_result
    }
  }
  let summary = "Resume " + chain_id + ": " + to_string(reused) + " из кэша, " + to_string(reran) + " переисполнено"
  let _ = SendTelegramReply(chat_id, summary)
  let _ = AuditLog("chain_resume_done", "system", chain_id + " reused=" + to_string(reused) + " reran=" + to_string(reran))
  return results
}
