// ── visual_palettes.mlog — color_palette system (5 intents × 2 modes) ──
// Visual Department Fosved v1.0
//
// color_palette(intent, mode) → Struct{paper, ink, accent, muted, rule}
//
// intent: calm | tension | energy | authority | warmth
// mode:   light | dark
// Total: 10 palettes
//
// NEVER set colors manually — always via color_palette.

fn DemoAllPalettes() -> String {
  let palettes = [
    {intent: "calm",     mode: "light"}, {intent: "calm",     mode: "dark"},
    {intent: "tension",  mode: "light"}, {intent: "tension",  mode: "dark"},
    {intent: "energy",   mode: "light"}, {intent: "energy",   mode: "dark"},
    {intent: "authority",mode: "light"}, {intent: "authority",mode: "dark"},
    {intent: "warmth",   mode: "light"}, {intent: "warmth",   mode: "dark"}
  ]
  let canvas_w = 960.0
  let card_h = 80.0
  let card_w = 180.0
  let cols = 5
  let canvas_h = 120.0 + 2.0 * (card_h + 20.0)
  let root = svg_canvas(canvas_w, canvas_h, "#FFFFFF")
  let root = svg_text(root, 32.0, 36.0, "Metalogos color_palette — 10 палитр", "#1a1a2e", 20.0, "bold")
  let root = svg_text(root, 32.0, 56.0, "5 intents × 2 modes → {paper, ink, accent, muted, rule}", "#5a5a5a", 12.0, "normal")
  let root = RenderPaletteGrid(root, palettes, 32.0, 80.0, card_w, card_h, cols)
  return root
}

fn RenderPaletteGrid(
  canvas: String,
  palettes: List<Struct{intent: String, mode: String}>,
  x: Float, y: Float, card_w: Float, card_h: Float, cols: Int
) -> String {
  if length(palettes) == 0 then { return canvas }
  let p = palettes[0]
  let rest = slice(palettes, 1, length(palettes))
  let idx = length(palettes) - length(rest) - 1
  let col = idx % cols
  let row = idx / cols
  let style = color_palette(p.intent, p.mode)
  let cx = x + to_float(col) * (card_w + 12.0)
  let cy = y + to_float(row) * (card_h + 20.0)
  let c = svg_rect(canvas, cx, cy, card_w, card_h, style.paper, style.rule)
  let label = p.intent + " / " + p.mode
  let c = svg_text(c, cx + 8.0, cy + 16.0, label, style.ink, 10.0, "bold")
  let swatch_w = (card_w - 16.0) / 5.0
  let c = svg_rect(c, cx + 8.0, cy + 24.0, swatch_w, 20.0, style.paper)
  let c = svg_rect(c, cx + 8.0 + swatch_w, cy + 24.0, swatch_w, 20.0, style.ink)
  let c = svg_rect(c, cx + 8.0 + 2.0*swatch_w, cy + 24.0, swatch_w, 20.0, style.accent)
  let c = svg_rect(c, cx + 8.0 + 3.0*swatch_w, cy + 24.0, swatch_w, 20.0, style.muted)
  let c = svg_rect(c, cx + 8.0 + 4.0*swatch_w, cy + 24.0, swatch_w, 20.0, style.rule)
  let c = svg_text(c, cx + 8.0, cy + 54.0, "paper", style.muted, 7.0, "normal")
  let c = svg_text(c, cx + 8.0 + swatch_w, cy + 54.0, "ink", style.muted, 7.0, "normal")
  let c = svg_text(c, cx + 8.0 + 2.0*swatch_w, cy + 54.0, "accent", style.muted, 7.0, "normal")
  let c = svg_text(c, cx + 8.0 + 3.0*swatch_w, cy + 54.0, "muted", style.muted, 7.0, "normal")
  let c = svg_text(c, cx + 8.0 + 4.0*swatch_w, cy + 54.0, "rule", style.muted, 7.0, "normal")
  let c = svg_text(c, cx + 8.0, cy + 70.0, "Заголовок", style.accent, 9.0, "bold")
  let c = svg_text(c, cx + 70.0, cy + 70.0, "Текст", style.ink, 9.0, "normal")
  return RenderPaletteGrid(c, rest, x, y, card_w, card_h, cols)
}

// Fosved brand override: authority/dark + gold accent
fn FosvedBrandPalette() -> Struct{paper: String, ink: String, accent: String, muted: String, rule: String} {
  let base = color_palette("authority", "dark")
  return {paper: base.paper, ink: base.ink, accent: "#c9a961", muted: base.muted, rule: base.rule}
}
