// 7. chart_boxplot — Box plot
fn VisualBoxplotChart(data: List<Struct{label: String, q1: Float, median: Float, q3: Float, whisker_low: Float, whisker_high: Float}>, intent: String, mode: String) -> String {
  let style = color_palette(intent, mode)
  return chart_boxplot(data, style)
}

fn DemoBoxplotChart() -> String {
  let response_times = [
    {label: "Anthropic", q1: 1.2, median: 2.1, q3: 3.4, whisker_low: 0.5, whisker_high: 6.8},
    {label: "OpenAI",    q1: 1.8, median: 2.9, q3: 4.1, whisker_low: 0.8, whisker_high: 8.2},
    {label: "Grok",      q1: 0.6, median: 1.1, q3: 1.8, whisker_low: 0.3, whisker_high: 3.5},
    {label: "DeepSeek",  q1: 2.1, median: 3.6, q3: 5.2, whisker_low: 1.0, whisker_high: 9.1}
  ]
  return VisualBoxplotChart(response_times, "tension", "light")
}

// 8. chart_heatmap — Heat map
fn VisualHeatmapChart(data: Struct{rows: List<String>, cols: List<String>, values: List<List<Float>}, intent: String, mode: String) -> String {
  let style = color_palette(intent, mode)
  return chart_heatmap(data, style)
}

fn DemoHeatmapChart() -> String {
  let activity_matrix = {
    rows: ["ОСП", "ЛЗ", "Эксперт", "Yana", "Кузница"],
    cols: ["09","10","11","12","13","14","15","16","17","18"],
    values: [
      [2.0,5.0,8.0,6.0,3.0,7.0,9.0,8.0,4.0,1.0],
      [1.0,3.0,6.0,7.0,4.0,5.0,6.0,4.0,2.0,0.0],
      [0.0,4.0,7.0,5.0,2.0,8.0,7.0,6.0,3.0,1.0],
      [3.0,6.0,9.0,8.0,5.0,7.0,8.0,9.0,6.0,2.0],
      [1.0,2.0,4.0,3.0,6.0,5.0,4.0,3.0,2.0,1.0]
    ]
  }
  return VisualHeatmapChart(activity_matrix, "energy", "dark")
}

// Master renderer
fn RenderChart(kind: String, data: Any, intent: String, mode: String) -> String {
  let style = color_palette(intent, mode)
  if kind == "bar" then { return chart_bar(data, style) }
  if kind == "line" then { return chart_line(data, style) }
  if kind == "area" then { return chart_area(data, style) }
  if kind == "donut" then { return chart_donut(data, style) }
  if kind == "scatter" then { return chart_scatter(data, style) }
  if kind == "radar" then { return chart_radar(data, style) }
  if kind == "boxplot" then { return chart_boxplot(data, style) }
  if kind == "heatmap" then { return chart_heatmap(data, style) }
  return "<svg><!-- unknown chart: " + kind + " --></svg>"
}
