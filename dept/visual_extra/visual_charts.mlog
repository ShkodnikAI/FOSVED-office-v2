// ── visual_charts.mlog — All 8 chart_* functions (Metalogos native SVG) ──
// Visual Department Fosved v1.0
//
// Coverage: chart_bar, chart_line, chart_area, chart_donut,
//           chart_scatter, chart_radar, chart_boxplot, chart_heatmap

// 1. chart_bar — Category bar chart
fn VisualBarChart(data: List<Struct{label: String, value: Float}>, intent: String, mode: String) -> String {
  let style = color_palette(intent, mode)
  let svg = chart_bar(data, style)
  let qa = infographic_qa(svg)
  if qa.passed == false then { print("WARNING: Bar chart QA: " + to_string(qa.warnings)) }
  return svg
}

fn DemoBarChart() -> String {
  let dept_activity = [
    {label: "ОСП",    value: 142.0}, {label: "ЛЗ",     value: 98.0},
    {label: "Эксперт",value: 87.0},  {label: "Yana",   value: 76.0},
    {label: "Кузница",value: 64.0},  {label: "Финанс", value: 51.0},
    {label: "Юрист",  value: 43.0},  {label: "Визуал", value: 38.0}
  ]
  return VisualBarChart(dept_activity, "authority", "dark")
}

// 2. chart_line — Time series
fn VisualLineChart(data: List<Struct{label: String, value: Float}>, intent: String, mode: String) -> String {
  let style = color_palette(intent, mode)
  let svg = chart_line(data, style)
  let qa = infographic_qa(svg)
  if qa.passed == false then { print("WARNING: Line chart QA: " + to_string(qa.warnings)) }
  return svg
}

fn DemoLineChart() -> String {
  let weekly_cost = [
    {label: "Пн", value: 12.40}, {label: "Вт", value: 15.80},
    {label: "Ср", value: 9.20},  {label: "Чт", value: 18.60},
    {label: "Пт", value: 22.10}, {label: "Сб", value: 7.30},
    {label: "Вс", value: 5.10}
  ]
  return VisualLineChart(weekly_cost, "energy", "light")
}

