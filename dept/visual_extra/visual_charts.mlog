    {x: 9.8, y: 3.5, label: "Кузница"},  {x: 4.2, y: 3.9, label: "Финанс"},
    {x: 3.1, y: 3.2, label: "Юрист"},    {x: 2.8, y: 4.6, label: "Визуал"}
  ]
