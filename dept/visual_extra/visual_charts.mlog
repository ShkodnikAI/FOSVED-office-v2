// 6. chart_radar — Radar chart
fn VisualRadarChart(data: Struct{axes: List<String>, series: List<Struct{name: String, values: List<Float>}>}, intent: String, mode: String) -> String {
  let style = color_palette(intent, mode)
  return chart_radar(data, style)
}

fn DemoRadarChart() -> String {
  let model_comparison = {
    axes: ["Скорость", "Качество", "Стоимость", "Контекст", "Многоязычность", "Рассуждения"],
    series: [
      {name: "Claude", values: [7.0,9.0,6.0,8.0,7.0,9.0]},
      {name: "GPT-4",  values: [6.0,8.0,4.0,9.0,8.0,8.0]},
      {name: "Grok",   values: [9.0,7.0,7.0,6.0,6.0,7.0]}
    ]
  }
  return VisualRadarChart(model_comparison, "authority", "dark")
