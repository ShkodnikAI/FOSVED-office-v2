  }
  if to_dept == "lz" and skill == "tech_scan" then {
    let r = try LZTechScan(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "osp" and skill == "forecast" then {
    let r = try OSPForecast(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "osp" and skill == "cross_country" then {
    let r = try OSPCrossCountry(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "expert" and skill == "brief" then {
    let r = try ExpertBrief(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "finance" and skill == "calc" then {
    let r = try FinanceCalc(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "legal" and skill == "legal_check" then {
    let r = try LegalCheck(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "marketing" and skill == "audience" then {
    let r = try MarketingAudience(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "design" and skill == "ux_review" then {
    let r = try DesignUxReview(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "dev" and skill == "tech_estimate" then {
    let r = try DevTechEstimate(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "qa" and skill == "risk_review" then {
    let r = try QaRiskReview(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "engineering" and skill == "feasibility" then {
    let r = try EngineeringFeasibility(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "visual" and skill == "visualize" then {
    let r = try VisualDeptVisualize(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "kavalnya" and skill == "methodology_review" then {
    let r = try KavalnyaMethodologyReview(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  if to_dept == "admin" and skill == "system_status" then {
    let r = try AdminSystemStatus(question)
    if to_string(r) != "()" then { let body = to_string(r) }
  }
  return body
}

// Навык подключён в диспетчере? (гвард рассинхрона реестра и кода)
pattern TeamSkillWired(to_dept: String, skill: String) -> Bool {
  if to_dept == "lz" and (skill == "factpack" or skill == "tech_scan") then { return true }
  if to_dept == "osp" and (skill == "forecast" or skill == "cross_country") then { return true }
  if to_dept == "expert" and skill == "brief" then { return true }
  if to_dept == "finance" and skill == "calc" then { return true }
  if to_dept == "legal" and skill == "legal_check" then { return true }
  if to_dept == "marketing" and skill == "audience" then { return true }
  if to_dept == "design" and skill == "ux_review" then { return true }
  if to_dept == "dev" and skill == "tech_estimate" then { return true }
  if to_dept == "qa" and skill == "risk_review" then { return true }
  if to_dept == "engineering" and skill == "feasibility" then { return true }
  if to_dept == "visual" and skill == "visualize" then { return true }
  if to_dept == "kavalnya" and skill == "methodology_review" then { return true }
  if to_dept == "admin" and skill == "system_status" then { return true }
  return false
}

// ── TEAM-2 #481 A.4: Яна-оркестратор — мультиобластной запрос ────────
// Детерминированно (без LLM): две и более семьи областей по маркерам.
pattern TeamYanaMultiDomain(query: String) -> Bool {
  let t = lower(query)
  let mut families = 0.0
  if contains(t, "рынок") or contains(t, "финанс") or contains(t, "бюджет") or contains(t, "прибыл") or contains(t, "окупаемост") or contains(t, "экономик") then { let families = families + 1.0 }
  if contains(t, "право") or contains(t, "юриди") or contains(t, "налог") or contains(t, "лиценз") or contains(t, "договор") or contains(t, "комплаенс") then { let families = families + 1.0 }
  if contains(t, "технолог") or contains(t, "производств") or contains(t, "оборудован") or contains(t, "разработк") or contains(t, "приложени") then { let families = families + 1.0 }
  if contains(t, "аудитори") or contains(t, "клиент") or contains(t, "маркетин") or contains(t, "реклам") or contains(t, "продаж") then { let families = families + 1.0 }
  if contains(t, "геополит") or contains(t, "риск") or contains(t, "прогноз") or contains(t, "конкурент") then { let families = families + 1.0 }
  return families >= 2.0
}

// Составить цепочку отделов по семьям (формат ExecuteChain: dept1+dept2)
pattern TeamYanaChainDepts(query: String) -> String {
  let t = lower(query)
  let mut chain = ""
  if contains(t, "рынок") or contains(t, "финанс") or contains(t, "бюджет") or contains(t, "прибыл") or contains(t, "окупаемост") then { let chain = chain + "+finance" }
  if contains(t, "право") or contains(t, "юриди") or contains(t, "налог") or contains(t, "лиценз") or contains(t, "договор") then { let chain = chain + "+legal" }
  if contains(t, "технолог") or contains(t, "производств") or contains(t, "оборудован") or contains(t, "разработк") or contains(t, "приложени") then { let chain = chain + "+dev" }
  if contains(t, "аудитори") or contains(t, "клиент") or contains(t, "маркетин") or contains(t, "реклам") or contains(t, "продаж") then { let chain = chain + "+marketing" }
  if contains(t, "геополит") or contains(t, "риск") or contains(t, "прогноз") or contains(t, "конкурент") then { let chain = chain + "+osp" }
  if starts_with(chain, "+") then { return substring(chain, 1.0, length(chain)) }
  return chain
}

