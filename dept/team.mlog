// Fosved Office v2 — Team Core (наряд #480 TEAM-1, ADR-0016)
//
// Ядро взаимодействия отделов: реестр навыков, бриф коллег, тихий режим,
// примитив консультации TeamConsult, ограничители (глубина, бюджет,
// кэш, аудит). Идеи: A2A AgentSkill (реестр), CrewAI ask/delegate +
// OpenAI Agents SDK agent-as-tool (консультация). Код не копировался.
//
// Принципы:
// - Источник объявлений навыков — один, этот файл (ADR-0013 в части
//   «один источник правды»): запись в реестре без реализации даёт
//   честный отказ, реализация без записи не вызовется.
// - Тихий режим: на время вызова в KV держится флаг team_quiet;
//   навык-функция тихий по построению, полный обработчик (TEAM-2)
//   обязан проверять TeamIsQuiet перед RecordAssistantMessage и
//   SendTelegramReply. Консультация пишет audit_log team_consult.
// - Ограничители: глубина 1 (стек в KV, окно 300 с), бюджет на запрос
//   владельца - TEAM_MAX_CONSULTS дефолт 3 и TEAM_MAX_LLM_CALLS дефолт 6
//   (счётчики KV, окно 600 с), кэш ответа на 30 мин, каждый вызов - в
//   audit_log. Сброс всего - TeamBudgetReset в начале обработчика.
// - Отказы - честная строка «коллега X недоступен: причина», не пустота;
//   отказы не кэшируются.
// - Cross-file вызовы (AuditLog, LZFactpack) - через bare try (штатный
//   приём dept/admin.mlog и dept/scheduler.mlog): честный отказ работает
//   и в автономном нативном прогоне без db и прокси.

// ── A.2: Реестр навыков ──────────────────────────────────────────────
// Формат записи: dept, skill, description, input, output, freshness,
// cost_llm (заявленная стоимость в вызовах LLM), enabled.
// enabled=false — навык объявлен, подключение в TEAM-2 (#481).
pattern TeamSkills() -> String {
  return json_encode([
    {dept: "lz", skill: "factpack", description: "Разведсводка по вопросу: живой поиск Tavily, кэш новостей, темы Telegram-мониторов — без гейтов и дисклеймеров полного ответа ЛЗ", input: "тема вопроса", output: "блок фактов с URL и датами, честные отказы", freshness: "живой поиск на момент запроса", cost_llm: 0.0, enabled: true},
    {dept: "lz", skill: "tech_scan", description: "Тех-скан: arXiv, HN, GitHub по технологии", input: "технология", output: "сводка сигналов", freshness: "на момент запроса", cost_llm: 0.0, enabled: true},
    {dept: "osp", skill: "forecast", description: "Калиброванная оценка вероятности по вопросу", input: "формулировка прогноза", output: "вероятности с обоснованием", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "osp", skill: "cross_country", description: "Кросс-страновая проекция решения", input: "решение и страны", output: "таблица различий", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "expert", skill: "brief", description: "Погружение в тему: сильные и слабые места позиции", input: "тема", output: "бриф с слабыми местами", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "finance", skill: "calc", description: "Юнит-экономика и налоги по юрисдикции", input: "модель и юрисдикция", output: "расчёт с допущениями", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "legal", skill: "legal_check", description: "Правовые риски и регуляторика по юрисдикции", input: "действие и юрисдикция", output: "список рисков", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "marketing", skill: "audience", description: "Разбор аудитории и каналов", input: "продукт и рынок", output: "сегменты и каналы", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "design", skill: "ux_review", description: "Разбор UX и интерфейса", input: "описание экрана или поток", output: "список замечаний", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "dev", skill: "tech_estimate", description: "Оценка сложности и стека", input: "задача", output: "оценка с диапазоном", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "qa", skill: "risk_review", description: "Риск-обзор плана или фичи", input: "план", output: "реестр рисков", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "engineering", skill: "feasibility", description: "Оценка реализуемости", input: "идея", output: "вердикт и границы", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "visual", skill: "visualize", description: "Визуальный артефакт по данным", input: "данные и формат", output: "ссылка на артефакт", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "kavalnya", skill: "methodology_review", description: "Проверка методологии", input: "методика", output: "замечания по стандарту", freshness: "на момент запроса", cost_llm: 1.0, enabled: true},
    {dept: "admin", skill: "system_status", description: "Статус системы и ключей", input: "подсистема", output: "статус с фактами", freshness: "живые данные", cost_llm: 0.0, enabled: true},
    {dept: "yana", skill: "", description: "Оркестратор: не поставщик навыков — запускает совместную работу отделов", input: "мультиобластной запрос", output: "координация", freshness: "не применимо", cost_llm: 0.0, enabled: false}
  ])
}

// ── A.2: Бриф коллег для промпта отдела (как в CrewAI) ───────────────
// В перечне только включённые навыки — обещать то, что отклонится
// честной строкой, промпту нельзя. Собственный отдел исключён.
pattern TeamCoworkersBrief(dept: String) -> String {
  let arr = parse_json(TeamSkills())
  if to_string(arr) == "()" then { return "" }
  let count = length(arr)
  let mut out = "=== Коллеги и их навыки (командная работа, ADR-0016) ==="
  let mut i = 0.0
  while i < count {
    let row = get(arr, i)
    let d = to_string(json_get(row, "dept", ""))
    let en = json_get(row, "enabled", false)
    if d != dept and en == true then {
      let out = out + "\n- " + d + " / " + to_string(json_get(row, "skill", "")) + " — " + to_string(json_get(row, "description", "")) + ". Вход: " + to_string(json_get(row, "input", "")) + ". Выход: " + to_string(json_get(row, "output", "")) + "."
    }
    let i = i + 1.0
  }
  return out
}

// ── Реестровые вспомогательные ───────────────────────────────────────
pattern TeamIsRegistered(dept: String) -> Bool {
  let arr = parse_json(TeamSkills())
  if to_string(arr) == "()" then { return false }
  let count = length(arr)
  let mut i = 0.0
  while i < count {
    let row = get(arr, i)
    if to_string(json_get(row, "dept", "")) == dept then { return true }
    let i = i + 1.0
  }
  return false
}

pattern TeamSkillCost(to_dept: String, skill: String) -> Float {
  let arr = parse_json(TeamSkills())
  if to_string(arr) == "()" then { return 0.0 }
  let count = length(arr)
  let mut i = 0.0
  while i < count {
    let row = get(arr, i)
    if to_string(json_get(row, "dept", "")) == to_dept and to_string(json_get(row, "skill", "")) == skill then {
      return to_float(json_get(row, "cost_llm", 0.0))
    }
    let i = i + 1.0
  }
  return 0.0
}

// ── Бюджет консультаций (KV, окно 600 с против залипания) ────────────
pattern TeamBudgetReset() -> String {
  let _ = kv_set("team_budget_consults", json_encode({ts: now(), used: 0.0}))
  let _ = kv_set("team_budget_llm", json_encode({ts: now(), used: 0.0}))
  let _ = kv_set("team_consult_stack", "")
  let _ = kv_set("team_quiet", "")
  return "ok"
}

pattern TeamBudgetUsed() -> Float {
  let v = kv_get("team_budget_consults")
  if v == "" then { return 0.0 }
  let j = parse_json(v)
  if to_string(j) == "()" then { return 0.0 }
  let ts = to_float(json_get(j, "ts", 0.0))
  if to_float(now()) - ts > 600.0 then { return 0.0 }
  return to_float(json_get(j, "used", 0.0))
}

pattern TeamBudgetCharge() -> Float {
  let used = TeamBudgetUsed() + 1.0
  let _ = kv_set("team_budget_consults", json_encode({ts: now(), used: used}))
  return used
}

// ── Бюджет вызовов LLM (начисление по стоимости навыка из реестра) ───
pattern TeamLLMUsed() -> Float {
  let v = kv_get("team_budget_llm")
  if v == "" then { return 0.0 }
  let j = parse_json(v)
  if to_string(j) == "()" then { return 0.0 }
  let ts = to_float(json_get(j, "ts", 0.0))
  if to_float(now()) - ts > 600.0 then { return 0.0 }
  return to_float(json_get(j, "used", 0.0))
}

pattern TeamLLMCharge(n: Float) -> String {
  let used = TeamLLMUsed() + n
  let _ = kv_set("team_budget_llm", json_encode({ts: now(), used: used}))
  return "ok"
}

// ── Стек глубины (глубина 1: консультируемый не консультирует) ───────
pattern TeamStackBegin(from_dept: String, to_dept: String, skill: String) -> String {
  let _ = kv_set("team_consult_stack", json_encode({ts: now(), src: from_dept, tgt: to_dept, skill: skill}))
  return "ok"
}

pattern TeamStackEnd() -> String {
  let _ = kv_set("team_consult_stack", "")
  return "ok"
}

pattern TeamStackActive() -> Bool {
  let v = kv_get("team_consult_stack")
  if v == "" then { return false }
  let j = parse_json(v)
  if to_string(j) == "()" then { return false }
  let ts = to_float(json_get(j, "ts", 0.0))
  return to_float(now()) - ts <= 300.0
}

// ── A.3: Тихий режим ─────────────────────────────────────────────────
// Флаг живёт только на время вызова навыка. Полный обработчик (TEAM-2)
// перед RecordAssistantMessage и SendTelegramReply обязан проверять
// TeamIsQuiet и пропускать побочные эффекты. Окно 300 с — защита от
// залипания при падении процесса; сброс — TeamBudgetReset.
pattern TeamQuietBegin(from_dept: String, to_dept: String, skill: String) -> String {
  let _ = kv_set("team_quiet", json_encode({ts: now(), src: from_dept, tgt: to_dept, skill: skill}))
  return "ok"
}

pattern TeamQuietEnd() -> String {
  let _ = kv_set("team_quiet", "")
  return "ok"
}

pattern TeamIsQuiet() -> Bool {
  let v = kv_get("team_quiet")
  if v == "" then { return false }
  let j = parse_json(v)
  if to_string(j) == "()" then { return false }
  let ts = to_float(json_get(j, "ts", 0.0))
  return to_float(now()) - ts <= 300.0
}

// ── A.5: Кэш консультаций (KV, TTL 30 мин) ───────────────────────────
// Ключ — to_dept, skill и нормализованный вопрос. Отказы не кэшируются:
// отказ — состояние запроса или коллеги, кэш отказов блокировал бы
// повторную попытку после устранимой причины.
pattern TeamNormQuestion(question: String) -> String {
  let q = lower(trim(question))
  if length(q) > 200.0 then { return substring(q, 0.0, 200.0) }
  return q
}

pattern TeamCacheStore(to_dept: String, skill: String, question: String, answer: String, at: Float) -> String {
  let key = "team_consult_cache|" + to_dept + "|" + skill + "|" + TeamNormQuestion(question)
  let _ = kv_set(key, json_encode({ts: at, answer: answer}))
  return "ok"
}

pattern TeamCacheLookup(to_dept: String, skill: String, question: String) -> String {
  let key = "team_consult_cache|" + to_dept + "|" + skill + "|" + TeamNormQuestion(question)
  let v = kv_get(key)
  if v == "" then { return "" }
  let j = parse_json(v)
  if to_string(j) == "()" then { return "" }
  let ts = to_float(json_get(j, "ts", 0.0))
  if to_float(now()) - ts > 1800.0 then { return "" }
  return to_string(json_get(j, "answer", ""))
}

// ── Извлечение секции из ответа навыка по маркерам ───────────────────
// Детерминированные маркеры [LIVE]/[NEWS]/[TG] выписывает сам навык;
// ОСП извлекает live-часть для гейта актуальности #474 A.2.
pattern TeamExtractSection(text: String, start_marker: String, end_marker: String) -> String {
  let s = index_of(text, start_marker)
  if s < 0.0 then { return "" }
  let rest = substring(text, s + length(start_marker), length(text))
  let e = index_of(rest, end_marker)
  if e < 0.0 then { return "" }
  return substring(rest, 0.0, e)
}

// ── Числовые env-параметры ограничителей ─────────────────────────────
// Чистый фильтр без try (TryVal вне неймспейса автономного прогона):
// только простые неотрицательные числа; мусор/пустота — дефолт.
// По образцу OSPStrIsNumber (n469).
pattern TeamIsNumberish(s: String) -> Bool {
  if length(s) == 0.0 then { return false }
  let mut dots = 0.0
  let mut i = 0.0
  while i < length(s) {
    let ch = substring(s, i, i + 1.0)
    if ch == "." then {
      let dots = dots + 1.0
    } else {
      if ch != "0" and ch != "1" and ch != "2" and ch != "3" and ch != "4" and ch != "5" and ch != "6" and ch != "7" and ch != "8" and ch != "9" then { return false }
    }
    let i = i + 1.0
  }
  return dots <= 1.0
}

pattern TeamEnvCount(name: String, default: Float) -> Float {
  let raw = trim(env_or(name, ""))
  if raw == "" then { return default }
  if TeamIsNumberish(raw) == false then { return default }
  return to_float(raw)
}

// ── A.4: Примитив консультации ───────────────────────────────────────
// Порядок проверок: глубина - кэш - бюджет консультаций - бюджет LLM -
// реестр - диспетчеризация. Кэш до бюджета: попадание не тратит квоту.
// Диспетчеризация — bare try: падение навыка даёт честный отказ, а не
// пустоту; стек и тихий флаг снимаются на обоих путях.
pattern TeamConsult(from_dept: String, to_dept: String, skill: String, question: String, context: String) -> String {
  if TeamStackActive() then {
    let _ = try AuditLog("team_consult", from_dept, "status=refused reason=depth to=" + to_dept + " skill=" + skill)
    return "(консультация отклонена: глубина 1 исчерпана — консультируемый не консультирует дальше)"
  }
  let cached = TeamCacheLookup(to_dept, skill, question)
  if cached != "" then {
    let _ = try AuditLog("team_consult", from_dept, "status=cache_hit to=" + to_dept + " skill=" + skill)
    return cached
  }
  let max_c = TeamEnvCount("TEAM_MAX_CONSULTS", 3.0)
  if TeamBudgetUsed() >= max_c then {
    let _ = try AuditLog("team_consult", from_dept, "status=refused reason=budget_consults to=" + to_dept + " skill=" + skill)
    return "(консультация отклонена: бюджет консультаций на запрос исчерпан — TEAM_MAX_CONSULTS)"
  }
  let max_l = TeamEnvCount("TEAM_MAX_LLM_CALLS", 6.0)
  if TeamLLMUsed() >= max_l then {
    let _ = try AuditLog("team_consult", from_dept, "status=refused reason=budget_llm to=" + to_dept + " skill=" + skill)
    return "(консультация отклонена: бюджет вызовов LLM на запрос исчерпан — TEAM_MAX_LLM_CALLS)"
  }
  if TeamIsRegistered(to_dept) == false then {
    let _ = try AuditLog("team_consult", from_dept, "status=refused reason=unknown_dept to=" + to_dept + " skill=" + skill)
    return "(коллега " + to_dept + " недоступен: отдел не в реестре командной работы)"
  }
  if TeamSkillWired(to_dept, skill) == false then {
    let _ = try AuditLog("team_consult", from_dept, "status=refused reason=skill_not_wired to=" + to_dept + " skill=" + skill)
    return "(коллега " + to_dept + " недоступен: навык '" + skill + "' ещё не подключён — TEAM-2)"
  }
  let _ = TeamQuietBegin(from_dept, to_dept, skill)
  let _ = TeamStackBegin(from_dept, to_dept, skill)
  let body = TeamRunSkill(to_dept, skill, question)
  let _ = TeamStackEnd()
  let _ = TeamQuietEnd()
  if body == "" then {
    let _ = try AuditLog("team_consult", from_dept, "status=refused reason=skill_error to=" + to_dept + " skill=" + skill)
    return "(коллега " + to_dept + " недоступен: навык вернул ошибку исполнения)"
  }
  let answer = "=== Консультация: " + to_dept + "/" + skill + " ===\n" + body
  let _ = TeamCacheStore(to_dept, skill, question, answer, now())
  let cost = TeamSkillCost(to_dept, skill)
  if cost > 0.0 then { let _ = TeamLLMCharge(cost) }
  let _ = TeamBudgetCharge()
  let _ = try AuditLog("team_consult", from_dept, "status=ok to=" + to_dept + " skill=" + skill + " cost_llm=" + to_string(cost))
  return answer
}

// ── TEAM-2 #481: карта потребностей по умолчанию (A.2, без LLM) ──────
// Детерминированное «кто кого спрашивает» — по маркерам запроса.
// Формат строк: to_dept|skill. Само-консультации исключены.
pattern TeamNeedsMap(from_dept: String, query: String) -> String {
  let t = lower(query)
  let mut out = ""
  if contains(t, "что происход") or contains(t, "что случил") or contains(t, "последние новости") or contains(t, "сейчас в мире") or contains(t, "актуальная обстановка") then {
    if from_dept != "lz" then { let out = out + "lz|factpack\n" }
  }
  if from_dept == "finance" and (contains(t, "налог") or contains(t, "ндс") or contains(t, "юрисдикци") or contains(t, "ип ") or contains(t, "ооо ")) then {
    let out = out + "legal|legal_check\n"
  }
  if from_dept == "expert" and (contains(t, "вклад") or contains(t, "влож") or contains(t, "инвестиц") or contains(t, "портфель") or contains(t, "окупаемост")) then {
    let out = out + "finance|calc\n"
  }
  if from_dept == "dev" and (contains(t, "архитектур") or contains(t, "рефакторинг") or contains(t, "миграци")) then {
    let out = out + "qa|risk_review\n"
  }
  return out
}

// Исполнить карту потребностей: по строке — одна консультация через
// TeamConsult (бюджет и кэш — общий шов). Пустая карта — пустой блок.
pattern TeamAutoConsult(from_dept: String, query: String) -> String {
  let map = trim(TeamNeedsMap(from_dept, query))
  if map == "" then { return "" }
  let lines = split(map, "\n")
  let count = length(lines)
  let mut block = ""
  let mut i = 0.0
  while i < count {
    let line = trim(to_string(get(lines, i)))
    if line != "" then {
      let sep = index_of(line, "|")
      if sep >= 0.0 then {
        let to_dept = trim(substring(line, 0.0, sep))
        let skill = trim(substring(line, sep + 1.0, length(line)))
        let consult = TeamConsult(from_dept, to_dept, skill, query, "")
        let block = block + consult + "\n"
      }
    }
    let i = i + 1.0
  }
  if trim(block) == "" then { return "" }
  return block
}

// ── TEAM-2 #481 A.3: правило ASK для промптов отделов ────────────────
pattern TeamAskRule() -> String {
  return "\n\n=== Командная работа: правило ASK ===\nЕсли для качественного ответа не хватает данных или компетенции коллеги — вместо выдумки выведи в конце черновика маркер строго в формате [ASK: отдел/навык | конкретный вопрос]. Не более двух маркеров. Отделы и навыки — только из списка коллег выше. Система спросит коллегу и даст тебе ответ для финального ответа владельцу. Никогда не выдумывай факты вместо запроса к коллеге."
}

pattern TeamAskBlock(dept: String) -> String {
  return TeamCoworkersBrief(dept) + TeamAskRule()
}

// Вырезать все ASK-маркеры из текста (страховка: маркеры не доходят владельцу)
pattern TeamStripAsks(text: String) -> String {
  let mut out = text
  let mut guard = 0.0
  while guard < 4.0 {
    let guard = guard + 1.0
    let start = index_of(out, "[ASK:")
    if start < 0.0 then {
      let guard = 4.0
    } else {
      let rest = substring(out, start, length(out))
      let end = index_of(rest, "]")
      if end < 0.0 then {
        let out = trim(substring(out, 0.0, start))
        let guard = 4.0
      } else {
        let after = substring(rest, end + 1.0, length(rest))
        let out = substring(out, 0.0, start) + after
      }
    }
  }
  let out = replace(out, "  ", " ")
  let out = replace(out, "  ", " ")
  return trim(out)
}

// Разобрать ASK-маркеры черновика (не более 2): исполнить консультации.
// Возврат json: n (число исполненных), clean (черновик без маркеров),
// consults (блок консультаций с заголовками).
pattern TeamProcessAsks(from_dept: String, reply: String) -> String {
  let mut clean = reply
  let mut consults = ""
  let mut n = 0.0
  let mut guard = 0.0
  while guard < 3.0 {
    let guard = guard + 1.0
    let start = index_of(clean, "[ASK:")
    if start < 0.0 then {
      let guard = 3.0
    } else {
      let rest = substring(clean, start + 5.0, length(clean))
      let end = index_of(rest, "]")
      if end < 0.0 then {
        let clean = trim(substring(clean, 0.0, start))
        let guard = 3.0
      } else {
        let inner = trim(substring(rest, 0.0, end))
        let after = substring(rest, end + 1.0, length(rest))
        let clean = trim(substring(clean, 0.0, start)) + " " + after
        let sep = index_of(inner, "|")
        if sep >= 0.0 and n < 2.0 then {
          let target = trim(substring(inner, 0.0, sep))
          let question = trim(substring(inner, sep + 1.0, length(inner)))
          let slash = index_of(target, "/")
          if slash >= 0.0 then {
            let to_dept = trim(substring(target, 0.0, slash))
            let skill = trim(substring(target, slash + 1.0, length(target)))
            let consult = TeamConsult(from_dept, to_dept, skill, question, "")
            let consults = consults + "\n\n" + consult
            let n = n + 1.0
          }
        }
      }
    }
  }
  return json_encode({n: n, clean: clean, consults: consults})
}

// Второй проход: исполнить ASK-маркеры черновика, спросить модель ещё раз
// с ответами коллег. Возврат: финальный ответ (всегда без маркеров) или
// "" — второй проход не потребовался/не удался (вызывающий оставит черновик,
// очищенный от маркеров — TeamStripAsks применён на всех путях).
pattern TeamSecondPass(dept: String, query: String, context: String, draft: String) -> String {
  if contains(draft, "[ASK:") == false then { return "" }
  let asks = parse_json(TeamProcessAsks(dept, draft))
  let n = to_float(json_get(asks, "n", 0.0))
  if n <= 0.0 then { return TeamStripAsks(draft) }
  let clean = to_string(json_get(asks, "clean", ""))
  let consults = to_string(json_get(asks, "consults", ""))
  let context2 = context + consults + "\n\n=== Черновик первого прохода — дай финальный ответ владельцу с учётом консультаций коллег выше ===\n" + clean + "\nНе упоминай механику консультаций и не выводи маркеры ASK."
  let r = redact(to_string(TryVal(try call_llm(context2, query))), "all")
  if r == "()" then { return TeamStripAsks(draft) + TeamFooterFromBlock(consults) }
  return TeamStripAsks(r) + TeamFooterFromBlock(consults)
}

// ── TEAM-2 #481 A.5: строка источников из блока консультаций ─────────
pattern TeamFooterFromBlock(block: String) -> String {
  let mut out = ""
  let mut rest = block
  let mut guard = 0.0
  while guard < 4.0 {
    let guard = guard + 1.0
    let start = index_of(rest, "=== Консультация: ")
    if start < 0.0 then {
      let guard = 4.0
    } else {
      let after = substring(rest, start + 18.0, length(rest))
      let end = index_of(after, " ===")
      if end < 0.0 then {
        let guard = 4.0
      } else {
        let name = trim(substring(after, 0.0, end))
        if contains(out, name) == false then { let out = out + name + ", " }
        let rest = substring(after, end + 4.0, length(after))
      }
    }
  }
  if out == "" then { return "" }
  return "\n\nИсточники: консультации коллег — " + substring(out, 0.0, length(out) - 2.0)
}

// ── TEAM-2 #481: диспетчер навыков (реестр — единственный источник) ──
// Каждый навык — облегчённая функция в своём dept-файле, тихая по
// построению. Падение навыка — честный отказ вызывающему (TeamConsult).
pattern TeamRunSkill(to_dept: String, skill: String, question: String) -> String {
  let mut body = ""
  if to_dept == "lz" and skill == "factpack" then {
    let r = try LZFactpack(question)
