}

test "team-481: второй проход — ответ владельцу никогда не содержит маркеров" {
  let res = TeamSecondPass("osp", "q", "ctx", "черновик [ASK: lz/factpack]")
  assert_eq(contains(res, "[ASK"), false)
  assert_eq(length(res) > 0.0, true)
  assert_eq(TeamSecondPass("osp", "q", "ctx", "просто ответ без маркеров"), "")
}

test "team-481: диспетчер — все навыки реестра проводятся, чужие нет" {
  assert_eq(TeamSkillWired("lz", "factpack"), true)
  assert_eq(TeamSkillWired("lz", "tech_scan"), true)
  assert_eq(TeamSkillWired("finance", "calc"), true)
