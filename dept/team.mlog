}

test "team-481: ASK-процессор — максимум два маркера, чистый текст без маркеров" {
  let _ = TeamBudgetReset()
  let j = parse_json(TeamProcessAsks("osp", "А1 [ASK: lz/factpack | вопрос один] Б [ASK: lz/factpack | вопрос два] В [ASK: lz/factpack | три]"))
  assert_eq(to_float(json_get(j, "n", 0.0)), 2.0)
  let clean = to_string(json_get(j, "clean", ""))
