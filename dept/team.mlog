  assert_eq(trim(TeamNeedsMap("osp", "что происходит в мировой экономике")), "lz|factpack")
  assert_eq(TeamNeedsMap("lz", "что происходит в мире"), "")
  assert_eq(trim(TeamNeedsMap("marketing", "актуальная обстановка на рынке рекламы")), "lz|factpack")
}

test "team-481: карта потребностей — эксперт к финансам, дев к QA" {
