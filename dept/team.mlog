  assert_eq(trim(TeamNeedsMap("dev", "рефакторинг архитектуры бэкенда")), "qa|risk_review")
}

test "team-481: strip — маркеры ASK вырезаются на всех путях" {
  assert_eq(TeamStripAsks("Ответ. [ASK: lz/factpack | свежие факты] Конец."), "Ответ. Конец.")
