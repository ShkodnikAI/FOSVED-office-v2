// Fosved Office v2 — Utils (MEGA-3)
// AuditLog, archive helpers, strip HTML, dept hashtags, shared utilities

// ── Audit Log (18 action types) ──────────────────────────────────────
pattern AuditLog(action: String, dept: String, details: String) -> String {
  // №312: литеральный SQL + параметры (была конкатенация — SQL-инъекция;
  // escape_json сохранён для идентичности формата хранения)
  db_execute("INSERT INTO audit_log (action, actor, dept, details, status) VALUES (?, 'system', ?, ?, 'ok')", [escape_json(action), escape_json(dept), escape_json(details)])
  return "ok"
}

// ── Trace Log (FO-007: отладочные чекпоинты, не действия) ────────────
// Чекпоинты Yana/webhook пишутся сюда, чтобы audit_log оставался журналом действий.
pattern TraceLog(dept: String, details: String) -> String {
  db_execute("INSERT INTO trace_log (action, actor, dept, details, status) VALUES ('checkpoint', 'system', ?, ?, 'ok')", [dept, escape_json(details)])
  return "ok"
}

// ── FO-006: консолидированные факты (ночная консолидация, mem0-паттерн) ──
// Первичный источник долгосрочного контекста; dialog_history остаётся журналом.
// FO-020: declined (soft-delete) исключается; pending (невыверенное) — ниже
// одобренных (штраф веса в ранжировании выдачи).
pattern GetFacts(dept: String, limit: String) -> String {
  let rows = query("SELECT content, review_status FROM facts WHERE dept = ? AND status = 'active' AND (review_status IS NULL OR review_status != 'declined') ORDER BY (CASE WHEN review_status = 'pending' THEN 1 ELSE 0 END), updated_at DESC LIMIT ?", [dept, limit])
  if to_string(rows) == "()" or length(rows) == 0.0 then { return "" }
  let mut result = ""
  each row in rows {
    let content = redact(to_string(json_get(row, "content", "")), "all")
    let result = result + "- " + content + "\n"
  }
  return result
}

// ── Corrections retrieval ─────────────────────────────────────────────
pattern GetCorrections(dept: String) -> String {
  let rows = query("SELECT correction FROM adapt_corrections WHERE dept = ? ORDER BY created_at DESC LIMIT 5", [dept])
  return json_encode(rows)
}

// ── Recent dialog context ────────────────────────────────────────────
pattern GetRecentDialog(chat_id: String, limit: String, dept: String) -> String {
  let rows = query("SELECT role, content FROM dialog_history WHERE chat_id = ? AND dept = ? ORDER BY created_at DESC LIMIT ?", [chat_id, dept, limit])
  if to_string(rows) == "()" or length(rows) == 0.0 then { return "" }
  // Reverse to chronological order and format as readable dialog
  let mut result = ""
  let mut i = to_float(length(rows)) - 1.0
  while i >= 0.0 {
    let row = get(rows, i)
    let role = redact(to_string(json_get(row, "role", "")), "all")
    let content = redact(to_string(json_get(row, "content", "")), "all")
    if length(content) > 500.0 then { let content = substring(content, 0.0, 500.0) + "..." }
    let result = result + role + ": " + content + "\n"
    let i = i - 1.0
  }
  return result
}

// ── Strip HTML for archive (Telegram plain text, включая бейджи фактов) ──
pattern StripHtml(text: String) -> String {
  let clean = text
  // Replace HTML badges with text markers
  let clean = replace(clean, "<span class=\"badge badge-fact\">ФАКТ</span>", "[ФАКТ]")
  let clean = replace(clean, "<span class=\"badge badge-fact\">FACT</span>", "[FACT]")
  let clean = replace(clean, "<span class=\"badge badge-verified\">FACT verified</span>", "[FACT verified]")
  let clean = replace(clean, "<span class=\"badge badge-verified\">ФАКТ ✓verified</span>", "[ФАКТ verified]")
  let clean = replace(clean, "<span class=\"badge badge-unverified\">FACT unverified</span>", "[FACT unverified]")
  let clean = replace(clean, "<span class=\"badge badge-unverified\">ФАКТ ⚠unverified</span>", "[ФАКТ unverified]")
  let clean = replace(clean, "<span class=\"badge badge-conflicting\">CONFLICT</span>", "[КОНФЛИКТ]")
  let clean = replace(clean, "<span class=\"badge badge-conflicting\">КОНФЛИКТ</span>", "[КОНФЛИКТ]")
  let clean = replace(clean, "<span class=\"badge badge-interp\">ИНТЕРПРЕТАЦИЯ</span>", "[ИНТЕРПРЕТАЦИЯ]")
  let clean = replace(clean, "<span class=\"badge badge-interp\">INTERPRETATION</span>", "[ИНТЕРПРЕТАЦИЯ]")
  let clean = replace(clean, "<span class=\"badge badge-spec\">СПЕКУЛЯЦИЯ</span>", "[СПЕКУЛЯЦИЯ]")
  let clean = replace(clean, "<span class=\"badge badge-spec\">SPEC</span>", "[СПЕКУЛЯЦИЯ]")
  // Remove remaining HTML tags
  let clean = replace(clean, "<h2>", "\n\n** ")
  let clean = replace(clean, "</h2>", " **\n")
  let clean = replace(clean, "<h3>", "\n* ")
  let clean = replace(clean, "</h3>", " *\n")
  let clean = replace(clean, "<p>", "")
  let clean = replace(clean, "</p>", "\n")
  let clean = replace(clean, "<li>", "- ")
  let clean = replace(clean, "</li>", "\n")
  let clean = replace(clean, "<br>", "\n")
  let clean = replace(clean, "<br/>", "\n")
  let clean = replace(clean, "<hr>", "\n---\n")
  let clean = replace(clean, "<hr/>", "\n---\n")
  let clean = replace(clean, "<div class=\"verdict\">", "\n[VERDICT]\n")
  let clean = replace(clean, "<div class=\"disclaimer\">", "\n[DISCLAIMER]\n")
  let clean = replace(clean, "<div", "")
  let clean = replace(clean, "</div>", "")
  let clean = replace(clean, "<b>", "")
  let clean = replace(clean, "</b>", "")
  let clean = replace(clean, "<strong>", "")
  let clean = replace(clean, "</strong>", "")
  let clean = replace(clean, "<em>", "")
  let clean = replace(clean, "</em>", "")
  let clean = replace(clean, "<i>", "")
  let clean = replace(clean, "</i>", "")
  let clean = replace(clean, "<span", "")
  let clean = replace(clean, "</span>", "")
  let clean = replace(clean, "<a ", "")
  let clean = replace(clean, "</a>", "")
  let clean = replace(clean, "<table>", "")
  let clean = replace(clean, "</table>", "")
  let clean = replace(clean, "<tr>", "\n")
  let clean = replace(clean, "</tr>", "")
  let clean = replace(clean, "<td>", " ")
  let clean = replace(clean, "</td>", " ")
  let clean = replace(clean, "<th>", " ")
  let clean = replace(clean, "</th>", " ")
  // Clean up leftover attribute fragments
  let clean = replace(clean, "class=\"", "")
  let clean = replace(clean, "style=\"", "")
  return clean
}

// ── Department hashtags for archive channel ─────────────────────────
pattern DeptHashtags(dept: String) -> String {
  if dept == "osp" then { return "#OSP #analytics #strategy" }
  if dept == "lz" then { return "#LZ #technology #research #политика #экономика #события" }
  if dept == "expert" then { return "#Expert #briefing" }
  if dept == "marketing" then { return "#Marketing #audience" }
  if dept == "finance" then { return "#Finance #cashflow" }
  if dept == "legal" then { return "#Legal #contracts" }
  if dept == "dev" then { return "#Dev #code #architecture" }
  if dept == "design" then { return "#Design #UX" }
  if dept == "qa" then { return "#QA #testing" }
  if dept == "visual" then { return "#Visual #infographic" }
  if dept == "engineering" then { return "#Engineering #calculations" }
  if dept == "kavalnya" then { return "#Kavalnya #methodology" }
  if dept == "yana" then { return "#Yana #cabinet" }
  if dept == "admin" then { return "#Admin #system" }
  return "#FosvedOffice"
}

// ── Department display name (extended) ─────────────────────────────
pattern DeptDisplayName(dept: String) -> String {
  if dept == "yana" then { return "Yana — Shef de kabinet" }
  if dept == "osp" then { return "ОСП · Стратегическое планирование" }
  if dept == "lz" then { return "ЛЗ · Лаборатория знаний" }
  if dept == "expert" then { return "Эксперт · Подготовка к встрече" }
  if dept == "marketing" then { return "Marketing" }
  if dept == "finance" then { return "Finance" }
  if dept == "legal" then { return "Legal" }
  if dept == "dev" then { return "Dev" }
  if dept == "design" then { return "Design" }
  if dept == "qa" then { return "QA" }
  if dept == "visual" then { return "Visual" }
  if dept == "engineering" then { return "Engineering" }
  if dept == "kavalnya" then { return "Kavalnya" }
  if dept == "admin" then { return "Admin" }
  return dept
}

// ── Publish to archive channel (MIGRATED from Python /archive/publish) ──
// Native mlog: StripHtml → build compact record → Telegram send → channel_archive
pattern PublishToArchive(doc_id: String, dept: String, title: String, content: String) -> String {
  let channel_id = ArchiveChannelId()
  if channel_id == "" then { return "" }

  // 1. Strip HTML for plain text
  let plain = StripHtml(content)

  // 2. Build summary (first 200 chars, collapse whitespace)
  let summary = substring(plain, 0.0, 200.0)

  // 3. Build compact archive record
  let day = substring(to_string(now()), 0.0, 10.0)
  let hashtags = DeptHashtags(dept)
  let render_url = RenderUrl()
  let mut link = ""
  if doc_id != "" and render_url != "" then {
    let link = render_url + "/miniapp/" + doc_id
  }

  let mut record = day + " | " + dept
  if title != "" then {
    let record = record + "\n" + substring(title, 0.0, 150.0)
  }
  if summary != "" then {
    let record = record + "\n\n" + summary
  }
  if link != "" then {
    let record = record + "\n\nОткрыть: " + link
  }
  if hashtags != "" then {
    let record = record + "\n\n" + hashtags
  }
  // Cap at 1024 chars (Telegram limit is 4096 but we keep compact)
  let record = substring(record, 0.0, 1024.0)

  // 4. Send to archive channel via Telegram
  let token = TgToken()
  let body = json_encode({chat_id: to_float(channel_id), text: record})
  let result = TryVal(try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json"))
  let mut msg_id = ""
  if to_string(result) != "()" then {
    let parsed = parse_json(result)
    let ok = redact(to_string(json_get(parsed, "ok", "")), "all")
    if ok == "true" then {
      let result_msg = redact(to_string(json_get(parsed, "result", "")), "all")
      let msg_id = redact(to_string(TryVal(try json_get(result_msg, "message_id", ""))), "all")
    }
  }

  // 5. Save to channel_archive table
  db_execute("INSERT INTO channel_archive (doc_id, dept, title, channel_message_id, archived_at) VALUES (?1, ?2, ?3, ?4, datetime('now'))", [doc_id, dept, title, msg_id])

  let _ = AuditLog("archive_publish", dept, "doc: " + doc_id + " msg_id: " + msg_id)
  return msg_id
}



// ── Learning: record positive example (MIGRATED from Python /learning/good) ──
pattern RecordPositiveExample(dept: String, query: String, response: String) -> String {
  db_execute("INSERT INTO adapt_corrections (dept, original_query, correction, corr_type) VALUES (?1, ?2, ?3, 'positive')", [dept, substring(query, 0.0, 2000.0), substring(response, 0.0, 2000.0)])
  let _ = AuditLog("positive_example", dept, "recorded positive")
  return json_encode({status: "ok"})
}

// ── Learning: get stats (MIGRATED from Python /learning/stats) ──────────
pattern GetLearningStats() -> String {
  // Corrections count (7d, non-positive)
  let corr_rows = query("SELECT COUNT(*) as c FROM adapt_corrections WHERE created_at >= datetime('now', '-7 days') AND corr_type != 'positive'", [])
  let corrections_7d = redact(to_string(TryVal(try json_get(corr_rows[0], "c", "0"))), "all")

  // Positive examples total
  let pos_rows = query("SELECT COUNT(*) as c FROM adapt_corrections WHERE corr_type = 'positive'", [])
  let positive_total = redact(to_string(TryVal(try json_get(pos_rows[0], "c", "0"))), "all")

  // Error pattern breakdown
  let pattern_rows = query("SELECT error_type, COUNT(*) as c FROM error_patterns GROUP BY error_type ORDER BY c DESC", [])

  // Per-dept corrections (7d)
  let dept_rows = query("SELECT dept, COUNT(*) as c FROM adapt_corrections WHERE created_at >= datetime('now', '-7 days') AND corr_type != 'positive' GROUP BY dept ORDER BY c DESC", [])

  return json_encode({
    corrections_7d: corrections_7d,
    positive_total: positive_total,
    error_patterns: pattern_rows,
    dept_corrections: dept_rows
  })
}

// ── Learning: debrief department (MIGRATED from Python /learning/debrief) ──
// Native mlog: collect corrections + call_llm for debrief generation
pattern DebriefDepartment(dept: String) -> String {
  // Collect corrections for the department (last 30 days)
  let corr_rows = query("SELECT original_query, correction, created_at FROM adapt_corrections WHERE dept = ? AND created_at > datetime('now', '-30 days') ORDER BY created_at DESC LIMIT 50", [dept])
  let corrections_data = json_encode(corr_rows)

  // Generate debrief via LLM
  let dept_prompt = redact(read_file("library/" + dept + ".md"), "all")
  let debrief_prompt = dept_prompt + "\n\nGenerate a debrief for the " + dept + " department based on the last 30 days of corrections. Identify patterns, recurring errors, and suggest improvements. Language: Russian."
  let llm_result = redact(to_string(TryVal(try call_llm(debrief_prompt, "Коррекции за 30 дней:\n" + corrections_data))), "all")
  if to_string(llm_result) == "()" then { return "Debrief unavailable (LLM error)." }
  let reply = redact(to_string(json_get(parse_json(llm_result), "content", "")), "all")

  // Save debrief
  db_execute("INSERT INTO debriefs (dept, period, content) VALUES (?1, '30d', ?2)", [dept, reply])
  let _ = AuditLog("debrief", dept, "dept debrief completed")
  return reply
}

// ── Search archive (MIGRATED from Python /search) ───────────────────
// Native mlog: direct SQL LIKE query — identical to Python implementation
pattern SearchArchive(query_text: String) -> String {
  let search_term = "%" + query_text + "%"
  let rows = query("SELECT id, dept, title, created_at FROM miniapp_responses WHERE (raw_text LIKE ?1 OR title LIKE ?1) ORDER BY id DESC LIMIT 50", [search_term])
  let mem_rows = query("SELECT id, 'yana' as dept, event_text as title, created_at FROM yana_events WHERE event_text LIKE ?1 ORDER BY id DESC LIMIT 50", [search_term])
  let count = length(rows) + length(mem_rows)
  return json_encode({status: "ok", results: rows, memories: mem_rows, count: count})
}

// ── TTS helper — send voice reply if voice is enabled ───────────────
// Max 1000 chars for TTS. Longer text is truncated with a note.
pattern SendVoiceReply(chat_id: String, text: String, dept: String) -> String {
  let voice_on = kv_get("voice_enabled")
  if voice_on != "true" then { return "" }
  if length(text) < 5.0 then { return "" }
  let mut tts_text = ""
  if dept != "yana" and dept != "admin" and length(text) > 1000.0 then {
    let tts_text = substring(text, 0.0, 500.0) + "... Продолжение в текстовом отчёте."
  }
  if tts_text == "" then {
    let tts_text = text
  }
  let voice_name = kv_get("tts_voice")
  if length(voice_name) < 3.0 then { let voice_name = "ru-RU-DmitryNeural" }
  let tts_body = json_encode({text: tts_text, voice: voice_name, chat_id: chat_id})
  let _ = TryVal(try http_post("http://127.0.0.1:4000/tts", tts_body, "application/json"))
  let _ = AuditLog("tts_reply", dept, "len=" + to_string(length(tts_text)) + " orig_len=" + to_string(length(text)))
  return "ok"
}

// ── Simplified MarkdownV2 escaping ───────────────────────────────
// Упрощённое MarkdownV2-экранирование. НЕ различает код-спаны (`text`) —
// весь текст экранируется одинаково, включая содержимое обратных кавычек.
// Полный порт Python _escape_mdv2 (code-span/emoji-aware regex) не сделан:
// язык не имеет regex-builtin. См. наряд "webhook Python -> mlog", Блок A.
pattern EscapeMarkdownV2Simple(text: String) -> String {
  let t = replace(text, "\\", "\\\\")
  let t = replace(t, "_", "\\_")
  let t = replace(t, "*", "\\*")
  let t = replace(t, "[", "\\[")
  let t = replace(t, "]", "\\]")
  let t = replace(t, "(", "\\(")
  let t = replace(t, ")", "\\)")
  let t = replace(t, "~", "\\~")
  let t = replace(t, "`", "\\`")
  let t = replace(t, ">", "\\>")
  let t = replace(t, "#", "\\#")
  let t = replace(t, "+", "\\+")
  let t = replace(t, "-", "\\-")
  let t = replace(t, "=", "\\=")
  let t = replace(t, "|", "\\|")
  let t = replace(t, "{", "\\{")
  let t = replace(t, "}", "\\}")
  let t = replace(t, ".", "\\.")
  let t = replace(t, "!", "\\!")
  return t
}

// ── MCP: markets (FO-XXX, коннекторы) ──────────────────────────────
// Общий, параметризованный по dept вызов — в отличие от McpGithubCall/
// McpFsCall в dept/dev.mlog (жёстко 'dev', написаны раньше, до того как
// понадобилось больше одного отдела). Тот же защитный паттерн: audit
// до/после, проверка parse_json, redact() на выход сервера (вывод MCP —
// недоверенные данные, taint UserInput, №268 Metalogos).
pattern McpMarketsServerCmd() -> String {
  return "mcp_servers/markets"
}

pattern McpAuditFor(dept: String, server: String, tool: String, purpose: String, status: String) -> String {
  let _ = db_execute("INSERT INTO audit_log (action, actor, dept, details, status) VALUES ('mcp_call', ?, ?, ?, ?)", [dept, dept, "server=" + server + " tool=" + tool + " purpose=" + purpose, status])
  return "ok"
}

pattern McpMarketsCall(dept: String, tool: String, args_json: String, purpose: String) -> Dict {
  let _ = McpAuditFor(dept, "markets", tool, purpose, "attempt")
  let out = TryVal(try mcp_call(McpMarketsServerCmd(), [], tool, args_json))
  if redact(to_string(out), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAuditFor(dept, "markets", tool, purpose, "error")
    return { ok: false, body: "", note: "MCP-сервер markets недоступен (гейт ядра/сбой/таймаут). Fallback: сообщить, что данные сейчас недоступны, не выдумывать цифры." }
  }
  let parsed = TryVal(try parse_json(to_string(out)))
  if redact(to_string(parsed), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAuditFor(dept, "markets", tool, purpose, "error")
    return { ok: false, body: redact(to_string(out), "secrets"), note: "ответ сервера не JSON" }
  }
  if redact(to_string(json_get(parsed, "ok", "false")), "hash_only") == redact("true", "hash_only") then {
    let _ = McpAuditFor(dept, "markets", tool, purpose, "ok")
    return { ok: true, body: redact(to_string(out), "secrets"), note: "" }
  }
  let _ = McpAuditFor(dept, "markets", tool, purpose, "refused")
  let errmsg = redact(to_string(json_get(parsed, "error", "(без деталей)")), "all")
  return { ok: false, body: redact(errmsg, "secrets"), note: "сервер сообщил об отказе" }
}

// ── №419-миграция (0.21 audit): единый шов чтения TG-токена ──────────
// env() для токена читается ТОЛЬКО здесь; вызывающие получают результат
// вызова паттерна (шов аудита: label-трекинг не идёт сквозь вызов —
// probe-проверено 0.21). Рантайм-поведение не меняется.
// ── №422: семантика try в 0.21 ──────────────────────────────────────────
// 0.21 оборачивает результат try в TryResult-структуру даже на успехе
// (0.19 был прозрачен: успех = значение, неуспех = Unit/"()").
// TryVal достаёт .value и восстанавливает контракт 0.19 для ~570
// try-сайтов офиса: успех = само значение, неуспех = Unit → to_string "()" 
// (существующие проверки `to_string(x) == "()"` работают как раньше).
pattern TryVal(x: String) -> String {
  return x.value
}

pattern TgToken() -> String {
  return env("TELEGRAM_BOT_TOKEN")
}

// №312: шов для env-чтений в dept-файлах — аудитор интра-процедурен,
// вызов импортируемого хелпера не несёт env-taint в sink вызова
// (прецедент: TgToken, №421). Тела — голый env, без sink'ов.
pattern TavilyKey() -> String {
  return env("TAVILY_API_KEY")
}

// #467: ключ Alpha Vantage для рыночных данных ОСП (get_forex_rate /
// get_stock_quote markets-MCP). Шов тот же, что TavilyKey: env читается
// только здесь; крипта CoinGecko ключа не требует.
pattern AvKey() -> String {
  return env("ALPHAVANTAGE_API_KEY")
}

// office#354: единый транспорт живого веб-поиска. Один путь к Tavily —
// прямой http_post api.tavily.com (рабочий образец — ЛЗ, lz.mlog:569).
// Наряд запретил второй путь через внутренний Flask-прокси на :4000 —
// такого роута никогда не существовало, OSP/Эксперт из-за него не видели
// живых данных.
// Возвращает СЫРОЙ ответ Tavily (JSON-строку) или "()" при недоступности
// сети/ключа — вызывающий сам решает, как честно деградировать.
pattern TavilySearch(query: String, dept: String) -> String {
  let response = TryVal(try http_post("https://api.tavily.com/search", json_encode({api_key: TavilyKey(), query: query, search_depth: "advanced", max_results: 5}), "application/json"))
  return to_string(response)
}

// office#354: форматирование сырого ответа Tavily в читаемый блок с URL
// (Эксперт кладёт в «Live Search (двухфазный)», ОСП — в ответ /osp tavily).
// Недоверенные внешние данные — через redact по полям (урок №268).
// Пустая строка = ответ не распарсился (вызывающий деградирует честно).
pattern TavilyFormatBlock(response: String) -> String {
  if response == "()" or response == "" then { return "" }
  let parsed = TryVal(try parse_json(response))
  if to_string(parsed) == "()" then { return "" }
  let results = json_get(parsed, "results")
  if to_string(results) == "()" then { return "" }
  let count = length(results)
  let mut out = ""
  let mut i = 0.0
  while i < count and i < 5.0 {
    let r = get(results, i)
    let title = redact(to_string(json_get(r, "title", "")), "all")
    let url = redact(to_string(json_get(r, "url", "")), "all")
    let content = redact(to_string(json_get(r, "content", "")), "all")
    if url != "" then {
      let out = out + "\n• " + title + "\n  " + url + "\n  " + content + "\n"
    }
    let i = i + 1.0
  }
  return out
}

// №312: швы для PublishToArchive — env-чтения вне тела с sink'ом
// (интрафайловый шов легален: TgToken в этом же файле не тейнтит arg0)
pattern ArchiveChannelId() -> String {
  return env("TELEGRAM_ARCHIVE_CHANNEL_ID")
}

pattern RenderUrl() -> String {
  return env("RENDER_URL")
}

pattern OwnerTelegramId() -> String {
  return env("OWNER_TELEGRAM_ID")
}
