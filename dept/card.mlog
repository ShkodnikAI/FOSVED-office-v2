  assert_eq(to_string(json_get(get(rows, 0.0), "status", "?")), "gated")
  assert_contains(to_string(json_get(get(rows, 0.0), "gate_report", "?")), "B1 дневной бюджет osp исчерпан")
}

test "грант: разрушающая уборка только с grant_issue" {
  let _ = db_execute("UPDATE dept_archive SET status = 'expired', resolved_at = datetime('now', '-200 days') WHERE topic = 'Прогноз охвата кампании #0'", [])
  let r = CardPurgeExpired(60.0)
  assert_contains(r, "OK|facts=")
  assert_contains(r, "|cards=1")
  let left = query("SELECT COUNT(*) AS n FROM dept_archive WHERE topic = 'Прогноз охвата кампании #0'", [])
  assert_eq(to_float(to_string(json_get(get(left, 0.0), "n", "1"))), 0.0)
}

// ══════════════════════════════════════════════════════════════════════════
// ТЕСТЫ v2 — добавлены портом по D1 (7 новых; всего 30)
// ══════════════════════════════════════════════════════════════════════════

test "D1: ноль новых таблиц, 17 аддитивных колонок, миграция идемпотентна" {
  let m1 = CardMigrate()
  assert_contains(m1, "tables=0|cols=20|new=17")
  assert_contains(m1, "failed=0")
  let m2 = CardMigrate()
  assert_eq(m2, "OK|tables=0|cols=20|new=17|added=0|failed=0")
  // таблицы v1 в БД нет — контракт живёт в таблицах прода
  let gone = query("SELECT COUNT(*) AS n FROM sqlite_master WHERE type = 'table' AND name IN ('dept_card','dept_card_fact','dept_answer_log')", [])
  assert_eq(to_float(to_string(json_get(get(gone, 0.0), "n", "1"))), 0.0)
  // колонки действительно существуют (а не «кажется, что ALTER прошёл»)
  assert_eq(CardColumnExists("dept_archive", "card_kind"), true)
  assert_eq(CardColumnExists("dept_archive", "contour"), true)
  assert_eq(CardColumnExists("dept_verification", "error_value"), true)
  assert_eq(CardColumnExists("dept_verification", "verified_by"), true)
}

test "D1: legacy /verify идёт через автомат, статуса 'verified' не появляется" {
  let r = CardSave("dispatch", "number", "Выручка январь 2027 (legacy-шов)", "210000 BYN",
    "{\"value\":210000,\"horizon_days\":30}", "2027-02-28", "stated", "yana:delegate:finance", "no", "", "{}", 0.0)
  assert_contains(r, "OK|")
  let id = to_float(get(split(r, "|"), 1.0))
  let v = CardVerifyDispatch("dispatch", id, "actual=200000")
  assert_contains(v, "OK|error=5%")   // to_string(5.0) = "5" — без хвоста ".0"
  let rows = query("SELECT status FROM dept_archive WHERE id = ?", [to_string(id)])
  assert_eq(to_string(json_get(get(rows, 0.0), "status", "?")), "resolved")
  // статус 'verified' (app.mlog:1224) не появляется — писатель статусов один
  assert_eq(CardLegacyCounters("dispatch"), "verified=0|drafted=0")
  // свободный текст основанием не является (D6/D8)
  assert_contains(CardVerifyDispatch("dispatch", id, "вроде совпало"), "NO|/verify требует программного основания")
  // чужой вид исхода отвергается формой, а не мнением
  assert_contains(CardVerifyDispatch("dispatch", id, "outcome=clean"), "NO|вид карточки")
}

test "D2/инвариант 5: контур bench не смешивается с метриками владельца" {
  let own = CardSaveContour("ospbench", "number", "Владелец: курс на конец квартала", "2.9",
    "{\"value\":2.9,\"horizon_days\":60}", "2027-01-31", "stated", "osp", "no", "", "{}", 0.0, "owner")
  assert_contains(own, "OK|")
  let ben = CardSaveContour("ospbench", "number", "Bench: вопрос раунда 2026-12 h3", "0.62",
    "{\"value\":0.62,\"horizon_days\":90}", "2027-03-01", "stated", "forecastbench", "no", "", "{}", 0.0, "bench")
  assert_contains(ben, "OK|")
  // метрика отдела считает ТОЛЬКО контур владельца (1 карточка, а не 2)
  let s = CardScore("ospbench", "number", 1.0)
  assert_contains(s, "не хватает данных: разрешено 0 из нужных 1 (всего карточек 1)")
  // контур неизменяем: переход статуса его не трогает
  let bid = to_float(get(split(ben, "|"), 1.0))
  let _ = CardTransition(bid, "watching", "вахта по горизонту", "osp")
  let rows = query("SELECT contour FROM dept_archive WHERE id = ?", [to_string(bid)])
  assert_eq(to_string(json_get(get(rows, 0.0), "contour", "?")), "bench")
  // неизвестный контур отвергается до записи
  assert_contains(CardSaveContour("ospbench", "number", "Контур вне списка", "0.5", "{\"value\":0.5}", "2027-01-31", "stated", "osp", "no", "", "{}", 0.0, "market"), "NO|неизвестный контур")
}

test "D2: кардинальность bench — 150 вопросов × 5 горизонтов" {
  // принятая политика (D2 + поправка 3 владельца): bench живёт в деталях ОСП,
  // общий стол отдела не засоряется 750 строками на раунд
  assert_eq(CardBenchCards(150.0, 5.0, "details"), "cards=0|details=750")
  assert_eq(CardBenchCards(100.0, 5.0, "details"), "cards=0|details=500")
  // отвергнутая альтернатива: карточка на каждый (вопрос, горизонт)
  assert_eq(CardBenchCards(150.0, 5.0, "cards"), "cards=750|details=750")
  assert_contains(CardBenchCards(150.0, 5.0, "unknown"), "NO|неизвестная политика")
  // фактически: в общем столе нет ни одной bench-карточки
  let n = query("SELECT COUNT(*) AS n FROM dept_archive WHERE contour = 'bench' AND dept = 'ospbench2'", [])
  assert_eq(to_float(to_string(json_get(get(n, 0.0), "n", "1"))), 0.0)
}

test "D1: сирота невозможна — FK отвергает факт без карточки; брак полей виден" {
  assert_contains(CardAuditOrphans(), "orphans=0")
  // FOREIGN KEY(archive_id) REFERENCES dept_archive(id) (app.mlog:287) —
  // факт без карточки не вставляется вовсе: гарантия на уровне БД, не проверки
  let bad = TryVal(try db_execute("INSERT INTO dept_verification (archive_id, actual_outcome, error_diagnosis) VALUES (987654, 'orphan', 'проба: факт без карточки')", []))
  assert_eq(to_string(bad), "()")
  assert_contains(CardAuditOrphans(), "orphans=0")
  // второй класс брака — карточка без структурного утверждения: находится программно
  let before = CardEmptyClaims()
  let _ = db_execute("INSERT INTO dept_archive (dept, topic, card_kind, status) VALUES ('orphanaudit', 'Карточка без claim_json', 'number', 'drafted')", [])
  assert_eq(CardEmptyClaims(), before + 1.0)
  // карточка без контура — тоже брак, виден программно (B3 #640: колонки без
  // DEFAULT — DEFAULT 'owner' молча маскировал бы такой брак под «норму»)
  let nc = query("SELECT COUNT(*) AS n FROM dept_archive WHERE card_kind IS NOT NULL AND (contour IS NULL OR contour = '')", [])
  assert_eq(to_float(to_string(json_get(get(nc, 0.0), "n", "0"))) >= 1.0, true)
}

test "D1: ScoreDept без правки не видит карточных статусов — нужен CardScoreBlock" {
  let r = CardSave("scoreblk", "flag", "Юристы: договор поставки №17", "clean",
    "{\"allowed\":\"clean|rewrite_required\",\"predicted\":\"clean\"}", "2027-01-31", "stated", "yana:delegate:legal", "no", "", "{}", 0.0)
  let id = to_float(get(split(r, "|"), 1.0))
  let _ = CardVerifyFlag(id, "clean", "owner", "сверка для блока оценки")
  // legacy-счётчики ScoreDept (app.mlog:1307-1308) пусты: 'verified'/'drafted' нет
  assert_eq(CardLegacyCounters("scoreblk"), "verified=0|drafted=0")
  // блок карточки показывает реальное состояние
  let b = CardScoreBlock("scoreblk")
  assert_contains(b, "Карточки (контур владельца): 1")
  assert_contains(b, "Разрешено: 1")
  assert_contains(b, "покрытие scoreblk:")
}

test "D1: журнал ответов — существующая dialog_history, новых таблиц нет" {
  let _ = CardLogBareAnswer("covprobe", "справка без утверждения")
  let _ = CardLogBareAnswer("covprobe", "консультация без утверждения")
  let r = CardSave("covprobe", "number", "Охват кампании, декабрь 2026", "12000",
    "{\"value\":12000,\"horizon_days\":30}", "2027-01-15", "stated", "marketing", "no", "", "{}", 0.0)
  assert_contains(r, "OK|")
  let cov = CardCoverage("covprobe")
  assert_contains(cov, "1/3 ответов стали карточками")
  // маркеры лежат в той таблице, куда уже пишет шов (app.mlog:592-599)
  let rows = query("SELECT COUNT(*) AS n FROM dialog_history WHERE dept = 'covprobe' AND role = 'assistant'", [])
  assert_eq(to_float(to_string(json_get(get(rows, 0.0), "n", "0"))), 3.0)
  assert_contains(CardCoverage("nodata"), "не хватает данных")
}

test "D1: legacy ComputeFinanceMAPE (app.mlog:1259) оживает на карточках" {
  let mut i = 0.0
  while i < 10.0 {
    let r = CardSave("mapeprobe", "number", "Прогноз выручки №" + to_string(i) + " (MAPE-проба)",
      "100000 BYN", "{\"value\":100000,\"horizon_days\":30}", "2027-01-31", "stated", "finance", "no", "", "{}", 0.0)
    let id = to_float(get(split(r, "|"), 1.0))
    let _ = CardVerifyNumber(id, 95000.0, "owner", "проба MAPE")
    i = i + 1.0
  }
  // запрос байт в байт как в проде (app.mlog:1260), только отдел параметром
  let rows = query("SELECT a.forecast_value, v.actual_value FROM dept_archive a JOIN dept_verification v ON v.archive_id = a.id WHERE a.dept = ? AND a.forecast_value IS NOT NULL AND v.actual_value IS NOT NULL", ["mapeprobe"])
  assert_eq(length(rows), 10.0)
  let f = to_float(to_string(json_get(get(rows, 0.0), "forecast_value", "0")))
  let a = to_float(to_string(json_get(get(rows, 0.0), "actual_value", "0")))
  assert_eq(abs(f - 100000.0) < 0.001, true)
  assert_eq(abs(a - 95000.0) < 0.001, true)
  // знаменатель MAPE: ошибка считается по строкам с фактом, а не «по всем подряд»
  assert_eq(abs(CardErrorPct(f, a) - 5.263157) < 0.001, true)
}

test "v2-самопроверка: невычислимая пара (факт = 0) не уходит в знаменатель MAPE" {
  let r = CardSave("zeroactual", "number", "Прогноз с нулевым фактом (самопроверка)", "5000 BYN",
    "{\"value\":5000,\"horizon_days\":30}", "2027-01-31", "stated", "finance", "no", "", "{}", 0.0)
  let id = to_float(get(split(r, "|"), 1.0))
  let v = CardVerifyNumber(id, 0.0, "owner", "факт оказался нулевым")
  assert_contains(v, "uncomputable")
  let r2 = CardSave("zeroactual", "number", "Прогноз с нормальным фактом (самопроверка)", "5000 BYN",
    "{\"value\":5000,\"horizon_days\":30}", "2027-01-31", "stated", "finance", "no", "", "{}", 0.0)
  let id2 = to_float(get(split(r2, "|"), 1.0))
  let _ = CardVerifyNumber(id2, 4750.0, "owner", "обычная сверка")
  let s = CardScore("zeroactual", "number", 1.0)
  print("zeroactual: " + s)
  // MAPE считается по ОДНОЙ паре (5000→4750 = 5.26%), а не по двум с -1 внутри
  assert_contains(s, "MAPE=5.2631")
  assert_contains(s, "n=1")
  assert_contains(s, "вне расчёта (факт = 0): 1")
}

// ── n639: legacy-шов на проде. ComputeFinanceMAPE (app.mlog) читает пары
// карточек (forecast_value ← CardSave, actual_value ← CardVerifyNumber) и
// считает знаменатель ТОЛЬКО по строкам с ненулевым фактом: раньше n рос по
// всем строкам, а слагаемое при actual = 0 пропускалось — MAPE занижался
// (баг app.mlog:1264-1278). Функция жёстко читает dept='finance', поэтому
// тест сам засеивает 10 вычислимых пар и одну нулевую; ожидание n считается
// по фактическому содержимому до и после засева — порядок и наполнение
// других тестов не влияют.
test "n639: legacy ComputeFinanceMAPE — знаменатель только по ненулевому факту" {
  let mut n_zero = 0.0
  let rows0 = query("SELECT a.forecast_value, v.actual_value FROM dept_archive a JOIN dept_verification v ON v.archive_id = a.id WHERE a.dept = 'finance' AND a.forecast_value IS NOT NULL AND v.actual_value IS NOT NULL", [])
  each r in rows0 {
    let a = to_float(to_string(json_get(r, "actual_value", "0")))
    if a == 0.0 then { n_zero = n_zero + 1.0 }
  }
  let mut i = 0.0
  while i < 10.0 {
    let r = CardSave("finance", "number", "n639 пара выручки №" + to_string(i) + " (MAPE-знаменатель)",
      "100000 BYN", "{\"value\":100000,\"horizon_days\":30}", "2027-06-30", "stated", "n639", "no", "", "{}", 0.0)
    let id = to_float(get(split(r, "|"), 1.0))
    let _ = CardVerifyNumber(id, 95000.0, "owner", "проба знаменателя")
    i = i + 1.0
  }
  // нулевой факт: пара есть, слагаемое и знаменатель — нет
  let rz = CardSave("finance", "number", "n639 пара с нулевым фактом (MAPE-знаменатель)",
    "5000 BYN", "{\"value\":5000,\"horizon_days\":30}", "2027-06-30", "stated", "n639", "no", "", "{}", 0.0)
  let idz = to_float(get(split(rz, "|"), 1.0))
  let _ = CardVerifyNumber(idz, 0.0, "owner", "факт оказался нулевым")
  let rows1 = query("SELECT a.forecast_value, v.actual_value FROM dept_archive a JOIN dept_verification v ON v.archive_id = a.id WHERE a.dept = 'finance' AND a.forecast_value IS NOT NULL AND v.actual_value IS NOT NULL", [])
  each r in rows1 {
    let a = to_float(to_string(json_get(r, "actual_value", "0")))
    if a == 0.0 then { n_zero = n_zero + 1.0 }
  }
  let n_ok_all = to_float(to_string(length(rows1))) - n_zero
  // обе ситуации в данных: вычислимые пары (>=10 — порог функции) и нулевой факт
  assert_eq(n_ok_all >= 10.0, true)
  assert_eq(n_zero >= 1.0, true)
  let s = TryVal(try ComputeFinanceMAPE())
  assert_contains(s, "MAPE (калиброванная)")
  // n в ответе — число вычислимых пар; нулевой факт знаменатель не раздувает
  assert_contains(s, "(n=" + to_string(to_int(n_ok_all)) + ")")
}

// ══════════════════════════════════════════════════════════════════════════
// ТЕСТЫ n640 — шов (D4), kill-switch, бюджеты-предохранители, стандарт D9
// ══════════════════════════════════════════════════════════════════════════

test "n640: хвост извлекается и вырезается программой — валидный JSON" {
  let ans = "Прогноз готов.\n```card\n{\"kind\":\"number\",\"claim\":\"Выручка декабря 210000 BYN\",\"verify_by\":\"2026-12-31\",\"value\":210000}\n```"
  assert_contains(CardTailValidate(ans), "OK|")
  assert_eq(CardTailExtract(ans), "{\"kind\":\"number\",\"claim\":\"Выручка декабря 210000 BYN\",\"verify_by\":\"2026-12-31\",\"value\":210000}")
  let stripped = CardTailStrip(ans)
  assert_eq(stripped, "Прогноз готов.\n")
  assert_eq(contains(stripped, "```card"), false)
}

test "n640: битый JSON в хвосте — FAIL, а не BARE (FAIL ≠ BARE)" {
  let ans = "Прогноз готов.\n```card\n{\"kind\":\"number\",\"claim\":незакрытая строка}\n```"
  assert_contains(CardTailValidate(ans), "FAIL|json не разобран")
  // kind вне словаря и нет verify_by — FAIL по форме, с точным путём поля
  let ans2 = "Ответ.\n```card\n{\"kind\":\"horoscope\",\"claim\":\"всё будет хорошо\"}\n```"
  assert_contains(CardTailValidate(ans2), "FAIL|форма хвоста")
  // хвоста нет — BARE, и только BARE
  assert_eq(CardTailValidate("Справка: ставка 9.5%."), "BARE")
}

test "n640: kill-switch — нет ключа = off, off не пишет и не меняет ответ" {
  let _ = db_execute_with_grant(grant_issue("db:delete:system_settings", 60.0, "once"), "DELETE FROM system_settings WHERE key = 'card_seam_enabled'", [])
  let ans = "Ответ отдела.\n```card\n{\"kind\":\"flag\",\"claim\":\"оценка риска\",\"verify_by\":\"2026-12-31\",\"allowed\":\"clean\"}\n```"
  assert_eq(CardSeamVerdict("seamoff", ans, 0.0), "OFF")
  let n = query("SELECT COUNT(*) AS n FROM dept_archive WHERE dept = 'seamoff'", [])
  assert_eq(to_float(to_string(json_get(get(n, 0.0), "n", "1"))), 0.0)
  // ключ off — то же самое
  let _ = db_execute("INSERT INTO system_settings (key, value) VALUES ('card_seam_enabled', 'off')", [])
  assert_eq(CardSeamVerdict("seamoff", ans, 0.0), "OFF")
  let _ = db_execute_with_grant(grant_issue("db:delete:system_settings", 60.0, "once"), "DELETE FROM system_settings WHERE key = 'card_seam_enabled'", [])
}

test "n640: шов OK — валидный хвост становится карточкой, ответ без хвоста" {
  let _ = db_execute_with_grant(grant_issue("db:delete:system_settings", 60.0, "once"), "DELETE FROM system_settings WHERE key = 'card_seam_enabled'", [])
  let _ = db_execute("INSERT INTO system_settings (key, value) VALUES ('card_seam_enabled', 'on')", [])
  let ans = "Прогноз кассового разрыва готов.\n```card\n{\"kind\":\"number\",\"claim\":\"Кассовый разрыв декабрь 120000 BYN\",\"verify_by\":\"2026-12-31\",\"value\":120000}\n```"
  let v = CardSeamVerdict("seamok", ans, 0.0)
  assert_contains(v, "OK|")
  assert_contains(v, "|published")
  // карточка в столе — из строки БД, ответ владельцу без машиночитаемого хвоста
  let rows = query("SELECT id, card_kind, status, source FROM dept_archive WHERE dept = 'seamok'", [])
  assert_eq(length(rows), 1.0)
  assert_eq(to_string(json_get(get(rows, 0.0), "card_kind", "?")), "number")
  assert_eq(to_string(json_get(get(rows, 0.0), "source", "?")), "seam:seamok")
  assert_eq(contains(CardTailStrip(ans), "```card"), false)
  // журнал ответов: один card-маркер (покрытие 1/1)
  assert_contains(CardCoverage("seamok"), "1/1 ответов стали карточками")
  let _ = db_execute_with_grant(grant_issue("db:delete:system_settings", 60.0, "once"), "DELETE FROM system_settings WHERE key = 'card_seam_enabled'", [])
}

test "n640: шов FAIL — брак формы громко, карточки нет, маркер fail" {
  let _ = db_execute("INSERT INTO system_settings (key, value) VALUES ('card_seam_enabled', 'on')", [])
  let ans = "Прогноз готов.\n```card\n{\"kind\":\"number\",\"claim\":незакрытая строка}\n```"
  let v = CardSeamVerdict("seamfail", ans, 0.0)
  assert_contains(v, "FAIL|json не разобран")
  let rows = query("SELECT COUNT(*) AS n FROM dept_archive WHERE dept = 'seamfail'", [])
  assert_eq(to_float(to_string(json_get(get(rows, 0.0), "n", "1"))), 0.0)
  let marks = query("SELECT COUNT(*) AS n FROM dialog_history WHERE dept = 'seamfail' AND content LIKE 'fail|%'", [])
  assert_eq(to_float(to_string(json_get(get(marks, 0.0), "n", "0"))), 1.0)
  let _ = db_execute_with_grant(grant_issue("db:delete:system_settings", 60.0, "once"), "DELETE FROM system_settings WHERE key = 'card_seam_enabled'", [])
}

test "n640: шов BARE — консультация без утверждения, bare-маркер, ответ цел" {
  let _ = db_execute("INSERT INTO system_settings (key, value) VALUES ('card_seam_enabled', 'on')", [])
  let ans = "Справка: ставка рефинансирования 9.5%."
  assert_eq(CardSeamVerdict("seambare", ans, 0.0), "BARE")
  let marks = query("SELECT COUNT(*) AS n FROM dialog_history WHERE dept = 'seambare' AND content LIKE 'bare|%'", [])
  assert_eq(to_float(to_string(json_get(get(marks, 0.0), "n", "0"))), 1.0)
  let _ = db_execute_with_grant(grant_issue("db:delete:system_settings", 60.0, "once"), "DELETE FROM system_settings WHERE key = 'card_seam_enabled'", [])
}

test "n640: бюджеты-предохранители засеяны — 15 отделов, ОСП дороже прочих" {
  let _ = CardSeamEnabled()
  let n = query("SELECT COUNT(*) AS n FROM system_settings WHERE key LIKE 'daily_budget_%'", [])
  assert_eq(to_float(to_string(json_get(get(n, 0.0), "n", "0"))) >= 15.0, true)
  let yana = query("SELECT value FROM system_settings WHERE key = 'daily_budget_yana'", [])
  assert_eq(to_string(json_get(get(yana, 0.0), "value", "?")), "3.00")
  // идемпотентность: повторный CardSeedBudgets не плодит дублей
  let _ = CardSeedBudgets()
  let n2 = query("SELECT COUNT(*) AS n FROM system_settings WHERE key LIKE 'daily_budget_%'", [])
  assert_eq(to_string(json_get(get(n, 0.0), "n", "?")), to_string(json_get(get(n2, 0.0), "n", "?")))
}

test "n640: стандарт D9 — короткий ответ OK, длинный/сырой — WARN" {
  assert_eq(CardD9Check("Короткий вывод одним предложением."), "OK")
  assert_contains(CardD9Check("Строка 1\nСтрока 2\nСтрока 3\nСтрока 4"), "WARN: первый блок")
  assert_contains(CardD9Check("Точность 5.26315 процента"), "WARN: число с >2 знаками: 5.26315")
  assert_contains(CardD9Check("Показатели: 10 20 30 единиц"), "WARN: чисел ≥3 без таблицы")
  // таблица снимает предупреждение о числах
  assert_eq(CardD9Check("Вывод: см. таблицу.\n\n| a | b | c |\n|---|---|---|\n| 10 | 20 | 30 |"), "OK")
  // маркеры и доля: один ok, один warn → 50%
  let _ = CardD9Log("d9probe", "Короткий вывод одним предложением.")
  let _ = CardD9Log("d9probe", "Строка 1\nСтрока 2\nСтрока 3\nСтрока 4")
  assert_contains(CardD9Share("d9probe"), "в стандарте D9: 50% (n=2)")
}

test "n640: /score — старые строки без card_kind не попадают, карточный блок есть" {
  // старая запись (наряды и пр.) — без card_kind
  let _ = db_execute("INSERT INTO dept_archive (dept, topic, status) VALUES ('scoresdept', 'Старая запись без контракта', 'verified')", [])
  let r = CardSave("scoresdept", "flag", "Карточка для проверки скоринга", "clean", "{\"allowed\":\"clean\"}", "2027-01-31", "stated", "n640", "no", "", "{}", 0.0)
  assert_contains(r, "OK|")
  let s = TryVal(try ScoreDept("scoresdept"))
  assert_contains(s, "Всего карточек: 1")
  assert_contains(s, "Опубликовано: 1")
  assert_contains(s, "Карточки (контур владельца): 1")
  assert_contains(s, "покрытие scoresdept")
  assert_contains(s, "в стандарте D9: данных нет")
  // старой строки в счётчиках нет
  assert_eq(contains(s, "Всего карточек: 2"), false)
}
