// /qa-strategy — design test strategy
pattern CmdQAStrategy(query: String, chat_id: String) -> String {
  let ctx = BuildQAContext(query, chat_id)
  let parsed = parse_json(ctx)
  let testType = json_get(parsed, "testType", QA_TT_UNIT())

  // Extract project name from query
  let project = "project"
  if contains(lower(query), "проект ") then { let project = "detected" }

  let strategy = TestStrategyDesign(project, testType, query, chat_id)

  // Rule 2: Verify strategy has failure modes
  let r2 = EnforceRule2_FailureModesRequired(strategy, "detected_from_strategy")
  if r2 != "PASS" then {
    return r2 + "\n\nСтратегия должна содержать секцию failure modes."
  }

  let _ = AuditLog("cmd_qa_strategy", QA_DEPT(), "Test strategy designed for " + project + " / " + testType)
  return QA_DISCLAIMER_TOP() + "\n\n" + strategy + "\n\n" + QA_DISCLAIMER_BOTTOM()
}

// /qa-test — run test suite
pattern CmdQATest(query: String, chat_id: String) -> String {
  let ctx = BuildQAContext(query, chat_id)
  let parsed = parse_json(ctx)
  let testType = json_get(parsed, "testType", QA_TT_UNIT())
  let environment = redact(to_string(json_get(parsed, "environment", QA_ENV_STAGING())), "all")

  // Rule 8: No production testing
  let r8 = EnforceRule8_NoProdTesting(environment)
  if r8 != "PASS" then { return r8 }

  let project = "project"
  let runId = CreateTestRun(project, testType, environment, "manual", chat_id)

  let prompt = "Ты QA-параноик. Выполняешь " + testType + " тестирование.\n\n" +
    "ЖЁСТКИЕ ПРАВИЛА:\n" +
    "• Среда: staging только (production запрещён)\n" +
    "• Автоматизация обязательна\n" +
    "• Каждый дефект → создание defect record\n" +
    "• Coverage отчёт обязателен\n\n" +
    "Test Run #" + runId + "\n" +
    "Запрос: " + query + "\n\n" +
    "ВЫВОД: результаты тестирования, найденные дефекты, coverage отчёт, вердикт"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }

  let _ = AuditLog("cmd_qa_test", QA_DEPT(), "Test run #" + runId + " for " + testType)
  return QA_DISCLAIMER_TOP() + "\n\nTest Run #" + runId + " (" + testType + " / " + environment + ")\n\n" + result + "\n\n" + QA_DISCLAIMER_BOTTOM()
}

// /qa-defect — manage individual defect
pattern CmdQADefect(query: String, chat_id: String) -> String {
  let ctx = BuildQAContext(query, chat_id)
  let parsed = parse_json(ctx)
  let severity = redact(to_string(json_get(parsed, "severity", QA_SEV_MEDIUM())), "all")
  let environment = redact(to_string(json_get(parsed, "environment", QA_ENV_STAGING())), "all")

  let q = lower(query)

  // Detect action
  if contains(q, "создай")  or  contains(q, "create")  or  contains(q, "новый дефект")  or  contains(q, "новый баг") then {
    let project = "project"
    let summary = query
    let defectId = CreateDefect(project, severity, summary, "", environment, chat_id)
    return QA_DISCLAIMER_TOP() + "\n\nДефект #" + defectId + " создан [" + severity + "]\n\n" + QA_DISCLAIMER_BOTTOM()
  }

  if contains(q, "закрой")  or  contains(q, "close")  or  contains(q, "верифицируй")  or  contains(q, "verify") then {
    // Extract defect ID from query
    let defectId = "0"
    let result = TransitionDefect(defectId, QA_DF_VERIFIED(), "true", chat_id)
    return QA_DISCLAIMER_TOP() + "\n\n" + result + "\n\n" + QA_DISCLAIMER_BOTTOM()
  }

  // Default: show defect or LLM-assisted management
  let result = DefectDiscipline("project", query, chat_id)
  return QA_DISCLAIMER_TOP() + "\n\n" + result + "\n\n" + QA_DISCLAIMER_BOTTOM()
}

// /qa-defects — list defects
pattern CmdQADefects(query: String, chat_id: String) -> String {
  let q = lower(query)
  // №312: литеральный SQL + флаги-параметры (конкатенация = динамический SQL).
  // Попутно починен латентный баг: shadow-in-if не применял фильтры вообще.
  let mut f_open = "no"
  let mut f_critical = "no"
  if contains(q, "open")  or  contains(q, "открыт") then { f_open = "yes" }
  if contains(q, "critical")  or  contains(q, "критич") then { f_critical = "yes" }

  let rows = db_execute(
    "SELECT id, project, severity, summary, status, created_at FROM defect_records WHERE ((?1 = 'yes' AND status = 'open') OR ?1 = 'no') AND ((?2 = 'yes' AND severity = 'critical') OR ?2 = 'no') ORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 WHEN 'low' THEN 4 ELSE 5 END, created_at DESC LIMIT 20",
    [f_open, f_critical]
  )

  if length(rows) == 0 then {
    return "Дефекты не найдены."
  }

  let _ = AuditLog("cmd_qa_defects", QA_DEPT(), "Defects listed" + statusFilter)
  return QA_DISCLAIMER_TOP() + "\n\n" + rows + "\n\n" + QA_DISCLAIMER_BOTTOM()
}

// /qa-eval — run AI eval
pattern CmdQAEval(query: String, chat_id: String) -> String {
  let ctx = BuildQAContext(query, chat_id)
  let parsed = parse_json(ctx)
  let isAISystem = json_get(parsed, "isAISystem", "false")

  // If not explicitly AI, check
  if isAISystem != "true" then {
    let _ = AuditLog("qa_eval_warning", QA_DEPT(), "/qa-eval called for non-AI project — proceeding with eval")
  }

  let project = "project"
  let modelId = "default"
  let totalCases = QA_AI_MIN_CASES()

  let evalId = CreateAIEvalRun(project, modelId, totalCases, chat_id)

  let result = AIEvalsFramework(project, query, chat_id)

  let _ = AuditLog("cmd_qa_eval", QA_DEPT(), "AI eval #" + evalId + " started for " + project)
  return QA_DISCLAIMER_TOP() + "\n\nAI Eval Run #" + evalId + "\n\n" + result + "\n\nМинимум " + QA_AI_MIN_CASES() + " кейсов | Пороги: g≥0.85 r≥0.85 f≥0.90 c≥0.80 pi≥0.95 pass≥0.90\n\n" + QA_DISCLAIMER_BOTTOM()
}

// /qa-security-audit — run security audit
pattern CmdQASecurityAudit(query: String, chat_id: String) -> String {
  let q = lower(query)

  // Detect audit type
  let auditType = QA_SA_OWASP()
  if contains(q, "dependency")  or  contains(q, "зависимост") then { let auditType = QA_SA_DEPENDENCY() }
  if contains(q, "owasp") then { let auditType = QA_SA_OWASP() }
  if contains(q, "manual")  or  contains(q, "ручн") then { let auditType = QA_SA_MANUAL() }
  if contains(q, "penetration")  or  contains(q, "пентест") then { let auditType = QA_SA_PENETRATION() }
  if contains(q, "secrets")  or  contains(q, "секрет") then { let auditType = QA_SA_SECRETS() }

  let project = "project"
  let auditId = CreateSecurityAudit(project, auditType, chat_id)

  let result = SecurityTestingProtocol(project, "", query, chat_id)

  let _ = AuditLog("cmd_qa_security", QA_DEPT(), "Security audit #" + auditId + " (" + auditType + ") for " + project)
  return QA_DISCLAIMER_TOP() + "\n\nSecurity Audit #" + auditId + " (" + auditType + ")\n\n" + result + "\n\n" + QA_DISCLAIMER_BOTTOM()
}

// /qa-coverage — coverage report
pattern CmdQACoverage(query: String, chat_id: String) -> String {
  let project = "project"

  // Get latest test runs with coverage
  let rows = db_execute(
    "SELECT id, test_type, verdict, coverage_pct, total_tests, passed, failed, completed_at FROM test_runs WHERE project = ? AND status = 'completed' ORDER BY completed_at DESC LIMIT 10",
    [project]
  )

  // Get defect metrics
  let defectStats = db_execute(
    "SELECT severity, COUNT(*) as cnt FROM defect_records WHERE project = ? AND status NOT IN ('wontfix', 'duplicate', 'verified') GROUP BY severity ORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 WHEN 'low' THEN 4 ELSE 5 END",
    [project]
  )

  let prompt = "Ты QA-педант. Формируешь coverage отчёт.\n\n" +
    "ЦЕЛИ:\n" +
    "• Critical path: ≥" + QA_COV_CRITICAL_PATH() + "%\n" +
    "• Business logic: ≥" + QA_COV_BUSINESS_LOGIC() + "%\n" +
    "• Overall: ≥" + QA_COV_OVERALL() + "%\n" +
    "• Test pyramid: unit " + QA_PYRAMID_UNIT_PCT() + "% / integration " + QA_PYRAMID_INTEGRATION_PCT() + "% / e2e " + QA_PYRAMID_E2E_PCT() + "%\n\n" +
    "Test runs:\n" + rows + "\n\n" +
    "Active defects:\n" + defectStats + "\n\n" +
    "ВЫВОД: coverage отчёт с gap analysis, рекомендации по достижению целей"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }

  let _ = AuditLog("cmd_qa_coverage", QA_DEPT(), "Coverage report for " + project)
  return QA_DISCLAIMER_TOP() + "\n\n" + result + "\n\n" + QA_DISCLAIMER_BOTTOM()
}

// /qa-runs — list test runs
pattern CmdQARuns(query: String, chat_id: String) -> String {
  let project = "project"

  let rows = db_execute(
    "SELECT id, test_type, status, verdict, total_tests, passed, failed, coverage_pct, environment, started_at, completed_at FROM test_runs WHERE project = ? ORDER BY started_at DESC LIMIT 15",
    [project]
  )

  if length(rows) == 0 then {
    return "Test runs не найдены для проекта " + project + "."
  }

  let _ = AuditLog("cmd_qa_runs", QA_DEPT(), "Test runs listed for " + project)
  return QA_DISCLAIMER_TOP() + "\n\n" + rows + "\n\n" + QA_DISCLAIMER_BOTTOM()
}

// /qa-monitor — production monitoring dashboard
pattern CmdQAMonitor(query: String, chat_id: String) -> String {
  let project = "project"

  // Get recent defect metrics
  let openCritical = db_execute(
    "SELECT COUNT(*) as cnt FROM defect_records WHERE project = ? AND severity = 'critical' AND status NOT IN ('verified', 'wontfix', 'duplicate')",
    [project]
  )
  let openHigh = db_execute(
    "SELECT COUNT(*) as cnt FROM defect_records WHERE project = ? AND severity = 'high' AND status NOT IN ('verified', 'wontfix', 'duplicate')",
    [project]
  )
  let recentDefects = db_execute(
    "SELECT id, severity, summary, status, created_at FROM defect_records WHERE project = ? AND created_at > datetime('now') - INTERVAL '24 hours' ORDER BY created_at DESC LIMIT 10",
    [project]
  )
  let securityStatus = GetSecurityAuditStatus(project)
  let latestRuns = db_execute(
    "SELECT id, test_type, verdict, coverage_pct, completed_at FROM test_runs WHERE project = ? AND status = 'completed' ORDER BY completed_at DESC LIMIT 5",
    [project]
  )

  let prompt = "Ты QA-параноик. Формируешь production monitoring отчёт.\n\n" +
    "МЕТРИКИ:\n" +
    "• Defect escape rate ≤10%\n" +
    "• MTTD critical ≤1ч\n" +
    "• MTTR critical ≤4ч\n" +
    "• Security findings high+ = 0 в production\n" +
    "• AI eval pass rate ≥90%\n" +
    "• Accessibility = 100% WCAG AA\n\n" +
    "Open critical: " + openCritical + "\n" +
    "Open high: " + openHigh + "\n" +
    "Recent defects (24h): " + recentDefects + "\n" +
    "Security: " + securityStatus + "\n" +
    "Latest runs: " + latestRuns + "\n\n" +
    "ВЫВОД: monitoring dashboard, alerts, trend analysis, action items"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }

  let _ = AuditLog("cmd_qa_monitor", QA_DEPT(), "Production monitor for " + project)
  return QA_DISCLAIMER_TOP() + "\n\n" + result + "\n\n" + QA_DISCLAIMER_BOTTOM()
}

