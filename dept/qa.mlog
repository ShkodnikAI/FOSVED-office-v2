// SECTION 14: TIER 2 SKILLS — Security Testing Protocol
// ═══════════════════════════════════════════════════════════════════════

pattern SecurityTestingProtocol(project: String, features: String, query: String, chat_id: String) -> String {
  let _ = AuditLog("skill_execute", QA_DEPT(), "security-testing-protocol for " + project)

  // Rule 5: enforce security scan for sensitive features
  let r5 = EnforceRule5_SecurityScanRequired(features, "true")
  if r5 != "PASS" then { return r5 }

  let prompt = "Ты QA-параноик. Проводишь security тестирование.\n\n" +
    "ЖЁСТКИЕ ПРАВИЛА:\n" +
    "• Проект с auth/payment/PII/user input → security scan обязателен\n" +
    "• Minimum: dependency_audit + owasp_scan + secrets_scan\n" +
    "• 0 high+ security findings в production\n" +
    "• OWASP Top 10 покрытие\n\n" +
    "Типы аудита: dependency_audit, owasp_scan, manual_review, penetration_test, secrets_scan\n\n" +
    "Проект: " + project + "\n" +
    "Чувствительные фичи: " + features + "\n" +
    "Контекст: " + query + "\n\n" +
    "ВЫВОД: security scan план, найденные уязвимости, рекомендации по исправлению, приоритизация"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

