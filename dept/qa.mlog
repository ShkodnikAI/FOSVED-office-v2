// ═══════════════════════════════════════════════════════════════════════
// SECTION 22: ACCESSIBILITY GATE
// ═══════════════════════════════════════════════════════════════════════

pattern AccessibilityGate(project: String, isProductionRelease: String, chat_id: String) -> String {
  let _ = AuditLog("accessibility_gate", QA_DEPT(), "WCAG gate check for " + project + " (production=" + isProductionRelease + ")")

  let prompt = "Ты QA-педант. Проверяешь accessibility.\n\n" +
    "ЖЁСТКОЕ ПРАВИЛО: Каждый production релиз проходит WCAG AA минимум.\n\n" +
    "Чеклист WCAG AA:\n" +
    "• Color contrast ≥4.5:1 (text), ≥3:1 (large text/UI components)\n" +
    "• Keyboard navigation — все интерактивные элементы доступны\n" +
    "• Screen reader support — ARIA labels, semantic HTML\n" +
    "• Focus management — видимый focus, logical tab order\n" +
    "• Error handling — accessible error messages\n" +
    "• Alt text для изображений\n" +
    "• Form labels и descriptions\n" +
    "• No content reliance on color alone\n\n" +
    "Проект: " + project + "\n\n" +
    "ВЫВОД: accessibility чеклист результат, найденные нарушения, WCAG уровень (A/AA/AAA)"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }

  // Rule 7: Production release must pass WCAG AA
  if isProductionRelease == "true" then {
    if contains(lower(result), "aa") == false  and  contains(lower(result), "aaa") == false then {
      let _ = AuditLog("accessibility_gate_blocked", QA_DEPT(), "Production release blocked — WCAG AA not met")
      return "ОТКАЗ: Production релиз заблокирован — WCAG AA не пройден. (Rule 7)\n\n" + result
    }
  }

  return result
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 23: RELEASE GATE
// ═══════════════════════════════════════════════════════════════════════

pattern ReleaseGate(project: String, environment: String, isAISystem: String, projectFeatures: String, chat_id: String) -> String {
  let _ = AuditLog("release_gate", QA_DEPT(), "Release gate check for " + project + " → " + environment)

  let gateResults = "RELEASE GATE — " + project + " → " + environment + "\n═══════════════════════════════════\n"
  let mut blocked = false

  // Rule 1: Critical test suite must pass
  let latestRun = db_execute(
    "SELECT verdict FROM test_runs WHERE project = ? AND test_type IN ('unit', 'integration', 'e2e', 'smoke') AND status = 'completed' ORDER BY completed_at DESC LIMIT 1",
    [project]
  )
  let criticalPassed = "false"
  if contains(latestRun, "passed") then { let criticalPassed = "true" }
  let r1 = EnforceRule1_NoReleaseWithoutPassedSuite(project, criticalPassed, environment)
  if r1 != "PASS" then {
    let gateResults = gateResults + "❌ Rule 1 (Critical suite): " + r1 + "\n"
    let blocked = true
  } else {
    let gateResults = gateResults + "✅ Rule 1 (Critical suite): Passed\n"
  }

  // Rule 5: Security scan for sensitive features
  let hasSecurityScan = "false"
  let secAudit = db_execute(
    "SELECT id FROM security_audits WHERE project = ? AND status = 'completed' ORDER BY completed_at DESC LIMIT 1",
    [project]
  )
  if length(secAudit) > 0 then { let hasSecurityScan = "true" }
  let r5 = EnforceRule5_SecurityScanRequired(projectFeatures, hasSecurityScan)
  if r5 != "PASS" then {
    let gateResults = gateResults + "❌ Rule 5 (Security scan): " + r5 + "\n"
    let blocked = true
  } else {
    let gateResults = gateResults + "✅ Rule 5 (Security scan): Passed\n"
  }

  // Rule 6: AI evals for AI systems
  if isAISystem == "true" then {
    let aiEval = db_execute(
      "SELECT verdict, total_cases, overall_pass_rate FROM ai_eval_runs WHERE project = ? AND status = 'completed' ORDER BY completed_at DESC LIMIT 1",
      [project]
    )
    let hasEvals = "false"
    if length(aiEval) > 0 then { let hasEvals = "true" }
    let r6 = EnforceRule6_AIEvalsRequired(isAISystem, hasEvals, "0")
    if r6 != "PASS" then {
      let gateResults = gateResults + "❌ Rule 6 (AI evals): " + r6 + "\n"
      let blocked = true
    } else {
      let gateResults = gateResults + "✅ Rule 6 (AI evals): Passed\n"
    }
  }

  // Rule 7: WCAG AA for production
  if environment == QA_ENV_PRODUCTION() then {
    let r7 = EnforceRule7_AccessibilityRequired("true", "AA")
    if r7 != "PASS" then {
      let gateResults = gateResults + "❌ Rule 7 (Accessibility): " + r7 + "\n"
      let blocked = true
    } else {
      let gateResults = gateResults + "✅ Rule 7 (Accessibility): Passed\n"
    }
  }

  // Rule 8: No production testing
  let r8 = EnforceRule8_NoProdTesting(environment)
  if r8 != "PASS" then {
    let gateResults = gateResults + "❌ Rule 8 (No prod testing): " + r8 + "\n"
    let blocked = true
  } else {
    let gateResults = gateResults + "✅ Rule 8 (No prod testing): Passed\n"
  }

  // Security findings check
  let secFindings = db_execute(
    "SELECT SUM(findings_critical + findings_high) as total FROM security_audits WHERE project = ? AND status = 'completed'",
    [project]
  )
  if contains(secFindings, "0") == false then {
    let gateResults = gateResults + "❌ Security: High+ findings exist in latest audit\n"
    let blocked = true
  } else {
    let gateResults = gateResults + "✅ Security: No high+ findings\n"
  }

  if blocked then {
    let gateResults = gateResults + "\n🔴 RELEASE BLOCKED — исправьте нарушения выше"
    let _ = AuditLog("release_gate_blocked", QA_DEPT(), "Release blocked for " + project)
    let _ = send_message(chat_id, "🔴 RELEASE BLOCKED: " + project + " — gate failures detected. See /qa-monitor.")
  } else {
    let gateResults = gateResults + "\n🟢 RELEASE APPROVED — все gates пройдены"
    let _ = AuditLog("release_gate_approved", QA_DEPT(), "Release approved for " + project)
  }

  return gateResults
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 24: LEARNING LOOPS
// ═══════════════════════════════════════════════════════════════════════




// Quarterly methodology review
pattern QuarterlyMethodologyReview(chat_id: String) -> String {
  let _ = AuditLog("quarterly_review", QA_DEPT(), "Quarterly methodology review started")

  // Systematic weakness detection: analyze patterns in defects
  let defectPatterns = db_execute(
    "SELECT severity, environment, COUNT(*) as cnt FROM defect_records WHERE created_at > datetime('now') - INTERVAL '90 days' GROUP BY severity, environment ORDER BY cnt DESC",
    []
  )

  let escapeTrend = db_execute(
    "SELECT DATE_TRUNC('month', created_at) as month, COUNT(*) as total, SUM(CASE WHEN environment = 'production' THEN 1 ELSE 0 END) as escaped FROM defect_records WHERE created_at > datetime('now') - INTERVAL '90 days' GROUP BY DATE_TRUNC('month', created_at) ORDER BY month",
    []
  )

  let falsePositiveRate = db_execute(
    "SELECT COUNT(CASE WHEN status = 'wontfix' THEN 1 END) as wontfix, COUNT(CASE WHEN status = 'duplicate' THEN 1 END) as duplicate, COUNT(*) as total FROM defect_records WHERE created_at > datetime('now') - INTERVAL '90 days'",
    []
  )

  let prompt = "Ты QA-педант. Проводишь квартальный обзор методологии.\n\n" +
    "ЦЕЛИ ОБЗОРА:\n" +
    "1. Выявить систематические слабости (patterns in defects)\n" +
    "2. Оценить escape rate тренд (улучшается/ухудшается)\n" +
    "3. Оценить false positive rate (≤15%)\n" +
    "4. Проверить актуальность failure modes списков\n" +
    "5. Оценить покрытие тест-пирамиды (70/20/10)\n" +
    "6. Рекомендации по улучшению методологии\n\n" +
    "Defect patterns (90d):\n" + defectPatterns + "\n\n" +
    "Escape trend:\n" + escapeTrend + "\n\n" +
    "False positive stats:\n" + falsePositiveRate + "\n\n" +
    "ВЫВОД: systematic weaknesses, trend analysis, methodology improvements, updated targets"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }

  let _ = AuditLog("quarterly_review_completed", QA_DEPT(), "Quarterly methodology review completed")
  return result
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 25: DISCLAIMER WRAPPER & ARCHIVE
// ═══════════════════════════════════════════════════════════════════════

pattern ApplyDisclaimer(text: String) -> String {
  if contains(text, "генерируются проектным ассистентом") == false then {
    return text + "\n\n" + QA_DISCLAIMER_BOTTOM()
  }
  return text
}

pattern SaveToQAArchive(shortTitle: String, fullResult: String, testType: String, project: String, chat_id: String) -> String {
  let resultWithDisclaimer = ApplyDisclaimer(fullResult)

  let _ = db_execute(
    "INSERT INTO qa_assessments (short_title, full_result, test_type, project, status, created_at, updated_at) VALUES (?, ?, ?, ?, 'published', datetime('now'), datetime('now'))",
    [shortTitle, resultWithDisclaimer, testType, project]
  )

  let idRows = query("SELECT LASTVAL() as id", [])
  let id = redact(to_string(json_get(parse_json(idRows), "0.id", "0")), "all")

  // Set verification date
  let _ = db_execute(
    "UPDATE qa_assessments SET verification_date = date('now', '+30 days') WHERE id = ?",
    [id]
  )

  let _ = AuditLog("qa_save", QA_DEPT(), "Assessment #" + to_string(id) + " saved: " + shortTitle + " [" + testType + "]")
  return to_string(id)
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 26: HELP
// ═══════════════════════════════════════════════════════════════════════

pattern ShowQAHelp() -> String {
  let help = "╔══════════════════════════════════════════╗\n" +
    "║  QA — Тестирование (Параноик + Педант)   ║\n" +
    "╚══════════════════════════════════════════╝\n\n" +
    "КОМАНДЫ:\n" +
    "/qa-strategy   — тест-стратегия (обязателен failure modes list)\n" +
    "/qa-test       — запуск тест-сьюты\n" +
    "/qa-defect     — управление дефектом\n" +
    "/qa-defects    — список дефектов\n" +
    "/qa-eval       — AI evals (минимум 50 кейсов)\n" +
    "/qa-security   — security аудит\n" +
    "/qa-coverage   — coverage отчёт\n" +
    "/qa-runs       — история test runs\n" +
    "/qa-monitor    — production мониторинг\n\n" +
    "ЖЁСТКИЕ ПРАВИЛА (10):\n" +
    "1. Нет релиза без passed test suite на critical\n" +
    "2. Нет стратегии без failure modes list\n" +
    "3. Нет закрытия дефекта без регрессионного теста\n" +
    "4. Нет 'manual only' — автоматизация обязательна\n" +
    "5. Нет skip security для auth/payment/PII/user input\n" +
    "6. Нет AI-релиза без evals ≥50 кейсов\n" +
    "7. Нет skip accessibility — WCAG AA обязателен\n" +
    "8. Нет тестирования в production (staging только)\n" +
    "9. Critical дефект → incident + RCA\n" +
    "10. Нет закрытия без coverage + failure modes\n\n" +
    "ТЕСТ-ПИРАМИДА: unit 70% | integration 20% | e2e 10%\n" +
    "COVERAGE: critical≥95% | business≥90% | overall≥80%\n\n" +
    "SKILLS (11):\n" +
    "Tier 1: test-strategy-design, failure-modes-mapping, defect-discipline, regression-test-discipline\n" +
    "Tier 2: unit-testing-craft, integration-testing-patterns, e2e-testing-with-playwright, security-testing-protocol, ai-evals-framework\n" +
    "Tier 3: performance-testing, chaos-engineering\n\n" +
    QA_DISCLAIMER_TOP()

  return help
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 27: FULL PIPELINE
// ═══════════════════════════════════════════════════════════════════════
// For free-text queries: context → skills → hard rules → strategy → test → defects → disclaimer → archive

pattern FullQAPipeline(query: String, chat_id: String, intent: String) -> String {
  let ctx = BuildQAContext(query, chat_id)
  let parsed = parse_json(ctx)
  let testType = json_get(parsed, "testType", QA_TT_UNIT())
  let severity = redact(to_string(json_get(parsed, "severity", QA_SEV_MEDIUM())), "all")
  let environment = redact(to_string(json_get(parsed, "environment", QA_ENV_STAGING())), "all")
  let isAISystem = json_get(parsed, "isAISystem", "false")
  let sensitiveFeatures = json_get(parsed, "sensitiveFeatures", "")

  // Hard rules gate
  let rules = QaEnforceHardRules(query, environment, "project", sensitiveFeatures)
  if rules != "PASS" then { return rules }

  // Load skills
  let skills = LoadAllSkills(testType, query)

  // Step 1: Test strategy (Tier 1 — mandatory first step)
  let mut strategy = ""
  if intent == "intent:strategy"  or  intent == "intent:general"  or  intent == "intent:failure-modes" then {
    let strategy = TestStrategyDesign("project", testType, query, chat_id)
    // Rule 2: Strategy must have failure modes
    let r2 = EnforceRule2_FailureModesRequired(strategy, "from_strategy")
    if r2 != "PASS" then {
      return r2
    }
  }

  // Step 2: Route by intent
  let mut result = ""

  if intent == "intent:strategy" then {
    let result = strategy
  }

  if intent == "intent:failure-modes" then {
    let fm = FailureModesMapping("project", query, chat_id)
    let result = fm
  }

  if intent == "intent:defect" then {
    let dd = DefectDiscipline("project", query, chat_id)
    let result = dd
  }

  if intent == "intent:regression" then {
    let rd = RegressionTestDiscipline("project", "latest", chat_id)
    let result = rd
  }

  if intent == "intent:ai-eval" then {
    // Rule 6: AI system requires evals
    let r6 = EnforceRule6_AIEvalsRequired(isAISystem, "pending", "0")
    let ae = AIEvalsFramework("project", query, chat_id)
    let result = ae
  }

  if intent == "intent:security" then {
    let st = SecurityTestingProtocol("project", sensitiveFeatures, query, chat_id)
    let result = st
  }

  if intent == "intent:coverage" then {
    let result = CmdQACoverage(query, chat_id)
  }

  if intent == "intent:accessibility" then {
    let ag = AccessibilityGate("project", "true", chat_id)
    let result = ag
  }

  if intent == "intent:performance" then {
    let pt = PerformanceTesting("project", query, chat_id)
    let result = pt
  }

  if intent == "intent:chaos" then {
    let ce = ChaosEngineering("project", query, chat_id)
    let result = ce
  }

  if intent == "intent:hotfix" then {
    let hf = DefectDiscipline("project", "HOTFLOW: " + query, chat_id)
    let result = hf
  }

  if intent == "intent:general" then {
    // General query — route through LLM with QA context
    let _strategy_str = ""
    if length(strategy) > 0 then { let _strategy_str = "СТРАТЕГИЯ (построена):\n" + strategy + "\n\n" }
    let prompt = "Ты QA-параноик-педант отдела Тестирование Fosved Office. Отвечаешь системно, точно, без эвфемизмов.\n\n" +
      "ТИП ТЕСТА: " + testType + "\n" +
      "SEVERITY: " + severity + "\n" +
      "СРЕДА: " + environment + "\n" +
      "AI-СИСТЕМА: " + isAISystem + "\n" +
      "НАГРУЖЕННЫЕ SKILLS: " + skills + "\n\n" +
      "ЖЁСТКИЕ ПРАВИЛА (10):\n" +
      "1. Нет релиза без passed test suite на critical scenarios\n" +
      "2. Нет стратегии без failure modes list\n" +
      "3. Нет закрытия дефекта без регрессионного теста\n" +
      "4. Нет 'manual only' — автоматизация обязательна\n" +
      "5. Нет skip security для auth/payment/PII/user input\n" +
      "6. Нет AI-релиза без evals ≥50 кейсов (pass rate ≥0.90)\n" +
      "7. Нет skip accessibility — WCAG AA обязателен для production\n" +
      "8. Нет тестирования в production (staging только)\n" +
      "9. Critical дефект → incident + RCA обязательно\n" +
      "10. Нет закрытия без coverage report + failure modes\n\n" +
      "ТЕСТ-ПИРАМИДА: unit 70% | integration 20% | e2e 10%\n" +
      "COVERAGE: critical≥95% | business≥90% | overall≥80%\n" +
      "DEFECT ESCAPE RATE TARGET: ≤10%\n" +
      "MTTD CRITICAL: ≤1ч | MTTR CRITICAL: ≤4ч\n\n" +
      _strategy_str +
      "ЗАПРОС: " + query + "\n\n" +
      "Отвечай системно: что проверять, как проверять, какие failure modes, какие риски."

    let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
    if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  }

  // Step 2.5: LLM-Verifier probabilistic gate — score QA output quality
  // Non-blocking: logs score, adds warning if quality is critically low
  let qv_resp = TryVal(try call_python("llm_verifier", "score", json_encode([query, result, "Testing rigor: Are test cases specific and repeatable? Coverage: Are critical paths covered? Discipline: Do recommendations follow QA hard rules?"])))
  let mut qv_score = 0.5
  if to_string(qv_resp) != "()" and contains(to_string(qv_resp), "error") == false then {
    let qv_parsed = TryVal(try parse_json(qv_resp))
    let qv_score = to_float(TryVal(try json_get(qv_parsed, "result", "0.5")))
    let _ = AuditLog("qa_verify_score", QA_DEPT(), "score=" + to_string(qv_score) + " intent=" + intent)
  }
  // If verification score is critically low, prepend a warning
  if qv_score < 0.4 then {
    let result = "[ВЕРИФИКАЦИЯ: низкая оценка качества анализа — рекомендуется ручная проверка]\n\n" + result
  }

  // Step 3: Disclaimer
  let withDisclaimer = ApplyDisclaimer(result)

  // Step 4: Safety check — never output without disclaimer
  if contains(withDisclaimer, "генерируются проектным ассистентом") == false then {
    return "⚠ ВНУТРЕННЯЯ ОШИБКА: disclaimer не применён. Результат заблокирован."
  }

  // Step 5: Save to archive
  let shortTitle = substring(query, 0.0, 80.0)
  let archiveId = SaveToQAArchive(shortTitle, withDisclaimer, testType, "project", chat_id)

  return withDisclaimer + "\n\n📎 Сохранено в архив: #" + archiveId + " | Verification date: +30 дней"
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 28: CROSS-DEPARTMENT INTEGRATION
// ═══════════════════════════════════════════════════════════════════════
// Reference only — critical defect triggers Dev hotfix task creation

pattern NotifyDevHotfix(defectId: String, severity: String, summary: String, chat_id: String) -> String {
  if severity != QA_SEV_CRITICAL()  and  severity != QA_SEV_HIGH() then {
    return "Hotfix not needed — severity " + severity
  }

  let _ = AuditLog("cross_dept_hotfix", QA_DEPT(), "Notifying Dev for hotfix: defect #" + defectId + " [" + severity + "]")

  // Create hotfix task reference in DB
  let _ = db_execute(
    "INSERT INTO cross_dept_tasks (source_dept, target_dept, task_type, reference_id, severity, summary, status, created_at) VALUES ('qa', 'dev', 'hotfix', ?, ?, ?, 'pending', datetime('now'))",
    [defectId, severity, summary]
  )

  let _ = send_message(chat_id, "🔧 HOTFIX TASK → Dev: Defect #" + defectId + " [" + severity + "] — " + summary)
  return "Hotfix task created for Dev: defect #" + defectId
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 29: ENTRY POINT
// ═══════════════════════════════════════════════════════════════════════

pattern HandleQA(query: String, chat_id: String) -> String {
  let dept = QA_DEPT()
  let _ = AuditLog("dept_query", dept, "query: " + substring(query, 0.0, 100.0))

  // Parse command/intent
  let parsed = ParseQAQuery(query)

  // Route by command
  if parsed == "cmd:qa-strategy" then {
    let reply = CmdQAStrategy(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  if parsed == "cmd:qa-test" then {
    let reply = CmdQATest(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  if parsed == "cmd:qa-defect" then {
    let reply = CmdQADefect(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  if parsed == "cmd:qa-defects" then {
    let reply = CmdQADefects(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  if parsed == "cmd:qa-eval" then {
    let reply = CmdQAEval(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  if parsed == "cmd:qa-security" then {
    let reply = CmdQASecurityAudit(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  if parsed == "cmd:qa-coverage" then {
    let reply = CmdQACoverage(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  if parsed == "cmd:qa-runs" then {
    let reply = CmdQARuns(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  if parsed == "cmd:qa-monitor" then {
    let reply = CmdQAMonitor(query, chat_id)
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  // Help detection
  if contains(lower(query), "/qa")  and  contains(lower(query), "help") then {
    let reply = ShowQAHelp()
    let _ = RecordAssistantMessage(chat_id, dept, reply)
    return reply
  }

  // Free-text: full pipeline
  let reply = FullQAPipeline(query, chat_id, parsed)
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  return reply
}

// ── TEAM-2 #481 A.1: навык qa/risk_review (реестр dept/team.mlog) ────
// Тихая облегчённая функция: риск-обзор плана или фичи.
pattern QaRiskReview(question: String) -> String {
  let prompt = "Ты отдел QA, коллега запрашивает навык risk_review: риск-обзор плана или фичи. Вопрос: " + question + "\nФормат: (1) реестр рисков (риск — вероятность — влияние); (2) какие риски блокирующие; (3) минимальный план проверок. Без приветствий и подписи."
  let r = redact(to_string(TryVal(try call_llm(prompt, question))), "all")
  if r == "()" then { return "(коллега qa/risk_review недоступен: модель не ответила)" }
  return r
}

