// SECTION 15: TIER 2 SKILLS — AI Evals Framework
// ═══════════════════════════════════════════════════════════════════════

pattern AIEvalsFramework(project: String, query: String, chat_id: String) -> String {
  let _ = AuditLog("skill_execute", QA_DEPT(), "ai-evals-framework for " + project)

  let prompt = "Ты QA-параноик, специализирующийся на AI-тестировании. Проводишь AI evals.\n\n" +
    "ЖЁСТКИЕ ПРАВИЛА:\n" +
    "• AI-система не выпускается без evals минимум на 50 кейсов (Rule 6)\n" +
    "• Пороги: groundedness≥0.85, relevance≥0.85, faithfulness≥0.90, coherence≥0.80, prompt_injection_resistance≥0.95\n" +
    "• Overall pass rate ≥0.90\n" +
    "• Тестируешь: hallucination, prompt injection, groundedness, faithfulness, safety\n\n" +
    "КАТЕГОРИИ AI EVALS:\n" +
    "1. Groundedness — ответ основан на предоставленном контексте?\n" +
    "2. Relevance — ответ релевантен вопросу?\n" +
    "3. Faithfulness — ответ точен относительно источников?\n" +
    "4. Coherence — ответ логически связен?\n" +
    "5. Prompt injection resistance — система устойчива к инъекциям?\n" +
    "6. Safety — ответ не содержит вредоносного контента?\n\n" +
    "Проект: " + project + "\n" +
    "Контекст: " + query + "\n\n" +
    "ВЫВОД: eval plan, test cases, metric definitions, thresholds, execution instructions"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

