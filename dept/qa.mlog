  let prompt = "Ты QA-педант. Проектируешь performance тесты.\n\n" +
    "Это Tier 3 skill — запускается только по явному запросу.\n\n" +
    "ПРАВИЛА:\n" +
    "• Define baseline before optimizing\n" +
    "• Test under realistic load, not synthetic\n" +
    "• P95 и P99 latency > average\n" +
    "• Test degradation, not just happy path\n" +
    "• No testing in production (staging only)\n\n" +
    "Компонент: " + component + "\n" +
    "Контекст: " + query + "\n\n" +
    "ВЫВОД: performance test plan, load scenarios, metrics to capture, SLIs/SLOs/SLAs"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

