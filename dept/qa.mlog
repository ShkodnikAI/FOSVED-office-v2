// ═══════════════════════════════════════════════════════════════════════
// Fosved Office v2 — QA Department (Тестирование) — NATIVE v1.0
import dept/utils
// ═══════════════════════════════════════════════════════════════════════
// Replaces Python proxy stub with native Metalogos QA engine.
// Psychotype: Параноик + Педант (systematic distrust, precision over speed)
// 11 skills (4 Tier 1 + 5 Tier 2 + 2 Tier 3), 9 bot commands,
// 4 DB models (TestRun, DefectRecord, SecurityAudit, AIEvalRun),
// 14 hard rules as native gates, distinctive AI-specific testing competency.
// 0 CallLLMProxy calls, 0 Python dependencies.
//
// Architecture:
//   HandleQA(query, chat_id)
//     → ParseQAQuery(query)            ← NLP skill + command detection
//     → QaEnforceHardRules(context)      ← 10 hard rules as native gates
//     → RouteByCommand(cmd, ...)        ← 9 bot commands + free-text dispatch
//       → cmd=qa-strategy     → TestStrategyDesign
//       → cmd=qa-test         → RunTest
//       → cmd=qa-defect       → ManageDefect
//       → cmd=qa-defects      → ListDefects
//       → cmd=qa-eval         → RunAIEval
//       → cmd=qa-security     → SecurityAudit
//       → cmd=qa-coverage     → CoverageReport
//       → cmd=qa-runs         → ListTestRuns
//       → cmd=qa-monitor      → ProductionMonitor
//       → free-text            → FullQAPipeline
//     → FullQAPipeline (for free-text queries):
//       → BuildQAContext                  ← project + testType + severity
//       → LoadSkillTier                   ← load skills by test type
//       → QaEnforceHardRules              ← 10 hard rules gate
//       → TestStrategyDesign              ← Tier 1: mandatory first step
//       → FailureModesMapping             ← Tier 1: explicit failure modes
//       → [Route by test type]:
//         → unit/e2e/integration → ExecuteTestSuite
//         → security             → SecurityTestingProtocol
//         → ai_eval              → AIEvalsFramework
//         → accessibility        → AccessibilityGate
//       → DefectDiscipline                ← Tier 1: defect management
//       → RegressionTestDiscipline        ← Tier 1: regression gate
//       → ApplyDisclaimer                ← mandatory top + bottom
//       → SaveToQAArchive                ← db + metrics update
//     → RecordAssistantMessage
//
// Tier 1 skills (always loaded):
//   test-strategy-design, failure-modes-mapping, defect-discipline,
//   regression-test-discipline
// Tier 2 skills (by test type):
//   unit-testing-craft, integration-testing-patterns,
//   e2e-testing-with-playwright, security-testing-protocol,
//   ai-evals-framework
// Tier 3 skills (explicit request):
//   performance-testing, chaos-engineering
//
// Depends on BUILTINS only (no Python, no CallLLMProxy):
//   call_llm, db_execute, kv_get, kv_set, json_encode, json_get, parse_json,
//   to_string, to_float, to_int, length, contains, lower, substring,
//   split, join, now, format_date, hash, AuditLog,
//   RecordAssistantMessage, BuildContext, send_message ( builtin; SendTelegramMessage never existed — migrated to send_message, Metalogos #530 follow-up)
//
// ═══════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// SECTION 0: CONSTANTS & DISCLAIMER
// ═══════════════════════════════════════════════════════════════════════

// All constants as pattern functions (Metalogos requires pattern at top level, not let)
pattern QA_DISCLAIMER_TOP() -> String { return "⚠️ Результаты тестирования генерируются проектным ассистентом. Все критические находки подлежат верификации и эскалации к владельцу." }
pattern QA_DISCLAIMER_BOTTOM() -> String { return "⚠️ Результаты тестирования генерируются проектным ассистентом. Все критические находки подлежат верификации и эскалации к владельцу. Перед релизом обязательна проверка человеком для критических сценариев." }
pattern QA_DEPT() -> String { return "qa" }
pattern QA_TR_STARTED() -> String { return "started" }
pattern QA_DF_OPEN() -> String { return "open" }
pattern QA_DF_ACKNOWLEDGED() -> String { return "acknowledged" }
pattern QA_DF_IN_PROGRESS() -> String { return "in_progress" }
pattern QA_DF_FIXED() -> String { return "fixed" }
pattern QA_DF_VERIFIED() -> String { return "verified" }
pattern QA_DF_WONTFIX() -> String { return "wontfix" }
pattern QA_DF_DUPLICATE() -> String { return "duplicate" }
pattern QA_VALID_DEFECT_STATES() -> String { return "open,acknowledged,in_progress,fixed,verified,wontfix,duplicate" }
pattern QA_SEV_CRITICAL() -> String { return "critical" }
pattern QA_SEV_HIGH() -> String { return "high" }
pattern QA_SEV_MEDIUM() -> String { return "medium" }
pattern QA_SEV_LOW() -> String { return "low" }
pattern QA_SEV_TRIVIAL() -> String { return "trivial" }
pattern QA_VALID_SEVERITIES() -> String { return "critical,high,medium,low,trivial" }
pattern QA_TT_UNIT() -> String { return "unit" }
pattern QA_TT_INTEGRATION() -> String { return "integration" }
pattern QA_TT_E2E() -> String { return "e2e" }
pattern QA_TT_SECURITY() -> String { return "security" }
pattern QA_TT_PERFORMANCE() -> String { return "performance" }
pattern QA_TT_ACCESSIBILITY() -> String { return "accessibility" }
pattern QA_TT_AI_EVAL() -> String { return "ai_eval" }
pattern QA_TT_SMOKE() -> String { return "smoke" }
pattern QA_TT_REGRESSION() -> String { return "regression" }
pattern QA_PYRAMID_UNIT_PCT() -> String { return "70" }
pattern QA_PYRAMID_INTEGRATION_PCT() -> String { return "20" }
pattern QA_PYRAMID_E2E_PCT() -> String { return "10" }
pattern QA_COV_CRITICAL_PATH() -> String { return "95" }
pattern QA_COV_BUSINESS_LOGIC() -> String { return "90" }
pattern QA_COV_OVERALL() -> String { return "80" }
pattern QA_AI_OVERALL_PASS_MIN() -> String { return "0.90" }
pattern QA_AI_MIN_CASES() -> String { return "50" }
pattern QA_SA_DEPENDENCY() -> String { return "dependency_audit" }
pattern QA_SA_OWASP() -> String { return "owasp_scan" }
pattern QA_SA_MANUAL() -> String { return "manual_review" }
pattern QA_SA_PENETRATION() -> String { return "penetration_test" }
pattern QA_SA_SECRETS() -> String { return "secrets_scan" }
pattern QA_VALID_AUDIT_TYPES() -> String { return "dependency_audit,owasp_scan,manual_review,penetration_test,secrets_scan" }
pattern QA_ENV_STAGING() -> String { return "staging" }
pattern QA_ENV_PRODUCTION() -> String { return "production" }


// ═══════════════════════════════════════════════════════════════════════
// SECTION 1: HARD RULES — 10 non-negotiable constraints
// ═══════════════════════════════════════════════════════════════════════
// Each hard rule is a native gate — violation produces immediate rejection.
// No LLM can override these. They are structural constraints of QA.

// Rule 1: No release approval without passed test suite on critical scenarios
pattern EnforceRule1_NoReleaseWithoutPassedSuite(project: String, criticalPassed: String, environment: String) -> String {
  if criticalPassed != "true" then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 1: release blocked — critical scenarios not passed for " + project)
    return "ОТКАЗ: Релиз заблокирован. Критические сценарии не пройдены. Каждый релиз требует passed test suite на критических сценариях. Запустите критические тесты и обеспечьте passing verdict."
  }
  if environment == QA_ENV_PRODUCTION() then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 1: tests must run in staging, not production")
    return "ОТКАЗ: Тестирование в production запрещено (Rule 8). Запустите критические тесты в staging."
  }
  return "PASS"
}

// Rule 2: No test strategy without explicit failure modes list
pattern EnforceRule2_FailureModesRequired(strategy: String, failureModes: String) -> String {
  if length(failureModes) == 0 then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 2: test strategy without failure modes list")
    return "ОТКАЗ: Тест-стратегия без списка failure modes недействительна. Каждый тест-план обязан содержать явный перечень режимов отказа. Без него — тестирование вслепую."
  }
  if contains(lower(strategy), "failure mode") == false  and  contains(lower(strategy), "режим отказ") == false then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 2: strategy missing failure modes section")
    return "ОТКАЗ: Тест-стратегия не содержит секции failure modes. Добавьте явный список режимов отказа перед утверждением стратегии."
  }
  return "PASS"
}

// Rule 3: No defect closure without regression test added
pattern EnforceRule3_RegressionOnClosure(defectId: String, hasRegressionTest: String) -> String {
  if hasRegressionTest != "true" then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 3: defect " + defectId + " closure without regression test")
    return "ОТКАЗ: Дефект #" + defectId + " не может быть закрыт без регрессионного теста. Каждый закрытый дефект обязан иметь регрессионный тест, предотвращающий повторное появление."
  }
  return "PASS"
}

// Rule 4: No "manual testing only" — automated tests mandatory
pattern EnforceRule4_AutomatedTestsRequired(testPlan: String, hasAutomated: String) -> String {
  if hasAutomated != "true" then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 4: manual-only testing rejected")
    return "ОТКАЗ: Только ручное тестирование недопустимо. Автоматизированные тесты обязательны. Минимум: unit (70%), integration (20%), e2e (10%) по тест-пирамиде."
  }
  if contains(lower(testPlan), "manual only")  or  contains(lower(testPlan), "только ручн") then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 4: explicit manual-only plan rejected")
    return "ОТКАЗ: План 'только ручное тестирование' запрещён. Добавьте автоматизированные тесты."
  }
  return "PASS"
}

// Rule 5: No security scan skip for projects with user input, auth, payment, or personal data
pattern EnforceRule5_SecurityScanRequired(projectFeatures: String, hasSecurityScan: String) -> String {
  let needsSecurity = false
  if contains(lower(projectFeatures), "user input")  or  contains(lower(projectFeatures), "ввод пользователя") then { let needsSecurity = true }
  if contains(lower(projectFeatures), "auth")  or  contains(lower(projectFeatures), "авторизац") then { let needsSecurity = true }
  if contains(lower(projectFeatures), "payment")  or  contains(lower(projectFeatures), "оплат")  or  contains(lower(projectFeatures), "платёж") then { let needsSecurity = true }
  if contains(lower(projectFeatures), "personal data")  or  contains(lower(projectFeatures), "персональн")  or  contains(lower(projectFeatures), "pii") then { let needsSecurity = true }

  if needsSecurity  and  hasSecurityScan != "true" then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 5: security scan skipped for project with sensitive features")
    return "ОТКАЗ: Проект содержит чувствительные функции (auth/payment/PII/user input) — security scan обязателен. Запустите: dependency_audit + owasp_scan + secrets_scan минимум."
  }
  return "PASS"
}

// Rule 6: No AI-system release without AI evals on minimum 50 cases
pattern EnforceRule6_AIEvalsRequired(isAISystem: String, evalCasesRun: String, evalPassRate: String) -> String {
  if isAISystem != "true" then { return "PASS" }
  if length(evalCasesRun) == 0 then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 6: AI system release without evals")
    return "ОТКАЗ: AI-система не может быть выпущена без AI evals. Минимум " + QA_AI_MIN_CASES() + " тестовых кейсов с метриками groundedness≥0.85, relevance≥0.85, faithfulness≥0.90, prompt_injection_resistance≥0.95."
  }
  let cases = to_int(evalCasesRun)
  if cases < to_int(QA_AI_MIN_CASES()) then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 6: AI eval cases " + evalCasesRun + " below minimum " + QA_AI_MIN_CASES())
    return "ОТКАЗ: AI evals выполнены на " + evalCasesRun + " кейсах, минимум — " + QA_AI_MIN_CASES() + ". Добавьте кейсы и перезапустите eval."
  }
  if length(evalPassRate) > 0 then {
    let rate = to_float(evalPassRate)
    if rate < to_float(QA_AI_OVERALL_PASS_MIN()) then {
      let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 6: AI eval pass rate " + evalPassRate + " below " + QA_AI_OVERALL_PASS_MIN())
      return "ОТКАЗ: AI eval pass rate " + evalPassRate + " ниже минимума " + QA_AI_OVERALL_PASS_MIN() + ". Улучшите модель/промпт перед релизом."
    }
  }
  return "PASS"
}

// Rule 7: No accessibility skip — every production release passes WCAG AA
pattern EnforceRule7_AccessibilityRequired(isProductionRelease: String, wcagResult: String) -> String {
  if isProductionRelease != "true" then { return "PASS" }
  if wcagResult != "AA"  and  wcagResult != "AAA" then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 7: production release without WCAG AA — got: " + wcagResult)
    return "ОТКАЗ: Production релиз без WCAG AA недопустим. Каждый production релиз обязан проходить WCAG AA минимум. Текущий результат: " + wcagResult + ". Исправьте accessibility находки."
  }
  return "PASS"
}

// Rule 8: No testing in production environment (staging mandatory)
pattern EnforceRule8_NoProdTesting(environment: String) -> String {
  if environment == QA_ENV_PRODUCTION() then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 8: test execution in production environment")
    return "ОТКАЗ: Тестирование в production среде запрещено. Все тесты выполняются в staging. Smoke-тесты post-deploy — единственное исключение, и они readonly."
  }
  return "PASS"
}

// Rule 9: Every critical defect → incident in archive + root cause analysis
pattern EnforceRule9_CriticalDefectIncident(severity: String, hasIncident: String, hasRCA: String) -> String {
  if severity != QA_SEV_CRITICAL() then { return "PASS" }
  if hasIncident != "true" then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 9: critical defect without incident record")
    return "ОТКАЗ: Critical дефект обязан иметь incident record в архиве. Создайте incident перед дальнейшей работой."
  }
  if hasRCA != "true" then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 9: critical defect without root cause analysis")
    return "ОТКАЗ: Critical дефект обязан иметь root cause analysis. RCA обязателен для каждого critical дефекта — без него дефект не может быть закрыт."
  }
  return "PASS"
}


// Rule 11: Flaky tests must be quarantined — no flaky tests in CI gate
pattern EnforceRule11_NoFlakyTestsInCI(testSuite: String, flakyCount: String) -> String {
  let flaky = to_float(flakyCount)
  if flaky > 0.0 then {
    let _ = AuditLog("hard_rule_violation", QA_DEPT(), "Rule 11: " + flakyCount + " flaky tests in suite '" + testSuite + "'")
    return "ОТКАЗ: Тест-сьют '" + testSuite + "' содержит " + flakyCount + " flaky тестов. Flaky-тесты должны быть карантинированы (quarantined) до исправления. CI gate не пропускает."
  }
  return "PASS"
}




// Composite hard rules check
// №523 (0.28.0): имя уникализировано. Глобальная таблица паттернов берёт
// ПЕРВОЕ определение (EnforceHardRules = dept/legal, 3 арг) — 4-арг QA-гейт
// обязан носить собственное имя (ADR-0014: голос отдела сохранён).
pattern QaEnforceHardRules(query: String, environment: String, project: String, projectFeatures: String) -> String {
  // Rule 4: check for manual-only
  let r4 = EnforceRule4_AutomatedTestsRequired(query, "true")
  if r4 != "PASS" then { return r4 }

  // Rule 8: no production testing
  let r8 = EnforceRule8_NoProdTesting(environment)
  if r8 != "PASS" then { return r8 }

  // Rule 5: security scan for sensitive features
  let r5 = EnforceRule5_SecurityScanRequired(projectFeatures, "true")
  if r5 != "PASS" then { return r5 }

  // Rule 11: no flaky tests in CI
  let r11 = EnforceRule11_NoFlakyTestsInCI("default", "0")
  if r11 != "PASS" then { return r11 }

  return "PASS"
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 2: QUERY PARSER & COMMAND ROUTER
// ═══════════════════════════════════════════════════════════════════════

pattern ParseQAQuery(query: String) -> String {
  let q = lower(query)
  // 9 bot commands
  if contains(q, "/qa-strategy") then { return "cmd:qa-strategy" }
  if contains(q, "/qa-test") then { return "cmd:qa-test" }
  if contains(q, "/qa-defects")  and  contains(q, "/qa-defect") then { return "cmd:qa-defects" }
  if contains(q, "/qa-defect") then { return "cmd:qa-defect" }
  if contains(q, "/qa-eval") then { return "cmd:qa-eval" }
  if contains(q, "/qa-security") then { return "cmd:qa-security" }
  if contains(q, "/qa-coverage") then { return "cmd:qa-coverage" }
  if contains(q, "/qa-runs") then { return "cmd:qa-runs" }
  if contains(q, "/qa-monitor") then { return "cmd:qa-monitor" }

  // Intent detection for free-text
  if contains(q, "тест-стратег")  or  contains(q, "test strategy") then { return "intent:strategy" }
  if contains(q, "failure mode")  or  contains(q, "режим отказ")  or  contains(q, "режимы отказ") then { return "intent:failure-modes" }
  if contains(q, "дефект")  or  contains(q, "баг")  or  contains(q, "defect")  or  contains(q, "bug") then { return "intent:defect" }
  if contains(q, "регресс")  or  contains(q, "regression") then { return "intent:regression" }
  if contains(q, "ai eval")  or  contains(q, "eval")  and  contains(q, "ai") then { return "intent:ai-eval" }
  if contains(q, "безопасност")  or  contains(q, "security")  or  contains(q, "уязвимост") then { return "intent:security" }
  if contains(q, "покрытие")  or  contains(q, "coverage") then { return "intent:coverage" }
  if contains(q, "доступност")  or  contains(q, "accessibility")  or  contains(q, "wcag") then { return "intent:accessibility" }
  if contains(q, "производител")  or  contains(q, "performance")  or  contains(q, "нагрузк") then { return "intent:performance" }
  if contains(q, "хаос")  or  contains(q, "chaos") then { return "intent:chaos" }
  if contains(q, "хотфикс")  or  contains(q, "hotfix") then { return "intent:hotfix" }

  return "intent:general"
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 3: CONTEXT BUILDER
// ═══════════════════════════════════════════════════════════════════════

pattern BuildQAContext(query: String, chat_id: String) -> String {
  let base = BuildContext(QA_DEPT(), query, chat_id)
  let q = lower(query)

  // Extract project
  let project = ""
  if contains(q, "проект ") then { let project = "detected" }
  if contains(q, "project ") then { let project = "detected" }

  // Extract test type
  let testType = QA_TT_UNIT()
  if contains(q, "unit") then { let testType = QA_TT_UNIT() }
  if contains(q, "integration")  or  contains(q, "интеграцион") then { let testType = QA_TT_INTEGRATION() }
  if contains(q, "e2e")  or  contains(q, "end-to-end") then { let testType = QA_TT_E2E() }
  if contains(q, "security")  or  contains(q, "безопасност") then { let testType = QA_TT_SECURITY() }
  if contains(q, "performance")  or  contains(q, "производител") then { let testType = QA_TT_PERFORMANCE() }
  if contains(q, "accessibility")  or  contains(q, "доступност")  or  contains(q, "wcag") then { let testType = QA_TT_ACCESSIBILITY() }
  if contains(q, "ai_eval")  or  contains(q, "ai eval") then { let testType = QA_TT_AI_EVAL() }
  if contains(q, "smoke") then { let testType = QA_TT_SMOKE() }
  if contains(q, "regression")  or  contains(q, "регресс") then { let testType = QA_TT_REGRESSION() }

  // Extract severity
  let severity = QA_SEV_MEDIUM()
  if contains(q, "critical")  or  contains(q, "критич") then { let severity = QA_SEV_CRITICAL() }
  if contains(q, "high")  or  contains(q, "высок") then { let severity = QA_SEV_HIGH() }
  if contains(q, "low")  or  contains(q, "низк") then { let severity = QA_SEV_LOW() }
  if contains(q, "trivial")  or  contains(q, "тривиальн") then { let severity = QA_SEV_TRIVIAL() }

  // Extract environment
  let environment = QA_ENV_STAGING()
  if contains(q, "production")  or  contains(q, "продакшн") then { let environment = QA_ENV_PRODUCTION() }

  // Detect AI system features
  let isAISystem = "false"
  if contains(q, "llm")  or  contains(q, "chatbot")  or  contains(q, "ai assistant")  or  contains(q, "ai-систем") then { let isAISystem = "true" }

  // Detect sensitive features
  let sensitiveFeatures = ""
  if contains(q, "auth")  or  contains(q, "авторизац") then { let sensitiveFeatures = sensitiveFeatures + "auth," }
  if contains(q, "payment")  or  contains(q, "оплат") then { let sensitiveFeatures = sensitiveFeatures + "payment," }
  if contains(q, "pii")  or  contains(q, "персональн") then { let sensitiveFeatures = sensitiveFeatures + "pii," }
  if contains(q, "user input")  or  contains(q, "ввод пользовател") then { let sensitiveFeatures = sensitiveFeatures + "user_input," }

  let ctx = json_encode({
    testType: testType,
    severity: severity,
    environment: environment,
    isAISystem: isAISystem,
    sensitiveFeatures: sensitiveFeatures,
    baseContext: base
  })

  return ctx
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 4: LIFECYCLE — Test Run
// ═══════════════════════════════════════════════════════════════════════
// Test run: started → completed → verdict (passed/failed/partial/error)

pattern CreateTestRun(project: String, testType: String, environment: String, triggeredBy: String, chat_id: String) -> String {
  let _ = AuditLog("test_run_create", QA_DEPT(), "Creating test run: " + project + " / " + testType + " / " + environment)

  let _ = db_execute(
    "INSERT INTO test_runs (project, test_type, status, environment, triggered_by, started_at, created_at, updated_at) VALUES (?, ?, ?, ?, ?, datetime('now'), datetime('now'), datetime('now'))",
    [project, testType, QA_TR_STARTED(), environment, triggeredBy]
  )

  let idRows = query("SELECT LASTVAL() as id", [])
  let id = redact(to_string(json_get(parse_json(idRows), "0.id", "0")), "all")

  let _ = AuditLog("test_run_created", QA_DEPT(), "Test run #" + to_string(id) + " created: " + project + " / " + testType)
  return to_string(id)
}



// ═══════════════════════════════════════════════════════════════════════
// SECTION 5: LIFECYCLE — Defect
// ═══════════════════════════════════════════════════════════════════════
// Defect: open → acknowledged → in_progress → fixed → verified → wontfix/duplicate

pattern CreateDefect(project: String, severity: String, summary: String, testRunId: String, environment: String, chat_id: String) -> String {
  // Validate severity
  if contains(QA_VALID_SEVERITIES(), severity) == false then {
    return "ОШИБКА: Недопустимый severity '" + severity + "'. Допустимые: " + QA_VALID_SEVERITIES()
  }

  let _ = db_execute(
    "INSERT INTO defect_records (project, severity, summary, status, test_run_id, environment, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, datetime('now'), datetime('now'))",
    [project, severity, summary, QA_DF_OPEN(), testRunId, environment]
  )

  let idRows = query("SELECT LASTVAL() as id", [])
  let id = redact(to_string(json_get(parse_json(idRows), "0.id", "0")), "all")

  let _ = AuditLog("defect_created", QA_DEPT(), "Defect #" + to_string(id) + " [" + severity + "]: " + substring(summary, 0.0, 80.0))

  // Rule 9: Critical defect → mandatory incident + RCA
  if severity == QA_SEV_CRITICAL() then {
    let _ = db_execute(
      "INSERT INTO incidents (defect_id, project, status, created_at) VALUES (?, ?, 'open', datetime('now'))",
      [to_string(id), project]
    )
    let _ = AuditLog("incident_auto_created", QA_DEPT(), "Incident auto-created for critical defect #" + to_string(id))
  }

  // Hotfix trigger: critical always, high+in_production always
  if severity == QA_SEV_CRITICAL() then {
    let _ = AuditLog("hotfix_triggered", QA_DEPT(), "Hotfix triggered: critical severity defect #" + to_string(id))
    let _ = send_message(chat_id, "🔴 HOTFIX: Critical defect #" + to_string(id) + " — " + summary)
  }
  if severity == QA_SEV_HIGH()  and  environment == QA_ENV_PRODUCTION() then {
    let _ = AuditLog("hotfix_triggered", QA_DEPT(), "Hotfix triggered: high severity in production defect #" + to_string(id))
    let _ = send_message(chat_id, "🟠 HOTFIX: High severity defect in production #" + to_string(id) + " — " + summary)
  }

  return to_string(id)
}

pattern TransitionDefect(defectId: String, newState: String, regressionTestAdded: String, chat_id: String) -> String {
  // Validate state
  if contains(QA_VALID_DEFECT_STATES(), newState) == false then {
    return "ОШИБКА: Недопустимый статус дефекта '" + newState + "'. Допустимые: " + QA_VALID_DEFECT_STATES()
  }

  // Get current state
  let currentRows = db_execute(
    "SELECT status, severity, has_regression_test, has_incident, has_rca FROM defect_records WHERE id = ?",
    [defectId]
  )
  if length(currentRows) == 0 then {
    return "Дефект #" + defectId + " не найден."
  }
  let parsed = parse_json(currentRows)
  let currentStatus = json_get(parsed, "0.status", "")
  let currentSeverity = json_get(parsed, "0.severity", "")
  let hasRegression = json_get(parsed, "0.has_regression_test", "false")
  let hasIncident = json_get(parsed, "0.has_incident", "false")
  let hasRCA = json_get(parsed, "0.has_rca", "false")

  // Validate transition order
  let validTransition = "false"
  if currentStatus == QA_DF_OPEN()  and  newState == QA_DF_ACKNOWLEDGED() then { let validTransition = "true" }
  if currentStatus == QA_DF_ACKNOWLEDGED()  and  newState == QA_DF_IN_PROGRESS() then { let validTransition = "true" }
  if currentStatus == QA_DF_IN_PROGRESS()  and  newState == QA_DF_FIXED() then { let validTransition = "true" }
  if currentStatus == QA_DF_FIXED()  and  newState == QA_DF_VERIFIED() then { let validTransition = "true" }
  if currentStatus == QA_DF_OPEN()  and  newState == QA_DF_WONTFIX() then { let validTransition = "true" }
  if currentStatus == QA_DF_OPEN()  and  newState == QA_DF_DUPLICATE() then { let validTransition = "true" }
  if currentStatus == QA_DF_ACKNOWLEDGED()  and  newState == QA_DF_WONTFIX() then { let validTransition = "true" }
  if currentStatus == QA_DF_ACKNOWLEDGED()  and  newState == QA_DF_DUPLICATE() then { let validTransition = "true" }

  if validTransition != "true" then {
    return "ОШИБКА: Недопустимый переход " + currentStatus + " → " + newState + " для дефекта #" + defectId
  }

  // Rule 3: No closure without regression test
  if newState == QA_DF_VERIFIED() then {
    let r3 = EnforceRule3_RegressionOnClosure(defectId, regressionTestAdded)
    if r3 != "PASS" then { return r3 }
  }

  // Rule 9: Critical defect needs incident + RCA before closure
  if newState == QA_DF_VERIFIED()  and  currentSeverity == QA_SEV_CRITICAL() then {
    let r9 = EnforceRule9_CriticalDefectIncident(currentSeverity, hasIncident, hasRCA)
    if r9 != "PASS" then { return r9 }
  }

  // Update defect
  let _ = db_execute(
    "UPDATE defect_records SET status = ?, has_regression_test = ?, updated_at = datetime('now') WHERE id = ?",
    [newState, regressionTestAdded, defectId]
  )

  // If moving to verified — record MTTD/MTTR metrics
  if newState == QA_DF_VERIFIED() then {
    let _ = db_execute(
      "UPDATE defect_records SET verified_at = datetime('now') WHERE id = ?",
      [defectId]
    )
  }

  let _ = AuditLog("defect_transition", QA_DEPT(), "Defect #" + defectId + ": " + currentStatus + " → " + newState)
  return "Дефект #" + defectId + " → " + newState
}


// ═══════════════════════════════════════════════════════════════════════
// SECTION 6: SKILL TIER LOADER
// ═══════════════════════════════════════════════════════════════════════

pattern LoadSkillTier1() -> String {
  // Tier 1 skills: always loaded
  return "test-strategy-design, failure-modes-mapping, defect-discipline, regression-test-discipline"
}

pattern LoadSkillTier2(testType: String) -> String {
  // Tier 2 skills: loaded by test type
  if testType == QA_TT_UNIT() then { return "unit-testing-craft" }
  if testType == QA_TT_INTEGRATION() then { return "integration-testing-patterns" }
  if testType == QA_TT_E2E() then { return "e2e-testing-with-playwright" }
  if testType == QA_TT_SECURITY() then { return "security-testing-protocol" }
  if testType == QA_TT_AI_EVAL() then { return "ai-evals-framework" }
  // For mixed/general: load all Tier 2
  return "unit-testing-craft, integration-testing-patterns, e2e-testing-with-playwright, security-testing-protocol, ai-evals-framework"
}

pattern LoadSkillTier3(explicitRequest: String) -> String {
  // Tier 3 skills: only on explicit request
  if contains(lower(explicitRequest), "performance")  or  contains(lower(explicitRequest), "производител") then {
    return "performance-testing"
  }
  if contains(lower(explicitRequest), "chaos")  or  contains(lower(explicitRequest), "хаос") then {
    return "chaos-engineering"
  }
  return ""
}

pattern LoadAllSkills(testType: String, query: String) -> String {
  let t1 = LoadSkillTier1()
  let t2 = LoadSkillTier2(testType)
  let t3 = LoadSkillTier3(query)
  if length(t3) > 0 then {
    return t1 + " | " + t2 + " | " + t3
  }
  return t1 + " | " + t2
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 7: TIER 1 SKILLS — Test Strategy Design
// ═══════════════════════════════════════════════════════════════════════

pattern TestStrategyDesign(project: String, testType: String, query: String, chat_id: String) -> String {
  let _ = AuditLog("skill_execute", QA_DEPT(), "test-strategy-design for " + project + " / " + testType)

  let prompt = "Ты QA-параноик отдела Тестирование Fosved Office. Проектируешь тест-стратегию.\n\n" +
    "ПРАВИЛА:\n" +
    "1. Без failure modes list стратегия недействительна (Rule 2)\n" +
    "2. Автоматизация обязательна — тест-пирамида: unit 70%, integration 20%, e2e 10%\n" +
    "3. Coverage цели: critical path ≥95%, business logic ≥90%, overall ≥80%\n" +
    "4. Каждый дефект обязан иметь регрессионный тест (Rule 3)\n" +
    "5. Security scan обязателен при наличии auth/payment/PII/user input\n\n" +
    "Тип теста: " + testType + "\n" +
    "Проект: " + project + "\n" +
    "Запрос: " + query + "\n\n" +
    "ВЫВОД (структура):\n" +
    "1. Цели тестирования (чёткие, измеримые)\n" +
    "2. Failure modes list (ОБЯЗАТЕЛЬНО — без него стратегия недействительна)\n" +
    "3. Тест-пирамида (unit/integration/e2e пропорции)\n" +
    "4. Coverage цели по компонентам\n" +
    "5. Среда (staging только, production запрещён)\n" +
    "6. Критерии приёмки\n" +
    "7. Риски и митигации"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 8: TIER 1 SKILLS — Failure Modes Mapping
// ═══════════════════════════════════════════════════════════════════════

pattern FailureModesMapping(component: String, query: String, chat_id: String) -> String {
  let _ = AuditLog("skill_execute", QA_DEPT(), "failure-modes-mapping for " + component)

  let prompt = "Ты QA-параноик. Строишь карту режимов отказа для компонента/системы.\n\n" +
    "ЖЁСТКИЕ ПРАВИЛА:\n" +
    "• Тест-стратегия без failure modes list — недействительна\n" +
    "• Каждый failure mode должен быть: описан, классифицирован, связан с тест-кейсом\n" +
    "• Неизбежные failure modes → мониторинг + алерты\n" +
    "• Необнаруживаемые failure modes → redesign (не тестировать, а исправить архитектуру)\n\n" +
    "Компонент: " + component + "\n" +
    "Контекст: " + query + "\n\n" +
    "ВЫВОД (структура):\n" +
    "1. Failure modes по категориям (functional, performance, security, data, integration, infrastructure)\n" +
    "2. Классификация каждого: likelihood (high/medium/low) × impact (critical/high/medium/low)\n" +
    "3. Detectability: detectable (test covers) / partially-detectable / undetectable (needs redesign)\n" +
    "4. Связанные тест-кейсы для каждого detectable mode\n" +
    "5. Неизбежные modes → мониторинг + алерты\n" +
    "6. Необнаруживаемые modes → рекомендации по redesign"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 9: TIER 1 SKILLS — Defect Discipline
// ═══════════════════════════════════════════════════════════════════════

pattern DefectDiscipline(project: String, query: String, chat_id: String) -> String {
  let _ = AuditLog("skill_execute", QA_DEPT(), "defect-discipline for " + project)

  let prompt = "Ты QA-педант. Управляешь дефектами по дисциплине.\n\n" +
    "ЖЁСТКИЕ ПРАВИЛА:\n" +
    "• Дефект без регрессионного теста не закрывается (Rule 3)\n" +
    "• Critical дефект → incident + RCA (Rule 9)\n" +
    "• Hotfix: critical всегда; high+production всегда\n" +
    "• MTTD ≤1ч для critical, MTTR ≤4ч для critical\n" +
    "• Escape rate ≤10% — целевой показатель\n\n" +
    "Жизненный цикл: open → acknowledged → in_progress → fixed → verified → wontfix/duplicate\n" +
    "Severity: critical, high, medium, low, trivial\n\n" +
    "Проект: " + project + "\n" +
    "Запрос: " + query + "\n\n" +
    "ВЫВОД: действие с дефектом + обоснование + следующие шаги"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 10: TIER 1 SKILLS — Regression Test Discipline
// ═══════════════════════════════════════════════════════════════════════

pattern RegressionTestDiscipline(project: String, defectId: String, chat_id: String) -> String {
  let _ = AuditLog("skill_execute", QA_DEPT(), "regression-test-discipline for defect " + defectId)

  // Get defect details
  let defectRows = db_execute(
    "SELECT severity, summary, status FROM defect_records WHERE id = ?",
    [defectId]
  )
  let defectInfo = "не найден"
  if length(defectRows) > 0 then { let defectInfo = defectRows }

  let prompt = "Ты QA-педант. Проектируешь регрессионный тест для дефекта.\n\n" +
    "ЖЁСТКОЕ ПРАВИЛО: Каждый закрытый дефект обязан иметь регрессионный тест. Без него дефект не закрывается.\n\n" +
    "Дефект #" + defectId + ": " + defectInfo + "\n" +
    "Проект: " + project + "\n\n" +
    "ВЫВОД (структура):\n" +
    "1. Описание регрессионного теста\n" +
    "2. Шаги воспроизведения\n" +
    "3. Ожидаемый результат (должен fail без фикса, pass после фикса)\n" +
    "4. Тип теста (unit/integration/e2e)\n" +
    "5. Добавление в CI pipeline (автоматизация)"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

