pattern ChaosEngineering(system: String, query: String, chat_id: String) -> String {
  let _ = AuditLog("skill_execute", QA_DEPT(), "chaos-engineering (Tier 3) for " + system)

  let prompt = "Ты QA-параноик. Проектируешь chaos engineering эксперименты.\n\n" +
    "Это Tier 3 skill — запускается только по явному запросу.\n\n" +
    "ПРАВИЛА:\n" +
    "• Hypothesis first — что ожидаем увидеть при отказе?\n" +
    "• Blast radius минимальный — staging only, never production without explicit approval\n" +
    "• Steady state → inject failure → observe → rollback\n" +
    "• Game days: scheduled, documented, reviewed\n" +
    "• Цель: доказать resilience, не сломать систему\n\n" +
    "Система: " + system + "\n" +
    "Контекст: " + query + "\n\n" +
    "ВЫВОД: chaos experiment plan, failure injections, expected system behavior, rollback procedures, observability requirements"

  let result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 18: AI EVAL RUN LOGIC
// ═══════════════════════════════════════════════════════════════════════

pattern CreateAIEvalRun(project: String, modelId: String, totalCases: String, chat_id: String) -> String {
  let _ = db_execute(
    "INSERT INTO ai_eval_runs (project, model_id, total_cases, status, groundedness_score, relevance_score, faithfulness_score, coherence_score, prompt_injection_score, overall_pass_rate, created_at, updated_at) VALUES (?, ?, ?, 'started', 0, 0, 0, 0, 0, 0, datetime('now'), datetime('now'))",
    [project, modelId, totalCases]
  )

  let idRows = query("SELECT LASTVAL() as id", [])
  let id = redact(to_string(json_get(parse_json(idRows), "0.id", "0")), "all")

  // Rule 6: Check minimum cases
  let cases = to_int(totalCases)
  if cases < to_int(QA_AI_MIN_CASES()) then {
    let _ = AuditLog("ai_eval_warning", QA_DEPT(), "AI eval run #" + to_string(id) + " with " + totalCases + " cases (minimum " + QA_AI_MIN_CASES() + ")")
  }

  let _ = AuditLog("ai_eval_created", QA_DEPT(), "AI eval run #" + to_string(id) + " for " + project + " / " + modelId)
  return to_string(id)
}



// ═══════════════════════════════════════════════════════════════════════
// SECTION 19: SECURITY AUDIT LOGIC
// ═══════════════════════════════════════════════════════════════════════

pattern CreateSecurityAudit(project: String, auditType: String, chat_id: String) -> String {
  if contains(QA_VALID_AUDIT_TYPES(), auditType) == false then {
    return "ОШИБКА: Недопустимый тип аудита '" + auditType + "'. Допустимые: " + QA_VALID_AUDIT_TYPES()
  }

  let _ = db_execute(
    "INSERT INTO security_audits (project, audit_type, status, findings_critical, findings_high, findings_medium, findings_low, created_at, updated_at) VALUES (?, ?, 'started', 0, 0, 0, 0, datetime('now'), datetime('now'))",
    [project, auditType]
  )

  let idRows = query("SELECT LASTVAL() as id", [])
  let id = redact(to_string(json_get(parse_json(idRows), "0.id", "0")), "all")

  let _ = AuditLog("security_audit_created", QA_DEPT(), "Security audit #" + to_string(id) + ": " + auditType + " for " + project)
  return to_string(id)
}


pattern GetSecurityAuditStatus(project: String) -> String {
  let rows = db_execute(
    "SELECT id, audit_type, status, findings_critical, findings_high, findings_medium, findings_low, completed_at FROM security_audits WHERE project = ? ORDER BY created_at DESC LIMIT 5",
    [project]
  )
  if length(rows) == 0 then {
    return "Security аудиты для проекта " + project + " не найдены."
  }
  return rows
}

