}

// ═══════════════════════════════════════════════════════════════════════
// FO-035 C.3: questions + run_spec по типам проектов (§5.5 ТЗ v3).
// «Модель не придумывает поля» — вопросы задаёт шаблон; модель только
// предлагает варианты ответов по цели проекта, владелец правит.
// run_spec — сборка/прогон/показ по типу (потребители: FO-037/FO-040).
// ═══════════════════════════════════════════════════════════════════════
pattern TemplateQuestions(template_id: String) -> String {
  if template_id == "landing" then { return "Какое действие главное на странице (заявка/покупка/подписка)?\nКакие блоки обязательны (герой, тарифы, отзывы, FAQ)?\nЕсть ли бренд-цвета/логотип?" }
  if template_id == "dashboard" then { return "Какие 3-5 метрик на главном экране?\nОткуда данные (API/БД/файл)?\nКто пользователь (роль, частота визитов)?" }
  if template_id == "ecommerce" then { return "Что продаём и сколько позиций?\nНужна ли корзина и оплата (какой провайдер)?\nКак принимаем заказы (почта/телеграм/CRM)?" }
  if template_id == "saas" then { return "Какая ключевая пользовательская история (одна фразой)?\nНужны ли роли/логины?\nЧто в MVP, а что потом?" }
  if template_id == "portfolio" then { return "Сколько работ и какого формата (картинки/видео/кейсы)?\nНужна ли страница 'обо мне' и контакты?\nЯзыки интерфейса?" }
  if template_id == "android" then { return "Какие 2-3 экрана в первой версии?\nЧто главное на каждом экране?\nНужна ли работа офлайн?" }
  if template_id == "ai_office" then { return "Какие департаменты нужны в первую очередь?\nОткуда бот берёт знания (документы/сайт)?\nКакие команды владельца самые частые?" }
  return "Какие 2-3 обязательных элемента результата?\nЧто считается успехом первой версии?"
}

pattern TemplateRunSpec(template_id: String) -> String {
  if template_id == "android" then { return "build: npx cap sync android && cd android && ./gradlew assembleDebug\nrun: статика + cap-обёртка\nshow: .apk в Telegram" }
  if template_id == "ai_office" then { return "build: pip install -r requirements.txt\nrun: python app.py / mlog serve\nshow: веб-превью порта" }
  return "build: npm install && npm run build (или статика без сборки)\nrun: статические файлы / dev-server\nshow: веб-превью"
}

// FO-044 B.1 (наряд #151): лимит виртуальной памяти прогона/превью по типу
// проекта (§5.5), КБ, RLIMIT_AS через `ulimit -v` (Go по спайку).
// Измерения спайка (scripts/spike_isolation.sh), локальный прокси: python
// живёт от 32 МБ VA (http.server — под 256 МБ); node резервирует ~1,2 ГБ VA
// — порог 1 ГБ его убивает, 1,3 ГБ хватает на минимум. Подтверждено прогоном
// на Render 2026-09-14 (Shell, вердикт в #151): python идентично (hog убит),
// node легче — VmSize 593 МБ, жив даже при пороге 1 ГБ. VA ≠ RAM: резидентную
// память по-прежнему ограничивает cgroup Render free (512 МБ) — 2 ГБ VA не
// дают 2 ГБ RAM.
// Глобальный оверрайд для эксплуатации: env FORGE_RUN_VLIMIT_KB (forge.mlog).
pattern TemplateRunMemLimit(template_id: String) -> String {
  if template_id == "android" then { return "262144" }
  if template_id == "ai_office" then { return "262144" }
  // site-типы (landing/dashboard/ecommerce/saas/portfolio) и неизвестные —
  // node-совместимый порог 2 ГБ VA
  return "2097152"
}
