// FOIP-003.8: Vertical Project Templates
// 5 ready-made architectures for common project types.
// Each template: tech stack, file structure, key components, dependencies.
// Dev selects template by DetectTaskType match, includes in call_llm prompt.

pattern TemplateList() -> String {
  return "landing, dashboard, ecommerce, saas, portfolio"
}

pattern TemplateGet(type: String) -> String {
  if type == "landing" then { return TemplateLanding() }
  if type == "dashboard" then { return TemplateDashboard() }
  if type == "ecommerce" then { return TemplateEcommerce() }
  if type == "saas" then { return TemplateSaaS() }
  if type == "portfolio" then { return TemplatePortfolio() }
  return ""
}

pattern MatchTemplate(task_type: String, query: String) -> String {
  let q = lower(query)
  if task_type == "site" or contains(q, "лендинг") or contains(q, "landing") then { return "landing" }
  if contains(q, "дашборд") or contains(q, "dashboard") or contains(q, "аналитик") then { return "dashboard" }
  if contains(q, "интернет-магазин") or contains(q, "ecommerce") or contains(q, "каталог") then { return "ecommerce" }
  if contains(q, "saas") or contains(q, "платформ") or contains(q, "мультитенант") then { return "saas" }
  if contains(q, "портфолио") or contains(q, "gallery") or contains(q, "витрин") then { return "portfolio" }
  return ""
}

pattern TemplateLanding() -> String {
  return "=== TEMPLATE: LANDING PAGE ===\n"
    + "Tech: Next.js 14 (App Router) + Tailwind CSS + TypeScript\n"
    + "Structure:\n"
    + "  app/layout.tsx — root layout with metadata\n"
    + "  app/page.tsx — landing page (all sections)\n"
    + "  app/globals.css — Tailwind + custom CSS variables\n"
    + "  components/hero.tsx — hero section with CTA\n"
    + "  components/features.tsx — 3-column features grid\n"
    + "  components/pricing.tsx — pricing table (3 tiers)\n"
    + "  components/testimonials.tsx — client testimonials carousel\n"
    + "  components/faq.tsx — accordion FAQ\n"
    + "  components/footer.tsx — footer with links + contacts\n"
    + "  public/ — static assets (logo, og-image)\n"
    + "Key: Mobile-first, Lighthouse 95+, SEO metadata, semantic HTML\n"
    + "Deploy: Vercel (free tier) or Render\n"
    + "=== END TEMPLATE ==="
}

