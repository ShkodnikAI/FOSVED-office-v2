// FOIP-003.8: Vertical Project Templates
// 5 ready-made architectures for common project types.
// Each template: tech stack, file structure, key components, dependencies.
// Dev selects template by DetectTaskType match, includes in call_llm prompt.

pattern TemplateList() -> String {
  return "landing, dashboard, ecommerce, saas, portfolio"
}

pattern TemplateGet(type: String) -> String {
  if type == "landing" then { return TemplateLanding() }
  if type == "dashboard" then { return TemplateDashboard() }
  if type == "ecommerce" then { return TemplateEcommerce() }
  if type == "saas" then { return TemplateSaaS() }
  if type == "portfolio" then { return TemplatePortfolio() }
  return ""
}

pattern MatchTemplate(task_type: String, query: String) -> String {
  let q = lower(query)
  if task_type == "site" or contains(q, "лендинг") or contains(q, "landing") then { return "landing" }
  if contains(q, "дашборд") or contains(q, "dashboard") or contains(q, "аналитик") then { return "dashboard" }
  if contains(q, "интернет-магазин") or contains(q, "ecommerce") or contains(q, "каталог") then { return "ecommerce" }
  if contains(q, "saas") or contains(q, "платформ") or contains(q, "мультитенант") then { return "saas" }
  if contains(q, "портфолио") or contains(q, "gallery") or contains(q, "витрин") then { return "portfolio" }
  return ""
}

pattern TemplateLanding() -> String {
  return "=== TEMPLATE: LANDING PAGE ===\n"
    + "Tech: Next.js 14 (App Router) + Tailwind CSS + TypeScript\n"
    + "Structure:\n"
    + "  app/layout.tsx — root layout with metadata\n"
    + "  app/page.tsx — landing page (all sections)\n"
    + "  app/globals.css — Tailwind + custom CSS variables\n"
    + "  components/hero.tsx — hero section with CTA\n"
    + "  components/features.tsx — 3-column features grid\n"
    + "  components/pricing.tsx — pricing table (3 tiers)\n"
    + "  components/testimonials.tsx — client testimonials carousel\n"
    + "  components/faq.tsx — accordion FAQ\n"
    + "  components/footer.tsx — footer with links + contacts\n"
    + "  public/ — static assets (logo, og-image)\n"
    + "Key: Mobile-first, Lighthouse 95+, SEO metadata, semantic HTML\n"
    + "Deploy: Vercel (free tier) or Render\n"
    + "=== END TEMPLATE ==="
}

pattern TemplateDashboard() -> String {
  return "=== TEMPLATE: DASHBOARD ===\n"
    + "Tech: Next.js 14 (App Router) + Tailwind CSS + Recharts + TypeScript\n"
    + "Structure:\n"
    + "  app/layout.tsx — root layout\n"
    + "  app/page.tsx — redirect to /dashboard\n"
    + "  app/dashboard/layout.tsx — sidebar + header layout\n"
    + "  app/dashboard/page.tsx — main dashboard (KPI cards + charts)\n"
    + "  app/dashboard/analytics/page.tsx — detailed analytics\n"
    + "  app/dashboard/settings/page.tsx — user settings\n"
    + "  components/sidebar.tsx — navigation sidebar (collapsible)\n"
    + "  components/kpi-card.tsx — KPI metric card\n"
    + "  components/chart.tsx — reusable chart wrapper (Recharts)\n"
    + "  components/data-table.tsx — sortable/filterable table\n"
    + "  lib/auth.ts — session management\n"
    + "  lib/api.ts — API client for data fetching\n"
    + "Key: Responsive sidebar, dark mode, real-time updates via SWR\n"
    + "Deploy: Vercel + API routes for data\n"
    + "=== END TEMPLATE ==="
}

pattern TemplateEcommerce() -> String {
  return "=== TEMPLATE: ECOMMERCE ===\n"
    + "Tech: Next.js 14 (App Router) + Tailwind CSS + Stripe + Prisma + PostgreSQL\n"
    + "Structure:\n"
    + "  app/layout.tsx — root layout\n"
    + "  app/page.tsx — homepage with featured products\n"
    + "  app/products/page.tsx — product catalog (grid + filters)\n"
    + "  app/products/[id]/page.tsx — product detail\n"
    + "  app/cart/page.tsx — shopping cart\n"
    + "  app/checkout/page.tsx — Stripe checkout\n"
    + "  app/orders/page.tsx — order history\n"
    + "  app/api/checkout/route.ts — Stripe webhook handler\n"
    + "  app/api/products/route.ts — products CRUD\n"
    + "  components/product-card.tsx — product card with image + price\n"
    + "  components/cart-item.tsx — cart line item (qty +/-)\n"
    + "  components/filters.tsx — category/price/rating filters\n"
    + "  prisma/schema.prisma — Product, Order, User models\n"
    + "  lib/stripe.ts — Stripe client init\n"
    + "Key: SSR for SEO product pages, optimistic cart updates, Stripe webhooks\n"
    + "Deploy: Vercel + Render (PostgreSQL) + Stripe\n"
    + "=== END TEMPLATE ==="
}

pattern TemplateSaaS() -> String {
  return "=== TEMPLATE: SAAS PLATFORM ===\n"
    + "Tech: Next.js 14 (App Router) + Tailwind CSS + NextAuth + Prisma + PostgreSQL + Stripe\n"
    + "Structure:\n"
    + "  app/layout.tsx — root layout\n"
    + "  app/(auth)/login/page.tsx — login page\n"
    + "  app/(auth)/register/page.tsx — registration\n"
    + "  app/(dashboard)/layout.tsx — protected dashboard layout\n"
    + "  app/(dashboard)/page.tsx — main dashboard\n"
    + "  app/(dashboard)/settings/page.tsx — account + billing\n"
    + "  app/(dashboard)/billing/page.tsx — subscription management\n"
    + "  app/api/auth/[...nextauth]/route.ts — NextAuth config\n"
    + "  app/api/stripe/webhook/route.ts — billing webhook\n"
    + "  app/api/stripe/portal/route.ts — customer portal\n"
    + "  middleware.ts — auth guard for protected routes\n"
    + "  components/pricing-table.tsx — 3-tier pricing with Stripe\n"
    + "  components/usage-meter.tsx — usage bar (X of Y used)\n"
    + "  lib/auth.ts — NextAuth configuration\n"
    + "  lib/stripe.ts — Stripe + subscription helpers\n"
    + "  prisma/schema.prisma — User, Account, Subscription models\n"
    + "Key: Multi-tenant, role-based access, subscription lifecycle, usage limits\n"
    + "Deploy: Vercel + Render (PostgreSQL) + Stripe + Resend (emails)\n"
    + "=== END TEMPLATE ==="
}

