    + "Structure:\n"
    + "  app/layout.tsx — root layout\n"
    + "  app/page.tsx — redirect to /dashboard\n"
    + "  app/dashboard/layout.tsx — sidebar + header layout\n"
    + "  app/dashboard/page.tsx — main dashboard (KPI cards + charts)\n"
    + "  app/dashboard/analytics/page.tsx — detailed analytics\n"
    + "  app/dashboard/settings/page.tsx — user settings\n"
    + "  components/sidebar.tsx — navigation sidebar (collapsible)\n"
    + "  components/kpi-card.tsx — KPI metric card\n"
    + "  components/chart.tsx — reusable chart wrapper (Recharts)\n"
    + "  components/data-table.tsx — sortable/filterable table\n"
    + "  lib/auth.ts — session management\n"
    + "  lib/api.ts — API client for data fetching\n"
    + "Key: Responsive sidebar, dark mode, real-time updates via SWR\n"
    + "Deploy: Vercel + API routes for data\n"
