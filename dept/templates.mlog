}

pattern TemplateEcommerce() -> String {
  return "=== TEMPLATE: ECOMMERCE ===\n"
    + "Tech: Next.js 14 (App Router) + Tailwind CSS + Stripe + Prisma + PostgreSQL\n"
    + "Structure:\n"
    + "  app/layout.tsx — root layout\n"
    + "  app/page.tsx — homepage with featured products\n"
    + "  app/products/page.tsx — product catalog (grid + filters)\n"
    + "  app/products/[id]/page.tsx — product detail\n"
    + "  app/cart/page.tsx — shopping cart\n"
    + "  app/checkout/page.tsx — Stripe checkout\n"
    + "  app/orders/page.tsx — order history\n"
    + "  app/api/checkout/route.ts — Stripe webhook handler\n"
    + "  app/api/products/route.ts — products CRUD\n"
    + "  components/product-card.tsx — product card with image + price\n"
    + "  components/cart-item.tsx — cart line item (qty +/-)\n"
    + "  components/filters.tsx — category/price/rating filters\n"
    + "  prisma/schema.prisma — Product, Order, User models\n"
    + "  lib/stripe.ts — Stripe client init\n"
    + "Key: SSR for SEO product pages, optimistic cart updates, Stripe webhooks\n"
    + "Deploy: Vercel + Render (PostgreSQL) + Stripe\n"
    + "=== END TEMPLATE ==="
}

pattern TemplateSaaS() -> String {
  return "=== TEMPLATE: SAAS PLATFORM ===\n"
    + "Tech: Next.js 14 (App Router) + Tailwind CSS + NextAuth + Prisma + PostgreSQL + Stripe\n"
    + "Structure:\n"
    + "  app/layout.tsx — root layout\n"
    + "  app/(auth)/login/page.tsx — login page\n"
    + "  app/(auth)/register/page.tsx — registration\n"
    + "  app/(dashboard)/layout.tsx — protected dashboard layout\n"
    + "  app/(dashboard)/page.tsx — main dashboard\n"
    + "  app/(dashboard)/settings/page.tsx — account + billing\n"
    + "  app/(dashboard)/billing/page.tsx — subscription management\n"
    + "  app/api/auth/[...nextauth]/route.ts — NextAuth config\n"
    + "  app/api/stripe/webhook/route.ts — billing webhook\n"
    + "  app/api/stripe/portal/route.ts — customer portal\n"
    + "  middleware.ts — auth guard for protected routes\n"
    + "  components/pricing-table.tsx — 3-tier pricing with Stripe\n"
    + "  components/usage-meter.tsx — usage bar (X of Y used)\n"
    + "  lib/auth.ts — NextAuth configuration\n"
    + "  lib/stripe.ts — Stripe + subscription helpers\n"
    + "  prisma/schema.prisma — User, Account, Subscription models\n"
    + "Key: Multi-tenant, role-based access, subscription lifecycle, usage limits\n"
    + "Deploy: Vercel + Render (PostgreSQL) + Stripe + Resend (emails)\n"
    + "=== END TEMPLATE ==="
}

