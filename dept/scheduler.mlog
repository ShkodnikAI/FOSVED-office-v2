// Fosved Office v2 — Scheduler (NARAD-17)
// All patterns delegate to Python proxy endpoints at :4000
// which perform the actual LLM calls and Telegram delivery.
// The mlog layer collects data, builds payloads, and triggers the proxy.

// ---------------------------------------------------------------------------
// 1. Morning Brief — 07:20 MSK daily (4:20 UTC)
// Яна: дата, время, погода, статус офиса, мировые события, находки ЛЗ
// Endpoint сам собирает погоду, метрики, LZ-находки.
// ---------------------------------------------------------------------------
pattern MorningBrief() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // Delegate to proxy — endpoint collects weather, metrics, LZ findings itself
  let payload = json_encode({owner_id: owner_id})
  let _ = try http_post("http://127.0.0.1:4000/scheduler/morning-brief", payload, "application/json")

  // Audit
  let _ = AuditLog("morning_brief", "scheduler", "morning brief triggered (weather + office + world events + LZ)")

  return "ok"
}

// ---------------------------------------------------------------------------
// 2. Evening Summary — 21:00 daily
// ---------------------------------------------------------------------------
pattern EveningSummary() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- Collect today's metrics (last 12 hours) ---
  let task_rows = query("SELECT COUNT(*) as cnt FROM dialog_history WHERE created_at > datetime('now', '-12 hours')", [])
  let tasks_today = to_string(json_get(to_string(task_rows), "[0].cnt", "0"))

  let dept_rows = query("SELECT DISTINCT dept FROM dialog_history WHERE created_at > datetime('now', '-12 hours')", [])
  let depts_active = json_encode(dept_rows)

  let sat_rows = query("SELECT ROUND(AVG(metric_value), 1) as avg_score FROM dept_metrics WHERE created_at > datetime('now', '-12 hours') AND metric_name = 'satisfaction'", [])
  let avg_score = to_string(json_get(to_string(sat_rows), "[0].avg_score", "0"))

  // --- Build prompt ---
  let prompt = "Ty — Yana. Sostav' vechernij svod. Kratko:\n"
  let prompt = prompt + "- Zadach za 12ch: " + tasks_today + "\n"
  let prompt = prompt + "- Otdely rabotali: " + depts_active + "\n"
  let prompt = prompt + "- Srednyaya ocenka: " + avg_score + "\n"
  let prompt = prompt + "Chto perenesti na zavtra, na chyom akcentirovat'."

  // --- Read Yana profile ---
  let yana_profile = read_file("library/yana.md")

  // --- Delegate to proxy ---
  let payload = json_encode({
    owner_id: owner_id,
    tasks_12h: tasks_today,
    depts_active: depts_active,
    avg_satisfaction: avg_score,
    prompt: prompt,
    yana_profile: yana_profile
  })
  let _ = try http_post("http://127.0.0.1:4000/scheduler/evening-summary", payload, "application/json")

  // --- Audit ---
  let _ = AuditLog("evening_summary", "scheduler", "triggered with " + tasks_today + " tasks, avg score " + avg_score)

  return "ok"
}

// ---------------------------------------------------------------------------
// 3. Weekly Digest — Monday 09:00
// ---------------------------------------------------------------------------
pattern WeeklyDigest() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- Collect 7-day metrics ---
  let task_rows = query("SELECT COUNT(*) as cnt FROM channel_archive WHERE archived_at > datetime('now', '-7 days')", [])
  let tasks_week = to_string(json_get(to_string(task_rows), "[0].cnt", "0"))

  let top_rows = query("SELECT dept, COUNT(*) as cnt FROM channel_archive WHERE archived_at > datetime('now', '-7 days') GROUP BY dept ORDER BY cnt DESC LIMIT 5", [])
  let top_depts = json_encode(top_rows)

  let sat_rows = query("SELECT ROUND(AVG(metric_value), 1) as avg_score FROM dept_metrics WHERE created_at > datetime('now', '-7 days') AND metric_name = 'satisfaction'", [])
  let avg_score = to_string(json_get(to_string(sat_rows), "[0].avg_score", "0"))

  let corr_rows = query("SELECT COUNT(*) as cnt FROM adapt_corrections WHERE created_at > datetime('now', '-7 days')", [])
  let corrections_week = to_string(json_get(to_string(corr_rows), "[0].cnt", "0"))

  let narad_rows = query("SELECT COUNT(*) as cnt FROM narads WHERE created_at > datetime('now', '-7 days')", [])
  let narads_week = to_string(json_get(to_string(narad_rows), "[0].cnt", "0"))

  // --- Read Yana profile ---
  let yana_profile = read_file("library/yana.md")

  // --- Build prompt ---
  let prompt = "Ty — Yana. Nedel'nyj daydzhest:\n"
  let prompt = prompt + "- Zadach: " + tasks_week + "\n"
  let prompt = prompt + "- Top otdely: " + top_depts + "\n"
  let prompt = prompt + "- Srednyaya ocenka: " + avg_score + "\n"
  let prompt = prompt + "- Korrekcij: " + corrections_week + "\n"
  let prompt = prompt + "- Naryadov: " + narads_week + "\n"
  let prompt = prompt + "Vydeli trendy, problemy, rekomendacii."

  // --- Delegate to proxy ---
  let payload = json_encode({
    owner_id: owner_id,
    tasks_7d: tasks_week,
    top_depts: top_depts,
    avg_satisfaction: avg_score,
    corrections_7d: corrections_week,
    narads_7d: narads_week,
    prompt: prompt,
    yana_profile: yana_profile
  })
  let _ = try http_post("http://127.0.0.1:4000/scheduler/weekly-digest", payload, "application/json")

  // --- Audit ---
  let _ = AuditLog("weekly_digest", "scheduler", "triggered with " + tasks_week + " tasks, " + corrections_week + " corrections, " + narads_week + " narads")

  return "ok"
}

// ---------------------------------------------------------------------------
// 4. Monthly Review — 1st of month, 10:00
// TODO: quarterly review trigger — every 3 months, run /quarterly-review for each active dept
// Trigger: first Monday of Jan/Apr/Jul/Oct
// ---------------------------------------------------------------------------
pattern MonthlyReview() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- All 12 departments ---
  let depts = ["osp", "lz", "expert", "marketing", "finance", "legal", "dev", "design", "qa", "visual", "engineering", "kavalnya"]

  let metrics_summary = ""
  each dept in depts {
    // Task count (30 days)
    let task_rows = query("SELECT COUNT(*) as cnt FROM channel_archive WHERE dept = ? AND archived_at > datetime('now', '-30 days')", [dept])
    let task_count = to_string(json_get(to_string(task_rows), "[0].cnt", "0"))

    // Average satisfaction (30 days)
    let sat_rows = query("SELECT ROUND(AVG(metric_value), 1) as avg_score FROM dept_metrics WHERE dept = ? AND metric_name = 'satisfaction' AND created_at > datetime('now', '-30 days')", [dept])
    let avg_sat = to_string(json_get(to_string(sat_rows), "[0].avg_score", "0"))

    // Corrections (30 days)
    let corr_rows = query("SELECT COUNT(*) as cnt FROM adapt_corrections WHERE dept = ? AND created_at > datetime('now', '-30 days')", [dept])
    let corr_count = to_string(json_get(to_string(corr_rows), "[0].cnt", "0"))

    let metrics_summary = metrics_summary + dept + ": " + task_count + " zadach, ocenka " + avg_sat + ", " + corr_count + " korrekcij\n"
  }

  // --- Read Yana profile ---
  let yana_profile = read_file("library/yana.md")

  // --- Build prompt ---
  let prompt = "Ty — Yana. Ezhemesyachnyj review ofisa:\n\n" + metrics_summary + "\n"
  let prompt = prompt + "Analiz:\n"
  let prompt = prompt + "1. Kakie otdely rabotali luchshe vsego\n"
  let prompt = prompt + "2. Kakie degradisirovali\n"
  let prompt = prompt + "3. Kakie ne ispol'zovalis'\n"
  let prompt = prompt + "4. Rekomendacii po uluchsheniyu\n"
  let prompt = prompt + "5. Predlozhit' rekalibrovku dlya otdelov s ocenkoj < 3"

  // --- Delegate to proxy ---
  let payload = json_encode({
    owner_id: owner_id,
    metrics_summary: metrics_summary,
    prompt: prompt,
    yana_profile: yana_profile
  })
  let _ = try http_post("http://127.0.0.1:4000/scheduler/monthly-review", payload, "application/json")

  // --- Audit ---
  let _ = AuditLog("monthly_review", "scheduler", "triggered for 12 departments")

  return "ok"
}

// ---------------------------------------------------------------------------
// 5. Control Check — daily 12:00, verifies predictions on watch
// ---------------------------------------------------------------------------
pattern ControlCheck() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- Fetch all control watches from system_settings ---
  let controls = query("SELECT key, value FROM system_settings WHERE key LIKE 'control_%'", [])

  let checks_data = ""
  let checks_done = 0.0

  each row in controls {
    let ctrl_key = json_get(to_string(row), "key", "")
    let ctrl_val = json_get(to_string(row), "value", "")

    // Value format: "daily|Topic" / "weekly|Topic" / "monthly|Topic"
    let parts = split(ctrl_val, "|")
    let freq = ""
    let topic = ""
    if len(parts) > 0.0 then { let freq = trim(get(parts, 0.0)) }
    if len(parts) > 1.0 then { let topic = trim(get(parts, 1.0)) }

    // Only verify daily watches in this cron
    if freq == "daily" then {
      // Extract doc_id from key (strip "control_" prefix)
      let doc_id = replace(ctrl_key, "control_", "")

      // Get original prediction from miniapp_responses
      let pred_rows = query("SELECT raw_text FROM miniapp_responses WHERE id = ?", [doc_id])
      let original_prediction = ""
      if len(to_string(pred_rows)) > 2.0 then {
        let original_prediction = json_get(to_string(pred_rows), "[0].raw_text", "")
      }

      // Append to checks data for proxy
      let checks_data = checks_data + "DOC:" + doc_id + "|TOPIC:" + topic + "|PRED:" + substring(original_prediction, 0, 2000) + "\n---\n"
      let checks_done = checks_done + 1.0
    }
  }

  // --- Read OSP profile for context ---
  let osp_profile = read_file("library/osp.md")

  // --- Delegate to proxy (even if 0 daily checks, proxy may handle weekly/monthly logic) ---
  let payload = json_encode({
    owner_id: owner_id,
    checks_done: to_string(checks_done),
    checks_data: checks_data,
    osp_profile: osp_profile
  })
  let _ = try http_post("http://127.0.0.1:4000/scheduler/control-check", payload, "application/json")

  // --- Audit ---
  if checks_done > 0.0 then {
    let _ = AuditLog("control_check", "scheduler", to_string(checks_done) + " daily predictions verified")
  } else {
    let _ = AuditLog("control_check", "scheduler", "no daily watches to verify")
  }

  return "ok"
}

// ---------------------------------------------------------------------------
// 6. Yana Self-Learn — daily, triggered from MorningBrief
// ---------------------------------------------------------------------------
pattern YanaSelfLearn() -> String {
  // --- Read Yana profile ---
  let yana_profile = read_file("library/yana.md")

  // --- Collect recent corrections as learning material ---
  let corr_rows = query("SELECT dept, original_query, correction FROM adapt_corrections WHERE created_at > datetime('now', '-7 days') ORDER BY created_at DESC LIMIT 20", [])
  let corrections_data = json_encode(corr_rows)

  // --- Delegate to proxy ---
  let payload = json_encode({
    yana_profile: yana_profile,
    recent_corrections: corrections_data
  })
  let _ = try http_post("http://127.0.0.1:4000/scheduler/self-learn", payload, "application/json")

  // --- Audit ---
  let _ = AuditLog("self_learn", "scheduler", "self-learn cycle triggered")

  return "ok"
}

// ---------------------------------------------------------------------------
// 7. Monthly Debrief per department — on-demand or scheduled
// ---------------------------------------------------------------------------
pattern MonthlyDebrief(dept: String) -> String {
  // --- Collect corrections for the department (last 30 days) ---
  let corr_rows = query("SELECT original_query, correction, created_at FROM adapt_corrections WHERE dept = ? AND created_at > datetime('now', '-30 days') ORDER BY created_at DESC LIMIT 50", [dept])
  let corrections_data = json_encode(corr_rows)

  // --- Delegate to proxy ---
  let payload = json_encode({
    dept: dept,
    corrections: corrections_data
  })
  let result = try http_post("http://127.0.0.1:4000/learning/debrief", payload, "application/json")

  // --- Audit ---
  let _ = AuditLog("monthly_debrief", "scheduler", "debrief for " + dept)

  return result
}

// ---------------------------------------------------------------------------
// 8. Reminder Check — every 5 min, sends due reminders
// ---------------------------------------------------------------------------
pattern ReminderCheck() -> String {
  let payload = json_encode("")
  let result = try http_post("http://127.0.0.1:4000/scheduler/reminder-check", payload, "application/json")
  if to_string(result) == "()" then { return "ok" }
  let sent = json_get(parse_json(result), "sent", "0")
  if sent != "0" then {
    let _ = AuditLog("reminder_check", "scheduler", sent + " reminders sent")
  }
  return "ok"
}
