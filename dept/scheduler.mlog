// FO-001: ежедневный бэкап главной БД (нативный слот; тело /cron/backup).
// VACUUM INTO — не деструктивная операция (скан DROP/DELETE/TRUNCATE/ALTER).
pattern DbBackupSlot() -> String {
  let _ = InitDB()
  let ts_rows = query("SELECT strftime('%Y%m%dT%H%M%SZ', 'now') AS t", [])
  let ts = "unknown"
  each r in ts_rows {
    let ts = redact(to_string(json_get(r, "t", "unknown")), "all")
  }
  let path = "/var/data/backups/fosved.db." + ts
  let _ = db_execute("VACUUM INTO ?", [path])
  let check_rows = query("PRAGMA integrity_check", [])
  let integrity = "no-result"
  each cr in check_rows {
    let integrity = redact(to_string(json_get(cr, "integrity_check", "no-result")), "all")
  }
  let _ = AuditLog("cron_backup", "system", path + " integrity=" + integrity)
  return "backup ok: " + path
}

// ── #255, консолидация 2026-09-21: ночная корзина (нативный слот) ──────────
// Тело /cron/night-tick: диспетчер обходит /cron/*-роуты по порядку —
// backup → indicator-reminders → shop-tick → golden-evals → night.
// Итог цепочки — одним сообщением в Telegram. Секрет нужен внутренним
// HTTP-вызовам (роуты остаются ручным/аварийным фолбэком — п.4 наряда).
pattern NightTickSlot() -> String {
  let _ = InitDB()
  let base = "http://127.0.0.1:4000/cron/"
  let qs = "?secret=" + env("CRON_SECRET")

  let mut report = "night-tick:"
  let r_backup = redact(to_string(TryVal(try http_get(base + "backup" + qs, 300.0))), "all")
  if to_string(r_backup) == "()" then { report = report + " backup=FAIL" } else { report = report + " backup=ok" }
  let r_ind = redact(to_string(TryVal(try http_get(base + "indicator-reminders" + qs, 300.0))), "all")
  if to_string(r_ind) == "()" then { report = report + " indicators=FAIL" } else { report = report + " indicators=ok" }
  let r_shop = redact(to_string(TryVal(try http_get(base + "shop-tick" + qs, 300.0))), "all")
  if to_string(r_shop) == "()" then { report = report + " shop=FAIL" } else { report = report + " shop=ok" }
  let r_evals = redact(to_string(TryVal(try http_get(base + "golden-evals" + qs, 300.0))), "all")
  if to_string(r_evals) == "()" then { report = report + " evals=FAIL" } else { report = report + " evals=ok" }
  let r_night = redact(to_string(TryVal(try http_get(base + "night" + qs, 600.0))), "all")
  if to_string(r_night) == "()" then { report = report + " night=запущен(фоном)" } else { report = report + " night=ok" }
  let _ = AuditLog("cron_night_tick", "system", report)
  let _ = SendTelegramReply(env("OWNER_TELEGRAM_ID"), report)
  return report
}
