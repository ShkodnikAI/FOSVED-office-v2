// Fosved Office v2 — Scheduler (NARAD-17)
// MIGRATED: EveningSummary, WeeklyDigest, MonthlyReview, ControlCheck, YanaSelfLearn
// now use native call_llm + SendTelegramReplyMDV2 instead of Python proxy.
// MorningBrief and ReminderCheck still delegate (complex: weather API / RRULE logic).

// ---------------------------------------------------------------------------
// 1. Morning Brief — 07:20 MSK daily (4:20 UTC)
// Яна: дата, время, погода, статус офиса, мировые события, находки ЛЗ
// STILL DELEGATED: Python endpoint collects weather, metrics, LZ findings.
// Migration path: add http_get for OpenWeatherMap API → then migrate.
// ---------------------------------------------------------------------------
pattern MorningBrief() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- P3-1: mlog collects SQL data, Python adds weather + credentials + LLM ---
  // Dialog count (24h)
  let dialog_rows = query("SELECT COUNT(*) as cnt FROM dialog_history WHERE created_at > datetime('now', '-24 hours')", [])
  let dialog_24h = to_string(json_get(dialog_rows[0], "cnt", "0"))

  // Active departments (24h)
  let dept_rows = query("SELECT DISTINCT dept FROM dialog_history WHERE created_at > datetime('now', '-24 hours')", [])
  let mut active_depts = "["
  let mut adi = 0
  each row in dept_rows {
    if adi > 0 then { let active_depts = active_depts + "," }
    let d = to_string(json_get(row, "dept", ""))
    let active_depts = active_depts + "\"" + d + "\""
    let adi = adi + 1
  }
  let active_depts = active_depts + "]"

  // Pending narads
  let narad_rows = query("SELECT COUNT(*) as cnt FROM narads WHERE status = 'pending'", [])
  let narads_pending = to_string(json_get(narad_rows[0], "cnt", "0"))

  // Recent corrections (24h)
  let corr_rows = query("SELECT COUNT(*) as cnt FROM adapt_corrections WHERE created_at > datetime('now', '-24 hours')", [])
  let corrections_24h = to_string(json_get(corr_rows[0], "cnt", "0"))

  // Token usage yesterday (calls + cost)
  let usage_rows = query("SELECT COUNT(*) as cnt, COALESCE(SUM(cost_usd),0) as cost FROM token_usage WHERE created_at >= date('now', '-1 day')", [])
  let calls_yesterday = to_string(json_get(usage_rows[0], "cnt", "0"))
  let cost_yesterday = to_string(json_get(usage_rows[0], "cost", "0"))

  // Top departments by usage (24h)
  let top_dept_rows = query("SELECT dept, COUNT(*) as cnt FROM token_usage WHERE created_at > datetime('now', '-24 hours') GROUP BY dept ORDER BY cnt DESC LIMIT 5", [])
  let mut top_depts = "["
  let mut tdi = 0
  each row in top_dept_rows {
    if tdi > 0 then { let top_depts = top_depts + "," }
    let td = to_string(json_get(row, "dept", ""))
    let tc = to_string(json_get(row, "cnt", "0"))
    let top_depts = top_depts + "{\"dept\":\"" + td + "\",\"calls\":" + tc + "}"
    let tdi = tdi + 1
  }
  let top_depts = top_depts + "]"

  // Delegate to proxy with pre-collected SQL data
  let payload = json_encode({
    owner_id: owner_id,
    dialog_24h: dialog_24h,
    active_depts: active_depts,
    narads_pending: narads_pending,
    corrections_24h: corrections_24h,
    calls_yesterday: calls_yesterday,
    cost_yesterday: cost_yesterday,
    top_depts: top_depts
  })
  let _ = try http_post("http://127.0.0.1:4000/scheduler/morning-brief", payload, "application/json")

  // Audit
  let _ = AuditLog("morning_brief", "scheduler", "morning brief triggered (mlog SQL: " + dialog_24h + " dialogs, " + narads_pending + " pending narads)")

  return "ok"
}

// ---------------------------------------------------------------------------
// 2. Evening Summary — 21:00 daily (MIGRATED to native call_llm)
// ---------------------------------------------------------------------------
pattern EveningSummary() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- Collect today's metrics (last 12 hours) ---
  let task_rows = query("SELECT COUNT(*) as cnt FROM dialog_history WHERE created_at > datetime('now', '-12 hours')", [])
  let tasks_today = "0"
  each r in task_rows { let tasks_today = to_string(json_get(r, "cnt", "0")) }

  let dept_rows = query("SELECT DISTINCT dept FROM dialog_history WHERE created_at > datetime('now', '-12 hours')", [])
  let depts_active = json_encode(dept_rows)

  let sat_rows = query("SELECT ROUND(AVG(metric_value), 1) as avg_score FROM dept_metrics WHERE created_at > datetime('now', '-12 hours') AND metric_name = 'satisfaction'", [])
  let avg_score = "0"
  each r in sat_rows { let avg_score = to_string(json_get(r, "avg_score", "0")) }

  // --- Build prompt ---
  let prompt = "Ты — Яна. Составь вечернюю сводку. Кратко:\n"
  let prompt = prompt + "- Задач за 12ч: " + tasks_today + "\n"
  let prompt = prompt + "- Отделы работали: " + depts_active + "\n"
  let prompt = prompt + "- Средняя оценка: " + avg_score + "\n"
  let prompt = prompt + "Что перенести на завтра, на чём акцентировать."

  // --- Read Yana profile ---
  let yana_profile = read_file("library/yana.md")

  // --- Native LLM call ---
  let llm_result = try call_llm(yana_profile, prompt)

  if to_string(llm_result) != "()" then {
    let reply = to_string(llm_result)
    let _ = SendTelegramReply(owner_id, "🌙 Вечерняя сводка\n\n" + reply)
  } else {
    let _ = SendTelegramReply(owner_id, "🌙 Вечерняя сводка: не удалось сгенерировать (LLM недоступна).")
  }

  // --- Audit ---
  let _ = AuditLog("evening_summary", "scheduler", "completed with " + tasks_today + " tasks, avg score " + avg_score)

  return "ok"
}

// ---------------------------------------------------------------------------
// 3. Weekly Digest — Monday 09:00 (MIGRATED to native call_llm)
// ---------------------------------------------------------------------------
pattern WeeklyDigest() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- Collect 7-day metrics ---
  let task_rows = query("SELECT COUNT(*) as cnt FROM channel_archive WHERE archived_at > datetime('now', '-7 days')", [])
  let tasks_week = "0"
  each r in task_rows { let tasks_week = to_string(json_get(r, "cnt", "0")) }

  let top_rows = query("SELECT dept, COUNT(*) as cnt FROM channel_archive WHERE archived_at > datetime('now', '-7 days') GROUP BY dept ORDER BY cnt DESC LIMIT 5", [])
  let top_depts = json_encode(top_rows)

  let sat_rows = query("SELECT ROUND(AVG(metric_value), 1) as avg_score FROM dept_metrics WHERE created_at > datetime('now', '-7 days') AND metric_name = 'satisfaction'", [])
  let avg_score = "0"
  each r in sat_rows { let avg_score = to_string(json_get(r, "avg_score", "0")) }

  let corr_rows = query("SELECT COUNT(*) as cnt FROM adapt_corrections WHERE created_at > datetime('now', '-7 days')", [])
  let corrections_week = "0"
  each r in corr_rows { let corrections_week = to_string(json_get(r, "cnt", "0")) }

  let narad_rows = query("SELECT COUNT(*) as cnt FROM narads WHERE created_at > datetime('now', '-7 days')", [])
  let narads_week = "0"
  each r in narad_rows { let narads_week = to_string(json_get(r, "cnt", "0")) }

  // --- Read Yana profile ---
  let yana_profile = read_file("library/yana.md")

  // --- Build prompt ---
  let prompt = "Ты — Яна. Недельный дайджест:\n"
  let prompt = prompt + "- Задач: " + tasks_week + "\n"
  let prompt = prompt + "- Топ отделы: " + top_depts + "\n"
  let prompt = prompt + "- Средняя оценка: " + avg_score + "\n"
  let prompt = prompt + "- Коррекций: " + corrections_week + "\n"
  let prompt = prompt + "- Нарядов: " + narads_week + "\n"
  let prompt = prompt + "Выдели тренды, проблемы, рекомендации."

  // --- Native LLM call ---
  let llm_result = try call_llm(yana_profile, prompt)

  if to_string(llm_result) != "()" then {
    let reply = to_string(llm_result)
    let _ = SendTelegramReply(owner_id, "📊 Недельный дайджест\n\n" + reply)
  } else {
    let _ = SendTelegramReply(owner_id, "📊 Недельный дайджест: не удалось сгенерировать (LLM недоступна).")
  }

  // --- Audit ---
  let _ = AuditLog("weekly_digest", "scheduler", "completed with " + tasks_week + " tasks, " + corrections_week + " corrections, " + narads_week + " narads")

  return "ok"
}

// ---------------------------------------------------------------------------
// 4. Monthly Review — 1st of month, 10:00 (MIGRATED to native call_llm)
// ---------------------------------------------------------------------------
pattern MonthlyReview() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- All 12 departments ---
  let depts = ["osp", "lz", "expert", "marketing", "finance", "legal", "dev", "design", "qa", "visual", "engineering", "kavalnya"]

  let mut metrics_summary = ""
  each dept in depts {
    // Task count (30 days)
    let task_rows = query("SELECT COUNT(*) as cnt FROM channel_archive WHERE dept = ? AND archived_at > datetime('now', '-30 days')", [dept])
    let task_count = to_string(try json_get(task_rows[0], "cnt", "0"))

    // Average satisfaction (30 days)
    let sat_rows = query("SELECT ROUND(AVG(metric_value), 1) as avg_score FROM dept_metrics WHERE dept = ? AND metric_name = 'satisfaction' AND created_at > datetime('now', '-30 days')", [dept])
    let avg_sat = to_string(try json_get(sat_rows[0], "avg_score", "0"))

    // Corrections (30 days)
    let corr_rows = query("SELECT COUNT(*) as cnt FROM adapt_corrections WHERE dept = ? AND created_at > datetime('now', '-30 days')", [dept])
    let corr_count = to_string(try json_get(corr_rows[0], "cnt", "0"))

    let metrics_summary = metrics_summary + dept + ": " + task_count + " задач, оценка " + avg_sat + ", " + corr_count + " коррекций\n"
  }

  // --- Read Yana profile ---
  let yana_profile = read_file("library/yana.md")

  // --- Build prompt ---
  let prompt = "Ты — Яна. Ежемесячный review офиса:\n\n" + metrics_summary + "\n"
  let prompt = prompt + "Анализ:\n"
  let prompt = prompt + "1. Какие отделы работали лучше всего\n"
  let prompt = prompt + "2. Какие деградировали\n"
  let prompt = prompt + "3. Какие не использовались\n"
  let prompt = prompt + "4. Рекомендации по улучшению\n"
  let prompt = prompt + "5. Предложить рекалибровку для отделов с оценкой < 3"

  // --- Native LLM call ---
  let llm_result = try call_llm(yana_profile, prompt)

  if to_string(llm_result) != "()" then {
    let reply = to_string(llm_result)
    let _ = SendTelegramReply(owner_id, "📅 Месячный обзор\n\n" + reply)
  } else {
    let _ = SendTelegramReply(owner_id, "📅 Месячный обзор: не удалось сгенерировать (LLM недоступна).")
  }

  // --- Audit ---
  let _ = AuditLog("monthly_review", "scheduler", "completed for 12 departments")

  return "ok"
}

// ---------------------------------------------------------------------------
// 5. Control Check — daily 12:00, verifies predictions on watch (MIGRATED)
// ---------------------------------------------------------------------------
pattern ControlCheck() -> String {
  let owner_id = env("OWNER_TELEGRAM_ID")

  // --- Fetch all control watches from system_settings ---
  let controls = query("SELECT key, value FROM system_settings WHERE key LIKE 'control_%'", [])

  let mut checks_data = ""
  let mut checks_done = 0.0

  each row in controls {
    let ctrl_key = to_string(try json_get(row, "key", ""))
    let ctrl_val = to_string(try json_get(row, "value", ""))

    // Value format: "daily|Topic" / "weekly|Topic" / "monthly|Topic"
    let _pipe = "|"
    let parts = split(ctrl_val, _pipe)
    let freq = ""
    let topic = ""
    if length(parts) > 0.0 then { let freq = trim(get(parts, 0.0)) }
    if length(parts) > 1.0 then { let topic = trim(get(parts, 1.0)) }

    // Only verify daily watches in this cron
    if freq == "daily" then {
      // Extract doc_id from key (strip "control_" prefix)
      let doc_id = replace(ctrl_key, "control_", "")

      // Get original prediction from miniapp_responses
      let pred_rows = query("SELECT raw_text FROM miniapp_responses WHERE id = ?", [doc_id])
      let mut original_prediction = ""
      if length(to_string(pred_rows)) > 2.0 then {
        let original_prediction = to_string(try json_get(pred_rows[0], "raw_text", ""))
      }

      // Append to checks data
      let checks_data = checks_data + "DOC:" + doc_id + "|TOPIC:" + topic + "|PRED:" + substring(original_prediction, 0, 2000) + "\n---\n"
      let checks_done = checks_done + 1.0
    }
  }

  // --- If no daily checks, skip ---
  if checks_done == 0.0 then {
    let _ = AuditLog("control_check", "scheduler", "no daily watches to verify")
    return "ok"
  }

  // --- Read OSP profile for context ---
  let osp_profile = read_file("library/osp.md")

  // --- Native LLM call to verify predictions ---
  let verify_prompt = osp_profile + "\n\nТы — ОСП. Проверь следующие прогнозы на актуальность. Для каждого: совпал ли прогноз с реальностью? Если нет — почему? Укажи новые индикаторы для наблюдения.\n\nФормат: [ПРОГНОЗ ПОДТВЕРЖДЁН] / [ПРОГНОЗ НЕ ПОДТВЕРЖДЁН] / [ТРЕБУЕТ ПРОВЕРКИ]"
  let llm_result = try call_llm(verify_prompt, checks_data)

  if to_string(llm_result) != "()" then {
    let reply = to_string(llm_result)
    let _ = SendTelegramReply(owner_id, "🔍 Контроль прогнозов\n\n" + reply)
  }

  // --- Audit ---
  let _ = AuditLog("control_check", "scheduler", to_string(checks_done) + " daily predictions verified")

  return "ok"
}

// ---------------------------------------------------------------------------
// 6. Yana Self-Learn — daily, triggered from MorningBrief (MIGRATED)
// ---------------------------------------------------------------------------
pattern YanaSelfLearn() -> String {
  // --- Read Yana profile ---
  let yana_profile = read_file("library/yana.md")

  // --- Collect recent corrections as learning material ---
  let corr_rows = query("SELECT dept, original_query, correction FROM adapt_corrections WHERE created_at > datetime('now', '-7 days') ORDER BY created_at DESC LIMIT 20", [])
  let corrections_data = json_encode(corr_rows)

  // --- Native LLM call for self-improvement ---
  let prompt = yana_profile + "\n\nТы — Яна. Проанализируй свои недавние коррекции. Выдели паттерны ошибок, предложи конкретные улучшения для каждого отдела. Язык: русский."
  let llm_result = try call_llm(prompt, "Мои коррекции за 7 дней:\n" + corrections_data)

  if to_string(llm_result) != "()" then {
    let insights = to_string(llm_result)
    // Save insights to debriefs
    if insights != "" then {
      db_execute("INSERT INTO debriefs (dept, period, content) VALUES ('yana', 'self-learn', ?1)", [insights])
    }
  }

  // --- Audit ---
  let _ = AuditLog("self_learn", "scheduler", "self-learn cycle completed")

  return "ok"
}

// ---------------------------------------------------------------------------
// 7. Monthly Debrief per department — on-demand or scheduled (already migrated via DebriefDepartment in utils.mlog)
// ---------------------------------------------------------------------------
pattern MonthlyDebrief(dept: String) -> String {
  // Delegate to the migrated DebriefDepartment pattern in utils.mlog
  let result = DebriefDepartment(dept)
  let _ = AuditLog("monthly_debrief", "scheduler", "debrief for " + dept)
  return result
}

// ---------------------------------------------------------------------------
// 8. Reminder Check — every 5 min, sends due reminders
// STILL DELEGATED: complex RRULE logic in Python scheduler/reminder-check
// Migration path: port RRULE parsing (daily/weekly/monthly/yearly) to mlog
// ---------------------------------------------------------------------------
pattern ReminderCheck() -> String {
  let payload = json_encode("")
  let result = try http_post("http://127.0.0.1:4000/scheduler/reminder-check", payload, "application/json")
  if to_string(result) == "()" then { return "ok" }
  let sent = json_get(parse_json(result), "sent", "0")
  if sent != "0" then {
    let _ = AuditLog("reminder_check", "scheduler", sent + " reminders sent")
  }
  return "ok"
}
