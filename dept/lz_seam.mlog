// ── Шов LLM-вызовов навыков ЛЗ (#556 → #604) ────────────────────────────────
// dept/lz.mlog зовёт LZLlm; определение раньше жило только в app.mlog —
// вторая точка входа (dogfood_staging.mlog, стенд FO-050) шов не получала
// и падала при старте: [UNDEFINED_FUNCTION] LZLlm ×6 (наряд #604).
// Модуль импортируют ОБЕ точки входа (app.mlog, dogfood_staging.mlog).
// dept/lz.mlog шов НЕ импортирует и НЕ определяет: стаб батареи v3
// (test_n556v3/test_n553v3) — локальное определение тестового замыкания,
// дыра в dept/lz заполняется вызывающим контуром (проба #604, bin/mlog
// 0.33.2: локаль входа сильнее импорта; dept/lz дыры не имеет — стаб её
// заполняет; прогон батареи после перехода: ALL PASS 29).
// Тело — прод-замыкание из app.mlog без изменений: to_string+TryVal
// (успех = ответ модели, неуспех = "()" — контракт #556/#422); промпты
// менялись ТОЛЬКО в части формата ответа (A.2/A.3 #556), смысловая часть
// не тронута (запрет наряда).
import dept/utils

pattern LZLlm(prompt: String) -> String {
  return to_string(TryVal(try call_llm(prompt)))
}
