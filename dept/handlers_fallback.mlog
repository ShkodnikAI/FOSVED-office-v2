// HOTFIX 2026-08-20: mlog 0.17.0 import regression
// Imported patterns from dept/osp.mlog and dept/expert.mlog are not visible at
// runtime (same class of bug that forced inlining HandleYana).
// Temporary: route through HandleDeptQuery (Python LLM proxy + library profiles).
// Native logic remains in dept/osp.mlog and dept/expert.mlog — restore imports
// when Metalogos cross-file pattern export is fixed.

pattern HandleOSP(query: String, chat_id: String) -> String {
  return HandleDeptQuery("osp", query, chat_id)
}

pattern HandleExpert(query: String, chat_id: String) -> String {
  return HandleDeptQuery("expert", query, chat_id)
}
