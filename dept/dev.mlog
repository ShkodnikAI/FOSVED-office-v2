// ═══════════════════════════════════════════════════════════════════════
// SECTION 12: SKILL TIER LOADING
// ═══════════════════════════════════════════════════════════════════════

pattern LoadSkillTiers(task_type: String, explicit_tier3: String) -> Dict {
  // Tier 1: ALWAYS loaded (5 skills)
  let tier1 = "architecture-decision-records,estimation-discipline,code-organization-standards,tech-radar-maintenance,iterative-implementation"

  // Tier 2: by task type (12 skills, load relevant subset)
  let tier2 = ""
  if task_type == TASK_TYPE_WEB_APP() then {
    let tier2 = "nextjs-architecture,database-design,api-design,devops-deployment,observability-setup,dependency-management"
  }
  if task_type == TASK_TYPE_SITE() then {
    let tier2 = "nextjs-architecture,devops-deployment,dependency-management"
  }
  if task_type == TASK_TYPE_AI_OFFICE() then {
    let tier2 = "nextjs-architecture,database-design,api-design,agent-architecture,llm-integration,multi-agent-orchestration,devops-deployment,observability-setup,dependency-management"
  }
  if task_type == TASK_TYPE_LOCAL_AI() then {
    let tier2 = "local-model-deployment,model-fine-tuning,llm-integration,devops-deployment,dependency-management"
  }
  if task_type == TASK_TYPE_INFRASTRUCTURE() then {
    let tier2 = "devops-deployment,observability-setup,dependency-management"
  }
  if task_type == TASK_TYPE_REFACTOR() then {
    let tier2 = "refactoring-discipline,dependency-management,nextjs-architecture,database-design"
  }
  if task_type == TASK_TYPE_HOTFIX() then {
    let tier2 = "dependency-management"
  }

  // Tier 3: explicit only (3 skills)
  let tier3 = ""
  let q = lower(explicit_tier3)
  if contains(q, "performance") or contains(q, "производительност") or contains(q, "оптимизац") then {
    let tier3 = tier3 + "performance-optimization,"
  }
  if contains(q, "security") or contains(q, "безопасност") or contains(q, "hardening") then {
    let tier3 = tier3 + "security-hardening,"
  }
  if contains(q, "legacy") or contains(q, "модернизац") or contains(q, "moderniz") then {
    let tier3 = tier3 + "legacy-system-modernization,"
  }

  let t1_count = 5
  let t2_count = length(split(tier2, ","))
  let t3_count = length(split(tier3, ","))
  let loaded_count = t1_count + t2_count + t3_count

  let msg = "Загружены skill tiers для " + TaskTypeNameRU(task_type) + ":\n"
  let msg = msg + "Tier 1 (всегда): " + tier1 + "\n"
  let msg = msg + "Tier 2 (по типу): " + tier2 + "\n"
  if tier3 != "" then {
    let msg = msg + "Tier 3 (explicit): " + tier3 + "\n"
  }
  let msg = msg + "Всего: " + to_string(loaded_count) + " skills"

  return {
    tier1_skills: tier1,
    tier2_skills: tier2,
    tier3_skills: tier3,
    loaded_count: loaded_count,
    message: msg
  }
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 13: TRIPLE STORAGE
// ═══════════════════════════════════════════════════════════════════════

pattern SnapshotToTelegramArchive(task_id: String, task_data: String, chat_id: String) -> String {
  // Hard rule 8: every major task → snapshot in Telegram Archive
  let snapshot_msg = "📋 DEV TASK SNAPSHOT\n\n"
  let snapshot_msg = snapshot_msg + "Task: " + task_id + "\n"
  let snapshot_msg = snapshot_msg + "Data: " + substring(task_data, 0.0, 3000.0) + "\n\n"
  let snapshot_msg = snapshot_msg + "Timestamp: " + format_date(now(), "yyyy-MM-dd HH:mm")

  let result = SendTelegramMessage(chat_id, snapshot_msg)
  let snapshot_id = "snap_" + to_string(hash(task_id + to_string(now())))

  // Update task with snapshot reference
  let _ = db_execute("UPDATE dev_tasks SET telegram_snapshot_id = ? WHERE id = ?", [snapshot_id, task_id])

  let _ = AuditLog("dev_snapshot", DEPT_NAME(), "task=" + task_id + " snapshot=" + snapshot_id + " target=telegram_archive")
  return "Telegram snapshot создан: " + snapshot_id
}

pattern SyncToLocal(task_id: String, task_data: String) -> String {
  // Deferred sync to local storage
  let sync_key = "dev_local_sync_" + task_id
  let _ = kv_set(sync_key, task_data)
  let _ = AuditLog("dev_local_sync", DEPT_NAME(), "task=" + task_id + " target=local_deferred")
  return "Local sync запланирован для task " + task_id
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 14: BOT COMMANDS (14 commands)
// ═══════════════════════════════════════════════════════════════════════

// ── /dev — Dashboard ───────────────────────────────────────────────────
pattern DevDashboard(chat_id: String) -> String {
  let active = db_execute("SELECT COUNT(*) as c FROM dev_tasks WHERE status NOT IN ('archived','abandoned')", [])
  let total = db_execute("SELECT COUNT(*) as c FROM dev_tasks", [])
  let radar_count = db_execute("SELECT COUNT(*) as c FROM tech_radar_entries", [])
  let repos_count = db_execute("SELECT COUNT(*) as c FROM code_repositories", [])

  let active_count = to_int(to_string(json_get(get(active, 0), "c", "0")))
  let total_count = to_int(to_string(json_get(get(total, 0), "c", "0")))
  let radar_total = to_int(to_string(json_get(get(radar_count, 0), "c", "0")))
  let repos_total = to_int(to_string(json_get(get(repos_count, 0), "c", "0")))

  let msg = "═══ ОТДЕЛ РАЗРАБОТКА ═══\n"
  let msg = msg + "Психотип: " + PSYCHOTYPE() + "\n\n"
  let msg = msg + "── СТАТИСТИКА ──\n"
  let msg = msg + "Активных задач: " + to_string(active_count) + " / " + to_string(total_count) + "\n"
  let msg = msg + "Tech Radar записей: " + to_string(radar_total) + "\n"
  let msg = msg + "Репозиториев: " + to_string(repos_total) + "\n\n"
  let msg = msg + "── КОМАНДЫ ──\n"
  let msg = msg + "/dev-estimate <task_id> — оценить задачу\n"
  let msg = msg + "/dev-decide <task_id> — создать ADR\n"
  let msg = msg + "/dev-implement <task_id> — реализовать итерацию\n"
  let msg = msg + "/dev-task <task_id> — показать задачу\n"
  let msg = msg + "/dev-tasks — список задач\n"
  let msg = msg + "/dev-repos — список репозиториев\n"
  let msg = msg + "/dev-repo <name> — показать репозиторий\n"
  let msg = msg + "/dev-create-repo <name> — создать репозиторий\n"
  let msg = msg + "/dev-radar — Tech Radar\n"
  let msg = msg + "/dev-radar-add — добавить в Radar\n"
  let msg = msg + "/dev-deploy <task_id> — deploy задачи\n"
  let msg = msg + "/dev-archive <task_id> — архивировать\n"
  let msg = msg + "/dev-local-sync — синхронизация\n\n"
  let msg = msg + "── ЖЁСТКИЕ ПРАВИЛА (10) ──\n"
  let msg = msg + "1. Нет кода без ADR\n"
  let msg = msg + "2. Нет оценки без диапазона\n"
  let msg = msg + "3. Нет технологий в 'hold'\n"
  let msg = msg + "4. Нет коммита без теста\n"
  let msg = msg + "5. Нет deploy без green QA\n"
  let msg = msg + "6. Нет секретов в репо\n"
  let msg = msg + "7. Каждый репо: README+LICENSE+.gitignore+CI\n"
  let msg = msg + "8. Каждая задача → Telegram snapshot\n"
  let msg = msg + "9. Нет зависимостей с critical vulns\n"
  let msg = msg + "10. Нет API break без major version bump"
  return WrapWithDisclaimer(msg)
}

// ── /dev-tasks — List tasks ────────────────────────────────────────────
pattern ListTasks(status_filter: String, limit: Int) -> String {
  let rows = db_execute("SELECT id, title, task_type, status, estimate_expected, updated_at FROM dev_tasks WHERE status NOT IN ('archived','abandoned') ORDER BY updated_at DESC LIMIT ?", [to_string(limit)])
  if status_filter != "" then { let rows = db_execute("SELECT id, title, task_type, status, estimate_expected, updated_at FROM dev_tasks WHERE status = ? ORDER BY updated_at DESC LIMIT ?", [status_filter, to_string(limit)]) }

  if length(rows) == 0 then {
    return "Нет задач. Создайте через свободный запрос или /dev-implement."
  }

  let prompt = "Форматируй список задач отдела Разработка. Показывай статус русскими названиями, тип задач русскими. JSON данные: " + to_string(rows)
  let formatted = call_llm(prompt)
  return WrapWithDisclaimer(formatted)
}

// ── /dev-task — Show single task ───────────────────────────────────────
pattern ShowTask(task_id: String) -> String {
  let row = db_execute("SELECT * FROM dev_tasks WHERE id = ? LIMIT 1", [task_id])
  if length(row) == 0 then {
    return "Задача не найдена: " + task_id
  }
  let data = get(row, 0)
  let status = to_string(json_get(data, "status", "unknown"))
  let task_type = to_string(json_get(data, "task_type", "unknown"))
  let title = to_string(json_get(data, "title", ""))
  let est_low = to_string(json_get(data, "estimate_low", "N/A"))
  let est_exp = to_string(json_get(data, "estimate_expected", "N/A"))
  let est_high = to_string(json_get(data, "estimate_high", "N/A"))
  let qa_status = to_string(json_get(data, "qa_status", "N/A"))
  let repo = to_string(json_get(data, "repo_name", "N/A"))
  let snap = to_string(json_get(data, "telegram_snapshot_id", "N/A"))

  let msg = "═══ ЗАДАЧА " + task_id + " ═══\n"
  let msg = msg + "Название: " + title + "\n"
  let msg = msg + "Тип: " + TaskTypeNameRU(task_type) + "\n"
  let msg = msg + "Статус: " + StateNameRU(status) + "\n"
  let msg = msg + "Оценка: " + est_low + " / " + est_exp + " / " + est_high + " ч (low/expected/high)\n"
  let msg = msg + "QA статус: " + qa_status + "\n"
  let msg = msg + "Репозиторий: " + repo + "\n"
  let msg = msg + "Telegram snapshot: " + snap + "\n\n"
  let msg = msg + "Полные данные:\n" + to_string(data)

  return WrapWithDisclaimer(msg)
}

// ── /dev-repos — List repositories ─────────────────────────────────────
pattern ListRepos() -> String {
  let rows = db_execute("SELECT name, url, task_type, has_readme, has_license, has_gitignore, has_ci FROM code_repositories ORDER BY name", [])
  if length(rows) == 0 then {
    return "Нет репозиториев. Создайте: /dev-create-repo <name> <task_type>"
  }

  let prompt = "Форматируй список репозиториев отдела Разработка. Для каждого показывай наличие обязательных файлов (✅/❌). JSON: " + to_string(rows)
  let formatted = call_llm(prompt)
  return WrapWithDisclaimer(formatted)
}

// ── /dev-repo — Show single repository ─────────────────────────────────
pattern ShowRepo(repo_name: String) -> String {
  let row = db_execute("SELECT * FROM code_repositories WHERE name = ? LIMIT 1", [repo_name])
  if length(row) == 0 then {
    return "Репозиторий не найден: " + repo_name
  }

  let data = get(row, 0)
  let compliance = VerifyCodeOrganization(repo_name)

  let msg = "═══ РЕПОЗИТОРИЙ " + repo_name + " ═══\n\n"
  let msg = msg + to_string(data) + "\n\n"
  let msg = msg + "── Соответствие стандартам ──\n"
  let msg = msg + compliance.message

  return WrapWithDisclaimer(msg)
}

// ── /dev-create-repo — Create repository ───────────────────────────────
pattern CreateRepo(name: String, task_type: String, url: String) -> String {
  // Hard rule 7: enforce required files
  let _ = db_execute("INSERT INTO code_repositories (name, url, task_type, has_readme, has_license, has_gitignore, has_ci, storage_primary, created_at) VALUES (?, ?, ?, 'false', 'false', 'false', 'false', ?, datetime('now'))", [name, url, task_type, STORAGE_GITHUB()])

  // Generate required files
  let standards = EnforceRepoStandards(name, url, task_type)

  let _ = AuditLog("dev_create_repo", DEPT_NAME(), "repo=" + name + " type=" + task_type)

  let msg = "Репозиторий создан: " + name + "\n"
  let msg = msg + "Тип: " + TaskTypeNameRU(task_type) + "\n"
  let msg = msg + "URL: " + url + "\n"
  let msg = msg + "Primary storage: GitHub\n\n"
  let msg = msg + "── Стандартные файлы ──\n" + standards
  return WrapWithDisclaimer(msg)
}

// ── /dev-deploy — Deploy task ──────────────────────────────────────────
pattern DeployTask(task_id: String, chat_id: String) -> String {
  // Hard rule 5: no production deploy without green QA
  let qa_gate = GateDeployRequiresGreenQA(task_id)
  ifqa_gate.passed == false then {
    return qa_gate.message
  }

  // Transition to deployed
  let transition = TransitionTask(task_id, STATUS_DEPLOYED(), "Production deploy via /dev-deploy")
  iftransition.success == false then {
    return "Deploy не удался: " + transition.message
  }

  // Snapshot to Telegram Archive (hard rule 8)
  let task_row = db_execute("SELECT * FROM dev_tasks WHERE id = ? LIMIT 1", [task_id])
  let task_data = "{}"
  if length(task_row) > 0 then { task_data = to_string(get(task_row, 0)) }
  let snapshot = SnapshotToTelegramArchive(task_id, task_data, chat_id)

  // Sync to local
  let local_sync = SyncToLocal(task_id, task_data)

  let _ = AuditLog("dev_deploy", DEPT_NAME(), "task=" + task_id + " → deployed")

  let msg = "═══ DEPLOY ═══\n"
  let msg = msg + "Task: " + task_id + "\n"
  let msg = msg + "Status: " + STATUS_DEPLOYED() + "\n"
  let msg = msg + "QA Gate: ✅ passed\n"
  let msg = msg + "Telegram snapshot: " + snapshot + "\n"
  let msg = msg + "Local sync: " + local_sync
  return WrapWithDisclaimer(msg)
}

// ── /dev-archive — Archive task ────────────────────────────────────────
pattern ArchiveTask(task_id: String, actual_hours: String) -> String {
  // Record actual hours for learning loop
  let _ = db_execute("UPDATE dev_tasks SET actual_hours = ? WHERE id = ?", [actual_hours, task_id])

  // Learning loop: update estimate verification
  let _ = db_execute("UPDATE dev_estimate_verifications SET actual_hours = ?, verified_at = datetime('now') WHERE task_id = ?", [actual_hours, task_id])

  let transition = TransitionTask(task_id, STATUS_ARCHIVED(), "Task completed, actual=" + actual_hours + "h")
  iftransition.success == false then {
    return "Archive не удался: " + transition.message
  }

  let _ = AuditLog("dev_archive", DEPT_NAME(), "task=" + task_id + " actual_hours=" + actual_hours)

  return "Задача " + task_id + " архивирована. Фактические часы: " + actual_hours + ". Данные добавлены в цикл обучения (estimate vs actual)."
}

// ── /dev-local-sync — Local sync ───────────────────────────────────────
pattern LocalSync() -> String {
  // Sync pending local items
  let pending = db_execute("SELECT id, title, status FROM dev_tasks WHERE status NOT IN ('archived','abandoned') ORDER BY updated_at DESC LIMIT 50", [])

  let sync_count = 0
  let i = 0
  while i < length(pending) {
    let task = get(pending, i)
    let task_id = to_string(json_get(task, "id", ""))
    let _ = kv_set("dev_local_" + task_id, to_string(task))
    let sync_count = sync_count + 1
    let i = i + 1
  }

  let _ = AuditLog("dev_local_sync", DEPT_NAME(), "synced=" + to_string(sync_count) + " tasks to local storage")
  return "Local sync завершён: " + to_string(sync_count) + " задач синхронизировано в KV store."
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 15: LEARNING LOOPS (4 scheduled tasks)
// ═══════════════════════════════════════════════════════════════════════

// ── Per-task: estimate vs actual verification ──────────────────────────
pattern VerifyEstimateAccuracy(task_id: String) -> Dict {
  let row = db_execute("SELECT estimate_low, estimate_expected, estimate_high, actual_hours FROM dev_estimate_verifications WHERE task_id = ? AND actual_hours IS NOT NULL LIMIT 1", [task_id])
  if length(row) == 0 then {
    return { mape: 0.0, bias: "no_data", message: "Нет данных для верификации estimate по задаче " + task_id }
  }

  let data = get(row, 0)
  let est_expected = to_float(to_string(json_get(data, "estimate_expected", "0")))
  let actual = to_float(to_string(json_get(data, "actual_hours", "0")))

  if est_expected == 0.0 or actual == 0.0 then {
    return { mape: 0.0, bias: "no_data", message: "Нулевые значения, невозможно вычислить MAPE" }
  }

  let mape = (actual - est_expected) / est_expected * 100.0
  let bias = ""
  if mape > 20.0 then { bias = "underestimate" }
  let bias = bias
  if mape < -20.0 then { bias = "overestimate" }
  let bias = bias
  if bias == "" then { bias = "calibrated" }

  let _ = db_execute("UPDATE dev_estimate_verifications SET mape = ?, bias = ?, verified_at = datetime('now') WHERE task_id = ?", [to_string(mape), bias, task_id])

  let msg = "Estimate verification для " + task_id + ":\n"
  let msg = msg + "Expected: " + substring(to_string(est_expected), 0.0, 6.0) + "ч, Actual: " + substring(to_string(actual), 0.0, 6.0) + "ч\n"
  let msg = msg + "MAPE: " + substring(to_string(mape), 0.0, 6.0) + "%\n"
  let msg = msg + "Bias: " + bias

  return { mape: mape, bias: bias, message: msg }
}

// ── Weekly: Wednesday 04:00 — Tech Radar scan ─────────────────────────
pattern WeeklyTechRadarScan() -> String {
  // Scan for technologies that need radar state review
  let all_entries = db_execute("SELECT name, category, radar_state, updated_at FROM tech_radar_entries ORDER BY radar_state, name", [])

  let prompt = "Еженедельный обзор Tech Radar отдела Разработка.\n\n"
  let prompt = prompt + "ЗАДАЧИ:\n"
  let prompt = prompt + "1. Какие технологии пора перевести в adopt (достаточно опыта)?\n"
  let prompt = prompt + "2. Какие в trial → пора в adopt или назад в assess?\n"
  let prompt = prompt + "3. Какие в assess → пора в trial или удалить?\n"
  let prompt = prompt + "4. Появились ли новые технологии, которые стоит добавить в assess?\n"
  let prompt = prompt + "5. Какие технологии в hold — можно ли убрать (исправлены проблемы)?\n\n"
  let prompt = prompt + "Текущий Tech Radar:\n" + to_string(all_entries)

  let analysis = call_llm(prompt)

  let _ = AuditLog("dev_radar_scan", DEPT_NAME(), "Weekly Tech Radar scan completed")
  return "═══ Еженедельный Tech Radar Scan ═══\n\n" + analysis
}

// ── Monthly: 1st 11:00 — Estimate calibration ─────────────────────────
pattern MonthlyEstimateCalibration() -> String {
  let verifications = db_execute("SELECT task_id, estimate_expected, actual_hours, mape, bias FROM dev_estimate_verifications WHERE verified_at >= datetime('now', '-30 days') AND actual_hours IS NOT NULL", [])

  if length(verifications) == 0 then {
    let _ = AuditLog("dev_monthly_cal", DEPT_NAME(), "No estimate verifications in past 30 days")
    return "Нет верифицированных оценок за последние 30 дней."
  }

  let prompt = "Месячная калибровка оценок отдела Разработка.\n\n"
  let prompt = prompt + "АНАЛИЗ:\n"
  let prompt = prompt + "1. Средний MAPE — насколько точно оцениваем?\n"
  let prompt = prompt + "2. Bias: систематически недооцениваем или переоцениваем?\n"
  let prompt = prompt + "3. По типам задач: какие типы оцениваем хуже?\n"
  let prompt = prompt + "4. Рекомендации: как улучшить оценки?\n\n"
  let prompt = prompt + "Данные:\n" + to_string(verifications)

  let analysis = call_llm(prompt)

  // Store monthly calibration
  let _ = db_execute("INSERT INTO dev_monthly_calibrations (period_start, period_end, verifications_count, analysis, created_at) VALUES (datetime('now', '-30 days'), datetime('now'), ?, ?, datetime('now'))", [to_string(length(verifications)), analysis])

  let _ = AuditLog("dev_monthly_cal", DEPT_NAME(), "Monthly estimate calibration: " + to_string(length(verifications)) + " verifications")

  return "═══ Месячная калибровка оценок ═══\n\n" + analysis
}

// ── Quarterly: Jan/Apr/Jul/Oct — Methodology review ───────────────────
pattern QuarterlyMethodologyReview() -> String {
  let prompt = "Квартальный обзор методологии отдела Разработка.\n\n"
  let prompt = prompt + "1. Соблюдаются ли жёсткие правила? (статистика нарушений)\n"
  let prompt = prompt + "2. Точность оценок — улучшается ли?\n"
  let prompt = prompt + "3. Tech Radar — адекватно ли отражает технологический ландшафт?\n"
  let prompt = prompt + "4. Качество ADR — достаточная ли глубина?\n"
  let prompt = prompt + "5. Итеративная реализация — соблюдается ли (нет big-bang)?\n"
  let prompt = prompt + "6. Code organization — все репо соответствуют стандартам?\n"
  let prompt = prompt + "7. Психотип: Прагматик + Методист — соблюдается?\n\n"

  let violations = db_execute("SELECT rule_number, COUNT(*) as c FROM dev_rule_violations WHERE created_at >= datetime('now', '-90 days') GROUP BY rule_number ORDER BY c DESC", [])
  let estimates = db_execute("SELECT AVG(mape) as avg_mape, bias, COUNT(*) as c FROM dev_estimate_verifications WHERE verified_at >= datetime('now', '-90 days') AND actual_hours IS NOT NULL GROUP BY bias", [])

  let prompt = prompt + "Нарушения правил (90 дней):\n" + to_string(violations) + "\n\n"
  let prompt = prompt + "Калибровка оценок (90 дней):\n" + to_string(estimates)

  let analysis = call_llm(prompt)

  let _ = AuditLog("dev_quarterly", DEPT_NAME(), "Quarterly methodology review completed")

  return "═══ Квартальный обзор методологии ═══\n\n" + analysis
}

