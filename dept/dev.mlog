// ═══════════════════════════════════════════════════════════════════════
// Fosved Office v2 — Dev Department (Разработка) (NATIVE v1.0)
// ═══════════════════════════════════════════════════════════════════════
// Replaces Python proxy stub with native Metalogos dev engine.
// 20 skill patterns, 10 hard rules, lifecycle state machine,
// disclaimer enforcement, estimation discipline, learning loop.
// 0 CallLLMProxy calls, 0 Python dependencies.
//
// Architecture:
//   HandleDev(query, chat_id)
//     → ParseDevQuery(query)              ← NLP task type + command detection
//     → RouteByCommand(cmd, ...)           ← 14 bot commands + free-text dispatch
//       → cmd=/dev         → DevDashboard
//       → cmd=/dev-estimate→ CreateEstimate
//       → cmd=/dev-decide  → CreateArchitectureDecision
//       → cmd=/dev-implement→ ImplementTask
//       → cmd=/dev-task    → ShowTask
//       → cmd=/dev-tasks   → ListTasks
//       → cmd=/dev-repos   → ListRepos
//       → cmd=/dev-repo    → ShowRepo
//       → cmd=/dev-create-repo → CreateRepo
//       → cmd=/dev-radar   → ShowTechRadar
//       → cmd=/dev-radar-add → AddTechRadarEntry
//       → cmd=/dev-deploy  → DeployTask
//       → cmd=/dev-archive → ArchiveTask
//       → cmd=/dev-local-sync → LocalSync
//       → free-text       → FullPipeline
//     → FullPipeline (for free-text queries):
//       → DetectTaskType                  ← web_app|site|ai_office|local_ai|infrastructure|refactor|hotfix
//       → LoadSkillTiers                  ← Tier1 always + Tier2 by type + Tier3 explicit
//       → GateHardRules                   ← 10 hard rules as native gates
//       → CreateArchitectureDecision      ← Tier 1: hard rule 1
//       → CreateEstimate (range)          ← Tier 1: hard rule 2
//       → CheckTechRadar                  ← Tier 1: hard rule 3
//       → ImplementIteratively            ← Tier 1: iterative-implementation
//       → VerifyCodeOrganization          ← Tier 1: code-organization-standards
//       → DeployWithGuards                ← Tier 2: devops-deployment
//       → WrapWithDisclaimer              ← Tier 1: hard rule enforcement
//     → RecordAssistantMessage
//
// Skill tiers:
//   Tier 1 (always): architecture-decision-records, estimation-discipline,
//                    code-organization-standards, tech-radar-maintenance,
//                    iterative-implementation
//   Tier 2 (by task): nextjs-architecture, database-design, api-design,
//                     agent-architecture, llm-integration, multi-agent-orchestration,
//                     local-model-deployment, model-fine-tuning, devops-deployment,
//                     observability-setup, refactoring-discipline, dependency-management
//   Tier 3 (explicit): performance-optimization, security-hardening,
//                      legacy-system-modernization
//
// Depends on BUILTINS only (no Python, no CallLLMProxy):
//   call_llm, db_execute, kv_get, kv_set, json_encode, json_get, parse_json,
//   to_string, to_float, to_int, length, contains, lower, substring,
//   join, split, now, format_date, hash, AuditLog,
//   RecordAssistantMessage, BuildContext, SendTelegramMessage
//
// ═══════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// SECTION 0: CONSTANTS & DISCLAIMER
// ═══════════════════════════════════════════════════════════════════════

pattern DISCLAIMER_TOP() -> String { return "⚠️ Код генерируется проектным ассистентом. Все решения подлежат проверке владельцем перед production deploy." }

pattern DISCLAIMER_BOTTOM() -> String { return "⚠️ Данный результат — работа проектного ассистента отдела Разработка. Ответственность за production решение несёт владелец после проверки." }

pattern DEPT_NAME() -> String { return "dev" }
pattern DEPT_NAME_RU() -> String { return "Разработка" }
pattern PSYCHOTYPE() -> String { return "Прагматик + Методист (accuracy > speed, repeatable procedures)" }

// Task types
pattern TASK_TYPE_WEB_APP() -> String { return "web_app" }
pattern TASK_TYPE_SITE() -> String { return "site" }
pattern TASK_TYPE_AI_OFFICE() -> String { return "ai_office" }
pattern TASK_TYPE_LOCAL_AI() -> String { return "local_ai" }
pattern TASK_TYPE_INFRASTRUCTURE() -> String { return "infrastructure" }
pattern TASK_TYPE_REFACTOR() -> String { return "refactor" }
pattern TASK_TYPE_HOTFIX() -> String { return "hotfix" }

// Lifecycle states
pattern STATUS_DRAFTED() -> String { return "drafted" }
pattern STATUS_ESTIMATED() -> String { return "estimated" }
pattern STATUS_ARCHITECTING() -> String { return "architecting" }
pattern STATUS_IMPLEMENTING() -> String { return "implementing" }
pattern STATUS_TESTING() -> String { return "testing" }
pattern STATUS_REVIEW() -> String { return "review" }
pattern STATUS_DEPLOYED() -> String { return "deployed" }
pattern STATUS_ARCHIVED() -> String { return "archived" }
pattern STATUS_ABANDONED() -> String { return "abandoned" }

// Tech Radar states
pattern RADAR_ADOPT() -> String { return "adopt" }
pattern RADAR_TRIAL() -> String { return "trial" }
pattern RADAR_ASSESS() -> String { return "assess" }
pattern RADAR_HOLD() -> String { return "hold" }

// Valid lifecycle transitions
pattern VALID_TRANSITIONS() -> String { return "drafted→estimated,drafted→abandoned,estimated→architecting,estimated→abandoned,architecting→implementing,architecting→abandoned,implementing→testing,implementing→abandoned,testing→review,testing→implementing,review→deployed,review→implementing,deployed→archived,deployed→abandoned" }

// Triple storage targets
pattern STORAGE_GITHUB() -> String { return "github" }
pattern STORAGE_TELEGRAM() -> String { return "telegram_archive" }
pattern STORAGE_LOCAL() -> String { return "local_deferred" }

// Required repo files (hard rule 7)
pattern REQUIRED_REPO_FILES() -> String { return "README.md,LICENSE,.gitignore,.github/workflows/ci.yml" }

// ═══════════════════════════════════════════════════════════════════════
// SECTION 1: NLP QUERY PARSER & TASK TYPE DETECTION
// ═══════════════════════════════════════════════════════════════════════

pattern DetectTaskType(query: String) -> String {
  let q = lower(query)
  // web_app keywords
  if contains(q, "веб-приложени") or contains(q, "web app") or contains(q, "fullstack") then { return TASK_TYPE_WEB_APP() }
  if contains(q, "next.js") or contains(q, "nextjs") or contains(q, "dashboard app") then { return TASK_TYPE_WEB_APP() }
  if contains(q, "saas") or contains(q, "crm") or contains(q, "админ-панел") then { return TASK_TYPE_WEB_APP() }
  // site keywords
  if contains(q, "сайт") or contains(q, "landing") or contains(q, "лендинг") then { return TASK_TYPE_SITE() }
  if contains(q, "site") or contains(q, "homepage") or contains(q, "корпоративн") then { return TASK_TYPE_SITE() }
  // ai_office keywords
  if contains(q, "ai office") or contains(q, "ai-офис") or contains(q, "агент") or contains(q, "бот") then { return TASK_TYPE_AI_OFFICE() }
  if contains(q, "fosved") or contains(q, "assistant office") or contains(q, "telegram bot") then { return TASK_TYPE_AI_OFFICE() }
  // local_ai keywords
  if contains(q, "локальн") and contains(q, "модел") then { return TASK_TYPE_LOCAL_AI() }
  if contains(q, "ollama") or contains(q, "llama.cpp") or contains(q, "local llm") then { return TASK_TYPE_LOCAL_AI() }
  if contains(q, "self-host") and contains(q, "ai") then { return TASK_TYPE_LOCAL_AI() }
  // infrastructure keywords
  if contains(q, "инфраструктур") or contains(q, "infrastructure") or contains(q, "deploy") then { return TASK_TYPE_INFRASTRUCTURE() }
  if contains(q, "ci/cd") or contains(q, "pipeline") or contains(q, "docker") then { return TASK_TYPE_INFRASTRUCTURE() }
  if contains(q, "kubernetes") or contains(q, "monitoring") or contains(q, "логирован") then { return TASK_TYPE_INFRASTRUCTURE() }
  // refactor keywords
  if contains(q, "рефакторинг") or contains(q, "refactor") or contains(q, "переписат") then { return TASK_TYPE_REFACTOR() }
  if contains(q, "moderniz") or contains(q, "migration") or contains(q, "миграци") then { return TASK_TYPE_REFACTOR() }
  // hotfix keywords
  if contains(q, "hotfix") or contains(q, "срочн") or contains(q, "баг") then { return TASK_TYPE_HOTFIX() }
  if contains(q, "критич") and contains(q, "ошибк") then { return TASK_TYPE_HOTFIX() }
  if contains(q, "production down") or contains(q, "падени") then { return TASK_TYPE_HOTFIX() }
  return TASK_TYPE_WEB_APP()
}

pattern DetectCommand(query: String) -> String {
  let q = lower(query)
  if contains(q, "/dev-estimate") then { return "dev-estimate" }
  if contains(q, "/dev-decide") then { return "dev-decide" }
  if contains(q, "/dev-implement") then { return "dev-implement" }
  if contains(q, "/dev-task") andcontains(q, "/dev-tasks") == false then { return "dev-task" }
  if contains(q, "/dev-tasks") then { return "dev-tasks" }
  if contains(q, "/dev-repos") then { return "dev-repos" }
  if contains(q, "/dev-repo") andcontains(q, "/dev-repos") == false andcontains(q, "/dev-create-repo") == false then { return "dev-repo" }
  if contains(q, "/dev-create-repo") then { return "dev-create-repo" }
  if contains(q, "/dev-radar-add") then { return "dev-radar-add" }
  if contains(q, "/dev-radar") then { return "dev-radar" }
  if contains(q, "/dev-deploy") then { return "dev-deploy" }
  if contains(q, "/dev-archive") then { return "dev-archive" }
  if contains(q, "/dev-local-sync") then { return "dev-local-sync" }
  if contains(q, "/dev") then { return "dev" }
  return "free_text"
}

pattern ParseDevQuery(query: String) -> Dict {
  let command = DetectCommand(query)
  let task_type = DetectTaskType(query)

  // Out-of-scope detection
  let q = lower(query)
  let is_out_of_scope = contains(q, "железо") and contains(q, "схем") or contains(q, "pcb layout") or contains(q, "hardware design")

  // Extract task_id if present (after command keyword)
  let task_id = ""
  let repo_name = ""
  let parts = split(query, " ")
  if length(parts) > 1 then {
    let second = to_string(get(parts, 1))
    if contains(second, "dev_") or contains(second, "task_") then {
      let task_id = second
    }
    if contains(second, "/") or contains(second, "-") then {
      ifcontains(second, "/dev") == false then {
        let repo_name = second
      }
    }
  }

  return {
    command: command,
    task_type: task_type,
    task_description: query,
    task_id: task_id,
    repo_name: repo_name,
    is_out_of_scope: is_out_of_scope
  }
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 2: DISCLAIMER ENFORCEMENT
// Hard rule: disclaimer at top and bottom of every output
// ═══════════════════════════════════════════════════════════════════════

pattern WrapWithDisclaimer(content: String) -> String {
  return DISCLAIMER_TOP() + "\n\n" + content + "\n\n" + DISCLAIMER_BOTTOM()
}

pattern DeclineOutOfScope(query: String) -> String {
  let msg = "Запрос отклонён: задача выходит за рамки отдела Разработка.\n\n"
  let msg = msg + "Отдел Разработка покрывает: web-приложения, сайты, AI-офисы, локальные AI, инфраструктуру, рефакторинг, hotfix.\n\n"
  let msg = msg + "Аппаратные схемы, PCB layout и подобное — вне компетенции отдела."
  return WrapWithDisclaimer(msg)
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 3: HARD RULE GATES (10 rules — native if-then blocks)
// ═══════════════════════════════════════════════════════════════════════

// ── Hard Rule 1: No code without architecture decision ─────────────────
pattern GateNoCodeWithoutDecision(task_id: String) -> Dict {
  let row = db_execute("SELECT id FROM architecture_decisions WHERE task_id = ? LIMIT 1", [task_id])
  if length(row) > 0 then {
    return { passed: true, message: "ADR exists for task " + task_id }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 1: Код без архитектурного решения ЗАПРЕЩЁН. Создайте ADR командой /dev-decide." }
}

// ── Hard Rule 2: No estimate without range ─────────────────────────────
pattern GateEstimateHasRange(estimate_json: String) -> Dict {
  let parsed = parse_json(estimate_json)
  let has_low = to_string(json_get(parsed, "low", "")) != ""
  let has_expected = to_string(json_get(parsed, "expected", "")) != ""
  let has_high = to_string(json_get(parsed, "high", "")) != ""
  if has_low and has_expected and has_high then {
    return { passed: true, message: "Estimate has required range (low/expected/high)" }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 2: Оценка без диапазона ЗАПРЕЩЕНА. Требуются low/expected/high. Точечные оценки НЕ допускаются." }
}

// ── Hard Rule 3: No technology in 'hold' state from Tech Radar ─────────
pattern GateNoHoldTech(technologies_json: String) -> Dict {
  let techs = parse_json(technologies_json)
  let hold_count = 0
  let hold_names = ""
  // Check each technology against radar
  let i = 0
  while i < length(techs) {
    let tech_name = to_string(get(techs, i))
    let row = db_execute("SELECT radar_state FROM tech_radar_entries WHERE name = ? LIMIT 1", [tech_name])
    if length(row) > 0 then {
      let state = to_string(json_get(get(row, 0), "radar_state", ""))
      if state == RADAR_HOLD() then {
        let hold_count = hold_count + 1
        let hold_names = hold_names + tech_name + " "
      }
    }
    let i = i + 1
  }
  if hold_count == 0 then {
    return { passed: true, message: "No technologies in 'hold' state" }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 3: Технологии в состоянии 'hold' ЗАПРЕЩЕНЫ: " + hold_names + ". Замените или переведите в trial/assess." }
}

// ── Hard Rule 4: No commit without at least 1 test ────────────────────
pattern GateCommitHasTest(commit_data: String) -> Dict {
  let has_test = contains(lower(commit_data), "test") or contains(lower(commit_data), ".test.") or contains(lower(commit_data), ".spec.") or contains(lower(commit_data), "__tests__")
  if has_test then {
    return { passed: true, message: "Commit includes test(s)" }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 4: Коммит без теста ЗАПРЕЩЁН. Добавьте минимум 1 тест перед коммитом." }
}

// ── Hard Rule 5: No production deploy without green QA ────────────────
pattern GateDeployRequiresGreenQA(task_id: String) -> Dict {
  let row = db_execute("SELECT qa_status FROM dev_tasks WHERE id = ? LIMIT 1", [task_id])
  if length(row) > 0 then {
    let qa_status = to_string(json_get(get(row, 0), "qa_status", ""))
    if qa_status == "green" then {
      return { passed: true, message: "QA status is green for task " + task_id }
    }
    if qa_status == "yellow" then {
      return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 5: QA статус 'yellow' — только некритичные сценарии. Production deploy требует 'green'." }
    }
    return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 5: Production deploy без зелёного QA ЗАПРЕЩЁН. Текущий QA статус: " + qa_status }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 5: QA результат не найден для задачи " + task_id + ". Запустите QA перед deploy." }
}

// ── Hard Rule 6: No secrets in repository ──────────────────────────────
pattern GateNoSecretsInRepo(repo_content: String) -> Dict {
  let c = lower(repo_content)
  let has_secret = contains(c, "api_key=") or contains(c, "api_key :") or contains(c, "secret_key=") or contains(c, "secret_key :")
  let has_secret = has_secret or contains(c, "password=") or contains(c, "password :") or contains(c, "token=") or contains(c, "private_key=")
  let has_secret = has_secret or contains(c, "aws_secret_access_key") or contains(c, "database_url=") or contains(c, "mongodb+srv://")
  let has_secret = has_secret or contains(c, "sk-") or contains(c, "ghp_") or contains(c, "xoxb-")
  if has_secret == false then {
    return { passed: true, message: "No secrets detected in repository" }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 6: Секреты в репозитории ЗАПРЕЩЕНЫ. Используйте environment variables или secrets manager." }
}

// ── Hard Rule 7: Every repo has README, LICENSE, .gitignore, CI/CD ─────
pattern GateRepoHasRequiredFiles(repo_name: String) -> Dict {
  let row = db_execute("SELECT has_readme, has_license, has_gitignore, has_ci FROM code_repositories WHERE name = ? LIMIT 1", [repo_name])
  if length(row) > 0 then {
    let data = get(row, 0)
    let has_readme = to_string(json_get(data, "has_readme", "false")) == "true"
    let has_license = to_string(json_get(data, "has_license", "false")) == "true"
    let has_gitignore = to_string(json_get(data, "has_gitignore", "false")) == "true"
    let has_ci = to_string(json_get(data, "has_ci", "false")) == "true"
    let all_present = has_readme and has_license and has_gitignore and has_ci
    if all_present then {
      return { passed: true, message: "Repository " + repo_name + " has all required files" }
    }
    let missing = ""
    if has_readme == false then { let missing = missing + "README.md " }
    if has_license == false then { let missing = missing + "LICENSE " }
    if has_gitignore == false then { let missing = missing + ".gitignore " }
    if has_ci == false then { let missing = missing + "CI/CD " }
    return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 7: Репозиторий " + repo_name + " не имеет обязательных файлов: " + missing }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 7: Репозиторий " + repo_name + " не найден в базе." }
}

// ── Hard Rule 8: Every major task → snapshot in Telegram Archive ───────
pattern GateTaskHasTelegramSnapshot(task_id: String) -> Dict {
  let row = db_execute("SELECT telegram_snapshot_id FROM dev_tasks WHERE id = ? LIMIT 1", [task_id])
  if length(row) > 0 then {
    let snapshot_id = to_string(json_get(get(row, 0), "telegram_snapshot_id", ""))
    if snapshot_id != "" and snapshot_id != "null" then {
      return { passed: true, message: "Task " + task_id + " has Telegram archive snapshot" }
    }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 8: Крупная задача без Telegram-снимка. Создайте snapshot перед продолжением." }
}

// ── Hard Rule 9: No libraries with critical security vulnerabilities ───
pattern GateNoCriticalVulns(dependencies_json: String) -> Dict {
  let deps = parse_json(dependencies_json)
  let critical_count = 0
  let critical_names = ""
  let i = 0
  while i < length(deps) {
    let dep = get(deps, i)
    let severity = to_string(json_get(dep, "max_severity", "none"))
    if severity == "critical" then {
      let critical_count = critical_count + 1
      let critical_names = critical_names + to_string(json_get(dep, "name", "unknown")) + " "
    }
    let i = i + 1
  }
  if critical_count == 0 then {
    return { passed: true, message: "No critical vulnerabilities in dependencies" }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 9: Зависимости с критическими уязвимостями ЗАПРЕЩЕНЫ: " + critical_names + ". Обновите или замените." }
}

// ── Hard Rule 10: No API contract break without major version bump ─────
pattern GateAPIContractBreak(contract_change: String, version_bump: String) -> Dict {
  let is_breaking = contains(lower(contract_change), "breaking") or contains(lower(contract_change), "removed") or contains(lower(contract_change), "deleted field")
  ifis_breaking == false then {
    return { passed: true, message: "No breaking API contract change detected" }
  }
  let is_major_bump = contains(version_bump, "major") or contains(lower(version_bump), "x.0.0") or contains(lower(version_bump), "v2") or contains(lower(version_bump), "v3")
  if is_major_bump then {
    return { passed: true, message: "Breaking change with major version bump — allowed" }
  }
  return { passed: false, message: "❌ ЖЁСТКОЕ ПРАВИЛО 10: Нарушение API контракта без major version bump ЗАПРЕЩЕНО. Увеличьте major version + напишите migration guide." }
}

// ── Combined gate check ────────────────────────────────────────────────
pattern CheckAllHardRules(task_id: String, estimate_json: String, technologies_json: String, repo_name: String) -> Dict {
  let violations = ""
  let passed_count = 0
  let total_count = 10

  // Rule 1
  let r1 = GateNoCodeWithoutDecision(task_id)
  if r1.passed then { let passed_count = passed_count + 1 } else { let violations = violations + r1.message + "\n" }

  // Rule 2
  let r2 = GateEstimateHasRange(estimate_json)
  if r2.passed then { let passed_count = passed_count + 1 } else { let violations = violations + r2.message + "\n" }

  // Rule 3
  let r3 = GateNoHoldTech(technologies_json)
  if r3.passed then { let passed_count = passed_count + 1 } else { let violations = violations + r3.message + "\n" }

  // Rule 4 — skip in batch check (requires commit data)
  let passed_count = passed_count + 1

  // Rule 5 — skip in batch check (requires QA status)
  let passed_count = passed_count + 1

  // Rule 6 — skip in batch check (requires repo content)
  let passed_count = passed_count + 1

  // Rule 7
  if repo_name != "" then {
    let r7 = GateRepoHasRequiredFiles(repo_name)
    if r7.passed then { let passed_count = passed_count + 1 } else { let violations = violations + r7.message + "\n" }
  } else {
    let passed_count = passed_count + 1
  }

  // Rule 8
  let r8 = GateTaskHasTelegramSnapshot(task_id)
  if r8.passed then { let passed_count = passed_count + 1 } else { let violations = violations + r8.message + "\n" }

  // Rule 9 — skip in batch check (requires deps audit)
  let passed_count = passed_count + 1

  // Rule 10 — skip in batch check (requires contract change data)
  let passed_count = passed_count + 1

  let all_passed = violations == ""
  return {
    all_passed: all_passed,
    violations: violations,
    passed_count: passed_count,
    total_count: total_count
  }
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 4: LIFECYCLE STATE MACHINE
// ═══════════════════════════════════════════════════════════════════════

pattern IsValidTransition(from_state: String, to_state: String) -> Bool {
  let transition = from_state + "→" + to_state
  return contains(VALID_TRANSITIONS(), transition)
}

pattern TransitionTask(task_id: String, new_state: String, notes: String) -> Dict {
  let row = db_execute("SELECT status FROM dev_tasks WHERE id = ? LIMIT 1", [task_id])
  if length(row) == 0 then {
    return { success: false, previous_state: "", new_state: new_state, message: "Task not found: " + task_id }
  }
  let current_state = to_string(json_get(get(row, 0), "status", ""))
  ifIsValidTransition(current_state, new_state) == false then {
    return { success: false, previous_state: current_state, new_state: new_state, message: "Invalid transition: " + current_state + " → " + new_state + ". Allowed transitions: drafted→estimated, estimated→architecting, architecting→implementing, implementing→testing, testing→review, review→deployed, deployed→archived" }
  }
  let _ = db_execute("UPDATE dev_tasks SET status = ?, updated_at = datetime('now') WHERE id = ?", [new_state, task_id])
  let _ = AuditLog("dev_lifecycle", DEPT_NAME(), "task=" + task_id + " " + current_state + "→" + new_state)
  return { success: true, previous_state: current_state, new_state: new_state, message: "Task " + task_id + ": " + current_state + " → " + new_state }
}

pattern StateNameRU(state: String) -> String {
  if state == STATUS_DRAFTED() then { return "Черновик" }
  if state == STATUS_ESTIMATED() then { return "Оценена" }
  if state == STATUS_ARCHITECTING() then { return "Архитектура" }
  if state == STATUS_IMPLEMENTING() then { return "Реализация" }
  if state == STATUS_TESTING() then { return "Тестирование" }
  if state == STATUS_REVIEW() then { return "Ревью" }
  if state == STATUS_DEPLOYED() then { return "Развёрнута" }
  if state == STATUS_ARCHIVED() then { return "Архив" }
  if state == STATUS_ABANDONED() then { return "Отменена" }
  return state
}

pattern TaskTypeNameRU(task_type: String) -> String {
  if task_type == TASK_TYPE_WEB_APP() then { return "Веб-приложение" }
  if task_type == TASK_TYPE_SITE() then { return "Сайт" }
  if task_type == TASK_TYPE_AI_OFFICE() then { return "AI-офис" }
  if task_type == TASK_TYPE_LOCAL_AI() then { return "Локальный AI" }
  if task_type == TASK_TYPE_INFRASTRUCTURE() then { return "Инфраструктура" }
  if task_type == TASK_TYPE_REFACTOR() then { return "Рефакторинг" }
  if task_type == TASK_TYPE_HOTFIX() then { return "Hotfix" }
  return task_type
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 5: TECH RADAR (Tier 1 — tech-radar-maintenance)
// ═══════════════════════════════════════════════════════════════════════

pattern AddTechRadarEntry(name: String, category: String, radar_state: String, description: String, rationale: String) -> String {
  // Validate radar state
  if radar_state != RADAR_ADOPT() and radar_state != RADAR_TRIAL() and radar_state != RADAR_ASSESS() and radar_state != RADAR_HOLD() then {
    return "Недопустимое состояние Tech Radar: " + radar_state + ". Допустимые: adopt, trial, assess, hold."
  }

  // Check if entry already exists
  let existing = db_execute("SELECT id, radar_state FROM tech_radar_entries WHERE name = ? LIMIT 1", [name])
  let prev_state = ""
  if length(existing) > 0 then {
    let prev_state = to_string(json_get(get(existing, 0), "radar_state", ""))
    let _ = db_execute("UPDATE tech_radar_entries SET radar_state = ?, category = ?, description = ?, rationale = ?, updated_at = datetime('now') WHERE name = ?", [radar_state, category, description, rationale, name])
  } else {
    let _ = db_execute("INSERT INTO tech_radar_entries (name, category, radar_state, description, rationale, created_at, updated_at) VALUES (?, ?, ?, ?, ?, datetime('now'), datetime('now'))", [name, category, radar_state, description, rationale])
  }

  let _ = AuditLog("dev_radar", DEPT_NAME(), name + ": " + prev_state + " → " + radar_state)

  let state_label = ""
  if radar_state == RADAR_ADOPT() then { state_label = "✅ ADOPT — используем в production" }
  let state_label = state_label
  if radar_state == RADAR_TRIAL() then { state_label = "🧪 TRIAL — пробуем в новых проектах" }
  let state_label = state_label
  if radar_state == RADAR_ASSESS() then { state_label = "🔍 ASSESS — изучаем, не используем" }
  let state_label = state_label
  if radar_state == RADAR_HOLD() then { state_label = "⛔ HOLD — ЗАПРЕЩЕНО для новых проектов" }

  let msg = "Tech Radar: " + name + "\n"
  let msg = msg + "Категория: " + category + "\n"
  let msg = msg + "Состояние: " + state_label + "\n"
  if prev_state != "" then {
    let msg = msg + "Предыдущее: " + prev_state + "\n"
  }
  let msg = msg + "Описание: " + description + "\n"
  let msg = msg + "Обоснование: " + rationale
  return msg
}

pattern ShowTechRadar(category: String) -> String {
  let rows = db_execute("SELECT name, category, radar_state, description FROM tech_radar_entries ORDER BY radar_state, category, name", [])
  if category != "" then { let rows = db_execute("SELECT name, category, radar_state, description FROM tech_radar_entries WHERE category = ? ORDER BY radar_state, name", [category]) }

  if length(rows) == 0 then {
    return "Tech Radar пуст. Добавьте: /dev-radar-add <name> <category> <adopt|trial|assess|hold>"
  }

  let prompt = "Форматируй Tech Radar отдела Разработка. Группируй по состоянию (ADOPT, TRIAL, ASSESS, HOLD). HOLD технологии выделены как запрещённые. JSON данные: " + to_string(rows)
  let formatted = call_llm(prompt)
  return WrapWithDisclaimer(formatted)
}

pattern GetTaskTechStack(task_type: String) -> String {
  // Returns default tech stack JSON for a task type
  if task_type == TASK_TYPE_WEB_APP() then {
    return "[\"nextjs\",\"typescript\",\"tailwindcss\",\"prisma\",\"postgresql\"]"
  }
  if task_type == TASK_TYPE_SITE() then {
    return "[\"nextjs\",\"typescript\",\"tailwindcss\"]"
  }
  if task_type == TASK_TYPE_AI_OFFICE() then {
    return "[\"nextjs\",\"typescript\",\"prisma\",\"postgresql\",\"langchain\",\"openai\"]"
  }
  if task_type == TASK_TYPE_LOCAL_AI() then {
    return "[\"ollama\",\"python\",\"langchain\",\"chromadb\"]"
  }
  if task_type == TASK_TYPE_INFRASTRUCTURE() then {
    return "[\"docker\",\"github-actions\",\"terraform\"]"
  }
  if task_type == TASK_TYPE_REFACTOR() then {
    return "[\"typescript\",\"jest\",\"playwright\"]"
  }
  if task_type == TASK_TYPE_HOTFIX() then {
    return "[\"typescript\",\"jest\"]"
  }
  return "[]"
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 6: ARCHITECTURE DECISION RECORDS (Tier 1 — architecture-decision-records)
// Hard rule 1: No code without ADR
// ═══════════════════════════════════════════════════════════════════════

pattern CreateArchitectureDecision(task_id: String, title: String, context: String, alternatives: String, decision: String, consequences: String) -> String {
  // Hard rule 1: even minimal ADR required (2-3 sentences for trivial)
  if length(context) < 10 then {
    return "❌ ЖЁСТКОЕ ПРАВИЛО 1: ADR без контекста — не ADR. Укажите контекст (минимум 2-3 предложения)."
  }

  let adr_id = "adr_" + to_string(hash(title + to_string(now())))
  let _ = db_execute("INSERT INTO architecture_decisions (id, task_id, title, context, alternatives, decision, consequences, status, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, 'proposed', datetime('now'))", [adr_id, task_id, title, context, alternatives, decision, consequences])

  let _ = AuditLog("dev_adr", DEPT_NAME(), "adr_id=" + adr_id + " task=" + task_id + " title=" + substring(title, 0.0, 80.0))

  let msg = "═══ Architecture Decision Record ═══\n"
  let msg = msg + "ID: " + adr_id + "\n"
  let msg = msg + "Task: " + task_id + "\n"
  let msg = msg + "Title: " + title + "\n\n"
  let msg = msg + "── CONTEXT ──\n" + context + "\n\n"
  let msg = msg + "── ALTERNATIVES ──\n" + alternatives + "\n\n"
  let msg = msg + "── DECISION ──\n" + decision + "\n\n"
  let msg = msg + "── CONSEQUENCES ──\n" + consequences + "\n\n"
  let msg = msg + "Status: proposed\n"
  let msg = msg + "Жёсткое правило 1: код может быть написан только после ADR."
  return WrapWithDisclaimer(msg)
}

pattern ListArchitectureDecisions(task_id: String) -> String {
  let rows = db_execute("SELECT id, title, status, created_at FROM architecture_decisions WHERE task_id = ? ORDER BY created_at DESC", [task_id])
  if length(rows) == 0 then {
    return "Нет ADR для задачи " + task_id + ". Создайте: /dev-decide " + task_id
  }
  let prompt = "Форматируй список Architecture Decision Records. JSON: " + to_string(rows)
  return call_llm(prompt)
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 7: ESTIMATION DISCIPLINE (Tier 1 — estimation-discipline)
// Hard rule 2: No estimate without range
// ═══════════════════════════════════════════════════════════════════════

pattern CreateEstimate(task_id: String, task_description: String, confidence: String) -> Dict {
  // Hard rule 2: ALWAYS range estimate — point estimates FORBIDDEN
  let prompt = "Создай оценку задачи в часах. ОБЯЗАТЕЛЬНО три значения: low, expected, high.\n\n"
  let prompt = prompt + "ПРАВИЛА ОЦЕНКИ:\n"
  let prompt = prompt + "1. Точечные оценки ЗАПРЕЩЕНЫ — только диапазон low/expected/high.\n"
  let prompt = prompt + "2. low — оптимистичный сценарий (всё идёт гладко, нет блокеров).\n"
  let prompt = prompt + "3. expected — наиболее вероятный (учти типичные проблемы).\n"
  let prompt = prompt + "4. high — пессимистичный (неизвестные всплывают, интеграция сложнее).\n"
  let prompt = prompt + "5. Соотношение: high ≈ expected × 2, low ≈ expected × 0.6 (для новых доменов).\n"
  let prompt = prompt + "6. Разбей на подзадачи если expected > 16 часов.\n"
  let prompt = prompt + "7. Укажи confidence: high (знакомый домен), medium (частично знакомый), low (новый домен).\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n"
  let prompt = prompt + "Confidence: " + confidence + "\n\n"
  let prompt = prompt + "Формат: JSON с полями low, expected, high (часы), subtasks (array), confidence, rationale."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)

  let low_hours = to_float(to_string(json_get(parsed, "low", "0")))
  let expected_hours = to_float(to_string(json_get(parsed, "expected", "0")))
  let high_hours = to_float(to_string(json_get(parsed, "high", "0")))

  // Safety: ensure range exists even if LLM fails
  let expected_hours = expected_hours
  if expected_hours == 0.0 then { expected_hours = 8.0 }
  let low_hours = low_hours
  if low_hours == 0.0 then { low_hours = expected_hours * 0.6 }
  let high_hours = high_hours
  if high_hours == 0.0 then { high_hours = expected_hours * 2.0 }

  let estimate_json = json_encode({low: low_hours, expected: expected_hours, high: high_hours, confidence: confidence})

  // Validate with hard rule 2 gate
  let gate = GateEstimateHasRange(estimate_json)

  // Update task in DB
  let _ = db_execute("UPDATE dev_tasks SET estimate_low = ?, estimate_expected = ?, estimate_high = ?, estimate_confidence = ?, status = ? WHERE id = ?", [to_string(low_hours), to_string(expected_hours), to_string(high_hours), confidence, STATUS_ESTIMATED(), task_id])

  // Store for learning loop (estimate vs actual)
  let _ = db_execute("INSERT INTO dev_estimate_verifications (task_id, estimate_low, estimate_expected, estimate_high, confidence, created_at) VALUES (?, ?, ?, ?, ?, datetime('now'))", [task_id, to_string(low_hours), to_string(expected_hours), to_string(high_hours), confidence])

  let msg = "═══ ОЦЕНКА ЗАДАЧИ ═══\n"
  let msg = msg + "Task: " + task_id + "\n"
  let msg = msg + "Low: " + substring(to_string(low_hours), 0.0, 6.0) + " ч\n"
  let msg = msg + "Expected: " + substring(to_string(expected_hours), 0.0, 6.0) + " ч\n"
  let msg = msg + "High: " + substring(to_string(high_hours), 0.0, 6.0) + " ч\n"
  let msg = msg + "Confidence: " + confidence + "\n"
  let gate_str = gate.message
  if gate.passed then { let gate_str = "✅ диапазон предоставлен" }
  let msg = msg + "Жёсткое правило 2: " +gate_str

  let _ = AuditLog("dev_estimate", DEPT_NAME(), "task=" + task_id + " expected=" + to_string(expected_hours) + "h range=" + to_string(low_hours) + "-" + to_string(high_hours))

  return {
    low_hours: low_hours,
    expected_hours: expected_hours,
    high_hours: high_hours,
    estimate_json: estimate_json,
    message: msg
  }
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 8: CODE ORGANIZATION STANDARDS (Tier 1 — code-organization-standards)
// Hard rule 7: Every repo has README, LICENSE, .gitignore, CI/CD
// ═══════════════════════════════════════════════════════════════════════

pattern VerifyCodeOrganization(repo_name: String) -> Dict {
  let gate = GateRepoHasRequiredFiles(repo_name)
  if gate.passed then {
    return { compliant: true, missing: "", message: "Репозиторий " + repo_name + " соответствует стандартам организации кода." }
  }
  return { compliant: false, missing: gate.message, message: gate.message + "\n\nСтандарт требует: README.md, LICENSE, .gitignore, CI/CD pipeline (.github/workflows/ci.yml)" }
}

pattern EnforceRepoStandards(repo_name: String, repo_url: String, task_type: String) -> String {
  // Check and create missing required files
  let prompt = "Сгенерируй обязательные файлы для репозитория по стандартам Fosved.\n\n"
  let prompt = prompt + "ОБЯЗАТЕЛЬНЫЕ ФАЙЛЫ:\n"
  let prompt = prompt + "1. README.md — название, описание, установка, запуск, тесты, deploy, окружение\n"
  let prompt = prompt + "2. LICENSE — MIT (стандарт Fosved)\n"
  let prompt = prompt + "3. .gitignore — для " + task_type + " (node_modules, .env, dist, .next, coverage)\n"
  let prompt = prompt + "4. .github/workflows/ci.yml — CI/CD pipeline: lint, type-check, test, build\n\n"
  let prompt = prompt + "Репозиторий: " + repo_name + "\n"
  let prompt = prompt + "URL: " + repo_url + "\n"
  let prompt = prompt + "Тип задачи: " + TaskTypeNameRU(task_type) + "\n\n"
  let prompt = prompt + "Формат: JSON с полями readme, license, gitignore, ci_yml (содержимое файлов)."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)

  let readme = to_string(json_get(parsed, "readme", ""))
  let license_content = to_string(json_get(parsed, "license", ""))
  let gitignore = to_string(json_get(parsed, "gitignore", ""))
  let ci_yml = to_string(json_get(parsed, "ci_yml", ""))

  // Update repo record
  let readme_bool = "false"
  if readme != "" then { let readme_bool = "true" }
  let license_content_bool = "false"
  if license_content != "" then { let license_content_bool = "true" }
  let gitignore_bool = "false"
  if gitignore != "" then { let gitignore_bool = "true" }
  let ci_yml_bool = "false"
  if ci_yml != "" then { let ci_yml_bool = "true" }
  let _ = db_execute("UPDATE code_repositories SET has_readme = ?, has_license = ?, has_gitignore = ?, has_ci = ? WHERE name = ?", [readme_bool, license_content_bool, gitignore_bool, ci_yml_bool, repo_name])

  let msg = "Стандартные файлы для " + repo_name + ":\n\n"
  let msg = msg + "── README.md ──\n" + substring(readme, 0.0, 500.0) + "\n\n"
  let msg = msg + "── LICENSE ──\n" + substring(license_content, 0.0, 200.0) + "\n\n"
  let msg = msg + "── .gitignore ──\n" + substring(gitignore, 0.0, 300.0) + "\n\n"
  let msg = msg + "── .github/workflows/ci.yml ──\n" + substring(ci_yml, 0.0, 500.0)
  return msg
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 9: ITERATIVE IMPLEMENTATION (Tier 1 — iterative-implementation)
// Hard rule 4: No commit without at least 1 test
// ═══════════════════════════════════════════════════════════════════════

pattern PlanIterations(task_description: String, estimate_expected: Float) -> Dict {
  let prompt = "Спланируй итеративную реализацию задачи.\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Каждая итерация — работающий код, проходящий базовые тесты.\n"
  let prompt = prompt + "2. Никаких big-bang попыток — итеративный подход обязателен.\n"
  let prompt = prompt + "3. Первая итерация — минимальный работающий slice (MVP).\n"
  let prompt = prompt + "4. Каждая итерация ≤ 4 часа focused work.\n"
  let prompt = prompt + "5. После каждой итерации: тесты зелёные, commit, можно показать.\n"
  let prompt = prompt + "6. Коммит без теста — ЗАПРЕЩЁН (жёсткое правило 4).\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n"
  let prompt = prompt + "Оценка: " + substring(to_string(estimate_expected), 0.0, 6.0) + " часов\n\n"
  let prompt = prompt + "Формат: JSON array итераций с полями: name, description, estimated_hours, test_requirements, deliverable."

  let llm_result = call_llm(prompt)
  let iterations = parse_json(llm_result)
  let total = length(iterations)

  let msg = "План итераций (" + to_string(total) + " итераций):\n" + llm_result
  return {
    iterations: llm_result,
    total_iterations: total,
    message: msg
  }
}

pattern ImplementIteration(task_id: String, iteration_num: Int, iteration_plan: String) -> Dict {
  let prompt = "Реализуй итерацию #" + to_string(iteration_num) + " задачи.\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Код ДОЛЖЕН работать после этой итерации (пусть минимально).\n"
  let prompt = prompt + "2. Минимум 1 тест — ОБЯЗАТЕЛЬНО (жёсткое правило 4).\n"
  let prompt = prompt + "3. Не пиши код, который не можешь проверить.\n"
  let prompt = prompt + "4. Если итерация зависит от предыдущих — укажи что именно.\n\n"
  let prompt = prompt + "План итерации:\n" + iteration_plan + "\n\n"
  let prompt = prompt + "Формат: JSON с полями: code (string), tests (string), test_passed (bool), notes (string)."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)

  let code = to_string(json_get(parsed, "code", ""))
  let tests = to_string(json_get(parsed, "tests", ""))
  let test_passed_str = to_string(json_get(parsed, "test_passed", "false"))
  let test_passed = test_passed_str == "true" or test_passed_str == "1"

  // Hard rule 4 gate: no commit without test
  let commit_data = code + " " + tests
  let gate = GateCommitHasTest(commit_data)

  ifgate.passed == false then {
    return {
      success: false,
      code: code,
      tests: tests,
      test_passed: false,
      message: gate.message
    }
  }

  // Update task status if first iteration
  let row = db_execute("SELECT status FROM dev_tasks WHERE id = ? LIMIT 1", [task_id])
  if length(row) > 0 then {
    let current = to_string(json_get(get(row, 0), "status", ""))
    if current == STATUS_ARCHITECTING() then {
      let _ = TransitionTask(task_id, STATUS_IMPLEMENTING(), "Iteration " + to_string(iteration_num) + " started")
    }
  }

  let msg = "Итерация #" + to_string(iteration_num) + ":\n"
  let test_str = "❌ НЕ ПРОЙДЕНЫ"
  if test_passed then { let test_str = "✅ ПРОЙДЕНЫ" }
  let msg = msg + "Тесты: " +test_str + "\n"
  let gate_str = gate.message
  if gate.passed then { let gate_str = "✅ коммит содержит тест" }
  let msg = msg + "Жёсткое правило 4: " +gate_str

  return {
    success: test_passed,
    code: code,
    tests: tests,
    test_passed: test_passed,
    message: msg
  }
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 10: SKILL TIER 2 — TASK-TYPE SPECIFIC SKILLS
// ═══════════════════════════════════════════════════════════════════════

// ── 10a: Next.js Architecture ──────────────────────────────────────────
pattern NextjsArchitecture(task_description: String) -> Dict {
  let prompt = "Разработай архитектуру Next.js 16+ приложения.\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. App Router (не Pages Router).\n"
  let prompt = prompt + "2. Server Components по умолчанию, Client Components только где нужно.\n"
  let prompt = prompt + "3. Server Actions для мутаций, не API routes.\n"
  let prompt = prompt + "4. Streaming + Suspense для загрузки.\n"
  let prompt = prompt + "5. Route Groups для layout организации.\n"
  let prompt = prompt + "6. Error Boundaries на каждом уровне.\n"
  let prompt = prompt + "7. Стек: Next.js 16 + TypeScript + Tailwind CSS 4 + shadcn/ui + Prisma.\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n\n"
  let prompt = prompt + "Формат: JSON с полями architecture (folder structure), recommendations (array), tech_stack (array)."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)
  let arch = to_string(json_get(parsed, "architecture", llm_result))
  let recs = to_string(json_get(parsed, "recommendations", ""))

  return { architecture: arch, recommendations: recs, message: "═══ Next.js Architecture ═══\n\n" + arch + "\n\n── Рекомендации ──\n" + recs }
}

// ── 10b: Database Design ───────────────────────────────────────────────
pattern DatabaseDesign(task_description: String) -> Dict {
  let prompt = "Разработай схему базы данных (PostgreSQL + Prisma ORM).\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Нормализация с целенаправленной денормализацией (каждая — обоснована).\n"
  let prompt = prompt + "2. snake_case для колонок, PascalCase для моделей Prisma.\n"
  let prompt = prompt + "3. Индексная стратегия: индексы по запросам, не по догадке.\n"
  let prompt = prompt + "4. Миграционная дисциплина: каждая миграция обратима.\n"
  let prompt = prompt + "5. Soft delete по умолчанию (deleted_at), hard delete только для transient данных.\n"
  let prompt = prompt + "6. Audit trail для критичных таблиц (created_at, updated_at, created_by).\n"
  let prompt = prompt + "7. UUID для public-facing ID, auto-increment только для внутренних.\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n\n"
  let prompt = prompt + "Формат: JSON с полями schema (Prisma schema string), migration_plan (string), indexes (array)."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)
  let schema = to_string(json_get(parsed, "schema", llm_result))
  let migration = to_string(json_get(parsed, "migration_plan", ""))

  return { schema: schema, migration_plan: migration, message: "═══ Database Schema ═══\n\n" + schema + "\n\n── Migration Plan ──\n" + migration }
}

// ── 10c: API Design ────────────────────────────────────────────────────
pattern ApiDesign(task_description: String) -> Dict {
  let prompt = "Разработай REST API дизайн.\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. URL структура: /api/v{major}/{resource}. Вложенные через /, не query.\n"
  let prompt = prompt + "2. HTTP семантика: GET (idempotent), POST (create), PUT (replace), PATCH (update), DELETE.\n"
  let prompt = prompt + "3. Status codes: 200 OK, 201 Created, 204 No Content, 400 Bad Request, 401/403, 404, 409 Conflict, 422 Validation, 500.\n"
  let prompt = prompt + "4. Versioning: URL-based (v1, v2). Breaking change → major version bump (жёсткое правило 10).\n"
  let prompt = prompt + "5. Error shape: { error: { code, message, details } }.\n"
  let prompt = prompt + "6. Pagination: cursor-based для больших коллекций.\n"
  let prompt = prompt + "7. Auth: JWT Bearer, refresh token rotation.\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n\n"
  let prompt = prompt + "Формат: JSON с полями endpoints (array), auth_strategy (string), versioning (string), error_shape (string)."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)
  let spec = to_string(json_get(parsed, "endpoints", llm_result))
  let ver = to_string(json_get(parsed, "versioning", ""))

  return { api_spec: spec, versioning: ver, message: "═══ API Design ═══\n\n" + spec + "\n\n── Versioning ──\n" + ver }
}

// ── 10d: Agent Architecture ────────────────────────────────────────────
pattern AgentArchitecture(task_description: String) -> Dict {
  let prompt = "Разработай архитектуру AI-агента.\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Single-purpose specialists > general-purpose agents.\n"
  let prompt = prompt + "2. Tool use с validation: каждый tool call — верифицируемый.\n"
  let prompt = prompt + "3. Memory: short-term (context window) + long-term (vector DB / KV).\n"
  let prompt = prompt + "4. Planning: task decomposition before action.\n"
  let prompt = prompt + "5. Error recovery: retry с backoff + fallback + graceful degradation.\n"
  let prompt = prompt + "6. No hallucination in production: grounded responses only.\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n\n"
  let prompt = prompt + "Формат: JSON с полями agent_spec, tools (array), memory_strategy, error_handling."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)
  let spec = to_string(json_get(parsed, "agent_spec", llm_result))

  return { agent_spec: spec, message: "═══ Agent Architecture ═══\n\n" + spec }
}

// ── 10e: LLM Integration ──────────────────────────────────────────────
pattern LlmIntegration(task_description: String) -> Dict {
  let prompt = "Разработай интеграцию с LLM (Claude, GPT, Grok, local).\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Provider abstraction: единый интерфейс, провайдер — параметр.\n"
  let prompt = prompt + "2. Streaming для user-facing, non-streaming для backend.\n"
  let prompt = prompt + "3. Retry: 3 попытки с exponential backoff.\n"
  let prompt = prompt + "4. Fallback provider: primary → secondary → local.\n"
  let prompt = prompt + "5. Cost tracking: каждый вызов логируется с token count.\n"
  let prompt = prompt + "6. Prompt management: versioned, not hardcoded.\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n\n"
  let prompt = prompt + "Формат: JSON с полями integration_spec, provider_config, cost_strategy."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)
  let spec = to_string(json_get(parsed, "integration_spec", llm_result))

  return { integration_spec: spec, message: "═══ LLM Integration ═══\n\n" + spec }
}

// ── 10f: Multi-Agent Orchestration ─────────────────────────────────────
