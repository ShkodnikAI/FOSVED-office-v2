// Fosved Office v2 — Department Dispatcher
// PLACEHOLDER_BODY

pattern HandleDev(query: String, chat_id: String) -> String {
  let dept = "dev"
  let context = BuildContext(dept, query, chat_id)
  let messages = json_encode([{role: "system", content: context}, {role: "user", content: query}])
  let proxy_result = CallLLMProxy(dept, messages)
  if proxy_result == "" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error: empty reply")
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  let _ = AuditLog("dept_query", dept, "query: " + substring(query, 0.0, 100.0))
  return reply
}
