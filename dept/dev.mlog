// SECTION 17: DEPARTMENT METRICS
// ═══════════════════════════════════════════════════════════════════════


// ═══════════════════════════════════════════════════════════════════════
// SECTION 18: FULL PIPELINE (for free-text dev queries)
// ═══════════════════════════════════════════════════════════════════════

pattern DevFullPipeline(query: String, task_type: String, chat_id: String, explicit_tier3: String) -> String {
  // Step 0: Create task in DB
  let task_id = "dev_" + to_string(sha256(query + to_string(now())))
  let _ = db_execute("INSERT INTO dev_tasks (id, title, task_type, status, qa_status, created_at, updated_at) VALUES (?, ?, ?, ?, 'pending', datetime('now'), datetime('now'))", [task_id, substring(query, 0.0, 200.0), task_type, DevStatusDrafted()])

  // Step 1: Load skill tiers
  let skills = LoadSkillTiers(task_type, explicit_tier3)

  // Step 2: Architecture Decision (Tier 1, hard rule 1)
  let adr_prompt = "Создай минимальный Architecture Decision Record для задачи.\n\n"
  let adr_prompt = adr_prompt + "Даже для тривиальных задач — минимум 2-3 предложения контекста.\n\n"
  let adr_prompt = adr_prompt + "Тип задачи: " + TaskTypeNameRU(task_type) + "\n"
  let adr_prompt = adr_prompt + "Описание: " + query + "\n\n"
  let adr_prompt = adr_prompt + "Формат: JSON с полями title, context, alternatives, decision, consequences."

  let adr_llm = redact(to_string(TryVal(try call_llm(adr_prompt))), "all")
  if to_string(adr_llm) == "()" then { let adr_llm = "[оценка недоступна — провайдеры модели не ответили]" }
  let adr_parsed = parse_json(adr_llm)
  let adr_title = redact(to_string(json_get(adr_parsed, "title", "ADR for " + task_id)), "all")
  let adr_context = redact(to_string(json_get(adr_parsed, "context", query)), "all")
  let adr_alts = redact(to_string(json_get(adr_parsed, "alternatives", "See ADR")), "all")
  let adr_decision = redact(to_string(json_get(adr_parsed, "decision", "See context")), "all")
  let adr_consequences = redact(to_string(json_get(adr_parsed, "consequences", "See decision")), "all")

  let adr_result = CreateArchitectureDecision(task_id, adr_title, adr_context, adr_alts, adr_decision, adr_consequences)

  // Step 3: Estimate (Tier 1, hard rule 2)
  let estimate = CreateEstimate(task_id, query, "medium")

  // Step 4: Check Tech Radar (Tier 1, hard rule 3)
  let tech_stack = GetTaskTechStack(task_type)
  let radar_gate = GateNoHoldTech(tech_stack)

  // Step 5: Transition to architecting
  let _ = TransitionTask(task_id, STATUS_ARCHITECTING(), "Pipeline: architecture phase")

  // Step 6: Tier 2 skills — task-type specific architecture
  let tier2_result = DispatchTier2Skill(task_type, query)

  // Step 7: Plan iterations (Tier 1, iterative-implementation)
  let iterations = PlanIterations(query, estimate.expected_hours)

  // Step 8: Tier 3 skills (if explicitly requested)
  let mut tier3_result = ""
  if contains(explicit_tier3, "performance") or contains(explicit_tier3, "производительност") then {
    let perf = PerformanceOptimization(query, "")
    let tier3_result = tier3_result + perf.message + "\n\n"
  }
  if contains(explicit_tier3, "security") or contains(explicit_tier3, "безопасност") then {
    let sec = SecurityHardening(query)
    let tier3_result = tier3_result + sec.message + "\n\n"
  }
  if contains(explicit_tier3, "legacy") or contains(explicit_tier3, "модернизац") then {
    let leg = LegacySystemModernization(query)
    let tier3_result = tier3_result + leg.message + "\n\n"
  }

  // Step 9: Hard rules check
  let rules = CheckAllHardRules(task_id, estimate.estimate_json, tech_stack, "")

  // Step 10: Snapshot to Telegram Archive (hard rule 8)
  let snapshot = SnapshotToTelegramArchive(task_id, json_encode({task: task_id, type: task_type, estimate: estimate.estimate_json}), chat_id)

  // Step 11: Assemble final output
  let mut doc = "═══════════════════════════════════════\n"
  let doc = doc + "РАЗРАБОТКА — ЗАДАЧА " + task_id + "\n"
  let doc = doc + "═══════════════════════════════════════\n\n"

  // Disclaimer at top
  let doc = doc + DevDisclaimerTop() + "\n\n"

  // Task info
  let doc = doc + "── ЗАДАЧА ──\n"
  let doc = doc + "Тип: " + TaskTypeNameRU(task_type) + "\n"
  let doc = doc + "Описание: " + query + "\n"
  let doc = doc + "Status: " + STATUS_ARCHITECTING() + "\n\n"

  // Skills loaded
  let doc = doc + "── ЗАГРУЖЕНЫ SKILLS ──\n"
  let doc = doc + skills.message + "\n\n"

  // ADR (hard rule 1)
  let doc = doc + "── ARCHITECTURE DECISION (правило 1) ──\n"
  let doc = doc + adr_result + "\n\n"

  // Estimate (hard rule 2)
  let doc = doc + "── ОЦЕНКА (правило 2) ──\n"
  let doc = doc + estimate.message + "\n\n"

  // Tech Radar check (hard rule 3)
  let doc = doc + "── TECH RADAR CHECK (правило 3) ──\n"
  let radar_str = radar_gate.message
  if radar_gate.passed then { let radar_str = "✅ " + radar_gate.message }
  let doc = doc +radar_str + "\n\n"

  // Architecture (Tier 2)
  let doc = doc + "── АРХИТЕКТУРА ──\n"
  let doc = doc + tier2_result + "\n\n"

  // Iteration plan
  let doc = doc + "── ПЛАН ИТЕРАЦИЙ ──\n"
  let mut doc = doc + iterations.message + "\n\n"

  // Tier 3 (if any)
  if tier3_result != "" then {
    let doc = doc + "── TIER 3 (explicit) ──\n"
    let doc = doc + tier3_result + "\n\n"
  }

  // Hard rules summary
  let mut doc = doc + "── ЖЁСТКИЕ ПРАВИЛА ──\n"
  if rules.all_passed then {
    let doc = doc + "✅ Все " + to_string(rules.passed_count) + "/" + to_string(rules.total_count) + " проверенных правил соблюдены\n\n"
  } else {
    let doc = doc + "❌ Нарушения:\n" + rules.violations + "\n\n"
  }

  // Storage
  let doc = doc + "── TRIPLE STORAGE ──\n"
  let doc = doc + "GitHub: primary (source of truth)\n"
  let doc = doc + "Telegram Archive: " + snapshot + "\n"
  let doc = doc + "Local: deferred sync\n\n"

  // Disclaimer at bottom
  let doc = doc + DevDisclaimerBottom()

  // Update task status
  let _ = RecordAssistantMessage(chat_id, DevDeptName(), substring(doc, 0.0, 4000.0))
  let _ = AuditLog("dev_pipeline", DevDeptName(), "task=" + task_id + " type=" + task_type + " estimate=" + substring(to_string(estimate.expected_hours), 0.0, 6.0) + "h rules=" + to_string(rules.passed_count) + "/" + to_string(rules.total_count))

  return doc
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 18.5: FOIP-003 PHASE 3 — Plan Mode + Design Tokens
// ═══════════════════════════════════════════════════════════════════════

// FOIP-003.7: Plan Mode — generate plan only, no code
pattern DevPlanMode(query: String, task_type: String, chat_id: String) -> String {
  let mut plan_prompt = "Ты — технический архитектор. Создай ДЕТАЛЬНЫЙ ПЛАН реализации задачи. НЕ пиши код."
  let plan_prompt = plan_prompt + "\n\nТип задачи: " + TaskTypeNameRU(task_type)
  let plan_prompt = plan_prompt + "\nОписание: " + query
  let plan_prompt = plan_prompt + "\n\nСтруктура плана:"
  let plan_prompt = plan_prompt + "\n1. Цель и scope (что входит, что нет)"
  let plan_prompt = plan_prompt + "\n2. Архитектура (стек, структура проекта, ключевые компоненты)"
  let plan_prompt = plan_prompt + "\n3. Пошаговый план реализации (6-10 шагов)"
  let plan_prompt = plan_prompt + "\n4. Риски и решения"
  let plan_prompt = plan_prompt + "\n5. Оценка: часов на этап, всего"
  let mut plan_prompt = plan_prompt + "\n\nФормат: структурированный markdown. Без кода."

  // FOIP-003.8: Include tmpl if matched
  let tmpl = MatchTemplate(task_type, query)
  if tmpl != "" then {
    let template_ctx = TemplateGet(tmpl)
    let plan_prompt = plan_prompt + "\n\nИспользуй эту архитектуру как базис:\n" + template_ctx
  }

  // FOIP-003.9: Include design tokens if available
  let tokens = GetDesignTokensForChat(chat_id)
  if tokens != "" then {
    let plan_prompt = plan_prompt + "\n\nDesign tokens клиента:\n" + tokens
  }

  let plan = redact(to_string(TryVal(try call_llm(plan_prompt))), "all")
  if to_string(plan) == "()" then { let plan = "[оценка недоступна — провайдеры модели не ответили]" }
  let doc = "\n\n\n\n\n\n\n\n"
  let doc = doc + "PLAN MODE\n"
  let doc = doc + "\n" + plan
  let doc = doc + "\n\nДля реализации плана: отправь задачу текстом (запустит DevFullPipeline) или используй /dev-implement\n"
  let doc = doc + DevDisclaimerBottom()
  return doc
}

// FOIP-003.9: Design Tokens — store/get/apply
pattern StoreDesignTokens(name: String, tokens_json: String) -> String {
  let _ = db_execute("INSERT INTO design_tokens (name, tokens_json, updated_at) VALUES (?, ?, datetime('now')) ON CONFLICT(name) DO UPDATE SET tokens_json = ?, updated_at = datetime('now')", [name, tokens_json, tokens_json])
  let _ = kv_set("design_tokens:" + name, tokens_json)
  return "ok"
}

pattern GetDesignTokens(name: String) -> String {
  let cached = kv_get("design_tokens:" + name)
  if cached != "" then { return cached }
  let rows = query("SELECT tokens_json FROM design_tokens WHERE name = ?", [name])
  if length(rows) == 0.0 then { return "" }
  let result = redact(to_string(json_get(rows[0], "tokens_json", "")), "all")
  if result != "" then { let _ = kv_set("design_tokens:" + name, result) }
  return result
}

pattern GetDesignTokensForChat(chat_id: String) -> String {
  let brand = kv_get("brand:" + chat_id)
  if brand == "" then { return "" }
  return GetDesignTokens(brand)
}

pattern ListDesignTokens() -> String {
  let rows = query("SELECT name, updated_at FROM design_tokens ORDER BY updated_at DESC", [])
  if length(rows) == 0.0 then { return "Нет сохранённых design tokens." }
  let mut out = ""
  each row in rows {
    let name = redact(to_string(json_get(row, "name", "?")), "all")
    let updated = redact(to_string(json_get(row, "updated_at", "?")), "all")
    let out = out + name + " (updated: " + updated + ")\n"
  }
  return out
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 19: COMMAND ROUTER
// ═══════════════════════════════════════════════════════════════════════
pattern DevRouteByCommand(parsed: Dict, chat_id: String) -> String {
  // Out-of-scope gate
  if parsed.is_out_of_scope then {
    return DevDeclineOutOfScope(parsed.task_description)
  }

  let cmd = parsed.command
  let mut parts = []
  let mut name = ""
  let mut category = ""

  // /issue — Create GitHub issue via MCP (FO-014)
  if cmd == "mcp-issue" then {
    return McpHandleIssue(parsed.task_description, chat_id)
  }

  // /ci — CI status via GitHub MCP (FO-014)
  if cmd == "mcp-ci" then {
    return McpHandleCI(parsed.task_description, chat_id)
  }

  // /docs — Documents sandbox via filesystem MCP (FO-014)
  if cmd == "mcp-docs" then {
    return McpHandleDocs(parsed.task_description, chat_id)
  }

  // /dev — Dashboard
  if cmd == "dev" then {
    return DevDashboard(chat_id)
  }

  // /dev-estimate — Create estimate
  if cmd == "dev-estimate" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-estimate <task_id> [confidence]" }
    let mut parts = split(parsed.task_description, " ")
    let confidence = "medium"
    if length(parts) > 2 then { let confidence = to_string(get(parts, 2)) }
    let est = CreateEstimate(parsed.task_id, parsed.task_description, confidence)
    return est.message
  }

  // /dev-decide — Create ADR
  if cmd == "dev-decide" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-decide <task_id> <title>" }
    let parts = split(parsed.task_description, " ")
    let title = "ADR for " + parsed.task_id
    if length(parts) > 2 then { let title = join(slice(parts, 2.0, length(parts)), " ") }
    return CreateArchitectureDecision(parsed.task_id, title, parsed.task_description, "See context", "See alternatives", "See decision")
  }

  // /dev-implement — Implement iteration
  if cmd == "dev-implement" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-implement <task_id> [iteration_num]" }
    let parts = split(parsed.task_description, " ")
    let iter_num = 1
    if length(parts) > 2 then { let iter_num = to_int(to_string(get(parts, 2))) }
    let result = ImplementIteration(parsed.task_id, iter_num, parsed.task_description)
    return result.message
  }

  // /dev-task — Show task
  if cmd == "dev-task" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-task <task_id>" }
    return ShowTask(parsed.task_id)
  }

  // /dev-tasks — List tasks
  if cmd == "dev-tasks" then {
    let parts = split(parsed.task_description, " ")
    let status_filter = ""
    if length(parts) > 1 then { let status_filter = to_string(get(parts, 1)) }
    return ListTasks(status_filter, 20)
  }

  // /dev-repos — List repositories
  if cmd == "dev-repos" then {
    return ListRepos()
  }

  // /dev-repo — Show repository
  if cmd == "dev-repo" then {
    if parsed.repo_name == "" then { return "Укажите имя репозитория: /dev-repo <name>" }
    return ShowRepo(parsed.repo_name)
  }

  // /dev-create-repo — Create repository
  if cmd == "dev-create-repo" then {
    let parts = split(parsed.task_description, " ")
    if length(parts) < 3 then { return "Формат: /dev-create-repo <name> <task_type> [url]" }
    let mut name = to_string(get(parts, 1))
    let task_type = to_string(get(parts, 2))
    let url = "https://github.com/fosved/" + name
    if length(parts) > 3 then { let url = to_string(get(parts, 3)) }
    return CreateRepo(name, task_type, url)
  }

  // /dev-radar — Show Tech Radar
  if cmd == "dev-radar" then {
    let parts = split(parsed.task_description, " ")
    let mut category = ""
    if length(parts) > 1 then { let category = to_string(get(parts, 1)) }
    return ShowTechRadar(category)
  }

  // /dev-radar-add — Add Tech Radar entry
  if cmd == "dev-radar-add" then {
    let parts = split(parsed.task_description, " ")
    if length(parts) < 4 then { return "Формат: /dev-radar-add <name> <category> <adopt|trial|assess|hold> [description]" }
    let name = to_string(get(parts, 1))
    let category = to_string(get(parts, 2))
    let state = to_string(get(parts, 3))
    let desc = "Added via /dev-radar-add"
    if length(parts) > 4 then { let desc = join(slice(parts, 4.0, length(parts)), " ") }
    return AddTechRadarEntry(name, category, state, desc, "User decision")
  }

  // /dev-deploy — Deploy task
  if cmd == "dev-deploy" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-deploy <task_id>" }
    return DeployTask(parsed.task_id, chat_id)
  }

  // /dev-archive — Archive task
  if cmd == "dev-archive" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-archive <task_id> <actual_hours>" }
    let parts = split(parsed.task_description, " ")
    let actual = "0"
    if length(parts) > 2 then { let actual = to_string(get(parts, 2)) }
    return ArchiveTask(parsed.task_id, actual)
  }

  // /dev-local-sync — Local sync
  if cmd == "dev-local-sync" then {
    return LocalSync()
  }

  // /dev-plan — FOIP-003.7: Plan mode (plan only, no code generation)
  if cmd == "dev-plan" then {
    let mut plan_query = parsed.task_description
    let plan_query = replace(plan_query, "/dev-plan", "")
    let plan_query = trim(plan_query)
    if plan_query == "" then { return "Формат: /dev-plan <описание задачи>" }
    return DevPlanMode(plan_query, parsed.task_type, chat_id)
  }

  // /dev-tokens -- FOIP-003.9: design tokens
  if cmd == "dev-tokens" then {
    let mut rest = replace(parsed.task_description, "/dev-tokens", "")
    let rest = trim(rest)
    if rest == "" then {
      return ListDesignTokens()
    }
    let parts = split(rest, " ")
    let action = to_string(get(parts, 0))
    if action == "set" and length(parts) >= 3.0 then {
      let name = to_string(get(parts, 1))
      let json_str = substring(rest, 5.0 + length(name) + 1.0, 10000.0)
      let _ = StoreDesignTokens(name, json_str)
      let _ = kv_set("brand:" + chat_id, name)
      return "Design tokens saved as " + name + ". Will be used in /dev and /dev-plan."
    }
    return "Format: /dev-tokens (list) or /dev-tokens set <name> <json>"
  }

  // Free-text: check tmpl (FOIP-003.8) + design tokens (FOIP-003.9)
  let tmpl = MatchTemplate(parsed.task_type, parsed.task_description)
  let mut enriched_query = parsed.task_description
  if tmpl != "" then {
    let template_ctx = TemplateGet(tmpl)
    let enriched_query = enriched_query + "\n\n[Template: " + tmpl + "]\n" + template_ctx
  }
  let dtokens = GetDesignTokensForChat(chat_id)
  if dtokens != "" then {
    let enriched_query = enriched_query + "\n\n[Design tokens]\n" + dtokens
  }
  return DevFullPipeline(enriched_query, parsed.task_type, chat_id, "")
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 20: ENTRY POINT (HandleDev)
// This is the pattern that app.mlog calls via import dept/dev
// ═══════════════════════════════════════════════════════════════════════

pattern HandleDev(query: String, chat_id: String) -> String {
  let dept = DevDeptName()
  let _ = AuditLog("dept_entry", dept, "query: " + substring(query, 0, 100))

  // Parse query → task type + command
  let parsed = ParseDevQuery(query)

  // Route to command handler or full pipeline
  let result = DevRouteByCommand(parsed, chat_id)

  // Final safety: ensure disclaimer is present
  let has_disclaimer = contains(result, "Код генерируется проектным ассистентом") or contains(result, "проектного ассистента")
  let output = DevWrapWithDisclaimer(result)
  if has_disclaimer then { let output = result }

  // ── LLM-Verifier: code/architecture quality ──
  let dv_resp = TryVal(try call_python("llm_verifier", "score", json_encode([query, output, "Technical accuracy: Are code snippets/architecture patterns correct? Security awareness: Are common vulnerabilities (injection, auth, data exposure) addressed? Best practices: Does it follow established patterns for the stated tech stack?"])))
  if to_string(dv_resp) != "()" and contains(to_string(dv_resp), "error") == false then {
    let dv_parsed = TryVal(try parse_json(dv_resp))
    let dv_score = to_float(TryVal(try json_get(dv_parsed, "result", "0.5")))
    let _ = AuditLog("dev_verify_score", dept, "score=" + to_string(dv_score))
  }

  let _ = kv_set("last_model_" + dept, "native_call_llm")
  let _ = RecordAssistantMessage(chat_id, dept, substring(output, 0.0, 4000.0))

  return output
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 20: MCP TOOLS — github + filesystem (FO-014, ADR-0132 v1)
// ═══════════════════════════════════════════════════════════════════════
// Вход: bin/mlog содержит mcp_call/mcp_list_tools (Metalogos №268).
// Гейты ядра: METALOGOS_SERVE_ALLOW_EXEC=1 (exec-гейт тел роутов) +
// METALOGOS_MCP_ALLOWLIST="mcp_servers/github,mcp_servers/filesystem"
// (конфиг, не код; изменение — отдельный коммит). Каждый spawn ядра —
// в METALOGOS_AUDIT_LOG_PATH; каждый вызов офиса — в audit_log.
// Taint: вывод тулз — недоверенные данные (UserInput из №268); наружу
// (промпты/ответы) — только после redact(). reflex_train с taint-входом
// отвергается статикой ядра.
// Инцидент-политика: try mcp_call → () при любом сбое ядра (spawn/таймаут/
// протокол) → департамент НЕ падает, диагностика + fallback «руками».
// Отказы самих тулз приходят как {"ok": false, "error": ...} (тулзы не
// бросают — детали диагностики не теряются в try).
// ═══════════════════════════════════════════════════════════════════════

pattern McpGithubServerCmd() -> String {
  return "mcp_servers/github"
}

pattern McpFsServerCmd() -> String {
  return "mcp_servers/filesystem"
}

// Журнал mcp_call: dept, сервер, тулза, цель (требование наряда —
// офисный лог поверх subprocess-лога ядра).
pattern McpAudit(server: String, tool: String, purpose: String, status: String) -> String {
  let _ = db_execute("INSERT INTO audit_log (action, actor, dept, details, status) VALUES ('mcp_call', 'dev', 'dev', ?, ?)", ["server=" + server + " tool=" + tool + " purpose=" + purpose, status])
  return "ok"
}

// Единый вызов GitHub-MCP: гейты ядра + audit + redact. Всегда Dict:
// { ok: true|false, body: <redact-ed текст сервера>, note: <диагностика> }
pattern McpGithubCall(tool: String, args_json: String, purpose: String) -> Dict {
  let _ = McpAudit("github", tool, purpose, "attempt")
  let out = TryVal(try mcp_call(McpGithubServerCmd(), [], tool, args_json))
  if redact(to_string(out), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAudit("github", tool, purpose, "error")
    return { ok: false, body: "", note: "MCP-сервер github недоступен (гейт ядра/сбой/таймаут). Fallback: сделать руками. Детали: METALOGOS_AUDIT_LOG_PATH." }
  }
  let parsed = TryVal(try parse_json(to_string(out)))
  if redact(to_string(parsed), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAudit("github", tool, purpose, "error")
    return { ok: false, body: redact(to_string(out), "secrets"), note: "ответ сервера не JSON" }
  }
  if redact(to_string(json_get(parsed, "ok", "false")), "hash_only") == redact("true", "hash_only") then {
    let _ = McpAudit("github", tool, purpose, "ok")
    return { ok: true, body: redact(to_string(out), "secrets"), note: "" }
  }
  let _ = McpAudit("github", tool, purpose, "refused")
  let errmsg = redact(to_string(json_get(parsed, "error", "(без деталей)")), "all")
  return { ok: false, body: redact(errmsg, "secrets"), note: "сервер сообщил об отказе" }
}

// Единый вызов filesystem-MCP (песочница data/documents, вне git).
pattern McpFsCall(tool: String, args_json: String, purpose: String) -> Dict {
  let _ = McpAudit("filesystem", tool, purpose, "attempt")
  let out = TryVal(try mcp_call(McpFsServerCmd(), [], tool, args_json))
  if redact(to_string(out), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAudit("filesystem", tool, purpose, "error")
    return { ok: false, body: "", note: "MCP-сервер filesystem недоступен (гейт ядра/сбой/таймаут). Fallback: сделать руками." }
  }
  let parsed = TryVal(try parse_json(to_string(out)))
  if redact(to_string(parsed), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAudit("filesystem", tool, purpose, "error")
    return { ok: false, body: redact(to_string(out), "secrets"), note: "ответ сервера не JSON" }
  }
  if redact(to_string(json_get(parsed, "ok", "false")), "hash_only") == redact("true", "hash_only") then {
    let _ = McpAudit("filesystem", tool, purpose, "ok")
    return { ok: true, body: redact(to_string(out), "secrets"), note: "" }
  }
  let _ = McpAudit("filesystem", tool, purpose, "refused")
  let errmsg = redact(to_string(json_get(parsed, "error", "(без деталей)")), "all")
  return { ok: false, body: redact(errmsg, "secrets"), note: "сервер сообщил об отказе (вне песочницы?)" }
}

// MON-2/MON-3 (#171): единый вызов media-MCP (YouTube/TikTok для ЛЗ).
// Зеркало McpGithubCall: гейты ядра + audit + redact. Весь вывод недоверенный.
pattern McpMediaServerCmd() -> String {
  return "mcp_servers/media"
}

pattern McpMediaCall(tool: String, args_json: String, purpose: String) -> Dict {
  let _ = McpAudit("media", tool, purpose, "attempt")
  let out = TryVal(try mcp_call(McpMediaServerCmd(), [], tool, args_json))
  if redact(to_string(out), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAudit("media", tool, purpose, "error")
    return { ok: false, body: "", note: "MCP-сервер media недоступен (гейт ядра/сбой/таймаут). Fallback: без медиа-данных." }
  }
  let parsed = TryVal(try parse_json(to_string(out)))
  if redact(to_string(parsed), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAudit("media", tool, purpose, "error")
    return { ok: false, body: redact(to_string(out), "secrets"), note: "ответ сервера не JSON" }
  }
  if redact(to_string(json_get(parsed, "ok", "false")), "hash_only") == redact("true", "hash_only") then {
    let _ = McpAudit("media", tool, purpose, "ok")
    return { ok: true, body: redact(to_string(out), "secrets"), note: "" }
  }
  let _ = McpAudit("media", tool, purpose, "refused")
  let errmsg = redact(to_string(json_get(parsed, "error", "(без деталей)")), "all")
  return { ok: false, body: redact(errmsg, "secrets"), note: "сервер сообщил об отказе (медиа-источник)" }
}

pattern McpWebServerCmd() -> String {
  return "mcp_servers/web"
}

// Единый вызов web-MCP (SHOP-2, #172): транспорт до страниц и JSON API
// маркетплейсов (WB/Onliner/21vek/Kufar) и сайтов производителей для
// SHOP-3/SHOP-6. Тот же контракт, что github/fs: { ok, body, note }.
// Отказы транспорта приходят как {"ok":false,"kind":"robots_disallow"|
// "rate_limited"|"http_4xx"|"network"|"ssrf"|...} (тулзы не бросают).
pattern McpWebCall(tool: String, args_json: String, purpose: String) -> Dict {
  let _ = McpAudit("web", tool, purpose, "attempt")
  let out = TryVal(try mcp_call(McpWebServerCmd(), [], tool, args_json))
  if redact(to_string(out), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAudit("web", tool, purpose, "error")
    return { ok: false, body: "", note: "MCP-сервер web недоступен (гейт ядра/сбой/таймаут). Fallback: сделать руками." }
  }
  let parsed = TryVal(try parse_json(to_string(out)))
  if redact(to_string(parsed), "hash_only") == redact("()", "hash_only") then {
    let _ = McpAudit("web", tool, purpose, "error")
    return { ok: false, body: redact(to_string(out), "secrets"), note: "ответ сервера не JSON" }
  }
  if redact(to_string(json_get(parsed, "ok", "false")), "hash_only") == redact("true", "hash_only") then {
    let _ = McpAudit("web", tool, purpose, "ok")
    return { ok: true, body: redact(to_string(out), "secrets"), note: "" }
  }
  let _ = McpAudit("web", tool, purpose, "refused")
  let errmsg = redact(to_string(json_get(parsed, "error", "(без деталей)")), "all")
  return { ok: false, body: redact(errmsg, "secrets"), note: "сервер сообщил об отказе (robots/rate-limit/сеть?)" }
}

// ── /issue <owner/repo> <заголовок и текст> — открыть issue через MCP ──
pattern McpHandleIssue(query: String, chat_id: String) -> String {
  let parts = split(query, " ")
  if length(parts) < 3 then {
    return "Формат: /issue <owner/repo> <заголовок и текст>\nПример: /issue ShkodnikAI/FOSVED-office-v2 Баг: тестовый наряд"
  }
  let repo = to_string(get(parts, 1))
  if contains(repo, "/") == false then {
    return "repo должен быть в формате owner/repo (например ShkodnikAI/FOSVED-office-v2)"
  }
  let text = join(slice(parts, 2.0, length(parts)), " ")
  let mut title = text
  if length(text) > 80.0 then { let title = substring(text, 0.0, 80.0) + "…" }
  let body = text + "\n\n---\nСоздано dev-департаментом офиса через MCP (FO-014)."
  let res = McpGithubCall("create_issue", json_encode({repo: repo, title: title, body: body}), "/issue")
  if res.ok == false then {
    let msg = "Issue не создан: " + res.body + "\n" + res.note
    let _ = SendTelegramReply(chat_id, substring(msg, 0.0, 3500.0))
    return msg
  }
  let data = TryVal(try parse_json(res.body))
  let number = redact(to_string(json_get(data, "number", "?")), "all")
  let url = redact(to_string(json_get(data, "url", "")), "all")
  let msg = "Issue открыт через MCP: #" + number + " " + repo + "\n" + url + "\n\nTaint-контур: вывод тулзы прошёл redact(), вызов — в audit_log."
  let _ = SendTelegramReply(chat_id, msg)
  return msg
}

// ── /ci <owner/repo> [branch] — CI-статус через MCP ─────────────────────
pattern McpHandleCI(query: String, chat_id: String) -> String {
  let parts = split(query, " ")
  if length(parts) < 2 then {
    return "Формат: /ci <owner/repo> [branch]\nПример: /ci ShkodnikAI/FOSVED-office-v2 main"
  }
  let repo = to_string(get(parts, 1))
  let mut refv = "main"
  if length(parts) > 2 then { let refv = to_string(get(parts, 2)) }
  let res = McpGithubCall("list_check_runs", json_encode({repo: repo, ref: refv}), "/ci")
  if res.ok == false then {
    let msg = "CI-статус недоступен: " + res.body + "\n" + res.note
    let _ = SendTelegramReply(chat_id, substring(msg, 0.0, 3500.0))
    return msg
  }
  let data = TryVal(try parse_json(res.body))
  let summary = redact(to_string(json_get(data, "summary", "(нет check-runs)")), "all")
  let count = redact(to_string(json_get(data, "count", "?")), "all")
  let msg = "CI " + repo + "@" + refv + " — " + count + " проверок:\n" + redact(summary, "secrets")
  let _ = SendTelegramReply(chat_id, substring(msg, 0.0, 3500.0))
  return msg
}

// ── /docs list | /docs read <path> | /docs write <path> <текст> ────────
// Документы — filesystem-MCP в песочнице data/documents (вне git).
pattern McpHandleDocs(query: String, chat_id: String) -> String {
  let parts = split(query, " ")
  if length(parts) < 2 then {
    return "Формат: /docs list [path] | /docs read <path> | /docs write <path> <текст>"
  }
  let sub = to_string(get(parts, 1))

  if sub == "list" then {
    let mut path = ""
    if length(parts) > 2 then { let path = to_string(get(parts, 2)) }
    let res = McpFsCall("list_dir", json_encode({path: path}), "/docs list")
    if res.ok == false then {
      let msg = "Список недоступен: " + res.body + "\n" + res.note
      let _ = SendTelegramReply(chat_id, substring(msg, 0.0, 3500.0))
      return msg
    }
    let data = TryVal(try parse_json(res.body))
    // №422: items — массив (each); redact(массив) = рантайм-ошибка; поля моются ниже
    let items = TryVal(try json_get(data, "items", "[]"))
    let mut out = "Документы (песочница data/documents):\n"
    let rows = TryVal(try items)
    if to_string(rows) != "()" then {
      each row in rows {
        let nm = redact(to_string(json_get(row, "name", "")), "all")
        let tp = redact(to_string(json_get(row, "type", "file")), "all")
        if tp == "dir" then { let out = out + "  " + nm + "/\n" } else { let out = out + "  " + nm + "\n" }
      }
    }
    let _ = SendTelegramReply(chat_id, substring(out, 0.0, 3500.0))
    return out
  }

  if sub == "read" then {
    if length(parts) < 3 then { return "Формат: /docs read <path>" }
    let path = to_string(get(parts, 2))
    let res = McpFsCall("read_file", json_encode({path: path}), "/docs read")
    if res.ok == false then {
      let msg = "Чтение не удалось: " + res.body + "\n" + res.note
      let _ = SendTelegramReply(chat_id, substring(msg, 0.0, 3500.0))
      return msg
    }
    let data = TryVal(try parse_json(res.body))
    let content = redact(to_string(json_get(data, "content", "")), "all")
    let mut out = "── " + path + " ──\n" + redact(content, "secrets")
    if length(out) > 3500.0 then { let out = substring(out, 0.0, 3500.0) + "\n…(обрезано)" }
    let _ = SendTelegramReply(chat_id, out)
    return out
  }

  if sub == "write" then {
    if length(parts) < 4 then { return "Формат: /docs write <path> <текст>" }
    let path = to_string(get(parts, 2))
    let content = join(slice(parts, 3.0, length(parts)), " ")
    let res = McpFsCall("write_file", json_encode({path: path, content: content}), "/docs write")
    if res.ok == false then {
      let msg = "Запись не удалась: " + res.body + "\n" + res.note
      let _ = SendTelegramReply(chat_id, substring(msg, 0.0, 3500.0))
      return msg
    }
    let msg = "Записано через MCP: " + path + " (песочница data/documents, вне git)"
    let _ = SendTelegramReply(chat_id, msg)
    return msg
  }

  return "Неизвестная подкоманда: " + sub + "\nФормат: /docs list | /docs read <path> | /docs write <path> <текст>"
}

// ── TEAM-2 #481 A.1: навык dev/tech_estimate (реестр dept/team.mlog) ─
// Тихая облегчённая функция: оценка сложности и стека.
pattern DevTechEstimate(question: String) -> String {
  let prompt = "Ты отдел разработки, коллега запрашивает навык tech_estimate: оценка сложности и стека. Вопрос: " + question + "\nФормат: (1) рекомендуемый стек; (2) оценка трудоёмкости диапазоном (часы/дни) с разбивкой; (3) главные технические риски. Без приветствий и подписи."
  let r = redact(to_string(TryVal(try call_llm(prompt, question))), "all")
  if r == "()" then { return "(коллега dev/tech_estimate недоступен: модель не ответила)" }
  return r
}

