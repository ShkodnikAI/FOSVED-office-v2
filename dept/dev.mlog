// ═══════════════════════════════════════════════════════════════════════
// SECTION 17: DEPARTMENT METRICS
// ═══════════════════════════════════════════════════════════════════════

pattern DevScore() -> String {
  // 90-day metrics
  let total = db_execute("SELECT COUNT(*) as c FROM dev_tasks WHERE created_at >= datetime('now', '-90 days')", [])
  let deployed = db_execute("SELECT COUNT(*) as c FROM dev_tasks WHERE status = 'deployed' AND updated_at >= datetime('now', '-90 days')", [])
  let with_adr = db_execute("SELECT COUNT(*) as c FROM dev_tasks t JOIN architecture_decisions a ON t.id = a.task_id WHERE t.created_at >= datetime('now', '-90 days')", [])
  let with_range = db_execute("SELECT COUNT(*) as c FROM dev_tasks WHERE estimate_low IS NOT NULL AND estimate_expected IS NOT NULL AND estimate_high IS NOT NULL AND created_at >= datetime('now', '-90 days')", [])
  let avg_mape = db_execute("SELECT AVG(ABS(mape)) as avg FROM dev_estimate_verifications WHERE verified_at >= datetime('now', '-90 days') AND actual_hours IS NOT NULL", [])

  let total_count = to_int(to_string(json_get(get(total, 0), "c", "0")))
  let deployed_count = to_int(to_string(json_get(get(deployed, 0), "c", "0")))
  let adr_count = to_int(to_string(json_get(get(with_adr, 0), "c", "0")))
  let range_count = to_int(to_string(json_get(get(with_range, 0), "c", "0")))
  let mape_val = to_float(to_string(json_get(get(avg_mape, 0), "avg", "0")))

  let adr_rate = 0.0
  if total_count > 0 then { adr_rate = to_float(to_string(adr_count)) / to_float(to_string(total_count)) * 100.0 }
  let range_rate = 0.0
  if total_count > 0 then { range_rate = to_float(to_string(range_count)) / to_float(to_string(total_count)) * 100.0 }
  let deploy_rate = 0.0
  if total_count > 0 then { deploy_rate = to_float(to_string(deployed_count)) / to_float(to_string(total_count)) * 100.0 }

  let msg = "═══ МЕТРИКИ ОТДЕЛА РАЗРАБОТКА (90 дней) ═══\n\n"
  let msg = msg + "Всего задач: " + to_string(total_count) + "\n"
  let msg = msg + "Deployed: " + to_string(deployed_count) + " (" + substring(to_string(deploy_rate), 0.0, 5.0) + "%)\n"
  let msg = msg + "ADR compliance: " + substring(to_string(adr_rate), 0.0, 5.0) + "% (цель: 100%, правило 1)\n"
  let msg = msg + "Range estimate compliance: " + substring(to_string(range_rate), 0.0, 5.0) + "% (цель: 100%, правило 2)\n"
  let msg = msg + "Estimate MAPE: " + substring(to_string(mape_val), 0.0, 5.0) + "% (цель: ≤30%)\n\n"
  let msg = msg + "── ЦЕЛЕВЫЕ ПОКАЗАТЕЛИ ──\n"
  let msg = msg + "• Production bug rate: ≤5 per month\n"
  let msg = msg + "• Time to first commit: ≤4 hours\n"
  let msg = msg + "• Code review pass rate: ≥70%\n"
  let msg = msg + "• Tech radar churn rate: ≤2 changes/week"

  return msg
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 18: FULL PIPELINE (for free-text dev queries)
// ═══════════════════════════════════════════════════════════════════════

pattern FullPipeline(query: String, task_type: String, chat_id: String, explicit_tier3: String) -> String {
  // Step 0: Create task in DB
  let task_id = "dev_" + to_string(hash(query + to_string(now())))
  let _ = db_execute("INSERT INTO dev_tasks (id, title, task_type, status, qa_status, created_at, updated_at) VALUES (?, ?, ?, ?, 'pending', datetime('now'), datetime('now'))", [task_id, substring(query, 0.0, 200.0), task_type, STATUS_DRAFTED()])

  // Step 1: Load skill tiers
  let skills = LoadSkillTiers(task_type, explicit_tier3)

  // Step 2: Architecture Decision (Tier 1, hard rule 1)
  let adr_prompt = "Создай минимальный Architecture Decision Record для задачи.\n\n"
  let adr_prompt = adr_prompt + "Даже для тривиальных задач — минимум 2-3 предложения контекста.\n\n"
  let adr_prompt = adr_prompt + "Тип задачи: " + TaskTypeNameRU(task_type) + "\n"
  let adr_prompt = adr_prompt + "Описание: " + query + "\n\n"
  let adr_prompt = adr_prompt + "Формат: JSON с полями title, context, alternatives, decision, consequences."

  let adr_llm = call_llm(adr_prompt)
  let adr_parsed = parse_json(adr_llm)
  let adr_title = to_string(json_get(adr_parsed, "title", "ADR for " + task_id))
  let adr_context = to_string(json_get(adr_parsed, "context", query))
  let adr_alts = to_string(json_get(adr_parsed, "alternatives", "See ADR"))
  let adr_decision = to_string(json_get(adr_parsed, "decision", "See context"))
  let adr_consequences = to_string(json_get(adr_parsed, "consequences", "See decision"))

  let adr_result = CreateArchitectureDecision(task_id, adr_title, adr_context, adr_alts, adr_decision, adr_consequences)

  // Step 3: Estimate (Tier 1, hard rule 2)
  let estimate = CreateEstimate(task_id, query, "medium")

  // Step 4: Check Tech Radar (Tier 1, hard rule 3)
  let tech_stack = GetTaskTechStack(task_type)
  let radar_gate = GateNoHoldTech(tech_stack)

  // Step 5: Transition to architecting
  let _ = TransitionTask(task_id, STATUS_ARCHITECTING(), "Pipeline: architecture phase")

  // Step 6: Tier 2 skills — task-type specific architecture
  let tier2_result = DispatchTier2Skill(task_type, query)

  // Step 7: Plan iterations (Tier 1, iterative-implementation)
  let iterations = PlanIterations(query, estimate.expected_hours)

  // Step 8: Tier 3 skills (if explicitly requested)
  let tier3_result = ""
  if contains(explicit_tier3, "performance") or contains(explicit_tier3, "производительност") then {
    let perf = PerformanceOptimization(query, "")
    let tier3_result = tier3_result + perf.message + "\n\n"
  }
  if contains(explicit_tier3, "security") or contains(explicit_tier3, "безопасност") then {
    let sec = SecurityHardening(query)
    let tier3_result = tier3_result + sec.message + "\n\n"
  }
  if contains(explicit_tier3, "legacy") or contains(explicit_tier3, "модернизац") then {
    let leg = LegacySystemModernization(query)
    let tier3_result = tier3_result + leg.message + "\n\n"
  }

  // Step 9: Hard rules check
  let rules = CheckAllHardRules(task_id, estimate.estimate_json, tech_stack, "")

  // Step 10: Snapshot to Telegram Archive (hard rule 8)
  let snapshot = SnapshotToTelegramArchive(task_id, json_encode({task: task_id, type: task_type, estimate: estimate.estimate_json}), chat_id)

  // Step 11: Assemble final output
  let doc = "═══════════════════════════════════════\n"
  let doc = doc + "РАЗРАБОТКА — ЗАДАЧА " + task_id + "\n"
  let doc = doc + "═══════════════════════════════════════\n\n"

  // Disclaimer at top
  let doc = doc + DISCLAIMER_TOP() + "\n\n"

  // Task info
  let doc = doc + "── ЗАДАЧА ──\n"
  let doc = doc + "Тип: " + TaskTypeNameRU(task_type) + "\n"
  let doc = doc + "Описание: " + query + "\n"
  let doc = doc + "Status: " + STATUS_ARCHITECTING() + "\n\n"

  // Skills loaded
  let doc = doc + "── ЗАГРУЖЕНЫ SKILLS ──\n"
  let doc = doc + skills.message + "\n\n"

  // ADR (hard rule 1)
  let doc = doc + "── ARCHITECTURE DECISION (правило 1) ──\n"
  let doc = doc + adr_result + "\n\n"

  // Estimate (hard rule 2)
  let doc = doc + "── ОЦЕНКА (правило 2) ──\n"
  let doc = doc + estimate.message + "\n\n"

  // Tech Radar check (hard rule 3)
  let doc = doc + "── TECH RADAR CHECK (правило 3) ──\n"
  let radar_str = radar_gate.message
  if radar_gate.passed then { let radar_str = "✅ " + radar_gate.message }
  let doc = doc +radar_str + "\n\n"

  // Architecture (Tier 2)
  let doc = doc + "── АРХИТЕКТУРА ──\n"
  let doc = doc + tier2_result + "\n\n"

  // Iteration plan
  let doc = doc + "── ПЛАН ИТЕРАЦИЙ ──\n"
  let doc = doc + iterations.message + "\n\n"

  // Tier 3 (if any)
  if tier3_result != "" then {
    let doc = doc + "── TIER 3 (explicit) ──\n"
    let doc = doc + tier3_result + "\n\n"
  }

  // Hard rules summary
  let doc = doc + "── ЖЁСТКИЕ ПРАВИЛА ──\n"
  if rules.all_passed then {
    let doc = doc + "✅ Все " + to_string(rules.passed_count) + "/" + to_string(rules.total_count) + " проверенных правил соблюдены\n\n"
  } else {
    let doc = doc + "❌ Нарушения:\n" + rules.violations + "\n\n"
  }

  // Storage
  let doc = doc + "── TRIPLE STORAGE ──\n"
  let doc = doc + "GitHub: primary (source of truth)\n"
  let doc = doc + "Telegram Archive: " + snapshot + "\n"
  let doc = doc + "Local: deferred sync\n\n"

  // Disclaimer at bottom
  let doc = doc + DISCLAIMER_BOTTOM()

  // Update task status
  let _ = RecordAssistantMessage(chat_id, DEPT_NAME(), substring(doc, 0.0, 4000.0))
  let _ = AuditLog("dev_pipeline", DEPT_NAME(), "task=" + task_id + " type=" + task_type + " estimate=" + substring(to_string(estimate.expected_hours), 0.0, 6.0) + "h rules=" + to_string(rules.passed_count) + "/" + to_string(rules.total_count))

  return doc
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 19: COMMAND ROUTER
// ═══════════════════════════════════════════════════════════════════════

pattern RouteByCommand(parsed: Struct{
  command: String,
  task_type: String,
  task_description: String,
  task_id: String,
  repo_name: String,
  is_out_of_scope: Bool
}, chat_id: String) -> String {
  // Out-of-scope gate
  if parsed.is_out_of_scope then {
    return DeclineOutOfScope(parsed.task_description)
  }

  let cmd = parsed.command

  // /dev — Dashboard
  if cmd == "dev" then {
    return DevDashboard(chat_id)
  }

  // /dev-estimate — Create estimate
  if cmd == "dev-estimate" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-estimate <task_id> [confidence]" }
    let parts = split(parsed.task_description, " ")
    let confidence = "medium"
    if length(parts) > 2 then { confidence = to_string(get(parts, 2)) }
    let est = CreateEstimate(parsed.task_id, parsed.task_description, confidence)
    return est.message
  }

  // /dev-decide — Create ADR
  if cmd == "dev-decide" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-decide <task_id> <title>" }
    let parts = split(parsed.task_description, " ")
    let title = "ADR for " + parsed.task_id
    if length(parts) > 2 then { title = join(parts, " ", 2) }
    return CreateArchitectureDecision(parsed.task_id, title, parsed.task_description, "See context", "See alternatives", "See decision")
  }

  // /dev-implement — Implement iteration
  if cmd == "dev-implement" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-implement <task_id> [iteration_num]" }
    let parts = split(parsed.task_description, " ")
    let iter_num = 1
    if length(parts) > 2 then { iter_num = to_int(to_string(get(parts, 2))) }
    let result = ImplementIteration(parsed.task_id, iter_num, parsed.task_description)
    return result.message
  }

  // /dev-task — Show task
  if cmd == "dev-task" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-task <task_id>" }
    return ShowTask(parsed.task_id)
  }

  // /dev-tasks — List tasks
  if cmd == "dev-tasks" then {
    let parts = split(parsed.task_description, " ")
    let status_filter = ""
    if length(parts) > 1 then { status_filter = to_string(get(parts, 1)) }
    return ListTasks(status_filter, 20)
  }

  // /dev-repos — List repositories
  if cmd == "dev-repos" then {
    return ListRepos()
  }

  // /dev-repo — Show repository
  if cmd == "dev-repo" then {
    if parsed.repo_name == "" then { return "Укажите имя репозитория: /dev-repo <name>" }
    return ShowRepo(parsed.repo_name)
  }

  // /dev-create-repo — Create repository
  if cmd == "dev-create-repo" then {
    let parts = split(parsed.task_description, " ")
    if length(parts) < 3 then { return "Формат: /dev-create-repo <name> <task_type> [url]" }
    let name = to_string(get(parts, 1))
    let task_type = to_string(get(parts, 2))
    let url = "https://github.com/fosved/" + name
    if length(parts) > 3 then { url = to_string(get(parts, 3)) }
    return CreateRepo(name, task_type, url)
  }

  // /dev-radar — Show Tech Radar
  if cmd == "dev-radar" then {
    let parts = split(parsed.task_description, " ")
    let category = ""
    if length(parts) > 1 then { category = to_string(get(parts, 1)) }
    return ShowTechRadar(category)
  }

  // /dev-radar-add — Add Tech Radar entry
  if cmd == "dev-radar-add" then {
    let parts = split(parsed.task_description, " ")
    if length(parts) < 4 then { return "Формат: /dev-radar-add <name> <category> <adopt|trial|assess|hold> [description]" }
    let name = to_string(get(parts, 1))
    let category = to_string(get(parts, 2))
    let state = to_string(get(parts, 3))
    let desc = "Added via /dev-radar-add"
    if length(parts) > 4 then { desc = join(parts, " ", 4) }
    return AddTechRadarEntry(name, category, state, desc, "User decision")
  }

  // /dev-deploy — Deploy task
  if cmd == "dev-deploy" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-deploy <task_id>" }
    return DeployTask(parsed.task_id, chat_id)
  }

  // /dev-archive — Archive task
  if cmd == "dev-archive" then {
    if parsed.task_id == "" then { return "Укажите ID задачи: /dev-archive <task_id> <actual_hours>" }
    let parts = split(parsed.task_description, " ")
    let actual = "0"
    if length(parts) > 2 then { actual = to_string(get(parts, 2)) }
    return ArchiveTask(parsed.task_id, actual)
  }

  // /dev-local-sync — Local sync
  if cmd == "dev-local-sync" then {
    return LocalSync()
  }

  // Free-text: run full pipeline
  return FullPipeline(parsed.task_description, parsed.task_type, chat_id, "")
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 20: ENTRY POINT (HandleDev)
// This is the pattern that app.mlog calls via import dept/dev
// ═══════════════════════════════════════════════════════════════════════

pattern HandleDev(query: String, chat_id: String) -> String {
  let dept = DEPT_NAME()
  let _ = AuditLog("dept_entry", dept, "query: " + substring(query, 0, 100))

  // Parse query → task type + command
  let parsed = ParseDevQuery(query)

  // Route to command handler or full pipeline
  let result = RouteByCommand(parsed, chat_id)

  // Final safety: ensure disclaimer is present
  let has_disclaimer = contains(result, "Код генерируется проектным ассистентом") or contains(result, "проектного ассистента")
  let output = WrapWithDisclaimer(result)
  if has_disclaimer then { output = result }

  // ── LLM-Verifier: code/architecture quality ──
  let dv_resp = try call_python("llm_verifier", "score", json_encode([query, output, "Technical accuracy: Are code snippets/architecture patterns correct? Security awareness: Are common vulnerabilities (injection, auth, data exposure) addressed? Best practices: Does it follow established patterns for the stated tech stack?"]))
  if to_string(dv_resp) != "()" and contains(to_string(dv_resp), "error") == false then {
    let dv_parsed = try parse_json(dv_resp)
    let dv_score = to_float(try json_get(dv_parsed, "result", "0.5"))
    let _ = AuditLog("dev_verify_score", dept, "score=" + to_string(dv_score))
  }

  let _ = kv_set("last_model_" + dept, "native_call_llm")
  let _ = RecordAssistantMessage(chat_id, dept, substring(output, 0.0, 4000.0))

  return output
}
