  return { observability_spec: spec, message: "═══ Observability Setup ═══\n\n" + spec }
}

// ── 10k: Refactoring Discipline ────────────────────────────────────────
pattern RefactoringDiscipline(task_description: String) -> Dict {
  let prompt = "Разработай план рефакторинга.\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Strangler fig pattern: новый код рядом со старым, постепенно заменяет.\n"
  let prompt = prompt + "2. Incremental migration: каждый шаг — работающая система.\n"
  let prompt = prompt + "3. Parallel running: старый и новый одновременно, сверка результатов.\n"
  let prompt = prompt + "4. Deprecation path: warn → migrate → remove (3 версии).\n"
  let prompt = prompt + "5. Big-bang rewrite — ЗАПРЕЩЁН (всегда проваливается).\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n\n"
  let prompt = prompt + "Формат: JSON с полями refactoring_plan, steps (array), rollback_points."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)
  let spec = to_string(json_get(parsed, "refactoring_plan", llm_result))

  return { refactoring_plan: spec, message: "═══ Refactoring Plan ═══\n\n" + spec }
}

// ── 10l: Dependency Management ─────────────────────────────────────────
pattern DependencyManagement(task_description: String) -> Dict {
  let prompt = "Разработай стратегию управления зависимостями.\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Каждая зависимость — долгосрочная liability (bundle size, attack surface, maintenance).\n"
  let prompt = prompt + "2. Adopt deliberately: зачем нужна, чем хуже без неё, когда убрать.\n"
  let prompt = prompt + "3. Update systematically: Dependabot/Renovate, не ручные обновления.\n"
  let prompt = prompt + "4. Remove aggressively: unused deps → немедленное удаление.\n"
  let prompt = prompt + "5. Critical vulns: ЗАПРЕЩЕНЫ (жёсткое правило 9).\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n\n"
  let prompt = prompt + "Формат: JSON с полями deps_spec, adopt (array), update_strategy, removal_candidates."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)
  let spec = to_string(json_get(parsed, "deps_spec", llm_result))

  return { deps_spec: spec, message: "═══ Dependency Management ═══\n\n" + spec }
}

// ── 10m: Tier 2 dispatcher ─────────────────────────────────────────────
pattern DispatchTier2Skill(task_type: String, task_description: String) -> String {
  if task_type == TASK_TYPE_WEB_APP() then {
    let arch = NextjsArchitecture(task_description)
    let db = DatabaseDesign(task_description)
    let api = ApiDesign(task_description)
    return arch.message + "\n\n" + db.message + "\n\n" + api.message
  }
  if task_type == TASK_TYPE_SITE() then {
    let arch = NextjsArchitecture(task_description)
    return arch.message
  }
  if task_type == TASK_TYPE_AI_OFFICE() then {
    let agent = AgentArchitecture(task_description)
    let llm = LlmIntegration(task_description)
    let orchestration = MultiAgentOrchestration(task_description)
    return agent.message + "\n\n" + llm.message + "\n\n" + orchestration.message
  }
  if task_type == TASK_TYPE_LOCAL_AI() then {
    let local = LocalModelDeployment(task_description)
    let tuning = ModelFineTuning(task_description)
    return local.message + "\n\n" + tuning.message
  }
  if task_type == TASK_TYPE_INFRASTRUCTURE() then {
    let devops = DevopsDeployment(task_description)
    let obs = ObservabilitySetup(task_description)
    return devops.message + "\n\n" + obs.message
  }
  if task_type == TASK_TYPE_REFACTOR() then {
    let refact = RefactoringDiscipline(task_description)
    let deps = DependencyManagement(task_description)
    return refact.message + "\n\n" + deps.message
  }
  if task_type == TASK_TYPE_HOTFIX() then {
    let deps = DependencyManagement(task_description)
    return deps.message
  }
  // Default: Next.js + DB + API
  let arch = NextjsArchitecture(task_description)
  return arch.message
}

