// SECTION 16: CROSS-DEPARTMENT HOOKS (reference only)
// ═══════════════════════════════════════════════════════════════════════
//
// These hooks are referenced for documentation; actual cross-dept calls
// happen via app.mlog routing, not directly in this file.
//
// Hook 1: Design approved → auto-create Dev task
//   Trigger: design.mlog sets design_approval = "approved"
//   Action: db_execute INSERT INTO dev_tasks (source='design', ...)
//
// Hook 2: Dev implemented → auto-trigger QA test run
//   Trigger: dev_tasks.status transitions to 'testing'
//   Action: qa.mlog HandleQA("/qa-run " + task_id, ...)
//
// Hook 3: QA critical defect → auto-create Dev hotfix task
//   Trigger: qa_results.severity = "critical"
//   Action: db_execute INSERT INTO dev_tasks (task_type='hotfix', priority='critical')
//
// ═══════════════════════════════════════════════════════════════════════

