  let prompt = prompt + "4. Conflict resolution: если агенты дают противоречивые результаты.\n"
  let prompt = prompt + "5. Error containment: отказ одного агента не валит систему.\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n\n"
  let prompt = prompt + "Формат: JSON с полями orchestration_spec, agents (array), routing, error_strategy."

  let llm_result = call_llm(prompt)
  let parsed = parse_json(llm_result)
  let spec = to_string(json_get(parsed, "orchestration_spec", llm_result))

  return { orchestration_spec: spec, message: "═══ Multi-Agent Orchestration ═══\n\n" + spec }
}

