// ── 11a: Performance Optimization ──────────────────────────────────────
pattern PerformanceOptimization(task_description: String, current_metrics: String) -> Dict {
  let prompt = "Разработай план оптимизации производительности.\n\n"
  let prompt = prompt + "1. Измерь перед оптимизацией (no premature optimization).\n"
  let prompt = prompt + "2. Bottleneck identification: profiling → biggest win → fix.\n"
  let prompt = prompt + "3. Оптимизации: caching, lazy loading, code splitting, DB query optimization.\n"
  let prompt = prompt + "4. Каждая оптимизация — измеримый результат.\n\n"
  let prompt = prompt + "Задача: " + task_description + "\n"
  let prompt = prompt + "Текущие метрики: " + current_metrics + "\n\n"
  let prompt = prompt + "Формат: JSON с полями optimization_plan, steps (array), expected_improvement."

  let llm_result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  let parsed = parse_json(llm_result)
  let spec = redact(to_string(json_get(parsed, "optimization_plan", llm_result)), "all")

  return { optimization_plan: spec, message: "═══ Performance Optimization (Tier 3) ═══\n\n" + spec }
}

