// Fosved Office v2 — Mini App Report Builder (MEGA-3)
// Department colors, HTML report generation, Telegram inline dispatch
// Auto-archive integration, SendReport with archive support

// ── Gradient start colors ──────────────────────────────────────────
pattern DeptColorStart(dept: String) -> String {
  if dept == "yana" then { return "#293133" }
  if dept == "osp" then { return "#b91c1c" }
  if dept == "lz" then { return "#0e7490" }
  if dept == "expert" then { return "#312e81" }
  if dept == "marketing" then { return "#c2410c" }
  if dept == "finance" then { return "#166534" }
  if dept == "legal" then { return "#334155" }
  if dept == "dev" then { return "#1e40af" }
  if dept == "design" then { return "#9d174d" }
  if dept == "qa" then { return "#3f6212" }
  if dept == "visual" then { return "#6b21a8" }
  if dept == "engineering" then { return "#44403c" }
  if dept == "kavalnya" then { return "#92400e" }
  if dept == "admin" then { return "#1e3a5f" }
  return "#334155"
}

