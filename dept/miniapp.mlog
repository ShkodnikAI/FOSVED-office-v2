// ── Display names ──────────────────────────────────────────────────
pattern DeptName(dept: String) -> String {
  if dept == "yana" then { return "Yana" }
  if dept == "osp" then { return "ОСП · Стратегическое планирование" }
  if dept == "lz" then { return "ЛЗ · Лаборатория знаний" }
  if dept == "expert" then { return "Эксперт · Подготовка к встрече" }
  if dept == "marketing" then { return "Marketing" }
  if dept == "finance" then { return "Finance" }
  if dept == "legal" then { return "Legal" }
  if dept == "dev" then { return "Dev" }
  if dept == "design" then { return "Design" }
  if dept == "qa" then { return "QA" }
  if dept == "visual" then { return "Visual" }
  if dept == "engineering" then { return "Engineering" }
  if dept == "kavalnya" then { return "Kavalnya" }
  if dept == "admin" then { return "Admin" }
  return dept
}

// ── Badge formatting for report body (icons, not text labels) ───
pattern FormatReportBody(dept: String, text: String) -> String {
  // Primary badges — icons only (compact, no eye strain)
  let mut body = replace(text, "[ФАКТ]", "<span class=\"badge badge-fact\">✓</span>")
  let body = replace(body, "[ИНТЕРПРЕТАЦИЯ]", "<span class=\"badge badge-interp\">◈</span>")
  let body = replace(body, "[СПЕКУЛЯЦИЯ]", "<span class=\"badge badge-spec\">⚡</span>")
  // English fallback badges
  let body = replace(body, "[FACT]", "<span class=\"badge badge-fact\">✓</span>")
  let body = replace(body, "[INTERPRETATION]", "<span class=\"badge badge-interp\">◈</span>")
  let body = replace(body, "[SPECULATION]", "<span class=\"badge badge-spec\">⚡</span>")
  // Apodex verified/unverified/conflicting badges
  let body = replace(body, "[FACT verified]", "<span class=\"badge badge-verified\">✓ verified</span>")
  let body = replace(body, "[ФАКТ verified]", "<span class=\"badge badge-verified\">✓ verified</span>")
  let body = replace(body, "[ФАКТ ✓verified]", "<span class=\"badge badge-verified\">✓ verified</span>")
  let body = replace(body, "[FACT unverified]", "<span class=\"badge badge-unverified\">⚠ unverified</span>")
  let body = replace(body, "[ФАКТ unverified]", "<span class=\"badge badge-unverified\">⚠ unverified</span>")
  let body = replace(body, "[ФАКТ ⚠unverified]", "<span class=\"badge badge-unverified\">⚠ unverified</span>")
  let body = replace(body, "[CONFLICT]", "<span class=\"badge badge-conflicting\">⚠</span>")
  let body = replace(body, "[КОНФЛИКТ]", "<span class=\"badge badge-conflicting\">⚠</span>")
  return body
}

// ── Department-specific disclaimer ──────────────────────────────────
pattern DeptDisclaimer(dept: String) -> String {
  if dept == "finance" then { return "<div class=\"disclaimer\">Дисклеймер: Данный отчёт не является финансовой консультацией. Все расчёты носят информационный характер.</div>" }
  if dept == "legal" then { return "<div class=\"disclaimer\">Дисклеймер: Данный отчёт не является юридической консультацией. Для принятия юридических решений обратитесь к квалифицированному юристу.</div>" }
  if dept == "engineering" then { return "<div class=\"disclaimer\">Дисклеймер: Технические расчёты требуют review квалифицированного инженера перед применением.</div>" }
  return "<div class=\"report-disclaimer\">Generated by Fosved Office v2 — " + DeptName(dept) + " department.</div>"
}

// ── Full Mini App HTML report builder ──────────────────────────────
// YANA and ADMIN are NEVER stored in miniapp — hard guard
pattern BuildReport(dept: String, query: String, reply: String, chat_id: String) -> String {
  if dept == "yana" or dept == "admin" then {
    let _ = SendTelegramReplyMDV2(chat_id, reply)
    return reply
  }
  let doc_id = "doc-" + to_string(now())
  let css = try read_file("report_css.txt")
  if css == "()" then { let css = "" }
  let name = DeptName(dept)
  let start = DeptColorStart(dept)
  let end = DeptColorEnd(dept)
  let accent = DeptAccent(dept)
  let formatted = FormatReportBody(dept, reply)
  let confidence = "2.0"
  let date_str = to_string(now())

  let mut header = "<div class=\"report-header\" style=\"background:linear-gradient(135deg, " + start + ", " + end + ")\">"
  let header = header + "<h1>" + name + "</h1>"
  let header = header + "<div class=\"subtitle\">" + query + "</div></div>"

  let mut meta = "<div class=\"report-meta\"><span>ID: " + doc_id + "</span>"
  let meta = meta + "<span>" + date_str + "</span>"
  let meta = meta + "<span>Confidence: " + confidence + "/4</span></div>"

  let body_block = "<div class=\"report-body\">" + formatted + "</div>"

  let disclaimer = DeptDisclaimer(dept)

  let mut html = "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
  let html = html + "<style>" + css + "</style></head><body>"
  let html = html + "<div class=\"report-container\">" + header + meta + body_block + disclaimer + "</div>"
  let html = html + "</body></html>"

  let _ = try query("INSERT INTO miniapp_responses (id, dept, title, query, raw_text, html, confidence, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'))", [doc_id, dept, query, query, reply, html, confidence])

  let reply_len = length(reply)
  if reply_len > 800.0 then {
    let short = substring(reply, 0.0, 200.0) + "..."
    let _ = AuditLog("miniapp_dispatch", dept, "doc=" + doc_id + " chat=" + chat_id)
    let render_url = env("RENDER_URL")
    let miniapp_url = render_url + "/miniapp/" + doc_id
    let token = env("TELEGRAM_BOT_TOKEN")
    let body = json_encode({
      chat_id: to_float(chat_id),
      text: short,
      reply_markup: {
        inline_keyboard: [[{
          text: "Открыть отчёт",
          web_app: { url: miniapp_url }
        }]]
      }
    })
    let _ = http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json")
    return short
  }

  return reply
}

// ── Router: plain text vs Mini App + AUTO-ARCHIVE ──────────────────
// Yana NEVER goes through miniapp — she sends plain text + voice directly
pattern SendReport(reply: String, dept: String, query: String, confidence: String, chat_id: String) -> String {
  if dept == "yana" or dept == "admin" then {
    let _ = SendTelegramReplyMDV2(chat_id, reply)
    return reply
  }
  let reply_len = length(reply)
  if reply_len > 800.0 then {
    let doc_id = "doc-" + to_string(now())
    let css = try read_file("report_css.txt")
    if css == "()" then { let css = "" }
    let name = DeptName(dept)
    let start = DeptColorStart(dept)
    let end = DeptColorEnd(dept)
    let formatted = FormatReportBody(dept, reply)
    let date_str = to_string(now())

    let mut header = "<div class=\"report-header\" style=\"background:linear-gradient(135deg, " + start + ", " + end + ")\">"
    let header = header + "<h1>" + name + "</h1>"
    let header = header + "<div class=\"subtitle\">" + query + "</div></div>"

    let mut meta = "<div class=\"report-meta\"><span>ID: " + doc_id + "</span>"
    let meta = meta + "<span>" + date_str + "</span>"
    let meta = meta + "<span>Confidence: " + confidence + "/4</span>"
    let model_info = to_string(kv_get("last_model_" + dept))
    if model_info == "" then { let model_info = "не определена" }
    let tokens_info = to_string(kv_get("last_tokens_" + dept))
    if tokens_info == "" then { let tokens_info = "?" }
    let meta = meta + "<span>Модель: " + model_info + "</span>"
    let meta = meta + "<span>Токены: " + tokens_info + "</span></div>"

    let body_block = "<div class=\"report-body\">" + formatted + "</div>"
    let disclaimer = DeptDisclaimer(dept)

    let mut html = "<!DOCTYPE html><html><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
    let html = html + "<style>" + css + "</style></head><body>"
    let html = html + "<div class=\"report-container\">" + header + meta + body_block + disclaimer + "</div>"
    let html = html + "</body></html>"

    let _ = try query("INSERT INTO miniapp_responses (id, dept, title, query, raw_text, html, confidence, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'))", [doc_id, dept, query, query, reply, html, confidence])

    // Send report: Mini App button by default; .html file only when report_delivery=file
    let short = substring(reply, 0.0, 200.0) + "..."
    let dept_title = dept
    if dept == "osp" then { let dept_title = "ОСП · Стратегическое планирование" }
    if dept == "lz" then { let dept_title = "ЛЗ · Лаборатория знаний" }
    if dept == "expert" then { let dept_title = "Эксперт · Подготовка к встрече" }
    if dept == "finance" then { let dept_title = "Финансы" }
    if dept == "legal" then { let dept_title = "Юристы" }
    if dept == "marketing" then { let dept_title = "Маркетинг" }
    if dept == "dev" then { let dept_title = "Разработка" }
    if dept == "design" then { let dept_title = "Дизайн" }
    if dept == "qa" then { let dept_title = "Контроль качества" }
    if dept == "engineering" then { let dept_title = "Инженерия" }
    if dept == "visual" then { let dept_title = "Визуал" }
    if dept == "kavalnya" then { let dept_title = "Кавальня" }
    if dept == "admin" then { let dept_title = "Админ" }
    let short_with_dept = dept_title + "\n\n" + short
    let _ = AuditLog("miniapp_dispatch", dept, "doc=" + doc_id)
    let delivery = kv_get("report_delivery")
    if delivery != "file" then {
      let render_url = env("RENDER_URL")
      let miniapp_url = render_url + "/miniapp/" + doc_id
      let token = env("TELEGRAM_BOT_TOKEN")
      let body = json_encode({
        chat_id: to_float(chat_id),
        text: short_with_dept,
        reply_markup: {
          inline_keyboard: [[{
            text: "Открыть отчёт",
            web_app: { url: miniapp_url }
          }]]
        }
      })
      let _ = try http_post("https://api.telegram.org/bot" + token + "/sendMessage", body, "application/json")
    } else {
      let file_body = json_encode({doc_id: doc_id, chat_id: chat_id, caption: short_with_dept})
      let file_res = try http_post("http://127.0.0.1:4000/tg-send-report-file", file_body, "application/json")
      if to_string(file_res) == "()" then {
        let _ = SendTelegramReply(chat_id, short_with_dept)
      }
    }

    // AUTO-ARCHIVE: publish to archive channel if enabled
    let auto_archive = try kv_get("auto_archive")
    if to_string(auto_archive) == "true" then {
      let _ = PublishToArchive(doc_id, dept, query, reply)
    }

    return short
  }
  // Short reply: just send as text
  let _ = SendTelegramReply(chat_id, reply)
  return reply
}

// ── Handle Mini App action callback ────────────────────────────────
pattern HandleMiniAppAction(payload: String, chat_id: String) -> String {
  let action = json_get(parse_json(payload), "action", "")
  let doc_id = json_get(parse_json(payload), "doc_id", "")

  if action == "archive" then {
    if doc_id != "" then {
      let rows = query("SELECT dept, title, raw_text FROM miniapp_responses WHERE id = ?", [doc_id])
      let dept = json_get(parse_json(to_string(rows)), "[0].dept", "")
      let title = json_get(parse_json(to_string(rows)), "[0].title", "")
      let content = json_get(parse_json(to_string(rows)), "[0].raw_text", "")
      if dept != "" then {
        let _ = PublishToArchive(doc_id, dept, title, content)
        send_message(chat_id, "Published to archive: " + title)
      }
    }
    return "ok"
  }

  if action == "note" then {
    let note_text = json_get(parse_json(payload), "text", "")
    if note_text != "" and doc_id != "" then {
      let _ = try query("INSERT INTO miniapp_notes (doc_id, note_text, created_at) VALUES (?, ?, datetime('now'))", [doc_id, note_text])
      send_message(chat_id, "Note added.")
    }
    return "ok"
  }

  if action == "watch" then {
    let freq = json_get(parse_json(payload), "freq", "daily")
    let topic = json_get(parse_json(payload), "topic", "")
    if doc_id != "" and topic != "" then {
      kv_set("control_" + doc_id, freq + "|" + topic)
      send_message(chat_id, "On control: " + topic + " (" + freq + ")")
    }
    return "ok"
  }

  if action == "journalist" then {
    if doc_id != "" then {
      let rows = query("SELECT title, raw_text FROM miniapp_responses WHERE id = ?", [doc_id])
      let title = json_get(parse_json(to_string(rows)), "[0].title", "")
      let raw = json_get(parse_json(to_string(rows)), "[0].raw_text", "")
      let ctx = BuildContext("osp", to_string(title), chat_id)
      let jprompt = "Ты — журналист-аналитик. Перепиши отчёт в журналистскую статью: без служебных реквизитов (ID, confidence, методология), без бейджей [ФАКТ]/[ИНТЕРПРЕТАЦИЯ]/[СПЕКУЛЯЦИЯ], живой язык, лид-абзац, структура лид→контекст→основа→вывод, 1000-1500 слов."
      let _pr = call_llm(ctx + "\n\n" + jprompt, raw)
      if to_string(_pr) == "()" then { return "Сервис временно недоступен." }
      let reply = to_string(_pr)
      let _ = SendReport(reply, "osp", "Статья: " + to_string(title), "2.0", chat_id)
    }
    return "ok"
  }

  if starts_with(action, "deepen_to_") then {
    if doc_id != "" then {
      let level = substring(action, 10.0, length(action))
      let rows = query("SELECT title, raw_text FROM miniapp_responses WHERE id = ?", [doc_id])
      let title = json_get(parse_json(to_string(rows)), "[0].title", "")
      let raw = json_get(parse_json(to_string(rows)), "[0].raw_text", "")
      let instr = "Стандартный анализ. 5-7 слоёв. ACH 3 гипотезы."
      if level == "1" then { let instr = "Быстрая оценка. 2-3 слоя. Кратко." }
      if level == "3" then { let instr = "Глубокое препарирование. 8-10 слоёв. ACH 5 гипотез. Premortem. Кантильон." }
      if level == "4" then { let instr = "Полное + Red Team. 12+ слоёв. ACH, premortem, кантильон. После анализа — сам себе Red Team: слепые пятна и контраргументы." }
      let ctx = BuildContext("osp", to_string(title), chat_id)
      let _pr = call_llm(ctx + "\n\n" + instr, "Углуби предыдущий анализ:\n" + raw)
      if to_string(_pr) == "()" then { return "Сервис временно недоступен." }
      let reply = to_string(_pr)
      let _ = SendReport(reply, "osp", to_string(title) + " (depth " + level + ")", level, chat_id)
    }
    return "ok"
  }

  if starts_with(action, "control_") then {
    if doc_id != "" then {
      let freq = substring(action, 8.0, length(action))
      let rows = query("SELECT title FROM miniapp_responses WHERE id = ?", [doc_id])
      let title = json_get(parse_json(to_string(rows)), "[0].title", "")
      kv_set("control_" + doc_id, freq + "|" + to_string(title))
      send_message(chat_id, "На контроле (" + freq + "): " + to_string(title))
    }
    return "ok"
  }

  if action == "counter_forecast" then {
    if doc_id != "" then {
      let rows = query("SELECT title, raw_text FROM miniapp_responses WHERE id = ?", [doc_id])
      let title = json_get(parse_json(to_string(rows)), "[0].title", "")
      let raw = json_get(parse_json(to_string(rows)), "[0].raw_text", "")
      let cprompt = "Ты — контр-аналитик. Построй максимально противоположный прогноз: найди слабые места исходного, альтернативный сценарий, те же факты с противоположной интерпретацией, оцени вероятность контр-сценария, индикаторы его реализации. Формат: ACH, минимум 3 контр-гипотезы."
      let ctx = BuildContext("osp", to_string(title), chat_id)
      let _pr = call_llm(ctx + "\n\n" + cprompt, raw)
      if to_string(_pr) == "()" then { return "Сервис временно недоступен." }
      let reply = to_string(_pr)
      let _ = SendReport(reply, "osp", "Контр-прогноз: " + to_string(title), "3.0", chat_id)
    }
    return "ok"
  }

  return "ok"
}
