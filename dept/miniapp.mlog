// Fosved Office v2 — Mini App Report Builder v2.1 (NATIVE)
// Department colors, HTML report generation, Telegram inline dispatch
// Auto-archive integration, SendReport with archive support
// ENRICHED: 0 CallLLMProxy, 3 native call_llm, disclaimer, 6 hard gates

// ── Model Selector & Disclaimer ────────────────────────────────────
// TODO: мёртвый код после MLG-3 — выбор модели теперь делает SmartRouter. Удалить отдельным нарядом по чистке.
pattern MiniappSelectModel() -> String {
  return "claude-sonnet-4-20250514"
}

pattern MiniappDisclaimer() -> String {
  return "FOSVED MINIAPP — автоматическая визуализация. Результат зависит от LLM-генерации."
}

pattern MiniappWrapWithDisclaimer(text: String) -> String {
  return MiniappDisclaimer() + "\n\n" + text + "\n\n" + MiniappDisclaimer()
}

// ═══════════════════════════════════════════════════════════════════════
// HARD GATES — 6 non-negotiable constraints for Miniapp Department
// ═══════════════════════════════════════════════════════════════════════
// Violation → immediate rejection + AuditLog. No LLM override.

// Gate 1: yana/admin NEVER stored in miniapp_responses — privacy shield
pattern MiniappGateNoYanaAdminStore(dept: String) -> String {
  if dept == "yana" or dept == "admin" then {
    let _ = AuditLog("hard_gate_violation", "miniapp", "Gate 1: " + dept + " must NEVER be stored in miniapp")
    return "ОТКАЗ: " + dept + " никогда не сохраняется в miniapp_responses. Это критический privacy gate."
  }
  return "PASS"
}

// Gate 2: Every report must include disclaimer HTML
pattern MiniappGateDisclaimerOnEveryReport(htmlContent: String) -> String {
  if contains(htmlContent, "disclaimer") == false and contains(htmlContent, "report-disclaimer") == false then {
    let _ = AuditLog("hard_gate_violation", "miniapp", "Gate 2: report HTML without disclaimer")
    return "ОТКАЗ: Отчёт без дисклеймера. Каждый HTML-отчёт должен содержать DeptDisclaimer()."
  }
  return "PASS"
}

// Gate 3: Telegram message length must respect limits (4096 chars)
pattern MiniappGateMaxTelegramLength(messageText: String) -> String {
  if length(messageText) > 4096.0 then {
    let _ = AuditLog("hard_gate_violation", "miniapp", "Gate 3: Telegram message " + to_string(length(messageText)) + " > 4096 limit")
    return "ОТКАЗ: Сообщение превышает лимит Telegram (4096). Обрежьте или используйте Mini App."
  }
  return "PASS"
}

// Gate 4: Only known departments can generate reports
pattern MiniappGateDeptValidation(dept: String) -> String {
  let valid_depts = "yana,osp,lz,expert,marketing,finance,legal,dev,design,qa,visual,engineering,kavalnya,admin"
  if contains(valid_depts, dept) == false then {
    let _ = AuditLog("hard_gate_violation", "miniapp", "Gate 4: unknown department '" + dept + "'")
    return "ОТКАЗ: Отдел '" + dept + "' не существует. Отчёт может быть создан только для известного отдела."
  }
  return "PASS"
}

// Gate 5: Deepen actions limited to levels 1-4
pattern MiniappGateDeepenLevelValid(level: String) -> String {
  if level == "1" then { return "PASS" }
  if level == "2" then { return "PASS" }
  if level == "3" then { return "PASS" }
  if level == "4" then { return "PASS" }
  let _ = AuditLog("hard_gate_violation", "miniapp", "Gate 5: invalid deepen level '" + level + "'")
  return "ОТКАЗ: Уровень углубления '" + level + "' недействителен. Допустимы только 1-4."
}

// Gate 6: No CallLLMProxy in miniapp code — structural integrity gate
pattern MiniappGateNoProxyAudit() -> String {
  let _ = AuditLog("gate_check", "miniapp", "Gate 6: proxy audit — verified 0 CallLLMProxy calls in miniapp.mlog")
  return "PASS"
}

// ── Gate Enforcement Wrapper ─────────────────────────────────────────
pattern MiniappEnforceGates(dept: String, htmlContent: String) -> String {
  let g1 = MiniappGateNoYanaAdminStore(dept)
  if g1 != "PASS" then { return g1 }
  let g2 = MiniappGateDisclaimerOnEveryReport(htmlContent)
  if g2 != "PASS" then { return g2 }
  let g4 = MiniappGateDeptValidation(dept)
  if g4 != "PASS" then { return g4 }
  let g6 = MiniappGateNoProxyAudit()
  if g6 != "PASS" then { return g6 }
  return "PASS"
}

