// ═══════════════════════════════════════════════════════════════════════
// Fosved Office v2 — Marketing Department (NATIVE v1.0)
// ═══════════════════════════════════════════════════════════════════════
// Replaces Python proxy stub with native Metalogos marketing engine.
// 11 skills (4 Tier1 + 5 Tier2 + 2 Tier3), 9 hard rules, campaign lifecycle,
// forecast→verification learning loop, honest claims enforcement.
// 0 CallLLMProxy calls, 0 Python dependencies.
//
// Psychotype: Эмпат + Экспериментатор
// Metric: campaign-accuracy (conversion ±25%, CAC ±30%)
// Work modes: internal (Fosved) + external (clients)
//
// Architecture:
//   HandleMarketing(query, chat_id)
//     → MarketingClassifyIntent(query)     ← NLP + command detection
//     → RouteByCommand(cmd, ...)            ← 8 bot commands + free-text dispatch
//       → cmd=research   → MarketingResearch
//       → cmd=segment    → MarketingSegment
//       → cmd=competitors→ MarketingCompetitors
//       → cmd=campaign   → MarketingCampaign
//       → cmd=forecast   → MarketingCampaignForecast  ← hard rule 1
//       → cmd=verify     → MarketingCampaignVerify     ← hard rule 1+2+9
//       → cmd=score      → MarketingScore
//       → cmd=archive    → MarketingArchiveSearch
//       → free-text      → FullPipeline
//     → FullPipeline:
//       → DetectOperation                  ← research|segment|campaign|competitors
//       → EnforceHardGates                 ← 9 programmatic gates
//       → ExecuteOperation                 ← with LLM + skills
//       → WrapWithDisclaimer               ← hard rule 7

// ═══════════════════════════════════════════════════════════════════════
// PROJECT PARAMETERS V1.0 — Token budgets, Models, Hard gates
// ═══════════════════════════════════════════════════════════════════════

// ── Depth → Model mapping ──
// depth 0: claude-3-5-haiku (fast — listing, simple queries)
// depth 1: claude-sonnet-4-20250514 (balanced — research, segmentation, forecasting)
// depth 2: claude-sonnet-4-20250514 (high reasoning — competitive analysis, positioning)
// depth 3: claude-opus-4-20250514 (deep — launch orchestration, quarterly review)
pattern MarketingSelectModel(depth: Int) -> String {
  if depth == 0.0 then { return "claude-3-5-haiku" }
  if depth == 1.0 then { return "claude-sonnet-4-20250514" }
  if depth == 2.0 then { return "claude-sonnet-4-20250514" }
  if depth == 3.0 then { return "claude-opus-4-20250514" }
  return "claude-sonnet-4-20250514"
}

// ── Per-operation token budgets ──
// [Context, Analysis, Output] per depth level
pattern MarketingOpBudget(depth: Int) -> String {
  if depth == 0.0 then { return "2000,500,500" }        // total ~3000
  if depth == 1.0 then { return "4000,2000,1000" }       // total ~7000
  if depth == 2.0 then { return "6000,4000,1500" }       // total ~11500
  if depth == 3.0 then { return "8000,6000,2000" }       // total ~16000
  return "4000,2000,1000"
}

// ── Skill loading budget per depth ──
pattern MarketingSkillBudget(depth: Int) -> Float {
  if depth == 0.0 then { return 6000.0 }
  if depth == 1.0 then { return 12000.0 }
  if depth == 2.0 then { return 16000.0 }
  if depth == 3.0 then { return 20000.0 }
  return 12000.0
}

// ═══════════════════════════════════════════════════════════════════════
// HARD RULE GATES — programmatic, not prompt-based
// These gates BLOCK execution if violated. No LLM can override them.
// ═══════════════════════════════════════════════════════════════════════

// Gate 1: No campaign launch without numeric forecast (3 required fields)
pattern GateCampaignForecast(forecast_conversion: String, forecast_cac: String, forecast_reach: String) -> String {
  if forecast_conversion == "" or forecast_conversion == "null" then { return "FAIL: hard rule 1 — forecast conversion rate is required before launch. A campaign without forecast is a guess, not work." }
  if forecast_cac == "" or forecast_cac == "null" then { return "FAIL: hard rule 1 — forecast CAC is required before launch." }
  if forecast_reach == "" or forecast_reach == "null" then { return "FAIL: hard rule 1 — forecast reach is required before launch." }
  return "PASS"
}

// Gate 2: No unverifiable advertising claims
pattern GateClaimsVerified(claims_verified: String) -> String {
  if claims_verified == "true" then { return "PASS" }
  return "FAIL: hard rule 2 — all advertising claims must be verified before launch. Run /campaign-verify-claims first."
}

// Gate 3: No abstract audience — concrete 4-field segments
pattern GateConcreteSegment(name: String, pain_point: String, where_to_reach: String, current_alternative: String) -> String {
  if len(name) < 3 then { return "FAIL: hard rule 3 — segment name must be concrete (≥3 chars). 'Everyone' is not a segment." }
  if len(pain_point) < 3 then { return "FAIL: hard rule 3 — pain point must be specific. Without pain, there is no segment." }
  if len(where_to_reach) < 3 then { return "FAIL: hard rule 3 — where-to-reach must be concrete. 'Everywhere' is nowhere." }
  if len(current_alternative) < 3 then { return "FAIL: hard rule 3 — current alternative must be named. People without alternatives don't need marketing." }
  return "PASS"
}

// Gate 4: No blind copying of competitors
pattern GateNoBlindCopy(query: String) -> String {
  let t = lower(query)
  if contains(t, "скопируй кампани") or contains(t, "повтори за конкурен") or contains(t, "copy competitor") then {
    return "FAIL: hard rule 4 — blind copying of competitor campaigns is forbidden. What works for them may not work for us (different segment, positioning, timing)."
  }
  return "PASS"
}

// Gate 5: No vanity metrics
pattern GateNoVanityMetrics(query: String) -> String {
  let t = lower(query)
  if contains(t, "сколько лайков") or contains(t, "охват без конверси") or contains(t, "impressions only") then {
    return "FAIL: hard rule 5 — vanity metrics (likes, impressions without conversion) are not results. Marketing measures: conversion, CAC, revenue."
  }
  return "PASS"
}

// Gate 6: No manipulative targeting of vulnerable groups
pattern GateNoManipulation(query: String) -> String {
  let t = lower(query)
  if contains(t, "уязвим") and contains(t, "таргет") then { return "FAIL: hard rule 6 — targeting vulnerable groups is forbidden." }
  if contains(t, "дет") and contains(t, "реклам") then { return "FAIL: hard rule 6 — advertising targeting children is forbidden." }
  if contains(t, "добавк") and contains(t, "зависим") then { return "FAIL: hard rule 6 — exploiting addiction is forbidden." }
  return "PASS"
}

// Gate 7: Everything archived (enforced by db_execute in each operation)

// Gate 8: No research without source + reliability tags
pattern GateResearchHasSources(data_sources: String) -> String {
  if data_sources == "[]" or data_sources == "" or data_sources == "null" then {
    return "FAIL: hard rule 8 — research without data sources is an opinion, not research. Name every source and tag its reliability."
  }
  return "PASS"
}

// Gate 9: No ignoring failed campaigns
pattern GateFailedCampaignsExist() -> String {
  let failed = query("SELECT COUNT(*) as n FROM campaign_verifications WHERE was_overoptimistic = 1 AND miss_source != 'external_factor' AND verified_at >= datetime('now', '-90 days')", [])
  if len(failed) > 0.0 then {
    let count = get(get(failed, 0.0), "n")
    if count >= 3.0 then {
      return "WARN: hard rule 9 — " + to_string(count) + " failed campaigns in 90 days. Repeated failure = unlearned lesson. Run /marketing-score and review miss sources before launching new campaigns."
    }
  }
  return "PASS"
}

// ═══════════════════════════════════════════════════════════════════════
// DISCLAIMER ENFORCEMENT
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingDisclaimerTop() -> String {
  return "⚠️ MARKETING DISCLAIMER: This is a marketing analysis and forecast, NOT a guarantee of results. Actual performance depends on execution quality, market conditions, and factors beyond analysis scope. All forecasts have verification dates."
}

pattern MarketingDisclaimerBottom(work_mode: String) -> String {
  let base = "\n---\n⚠️ Marketing analysis by Fosved. Forecasts are hypotheses to be verified, not promises. Work mode: " + work_mode + "."
  let base = base + "\nEvery forecast has a verification date. Every campaign gets checked against reality."
  let base = base + "\nThis is NOT investment advice. For financial decisions, consult Finance department."
  return base
}

pattern MarketingFinalSafetyCheck(reply: String) -> String {
  let r = lower(reply)
  let safe = "true"
  if contains(r, "гарантир") then { let safe = "false" }
  if contains(r, "100% конверси") then { let safe = "false" }
  if contains(r, "обязательно сработа") then { let safe = "false" }
  if contains(r, "лучший на рынке") then { let safe = "false" }
  if contains(r, "number one") then { let safe = "false" }
  if contains(r, "guaranteed") then { let safe = "false" }
  if safe == "false" then {
    return reply + "\n\n🚨 SAFETY: Output contained forbidden pattern (guarantee/superlative). Marketing makes forecasts, not guarantees. Verify manually."
  }
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// INTENT CLASSIFIER — determines marketing sub-operation
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingClassifyIntent(query: String) -> String {
  let t = lower(query)
  // Market research
  if contains(t, "research") or contains(t, "исследован") or contains(t, "рынок") or contains(t, "market siz") or contains(t, "размер рынка") or contains(t, "анализ рынка") then { return "research" }
  // Audience segmentation
  if contains(t, "сегмент") or contains(t, "segment") or contains(t, "аудитори") or contains(t, "целевая групп") or contains(t, "для кого") or contains(t, "кто клиент") then { return "segment" }
  // Competitive analysis
  if contains(t, "конкурент") or contains(t, "competitor") or contains(t, "аналог") or contains(t, "альтернатив") then { return "competitors" }
  // Campaign management
  if contains(t, "кампани") or contains(t, "campaign") or contains(t, "запуск") or contains(t, "launch") or contains(t, "продвижен") or contains(t, "продвинуть") then { return "campaign" }
  // Forecast
  if contains(t, "прогноз кампан") or contains(t, "forecast") or contains(t, "cac") or contains(t, "конверси") then { return "forecast" }
  // Verification
  if contains(t, "верификац") or contains(t, "verify") or contains(t, "сверить") or contains(t, "факт vs прогноз") then { return "verify" }
  // A/B testing
  if contains(t, "a/b") or contains(t, "ab test") or contains(t, "сплит тест") then { return "ab_test" }
  // Archive
  if contains(t, "архив") or contains(t, "archive") or contains(t, "история кампан") then { return "archive" }
  // Score
  if contains(t, "метрик") or contains(t, "score") or contains(t, "точность прогноз") or contains(t, "marketing-score") then { return "score" }
  return "general"
}

// Work mode extractor
pattern MarketingExtractWorkMode(query: String) -> String {
  let t = lower(query)
  if contains(t, "клиент") or contains(t, "client") or contains(t, "external") or contains(t, "внешн") then { return "external" }
  return "internal"
}

// ═══════════════════════════════════════════════════════════════════════
// API ENDPOINTS — REST routes for external access
// ═══════════════════════════════════════════════════════════════════════

// GET /marketing/campaigns?status=launched&limit=20
pattern MarketingCampaignsAPI(status: String, limit: Int) -> String {
  let q = "SELECT id, title, campaign_type, product_promoted, status, forecast_conversion_rate, forecast_cac, actual_conversion_rate, actual_cac FROM marketing_campaigns WHERE 1=1"
  if status != "" then { let q = q + " AND status = '" + status + "'" }
  let q = q + " ORDER BY created_at DESC LIMIT " + to_string(limit)
  let rows = query(q, [])
  return json_encode(rows)
}

// GET /marketing/segments?status=validated&limit=20
pattern MarketingSegmentsAPI(status: String, limit: Int) -> String {
  let q = "SELECT id, name, pain_point, where_to_reach, current_alternative, estimated_size, status FROM audience_segments WHERE 1=1"
  if status != "" then { let q = q + " AND status = '" + status + "'" }
  let q = q + " ORDER BY created_at DESC LIMIT " + to_string(limit)
  let rows = query(q, [])
  return json_encode(rows)
}

// GET /marketing/research?status=published&limit=10
pattern MarketingResearchAPI(status: String, limit: Int) -> String {
  let q = "SELECT id, title, research_type, overall_confidence, status, verification_date FROM market_research WHERE 1=1"
  if status != "" then { let q = q + " AND status = '" + status + "'" }
  let q = q + " ORDER BY created_at DESC LIMIT " + to_string(limit)
  let rows = query(q, [])
  return json_encode(rows)
}

// GET /marketing/metrics — campaign accuracy snapshot
pattern MarketingMetricsAPI() -> String {
  let rows = query("SELECT AVG(v.conversion_accuracy) as avg_conv, AVG(v.cac_accuracy) as avg_cac, COUNT(*) as n FROM campaign_verifications v WHERE v.verified_at >= datetime('now', '-90 days')", [])
  if len(rows) > 0.0 then {
    let avg_conv = get(get(rows, 0.0), "avg_conv")
    let avg_cac = get(get(rows, 0.0), "avg_cac")
    let n = get(get(rows, 0.0), "n")
    return json_encode({metric: "campaign-accuracy", avg_conversion_accuracy: avg_conv, avg_cac_accuracy: avg_cac, sample_size: n, period: "last_90_days"})
  }
  return json_encode({metric: "campaign-accuracy", value: null, sample_size: 0, period: "last_90_days", note: "no verified campaigns"})
}

// ═══════════════════════════════════════════════════════════════════════
// MAIN DISPATCHER — routes sub-commands within Marketing
// ═══════════════════════════════════════════════════════════════════════

pattern HandleMarketing(query: String, chat_id: String) -> String {
  let dept = "marketing"
  let t = lower(query)

  // ── Sub-command routing (specific first, general last) ──
  if starts_with(t, "/market-research") then {
    let q = substring(query, 15.0, 300.0)
    return MarketingResearch(q, chat_id)
  }
  if starts_with(t, "/segment") then {
    let q = substring(query, 8.0, 300.0)
    return MarketingSegment(q, chat_id)
  }
  if starts_with(t, "/competitors") then {
    let q = substring(query, 11.0, 300.0)
    return MarketingCompetitors(q, chat_id)
  }
  if starts_with(t, "/campaign-forecast") then {
    let q = substring(query, 18.0, 300.0)
    return MarketingCampaignForecast(q, chat_id)
  }
  if starts_with(t, "/campaign-verify") then {
    let q = substring(query, 15.0, 300.0)
    return MarketingCampaignVerify(q, chat_id)
  }
  if starts_with(t, "/campaign") then {
    let q = substring(query, 9.0, 300.0)
    return MarketingCampaignHandler(q, chat_id)
  }
  if starts_with(t, "/marketing-score") then {
    return MarketingScore(chat_id)
  }
  if starts_with(t, "/marketing-archive") then {
    let q = substring(query, 17.0, 300.0)
    return MarketingArchiveSearch(q, chat_id)
  }

  // ── Help text ──
  if t == "/marketing" or t == "/marketing " then {
    return MarketingHelpText()
  }

  // ── Intent classification + enriched routing ──
  let intent = MarketingClassifyIntent(query)
  let work_mode = MarketingExtractWorkMode(query)

  // Run hard gates
  let g4 = GateNoBlindCopy(query)
  if g4 != "PASS" then { return "🚫 " + g4 }
  let g5 = GateNoVanityMetrics(query)
  if g5 != "PASS" then { return "🚫 " + g5 }
  let g6 = GateNoManipulation(query)
  if g6 != "PASS" then { return "🚫 " + g6 }
  let g9 = GateFailedCampaignsExist()
  if starts_with(g9, "WARN") then {
    // Warning, not block — proceed but note
    let _ = AuditLog("marketing_gate9_warn", "marketing", g9)
  }

  // Route by intent
  if intent == "research" then { return MarketingResearch(query, chat_id) }
  if intent == "segment" then { return MarketingSegment(query, chat_id) }
  if intent == "competitors" then { return MarketingCompetitors(query, chat_id) }
  if intent == "campaign" then { return MarketingCampaignHandler(query, chat_id) }
  if intent == "forecast" then { return MarketingCampaignForecast(query, chat_id) }
  if intent == "verify" then { return MarketingCampaignVerify(query, chat_id) }
  if intent == "archive" then { return MarketingArchiveSearch(query, chat_id) }
  if intent == "score" then { return MarketingScore(chat_id) }

  // ── General free-text query (depth 1, LLM-routed) ──
  let context = BuildMarketingContext(query, work_mode, chat_id)
  let disclaimer_top = MarketingDisclaimerTop()
  let prompt = disclaimer_top + "\n\n" + context + "\n\n=== ЗАПРОС ===\n" + query + "\n\nПравила ответа:\n1. Работа mode: " + work_mode + "\n2. Каждое утверждение о рынке должно иметь источник и оценку надёжности\n3. Прогнозы — range, не point estimate\n4. Никаких гарантий результата — только гипотезы с verification date\n5. Если просят 'куда вложить' — это не Marketing, это OSP\n6. Аудитория всегда конкретная: имя сегмента, боль, канал, альтернатива\n7. Не используй superlatives: 'лучший', 'number one', 'гарантированно'"
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: query}])
  let model = MarketingSelectModel(1)
  let llm_result = call_llm(model, messages)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)
  let disclaimer_bottom = MarketingDisclaimerBottom(work_mode)
  let reply = reply + "\n\n" + disclaimer_bottom
  let reply = MarketingFinalSafetyCheck(reply)
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  let _ = AuditLog("dept_query", dept, "intent=" + intent + " mode=" + work_mode + " model=" + model + " query: " + substring(query, 0, 100))
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// HELP TEXT
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingHelpText() -> String {
  let h = "📢 *Marketing Department*\n\n"
  let h = h + "Базовый принцип: каждая кампания — проверяемая гипотеза. Прогноз → запуск → верификация → обучение.\n\n"
  let h = h + "Команды:\n"
  let h = h + "/market-research <topic> — исследование рынка\n"
  let h = h + "/segment <product> — сегментация аудитории\n"
  let h = h + "/competitors <domain> — конкурентный анализ\n"
  let h = h + "/campaign <action> — управление кампанией\n"
  let h = h + "/campaign-forecast <id> — прогноз кампании (3 поля!)\n"
  let h = h + "/campaign-verify <id> — верификация кампании\n"
  let h = h + "/marketing-score — метрики точности прогнозов\n"
  let h = h + "/marketing-archive — архив кампаний\n\n"
  let h = h + "Или просто /marketing <запрос> — определит intent автоматически.\n\n"
  let h = h + "⚠️ Hard rules: нет кампании без прогноза, нет утверждений без верификации, нет абстрактной аудитории."
  return h
}

// ═══════════════════════════════════════════════════════════════════════
// CONTEXT BUILDER — enriched with profile + skills + research data + corrections
// ═══════════════════════════════════════════════════════════════════════

pattern BuildMarketingContext(query: String, work_mode: String, chat_id: String) -> String {
  let profile = ReadDeptProfile("marketing")
  let skills = LoadMarketingSkills(query, 1)
  let corrections = GetCorrections("marketing")
  let dialog = GetRecentDialog(chat_id, "10")
  let memories = YanaRecallMemories(query)
  let now_info = YanaNowInfo()

  // Recent segments for context
  let segments = query("SELECT id, name, pain_point, status FROM audience_segments ORDER BY created_at DESC LIMIT 5", [])
  // Recent campaigns for context
  let campaigns = query("SELECT id, title, campaign_type, status, forecast_conversion_rate, forecast_cac FROM marketing_campaigns ORDER BY created_at DESC LIMIT 5", [])

  let s_memories = to_string(memories)
  if s_memories == "()" then { let s_memories = "" }
  let s_corrections = to_string(corrections)
  if s_corrections == "()" then { let s_corrections = "" }
  let s_dialog = to_string(dialog)
  if s_dialog == "()" then { let s_dialog = "" }
  let s_now = to_string(now_info)
  if s_now == "()" then { let s_now = "" }
  let s_skills = to_string(skills)
  if s_skills == "()" then { let s_skills = "" }

  let context = profile + "\n\n=== Текущая дата и время ===\n" + s_now
  let context = context + "\n\n=== Work Mode ===\n" + work_mode
  let context = context + "\n\n=== Active Segments ===\n" + json_encode(segments)
  let context = context + "\n\n=== Recent Campaigns ===\n" + json_encode(campaigns)
  let context = context + "\n\n=== Active Skills ===\n" + s_skills
  let context = context + "\n\n=== Corrections ===\n" + s_corrections
  let context = context + "\n\n=== Long-term Memory ===\n" + s_memories
  let context = context + "\n\n=== Recent Dialog ===\n" + s_dialog

  let context = context + "\n\n=== ПОВТОР: ТЕКУЩАЯ ДАТА ===\n" + s_now + "\nВНИМАНИЕ: Все verification dates рассчитываются от этой даты. Не давай гарантий — только прогнозы с датой верификации."

  return context
}

// ═══════════════════════════════════════════════════════════════════════
// ENRICHED SKILL LOADING — 3-tier
// ═══════════════════════════════════════════════════════════════════════

pattern LoadMarketingSkills(query: String, depth: Int) -> String {
  let t = lower(query)
  let result = ""
  let budget = MarketingSkillBudget(depth)

  // ── Tier 1: Methodological core (always loaded) ──
  let s = read_file("skills/fosved/marketing/audience-segmentation/SKILL.md")
  if s != "" and len(result) < budget then { let result = result + "\n--- audience-segmentation ---\n" + s }
  let s = read_file("skills/fosved/marketing/forecast-before-launch/SKILL.md")
  if s != "" and len(result) < budget then { let result = result + "\n--- forecast-before-launch ---\n" + s }
  let s = read_file("skills/fosved/marketing/campaign-verification/SKILL.md")
  if s != "" and len(result) < budget then { let result = result + "\n--- campaign-verification ---\n" + s }
  let s = read_file("skills/fosved/marketing/honest-claims-discipline/SKILL.md")
  if s != "" and len(result) < budget then { let result = result + "\n--- honest-claims-discipline ---\n" + s }

  // ── Tier 2: Domain depth (by operation type) ──
  // Market research
  if (contains(t, "исследован") or contains(t, "research") or contains(t, "рынок") or contains(t, "размер рынка")) and len(result) < budget then {
    let s = read_file("skills/fosved/marketing/market-research-methods/SKILL.md")
    if s != "" then { let result = result + "\n--- market-research-methods ---\n" + s }
  }
  // Competitive analysis
  if (contains(t, "конкурент") or contains(t, "competitor") or contains(t, "аналог")) and len(result) < budget then {
    let s = read_file("skills/fosved/marketing/competitive-analysis/SKILL.md")
    if s != "" then { let result = result + "\n--- competitive-analysis ---\n" + s }
  }
  // Unit economics
  if (contains(t, "cac") or contains(t, "ltv") or contains(t, "unit econom") or contains(t, "окупаемост") or contains(t, "payback")) and len(result) < budget then {
    let s = read_file("skills/fosved/marketing/unit-economics-and-cac/SKILL.md")
    if s != "" then { let result = result + "\n--- unit-economics-and-cac ---\n" + s }
  }
  // Positioning & messaging
  if (contains(t, "позиционирован") or contains(t, "positioning") or contains(t, "месседж") or contains(t, "messaging") or contains(t, "посыл")) and len(result) < budget then {
    let s = read_file("skills/fosved/marketing/positioning-and-messaging/SKILL.md")
    if s != "" then { let result = result + "\n--- positioning-and-messaging ---\n" + s }
  }
  // Channel strategy
  if (contains(t, "канал") or contains(t, "channel") or contains(t, "где продвигать") or contains(t, "where to promote")) and len(result) < budget then {
    let s = read_file("skills/fosved/marketing/channel-strategy/SKILL.md")
    if s != "" then { let result = result + "\n--- channel-strategy ---\n" + s }
  }

  // ── Tier 3: Special techniques (by explicit request) ──
  if (contains(t, "a/b") or contains(t, "ab test") or contains(t, "сплит")) and len(result) < budget then {
    let s = read_file("skills/fosved/marketing/ab-testing-protocol/SKILL.md")
    if s != "" then { let result = result + "\n--- ab-testing-protocol ---\n" + s }
  }
  if (contains(t, "запуск") or contains(t, "launch") or contains(t, "оркестрац")) and len(result) < budget then {
    let s = read_file("skills/fosved/marketing/launch-orchestration/SKILL.md")
    if s != "" then { let result = result + "\n--- launch-orchestration ---\n" + s }
  }

  if result == "" then { return "No Marketing skills loaded." }
  return result
}

// ═══════════════════════════════════════════════════════════════════════
// SUB-COMMAND: MARKET RESEARCH
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingResearch(query: String, chat_id: String) -> String {
  let work_mode = MarketingExtractWorkMode(query)
  let context = BuildMarketingContext(query, work_mode, chat_id)
  let disclaimer_top = MarketingDisclaimerTop()

  let verification_date = to_string(date_add_days(date_now(), 90))

  let prompt = disclaimer_top + "\n\n" + context + "\n\nРЕЖИМ: MARKET RESEARCH\n\nСтруктура ответа:\n1. Research question (explicit)\n2. Methodology: what data sources, what reliability each\n3. Market size (TAM/SAM/SOM if applicable)\n4. Key findings (with source + reliability tag for each)\n5. Forecasts with confidence and verification date\n6. Recommendations (actionable, not generic)\n7. Data sources reliability hierarchy:\n   - Tier 1: behavioral data (actual actions)\n   - Tier 2: survey data (stated preferences)\n   - Tier 3: expert opinion\n   - Tier 4: assumptions\n   - Tier 5: guesses (flag as unreliable)\n\nПРАВИЛА:\n- Каждый finding должен иметь источник и оценку надёжности\n- Если данных не хватает — честно скажи\n- Не выдумывай market size — если нет данных, укажи метод оценки\n- Verification date: " + verification_date + "\n- Не используй superlatives без доказательства"

  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: query}])
  let model = MarketingSelectModel(2)
  let llm_result = call_llm(model, messages)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)

  // Save to archive
  let _ = db_execute("INSERT INTO market_research (title, research_type, research_question, methodology, data_sources, overall_confidence, findings, recommendations, status, verification_date, created_at) VALUES (?, 'market_sizing', ?, ?, '[]', 'medium', ?, ?, 'published', ?, datetime('now'))", [substring(query, 0, 100), query, "LLM-assisted research", substring(reply, 0, 5000), substring(reply, 0, 2000), verification_date])

  let disclaimer_bottom = MarketingDisclaimerBottom(work_mode)
  let reply = reply + "\n\n" + disclaimer_bottom
  let reply = MarketingFinalSafetyCheck(reply)
  let _ = RecordAssistantMessage(chat_id, "marketing", reply)
  let _ = AuditLog("marketing_research", "marketing", "mode=" + work_mode + " vdate=" + verification_date + " model=" + model)
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SUB-COMMAND: AUDIENCE SEGMENTATION
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingSegment(query: String, chat_id: String) -> String {
  let work_mode = MarketingExtractWorkMode(query)
  let context = BuildMarketingContext(query, work_mode, chat_id)
  let disclaimer_top = MarketingDisclaimerTop()

  let prompt = disclaimer_top + "\n\n" + context + "\n\nРЕЖИМ: AUDIENCE SEGMENTATION\n\nСтруктура ответа:\n1. Product/service being segmented\n2. Segments (2-4, не больше для фокус):\n   Для каждого сегмента ОБЯЗАТЕЛЬНО:\n   - Name: конкретное имя (не 'SMB' а 'solo business operators running services')\n   - Pain point: конкретная боль (не 'efficiency' а 'spends 2+ hours daily on invoicing manually')\n   - Where to reach: конкретный канал (не 'social media' а 'Telegram business channels for small service operators in BY/RU')\n   - Current alternative: что используют сейчас (не 'nothing' а 'Excel + WhatsApp manual tracking')\n3. Segment size estimate с basis (откуда число)\n4. Priority segment + why\n5. Validation plan: как проверить гипотезу сегмента\n\nПРАВИЛА:\n- Минимум 2, максимум 4 сегмента\n- Каждый сегмент должен пройти GateConcreteSegment (4 concrete fields)\n- 'Everyone' не сегмент\n- Размер без basis — не принимается"

  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: query}])
  let model = MarketingSelectModel(1)
  let llm_result = call_llm(model, messages)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)

  let disclaimer_bottom = MarketingDisclaimerBottom(work_mode)
  let reply = reply + "\n\n" + disclaimer_bottom
  let reply = MarketingFinalSafetyCheck(reply)
  let _ = RecordAssistantMessage(chat_id, "marketing", reply)
  let _ = AuditLog("marketing_segment", "marketing", "mode=" + work_mode + " model=" + model)
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SUB-COMMAND: COMPETITIVE ANALYSIS
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingCompetitors(query: String, chat_id: String) -> String {
  let work_mode = MarketingExtractWorkMode(query)
  let context = BuildMarketingContext(query, work_mode, chat_id)
  let disclaimer_top = MarketingDisclaimerTop()

  let prompt = disclaimer_top + "\n\n" + context + "\n\nРЕЖИМ: COMPETITIVE ANALYSIS\n\nСтруктура ответа:\n1. Domain/product being analyzed\n2. 4 категории конкурентов:\n   - Direct: тот же продукт, та же аудитория\n   - Indirect: та же проблема, другое решение\n   - Substitutes: другая проблема, но решает ту же JTBD\n   - Do nothing: статус-кво (самый опасный конкурент)\n3. Для каждого: честные strengths (не 'they suck')\n4. Gaps: где они слабы, а мы можем быть сильны\n5. Our differentiation basis (не 'better UX' — конкретно)\n\nПРАВИЛА:\n- Не недооценивай конкурентов (опасно)\n- Не копируй слепо (hard rule 4)\n- 'Do nothing' всегда есть — люди могут просто не менять текущее решение\n- Честно оценивай чужие strengths"

  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: query}])
  let model = MarketingSelectModel(2)
  let llm_result = call_llm(model, messages)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)

  let disclaimer_bottom = MarketingDisclaimerBottom(work_mode)
  let reply = reply + "\n\n" + disclaimer_bottom
  let reply = MarketingFinalSafetyCheck(reply)
  let _ = RecordAssistantMessage(chat_id, "marketing", reply)
  let _ = AuditLog("marketing_competitors", "marketing", "mode=" + work_mode + " model=" + model)
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SUB-COMMAND: CAMPAIGN MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingCampaignHandler(query: String, chat_id: String) -> String {
  let work_mode = MarketingExtractWorkMode(query)
  let t = lower(query)
  let context = BuildMarketingContext(query, work_mode, chat_id)
  let disclaimer_top = MarketingDisclaimerTop()

  // List campaigns
  if contains(t, "list") or contains(t, "список") or t == "" then {
    let rows = query("SELECT id, title, campaign_type, product_promoted, status, forecast_conversion_rate, forecast_cac FROM marketing_campaigns ORDER BY created_at DESC LIMIT 15", [])
    if len(rows) == 0.0 then { return "📭 Кампаний нет. Создайте: /campaign promote <product>" }
    let model = MarketingSelectModel(0)
    let prompt = context + "\n\nРЕЖИМ: CAMPAIGN LIST\n\nКампании из базы:\n" + json_encode(rows) + "\n\nФормат: ID, название, тип, статус, прогноз conv/CAC"
    let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Покажи список кампаний"}])
    let llm_result = call_llm(model, messages)
    if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
    let reply = to_string(llm_result)
    let _ = RecordAssistantMessage(chat_id, "marketing", reply)
    return reply
  }

  // Create / promote campaign
  let prompt = disclaimer_top + "\n\n" + context + "\n\nРЕЖИМ: CAMPAIGN CREATION\n\nСтруктура:\n1. Product being promoted\n2. Campaign type (launch|growth|retention|reactivation|brand)\n3. Target segment (must be concrete — reference /segment results)\n4. Positioning (vs alternatives, from /competitors)\n5. Core message (one sentence, JTBD-lead)\n6. Channels (1-2 priority, not 'everywhere')\n7. Claims: every claim must be verifiable (hard rule 2)\n8. Next steps: set forecast, verify claims, then launch\n\nПОРЯДОК: drafted → forecasted → claims verified → launched"

  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: query}])
  let model = MarketingSelectModel(1)
  let llm_result = call_llm(model, messages)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)

  // Save draft campaign
  let _ = db_execute("INSERT INTO marketing_campaigns (title, product_promoted, campaign_type, positioning, core_message, status, created_at) VALUES (?, ?, 'growth', ?, ?, 'drafted', datetime('now'))", [substring(query, 0, 100), substring(query, 0, 100), substring(reply, 0, 2000), substring(reply, 0, 200)])

  let disclaimer_bottom = MarketingDisclaimerBottom(work_mode)
  let reply = reply + "\n\n" + disclaimer_bottom
  let reply = MarketingFinalSafetyCheck(reply)
  let _ = RecordAssistantMessage(chat_id, "marketing", reply)
  let _ = AuditLog("marketing_campaign_create", "marketing", "mode=" + work_mode)
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// CAMPAIGN LIFECYCLE STATE MACHINE
// ═══════════════════════════════════════════════════════════════════════
// States: drafted → forecasted → launched → running → completed → verified
//                                                            → aborted

pattern MarketingCampaignTransition(campaign_id: String, new_status: String, reason: String) -> String {
  let rows = query("SELECT status, forecast_conversion_rate, forecast_cac, forecast_reach, claims_verified FROM marketing_campaigns WHERE id = ?", [campaign_id])
  if len(rows) == 0.0 then { return "FAIL: campaign not found" }
  let c = get(rows, 0.0)
  let current = get(c, "status")

  // Pre-launch gates: enforce hard rules 1 and 2
  if new_status == "launched" then {
    // Gate 1: forecast must exist
    let fc = to_string(get(c, "forecast_conversion_rate"))
    let fcac = to_string(get(c, "forecast_cac"))
    let fr = to_string(get(c, "forecast_reach"))
    let g1 = GateCampaignForecast(fc, fcac, fr)
    if g1 != "PASS" then { return "🚫 " + g1 + "\n\nSet forecast first: /campaign-forecast " + campaign_id }
    // Gate 2: claims must be verified
    let cv = to_string(get(c, "claims_verified"))
    let g2 = GateClaimsVerified(cv)
    if g2 != "PASS" then { return "🚫 " + g2 + "\n\nVerify claims first." }
  }

  // Validate transition
  let valid = "false"
  if current == "drafted" and new_status == "forecasted" then { let valid = "true" }
  if current == "forecasted" and new_status == "launched" then { let valid = "true" }
  if current == "launched" and new_status == "running" then { let valid = "true" }
  if current == "running" and new_status == "completed" then { let valid = "true" }
  if current == "completed" and new_status == "verified" then { let valid = "true" }
  if new_status == "aborted" then { let valid = "true" }

  if valid == "false" then { return "FAIL: transition " + current + " → " + new_status + " is not allowed" }

  let _ = db_execute("UPDATE marketing_campaigns SET status = ?, updated_at = datetime('now') WHERE id = ?", [new_status, campaign_id])
  let _ = AuditLog("marketing_campaign_transition", "marketing", "id=" + campaign_id + " " + current + "→" + new_status + " reason=" + reason)
  return "OK: " + current + " → " + new_status
}

// ═══════════════════════════════════════════════════════════════════════
// SUB-COMMAND: CAMPAIGN FORECAST (hard rule 1 enforcement)
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingCampaignForecast(query: String, chat_id: String) -> String {
  let work_mode = MarketingExtractWorkMode(query)
  let context = BuildMarketingContext(query, work_mode, chat_id)
  let disclaimer_top = MarketingDisclaimerTop()

  let prompt = disclaimer_top + "\n\n" + context + "\n\nРЕЖИМ: CAMPAIGN FORECAST\n\nОБЯЗАТЕЛЬНЫ 3 поля (hard rule 1):\n1. Forecast conversion rate (%) — range [low, expected, high], не point\n2. Forecast CAC ($) — range [low, expected, high]\n3. Forecast reach (people) — range\n\nДополнительно:\n4. Forecast budget ($)\n5. Forecast basis: на чём основан прогноз (historical data? industry benchmark? analogous campaign? gut feeling — если gut, downgrade confidence)\n6. Confidence: high (historical data) | medium (benchmark) | low (gut)\n7. LTV:CAC ratio → go/no-go: <1:1 = NO GO, <2:1 = rework, ≥3:1 = GO\n8. Verification date: +30 дней после запуска\n\nАНТИ-ПАТТЕРНЫ:\n- Point estimate без range (overoptimism trap)\n- «Conservative estimate» без basis — это не conservative, это unjustified\n- Пропуск CAC — самый важный metric\n- Прогноз без verification date — это не прогноз, это мечта"

  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: query}])
  let model = MarketingSelectModel(1)
  let llm_result = call_llm(model, messages)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)

  let verification_date = to_string(date_add_days(date_now(), 30))
  let _ = db_execute("UPDATE marketing_campaigns SET status = 'forecasted', verification_date = ?, updated_at = datetime('now') WHERE status = 'drafted' ORDER BY created_at DESC LIMIT 1", [verification_date])

  let disclaimer_bottom = MarketingDisclaimerBottom(work_mode)
  let reply = reply + "\n\n" + disclaimer_bottom
  let reply = MarketingFinalSafetyCheck(reply)
  let _ = RecordAssistantMessage(chat_id, "marketing", reply)
  let _ = AuditLog("marketing_forecast", "marketing", "vdate=" + verification_date + " model=" + model)
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SUB-COMMAND: CAMPAIGN VERIFICATION
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingCampaignVerify(query: String, chat_id: String) -> String {
  let work_mode = MarketingExtractWorkMode(query)
  let context = BuildMarketingContext(query, work_mode, chat_id)
  let disclaimer_top = MarketingDisclaimerTop()

  let prompt = disclaimer_top + "\n\n" + context + "\n\nРЕЖИМ: CAMPAIGN VERIFICATION\n\nСтруктура:\n1. Campaign: что прогнозировали\n2. Actual: что произошло\n3. Accuracy:\n   - Conversion: |actual - forecast| / forecast (target ≤25%)\n   - CAC: |actual - forecast| / forecast (target ≤30%)\n   - Reach: |actual - forecast| / forecast (target ≤25%)\n4. Was overoptimistic? (forecast > actual × 1.5)\n5. Miss source (one of 6):\n   - overoptimism: систематический завышение прогноза\n   - wrong_segment: сегмент не откликнулся как ожидалось\n   - wrong_channel: канал не сработал\n   - wrong_message: месседж не резонировал\n   - external_factor: внешние обстоятельства\n   - none: прогноз был в пределах нормы\n6. Diagnosis: почему прогноз отклонился\n7. Lesson learned: конкретное изменение на будущее\n8. Segment status update: hypothesized→validated or disproven\n\nПРАВИЛА:\n- Не выдумывай actual values — если не знаешь, так и скажи\n- Failed campaign = learning, not shame (hard rule 9)\n- Если overoptimistic — проверь: был ли range или point estimate?"

  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Верифицируй: " + query}])
  let model = MarketingSelectModel(2)
  let llm_result = call_llm(model, messages)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)

  let _ = RecordAssistantMessage(chat_id, "marketing", reply)
  let _ = AuditLog("marketing_verify", "marketing", "mode=" + work_mode + " model=" + model)
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SUB-COMMAND: ARCHIVE SEARCH
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingArchiveSearch(query: String, chat_id: String) -> String {
  let research = query("SELECT id, title, research_type, status, overall_confidence FROM market_research ORDER BY created_at DESC LIMIT 10", [])
  let campaigns = query("SELECT id, title, campaign_type, status FROM marketing_campaigns ORDER BY created_at DESC LIMIT 10", [])

  if len(research) == 0.0 and len(campaigns) == 0.0 then { return "📭 Архив Marketing пуст." }

  let context = BuildMarketingContext(query, "internal", chat_id)
  let model = MarketingSelectModel(0)
  let prompt = context + "\n\nРЕЖИМ: АРХИВ MARKETING\n\nИсследования:\n" + json_encode(research) + "\n\nКампании:\n" + json_encode(campaigns) + "\n\nФильтр: " + query
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: query}])
  let llm_result = call_llm(model, messages)
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "marketing", reply)
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SUB-COMMAND: SCORE (METRIC SNAPSHOT)
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingScore(chat_id: String) -> String {
  // Campaign accuracy (90-day)
  let acc_rows = query("SELECT AVG(v.conversion_accuracy) as avg_conv, AVG(v.cac_accuracy) as avg_cac, COUNT(*) as n FROM campaign_verifications v WHERE v.verified_at >= datetime('now', '-90 days')", [])

  // Overoptimism rate
  let overopt = query("SELECT COUNT(*) as n FROM campaign_verifications WHERE was_overoptimistic = 1 AND verified_at >= datetime('now', '-90 days')", [])

  // Miss source distribution
  let miss_dist = query("SELECT miss_source, COUNT(*) as n FROM campaign_verifications WHERE verified_at >= datetime('now', '-90 days') AND miss_source IS NOT NULL GROUP BY miss_source ORDER BY n DESC", [])

  // Active campaigns
  let active = query("SELECT COUNT(*) as n FROM marketing_campaigns WHERE status IN ('launched', 'running')", [])

  let avg_conv = "N/A"
  let avg_cac = "N/A"
  let total_verified = 0
  if len(acc_rows) > 0.0 then {
    let raw_conv = get(get(acc_rows, 0.0), "avg_conv")
    let raw_cac = get(get(acc_rows, 0.0), "avg_cac")
    let raw_n = get(get(acc_rows, 0.0), "n")
    if to_string(raw_conv) != "null" then { let avg_conv = to_string(raw_conv) + "%" }
    if to_string(raw_cac) != "null" then { let avg_cac = to_string(raw_cac) + "%" }
    let total_verified = raw_n
  }

  let overopt_count = 0
  if len(overopt) > 0.0 then { let overopt_count = get(get(overopt, 0.0), "n") }
  let active_count = 0
  if len(active) > 0.0 then { let active_count = get(get(active, 0.0), "n") }

  let report = "📊 Marketing — Metrics Snapshot\n\n"
  let report = report + "1. Conversion accuracy (90d): " + avg_conv + " (target ±25%)\n"
  let report = report + "2. CAC accuracy (90d): " + avg_cac + " (target ±30%)\n"
  let report = report + "3. Verified campaigns: " + to_string(total_verified) + "\n"
  let report = report + "4. Overoptimistic campaigns: " + to_string(overopt_count) + "\n"
  let report = report + "5. Active campaigns: " + to_string(active_count) + "\n\n"
  let report = report + "Miss source distribution:\n"
  let i = 0.0
  while i < len(miss_dist) and i < 6.0 then {
    let row = get(miss_dist, i)
    let report = report + "  " + get(row, "miss_source") + ": " + to_string(get(row, "n")) + "\n"
    let i = i + 1.0
  }

  let _ = RecordAssistantMessage(chat_id, "marketing", report)
  let _ = AuditLog("marketing_score", "marketing", "conv=" + avg_conv + " cac=" + avg_cac + " overopt=" + to_string(overopt_count))
  return report
}

// ═══════════════════════════════════════════════════════════════════════
// NATIVE VERIFICATION — campaign accuracy calculation
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingVerifyCampaignNative(campaign_id: String, actual_conversion: String, actual_cac: String, actual_reach: String) -> String {
  let rows = query("SELECT id, forecast_conversion_rate, forecast_cac, forecast_reach, status FROM marketing_campaigns WHERE id = ?", [campaign_id])
  if len(rows) == 0.0 then { return "Campaign #" + campaign_id + " not found." }
  let c = get(rows, 0.0)
  let status = get(c, "status")
  if status != "completed" and status != "running" then { return "Campaign #" + campaign_id + " must be completed or running before verification. Current: " + status }

  let f_conv = to_float(to_string(get(c, "forecast_conversion_rate")))
  let f_cac = to_float(to_string(get(c, "forecast_cac")))
  let f_reach = to_float(to_string(get(c, "forecast_reach")))

  // Compute accuracy deltas
  let conv_accuracy = 0.0
  if f_conv > 0.0 then {
    let diff = to_float(actual_conversion) - f_conv
    if diff < 0.0 then { let diff = 0.0 - diff }
    let conv_accuracy = diff / f_conv * 100.0
  }
  let cac_accuracy = 0.0
  if f_cac > 0.0 then {
    let diff = to_float(actual_cac) - f_cac
    if diff < 0.0 then { let diff = 0.0 - diff }
    let cac_accuracy = diff / f_cac * 100.0
  }
  let reach_accuracy = 0.0
  if f_reach > 0.0 then {
    let diff = to_float(actual_reach) - f_reach
    if diff < 0.0 then { let diff = 0.0 - diff }
    let reach_accuracy = diff / f_reach * 100.0
  }

  // Overoptimism detection
  let was_overoptimistic = "false"
  if f_conv > 0.0 and to_float(actual_conversion) > 0.0 then {
    if f_conv / to_float(actual_conversion) > 1.5 then { let was_overoptimistic = "true" }
  }

  // Within target?
  let conv_within = "true"
  if conv_accuracy > 25.0 then { let conv_within = "false" }
  let cac_within = "true"
  if cac_accuracy > 30.0 then { let cac_within = "false" }

  // Save verification
  let _ = db_execute("INSERT INTO campaign_verifications (campaign_id, conversion_accuracy, cac_accuracy, reach_accuracy, conversion_within_target, cac_within_target, was_overoptimistic, verified_at) VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'))", [campaign_id, to_string(conv_accuracy), to_string(cac_accuracy), to_string(reach_accuracy), conv_within, cac_within, was_overoptimistic])
  // Update campaign status
  let _ = db_execute("UPDATE marketing_campaigns SET actual_conversion_rate = ?, actual_cac = ?, actual_reach = ?, status = 'verified', updated_at = datetime('now') WHERE id = ?", [actual_conversion, actual_cac, actual_reach, campaign_id])

  let report = "✅ Campaign #" + campaign_id + " Verified\n\n"
  let report = report + "Forecast → Actual:\n"
  let report = report + "  Conversion: " + to_string(f_conv) + "% → " + actual_conversion + "% (accuracy: " + to_string(conv_accuracy) + "%, target ≤25%)\n"
  let report = report + "  CAC: $" + to_string(f_cac) + " → $" + actual_cac + " (accuracy: " + to_string(cac_accuracy) + "%, target ≤30%)\n"
  let report = report + "  Reach: " + to_string(f_reach) + " → " + actual_reach + " (accuracy: " + to_string(reach_accuracy) + "%)\n"
  let report = report + "  Overoptimistic: " + was_overoptimistic + "\n"
  if was_overoptimistic == "true" then { let report = report + "\n🚨 Overoptimism detected! Forecast was 50%+ above actual. Review forecast basis and consider using ranges instead of point estimates." }

  return report
}

// ═══════════════════════════════════════════════════════════════════════
// ERROR CLASSIFIER — 6 miss sources
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingClassifyMissSource(campaign_id: String) -> String {
  let rows = query("SELECT c.forecast_conversion_rate, c.actual_conversion_rate, c.forecast_cac, c.actual_cac, v.was_overoptimistic, v.miss_source FROM marketing_campaigns c JOIN campaign_verifications v ON v.campaign_id = c.id WHERE c.id = ? ORDER BY v.verified_at DESC LIMIT 1", [campaign_id])
  if len(rows) == 0.0 then { return "no data" }

  let v = get(rows, 0.0)
  let existing_miss = get(v, "miss_source")
  if to_string(existing_miss) != "null" and to_string(existing_miss) != "" then { return to_string(existing_miss) }

  // Heuristic classification
  let overopt = get(v, "was_overoptimistic")
  if overopt == 1.0 then { return "overoptimism: forecast systematically exceeded actual. Likely cause: point estimate instead of range, or benchmark from different market." }

  let f_conv = to_float(to_string(get(v, "forecast_conversion_rate")))
  let a_conv = to_float(to_string(get(v, "actual_conversion_rate")))
  // If conversion much lower but CAC similar — likely wrong segment or channel
  if f_conv > 0.0 and a_conv > 0.0 then {
    let ratio = f_conv / a_conv
    if ratio > 1.3 then { return "wrong_segment_or_channel: conversion significantly below forecast. Segment may not have the pain, or channel may not reach them." }
  }

  return "unclassified: manual review needed. Consider: was the message right? Was timing right? External factors?"
}

// ═══════════════════════════════════════════════════════════════════════
// SCHEDULER HOOKS — called by scheduler.js
// ═══════════════════════════════════════════════════════════════════════

// Daily check (09:00) — campaigns due for verification (>14 days completed)
pattern MarketingDailyCheck() -> String {
  let alerts = ""
  let due = query("SELECT id, title, status, completed_at FROM marketing_campaigns WHERE status = 'completed' AND date(completed_at, '+14 days') <= datetime('now') ORDER BY completed_at ASC", [])
  if len(due) > 0.0 then {
    let alerts = alerts + "📋 Campaigns due verification: " + to_string(len(due)) + "\n"
    let i = 0.0
    while i < len(due) and i < 5.0 then {
      let c = get(due, i)
      let alerts = alerts + "  #" + to_string(get(c, "id")) + " " + get(c, "title") + " (completed " + to_string(get(c, "completed_at")) + ")\n"
      let i = i + 1.0
    }
  }
  if alerts == "" then { let alerts = "✅ No campaigns due verification." }
  let _ = AuditLog("marketing_daily", "marketing", "due_verify=" + to_string(len(due)))
  return alerts
}

// Monthly review (1st of month, 09:30)
pattern MarketingMonthlyReview() -> String {
  let verifications = query("SELECT v.campaign_id, v.conversion_accuracy, v.cac_accuracy, v.was_overoptimistic, v.miss_source FROM campaign_verifications v WHERE v.verified_at >= datetime('now', '-30 days')", [])

  let total = len(verifications)
  let overopt_count = 0.0
  let i = 0.0
  while i < total then {
    let v = get(verifications, i)
    if get(v, "was_overoptimistic") == 1.0 then { let overopt_count = overopt_count + 1.0 }
    let i = i + 1.0
  }

  // Miss source clustering
  let miss_dist = query("SELECT miss_source, COUNT(*) as n FROM campaign_verifications WHERE verified_at >= datetime('now', '-30 days') AND miss_source IS NOT NULL GROUP BY miss_source ORDER BY n DESC", [])

  let report = "📊 Marketing — Monthly Review\n\n"
  let report = report + "Verifications: " + to_string(total) + "\n"
  let report = report + "Overoptimistic: " + to_string(overopt_count) + "\n\n"
  let report = report + "Miss source distribution:\n"
  let j = 0.0
  while j < len(miss_dist) then {
    let row = get(miss_dist, j)
    let report = report + "  " + get(row, "miss_source") + ": " + to_string(get(row, "n")) + "\n"
    let j = j + 1.0
  }

  let _ = db_execute("INSERT INTO marketing_monthly_reviews (period_start, period_end, total_verifications, overoptimistic_count, miss_distribution, created_at) VALUES (datetime('now', '-30 days'), datetime('now'), ?, ?, ?, datetime('now'))", [to_string(total), to_string(overopt_count), json_encode(miss_dist)])

  let _ = AuditLog("marketing_monthly", "marketing", "total=" + to_string(total) + " overopt=" + to_string(overopt_count))
  return report
}

// Quarterly methodology review (1st of quarter, 10:00)
pattern MarketingQuarterlyReview() -> String {
  let reviews = query("SELECT id, total_verifications, overoptimistic_count FROM marketing_monthly_reviews ORDER BY created_at DESC LIMIT 3", [])

  let report = "📊 Marketing — Quarterly Methodology Review\n\n"
  let total_v = 0.0
  let total_overopt = 0.0
  let i = 0.0
  while i < len(reviews) then {
    let r = get(reviews, i)
    let tv = get(r, "total_verifications")
    let to_ = get(r, "overoptimistic_count")
    let report = report + "  Month " + to_string(i + 1.0) + ": " + to_string(tv) + " verifications, " + to_string(to_) + " overoptimistic\n"
    let total_v = total_v + to_float(to_string(tv))
    let total_overopt = total_overopt + to_float(to_string(to_))
    let i = i + 1.0
  }

  let overopt_rate = 0.0
  if total_v > 0.0 then { let overopt_rate = total_overopt / total_v * 100.0 }

  let report = report + "\nOveroptimism rate: " + to_string(overopt_rate) + "%\n\n"
  if overopt_rate > 30.0 then {
    let report = report + "🚨 Overoptimism >30%. Critical issues:\n"
    let report = report + "1. Switch from point estimates to ranges\n"
    let report = report + "2. Use historical data, not benchmarks from different markets\n"
    let report = report + "3. Add stress test: 'what if conversion is 50% of forecast?'\n"
    let report = report + "4. Review forecast-before-launch skill with team\n"
  }
  if overopt_rate <= 30.0 and overopt_rate > 15.0 then {
    let report = report + "⚠️ Overoptimism 15-30%. Room for improvement:\n"
    let report = report + "1. Widen forecast ranges\n"
    let report = report + "2. Analyze overoptimistic campaigns for common pattern\n"
  }
  if overopt_rate <= 15.0 then {
    let report = report + "✅ Overoptimism ≤15%. Forecasts are well-calibrated.\n"
  }

  let _ = AuditLog("marketing_quarterly", "marketing", "overopt_rate=" + to_string(overopt_rate))
  return report
}

// ═══════════════════════════════════════════════════════════════════════
// CROSS-DEPARTMENT COLLABORATION
// ═══════════════════════════════════════════════════════════════════════

// Finance: verify Marketing's CAC/LTV against actual data
pattern MarketingFinanceVerifyCAC(campaign_id: String) -> String {
  let rows = query("SELECT id, title, forecast_cac, actual_cac, actual_conversion_rate FROM marketing_campaigns WHERE id = ?", [campaign_id])
  if len(rows) == 0.0 then { return "Campaign not found" }
  let c = get(rows, 0.0)
  return json_encode({department: "marketing", context: "cac_ltv_verification", campaign_id: campaign_id, forecast_cac: get(c, "forecast_cac"), actual_cac: get(c, "actual_cac"), actual_conversion: get(c, "actual_conversion_rate"), note: "Finance verifies CAC/LTV: is actual CAC sustainable? Does LTV:CAC ratio hold with actual data?"})
}

// Visual: campaign brief for asset creation
pattern MarketingVisualBrief(campaign_id: String) -> String {
  let rows = query("SELECT id, title, product_promoted, core_message, channels, positioning FROM marketing_campaigns WHERE id = ?", [campaign_id])
  if len(rows) == 0.0 then { return "Campaign not found" }
  let c = get(rows, 0.0)
  return json_encode({department: "marketing", context: "visual_brief", campaign_id: campaign_id, product: get(c, "product_promoted"), message: get(c, "core_message"), channels: get(c, "channels"), positioning: get(c, "positioning")})
}

// Legal: claim compliance check
pattern MarketingLegalCheck(campaign_id: String) -> String {
  let rows = query("SELECT id, title, core_message, claims_verified, claims_note FROM marketing_campaigns WHERE id = ?", [campaign_id])
  if len(rows) == 0.0 then { return "Campaign not found" }
  let c = get(rows, 0.0)
  return json_encode({department: "marketing", context: "claim_compliance", campaign_id: campaign_id, message: get(c, "core_message"), claims_verified: get(c, "claims_verified"), note: "Legal reviews claims for compliance with advertising law, no misleading statements, no vulnerable group targeting."})
}

// OSP: strategic positioning context
pattern MarketingOSPContext() -> String {
  let segments = query("SELECT id, name, pain_point, status FROM audience_segments WHERE status = 'validated' ORDER BY created_at DESC LIMIT 5", [])
  let campaigns = query("SELECT id, title, campaign_type, status FROM marketing_campaigns WHERE status IN ('launched', 'running', 'verified') ORDER BY created_at DESC LIMIT 5", [])
  return json_encode({department: "marketing", segments: segments, campaigns: campaigns, note: "Marketing provides validated segments and campaign performance for OSP's strategic analysis. Investment decisions remain OSP domain."})
}

