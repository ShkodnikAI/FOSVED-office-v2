// ═══════════════════════════════════════════════════════════════════════
// BOT HANDLER REGISTRY — 8 Telegram commands
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingBotHandlers() -> String {
  let h = ""
  let h = h + "/market-research <topic> → MarketingResearch\n"
  let h = h + "/segment <product> → MarketingSegment\n"
  let h = h + "/competitors <domain> → MarketingCompetitors\n"
  let h = h + "/campaign [list|promote <product>] → MarketingCampaignHandler\n"
  let h = h + "/campaign-forecast <id> → MarketingCampaignForecast (hard rule 1: 3 fields)\n"
  let h = h + "/campaign-verify <id> → MarketingCampaignVerify (accuracy + overoptimism)\n"
  let h = h + "/marketing-score → MarketingScore\n"
  let h = h + "/marketing-archive [filter] → MarketingArchiveSearch\n"
  return h
}

// ═══════════════════════════════════════════════════════════════════════
// DEPARTMENT REGISTRY ENTRY — metadata for lib/departments-registry.js
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingRegistryEntry() -> String {
  return json_encode({
    slug: "marketing",
    title: "Продвижение",
    shortName: "МКТ",
    status: "active",
    psychotype_primary: "Эмпат",
    psychotype_secondary: "Экспериментатор",
    metric_name: "campaign-accuracy",
    metric_targets: "conversion ±25%, CAC ±30%",
    archiveModel: "MarketingCampaign",
    verificationModel: "CampaignVerification",
    monthlyReviewModel: "MarketingMonthlyReview",
    aliases: "маркетинг,продвижение,реклама,кампания,mkt,marketing,campaign",
    routingTriggers: "сегмент,кампания,конверсия,CAC,LTV,конкурент,позиционирование,канал,исследование рынка,audience,campaign,segment",
    requiredContext: "workMode (internal/external)",
    commands: "/marketing,/market-research,/segment,/competitors,/campaign,/campaign-forecast,/campaign-verify,/marketing-score,/marketing-archive",
    schedule: "daily 09:00, monthly 1st 09:30, quarterly 1st 10:00"
  })
}

// ═══════════════════════════════════════════════════════════════════════
// UPRAVLENIE ROUTING — Yana's Marketing integration
// ═══════════════════════════════════════════════════════════════════════

pattern MarketingYanaRouting(query: String) -> String {
  let t = lower(query)
  // Direct Marketing patterns
  if contains(t, "исследован") and contains(t, "рынок") then { return "ROUTE:marketing:research" }
  if contains(t, "сегмент") or contains(t, "аудитори") or contains(t, "целевая") then { return "ROUTE:marketing:segment" }
  if contains(t, "конкурент") or contains(t, "аналог") then { return "ROUTE:marketing:competitors" }
  if contains(t, "кампани") or contains(t, "продвижен") or contains(t, "реклам") then { return "ROUTE:marketing:campaign" }
  if contains(t, "конверси") or contains(t, "cac") or contains(t, "ltv") then { return "ROUTE:marketing:unit_economics" }
  // Boundary: OSP
  if contains(t, "стратегическ ситуаци") or contains(t, "куда двигаться") then { return "ROUTE:osp:strategic" }
  // Boundary: Finance
  if contains(t, "сколько денег") or contains(t, "cashflow") then { return "ROUTE:finance:cashflow" }
  // Boundary: Legal
  if contains(t, "закон о реклам") or contains(t, "compliance") then { return "ROUTE:legal:compliance" }
  // Cross-department
  if contains(t, "запусти") and contains(t, "продукт") then { return "ROUTE:marketing+visual+legal:launch_pipeline" }
  return "NO_ROUTE"
}

// Yana boundary disambiguation
pattern MarketingYanaBoundaries(query: String) -> String {
  let t = lower(query)
  // Most common confusion: Marketing vs OSP
  if (contains(t, "стратег") or contains(t, "позиционирован на рынке")) and not contains(t, "кампани") then {
    return "BOUNDARY: это стратегический вопрос → OSP. Marketing делает тактическое позиционирование и кампании. OSP — стратегическое."
  }
  // Marketing vs ЛЗ (Knowledge Lab)
  if contains(t, "технолог") and contains(t, "тренд") then {
    return "BOUNDARY: technology trends → ЛЗ (Knowledge Lab). Marketing исследует рынок и конкурентов, не технологии."
  }
  // Marketing vs Visual
  if contains(t, "дизайн") and not contains(t, "кампани") then {
    return "BOUNDARY: design without campaign context → Visual. Marketing брифует, Visual создаёт."
  }
  return "NO_BOUNDARY"
}
