// Fosved Office v2 — Context Manager
// BuildContext, SelectSkillsByKeywords, CompressDialog

pattern BuildContext(dept: String, query: String, chat_id: String) -> String {
  // Level 1: Always — profile + skills
  let profile = ReadDeptProfile(dept)
  let skills = SelectSkillsByKeywords(dept, query)

  // Level 2: On request — corrections + recent dialog
  let corrections = GetCorrections(dept)
  let dialog = GetRecentDialog(chat_id, "5")

  // Level 3: Auto — compressed history
  let msg_count = to_string(now())

  // Compose context
  let context = profile + "\n\n=== Active Skills ===\n" + skills + "\n\n=== Corrections ===\n" + corrections + "\n\n=== Recent Dialog ===\n" + dialog
  return context
}

pattern ReadDeptProfile(dept: String) -> String {
  // Try file_cache first (transliterated ASCII)
  let cached = kv_get("fc_profile_" + dept)
  if cached != "" then { return cached }

  // Try reading library/*.md directly
  let content = read_file("library/" + dept + ".md")
  if content != "" then { return content }

  // Fallback to condensed
  return "Department: " + dept + ". Act professionally."
}

pattern SelectSkillsByKeywords(dept: String, query: String) -> String {
  // Read skills index for department
  let index_content = read_file("skills_index/" + dept + ".txt")
  if index_content == "" then { return "No skills loaded." }

  // Simple keyword matching — return top skills
  let skills_list = split(trim(index_content), "\n")
  let result = ""
  each skill in skills_list {
    if len(result) < 2000.0 then {
      let skill_content = read_file("skills/fosved/" + dept + "/" + trim(skill) + "/SKILL.md")
      if skill_content != "" then {
        // Check if query keywords appear in skill
        if contains(lower(skill_content), lower(substring(query, 0.0, 50.0))) == 1.0 then {
          let result = result + "\n--- " + trim(skill) + " ---\n" + substring(skill_content, 0.0, 500.0)
        }
      }
    }
  }
  if result == "" then { return "Skills available for " + dept + ": " + index_content }
  return result
}

pattern CompressDialog(chat_id: String) -> String {
  // If > 20 messages, compress oldest 15
  let rows = query("SELECT COUNT(*) as cnt FROM dialog_history WHERE chat_id = ?", [chat_id])
  return "ok"
}
