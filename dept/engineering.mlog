// ═══════════════════════════════════════════════════════════════════════
// Fosved Office v2 — Engineering Department (NATIVE v1.0)
// ═══════════════════════════════════════════════════════════════════════
// Replaces Python proxy stub with native Metalogos engineering engine.
// 12 skill patterns, 3 disciplines, 10 hard rules, lifecycle state machine,
// HARD GATES: immutable calc zones, disclaimer enforcement, safety factor

// ── Hard Gates ────────────────────────────────────────────────────────
pattern EngGateImmutable(file_path: String) -> String {
  // Engineering calculations in these zones are immutable
  if contains(file_path, "calc_verified") then { return "BLOCK:verified_calc" }
  if contains(file_path, "audit_log") then { return "BLOCK:audit" }
  if contains(file_path, "lockdown") then { return "BLOCK:lockdown" }
  return "PASS"
}

pattern EngGateSafetyFactor(factor: String) -> String {
  // Minimum safety factor enforcement (naryad #378: gate wiring live).
  // Floor = 1.5 (codified department minimum); config/engineering_min_safety_factor.txt
  // can only RAISE the floor (max of 1.5 and config). Non-numeric factor ("N/A") —
  // gate cannot evaluate → PASS (honesty is enforced by the verdict path, not by this gate).
  let mut min_f = 1.5
  let min_cfg = TryVal(try to_float(trim(redact(read_file("config/engineering_min_safety_factor.txt"), "all"))))
  if to_string(min_cfg) != "()" then {
    if min_cfg > min_f then { let min_f = min_cfg }
  }
  let f = TryVal(try to_float(factor))
  if to_string(f) == "()" then { return "PASS" }
  if f < min_f then { return "BLOCK:safety_factor_below_minimum" }
  return "PASS"
}
// disclaimer enforcement, independent verification, learning loop.
// 0 CallLLMProxy calls, 0 Python dependencies.
//
// Architecture:
//   HandleEngineering(query, chat_id)
//     → ParseEngineeringQuery(query)       ← NLP discipline + command detection
//     → RouteByCommand(cmd, ...)            ← 8 bot commands + free-text dispatch
//       → cmd=calc     → CreateCalculation
//       → cmd=norms    → SetNormBase          ← Tier 1: hard rule 2
//       → cmd=loadcases→ SetLoadCases         ← Tier 1: hard rule 3
//       → cmd=verify   → IndependentVerify     ← Tier 1: hard rule 7+8
//       → cmd=review   → EngineerReview
//       → cmd=show     → ShowCalculation
//       → cmd=score    → EngineeringScore
//       → cmd=archive  → SearchArchive
//       → free-text    → FullPipeline
//     → FullPipeline (for free-text queries):
//       → DetectDiscipline                  ← structural | hydraulic | power_electronics
//       → FeasibilityEstimate (optional)    ← Tier 3 screening
//       → SetNormBase                       ← Tier 1: mandatory
//       → SetLoadCases                      ← Tier 1: mandatory
//       → ExecuteDisciplineCalc             ← Tier 2: structural | hydraulic | power_electronics
//       → IndependentVerify                 ← Tier 1: mandatory
//       → AssembleDocumentation             ← Tier 1: final assembly
//       → WrapWithDisclaimer                ← Tier 1: hard rule 1
//     → RecordAssistantMessage
//
// Discipline blocks (Tier 2):
//   Structural: StructuralLoadBearing, StructuralElementsSizing
//   Hydraulic:  HydraulicDriveDesign
//   Power:      PowerElectronicsInverter, RenewableSystemMatching
//
// Depends on BUILTINS only (no Python, no CallLLMProxy):
//   call_llm, db_execute, kv_get, kv_set, json_encode, json_get, parse_json,
//   to_string, to_float, to_int, length, contains, lower, substring,
//   substring, join, split, now, format_date, hash, AuditLog,
//   RecordAssistantMessage, BuildContext, SendTelegramMessage
//
// ═══════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// SECTION 0: CONSTANTS & DISCLAIMER
// ═══════════════════════════════════════════════════════════════════════

pattern DISCLAIMER_TOP() -> String { return "⚠️ ПРЕДВАРИТЕЛЬНО. Расчёт подлежит проверке и утверждению дипломированным инженером соответствующей специальности. Не является основанием для строительства/производства без такой проверки." }

pattern DISCLAIMER_BOTTOM() -> String { return "⚠️ Данный результат — предварительный расчёт проектного ассистента. Ответственность за конструкцию несёт дипломированный инженер после проверки и подписи." }



// Lifecycle states
pattern STATUS_DRAFTED() -> String { return "drafted" }
pattern STATUS_CALCULATED() -> String { return "calculated" }
pattern STATUS_SELF_VERIFIED() -> String { return "self_verified" }
pattern STATUS_SENT_FOR_REVIEW() -> String { return "sent_for_review" }
pattern STATUS_ENGINEER_APPROVED() -> String { return "engineer_approved" }
pattern STATUS_ENGINEER_CORRECTED() -> String { return "engineer_corrected" }
pattern STATUS_ARCHIVED() -> String { return "archived" }


// ── Immunity gate wiring (naryad #378: gates were declared but never called) ──
pattern CalcImmutableZone(calc_id: String) -> String {
  // Maps a calculation record to its storage zone for EngGateImmutable:
  // engineer_approved / archived → calc_verified (engineer-of-record document, immutable);
  // system_lockdown (kv_store, наряд №268) → lockdown (office-wide write freeze).
  if kv_get("system_lockdown") == "true" then { return "lockdown" }
  let rows = query("SELECT status FROM engineering_calculations WHERE id = ?", [calc_id])
  if length(rows) > 0 then {
    let status = redact(to_string(json_get(get(rows, 0), "status", "")), "all")
    if status == STATUS_ENGINEER_APPROVED() then { return "calc_verified" }
    if status == STATUS_ARCHIVED() then { return "calc_verified" }
  }
  return "drafting"
}

pattern GuardMutable(calc_id: String) -> String {
  // Returns "" when the record may be modified, otherwise an honest refusal.
  // Guards SetNormBase / SetLoadCases / IndependentVerify / EngineerReview from
  // silently mutating engineer-approved or archived calculations.
  let zone = CalcImmutableZone(calc_id)
  let gate = EngGateImmutable("engineering_calcs/" + zone + "/" + calc_id)
  if gate != "PASS" then {
    let _ = AuditLog("eng_gate_immutable", "engineering", "calc_id=" + calc_id + " gate=" + gate)
    return "ЗАБЛОКИРОВАНО гейтом EngGateImmutable (" + gate + "): расчёт " + calc_id + " в неизменяемой зоне («" + zone + "»). Создайте новый расчёт вместо правки утверждённого."
  }
  return ""
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 1: NLP QUERY PARSER & DISCIPLINE DETECTION
// ═══════════════════════════════════════════════════════════════════════

pattern DetectDiscipline(query: String) -> String {
  let q = lower(query)
  // Structural keywords
  if contains(q, "несущ") or contains(q, "кровл") or contains(q, "теплиц") or contains(q, "каркас") then { return "structural" }
  if contains(q, "балк") or contains(q, "ферм") or contains(q, "снегов") or contains(q, "ветров") then { return "structural" }
  if contains(q, "строимех") or contains(q, "строймех") or contains(q, "сечени") or contains(q, "прогиб") then { return "structural" }
  if contains(q, "roof") or contains(q, "greenhouse") or contains(q, "frame") or contains(q, "beam") then { return "structural" }
  if contains(q, "snow load") or contains(q, "wind load") or contains(q, "bearing") then { return "structural" }
  // Hydraulic keywords
  if contains(q, "гидравл") or contains(q, "гидропривод") or contains(q, "гидроцилиндр") then { return "hydraulic" }
  if contains(q, "подъёмник") or contains(q, "подъемник") or contains(q, "давлени") or contains(q, "насос") then { return "hydraulic" }
  if contains(q, "hydraulic") or contains(q, "cylinder") or contains(q, "lift") or contains(q, "pump") then { return "hydraulic" }
  // Power electronics keywords
  if contains(q, "инвертор") or contains(q, "коммутатор") or contains(q, "преобразоват") then { return "power_electronics" }
  if contains(q, "ветрогенератор") or contains(q, "солнечн") or contains(q, "фотоэлектрич") then { return "power_electronics" }
  if contains(q, "inverter") or contains(q, "solar") or contains(q, "wind generator") or contains(q, "PV") then { return "power_electronics" }
  return "unknown"
}

pattern DetectCommand(query: String) -> String {
  let q = lower(query)
  if contains(q, "/calc-norms") then { return "norms" }
  if contains(q, "/calc-loadcases") then { return "loadcases" }
  if contains(q, "/calc-verify") then { return "verify" }
  if contains(q, "/calc-review") then { return "review" }
  if contains(q, "/calc-show") then { return "show" }
  if contains(q, "/calc") then { return "calc" }
  if contains(q, "/eng-score") then { return "score" }
  if contains(q, "/eng-archive") then { return "archive" }
  return "free_text"
}

pattern ParseEngineeringQuery(query: String) -> Dict {
  let command = DetectCommand(query)
  let discipline = DetectDiscipline(query)

  // Out-of-scope detection: disciplines beyond the three
  let q = lower(query)
  let is_out_of_scope = contains(q, "фундамент") or contains(q, "сейсм") or contains(q, "пожарн") or contains(q, "геотехн") or contains(q, "foundation") or contains(q, "seismic") or contains(q, "fire saf") or contains(q, "geotechn")

  // Extract calc_id if present (after command keyword)
  let mut calc_id = ""
  let parts = split(query, " ")
  if command == "norms" or command == "loadcases" or command == "verify" or command == "review" or command == "show" then {
    if length(parts) > 1 then {
      let calc_id = to_string(get(parts, 1))
    }
  }

  return {
    command: command,
    discipline: discipline,
    task_description: query,
    calc_id: calc_id,
    is_out_of_scope: is_out_of_scope
  }
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 2: DISCLAIMER ENFORCEMENT (Tier 1 — engineering-disclaimer-discipline)
// Hard rules: #1 (mandatory disclaimer), #6 (out-of-scope refusal), #10 (plain fails)
// ═══════════════════════════════════════════════════════════════════════

pattern WrapWithDisclaimer(content: String) -> String {
  return DISCLAIMER_TOP() + "\n\n" + content + "\n\n" + DISCLAIMER_BOTTOM()
}

pattern DeclineOutOfScope(query: String) -> String {
  let msg = "Запрос отклонён: задача выходит за рамки трёх дисциплин инженерного отдела (строительная механика, гидравлика, силовая электроника).\n\n"
  let msg = msg + "Запрошенная задача требует профильного инженера-специалиста. Инженерный отдел — проектный ассистент в строго определённых дисциплинах, не инженер-универсал.\n\n"
  let msg = msg + "Доступные дисциплины:\n"
  let msg = msg + "• Строительная механика — несущие конструкции, кровли, теплицы, каркасы\n"
  let msg = msg + "• Гидравлика — гидроприводы, подъёмники, гидроцилиндры\n"
  let msg = msg + "• Силовая электроника — инверторы, ВИЭ, коммутаторы"
  return WrapWithDisclaimer(msg)
}

pattern FormatVerdict(verdict: String) -> String {
  // Hard rule 10: plain verdict, no softening
  if verdict == "passes" then { return "✅ КОНСТРУКЦИЯ ПРОХОДИТ — при условии проверки дипломированным инженером." }
  if verdict == "fails" then { return "❌ КОНСТРУКЦИЯ НЕ ПРОХОДИТ — требуется изменение концепции или параметров." }
  if verdict == "conditional" then { return "⚠️ УСЛОВНО ПРОХОДИТ — при выполнении указанных условий." }
  if verdict == "needs_more_data" then { return "❓ НЕДОСТАТОЧНО ДАННЫХ — для завершения расчёта необходимы указанные параметры." }
  return verdict
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 3: NORM-BASE FIXATION (Tier 1 — norm-base-fixation)
// Hard rule: #2 (no calculation without a stated norm)
// ═══════════════════════════════════════════════════════════════════════

pattern GetNormSystem() -> String {
  // Normative-base switch (naryad #378): config/engineering_normbase.txt ∈ {RF, BY, EU}.
  // Default RF; missing/unknown content honestly falls back to RF (codified default).
  let nb = trim(redact(read_file("config/engineering_normbase.txt"), "all"))
  if nb == "BY" then { return "BY" }
  if nb == "EU" then { return "EU" }
  return "RF"
}

pattern GetDefaultNormsFor(discipline: String, norm_system: String) -> String {
  // Default norm packs per (discipline, norm_system). Unknown combination → "[]"
  // → SetNormBase honestly refuses (hard rule 2: no calculation without a fixed norm base).
  if norm_system == "RF" then {
    if discipline == "structural" then {
      return "[{\"code\":\"СП 20.13330\",\"edition\":\"2016\",\"title\":\"Нагрузки и воздействия\",\"governs\":\"load_combinations\"},{\"code\":\"СП 16.13330\",\"edition\":\"2017\",\"title\":\"Стальные конструкции\",\"governs\":\"steel_design\"},{\"code\":\"СП 64.13330\",\"edition\":\"2017\",\"title\":\"Деревянные конструкции\",\"governs\":\"timber_design\"},{\"code\":\"СП 70.13330\",\"edition\":\"2016\",\"title\":\"Несущие и ограждающие конструкции\",\"governs\":\"execution\"}]"
    }
    if discipline == "hydraulic" then {
      return "[{\"code\":\"ГОСТ Р 52869\",\"edition\":\"2007\",\"title\":\"Гидроприводы объёмные\",\"governs\":\"hydraulic_systems\"},{\"code\":\"ГОСТ 17474\",\"edition\":\"2015\",\"title\":\"Гидроцилиндры\",\"governs\":\"cylinder_specs\"},{\"code\":\"ПБ 10-157-97\",\"edition\":\"2003\",\"title\":\"Правила подъёмных сооружений\",\"governs\":\"lifting_safety\"}]"
    }
    if discipline == "power_electronics" then {
      return "[{\"code\":\"ПУЭ\",\"edition\":\"7-е изд.\",\"title\":\"Правила устройства электроустановок\",\"governs\":\"electrical_safety\"},{\"code\":\"ГОСТ Р 50571\",\"edition\":\"2019\",\"title\":\"Электробезопасность\",\"governs\":\"low_voltage_installations\"},{\"code\":\"ГОСТ Р 54002\",\"edition\":\"2010\",\"title\":\"Фотоэлектрические системы\",\"governs\":\"pv_systems\"}]"
    }
  }
  if norm_system == "BY" then {
    if discipline == "structural" then {
      return "[{\"code\":\"СН 2.04.01-2020\",\"edition\":\"\",\"title\":\"Нагрузки и воздействия (РБ)\",\"governs\":\"load_combinations\"},{\"code\":\"СН 5.04.01-2021\",\"edition\":\"\",\"title\":\"Стальные конструкции (РБ)\",\"governs\":\"steel_design\"},{\"code\":\"СН 5.06.01-2020\",\"edition\":\"\",\"title\":\"Деревянные конструкции (РБ)\",\"governs\":\"timber_design\"}]"
    }
    if discipline == "hydraulic" then {
      return "[{\"code\":\"ГОСТ 18464-96\",\"edition\":\"\",\"title\":\"Гидрообъемные приводы. Методы испытаний\",\"governs\":\"hydraulic_testing\"},{\"code\":\"ГОСТ 17474\",\"edition\":\"\",\"title\":\"Гидроцилиндры\",\"governs\":\"cylinder_specs\"}]"
    }
    if discipline == "power_electronics" then {
      return "[{\"code\":\"ГОСТ 30331.1\",\"edition\":\"\",\"title\":\"Электроустановки зданий. Основные положения\",\"governs\":\"electrical_safety\"}]"
    }
  }
  if norm_system == "EU" then {
    if discipline == "structural" then {
      return "[{\"code\":\"EN 1990\",\"edition\":\"2002\",\"title\":\"Eurocode — Basis of structural design\",\"governs\":\"load_combinations\"},{\"code\":\"EN 1991\",\"edition\":\"\",\"title\":\"Eurocode 1 — Actions on structures\",\"governs\":\"actions\"},{\"code\":\"EN 1993\",\"edition\":\"\",\"title\":\"Eurocode 3 — Design of steel structures\",\"governs\":\"steel_design\"},{\"code\":\"EN 1995\",\"edition\":\"\",\"title\":\"Eurocode 5 — Design of timber structures\",\"governs\":\"timber_design\"}]"
    }
    if discipline == "hydraulic" then {
      return "[{\"code\":\"ISO 4413\",\"edition\":\"2010\",\"title\":\"Hydraulic fluid power — General rules and safety requirements\",\"governs\":\"hydraulic_systems\"},{\"code\":\"EN 982\",\"edition\":\"1996\",\"title\":\"Fluid power systems — hydraulic safety requirements\",\"governs\":\"lifting_safety\"}]"
    }
    if discipline == "power_electronics" then {
      return "[{\"code\":\"IEC 60364\",\"edition\":\"\",\"title\":\"Low-voltage electrical installations\",\"governs\":\"electrical_safety\"},{\"code\":\"IEC 62446\",\"edition\":\"\",\"title\":\"Photovoltaic systems — documentation and commissioning\",\"governs\":\"pv_systems\"}]"
    }
  }
  return "[]"
}

pattern GetDefaultNorms(discipline: String) -> String {
  // Returns JSON array of default norms for RF jurisdiction (naryad #378: RF = one of {RF, BY, EU})
  return GetDefaultNormsFor(discipline, "RF")
}

pattern SetNormBase(calc_id: String, discipline: String, norm_system: String, norms_json: String) -> String {
  // Hard rule 2: no calculation without a fixed norm base
  // Immunity gate (naryad #378): approved/archived calculations are immutable
  let gm = GuardMutable(calc_id)
  if gm != "" then { return gm }
  // Gate: if norms_json is empty, use discipline defaults for the given norm_system
  let norms = norms_json
  if norms_json == "" or norms_json == "[]" then { let norms = GetDefaultNormsFor(discipline, norm_system) }

  // Validate: at least 1 norm must be present
  let norms_parsed = parse_json(norms)
  if length(norms_parsed) == 0 then {
    return "ОШИБКА: Невозможно начать расчёт без нормативной базы. Укажите нормы командой /calc-norms или уточните дисциплину."
  }

  // Persist to DB
  let _ = db_execute("UPDATE engineering_calculations SET norm_system = ?, norms_applied = ?, status = ? WHERE id = ?", [norm_system, norms, STATUS_DRAFTED(), calc_id])

  // Log norm fixation
  let _ = AuditLog("eng_norm_fix", "engineering", "calc_id=" + calc_id + " norm_system=" + norm_system + " norms_count=" + to_string(length(norms_parsed)))

  return "Нормативная база зафиксирована:\nСистема: " + norm_system + "\nНормы: " + to_string(length(norms_parsed)) + " документа(ов)\n\nРасчёт может продолжаться (жёсткое правило 2 выполнено)."
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 4: LOAD-CASE ENUMERATION (Tier 1 — load-case-enumeration)
// Hard rule: #3 (every load case enumerated before calculation)
// ═══════════════════════════════════════════════════════════════════════

pattern GetDefaultLoadCases(discipline: String, object_type: String) -> String {
  // Returns JSON array of default load cases by discipline
  if discipline == "structural" then {
    return "[{\"case\":\"Собственный вес\",\"type\":\"permanent\",\"source\":\"вес конструкции\"},{\"case\":\"Снеговая нагрузка\",\"type\":\"snow\",\"source\":\"СП 20.13330\"},{\"case\":\"Ветровая нагрузка\",\"type\":\"wind\",\"source\":\"СП 20.13330\"},{\"case\":\"Эксплуатационная\",\"type\":\"operational\",\"source\":\"нормативная\"},{\"case\":\"Аварийная (обрыв связи)\",\"type\":\"emergency\",\"source\":\"СП 20.13330\"}]"
  }
  if discipline == "hydraulic" then {
    return "[{\"case\":\"Рабочее выдвижение\",\"type\":\"operational\",\"source\":\"номинальное\"},{\"case\":\"Рабочее втягивание\",\"type\":\"operational\",\"source\":\"номинальное\"},{\"case\":\"Удержание на весу\",\"type\":\"emergency\",\"source\":\"статический\"},{\"case\":\"Динамический удар\",\"type\":\"emergency\",\"source\":\"аварийный\"},{\"case\":\"Потеря давления\",\"type\":\"emergency\",\"source\":\"отказ насоса\"}]"
  }
  if discipline == "power_electronics" then {
    return "[{\"case\":\"Номинальная мощность\",\"type\":\"operational\",\"source\":\"STC\"},{\"case\":\"Холодный день — пик напряжения\",\"type\":\"environmental\",\"source\":\"V_oc при T_min\"},{\"case\":\"Жаркий день — минимум мощности\",\"type\":\"environmental\",\"source\":\"P_mpp при T_max\"},{\"case\":\"Короткое замыкание\",\"type\":\"emergency\",\"source\":\"защита\"},{\"case\":\"Обрыв цепи\",\"type\":\"emergency\",\"source\":\"отказ\"}]"
  }
  return "[]"
}

pattern SetLoadCases(calc_id: String, discipline: String, load_cases_json: String, input_data_json: String, missing_data: String) -> String {
  // Hard rule 3: every load case enumerated before calculation
  // Immunity gate (naryad #378): approved/archived calculations are immutable
  let gm = GuardMutable(calc_id)
  if gm != "" then { return gm }
  let lc = load_cases_json
  if load_cases_json == "" or load_cases_json == "[]" then { let lc = GetDefaultLoadCases(discipline, "") }

  let lc_parsed = parse_json(lc)
  if length(lc_parsed) == 0 then {
    return "ОШИБКА: Невозможно начать расчёт без перечня расчётных случаев. Укажите нагрузки командой /calc-loadcases."
  }

  // Check for completeness: must have at least permanent + 1 variable + 1 emergency
  let has_permanent = contains(lc, "permanent")
  let has_variable = contains(lc, "snow") or contains(lc, "wind") or contains(lc, "operational")
  let has_emergency = contains(lc, "emergency")
  let completeness = "likely_incomplete"
  if has_permanent and has_variable and has_emergency then { let completeness = "likely_complete" }

  let data_complete = "false"
  if missing_data == "" or missing_data == "[]" then { let data_complete = "true" }

  let _ = db_execute("UPDATE engineering_calculations SET load_cases = ?, input_data = ?, data_complete = ?, missing_data = ?, status = ? WHERE id = ?", [lc, input_data_json, data_complete, missing_data, STATUS_DRAFTED(), calc_id])

  let _ = AuditLog("eng_loadcases", "engineering", "calc_id=" + calc_id + " cases=" + to_string(length(lc_parsed)) + " completeness=" + completeness)

  let mut msg = "Расчётные случаи зафиксированы: " + to_string(length(lc_parsed)) + " случаев.\n"
  let mut msg = msg + "Полнота: " + completeness + "\n"
  if data_complete == "false" then {
    let msg = msg + "\n⚠️ Недостающие данные: " + missing_data + "\n(Жёсткое правило 9: результат зависит от уточнения данных.)"
  }
  return msg
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 5: INDEPENDENT VERIFICATION (Tier 1 — independent-verification)
// Hard rules: #7 (independent method), #8 (dimensional check)
// ═══════════════════════════════════════════════════════════════════════

pattern IndependentVerify(calc_id: String, result_summary: String, discipline: String) -> Dict {
  // Three verification routes (hard rule 7 + 8):
  // 1. Dimensional analysis — ALWAYS mandatory
  // 2. Order-of-magnitude estimate
  // 3. Independent method (discipline-specific)

  // Route 1: Dimensional check
  // Check that result contains proper units (kN, MPa, kW, V, A, bar, L/min)
  let has_force = contains(result_summary, "кН") or contains(result_summary, "kN") or contains(result_summary, "Н/") or contains(result_summary, "N/")
  let has_stress = contains(result_summary, "МПа") or contains(result_summary, "MPa") or contains(result_summary, "Па")
  let has_power = contains(result_summary, "кВт") or contains(result_summary, "kW") or contains(result_summary, "Вт")
  let has_voltage = contains(result_summary, "В") or contains(result_summary, "V")
  let has_pressure = contains(result_summary, "бар") or contains(result_summary, "bar") or contains(result_summary, "МПа")
  let has_flow = contains(result_summary, "л/мин") or contains(result_summary, "L/min")
  let has_dimension = contains(result_summary, "мм") or contains(result_summary, "mm") or contains(result_summary, "м") or contains(result_summary, "m")
  let dimensional_check_ok = has_force or has_stress or has_power or has_voltage or has_pressure or has_flow or has_dimension

  // Route 2: Order-of-magnitude (prompt LLM for sanity check)
  let magnitude_prompt = "Проверь порядок величины результата. Если результат явно нереалистичен (на порядки отличается от ожидаемого), укажи это. Результат: " + result_summary
  let magnitude_check = redact(to_string(TryVal(try call_llm(magnitude_prompt))), "all")
  if to_string(magnitude_check) == "()" then { let magnitude_check = "[оценка недоступна — провайдеры модели не ответили]" }

  // Immunity gate (naryad #378): approved/archived calculations are immutable
  let gm = GuardMutable(calc_id)
  if gm != "" then {
    return { verification_method: "verification blocked", verification_agrees: false, dimensional_check_ok: false, verdict: "blocked_immutable", details: gm }
  }

  // verification_agrees from the REAL Route-2 signal (naryad #378: was hardcoded true,
  // which marked every calculation self_verified regardless of the check outcome).
  // States: agreed | disagreed | unavailable — unavailable is honest, never true.
  let mut verification_state = "agreed"
  if contains(magnitude_check, "недоступна") then { let verification_state = "unavailable" }
  if contains(magnitude_check, "нереалист") or contains(magnitude_check, "на порядк") or contains(magnitude_check, "противореч") or contains(magnitude_check, "ошибоч") then {
    let verification_state = "disagreed"
  }
  let verification_agrees = verification_state == "agreed"

  // Route 3: Independent method — discipline-specific
  let mut independent_method = ""
  if discipline == "structural" then {
    let independent_method = "Сравнение прогиба с допустимым по норме L/n; проверка utilisation ratio ≤ 1.0"
  }
  if discipline == "hydraulic" then {
    let independent_method = "Проверка баланса: F = P × A; энергетический баланс: мощность = давление × расход"
  }
  if discipline == "power_electronics" then {
    let independent_method = "Проверка: P = V × I; тепловой баланс при T_ambient_max; проверка Voc(T_cold) ≤ V_max"
  }

  // Gate: all three must agree for self_verified
  let all_agree = dimensional_check_ok and verification_agrees
  let verdict = STATUS_CALCULATED()
  if all_agree then { let verdict = STATUS_SELF_VERIFIED() }
  let dim_str = "НЕ ПРОЙДЕНА"
  if dimensional_check_ok then { let dim_str = "ПРОЙДЕНА" }
  let details = "Размерностная проверка: " + dim_str + "\n"
  let details = details + "Порядок величины (" + verification_state + "): " + substring(magnitude_check, 0.0, 160.0) + "\n"
  let details = details + "Независимый метод: " + independent_method + "\n"
  let verdict_str = "НЕ верифицирован — требуется доработка"
  if all_agree then { let verdict_str = "self_verified — расчёт может быть передан инженеру" }
  if verification_state == "unavailable" then { let verdict_str = "verification_unavailable — независимая сверка недоступна, self_verified НЕ присвоен" }
  let details = details + "Вердикт: " + verdict_str

  // Update DB
  let va_str = "false"
  if verification_agrees then { let va_str = "true" }
  if verification_state == "unavailable" then { let va_str = "unavailable" }
  let dc_str = "false"
  if dimensional_check_ok then { let dc_str = "true" }
  let _ = db_execute("UPDATE engineering_calculations SET verification_method = ?, verification_agrees = ?, dimensional_check_ok = ?, status = ? WHERE id = ?", [independent_method, va_str, dc_str, verdict, calc_id])

  return {
    verification_method: independent_method,
    verification_agrees: verification_agrees,
    verification_state: verification_state,
    dimensional_check_ok: dimensional_check_ok,
    verdict: verdict,
    details: details
  }
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 6: CALCULATION DOCUMENTATION (Tier 1 — calculation-documentation)
// Hard rules: #1, #5, #9, #10 — final assembly
// ═══════════════════════════════════════════════════════════════════════

pattern AssembleDocumentation(
  calc_id: String,
  discipline: String,
  norm_system: String,
  norms_applied: String,
  load_cases: String,
  input_data: String,
  assumptions: String,
  method: String,
  result_summary: String,
  result_details: String,
  safety_factor: String,
  safety_factor_required: String,
  safety_factor_ok: Bool,
  verdict: String,
  verification_details: String
) -> String {
  // 11-section documented calculation (per calculation-documentation skill)

  let doc = "═══════════════════════════════════════\n"
  let doc = doc + "ИНЖЕНЕРНЫЙ РАСЧЁТ №" + calc_id + "\n"
  let doc = doc + "═══════════════════════════════════════\n\n"

  // Section 1: Disclaimer (top) — hard rule 1
  let doc = doc + DISCLAIMER_TOP() + "\n\n"

  // Section 2: Task description
  let doc = doc + "── ЗАДАЧА ──\n"
  let doc = doc + "Дисциплина: " + DisciplineNameRU(discipline) + "\n\n"

  // Section 3: Normative base — hard rule 2
  let doc = doc + "── НОРМАТИВНАЯ БАЗА ──\n"
  let doc = doc + "Система норм: " + norm_system + "\n"
  let doc = doc + "Применённые нормы:\n" + norms_applied + "\n\n"

  // Section 4: Input data — hard rule 9 (certainty tagging)
  let doc = doc + "── ИСХОДНЫЕ ДАННЫЕ ──\n"
  let doc = doc + input_data + "\n\n"

  // Section 5: Load cases — hard rule 3
  let doc = doc + "── РАСЧЁТНЫЕ СЛУЧАИ ──\n"
  let doc = doc + load_cases + "\n\n"

  // Section 6: Assumptions — hard rule 5 (conservative, explicit)
  let doc = doc + "── ДОПУЩЕНИЯ (консервативные) ──\n"
  let doc = doc + assumptions + "\n\n"

  // Section 7: Method
  let doc = doc + "── МЕТОДИКА ──\n"
  let doc = doc + method + "\n\n"

  // Section 8: Working steps (result details)
  let doc = doc + "── ХОД РАСЧЁТА ──\n"
  let doc = doc + result_details + "\n\n"

  // Section 9: Result + verdict — hard rule 10 (plain)
  let doc = doc + "── РЕЗУЛЬТАТ ──\n"
  let doc = doc + result_summary + "\n"
  let doc = doc + "Запас прочности: " + safety_factor + " (требуемый: " + safety_factor_required + ")\n"
  let sf_str = "НЕТ"
  if safety_factor_ok then { let sf_str = "ДА" }
  let doc = doc + "Запас соответствует норме: " + sf_str + "\n"
  let doc = doc + "\nВЕРДИКТ: " + FormatVerdict(verdict) + "\n\n"

  // Section 10: Verification — hard rules 7, 8
  let doc = doc + "── ВЕРИФИКАЦИЯ ──\n"
  let doc = doc + verification_details + "\n\n"

  // Section 11: Disclaimer (bottom) — hard rule 1
  let doc = doc + DISCLAIMER_BOTTOM()

  // Update DB: status → sent_for_review
  let sf_ok_str = "false"
  if safety_factor_ok then { let sf_ok_str = "true" }
  let _ = db_execute("UPDATE engineering_calculations SET disclaimer_included = ?, status = ?, result_summary = ?, result_details = ?, safety_factor = ?, safety_factor_required = ?, safety_factor_ok = ?, verdict = ?, method = ?, assumptions = ? WHERE id = ?", ["true", STATUS_SENT_FOR_REVIEW(), result_summary, result_details, safety_factor, safety_factor_required, sf_ok_str, verdict, method, assumptions, calc_id])

  return doc
}

pattern DisciplineNameRU(discipline: String) -> String {
  if discipline == "structural" then { return "Строительная механика" }
  if discipline == "hydraulic" then { return "Гидравлика" }
  if discipline == "power_electronics" then { return "Силовая электроника" }
  return discipline
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 7: DISCIPLINE BLOCKS (Tier 2)
// ═══════════════════════════════════════════════════════════════════════

// ── 7a: Structural — Load-Bearing ─────────────────────────────────────
// Checks: ULS (strength, stability, buckling, shear, connections),
//         SLS (deflection, vibration)

pattern StructuralLoadBearing(calc_id: String, query: String, norms: String, load_cases: String) -> Dict {
  // Build structured prompt for LLM with all constraints
  let prompt = "Выполни расчёт несущей способности по предельным состояниям.\n\n"
  let prompt = prompt + "ОБЯЗАТЕЛЬНЫЕ ТРЕБОВАНИЯ:\n"
  let prompt = prompt + "1. Проверь ОБА предельных состояния: ULS (прочность, устойчивость, потеря устойчивости, сдвиг, соединения) и SLS (прогиб, вибрация).\n"
  let prompt = prompt + "2. Для КАЖДОГО элемента — все failure modes: изгиб, осевая сила, потеря устойчивости, сдвиг, местные эффекты, общая устойчивость.\n"
  let prompt = prompt + "3. Для лёгких конструкций: отрыв и потеря устойчивости часто определяют — проверяй в первую очередь.\n"
  let prompt = prompt + "4. Utilisation ratio = demand/capacity. Проходит если ≤ 1.0 для всех проверок.\n"
  let prompt = prompt + "5. Все допущения — консервативные (в сторону запаса). Каждое допущение запиши явно.\n"
  let prompt = prompt + "6. Если конструкция НЕ проходит — скажи это ПРЯМО, без смягчения.\n"
  let prompt = prompt + "7. Фундаменты — вне области (требуется геотехник).\n\n"
  let prompt = prompt + "НОРМЫ:\n" + norms + "\n\n"
  let prompt = prompt + "РАСЧЁТНЫЕ СЛУЧАИ:\n" + load_cases + "\n\n"
  let prompt = prompt + "ЗАДАЧА:\n" + query + "\n\n"
  let prompt = prompt + "Формат результата: JSON с полями result_summary, result_details, safety_factor, safety_factor_required, safety_factor_ok (bool), verdict (passes|fails|conditional|needs_more_data), method, assumptions."

  let llm_result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  let parsed = parse_json(llm_result)

  // Extract with fallbacks
  let result_summary = redact(to_string(json_get(parsed, "result_summary", "Расчёт выполнен, результат в details")), "all")
  let result_details = redact(to_string(json_get(parsed, "result_details", llm_result)), "all")
  let safety_factor = redact(to_string(json_get(parsed, "safety_factor", "N/A")), "all")
  let safety_factor_required = redact(to_string(json_get(parsed, "safety_factor_required", "N/A")), "all")
  let sf_ok_str = redact(to_string(json_get(parsed, "safety_factor_ok", "false")), "all")
  let safety_factor_ok = sf_ok_str == "true" or sf_ok_str == "1"
  let verdict = redact(to_string(json_get(parsed, "verdict", "needs_more_data")), "all")
  let method = redact(to_string(json_get(parsed, "method", "Limit states per СП")), "all")
  let assumptions = redact(to_string(json_get(parsed, "assumptions", "См. ход расчёта")), "all")

  // Update DB
  let sf_ok_db = "false"
  if safety_factor_ok then { let sf_ok_db = "true" }
  let _ = db_execute("UPDATE engineering_calculations SET discipline = ?, method = ?, result_summary = ?, result_details = ?, safety_factor = ?, safety_factor_required = ?, safety_factor_ok = ?, verdict = ?, assumptions = ?, status = ? WHERE id = ?", ["structural", method, result_summary, result_details, safety_factor, safety_factor_required, sf_ok_db, verdict, assumptions, STATUS_CALCULATED(), calc_id])

  return {
    result_summary: result_summary,
    result_details: result_details,
    safety_factor: safety_factor,
    safety_factor_required: safety_factor_required,
    safety_factor_ok: safety_factor_ok,
    verdict: verdict,
    method: method,
    assumptions: assumptions
  }
}

// ── 7b: Structural — Elements Sizing ─────────────────────────────────
// Select from REAL standard section ranges, iterate to find smallest passing

pattern StructuralElementsSizing(calc_id: String, query: String, norms: String, load_cases: String) -> Dict {
  let prompt = "Выполни подбор сечений из стандартного сортамента.\n\n"
  let prompt = prompt + "ОБЯЗАТЕЛЬНЫЕ ТРЕБОВАНИЯ:\n"
  let prompt = prompt + "1. Подбирай ТОЛЬКО из реального сортамента (ГОСТ на прокат, трубы, и т.д.).\n"
  let prompt = prompt + "2. Найди наименьшее проходящее сечение (без избыточного запаса).\n"
  let prompt = prompt + "3. Если ни одно сечение не проходит → «концепцию нужно менять» (скажи прямо).\n"
  let prompt = prompt + "4. Соединения — часть результата (не оставляй без подбора).\n"
  let prompt = prompt + "5. Учти собственный вес (обратная связь для тяжёлых сечений).\n"
  let prompt = prompt + "6. Все допущения — консервативные, каждое записано.\n\n"
  let prompt = prompt + "НОРМЫ:\n" + norms + "\n\n"
  let prompt = prompt + "РАСЧЁТНЫЕ СЛУЧАИ:\n" + load_cases + "\n\n"
  let prompt = prompt + "ЗАДАЧА:\n" + query + "\n\n"
  let prompt = prompt + "Формат: JSON с полями result_summary, result_details, safety_factor, safety_factor_required, safety_factor_ok, verdict, method, assumptions."

  let llm_result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  let parsed = parse_json(llm_result)

  let result_summary = redact(to_string(json_get(parsed, "result_summary", "Подбор сечений выполнен")), "all")
  let result_details = redact(to_string(json_get(parsed, "result_details", llm_result)), "all")
  let safety_factor = redact(to_string(json_get(parsed, "safety_factor", "N/A")), "all")
  let safety_factor_required = redact(to_string(json_get(parsed, "safety_factor_required", "N/A")), "all")
  let sf_ok_str = redact(to_string(json_get(parsed, "safety_factor_ok", "false")), "all")
  let safety_factor_ok = sf_ok_str == "true" or sf_ok_str == "1"
  let verdict = redact(to_string(json_get(parsed, "verdict", "needs_more_data")), "all")
  let method = redact(to_string(json_get(parsed, "method", "Sortament iteration per СП")), "all")
  let assumptions = redact(to_string(json_get(parsed, "assumptions", "См. ход расчёта")), "all")

  let sf_ok_db = "false"
  if safety_factor_ok then { let sf_ok_db = "true" }
  let _ = db_execute("UPDATE engineering_calculations SET discipline = ?, method = ?, result_summary = ?, result_details = ?, safety_factor = ?, safety_factor_required = ?, safety_factor_ok = ?, verdict = ?, assumptions = ?, status = ? WHERE id = ?", ["structural", method, result_summary, result_details, safety_factor, safety_factor_required, sf_ok_db, verdict, assumptions, STATUS_CALCULATED(), calc_id])

  return {
    result_summary: result_summary,
    result_details: result_details,
    safety_factor: safety_factor,
    safety_factor_required: safety_factor_required,
    safety_factor_ok: safety_factor_ok,
    verdict: verdict,
    method: method,
    assumptions: assumptions
  }
}

// ── 7c: Hydraulic — Drive Design ─────────────────────────────────────
// Full chain: F → P → Q → pump → components → holding → safety

pattern HydraulicDriveDesign(calc_id: String, query: String, norms: String, load_cases: String) -> Dict {
  let prompt = "Выполни расчёт гидропривода / гидравлического подъёмника.\n\n"
  let prompt = prompt + "ОБЯЗАТЕЛЬНЫЕ ТРЕБОВАНИЯ:\n"
  let prompt = prompt + "1. Вся цепь: нагрузка → сила → давление → расход → насос → компоненты → удержание → безопасность.\n"
  let prompt = prompt + "2. Удержание на весу — ПАРАНОИДАЛЬНАЯ проверка (неконтролируемый спуск = самый опасный отказ).\n"
  let prompt = prompt + "3. ОБА направления: выдвижение и втягивание (A_bore vs A_bore - A_rod).\n"
  let prompt = prompt + "4. Учти потери давления в линиях.\n"
  let prompt = prompt + "5. Компоненты — только стандартные (из каталогов производителей).\n"
  let prompt = prompt + "6. Цикл нагружения важен для усталости и нагрева.\n"
  let prompt = prompt + "7. Формулы: F = P × A_effective; Q = A × v; P_pump = P_working + ΔP_losses.\n"
  let prompt = prompt + "8. Динамическая сила: F_dyn = m × a (учти инерцию и трение).\n\n"
  let prompt = prompt + "НОРМЫ:\n" + norms + "\n\n"
  let prompt = prompt + "РАСЧЁТНЫЕ СЛУЧАИ:\n" + load_cases + "\n\n"
  let prompt = prompt + "ЗАДАЧА:\n" + query + "\n\n"
  let prompt = prompt + "Формат: JSON с полями result_summary, result_details, safety_factor, safety_factor_required, safety_factor_ok, verdict, method, assumptions."

  let llm_result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  let parsed = parse_json(llm_result)

  let result_summary = redact(to_string(json_get(parsed, "result_summary", "Расчёт гидропривода выполнен")), "all")
  let result_details = redact(to_string(json_get(parsed, "result_details", llm_result)), "all")
  let safety_factor = redact(to_string(json_get(parsed, "safety_factor", "N/A")), "all")
  let safety_factor_required = redact(to_string(json_get(parsed, "safety_factor_required", "N/A")), "all")
  let sf_ok_str = redact(to_string(json_get(parsed, "safety_factor_ok", "false")), "all")
  let safety_factor_ok = sf_ok_str == "true" or sf_ok_str == "1"
  let verdict = redact(to_string(json_get(parsed, "verdict", "needs_more_data")), "all")
  let method = redact(to_string(json_get(parsed, "method", "Hydraulic chain calculation")), "all")
  let assumptions = redact(to_string(json_get(parsed, "assumptions", "См. ход расчёта")), "all")

  let sf_ok_db = "false"
  if safety_factor_ok then { let sf_ok_db = "true" }
  let _ = db_execute("UPDATE engineering_calculations SET discipline = ?, method = ?, result_summary = ?, result_details = ?, safety_factor = ?, safety_factor_required = ?, safety_factor_ok = ?, verdict = ?, assumptions = ?, status = ? WHERE id = ?", ["hydraulic", method, result_summary, result_details, safety_factor, safety_factor_required, sf_ok_db, verdict, assumptions, STATUS_CALCULATED(), calc_id])

  return {
    result_summary: result_summary,
    result_details: result_details,
    safety_factor: safety_factor,
    safety_factor_required: safety_factor_required,
    safety_factor_ok: safety_factor_ok,
    verdict: verdict,
    method: method,
    assumptions: assumptions
  }
}

// ── 7d: Power Electronics — Inverter ─────────────────────────────────
// Rate for PEAKS, cold-day Voc, thermal at T_max, fault analysis

pattern PowerElectronicsInverter(calc_id: String, query: String, norms: String, load_cases: String) -> Dict {
  let prompt = "Выполни расчёт инвертора / силовой электроники для ВИЭ.\n\n"
  let prompt = prompt + "ОБЯЗАТЕЛЬНЫЕ ТРЕБОВАНИЯ:\n"
  let prompt = prompt + "1. Номиналь по ПИКАМ, не по средним. PV cold-day Voc — опасный пик.\n"
  let prompt = prompt + "2. V_oc(T_cold) ≤ V_max_inverter — обязательная проверка.\n"
  let prompt = prompt + "3. Тепловой расчёт при T_ambient_max: T_component < T_limit.\n"
  let prompt = prompt + "4. Анализ аварийных режимов: КЗ, обрыв, островение (anti-islanding).\n"
  let prompt = prompt + "5. Электрический отказ = пожар (тот же параноидальный подход, что в строймеханике).\n"
  let prompt = prompt + "6. Grid-code compliance + anti-islanding для grid-tie.\n"
  let prompt = prompt + "7. Компоненты — только стандартные.\n\n"
  let prompt = prompt + "НОРМЫ:\n" + norms + "\n\n"
  let prompt = prompt + "РАСЧЁТНЫЕ СЛУЧАИ:\n" + load_cases + "\n\n"
  let prompt = prompt + "ЗАДАЧА:\n" + query + "\n\n"
  let prompt = prompt + "Формат: JSON с полями result_summary, result_details, safety_factor, safety_factor_required, safety_factor_ok, verdict, method, assumptions."

  let llm_result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  let parsed = parse_json(llm_result)

  let result_summary = redact(to_string(json_get(parsed, "result_summary", "Расчёт инвертора выполнен")), "all")
  let result_details = redact(to_string(json_get(parsed, "result_details", llm_result)), "all")
  let safety_factor = redact(to_string(json_get(parsed, "safety_factor", "N/A")), "all")
  let safety_factor_required = redact(to_string(json_get(parsed, "safety_factor_required", "N/A")), "all")
  let sf_ok_str = redact(to_string(json_get(parsed, "safety_factor_ok", "false")), "all")
  let safety_factor_ok = sf_ok_str == "true" or sf_ok_str == "1"
  let verdict = redact(to_string(json_get(parsed, "verdict", "needs_more_data")), "all")
  let method = redact(to_string(json_get(parsed, "method", "Power electronics rating")), "all")
  let assumptions = redact(to_string(json_get(parsed, "assumptions", "См. ход расчёта")), "all")

  let sf_ok_db = "false"
  if safety_factor_ok then { let sf_ok_db = "true" }
  let _ = db_execute("UPDATE engineering_calculations SET discipline = ?, method = ?, result_summary = ?, result_details = ?, safety_factor = ?, safety_factor_required = ?, safety_factor_ok = ?, verdict = ?, assumptions = ?, status = ? WHERE id = ?", ["power_electronics", method, result_summary, result_details, safety_factor, safety_factor_required, sf_ok_db, verdict, assumptions, STATUS_CALCULATED(), calc_id])

  return {
    result_summary: result_summary,
    result_details: result_details,
    safety_factor: safety_factor,
    safety_factor_required: safety_factor_required,
    safety_factor_ok: safety_factor_ok,
    verdict: verdict,
    method: method,
    assumptions: assumptions
  }
}

// ── 7e: Power Electronics — Renewable System Matching ────────────────
// Three matching questions: source→converter, converter→load, energy balance

pattern RenewableSystemMatching(calc_id: String, query: String, norms: String, load_cases: String) -> Dict {
  let prompt = "Выполни согласование ВИЭ (ветрогенератор/солнечные панели) с нагрузкой и инвертором.\n\n"
  let prompt = prompt + "ОБЯЗАТЕЛЬНЫЕ ТРЕБОВАНИЯ:\n"
  let prompt = prompt + "1. Три вопроса согласования — ВСЕ должны сойтись:\n"
  let prompt = prompt + "   a) Источник → преобразователь: электрическое согласование при ВСЕХ условиях\n"
  let prompt = prompt + "   b) Преобразователь → нагрузка: соответствие по мощности и напряжению\n"
  let prompt = prompt + "   c) Энергобаланс во времени: Σгенерация ≥ Σпотребление (за цикл)\n"
  let prompt = prompt + "2. PV напряжение РАСТЁТ при падении температуры — классическая ловушка.\n"
  let prompt = prompt + "3. Длина строки ограничена холодным случаем (верх) и горячим (низ):\n"
  let prompt = prompt + "   V_string_cold = N × V_oc(T_cold) ≤ V_max_inverter\n"
  let prompt = prompt + "   V_string_hot = N × V_mppt(T_hot) ≥ V_mppt_floor\n"
  let prompt = prompt + "4. Это согласование СИСТЕМЫ, не номинация УСТРОЙСТВА.\n\n"
  let prompt = prompt + "НОРМЫ:\n" + norms + "\n\n"
  let prompt = prompt + "РАСЧЁТНЫЕ СЛУЧАИ:\n" + load_cases + "\n\n"
  let prompt = prompt + "ЗАДАЧА:\n" + query + "\n\n"
  let prompt = prompt + "Формат: JSON с полями result_summary, result_details, safety_factor, safety_factor_required, safety_factor_ok, verdict, method, assumptions."

  let llm_result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  let parsed = parse_json(llm_result)

  let result_summary = redact(to_string(json_get(parsed, "result_summary", "Согласование ВИЭ выполнено")), "all")
  let result_details = redact(to_string(json_get(parsed, "result_details", llm_result)), "all")
  let safety_factor = redact(to_string(json_get(parsed, "safety_factor", "N/A")), "all")
  let safety_factor_required = redact(to_string(json_get(parsed, "safety_factor_required", "N/A")), "all")
  let sf_ok_str = redact(to_string(json_get(parsed, "safety_factor_ok", "false")), "all")
  let safety_factor_ok = sf_ok_str == "true" or sf_ok_str == "1"
  let verdict = redact(to_string(json_get(parsed, "verdict", "needs_more_data")), "all")
  let method = redact(to_string(json_get(parsed, "method", "Renewable system matching")), "all")
  let assumptions = redact(to_string(json_get(parsed, "assumptions", "См. ход расчёта")), "all")

  let sf_ok_db = "false"
  if safety_factor_ok then { let sf_ok_db = "true" }
  let _ = db_execute("UPDATE engineering_calculations SET discipline = ?, method = ?, result_summary = ?, result_details = ?, safety_factor = ?, safety_factor_required = ?, safety_factor_ok = ?, verdict = ?, assumptions = ?, status = ? WHERE id = ?", ["power_electronics", method, result_summary, result_details, safety_factor, safety_factor_required, sf_ok_db, verdict, assumptions, STATUS_CALCULATED(), calc_id])

  return {
    result_summary: result_summary,
    result_details: result_details,
    safety_factor: safety_factor,
    safety_factor_required: safety_factor_required,
    safety_factor_ok: safety_factor_ok,
    verdict: verdict,
    method: method,
    assumptions: assumptions
  }
}

// ── 7f: Discipline dispatcher ─────────────────────────────────────────

pattern ExecuteDisciplineCalc(calc_id: String, discipline: String, query: String, norms: String, load_cases: String) -> Dict {
  // Determine which Tier 2 skill to invoke based on query content
  let q = lower(query)

  // Structural: check if sizing or load-bearing
  if discipline == "structural" then {
    let is_sizing = contains(q, "подбор") or contains(q, "сечени") or contains(q, "сортамент") or contains(q, "size") or contains(q, "select section")
    if is_sizing then {
      return StructuralElementsSizing(calc_id, query, norms, load_cases)
    }
    return StructuralLoadBearing(calc_id, query, norms, load_cases)
  }

  // Hydraulic
  if discipline == "hydraulic" then {
    return HydraulicDriveDesign(calc_id, query, norms, load_cases)
  }

  // Power electronics: check if matching or inverter
  if discipline == "power_electronics" then {
    let is_matching = contains(q, "согласовани") or contains(q, "подключени") or contains(q, "строк") or contains(q, "matching") or contains(q, "string")
    if is_matching then {
      return RenewableSystemMatching(calc_id, query, norms, load_cases)
    }
    return PowerElectronicsInverter(calc_id, query, norms, load_cases)
  }

  // Fallback — structural load-bearing
  return StructuralLoadBearing(calc_id, query, norms, load_cases)
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 8: SPECIAL TECHNIQUES (Tier 3)
// ═══════════════════════════════════════════════════════════════════════

// ── 8a: Feasibility Estimation ────────────────────────────────────────
// PRECEDES the full pipeline; estimate ≠ calculation

pattern FeasibilityEstimate(discipline: String, query: String) -> Dict {
  let disclaimer = "ОЦЕНКА ОСУЩЕСТВИМОСТИ — это НЕ расчёт. Не может служить основанием для проектного решения."

  let prompt = "Выполни прикидочную оценку осуществимости. Это НЕ расчёт — грубая прикидка порядка величин.\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Оценка ≠ расчёт. Разница никогда не должна размываться.\n"
  let prompt = prompt + "2. Избыточная точность запрещена — не давай много значащих цифр из грубого метода.\n"
  let prompt = prompt + "3. Обязательное сравнение с референсом (известные аналоги).\n"
  let prompt = prompt + "4. Вердикт: feasible | feasible_but_tight | infeasible_as_posed | cannot_tell.\n\n"
  let prompt = prompt + "Дисциплина: " + DisciplineNameRU(discipline) + "\n"
  let prompt = prompt + "Вопрос: " + query + "\n\n"
  let prompt = prompt + "Формат: JSON с полями feasible (bool), verdict (string), details (string)."

  let llm_result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  let parsed = parse_json(llm_result)

  let feasible_str = redact(to_string(json_get(parsed, "feasible", "true")), "all")
  let feasible = feasible_str == "true" or feasible_str == "1"
  let verdict = redact(to_string(json_get(parsed, "verdict", "cannot_tell")), "all")
  let details = redact(disclaimer + "\n\n" + to_string(json_get(parsed, "details", llm_result)), "all")

  return {
    feasible: feasible,
    verdict: verdict,
    details: details
  }
}

// ── 8b: Third-Party Calc Review ──────────────────────────────────────
// Review ≠ approval

pattern ThirdPartyCalcReview(discipline: String, document: String) -> Dict {
  let prompt = "Выполни проверку чужого расчёта (sanity-check).\n\n"
  let prompt = prompt + "ПРАВИЛА:\n"
  let prompt = prompt + "1. Проверка ≠ утверждение. Самое сильное заключение: «грубых ошибок не найдено», НИКОГДА «расчёт верен».\n"
  let prompt = prompt + "2. Выборочная проверка, не переделывание.\n"
  let prompt = prompt + "3. Пропущенный расчётный случай — находка наивысшей ценности.\n"
  let prompt = prompt + "4. Классификация: critical (опасный результат), major (значительная проблема), minor (стоит исправить), note (наблюдение).\n"
  let prompt = prompt + "5. Вне области — отклоняй.\n\n"
  let prompt = prompt + "Дисциплина: " + DisciplineNameRU(discipline) + "\n"
  let prompt = prompt + "Документ для проверки:\n" + document + "\n\n"
  let prompt = prompt + "Формат: JSON с полями findings (JSON array with severity), gross_errors (int), verdict (sound|has_issues|unsound|inconclusive), recommendation (string)."

  let llm_result = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  let parsed = parse_json(llm_result)

  let findings = redact(to_string(json_get(parsed, "findings", "[]")), "all")
  let gross_errors = to_int(to_string(json_get(parsed, "gross_errors", "0")))
  let verdict = redact(to_string(json_get(parsed, "verdict", "inconclusive")), "all")
  let recommendation = redact(to_string(json_get(parsed, "recommendation", "Требуется проверка дипломированным инженером")), "all")

  // Store in design_reviews table
  let _ = db_execute("INSERT INTO design_reviews (discipline, review_type, findings, gross_errors_found, verdict, recommendation, disclaimer_included, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'))", [discipline, "third_party_calc", findings, to_string(gross_errors), verdict, recommendation, "true"])

  return {
    findings: findings,
    gross_errors: gross_errors,
    verdict: verdict,
    recommendation: recommendation
  }
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 9: BOT COMMANDS (8 commands)
// ═══════════════════════════════════════════════════════════════════════

// ── /calc — Create or list calculations ───────────────────────────────
pattern CreateCalculation(discipline: String, title: String, chat_id: String) -> String {
  // Validate discipline
  if discipline != "structural" and discipline != "hydraulic" and discipline != "power_electronics" then {
    return WrapWithDisclaimer("Неизвестная дисциплина: " + discipline + "\n\nДоступные: structural (строймеханика), hydraulic (гидравлика), power_electronics (силовая электроника)")
  }

  // Create calculation in DB
  let calc_id = "eng_" + to_string(sha256(title + to_string(now())))
  let _ = db_execute("INSERT INTO engineering_calculations (id, title, discipline, norm_system, status, disclaimer_included, created_at) VALUES (?, ?, ?, ?, ?, ?, datetime('now'))", [calc_id, title, discipline, "not_set", STATUS_DRAFTED(), "false"])

  let _ = AuditLog("eng_create", "engineering", "calc_id=" + calc_id + " discipline=" + discipline)

  let msg = "Расчёт создан: " + calc_id + "\n"
  let msg = msg + "Дисциплина: " + DisciplineNameRU(discipline) + "\n"
  let msg = msg + "Статус: " + STATUS_DRAFTED() + "\n\n"
  let msg = msg + "Следующие шаги:\n"
  let msg = msg + "1. /calc-norms " + calc_id + " — зафиксировать нормативную базу\n"
  let msg = msg + "2. /calc-loadcases " + calc_id + " — определить расчётные случаи\n"
  let msg = msg + "3. /calc-verify " + calc_id + " — верификация\n"
  let msg = msg + "4. /calc-review " + calc_id + " — передать инженеру"

  return WrapWithDisclaimer(msg)
}

pattern ListCalculations(chat_id: String, limit: Int) -> String {
  let rows = query("SELECT id, title, discipline, status, verdict FROM engineering_calculations ORDER BY created_at DESC LIMIT ?", [to_string(limit)])
  if length(rows) == 0 then {
    return "Нет сохранённых расчётов. Создайте: /calc <дисциплина> <задача>"
  }
  // Format list
  let prompt = "Форматируй список инженерных расчётов для отображения. JSON данные: " + to_string(rows)
  let formatted = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(formatted) == "()" then { let formatted = "[оценка недоступна — провайдеры модели не ответили]" }
  return WrapWithDisclaimer(formatted)
}

// ── /calc-show — Display calculation ─────────────────────────────────
pattern ShowCalculation(calc_id: String) -> String {
  let row = query("SELECT * FROM engineering_calculations WHERE id = ?", [calc_id])
  if length(row) == 0 then {
    return "Расчёт не найден: " + calc_id
  }
  let data = get(row, 0)
  let status = redact(to_string(json_get(data, "status", "unknown")), "all")
  let discipline = redact(to_string(json_get(data, "discipline", "unknown")), "all")
  let verdict = redact(to_string(json_get(data, "verdict", "N/A")), "all")
  let disclaimer = redact(to_string(json_get(data, "disclaimer_included", "false")), "all")

  let msg = "Расчёт: " + calc_id + "\n"
  let msg = msg + "Дисциплина: " + DisciplineNameRU(discipline) + "\n"
  let msg = msg + "Статус: " + status + "\n"
  let msg = msg + "Вердикт: " + FormatVerdict(verdict) + "\n"
  let disclaimer_str = "⚠️ ОТСУТСТВУЕТ"
  if disclaimer == "true" then { let disclaimer_str = "включён" }
  let msg = msg + "Дисклеймер: " +disclaimer_str + "\n\n"
  let msg = msg + "Полные данные:\n" + to_string(data)

  return WrapWithDisclaimer(msg)
}

// ── /eng-score — Department metrics ──────────────────────────────────
pattern EngineeringScore() -> String {
  // Aggregate 90-day metrics
  let total = query("SELECT COUNT(*) as c FROM engineering_calculations WHERE created_at >= datetime('now', '-90 days')", [])
  let verified = query("SELECT COUNT(*) as c FROM engineering_calculations WHERE status IN ('self_verified','sent_for_review','engineer_approved','engineer_corrected') AND created_at >= datetime('now', '-90 days')", [])
  let corrected = query("SELECT COUNT(*) as c FROM engineering_calculations WHERE status = 'engineer_corrected' AND created_at >= datetime('now', '-90 days')", [])
  let dim_ok = query("SELECT COUNT(*) as c FROM engineering_calculations WHERE dimensional_check_ok = 'true' AND created_at >= datetime('now', '-90 days')", [])
  let disclaimer_ok = query("SELECT COUNT(*) as c FROM engineering_calculations WHERE disclaimer_included = 'true' AND created_at >= datetime('now', '-90 days')", [])

  let total_count = to_int(to_string(json_get(get(total, 0), "c", "0")))
  let verified_count = to_int(to_string(json_get(get(verified, 0), "c", "0")))
  let corrected_count = to_int(to_string(json_get(get(corrected, 0), "c", "0")))
  let dim_ok_count = to_int(to_string(json_get(get(dim_ok, 0), "c", "0")))
  let disclaimer_ok_count = to_int(to_string(json_get(get(disclaimer_ok, 0), "c", "0")))

  let correction_rate = 0.0
  if total_count > 0 then { let correction_rate = to_float(to_string(corrected_count)) / to_float(to_string(total_count)) * 100.0 }
  let agreement_rate = 0.0
  if total_count > 0 then { let agreement_rate = to_float(to_string(dim_ok_count)) / to_float(to_string(total_count)) * 100.0 }
  let disclaimer_rate = 0.0
  if total_count > 0 then { let disclaimer_rate = to_float(to_string(disclaimer_ok_count)) / to_float(to_string(total_count)) * 100.0 }

  let msg = "═══ МЕТРИКИ ИНЖЕНЕРНОГО ОТДЕЛА (90 дней) ═══\n\n"
  let msg = msg + "Всего расчётов: " + to_string(total_count) + "\n"
  let msg = msg + "Верифицировано: " + to_string(verified_count) + "\n"
  let msg = msg + "Engineer correction rate: " + substring(to_string(correction_rate), 0.0, 5.0) + "% (цель: ≤25%)\n"
  let msg = msg + "Independent-method agreement: " + substring(to_string(agreement_rate), 0.0, 5.0) + "% (цель: ≥90%)\n"
  let msg = msg + "Disclaimer compliance: " + substring(to_string(disclaimer_rate), 0.0, 5.0) + "% (цель: 100%)\n"

  return msg
}

// ── /eng-archive — Search archive ────────────────────────────────────
pattern SearchArchive(discipline: String, limit: Int) -> String {
  let rows = query("SELECT id, title, discipline, verdict, created_at FROM engineering_calculations WHERE status IN ('engineer_approved','engineer_corrected','archived') ORDER BY created_at DESC LIMIT ?", [to_string(limit)])
  if discipline != "" then { let rows = query("SELECT id, title, discipline, verdict, created_at FROM engineering_calculations WHERE discipline = ? AND status IN ('engineer_approved','engineer_corrected','archived') ORDER BY created_at DESC LIMIT ?", [discipline, to_string(limit)]) }

  if length(rows) == 0 then {
    return "Архив пуст."
  }

  let prompt = "Форматируй список архивных расчётов. JSON: " + to_string(rows)
  let formatted = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(formatted) == "()" then { let formatted = "[оценка недоступна — провайдеры модели не ответили]" }
  return WrapWithDisclaimer(formatted)
}

// ── /calc-review — Engineer review handoff ────────────────────────────
pattern EngineerReview(calc_id: String, engineer_verdict: String, engineer_notes: String) -> String {
  // Gate: calculation must be self_verified
  let row = query("SELECT status FROM engineering_calculations WHERE id = ?", [calc_id])
  if length(row) == 0 then { return "Расчёт не найден: " + calc_id }
  // Immunity gate (naryad #378): approved/archived calculations are immutable
  let gm = GuardMutable(calc_id)
  if gm != "" then { return gm }
  let current_status = redact(to_string(json_get(get(row, 0), "status", "")), "all")
  if current_status != STATUS_SELF_VERIFIED() and current_status != STATUS_SENT_FOR_REVIEW() then {
    return "Расчёт " + calc_id + " в статусе " + current_status + " — не готов для передачи инженеру. Нужен статус self_verified."
  }

  // Record engineer verdict
  let new_status = STATUS_ENGINEER_CORRECTED()
  if engineer_verdict == "approved" then { let new_status = STATUS_ENGINEER_APPROVED() }
  let _ = db_execute("UPDATE engineering_calculations SET engineer_verdict = ?, engineer_notes = ?, status = ? WHERE id = ?", [engineer_verdict, engineer_notes, new_status, calc_id])

  // Create verification record (learning loop input)
  let corrected_bool0 = "false"
  if engineer_verdict == "corrected" then { let corrected_bool0 = "true" }
  let corrected_bool1 = "false"
  if engineer_verdict == "corrected" then { let corrected_bool1 = "true" }
  let _ = db_execute("INSERT INTO engineering_calculation_verifications (calculation_id, engineer_found_error, error_was_substantive, created_at) VALUES (?, ?, ?, datetime('now'))", [calc_id, corrected_bool0, corrected_bool1])

  let msg = "Вердикт инженера записан: " + calc_id + "\n"
  let verdict_str = "ВОЗВРАЩЕНО С ПРАВКАМИ"
  if engineer_verdict == "approved" then { let verdict_str = "УТВЕРЖДЕНО" }
  let msg = msg + "Результат: " +verdict_str + "\n"
  let msg = msg + "Статус: " + new_status + "\n\n"
  let msg = msg + "Запись добавлена в цикл обучения (verification → monthly → quarterly)."

  return msg
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 10: SCHEDULER TASKS (3 tasks)
// ═══════════════════════════════════════════════════════════════════════

// ── Weekly: Thursday 10:00 MSK — engineer correction review ──────────
pattern WeeklyCorrectionReview() -> String {
  let corrected = query("SELECT id, title, discipline, engineer_notes FROM engineering_calculations WHERE status = 'engineer_corrected' AND updated_at >= datetime('now', '-7 days') ORDER BY updated_at DESC", [])

  if length(corrected) == 0 then {
    let _ = AuditLog("eng_weekly", "engineering", "No engineer corrections in past 7 days")
    return "За прошедшую неделю — нет инженерных правок. Отдел работает чисто."
  }

  let msg = "Еженедельный обзор правок инженера (" + to_string(length(corrected)) + " правок за 7 дней):\n\n"
  let prompt = "Проанализируй паттерны в инженерных правках. Классифицируй: missed_load_case, wrong_coefficient, wrong_norm, dimensional_error, wrong_assumption, method_error. Дай 1-2 рекомендации по улучшению. Данные: " + to_string(corrected)
  let analysis = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(analysis) == "()" then { let analysis = "[оценка недоступна — провайдеры модели не ответили]" }

  let _ = AuditLog("eng_weekly", "engineering", "Corrections: " + to_string(length(corrected)) + ", analysis: " + substring(analysis, 0.0, 200.0))

  return msg + analysis
}

// ── Monthly: 1st 10:30 MSK — performance review ─────────────────────
pattern MonthlyPerformanceReview() -> String {
  let score = EngineeringScore()

  let clusters = query("SELECT error_class, COUNT(*) as c FROM engineering_calculation_verifications WHERE created_at >= datetime('now', '-30 days') AND error_was_substantive = 'true' GROUP BY error_class ORDER BY c DESC", [])

  let msg = score + "\n\n── КЛАСТЕРЫ ОШИБОК (30 дней) ──\n"
  let msg = msg + to_string(clusters) + "\n\n"

  let prompt = "На основе метрик и кластеров ошибок, предложи 1-2 конкретных улучшения для инженерного отдела. Метрики: " + score + " Кластеры: " + to_string(clusters)
  let improvements = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(improvements) == "()" then { let improvements = "[оценка недоступна — провайдеры модели не ответили]" }

  // Store monthly review
  let _ = db_execute("INSERT INTO engineering_monthly_reviews (period_start, period_end, calculations_reviewed, improvements_chosen, created_at) VALUES (datetime('now', '-30 days'), datetime('now'), ?, ?, datetime('now'))", [to_string(length(clusters)), improvements])

  let _ = AuditLog("eng_monthly", "engineering", "Monthly review completed")

  return msg + "── РЕКОМЕНДАЦИИ ──\n" + improvements
}

// ── Quarterly: Q-start 11:00 MSK — methodology review ───────────────
pattern QuarterlyMethodologyReview() -> String {
  let prompt = "Выполни квартальный обзор методологии инженерного отдела.\n\n"
  let prompt = prompt + "1. Проверь: не устарели ли применяемые нормы (новые редакции СП/ГОСТ/ПУЭ/IEC)?\n"
  let prompt = prompt + "2. Проанализируй: какие классы ошибок повторяются?\n"
  let prompt = prompt + "3. Оцени: нужны ли обновления skill-файлов?\n"
  let prompt = prompt + "4. Проверь: соблюдается ли психотип (Параноик + Педант)?\n\n"

  let verifications = query("SELECT error_class, COUNT(*) as c FROM engineering_calculation_verifications WHERE created_at >= datetime('now', '-90 days') GROUP BY error_class ORDER BY c DESC", [])
  let prompt = prompt + "Данные за квартал:\n" + to_string(verifications)

  let analysis = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(analysis) == "()" then { let analysis = "[оценка недоступна — провайдеры модели не ответили]" }

  let _ = AuditLog("eng_quarterly", "engineering", "Quarterly methodology review completed")

  return "═══ КВАРТАЛЬНЫЙ ОБЗОР МЕТОДОЛОГИИ ═══\n\n" + analysis
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 11: FULL PIPELINE (for free-text engineering queries)
// ═══════════════════════════════════════════════════════════════════════

pattern FullPipeline(query: String, discipline: String, chat_id: String) -> String {
  // Step 0: Create calculation
  let calc_id = "eng_" + to_string(sha256(query + to_string(now())))

  // Step 1: Optional feasibility estimate (Tier 3)
  let feasibility = FeasibilityEstimate(discipline, query)
  if feasibility.verdict == "infeasible_as_posed" then {
    let _ = AuditLog("eng_infeasible", "engineering", "calc_id=" + calc_id + " — infeasible as posed")
    return WrapWithDisclaimer("ОЦЕНКА ОСУЩЕСТВИМОСТИ: концепция, по-видимому, неосуществима в текущей постановке.\n\n" + feasibility.details + "\n\nТребуется изменение концепции или параметров.")
  }

  // Step 2: Create in DB
  let _ = db_execute("INSERT INTO engineering_calculations (id, title, discipline, status, disclaimer_included, created_at) VALUES (?, ?, ?, ?, ?, datetime('now'))", [calc_id, substring(query, 0.0, 200.0), discipline, STATUS_DRAFTED(), "false"])

  // Step 3: Norm-base fixation (Tier 1, hard rule 2) — norm_system from config switch (naryad #378)
  let norm_system = GetNormSystem()
  let norms = GetDefaultNormsFor(discipline, norm_system)
  let _ = SetNormBase(calc_id, discipline, norm_system, norms)

  // Step 4: Load-case enumeration (Tier 1, hard rule 3)
  let load_cases = GetDefaultLoadCases(discipline, "")
  let _ = SetLoadCases(calc_id, discipline, load_cases, "[]", "")

  // Step 5: Discipline calculation (Tier 2)
  let calc_result = ExecuteDisciplineCalc(calc_id, discipline, query, norms, load_cases)

  // Step 5.5: safety-factor hard gate (naryad #378 — gate was declared but never called).
  // Non-numeric safety_factor ("N/A") — gate not applicable, recorded honestly in audit.
  let sf_num = TryVal(try to_float(calc_result.safety_factor))
  if to_string(sf_num) == "()" then {
    let _ = AuditLog("eng_gate_safety", "engineering", "calc_id=" + calc_id + " safety_factor non-numeric (" + calc_result.safety_factor + ") — gate not applicable")
  } else {
    let sf_gate = EngGateSafetyFactor(calc_result.safety_factor)
    if sf_gate != "PASS" then {
      let _ = AuditLog("eng_gate_safety", "engineering", "calc_id=" + calc_id + " gate=" + sf_gate + " safety_factor=" + calc_result.safety_factor)
      return WrapWithDisclaimer("РАСЧЁТ ОСТАНОВЛЕН гейтом запаса прочности: коэффициент " + calc_result.safety_factor + " ниже кодифицированного минимума.\n\nРасчёт не может быть передан инженеру. Требуется изменение конструкции, материалов или пересчёт с обоснованным коэффициентом запаса.")
    }
  }

  // Step 6: Independent verification (Tier 1, hard rules 7+8)
  let verification = IndependentVerify(calc_id, calc_result.result_summary, discipline)

  // Step 7: Assemble documentation (Tier 1, hard rules 1,5,9,10)
  let doc = AssembleDocumentation(
    calc_id,
    discipline,
    norm_system,
    norms,
    load_cases,
    "[]", // input_data — would be from query parsing
    calc_result.assumptions,
    calc_result.method,
    calc_result.result_summary,
    calc_result.result_details,
    calc_result.safety_factor,
    calc_result.safety_factor_required,
    calc_result.safety_factor_ok,
    calc_result.verdict,
    verification.details
  )

  // Step 8: Record
  let _ = RecordAssistantMessage(chat_id, "engineering", substring(doc, 0.0, 4000.0))
  let _ = AuditLog("eng_pipeline", "engineering", "calc_id=" + calc_id + " discipline=" + discipline + " verdict=" + calc_result.verdict + " verified=" + verification.verdict)

  return doc
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 12: COMMAND ROUTER
// ═══════════════════════════════════════════════════════════════════════

pattern RouteByCommand(parsed: Dict, chat_id: String) -> String {
  // Out-of-scope gate (hard rule 6)
  if parsed.is_out_of_scope then {
    return DeclineOutOfScope(parsed.task_description)
  }

  let cmd = parsed.command

  // /calc — create or list
  if cmd == "calc" then {
    if parsed.discipline == "unknown" then {
      return ListCalculations(chat_id, 10)
    }
    return CreateCalculation(parsed.discipline, parsed.task_description, chat_id)
  }

  // /calc-norms — fix normative base
  if cmd == "norms" then {
    if parsed.calc_id == "" then { return "Укажите ID расчёта: /calc-norms <id>" }
    return SetNormBase(parsed.calc_id, parsed.discipline, GetNormSystem(), "")
  }

  // /calc-loadcases — enumerate load cases
  if cmd == "loadcases" then {
    if parsed.calc_id == "" then { return "Укажите ID расчёта: /calc-loadcases <id>" }
    return SetLoadCases(parsed.calc_id, parsed.discipline, "", "", "")
  }

  // /calc-verify — independent verification
  if cmd == "verify" then {
    if parsed.calc_id == "" then { return "Укажите ID расчёта: /calc-verify <id>" }
    let row = query("SELECT result_summary, discipline FROM engineering_calculations WHERE id = ?", [parsed.calc_id])
    if length(row) == 0 then { return "Расчёт не найден: " + parsed.calc_id }
    let data = get(row, 0)
    let result_summary = redact(to_string(json_get(data, "result_summary", "")), "all")
    let discipline = redact(to_string(json_get(data, "discipline", "structural")), "all")
    let v = IndependentVerify(parsed.calc_id, result_summary, discipline)
    return "Верификация расчёта " + parsed.calc_id + ":\n" + v.details
  }

  // /calc-review — engineer review
  if cmd == "review" then {
    if parsed.calc_id == "" then { return "Укажите ID расчёта: /calc-review <id>" }
    return "Передайте расчёт " + parsed.calc_id + " дипломированному инженеру.\n\nПосле проверки: /calc-review " + parsed.calc_id + " <approved|corrected> <заметки>"
  }

  // /calc-show — display
  if cmd == "show" then {
    if parsed.calc_id == "" then { return "Укажите ID расчёта: /calc-show <id>" }
    return ShowCalculation(parsed.calc_id)
  }

  // /eng-score — metrics
  if cmd == "score" then {
    return EngineeringScore()
  }

  // /eng-archive — search archive
  if cmd == "archive" then {
    return SearchArchive(parsed.discipline, 20)
  }

  // Free-text: run full pipeline
  if parsed.discipline == "unknown" then {
    // Cannot determine discipline — ask user
    return WrapWithDisclaimer("Не удалось определить дисциплину. Уточните:\n• Строительная механика (кровля, теплица, каркас...)\n• Гидравлика (гидропривод, подъёмник...)\n• Силовая электроника (инвертор, солнечные панели...)")
  }

  return FullPipeline(parsed.task_description, parsed.discipline, chat_id)
}

// ═══════════════════════════════════════════════════════════════════════
// SECTION 13: ENTRY POINT (HandleEngineering)
// This is the pattern that app.mlog calls via import dept/engineering
// ═══════════════════════════════════════════════════════════════════════

pattern HandleEngineering(query: String, chat_id: String) -> String {
  let dept = "engineering"
  let _ = AuditLog("dept_entry", dept, "query: " + substring(query, 0, 100))

  // Parse query → discipline + command
  let parsed = ParseEngineeringQuery(query)

  // Route to command handler or full pipeline
  let result = RouteByCommand(parsed, chat_id)

  // Final safety: ensure disclaimer is present (hard rule 1)
  let has_disclaimer = contains(result, "ПРЕДВАРИТЕЛЬНО") or contains(result, "предварительный")
  let output = WrapWithDisclaimer(result)
  if has_disclaimer then { let output = result }

  // ── LLM-Verifier: engineering calculation quality ──
  let engv_resp = TryVal(try call_python("llm_verifier", "score", json_encode([query, output, "Formula correctness: Are engineering formulas and units applied correctly? Safety margins: Are appropriate safety factors included? Unit consistency: Are all values in consistent units throughout?"])))
  if to_string(engv_resp) != "()" and contains(to_string(engv_resp), "error") == false then {
    let engv_parsed = TryVal(try parse_json(engv_resp))
    let engv_score = to_float(TryVal(try json_get(engv_parsed, "result", "0.5")))
    let _ = AuditLog("engineering_verify_score", dept, "score=" + to_string(engv_score))
  }

  let _ = kv_set("last_model_" + dept, "native_call_llm")
  let _ = RecordAssistantMessage(chat_id, dept, substring(output, 0.0, 4000.0))

  return output
}
