// Web: real Tavily + RSS + GDELT via /news/fresh endpoint
pattern ScanWeb(query: String) -> String {
  let body = json_encode({query: query, dept: "lz", limit: 8})
  let resp = TryVal(try http_post("http://127.0.0.1:4000/news/fresh", body, "application/json"))
  if to_string(resp) == "()" then { return "[web scan: proxy unavailable]" }
  let parsed = TryVal(try parse_json(resp))
  if to_string(parsed) == "()" then { return "[web scan: parse error]" }
  return to_string(json_get(parsed, "news", "no results"))
}

// GitHub: real GitHub API via /lz/github-scan endpoint
pattern ScanGitHub(query: String) -> String {
  let body = json_encode({query: query, limit: 5})
  let resp = TryVal(try http_post("http://127.0.0.1:4000/lz/github-scan", body, "application/json"))
  if to_string(resp) == "()" then { return "[github scan: proxy unavailable]" }
  let parsed = TryVal(try parse_json(resp))
  if to_string(parsed) == "()" then { return "[github scan: parse error]" }
  return to_string(parsed)
}

// FO-010: arXiv + HN Algolia + GitHub Search — детерминированные API-источники.
