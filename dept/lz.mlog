// ═══════════════════════════════════════════════════════════════════════
// SEARCH INTEGRATIONS — Tavily + Telegram + Multi-source
// ═══════════════════════════════════════════════════════════════════════

pattern LZTavilySearch(query: String, chat_id: String) -> String {
  // Tavily API for real-time web search
  // office#354: транспорт вынесен в общий паттерн TavilySearch (utils.mlog),
  // прямой вызов api.tavily.com — единственный путь к Tavily на проект.
  // Достижимость сети честно проверяется /lz/diagnose.
  // #427 A.1: внутри тоже чистим префикс — паттерн зовётся и из домен-веток
  // (там уже чистый запрос — идемпотентная чистка без изменений), и из
  // общего пути. В Tavily уходит смысловая часть, не команда.
  let q = LZStripCommand(query)
  if q == "" then { return "[tavily: пустой запрос после снятия префикса — тема не задана]" }
  let response = TavilySearch(q, "lz")
  if response == "()" then { return "[tavily: сеть недоступна или ключ не задан — см. /lz/diagnose]" }
  // #474 A.3: общий бюджетный шов — исчерпание дневного бюджета честно
  // попадает в Live-подсказку, модель не принимает тишину за «данных нет в принципе».
  if response == "(budget)" then { return "[tavily: дневной бюджет Tavily исчерпан — поиск не выполнялся]" }
  // #427 A.2: пустая выдача — не источник, подвал её не покажет (маркер-строка).
  let parsed_resp = TryVal(try parse_json(response))
  if to_string(parsed_resp) != "()" then {
    let results = json_get(parsed_resp, "results")
    if to_string(results) == "()" or length(results) == 0.0 then {
      return "[tavily: релевантных результатов нет]"
    }
  }
  let analysis = redact(to_string(TryVal(try call_llm("Synthesize Tavily results for ЛЗ intelligence: extract key findings, disruption signals, inflection indicators, cross-domain opportunities. Если результаты не относятся к запросу — верни ровно одну строку [tavily: результаты не по теме запроса] без другого текста.", "Запрос: " + q + "\nРезультаты: " + to_string(response)))), "all")
  if to_string(analysis) == "()" then { let analysis = "[оценка недоступна — провайдеры модели не ответили]" }
  let _ = TryVal(try db_execute("INSERT INTO scan_logs (scan_type, sources_queried, artifacts_found) VALUES (?, ?, ?)", ["tavily", "tavily", 5]))
  return analysis
}

// ── TEAM-1 (#480 A.6): навык factpack — разведсводка для коллег ──────
// Облегённая функция ЛЗ (ADR-0016): живой поиск, кэш новостей, темы
// Telegram-мониторов — без 12 гейтов и дисклеймеров полного ответа.
// Тихий по построению: не пишет dialog_history, не шлёт Telegram,
// не зовёт call_llm (стоимость 0 в реестре dept/team.mlog).
// Секции [LIVE]/[NEWS]/[TG] — детерминированные маркеры: ОСП извлекает
// live-часть для гейта актуальности #474 A.2 (TeamExtractSection).
// Гео-дополнение #423 отдел-специалист делает сам — задокументированный
// компромисс ADR-0016 (общий шов — кандидат в рефакторинг TEAM-2).
pattern LZFactpack(question: String) -> String {
  let t = lower(question)
  let mut q = question
  if contains(t, "беларус") or contains(t, "минск") or contains(t, "лукашенко") then {
    let q = question + " Беларусь"
  }
  let mut live_part = ""
  if trim(TavilyKey()) == "" then {
    let live_part = "(живой поиск не выполнен: ключ Tavily не задан)"
  } else {
    let response = TavilySearch(q, "lz")
    if response == "(budget)" then {
      let live_part = "(живой поиск не выполнен: дневной бюджет Tavily исчерпан)"
    } else {
      if response == "()" then {
        let live_part = "(живой поиск не выполнен: сеть Tavily недоступна)"
      } else {
        let block = TavilyFormatBlock(response)
        if block == "" then {
          let live_part = "(живой поиск вернул 0 результатов)"
        } else {
          let live_part = block
        }
      }
    }
  }
  let news_resp = try http_post("http://127.0.0.1:4000/news/fresh", json_encode({query: q, dept: "lz", limit: 5}), "application/json")
  let mut news_part = "(кэш новостей недоступен)"
  if to_string(news_resp) != "()" then {
    let news_parsed = try parse_json(to_string(news_resp))
    if to_string(news_parsed) != "()" then {
      let news_text = redact(to_string(json_get(news_parsed, "news", "")), "all")
      if trim(news_text) == "" then {
        let news_part = "(кэш новостей пуст по теме)"
      } else {
        let news_part = news_text
      }
    }
  }
  let mon_rows = try query("SELECT query FROM lz_monitors WHERE frequency = 'daily' LIMIT 5", [])
  let mut tg_part = "(каналы Telegram: мониторы не настроены или недоступны)"
  if to_string(mon_rows) != "()" and to_string(mon_rows) != "[]" then {
    if length(mon_rows) > 0.0 then {
      let mut topics = ""
      let mut i = 0.0
      while i < length(mon_rows) {
        let row = get(mon_rows, i)
        let topics = topics + to_string(json_get(row, "query", "")) + ", "
        let i = i + 1.0
      }
      let tg_part = "мониторы активны по темам: " + topics + "выжимка — /lz digest"
    }
  }
  let mut fresh_mark = "Свежесть: живых данных нет (причина в секции LIVE) — вероятностные выводы по свежим событиям запрещены"
  if starts_with(trim(live_part), "(") == false and trim(live_part) != "" then {
    let fresh_mark = "Свежесть: живой поиск только что — данные можно считать свежими"
  }
  return "[LIVE]\n" + live_part + "\n[NEWS]\n" + news_part + "\n[TG]\n" + tg_part + "\n" + fresh_mark
}

pattern LZTelegramSearch(query: String, chat_id: String) -> String {
  // Search monitored Telegram channels
  let channels = TryVal(try query("SELECT channel_id, category FROM lz_channels WHERE status = ?", ["active"]))
  if to_string(channels) == "()" then { return "[telegram: нет отслеживаемых каналов — таблица lz_channels пуста или недоступна]" }
  let ch_str = to_string(channels)
  if ch_str == "[]" then { return "[telegram: список каналов пуст, добавь через /lz channel add]" }
  let result = redact(to_string(TryVal(try call_llm("Search Telegram channels for: " + query + "\nMonitored channels: " + ch_str + "\n\nAnalyze posts for: emerging tech signals, insider intel, sentiment shifts, early indicators.", query))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

