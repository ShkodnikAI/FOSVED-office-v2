// ═══════════════════════════════════════════════════════════════════════
// DISCLOSURE
// ═══════════════════════════════════════════════════════════════════════
pattern LZDisclaimer() -> String {
  return "⚠️ ЛЗ: разведка мира, не инвестиционный совет. Disruption alerts требуют ≥3 подтверждений. Negative signals не игнорируются. /lz invest → пересылка в ОСП."
}

// ═══════════════════════════════════════════════════════════════════════
// HARD RULE GATES (8 programmatic gates)
// ═══════════════════════════════════════════════════════════════════════

// Gate 1: Minimum 3 independent confirmations before disruption alert
pattern LZGateConfirmations(artifact_id: Int) -> String {
  let rows = query("SELECT confirmation_count, status FROM knowledge_artifacts WHERE id = ?", [artifact_id])
  if length(rows) == 0 then { return "FAIL: artifact not found" }
  let count = to_float(to_string(json_get(get(rows, 0), "confirmation_count", "0")))
  let status = to_string(json_get(get(rows, 0), "status", ""))
  if status == "confirmed_disruption" then { return "PASS: already confirmed" }
  if count < 3.0 then { return "FAIL: " + to_string(count) + "/3 confirmations" }
  return "PASS: 3+ confirmations reached"
}


// Gate 3: Must not ignore negative signals after initial enthusiasm
pattern LZGateNegativeSignals(artifact_id: Int) -> String {
  let rows = query("SELECT title, hype_cycle_stage, disruption_score FROM knowledge_artifacts WHERE id = ?", [artifact_id])
  if len(rows) == 0 then { return "FAIL: not found" }
  let stage = to_string(json_get(get(rows, 0), "hype_cycle_stage", ""))
  if stage == "peak" then {
    // #556 A.4: вызов через шов LZLlm; NONE — устойчиво («NONE.», «NONE — …»)
    let check = redact(LZLlm("Technology at Peak of Inflated Expectations. Check for negative signals (failed POCs, talent exodus, regulatory blocks, cost overruns). Technology: " + to_string(json_get(get(rows, 0), "title", "")) + ". List any negative signals found or say NONE."), "all")
    if to_string(check) == "()" then { let check = "[оценка недоступна — провайдеры модели не ответили]" }
    if LZNone(check) then { return "PASS: no negative signals at peak" }
    return "WARN: negative signals at peak — " + check
  }
  return "PASS: not at peak stage"
}

// Gate 4: Hype narrative must be verified against actual flows
pattern LZGateHypeVsFlows(technology: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("Compare public narrative about " + technology + " with actual financial/material/talent flows. Are narrative and flows aligned or divergent? Reply ALIGNED or DIVERGENT with brief explanation."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  if starts_with(result, "DIVERGENT") then { return "WARN: narrative diverges from flows — " + result }
  return "PASS: narrative consistent with flows"
}

// Gate 5: Investment implications must be referred to OSP
pattern LZGateOSPReferral(query: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("Does this query involve investment recommendations or portfolio implications? Query: " + query + " Reply YES or NO."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // #556 A.4: устойчивое да — «Yes.», «YES — …» больше не теряются
  if LZYes(result) then {
    // №318: в query — ОДНОСТОРОННИЙ redact-hash секрета (№327/ADR-0161):
    // public-метка (нет private-egress), URL-safe (hex — нет '+'/' ' — не
    // ломается на декоде 0.21 и перекодировке прокси), секрет не светится
    // даже в логах. Таймаут 5с — fire-and-forget: анализ продолжается на
    // сервере, результат приходит владельцу в TG независимо от этого вызова.
    TryVal(try http_post("http://127.0.0.1:10001/osp/analyze?secret=" + redact(env("CRON_SECRET"), "hash_only"), json_encode({source: "lz", query: query, type: "investment_implication"}), "application/json", 5.0))
    // TEAM-3 #482 A.4: алерт ЛЗ дополнительно на доску (видят Эксперт/Финансы/ОСП — не только прямой путь /osp/analyze)
    let _ = TeamPublish("lz", "alert", query, "[]", "ЛЗ: инвестиционная направленность запроса — передан в ОСП на анализ (гейт 5, №318 fire-and-forget)", "", 48.0)
    return "REFERRED: investment query sent to OSP"
  }
  return "PASS: no investment implication"
}

// Gate 6 УДАЛЁН (#446, решение владельца 2026-10-02 — класс B, убрать):
// LZGateEmissionCheck сам недостижим из прода (STRING_ONLY по реестру #449),
// а его мост /osp/cantillon (:4000) никогда не существовал — ошибки глотались.

// Gate 7: Single-tech focus must check competing alternatives
pattern LZGateCompetingCheck(technology: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("Name 2-3 competing alternatives to " + technology + " that solve the same fundamental problem differently. If none exist, reply NONE."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  if LZNone(result) then { return "PASS: no known alternatives" }
  return "PASS: alternatives identified — " + result
}

// Gate 8: Every tracked technology assessed for cross-domain potential
pattern LZGateCrossDomain(technology: String, src_domain: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("Could " + technology + " (currently in " + src_domain + ") have applications in other domains? Name 1-2 cross-domain possibilities or reply NONE."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  if LZNone(result) then { return "PASS: no cross-domain potential identified" }
  return "PASS: cross-domain potential — " + result
}

// ═══════════════════════════════════════════════════════════════════════
// MAIN DISPATCHER
// ═══════════════════════════════════════════════════════════════════════
// ── #427 A.1: чистый текст темы ─────────────────────────────────────────
// После #362 HandleLZ получает ПОЛНЫЙ текст команды с префиксом. Домен-ветки
// выше вырезают префикс substring-ами с захардкоженными смещениями, общий
// путь — нет: в Tavily уходило «/lz новинки GitHub» → выдача про LZ4/lz-string.
// Снимает ведущие /lz или /лз и известную подкоманду диспетчера, если она
// присутствует; возвращает смысловую часть. Идемпотентен: текст без префикса
// возвращается как есть (подрезанные запросы из домен-веток проходят сквозь
// повторную чистку без изменений) — поэтому безопасно применять и в
// LZTavilySearch, и в LZExtractTopic, и в промпте общего пути.
pattern LZStripCommand(text: String) -> String {
  let t = lower(trim(text))
  let mut rest = text
  if starts_with(t, "/lz") or starts_with(t, "/лз") then {
    let rest = substring(text, 3.0, length(text))
  }
  let t2 = lower(trim(rest))
  if t2 == "" then { return "" }
  // первое слово rest — подкоманда диспетчера? (список = ветки HandleLZ выше)
  // Составные «watch add» / «watch remove» — точное двухсловное имя, снимаются
  // целиком, а не пословно.
  let sp = index_of(t2, " ")
  let mut first = t2
  if sp > 0.0 then { let first = substring(t2, 0.0, sp) }
  if starts_with(t2, "watch add") or starts_with(t2, "watch remove") then {
    let first = "watch add"
    if starts_with(t2, "watch remove") then { let first = "watch remove" }
  }
  let is_sub = (first == "politics") or (first == "economics") or (first == "economy") or (first == "event") or (first == "events") or (first == "geopolitics") or (first == "geopol") or (first == "tavily") or (first == "tg") or (first == "telegram") or (first == "digest") or (first == "hype") or (first == "disrupt") or (first == "inflection") or (first == "oob") or (first == "cross-domain") or (first == "watch") or (first == "watch add") or (first == "watch remove") or (first == "watchlist") or (first == "archive") or (first == "deep") or (first == "all") or (first == "score") or (first == "recalibrate") or (first == "leaked") or (first == "dark") or (first == "profile") or (first == "invest") or (first == "github")
  if is_sub then {
    if length(t2) > length(first) then {
      let rest = substring(rest, length(first) + 1.0, length(rest))
    } else {
      let rest = ""
    }
  }
  return trim(rest)
}

pattern HandleLZ(query: String, chat_id: String) -> String {
  let dept = "lz"
  let t = lower(query)
  let disclaimer = LZDisclaimer()

  // ── Domain-specific scans ──
  if starts_with(t, "/lz politics") then {
    let q = substring(query, 12.0, 300.0)
    return disclaimer + "\n" + LZPoliticsScan(q, chat_id)
  }
  if starts_with(t, "/lz economics") or starts_with(t, "/lz economy") then {
    let q = substring(query, 13.0, 300.0)
    return disclaimer + "\n" + LZEconomicsScan(q, chat_id)
  }
  if starts_with(t, "/lz event") then {
    let q = substring(query, 10.0, 300.0)
    return disclaimer + "\n" + LZEventsScan(q, chat_id)
  }
  if starts_with(t, "/lz geopolitics") or starts_with(t, "/lz geopol") then {
    let q = substring(query, 15.0, 300.0)
    return disclaimer + "\n" + LZGeopoliticsScan(q, chat_id)
  }
  // ── Tavily real web search ──
  if starts_with(t, "/lz tavily") then {
    let q = substring(query, 10.0, 300.0)
    return disclaimer + "\n" + LZTavilySearch(q, chat_id)
  }
  // ── Telegram channel search ──
  if starts_with(t, "/lz tg") or starts_with(t, "/lz telegram") then {
    let q = substring(query, 7.0, 300.0)
    return disclaimer + "\n" + LZTelegramSearch(q, chat_id)
  }
  // ── MON-4 (#171): сводка по каналам наблюдения ──
  if starts_with(t, "/lz digest") then {
    let rest = substring(query, 10.0, length(query))
    let hours = trim(rest)
    return LZChannelDigest("[]", hours, chat_id)
  }
  // ── Skill commands ──
  if starts_with(t, "/lz hype") then {
    let q = substring(query, 8.0, 300.0)
    return LZHypeCycleMap(q, chat_id)
  }
  if starts_with(t, "/lz disrupt") then {
    let q = substring(query, 11.0, 300.0)
    return LZDisruptionScore(q, chat_id)
  }
  if starts_with(t, "/lz inflection") then {
    let q = substring(query, 13.0, 300.0)
    return LZInflectionDetect(q, chat_id)
  }
  if starts_with(t, "/lz oob") then {
    let q = substring(query, 7.0, 300.0)
    return LZOrderOfBattle(q, chat_id)
  }
  if starts_with(t, "/lz cross-domain") then {
    let q = substring(query, 15.0, 300.0)
    return LZCrossDomainTransfer(q, chat_id)
  }
  // ── Watchlist ──
  if starts_with(t, "/lz watch add") then {
    let q = substring(query, 13.0, 300.0)
    return LZWatchAdd(q, chat_id)
  }
  if starts_with(t, "/lz watch remove") then {
    let q = substring(query, 16.0, 300.0)
    return LZWatchRemove(q)
  }
  if starts_with(t, "/lz watch") or starts_with(t, "/lz watchlist") then {
    return LZWatchList()
  }
  // ── Archive ──
  if starts_with(t, "/lz archive") then {
    let q = substring(query, 11.0, 300.0)
    return LZArchiveSearch(q)
  }
  // ── Deep scan / research ──
  if starts_with(t, "/lz deep") then {
    let q = substring(query, 8.0, 300.0)
    return LZDeepScan(q, chat_id)
  }
  if starts_with(t, "/lz all") then {
    return LZAllScan(query, chat_id)
  }
  // ── Metrics ──
  if starts_with(t, "/lz score") then { return LZMetricsScore() }
  if starts_with(t, "/lz recalibrate") then { return LZRecalibrate() }
  // ── Tier 3 commands ──
  if starts_with(t, "/lz leaked") then {
    let q = substring(query, 10.0, 300.0)
    return LZLeakedRoadmap(q, chat_id)
  }
  if starts_with(t, "/lz dark") then {
    let q = substring(query, 8.0, 300.0)
    return LZDarkWebResearch(q, chat_id)
  }
  if starts_with(t, "/lz profile") then {
    let q = substring(query, 11.0, 300.0)
    return LZDeepResearcherProfile(q, chat_id)
  }
  // ── #400 A.3: явная пересылка в ОСП по команде (упомянута в дисклеймере) ──
  // Единственный путь пересылки помимо гейта LZGateOSPReferral (A.2):
  // один запрос — максимум одна пересылка. №318: redact-hash секрета,
  // fire-and-forget (таймаут 5с), результат ОСП приходит владельцу отдельно.
  if starts_with(t, "/lz invest") then {
    let q = trim(substring(query, 10.0, length(query)))
    if q == "" then { return disclaimer + "\nИспользование: /lz invest <тема> — явная пересылка запроса в ОСП для инвестиционного анализа." }
    TryVal(try http_post("http://127.0.0.1:10001/osp/analyze?secret=" + redact(env("CRON_SECRET"), "hash_only"), json_encode({source: "lz", query: q, type: "explicit_invest"}), "application/json", 5.0))
    // TEAM-3 #482 A.4: явная пересылка владельцем — тоже на доску
    let _ = TeamPublish("lz", "alert", q, "[]", "ЛЗ: запрос владельца передан в ОСП для инвестиционного анализа (/lz invest)", "", 48.0)
    return disclaimer + "\n🔄 Передано в ОСП для инвестиционного анализа: «" + q + "»"
  }

  // ── #402 A.1: новинки GitHub из LZ Daily (lz_github_updates) ──────────
  // Таблицу пишет LZ Daily (proxy/lz_github.py), раньше не читал никто:
  // grep "FROM lz_github_updates" давал 0 совпадений. Дни — опционально
  // (/lz github 3), дефолт 7, зажим 1..30.
  if starts_with(t, "/lz github") then {
    let rest = trim(substring(query, 10.0, length(query)))
    return disclaimer + "\n" + LZGithubUpdates(rest)
  }

  // ── Domain classification + enriched context ──
  // #427 A.1: во внешний поиск, в извлечение темы, в гейт ОСП и в промпт
  // синтеза уходит чистый текст темы — не команда с префиксом. Случай
  // из наряда: «/lz новинки GitHub» целиком уходил в Tavily → выдача
  // про LZ4/lz-string.
  let topic_query = LZStripCommand(query)
  if topic_query == "" then { return disclaimer + "\nЗадай тему: /lz <тема> или /lz <подкоманда> <аргументы>." }
  let domain = LZClassifyDomain(topic_query)
  let context = BuildLZContext(topic_query, domain, chat_id)

  // Gate 5: ЕДИНСТВЕННЫЙ триггер пересылки в ОСП (#400 A.2): явный YES/NO-гейт
  // LЗGateOSPReferral сам делает fire-and-forget POST /osp/analyze и возвращает
  // "REFERRED..." / "PASS...". Генерирующий промпт больше НЕ просит модель
  // ставить префикс INVEST_REFERRAL (снят #400: модель решала без строгого
  // критерия — «новинки GitHub» улетали в ОСП, ответ ЛЗ выбрасывался).
  let ref = LZGateOSPReferral(topic_query)

  // Для доменов, где важна свежесть (не «вечное» tech-знание) — добираем
  // живой веб-поиск перед синтезом, а не отдаём модель без данных.
  // РАСШИРЕНО (было только geopolitics/politics/events — tech и
  // economics отвечали чистым знанием модели без единого реального
  // источника, что и породило полностью выдуманный отчёт про автопром
  // при реальном запросе владельца). Живой поиск нужен всем пяти
  // доменам, не трём — «вечных» тем в LZ по определению нет, вся суть
  // отдела в свежести.
  let live = "\n\n" + LZTavilySearch(topic_query, chat_id)

  let result = redact(to_string(TryVal(try call_llm("ЛЗ (" + domain + "): работай как разведотдел, не как консультант. Не задавай уточняющих вопросов и не предлагай варианты на выбор — сразу дай оценку на основе того, что реально есть в контексте ниже. Если после этого данных всё равно недостаточно — одной фразой констатируй факт отсутствия данных, без извинений, без эмодзи, без списка вариантов «что я могу сделать».", topic_query + "\nContext: " + context + live))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // TEAM-2 #481 A.3: маркеры ASK — консультации коллег и второй проход;
  // маркеры не доходят владельцу
  let enhanced = TeamSecondPass(dept, topic_query, context, result)
  if enhanced != "" then { let result = enhanced }
  // ── #400 A.1: пересылка — ДОПОЛНЕНИЕ, не замена ──────────────────────
  // Ответ ЛЗ отдаётся владельцу ВСЕГДА; при срабатывании гейта (единственный
  // триггер) — строка-пометка о фоновой пересылке. Ветка «выбросить ответ,
  // вернуть только „Передано в ОСП“» удалена (#400: владелец спрашивал ЛЗ —
  // получал отчёт ОСП; двойная пересылка — гейт + префиксная ветка).
  let mut referral_note = ""
  if starts_with(ref, "REFERRED") then {
    let referral_note = "\n\n🔄 Запрос также передан в ОСП для инвестиционного анализа — ответ придёт отдельным сообщением."
  }

  // ── LLM-Verifier: intelligence quality scoring ──
  let lzv_resp = TryVal(try call_python("llm_verifier", "score", json_encode([query, result, "Source quality: Are claims grounded in verifiable evidence? Analytical depth: Multiple perspectives and second-order effects? Signal vs noise: Distinguishes emerging signals from noise?"])))
  if to_string(lzv_resp) != "()" and contains(to_string(lzv_resp), "error") == false then {
    let lzv_parsed = TryVal(try parse_json(lzv_resp))
    let lzv_score = to_float(TryVal(try json_get(lzv_parsed, "result", "0.5")))
    let _ = AuditLog("lz_verify_score", dept, "score=" + to_string(lzv_score) + " domain=" + domain)
  }

  // Log scan
  let _ = TryVal(try db_execute("INSERT INTO scan_logs (scan_type, sources_queried, artifacts_found) VALUES (?, ?, 1)", ["realtime", domain]))

  return disclaimer + "\n" + result + LZSourcesFooter(context, live) + referral_note
}

// Подвал со списком реально использованных источников. "context" уже
// содержит вывод LZApiScanContext (детерминированный скан arXiv/HN/
// GitHub) — честно отличаем реальную находку от "не нашёл" сообщения.
// "live" — отдельная переменная (Tavily), не часть context, добавлена
// напрямую в промпт модели, проверяем отдельно.
pattern LZSourcesFooter(context: String, live: String) -> String {
  // #427 A.2: подвал показывает источник, только когда его данные реально
  // вошли в ответ, а не когда секция формально присутствует. Маркеры-ошибки
  // и отказы (сеть недоступна, ключ не задан, пустая выдача, «не по теме»,
  // провайдеры молчат) — не источники.
  let live_trim = trim(live)
  let mut lines = ""
  if live_trim != "" and starts_with(live_trim, "[tavily:") == false and starts_with(live_trim, "[оценка недоступна") == false then {
    let lines = lines + "\n· Живой веб-поиск (Tavily)"
  }
  // «APIscan (тема: …):» — маркер успешного скана (подстрока «APIscan:»
  // в нём отсутствует — предсуществующий дефект: при находке источник
  // не показывался вовсе); «APIscan: …» без «(тема» — только отказы,
  // их отсекают условия ниже.
  if (contains(context, "APIscan (тема:") or contains(context, "APIscan:")) and contains(context, "не нашёл релевантных результатов") == false and contains(context, "не удалось выделить английские ключевые слова") == false then {
    let lines = lines + "\n· Детерминированный скан (arXiv/HN/GitHub)"
  }
  if contains(context, "LZ Daily (GitHub)") then {
    let lines = lines + "\n· LZ Daily (GitHub)"
  }
  if length(lines) == 0.0 then { return "" }
  return "\n\n---\n**Источники:**" + lines
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN CLASSIFICATION + CONTEXT BUILDER
// ═══════════════════════════════════════════════════════════════════════
pattern LZClassifyDomain(query: String) -> String {
  // #556: вызов через шов LZLlm (в батарее — стаб)
  let result = redact(LZLlm("Classify this query into exactly one domain: tech, politics, economics, geopolitics, events. Query: " + query + ". Reply with single word only."), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

pattern BuildLZContext(query: String, domain: String, chat_id: String) -> String {
  let kb = LZWorldKB(domain)
  let watch = LZWatchRelevance(query)
  let recent = LZRecentArtifacts(domain, 5.0)
  let scan = LZApiScanContext(query, domain, chat_id)
  // #402 A.2: данные LZ Daily по GitHub — только при GitHub-теме запроса
  return "KB: " + kb + "\nWatch: " + watch + "\nRecent: " + recent + "\n" + scan + LZGithubContextIfRelevant(query) + TeamAskBlock("lz") + TeamBoardBlock("lz")
}

// ── FORGE (#221): детерминированные API-источники в общем пути /lz ──────
// arXiv/HN/GitHub (proxy/lz_sources.py, lz_api_scan) раньше были недостижимы
// из общего пути: контекст собирался только из статичного KB-ярлыка, вотча и
// планового LZ Daily. Домены скана — явное решение наряда A.2, ADR-0003:
// tech (все 3 источника) + economics (arXiv q-fin, HN VC/финтех, GitHub
// финтех-репо); politics/geopolitics/events — источники нерелевантны, там
// живой веб (LZTavilySearch, PR #219). Два класса данных работают
// параллельно и не заменяют друг друга.
pattern LZApiScanContext(query: String, domain: String, chat_id: String) -> String {
  if domain != "tech" and domain != "economics" then { return "" }
  let topic = LZExtractTopic(query)
  if topic == "" then { return "" }
  // Защита от неудачного перевода: если модель-извлекатель не справилась
  // и вернула (или fallback вернул) кириллицу вместо английских ключевых
  // слов — искать этим по arXiv/HN/GitHub бессмысленно, результат будет
  // случайным мусором, выданным за проверенные факты (реальный инцидент:
  // запрос про локальный inference LLM вернул статьи про астрофизику и
  // генерацию изображений). Честно останавливаемся, не ищем вслепую.
  if LZContainsCyrillic(topic) then {
    return "APIscan: не удалось выделить английские ключевые слова для точного скана (извлечение вернуло нелатинский текст) — arXiv/HN/GitHub пропущены, не искали бы по делу"
  }
  let resp = call_python("lz_sources", "lz_api_scan", json_encode([[topic], 6.0, "lz"]))
  if to_string(resp) == "()" then { return "" }
  let parsed = TryVal(try parse_json(resp))
  if to_string(parsed) == "()" then { return "" }
  let text = redact(to_string(json_get(parsed, "result.text", "")), "all")
  if text == "" then {
    return "APIscan: детерминированный скан (arXiv/HN/GitHub) не нашёл релевантных результатов по теме «" + topic + "»"
  }
  return "APIscan (тема: " + topic + "):\n" + text
}

// ── #402: чтение lz_github_updates (пишется LZ Daily, proxy/lz_github.py) ──
// Ссылки НЕ выдумываются: они детерминированно выводятся из реального поля
// channel_name (owner/repo из записи GitHub API), это данные, не генерация.
pattern LZGithubUpdates(days_text: String) -> String {
  let mut d = to_float(days_text)
  if d <= 0.0 then { let d = 7.0 }
  if d > 30.0 then { let d = 30.0 }
  let ds = to_string(to_int(d))
  let rows = query("SELECT update_id, channel_name, text, date FROM lz_github_updates WHERE date > datetime('now', '-' || ?1 || ' days') ORDER BY date DESC LIMIT 40", [ds])
  if to_string(rows) == "()" or length(rows) == 0.0 then {
    return "LZ Daily за " + ds + " дн. ничего не собрал — в lz_github_updates записей за период нет."
  }
  let mut releases = ""
  let mut repos = ""
  each row in rows {
    let uid = to_string(json_get(row, "update_id", ""))
    let name = redact(to_string(json_get(row, "channel_name", "")), "all")
    let txt = redact(substring(to_string(json_get(row, "text", "")), 0.0, 200.0), "all")
    let day = substring(to_string(json_get(row, "date", "")), 0.0, 10.0)
    if starts_with(uid, "gh:repo:") then {
      let repos = repos + "· [" + name + "](https://github.com/" + name + ") — " + txt + " (" + day + ")\n"
    } else {
      let releases = releases + "· [" + name + "](https://github.com/" + name + ") — релиз: " + txt + " (" + day + ")\n"
    }
  }
  let mut out = "**Новинки GitHub (LZ Daily, " + ds + " дн.):**\n"
  if releases != "" then { let out = out + "\n**Релизы:**\n" + releases }
  if repos != "" then { let out = out + "\n**Новые репозитории:**\n" + repos }
  // Краткий синтез ЛЗ ПОВЕРХ реальных записей; провайдеры недоступны —
  // честный листинг без выдумок (TryVal-грейсфул).
  let synth_src = substring(out, 0.0, 4000.0)
  let synth = redact(to_string(TryVal(try call_llm("Синтезируй краткую выжимку (до 7 пунктов, без новых фактов) из этих записей LZ Daily по GitHub. Используй ТОЛЬКО приведённые записи — то, чего нет в записях, не упоминай.\n\nЗаписи:\n" + synth_src))), "all")
  if to_string(synth) != "()" and length(synth) > 0.0 and contains(synth, "оценка недоступна") == false then {
    let out = out + "\n**Синтез ЛЗ (только по записям выше):**\n" + synth
  }
  return out
}

// A.2: подмешивание в свободный запрос — только при GitHub-теме, с лимитом
// объёма. Маркер "LZ Daily (GitHub)" читает LZSourcesFooter (A.3).
pattern LZGithubContextIfRelevant(query: String) -> String {
  let t = lower(query)
  if contains(t, "github") == false and contains(t, "гитхаб") == false and contains(t, "гит хаб") == false and contains(t, "репозитор") == false and contains(t, "релиз") == false then {
    return ""
  }
  let rows = query("SELECT update_id, channel_name, text, date FROM lz_github_updates ORDER BY date DESC LIMIT 12", [])
  if to_string(rows) == "()" or length(rows) == 0.0 then { return "" }
  let mut out = "LZ Daily (GitHub) — последние реальные записи:\n"
  each row in rows {
    let uid = to_string(json_get(row, "update_id", ""))
    let name = redact(to_string(json_get(row, "channel_name", "")), "all")
    let txt = redact(substring(to_string(json_get(row, "text", "")), 0.0, 150.0), "all")
    let day = substring(to_string(json_get(row, "date", "")), 0.0, 10.0)
    let kind = "релиз"
    if starts_with(uid, "gh:repo:") then { let kind = "новый репозиторий" }
    let out = out + "- " + name + " (" + kind + ", " + day + "): " + txt + "\n"
  }
  return "\n" + out
}

pattern LZContainsCyrillic(s: String) -> Bool {
  let letters = ["а","б","в","г","д","е","ж","з","и","й","к","л","м","н","о","п","р","с","т","у","ф","х","ц","ч","ш","щ","ъ","ы","ь","э","ю","я"]
  let low = lower(s)
  let mut found = false
  each ch in letters {
    if contains(low, ch) then { let found = true }
  }
  return found
}

// Тема для API-скана: короткий набор английских ключевых слов из свободного
// текста запроса (arXiv/HN/GitHub плохо ищут по длинной русской фразе).
// Fallback — усечённый исходный запрос: источники честно вернут пусто и
// LZApiScanContext отразит это, молчаливой подмены данных нет.
pattern LZExtractTopic(query: String) -> String {
  // #427 A.1: во внешний скан уходит чистая тема — команда-префикс
  // здесь мусор (выдача по «/lz …» шла про библиотеки сжатия).
  let q = LZStripCommand(query)
  let result = redact(to_string(TryVal(try call_llm("Extract 2-4 English search keywords from the query below for arXiv/HackerNews/GitHub search. Reply with the keywords separated by spaces, nothing else. Query: " + substring(q, 0.0, 400.0)))), "all")
  if to_string(result) == "()" then { return substring(q, 0.0, 120.0) }
  return substring(result, 0.0, 120.0)
}

pattern LZWorldKB(domain: String) -> String {
  let tech = "Spheres: Computational·Биотех·Energy·Materials·Военные·Transport·Comms·FinTech·Robotics·Climate"
  let politics = "Spheres: Геополитические сдвиги·Выборы·Санкции·Конфликты·Кибервойна·Ядерная политика"
  let economics = "Spheres: Макро·Монетарная·Фискальная·Валютные·Товарные·Кризисные сигналы·РФ специфика"
  let events = "Spheres: ЧС·Теракты·Протесты·Политкризисы·Пандемии·Корпсобытия·Научные прорывы"
  let geopol = "Spheres: Сферы влияния·Военные альянсы·Энергетическая геополитика·Tech sovereignty·Sanctions regimes"
  if domain == "tech" then { return tech }
  if domain == "politics" then { return politics }
  if domain == "economics" then { return economics }
  if domain == "events" then { return events }
  if domain == "geopolitics" then { return geopol }
  return tech + " | " + politics + " | " + economics
}

pattern LoadLZSkills(query: String, domain: String) -> String {
  // Core skills always loaded
  let core = "hype-cycle-mapping, disruption-scoring, inflection-detection, technology-OOB, cross-domain-transfer"
  let domain_skills = ""
  if domain == "tech" then { let domain_skills = "patent-prosecution, talent-flow-tracking, vc-tracking, competing-alternatives" }
  if domain == "politics" then { let domain_skills = "cantillon(inject), narrative-vs-flows(inject), cycle-position(inject), iw-watchlist(inject)" }
  if domain == "economics" then { let domain_skills = "macro-regime-id(inject), cross-asset-divergence(inject), cashflow-forecasting(inject), cantillon(inject)" }
  if domain == "events" then { let domain_skills = "domain-rapid-entry(inject), failure-modes-mapping(inject), adjacent-field-cross-check(inject), iw-watchlist(inject)" }
  // Tier 3: loaded on demand only
  let tier3 = "leaked-roadmap-analysis, dark-web-tech-research, deep-researcher-profiling (owner-approved only)"
  return "Core[" + core + "] Domain[" + domain_skills + "] Tier3[" + tier3 + "]"
}

// ═══════════════════════════════════════════════════════════════════════
// DATA INTEGRITY HELPERS (#556) — адресация по id, форматы ответов модели,
// устойчивый да/нет, идемпотентная миграция данных. Предусловие #553–#555:
// новые механики (буферы, триаж, провенанс, независимость подтверждений)
// сюда НЕ входят. Шов LLM-вызовов LZLlm определён в app-слое (app.mlog):
// импортированные определения сильнее локальных, нативы не перекрываются —
// проверено пробой bin/mlog перед нарядом.
// ═══════════════════════════════════════════════════════════════════════

// Нормализация названия (#556 A.1): lower, trim, схлопнутые пробелы.
// replace заменяет все вхождения: 3 прохода схлопывают серии до 16 пробелов —
// для названий артефактов достаточно. Сравнение держится в mlog, а не в SQL:
// SQLite lower() понимает только ASCII, кириллические названия не матчились бы.
pattern LZNormTitle(title: String) -> String {
  let t = lower(trim(to_string(title)))
  let a = replace(t, "  ", " ")
  let b = replace(a, "  ", " ")
  return replace(b, "  ", " ")
}

// Адресация артефакта (#556 A.1): точное совпадение нормализованного названия
// и домена. Нет записи — создать и вернуть новый id. Все UPDATE по
// knowledge_artifacts и tracked_technologies — только по id: обновление по
// подстроке названия одной командой меняло все похожие записи («AI» задевало
// «AI chips» и «OpenAI»).
pattern LZArtifactId(title: String, domain: String) -> Float {
  let nt = LZNormTitle(title)
  let dom = trim(to_string(domain))
  let rows = query("SELECT id, title FROM knowledge_artifacts WHERE domain = ? ORDER BY id", [dom])
  let mut found = -1.0
  each r in rows {
    if found < 0.0 then {
      if LZNormTitle(to_string(json_get(r, "title", ""))) == nt then {
        let found = to_float(json_get(r, "id", "0"))
      }
    }
  }
  if found > 0.0 then { return found }
  db_execute("INSERT INTO knowledge_artifacts (title, domain, source, source_tier, status) VALUES (?, ?, 'lz', 2, 'tracking')", [trim(to_string(title)), dom])
  let created = query("SELECT id FROM knowledge_artifacts WHERE domain = ? ORDER BY id DESC LIMIT 1", [dom])
  let new_id = to_float(json_get(get(created, 0), "id", "0"))
  // #553: домен на создании — значение чистого правила, не LLM
  let _ = LZProvRule(new_id, "domain", "LZClassifyDomain")
  return new_id
}

// ── Провенанс LLM-полей (#553): записывается В МОМЕНТ записи значения ──
// Формат по наряду: поле -> provider/model/params/recorded_at/via — для
// суждений модели; поле -> rule — для значений чистых правил. JSON строится
// на стороне SQL (json_object): ключи-поля бывают зарезервированными
// словами mlog (domain, rule — проба 553b, двойное вложение), и скобки
// в mlog-литералах не нужны вовсе. provider/model — из env; не заданы —
// честное unrecorded, не выдуманное имя. Температура в mlog-слое не видна
// (ставится proxy per-dept) — unrecorded, не выдуманное число.
pattern LZProvRecord(artifact_id: Float, field: String, via: String) -> String {
  let prov = env_or("METALOGOS_LLM_PROVIDER", "unrecorded")
  let model = env_or("METALOGOS_LLM_MODEL", "unrecorded")
  db_execute("UPDATE knowledge_artifacts SET provenance = json_set(COALESCE(provenance, '{}'), ?, json_object('provider', ?, 'model', ?, 'params', json_object('temperature', 'unrecorded'), 'recorded_at', datetime('now'), 'via', ?)) WHERE id = ?", ["$." + field, prov, model, via, artifact_id])
  return "ok"
}

pattern LZProvRule(artifact_id: Float, field: String, rule_name: String) -> String {
  db_execute("UPDATE knowledge_artifacts SET provenance = json_set(COALESCE(provenance, '{}'), ?, json_object('rule', ?)) WHERE id = ?", ["$." + field, rule_name, artifact_id])
  return "ok"
}

// Строка tracked_technologies артефакта (#556 A.1): создаётся при первой
// записи со скором; до #556 строк никто не создавал и все UPDATE шли в пустоту.
pattern LZTechRowId(artifact_id: Float, technology: String) -> Float {
  let rows = query("SELECT id FROM tracked_technologies WHERE artifact_id = ? ORDER BY id LIMIT 1", [artifact_id])
  if length(rows) > 0.0 then { return to_float(json_get(get(rows, 0), "id", "0")) }
  db_execute("INSERT INTO tracked_technologies (artifact_id, technology_name) VALUES (?, ?)", [artifact_id, trim(to_string(technology))])
  let created = query("SELECT id FROM tracked_technologies WHERE artifact_id = ? ORDER BY id DESC LIMIT 1", [artifact_id])
  return to_float(json_get(get(created, 0), "id", "0"))
}

// Стадия хайпа (#556 A.2): код из первой строки вида STAGE: <code>.
// Не распознано — пустая строка: стадия в базе не меняется, владельцу —
// пометка в ответе. В hype_cycle_stage пишется только код, полный текст
// ответа модели остаётся в ответе владельцу.
pattern LZStageFromText(text: String) -> String {
  let t = trim(to_string(text))
  if starts_with(upper(t), "STAGE:") then {
    let rest_raw = substring(t, 6.0, length(t))
    let nl = index_of(rest_raw, "\n")
    let mut line = rest_raw
    if nl >= 0.0 then { let line = substring(rest_raw, 0.0, nl) }
    let code = lower(trim(line))
    if code == "trigger" then { return "trigger" }
    if code == "peak" then { return "peak" }
    if code == "trough" then { return "trough" }
    if code == "slope" then { return "slope" }
    if code == "plateau" then { return "plateau" }
  }
  return ""
}

// Скор прорыва (#556 A.3): из строки SCORES: 1y=<0-100> 3y=<0-100> 5y=<0-100>
// 10y=<0-100>. Возвращает долю 0-1 или -1 — не распознано, значения не менять.
// to_float_or вместо to_float: на нечисловом хвосте to_float бросает
// исключение (№514), а мусорный ответ модели не должен ронять навык.
pattern LZScoreFor(text: String, horizon: String) -> Float {
  let t = to_string(text)
  let si = index_of(t, "SCORES:")
  if si < 0.0 then { return -1.0 }
  let tail = trim(substring(t, si + 7.0, length(t)))
  let nl = index_of(tail, "\n")
  let mut line = tail
  if nl >= 0.0 then { let line = substring(tail, 0.0, nl) }
  let toks = split(line, " ")
  let mut found = -1.0
  each tok in toks {
    if found < 0.0 then {
      let s = trim(to_string(tok))
      let eq = index_of(s, "=")
      if eq > 0.0 then {
        let key = lower(trim(substring(s, 0.0, eq)))
        if key == horizon then {
          let val_raw = trim(substring(s, eq + 1.0, length(s)))
          let v = to_float_or(val_raw, -1.0)
          if v >= 0.0 and v <= 100.0 then { let found = v / 100.0 }
        }
      }
    }
  }
  return found
}

// Устойчивый да/нет (#556 A.4): после trim и upper ответ начинается с YES
// или ДА. Раньше строгое сравнение с "YES" теряло «Yes.», «YES — …», «да» —
// инфлекшн-алерт в ОСП не уходил.
pattern LZYes(text: String) -> Bool {
  let t = upper(trim(to_string(text)))
  if starts_with(t, "YES") then { return true }
  if starts_with(t, "ДА") then { return true }
  return false
}

// Аналог для NONE (#556 A.4): «NONE.», «NONE — …» распознаются.
pattern LZNone(text: String) -> Bool {
  let t = upper(trim(to_string(text)))
  return starts_with(t, "NONE")
}

// Миграция данных (#556 A.5) — идемпотентна, вызывается из InitDB (app.mlog)
// при каждом старте, изменения сами себя не повторяют. Ничего не удаляет
// (правило офиса): длинные стадии — разобрать первую строку по A.2 или NULL;
// дубли по нормализованному названию и домену — keeper с минимальным id,
// updated_at keeper'а — максимум группы, остальные — статус archived.
pattern LZDataMaintain() -> String {
  // шаг 1а: длинные стадии с корректной первой строкой STAGE: <code> — разобрать;
  // #553: перезапись значения правилом — провенанс rule в том же UPDATE
  db_execute("UPDATE knowledge_artifacts SET hype_cycle_stage = lower(trim(substr(hype_cycle_stage, 8, instr(substr(hype_cycle_stage, 8) || char(10), char(10)) - 1))), provenance = json_set(COALESCE(provenance, '{}'), '$.hype_cycle_stage', json_object('rule', 'LZDataMaintain:STAGE-parse')) WHERE length(hype_cycle_stage) > 12 AND upper(substr(hype_cycle_stage, 1, 6)) = 'STAGE:' AND lower(trim(substr(hype_cycle_stage, 8, instr(substr(hype_cycle_stage, 8) || char(10), char(10)) - 1))) IN ('trigger', 'peak', 'trough', 'slope', 'plateau')", [])
  // шаг 1б: остальные длинные (мусор «весь текст ответа») — NULL
  let junk = query("SELECT COUNT(*) AS c FROM knowledge_artifacts WHERE length(hype_cycle_stage) > 12", [])
  db_execute("UPDATE knowledge_artifacts SET hype_cycle_stage = NULL WHERE length(hype_cycle_stage) > 12", [])
  let n_nulled = to_float(json_get(get(junk, 0), "c", "0"))
  // шаг 2: дубли — keeper = минимальный id, дубликаты — archived.
  // Archived-строки исключены: повторный запуск не переархивирует и не растит счётчик.
  let rows = query("SELECT id, title, domain, updated_at FROM knowledge_artifacts WHERE status != 'archived' ORDER BY id", [])
  let mut seen = "\n"
  let mut archived = 0.0
  each r in rows {
    let rid = to_float(json_get(r, "id", "0"))
    let dom = trim(to_string(json_get(r, "domain", "")))
    let nt = LZNormTitle(to_string(json_get(r, "title", "")))
    let key = dom + "||" + nt
    if contains(seen, key + "\n") then {
      let earlier = query("SELECT id, title FROM knowledge_artifacts WHERE id < ? AND domain = ? AND status != 'archived' ORDER BY id", [rid, dom])
      let mut dup = false
      each e in earlier {
        if dup == false then {
          if LZNormTitle(to_string(json_get(e, "title", ""))) == nt then { let dup = true }
        }
      }
      if dup then {
        db_execute("UPDATE knowledge_artifacts SET status = 'archived' WHERE id = ?", [rid])
        let dupe_upd = to_string(json_get(r, "updated_at", ""))
        each e2 in earlier {
          if LZNormTitle(to_string(json_get(e2, "title", ""))) == nt then {
            db_execute("UPDATE knowledge_artifacts SET updated_at = MAX(COALESCE(updated_at, ''), ?) WHERE id = ?", [dupe_upd, to_float(json_get(e2, "id", "0"))])
          }
        }
        let archived = archived + 1.0
      }
    }
    let seen = seen + key + "\n"
  }
  return "stages_nulled=" + to_string(n_nulled) + " dupes_archived=" + to_string(archived)
}

// ═══════════════════════════════════════════════════════════════════════
// CORE SKILLS (5) — native call_llm implementations
// ═══════════════════════════════════════════════════════════════════════

// Skill 1: hype-cycle-mapping
pattern LZHypeCycleMap(technology: String, chat_id: String) -> String {
  // #556 A.2: добавлено требование формата первой строки — смысловая часть промпта не менялась
  let result = redact(LZLlm("HYPE CYCLE MAPPING for: " + technology + "\n\nClassify onto Gartner hype cycle:\n1. Innovation Trigger — breakthrough generates attention\n2. Peak of Inflated Expectations — overpromotion\n3. Trough of Disillusionment — expectations correct\n4. Slope of Enlightenment — practical use emerges\n5. Plateau of Productivity — mainstream adoption\n\nFIRST LINE of the reply MUST be exactly: STAGE: <trigger|peak|trough|slope|plateau>\nThen provide: stage, evidence, timeline_to_next_stage, investment_implication (buy/sell/wait)"), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // #556 A.1/A.2: адресация по id; в базе — только код из 5 значений,
  // полный текст ответа остаётся владельцу; не распознано — стадия не меняется
  let domain = LZClassifyDomain(technology)
  let aid = LZArtifactId(technology, domain)
  let stage = LZStageFromText(result)
  let mut stage_note = ""
  if stage == "" then { let stage_note = "\n⚠️ Стадия не распознана — значение в базе не менялось" }
  if stage != "" then {
    db_execute("UPDATE knowledge_artifacts SET hype_cycle_stage = ?, updated_at = datetime('now') WHERE id = ?", [stage, aid])
    // #553: стадия — суждение модели, провенанс в момент записи
    let _ = LZProvRecord(aid, "hype_cycle_stage", "LZLlm")
    // #565 A.1: стадия — грейдимый ключ; сверка — ежемесячный re-scoring (устав Scheduler)
    db_execute("INSERT INTO prediction_keys (artifact_id, kind, claim, verify_source, due_at) VALUES (?, 'hype_stage', ?, 'rescore:monthly', datetime('now', '+30 days'))", [aid, "hype_stage=" + stage])
  }
  // Gate 3: Check negative signals at peak — настоящий id артефакта (#556 A.4,
  // раньше LZGateNegativeSignals(0) — запрос WHERE id = 0, всегда FAIL: not found)
  let neg_check = LZGateNegativeSignals(aid)
  // Gate 4: Verify hype vs flows
  let flow_check = LZGateHypeVsFlows(technology)
  return "📊 Hype Cycle: " + technology + "\n" + result + "\n" + neg_check + "\n" + flow_check + stage_note
}

// Skill 2: disruption-scoring
pattern LZDisruptionScore(technology: String, chat_id: String) -> String {
  // #556 A.3: добавлено требование строки SCORES — смысловая часть промпта не менялась
  let result = redact(LZLlm("DISRUPTION SCORING for: " + technology + "\n\nEvaluate 5 components (0-100 each):\n1. Performance ratio vs incumbent\n2. Cost trajectory\n3. Patent activity concentration\n4. Talent flow signal\n5. VC investment patterns\n\nCompute weighted disruption probability at horizons: 1y, 3y, 5y, 10y.\nStatus: tracking | hot | confirmed_disruption | cooled | failed\n\nFIRST LINE of the reply MUST be exactly: SCORES: 1y=<0-100> 3y=<0-100> 5y=<0-100> 10y=<0-100>"), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // #556 A.1/A.3: скоры — из ответа модели (доли 0-1), а не жёсткие нули;
  // в knowledge_artifacts.disruption_score — горизонт 3y; строка
  // tracked_technologies создаётся при первой записи; не распознано — не менять
  let domain = LZClassifyDomain(technology)
  let aid = LZArtifactId(technology, domain)
  let s1 = LZScoreFor(result, "1y")
  let s3 = LZScoreFor(result, "3y")
  let s5 = LZScoreFor(result, "5y")
  let s10 = LZScoreFor(result, "10y")
  let mut score_note = ""
  if s1 < 0.0 or s3 < 0.0 or s5 < 0.0 or s10 < 0.0 then {
    let score_note = "\n⚠️ Скор прорыва не распознан — значения в базе не менялись"
  }
  if s1 >= 0.0 and s3 >= 0.0 and s5 >= 0.0 and s10 >= 0.0 then {
    let tid = LZTechRowId(aid, technology)
    db_execute("UPDATE tracked_technologies SET disruption_1y = ?, disruption_3y = ?, disruption_5y = ?, disruption_10y = ?, updated_at = datetime('now') WHERE id = ?", [s1, s3, s5, s10, tid])
    db_execute("UPDATE knowledge_artifacts SET disruption_score = ?, last_scored_at = datetime('now'), updated_at = datetime('now') WHERE id = ?", [s3, aid])
    // #553: скор — суждение модели, провенанс в момент записи
    let _ = LZProvRecord(aid, "disruption_score", "LZLlm")
    // #565 A.1: предсказание = грейдимый ключ (горизонт 3y — он пишется в артефакт)
    db_execute("INSERT INTO prediction_keys (artifact_id, kind, claim, verify_source, due_at) VALUES (?, 'disruption_score', ?, 'rescore:monthly', datetime('now', '+1095 days'))", [aid, "disruption_score(3y)=" + to_string(s3)])
  }
  // Gate 7: Check competing alternatives
  let alt_check = LZGateCompetingCheck(technology)
  // Gate 8: Cross-domain potential
  let cross_check = LZGateCrossDomain(technology, "tech")
  return "🎯 Disruption Score: " + technology + "\n" + result + "\n" + alt_check + "\n" + cross_check + score_note
}

// Skill 3: inflection-detection
pattern LZInflectionDetect(technology: String, chat_id: String) -> String {
  let result = redact(LZLlm("INFLECTION DETECTION for: " + technology + "\n\nWatch for signals:\n1. First non-academic deployments\n2. Regulatory attention signals\n3. Corporate VC entry\n4. Supply chain emergence\n5. Technical standards formation\n6. Talent concentration shift\n\nIs this technology at inflection point? Provide evidence and confidence level."), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // If inflection detected, escalate to hot
  let check = redact(LZLlm("Is this technology at inflection? Reply YES or NO. Analysis: " + result), "all")
  if to_string(check) == "()" then { let check = "[оценка недоступна — провайдеры модели не ответили]" }
  // #556 A.4: устойчивый да/нет — «Yes.», «YES — …», «да» срабатывают
  // (раньше строгое сравнение с YES молча теряло алерт в ОСП)
  if LZYes(check) then {
    // #556 A.1: адресация по id, не по подстроке названия
    let aid = LZArtifactId(technology, LZClassifyDomain(technology))
    db_execute("UPDATE knowledge_artifacts SET status = ?, updated_at = datetime('now') WHERE id = ?", ["hot", aid])
    // #553: переход статуса — вердикт модели по проверке инфлекшна (LZYes),
    // провенанс фиксирует и канал суждения, и применившее его правило
    let _ = LZProvRecord(aid, "status", "LZInflectionDetect+LZYes")
    // #565 A.1: инфлекшн-вердикт — грейдимый ключ; сверка — quarterly обзор устава
    db_execute("INSERT INTO prediction_keys (artifact_id, kind, claim, verify_source, due_at) VALUES (?, 'inflection', 'inflection=YES->hot', 'rescore:quarterly', datetime('now', '+90 days'))", [aid])
    // #446 A.2 (решение владельца: построить): алерт уходит в ЖИВОЙ
    // /osp/analyze (:10001) по контракту №318 — hash-form секрета,
    // fire-and-forget 5с: анализ продолжается на сервере, отчёт приходит
    // владельцу через SendReport (прецедент — LZGateOSPReferral выше).
    // Раньше: несуществующий роут :4000/osp/inflection-alert — инфлекшн-алерты
    // ЛЗ молча терялись (класс ошибок №1, #381).
    TryVal(try http_post("http://127.0.0.1:10001/osp/analyze?secret=" + redact(env("CRON_SECRET"), "hash_only"), json_encode({source: "lz", query: "Inflection alert: " + technology + ". Анализ: " + result, type: "inflection_alert"}), "application/json", 5.0))
  }
  return "🔬 Inflection: " + technology + "\n" + result
}

// Skill 4: technology-OOB
pattern LZOrderOfBattle(technology: String, chat_id: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("TECHNOLOGY ORDER OF BATTLE for: " + technology + "\n\nCompare competing actors' capabilities:\n1. Compute capacity\n2. Talent concentration\n3. Data access\n4. Capital resources\n5. IP position (patents)\n6. Manufacturing capability\n7. Regulatory environment\n8. Time-to-market\n\nWho has structural advantage? Who can catch up? Who is structurally disadvantaged?"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  db_execute("UPDATE tracked_technologies SET oob_data = ?, updated_at = datetime('now') WHERE id = ?", [result, LZTechRowId(LZArtifactId(technology, LZClassifyDomain(technology)), technology)])
  return "⚔️ OOB: " + technology + "\n" + result
}

// Skill 5: cross-domain-transfer
pattern LZCrossDomainTransfer(query: String, chat_id: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("CROSS-DOMAIN TRANSFER analysis for: " + query + "\n\nIdentify technologies from one domain applicable in another.\nLook for:\n1. Core capability applicable elsewhere\n2. Unrecognized applicability\n3. Revenue potential in target domain\n4. Barriers to transfer\n5. Historical precedents (mRNA→cancer, ML→finance, Li-ion→EVs)"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return "🔀 Cross-Domain: " + query + "\n" + result
}

