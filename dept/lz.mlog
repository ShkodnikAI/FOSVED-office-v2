pattern LZWatchAdd(topic: String, chat_id: String) -> String {
  db_execute("INSERT INTO watchlist_entries (topic, domain, status) VALUES (?, ?, ?)", [topic, "auto", "active"])
  return "👁️ Added to watchlist: " + topic
}

pattern LZWatchRemove(topic: String) -> String {
  db_execute("UPDATE watchlist_entries SET status = ? WHERE topic LIKE ?", ["expired", "%" + topic + "%"])
  return "Removed from watchlist: " + topic
}

pattern LZWatchList() -> String {
  let rows = query("SELECT topic, domain, threshold_disruption, status FROM watchlist_entries WHERE status = ? ORDER BY created_at DESC", ["active"])
  return "👁️ Watchlist:\n" + to_string(rows)
}

pattern LZWatchRelevance(query: String) -> String {
  let rows = query("SELECT topic, domain FROM watchlist_entries WHERE status = ?", ["active"])
  let result = redact(to_string(TryVal(try call_llm("Which watchlist entries are relevant to this query? Query: " + query + "\nWatchlist: " + to_string(rows) + "\n\nList relevant entries or reply NONE."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return result
}

pattern LZRecentArtifacts(domain: String, limit: Float) -> String {
  let rows = query("SELECT title, disruption_score, status, created_at FROM knowledge_artifacts WHERE domain = ? ORDER BY created_at DESC LIMIT ?", [domain, limit])
  return to_string(rows)
}

pattern LZArchiveSearch(query: String) -> String {
  let rows = query("SELECT id, title, domain, hype_cycle_stage, disruption_score, status FROM knowledge_artifacts WHERE title LIKE ? ORDER BY updated_at DESC LIMIT 10", ["%" + query + "%"])
  return "📚 Archive:\n" + to_string(rows)
}

pattern LZMetricsScore() -> String {
  let total = query("SELECT COUNT(*) as c FROM knowledge_artifacts", [])
  let hot = query("SELECT COUNT(*) as c FROM knowledge_artifacts WHERE status = ?", ["hot"])
  let confirmed = query("SELECT COUNT(*) as c FROM knowledge_artifacts WHERE status = ?", ["confirmed_disruption"])
  let watch = query("SELECT COUNT(*) as c FROM watchlist_entries WHERE status = ?", ["active"])
  let scans = query("SELECT COUNT(*) as c FROM scan_logs", [])
  return "📊 ЛЗ Metrics:\nTotal artifacts: " + to_string(total) + "\nHot: " + to_string(hot) + "\nConfirmed disruptions: " + to_string(confirmed) + "\nActive watchlist: " + to_string(watch) + "\nTotal scans: " + to_string(scans)
}

