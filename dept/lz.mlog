// CORE SKILLS (5) — native call_llm implementations
// ═══════════════════════════════════════════════════════════════════════

// Skill 1: hype-cycle-mapping
pattern LZHypeCycleMap(technology: String, chat_id: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("HYPE CYCLE MAPPING for: " + technology + "\n\nClassify onto Gartner hype cycle:\n1. Innovation Trigger — breakthrough generates attention\n2. Peak of Inflated Expectations — overpromotion\n3. Trough of Disillusionment — expectations correct\n4. Slope of Enlightenment — practical use emerges\n5. Plateau of Productivity — mainstream adoption\n\nProvide: stage, evidence, timeline_to_next_stage, investment_implication (buy/sell/wait)"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // Store result
  db_execute("UPDATE knowledge_artifacts SET hype_cycle_stage = ?, updated_at = datetime('now') WHERE title LIKE ?", [result, "%" + technology + "%"])
  // Gate 3: Check negative signals at peak
  let neg_check = LZGateNegativeSignals(0)
  // Gate 4: Verify hype vs flows
  let flow_check = LZGateHypeVsFlows(technology)
  return "📊 Hype Cycle: " + technology + "\n" + result + "\n" + neg_check + "\n" + flow_check
}

// Skill 2: disruption-scoring
pattern LZDisruptionScore(technology: String, chat_id: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("DISRUPTION SCORING for: " + technology + "\n\nEvaluate 5 components (0-100 each):\n1. Performance ratio vs incumbent\n2. Cost trajectory\n3. Patent activity concentration\n4. Talent flow signal\n5. VC investment patterns\n\nCompute weighted disruption probability at horizons: 1y, 3y, 5y, 10y.\nStatus: tracking | hot | confirmed_disruption | cooled | failed"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // Store scores
  db_execute("UPDATE tracked_technologies SET disruption_1y = ?, disruption_3y = ?, disruption_5y = ?, disruption_10y = ?, updated_at = datetime('now') WHERE technology_name LIKE ?", [0.0, 0.0, 0.0, 0.0, "%" + technology + "%"])
  // Gate 7: Check competing alternatives
  let alt_check = LZGateCompetingCheck(technology)
  // Gate 8: Cross-domain potential
  let cross_check = LZGateCrossDomain(technology, "tech")
  return "🎯 Disruption Score: " + technology + "\n" + result + "\n" + alt_check + "\n" + cross_check
}

// Skill 3: inflection-detection
pattern LZInflectionDetect(technology: String, chat_id: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("INFLECTION DETECTION for: " + technology + "\n\nWatch for signals:\n1. First non-academic deployments\n2. Regulatory attention signals\n3. Corporate VC entry\n4. Supply chain emergence\n5. Technical standards formation\n6. Talent concentration shift\n\nIs this technology at inflection point? Provide evidence and confidence level."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // If inflection detected, escalate to hot
  let check = redact(to_string(TryVal(try call_llm("Is this technology at inflection? Reply YES or NO. Analysis: " + result))), "all")
  if to_string(check) == "()" then { let check = "[оценка недоступна — провайдеры модели не ответили]" }
  if check == "YES" then {
    db_execute("UPDATE knowledge_artifacts SET status = ?, updated_at = datetime('now') WHERE title LIKE ?", ["hot", "%" + technology + "%"])
    // Auto-trigger OSP if disruption >= 70%
    TryVal(try http_post("http://127.0.0.1:4000/osp/inflection-alert", json_encode({technology: technology, source: "lz", analysis: result}), "application/json"))
  }
  return "🔬 Inflection: " + technology + "\n" + result
}

// Skill 4: technology-OOB
pattern LZOrderOfBattle(technology: String, chat_id: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("TECHNOLOGY ORDER OF BATTLE for: " + technology + "\n\nCompare competing actors' capabilities:\n1. Compute capacity\n2. Talent concentration\n3. Data access\n4. Capital resources\n5. IP position (patents)\n6. Manufacturing capability\n7. Regulatory environment\n8. Time-to-market\n\nWho has structural advantage? Who can catch up? Who is structurally disadvantaged?"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  db_execute("UPDATE tracked_technologies SET oob_data = ?, updated_at = datetime('now') WHERE technology_name LIKE ?", [result, "%" + technology + "%"])
  return "⚔️ OOB: " + technology + "\n" + result
}

// Skill 5: cross-domain-transfer
pattern LZCrossDomainTransfer(query: String, chat_id: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("CROSS-DOMAIN TRANSFER analysis for: " + query + "\n\nIdentify technologies from one domain applicable in another.\nLook for:\n1. Core capability applicable elsewhere\n2. Unrecognized applicability\n3. Revenue potential in target domain\n4. Barriers to transfer\n5. Historical precedents (mRNA→cancer, ML→finance, Li-ion→EVs)"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return "🔀 Cross-Domain: " + query + "\n" + result
}

