// Skill 10: leaked-roadmap-analysis
pattern LZLeakedRoadmap(query: String, chat_id: String) -> String {
  // Tier 3: requires owner approval
  let approval = redact(to_string(TryVal(try call_llm("Is leaked roadmap analysis approved for this session? Check owner context. Reply APPROVED or DENIED."))), "all")
  if to_string(approval) == "()" then { let approval = "[оценка недоступна — провайдеры модели не ответили]" }
  if approval != "APPROVED" then { return "⛔ Tier 3: leaked-roadmap-analysis requires owner approval" }
  let result = redact(to_string(TryVal(try call_llm("LEAKED ROADMAP ANALYSIS for: " + query + "\n\nAuthenticate source → Extract strategic direction → Assess credibility → Identify timing constraints → Generate actionable intelligence. Distinguish authentic leaks from disinformation."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  return "🔐 Leaked Intel: " + query + "\n" + result
}

