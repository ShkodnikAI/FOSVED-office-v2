// ── Грейдинг предсказаний (#565) ─────────────────────────────────────────
// rule-грейдер одного ключа: исход = зафиксированное состояние артефакта на
// момент грейдинга, окно = due_at. Возвращает JSON-строку raw-прогона.
// LLM-эскалация — только при передаче конкретных ключей и исходов, провенанс
// по #553 (наряд); здесь — детерминированные правила, honest по умолчанию.
pattern LZGradeKey(key_id: Float, artifact_id: Float, kind: String, claim: String) -> String {
  if kind == "disruption_score" then {
    let rows = query("SELECT disruption_score AS s FROM knowledge_artifacts WHERE id = ?", [artifact_id])
    if length(rows) > 0.0 then {
      let cur = to_float(json_get(get(rows, 0), "s", "0"))
      let claimed = to_float_or(trim(substring(claim, index_of(claim, "=") + 1.0, length(claim))), -1.0)
      if claimed >= 0.0 then {
        let mut dev = cur - claimed
        if dev < 0.0 then { let dev = 0.0 - dev }
        let score = 1.0 - dev / 0.5
        if score < 0.0 then { let score = 0.0 }
        let grader = "rule:linear-half-range"
        let out_line = json_encode({key_id: key_id, kind: kind, claim: claim, outcome: cur, score: score, grader: grader})
        db_execute("UPDATE prediction_keys SET status = 'graded', graded_at = datetime('now'), score = ?, grader = ?, caveats = ? WHERE id = ?", [score, grader, "исход = disruption_score артефакта на момент грейдинга; полный промах = отклонение 0.5", key_id])
        return out_line
      }
    }
  }
  if kind == "hype_stage" then {
    let rows = query("SELECT hype_cycle_stage AS s FROM knowledge_artifacts WHERE id = ?", [artifact_id])
    if length(rows) > 0.0 then {
      let cur = to_string(json_get(get(rows, 0), "s", ""))
      let claimed = trim(substring(claim, index_of(claim, "=") + 1.0, length(claim)))
      if cur != "" then {
        let score = 0.0
        if cur == claimed then { let score = 1.0 }
        let grader = "rule:stage-equality"
        let out_line = json_encode({key_id: key_id, kind: kind, claim: claim, outcome: cur, score: score, grader: grader})
        db_execute("UPDATE prediction_keys SET status = 'graded', graded_at = datetime('now'), score = ?, grader = ?, caveats = ? WHERE id = ?", [score, grader, "исход = hype_cycle_stage артефакта на момент грейдинга; совпадение = 1", key_id])
        return out_line
      }
    }
  }
  if kind == "inflection" then {
    let rows = query("SELECT status AS s FROM knowledge_artifacts WHERE id = ?", [artifact_id])
    if length(rows) > 0.0 then {
      let cur = to_string(json_get(get(rows, 0), "s", ""))
      let score = 0.0
      if cur == "hot" or cur == "confirmed_disruption" then { let score = 1.0 }
      let grader = "rule:inflection-status"
      let out_line = json_encode({key_id: key_id, kind: kind, claim: claim, outcome: cur, score: score, grader: grader})
      db_execute("UPDATE prediction_keys SET status = 'graded', graded_at = datetime('now'), score = ?, grader = ?, caveats = ? WHERE id = ?", [score, grader, "исход = статус артефакта на момент грейдинга; hot/confirmed_disruption = 1", key_id])
      return out_line
    }
  }
  // неизвестный kind — не грейдим (score -1: прогон пропустит ключ)
  return json_encode({key_id: key_id, kind: kind, claim: claim, outcome: "", score: -1.0, grader: "rule:unimplemented"})
}

// Журнал сырых прогонов: каждая калибровка — строка в grading_runs (A.2)
pattern LZGradingRunLog(metric: String, n: Float, raw: String, caveats: String) -> Float {
  db_execute("INSERT INTO grading_runs (metric, n, raw, caveats) VALUES (?, ?, ?, ?)", [metric, n, raw, caveats])
  let created = query("SELECT id AS i FROM grading_runs ORDER BY id DESC LIMIT 1", [])
  return to_float(json_get(get(created, 0), "i", "0"))
}

// Сводка — медиана и среднее раздельно, считаются ИЗ raw-строк (JSONL),
// а не из промежуточных значений: воспроизводимость из raw (A.2)
pattern LZSummaryFromRaw(raw: String) -> String {
  let lines = split(raw, "\n")
  let mut vals = ""
  let mut cnt = 0.0
  each ln in lines {
    let t = trim(to_string(ln))
    if t != "" then {
      let obj = parse_json(t)
      let sc = to_float(json_get(obj, "score", "-1"))
      if sc >= 0.0 then {
        let vals = vals + to_string(sc) + " "
        let cnt = cnt + 1.0
      }
    }
  }
  if cnt == 0.0 then { return json_encode({n: 0.0, mean: 0.0, median: 0.0, note: "нет грейденных ключей в raw"}) }
  let parts = split(trim(vals), " ")
  let sorted = sort(parts)
  let mut sum = 0.0
  each v in sorted {
    let sum = sum + to_float(to_string(v))
  }
  let mean = sum / cnt
  // медиана: нечётный n — средний элемент; чётный — среднее двух средних.
  // to_int() — встроенный; floor/% в mlog нет (пробы probe_mod/probe_int).
  let half = cnt / 2.0
  if to_float(to_int(half)) == half then {
    let median = (to_float(to_string(get(sorted, half - 1.0))) + to_float(to_string(get(sorted, half)))) / 2.0
    return json_encode({n: cnt, mean: mean, median: median})
  }
  let median = to_float(to_string(get(sorted, to_int(half))))
  return json_encode({n: cnt, mean: mean, median: median})
}

pattern LZRecalibrate() -> String {
  // #565 A.3: калибровка ТОЛЬКО по prediction_keys. Без ключей — честное
  // «нечем калибровать»: никакого accuracy rate из ниотчего (раньше промпт
  // просил LLM «Compute accuracy rate» при отсутствии в схеме и предсказаний,
  // и исходов — выдуманная точность уходила в чат, след — scan_logs).
  let total_rows = query("SELECT COUNT(*) AS c FROM prediction_keys", [])
  let total = to_float(json_get(get(total_rows, 0), "c", "0"))
  let _ = db_execute("INSERT INTO scan_logs (scan_type, artifacts_found) VALUES (?, 0)", ["recalibrate"])
  if total == 0.0 then {
    let run_id = LZGradingRunLog("recalibrate", 0.0, "", "ключей предсказаний — 0; калибровать нечем")
    return "Нечем калибровать: ключей предсказаний — 0 (прогон журналирован: grading_runs#" + to_string(run_id) + ")"
  }
  let due = query("SELECT id, artifact_id, kind, claim FROM prediction_keys WHERE status = 'pending' AND due_at IS NOT NULL AND due_at <= datetime('now') ORDER BY id", [])
  let n_due = length(due)
  if n_due == 0.0 then {
    let run_id = LZGradingRunLog("recalibrate", 0.0, "", "ключей предсказаний — " + to_string(total) + ", грейдимых (окно сверки наступило) — 0")
    return "Нечем калибровать: ключей предсказаний — " + to_string(total) + ", грейдимых (окно сверки наступило) — 0 (прогон журналирован: grading_runs#" + to_string(run_id) + ")"
  }
  let mut raw = ""
  let mut graded = 0.0
  each k in due {
    let kid = to_float(json_get(k, "id", "0"))
    let kaid = to_float(json_get(k, "artifact_id", "0"))
    let kind = to_string(json_get(k, "kind", ""))
    let claim = to_string(json_get(k, "claim", ""))
    let line = LZGradeKey(kid, kaid, kind, claim)
    let obj = parse_json(line)
    if to_float(json_get(obj, "score", "-1")) >= 0.0 then {
      let graded = graded + 1.0
      let raw = raw + line + "\n"
    }
  }
  let skipped = n_due - graded
  let run_id = LZGradingRunLog("recalibrate-keys", graded, raw, "rule grader: исход = состояние артефакта на момент грейдинга, окно = due_at; n=" + to_string(graded) + ", пропущено (неизвестный kind/нет исхода)=" + to_string(skipped))
  let sm = LZSummaryFromRaw(raw)
  db_execute("UPDATE grading_runs SET summary = ? WHERE id = ?", [sm, run_id])
  let sm_obj = parse_json(sm)
  let mut tail = ""
  if skipped > 0.0 then { let tail = "; пропущено ключей (неизвестный kind/нет исхода): " + to_string(skipped) }
  return "Калибровка по ключам предсказаний: грейдено " + to_string(graded) + " из " + to_string(n_due) + " due (всего ключей " + to_string(total) + "); mean=" + to_string(json_get(sm_obj, "mean", "0")) + ", median=" + to_string(json_get(sm_obj, "median", "0")) + " — производны от raw прогона grading_runs#" + to_string(run_id) + "; caveats: rule grader, исход = состояние артефакта на момент грейдинга, окно = due_at, n=" + to_string(graded) + tail
}

// ═══════════════════════════════════════════════════════════════════════
// FINAL SAFETY CHECK — blocks investment advice
// ═══════════════════════════════════════════════════════════════════════

// ═══════════════════════════════════════════════════════════════════════
// MON-4 (#171): сводка ЛЗ — Telegram-посты (MON-1) + YouTube (MON-2) + TikTok (MON-3)
// Синтез call_llm ИСКЛЮЧИТЕЛЬНО из собранного корпуса — «общие знания» запрещены.
// channel_ids_json: "[]" = все каналы lz_telegram_channels (фильтр по подстроке,
// если передан непустой); since_hours: глубина выборки в часах (дефолт 24).
// chat_id: для SendReport (формат report-mlg2) — отклонение от буквы наряда
// (там 2 параметра): SendReport требует получателя, документировано в PR.
// ═══════════════════════════════════════════════════════════════════════
pattern LZChannelDigest(channel_ids_json: String, since_hours: String, chat_id: String) -> String {
  let hours = "24"
  if since_hours != "" then { let hours = since_hours }
  let corpus = ""
  let srcs = ""

  // ── 1. Telegram-посты за период (MON-1 собрал) ──
  let rows = TryVal(try query("SELECT channel_id, channel_name, substr(text, 1, 400), media_type, date FROM lz_channel_posts WHERE date >= datetime('now', ?) ORDER BY date DESC LIMIT 120", ["-" + hours + " hours"]))
  if to_string(rows) != "()" then {
    let n = redact(to_string(json_get(json_encode(rows), "length")), "all")
    let rows_str = to_string(rows)
    if rows_str == "[]" then {
      let corpus = corpus + "TELEGRAM: постов за период нет (монитор собирает, поллинг 5 мин).\n"
    } else {
      let corpus = corpus + "TELEGRAM-ПОСТЫ (последние " + to_string(length(rows_str)) + " симв. среза):\n" + substring(rows_str, 0.0, 5000.0) + "\n"
      let srcs = srcs + "telegram(posts) "
    }
  } else {
    let corpus = corpus + "TELEGRAM: выборка недоступна.\n"
  }

  // ── 2. YouTube-каналы (category="youtube"): новые видео + транскрипт последнего ──
  let yt_channels = TryVal(try query("SELECT channel_id, channel_name FROM lz_telegram_channels WHERE category = ?", ["youtube"]))
  if to_string(yt_channels) != "()" and to_string(yt_channels) != "[]" then {
    let yt_str = to_string(yt_channels)
    let corpus = corpus + "YOUTUBE-КАНАЛЫ В ОТСЛЕЖИВАНИИ:\n" + substring(yt_str, 0.0, 800.0) + "\n"
    let srcs = srcs + "youtube "
  }

  // ── 3. TikTok-каналы (category="tiktok"): честная деградация непереговорна ──
  let tt_channels = TryVal(try query("SELECT channel_id, channel_name FROM lz_telegram_channels WHERE category = ?", ["tiktok"]))
  if to_string(tt_channels) != "()" and to_string(tt_channels) != "[]" then {
    let tt_str = to_string(tt_channels)
    let media = McpMediaCall("tiktok_channel_videos", json_encode({username: substring(tt_str, 0.0, 60.0)}), "lz digest tiktok")
    if media.ok == true then {
      let corpus = corpus + "TIKTOK-ДАННЫЕ:\n" + substring(media.body, 0.0, 1200.0) + "\n"
      let srcs = srcs + "tiktok "
    } else {
      let corpus = corpus + "TikTok: недоступен (" + media.note + "; " + substring(media.body, 0.0, 120.0) + ").\n"
    }
  }

  // ── 4. Синтез строго из собранного ──
  let prompt = "Ты — Лаборатория Загадок (ЛЗ) Fosved Office. Собери сводку по каналу наблюдения за последние " + hours + " часов.\n\n"
  let prompt = prompt + "ЖЁСТКОЕ ПРАВИЛО: используй ТОЛЬКО данные ниже. Никаких общих знаний и домыслов; чего нет в данных — того нет в сводке. Если данных мало — скажи это прямо.\n\n"
  let prompt = prompt + "Структура сводки:\n1. Сигналы дня (что случилось, где, почему это важно)\n2. Аномалии и ранние индикаторы\n3. Что deserves deeper look (рекомендация углубления)\n\n"
  let prompt = prompt + "ДАННЫЕ:\n" + substring(corpus, 0.0, 7000.0)
  let synthesis = redact(to_string(TryVal(try call_llm(prompt))), "all")
  if to_string(synthesis) == "()" then {
    let synthesis = "[синтез недоступен — провайдеры модели не ответили; ниже сырой корпус]\n" + substring(corpus, 0.0, 2000.0)
  }
  let reply = "📡 Сводка ЛЗ (" + hours + "ч; источники: " + srcs + ")\n\n" + synthesis + "\n\n" + LZDisclaimer()

  // ── 5. Отчёт в формате report-mlg2 (архив + карточка) ──
  let _ = SendReport(reply, "lz", "lz digest " + hours + "ч", "3", chat_id)
  return reply
}

// ── TEAM-2 #481 A.1: навык lz/tech_scan (реестр dept/team.mlog) ──────
// Тихая облегчённая функция: тех-скан (живой поиск + GitHub-контекст).
// Транспорт Tavily — общий шов utils.mlog (office#354), бюджет честный.
pattern LZTechScan(question: String) -> String {
  let response = TavilySearch(question + " technology", "lz")
  if response == "(budget)" then { return "(тех-скан не выполнен: дневной бюджет Tavily исчерпан)" }
  if response == "()" then { return "(тех-скан не выполнен: сеть Tavily недоступна)" }
  let block = TavilyFormatBlock(response)
  if block == "" then { return "(тех-скан: 0 результатов)" }
  return block + LZGithubContextIfRelevant(question)
}

