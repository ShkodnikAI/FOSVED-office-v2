// Skill 6: patent-prosecution-analysis
pattern LZPatentAnalysis(technology: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("PATENT PROSECUTION ANALYSIS for: " + technology + "\n\nAnalyze patent activity to reveal real R&D priorities:\n1. Recent filings (USPTO/EPO/WIPO/CN)\n2. Assignee concentration\n3. Claim direction analysis\n4. Filing velocity trend\n5. What they protect reveals what they build"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  db_execute("UPDATE tracked_technologies SET patent_activity = ?, updated_at = datetime('now') WHERE technology_name LIKE ?", [result, "%" + technology + "%"])
  return "📋 Patents: " + technology + "\n" + result
}

// Skill 7: talent-flow-tracking
pattern LZTalentFlow(technology: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("TALENT FLOW TRACKING for: " + technology + "\n\nTrack migration of top researchers/engineers:\n1. Key researchers in this field\n2. Recent moves (LinkedIn, conferences)\n3. Concentration points (where talent goes)\n4. Exodus signals (where talent leaves)\n5. Implications for capability direction"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  db_execute("UPDATE tracked_technologies SET talent_flow = ?, updated_at = datetime('now') WHERE technology_name LIKE ?", [result, "%" + technology + "%"])
  return "👥 Talent Flow: " + technology + "\n" + result
}

// Skill 8: vc-tracking
pattern LZVCTracking(technology: String) -> String {
  let result = redact(to_string(TryVal(try call_llm("VC TRACKING for: " + technology + "\n\nAnalyze venture capital patterns:\n1. Recent funding rounds (Crunchbase)\n2. Investor quality signal (track record firms)\n3. Capital concentration by subfield\n4. Stage distribution (seed/A/B/C)\n5. Smart money vs dumb money ratio"))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  db_execute("UPDATE tracked_technologies SET vc_investment = ?, updated_at = datetime('now') WHERE technology_name LIKE ?", [result, "%" + technology + "%"])
  // Cross-dept: notify Finance if significant VC signal
  let sig_check = redact(to_string(TryVal(try call_llm("Is this VC signal significant enough to notify Finance? Reply YES or NO. Analysis: " + result))), "all")
  if to_string(sig_check) == "()" then { let sig_check = "[оценка недоступна — провайдеры модели не ответили]" }
  if sig_check == "YES" then {
    TryVal(try http_post("http://127.0.0.1:4000/finance/vc-signal", json_encode({technology: technology, analysis: result, source: "lz"}), "application/json"))
  }
  return "💰 VC: " + technology + "\n" + result
}

