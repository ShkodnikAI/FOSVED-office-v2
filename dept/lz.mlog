pattern LZRecalibrate() -> String {
  // Recalibrate disruption scores based on latest outcomes
  let result = call_llm("Recalibrate all tracked technologies: compare past disruption predictions with actual outcomes. Compute accuracy rate. Adjust scoring weights if systematic bias detected.")
  db_execute("INSERT INTO scan_logs (scan_type, artifacts_found) VALUES (?, 0)", ["recalibrate"])
  return "🔄 Recalibration complete:\n" + result
}

// ═══════════════════════════════════════════════════════════════════════
// FINAL SAFETY CHECK — blocks investment advice
// ═══════════════════════════════════════════════════════════════════════
pattern LZFinalSafetyCheck(output: String) -> String {
  let check = call_llm("Does this text contain specific investment advice (buy/sell/hold recommendations, portfolio allocations, price targets)? Text: " + output + " Reply YES or NO.")
  if check == "YES" then {
    return "⛔ BLOCKED: Investment advice detected. ЛЗ provides intelligence, not investment recommendations. Forwarded to ОСП. " + LZDisclaimer()
  }
  return output
}
