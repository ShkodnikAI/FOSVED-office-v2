pattern LZDeepScan(query: String, chat_id: String) -> String {
  let domain = LZClassifyDomain(query)
  let skills = LoadLZSkills(query, domain)
  // Parallel multi-source scan
  let web = ScanWeb(query)
  let science = ScanScience(query)
  let github = ScanGitHub(query)
  let yt = ScanYouTube(query)
  // Synthesize
  let result = call_llm("DEEP SCAN synthesis for: " + query + "\nDomain: " + domain + "\nSkills: " + skills + "\n\nWeb: " + web + "\nScience: " + science + "\nGitHub: " + github + "\nYouTube: " + yt + "\n\nProvide comprehensive intelligence assessment with disruption scoring and inflection analysis.")
  // Store artifact
  db_execute("INSERT INTO knowledge_artifacts (title, domain, source, source_tier, status) VALUES (?, ?, ?, 2, ?)", [query, domain, "deep_scan", "tracking"])
  return "🔍 Deep Scan: " + query + "\n" + result
}

pattern LZAllScan(query: String, chat_id: String) -> String {
  let web = ScanWeb(query)
  let yt = ScanYouTube(query)
  let reddit = ScanReddit(query)
  let science = ScanScience(query)
  let github = ScanGitHub(query)
  let social = ScanSocial(query)
  let tg = ScanTelegram(query)
  let result = call_llm("ALL-SOURCE synthesis for: " + query + "\n\nWeb: " + web + "\nYouTube: " + yt + "\nReddit: " + reddit + "\nScience: " + science + "\nGitHub: " + github + "\nSocial: " + social + "\nTelegram: " + tg + "\n\nComprehensive multi-source intelligence assessment.")
  db_execute("INSERT INTO scan_logs (scan_type, sources_queried, artifacts_found) VALUES (?, ?, 1)", ["all", "web,youtube,reddit,science,github,social,telegram"])
  return result
}

