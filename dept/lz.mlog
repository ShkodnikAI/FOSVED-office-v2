pattern LZWatchAdd(topic: String, chat_id: String) -> String {
  db_execute("INSERT INTO watchlist_entries (topic, domain, status) VALUES (?, ?, ?)", [topic, "auto", "active"])
  return "👁️ Added to watchlist: " + topic
}

pattern LZWatchRemove(topic: String) -> String {
  db_execute("UPDATE watchlist_entries SET status = ? WHERE topic ILIKE ?", ["expired", "%" + topic + "%"])
  return "Removed from watchlist: " + topic
}

pattern LZWatchList() -> String {
  let rows = db_execute("SELECT topic, domain, threshold_disruption, status FROM watchlist_entries WHERE status = ? ORDER BY created_at DESC", ["active"])
  return "👁️ Watchlist:\n" + to_string(rows)
}

pattern LZWatchRelevance(query: String) -> String {
  let rows = db_execute("SELECT topic, domain FROM watchlist_entries WHERE status = ?", ["active"])
  let result = call_llm("Which watchlist entries are relevant to this query? Query: " + query + "\nWatchlist: " + to_string(rows) + "\n\nList relevant entries or reply NONE.")
  return result
}

pattern LZRecentArtifacts(domain: String, limit: Float) -> String {
  let rows = db_execute("SELECT title, disruption_score, status, created_at FROM knowledge_artifacts WHERE domain = ? ORDER BY created_at DESC LIMIT ?", [domain, limit])
  return to_string(rows)
}

pattern LZArchiveSearch(query: String) -> String {
  let rows = db_execute("SELECT id, title, domain, hype_cycle_stage, disruption_score, status FROM knowledge_artifacts WHERE title ILIKE ? ORDER BY updated_at DESC LIMIT 10", ["%" + query + "%"])
  return "📚 Archive:\n" + to_string(rows)
}

pattern LZMetricsScore() -> String {
  let total = db_execute("SELECT COUNT(*) as c FROM knowledge_artifacts", [])
  let hot = db_execute("SELECT COUNT(*) as c FROM knowledge_artifacts WHERE status = ?", ["hot"])
  let confirmed = db_execute("SELECT COUNT(*) as c FROM knowledge_artifacts WHERE status = ?", ["confirmed_disruption"])
  let watch = db_execute("SELECT COUNT(*) as c FROM watchlist_entries WHERE status = ?", ["active"])
  let scans = db_execute("SELECT COUNT(*) as c FROM scan_logs", [])
  return "📊 ЛЗ Metrics:\nTotal artifacts: " + to_string(total) + "\nHot: " + to_string(hot) + "\nConfirmed disruptions: " + to_string(confirmed) + "\nActive watchlist: " + to_string(watch) + "\nTotal scans: " + to_string(scans)
}

// ═══════════════════════════════════════════════════════════════════════
// LIFECYCLE STATE MACHINE
// tracking → hot → confirmed_disruption | tracking → cooled | tracking → failed
// ═══════════════════════════════════════════════════════════════════════

pattern LZLifecycleTransition(artifact_id: Int, new_status: String) -> String {
  let rows = db_execute("SELECT status, confirmation_count FROM knowledge_artifacts WHERE id = ?", [artifact_id])
  if length(rows) == 0 then { return "FAIL: artifact not found" }
  let current = to_string(get(get(rows, 0), "status"))
  let confirmations = to_float(get(get(rows, 0), "confirmation_count"))
  // Valid transitions
  if current == "tracking" and new_status == "hot" then {
    db_execute("UPDATE knowledge_artifacts SET status = ?, updated_at = NOW() WHERE id = ?", ["hot", artifact_id])
    return "✅ tracking → hot"
  }
  if current == "tracking" and new_status == "cooled" then {
    db_execute("UPDATE knowledge_artifacts SET status = ?, updated_at = NOW() WHERE id = ?", ["cooled", artifact_id])
    return "✅ tracking → cooled"
  }
  if current == "tracking" and new_status == "failed" then {
    db_execute("UPDATE knowledge_artifacts SET status = ?, updated_at = NOW() WHERE id = ?", ["failed", artifact_id])
    return "✅ tracking → failed"
  }
  if current == "hot" and new_status == "confirmed_disruption" then {
    // Gate 1: Need 3+ confirmations
    if confirmations < 3.0 then { return "⛔ Need " + to_string(3.0 - confirmations) + " more confirmations" }
    db_execute("UPDATE knowledge_artifacts SET status = ?, updated_at = NOW() WHERE id = ?", ["confirmed_disruption", artifact_id])
    // Auto-trigger OSP analysis
    http_post("/osp/disruption-confirmed", {artifact_id: artifact_id, source: "lz"})
    return "✅ hot → confirmed_disruption (OSP notified)"
  }
  if current == "hot" and new_status == "cooled" then {
    db_execute("UPDATE knowledge_artifacts SET status = ?, updated_at = NOW() WHERE id = ?", ["cooled", artifact_id])
    return "✅ hot → cooled"
  }
  return "⛔ Invalid transition: " + current + " → " + new_status
}

// ═══════════════════════════════════════════════════════════════════════
// SCHEDULED TASKS (5 horizons)
// ═══════════════════════════════════════════════════════════════════════

// Every 4h: incremental scan
pattern LZIncrementalScan() -> String {
  let result = call_llm("Incremental scan: check arxiv, biorxiv, medrxiv, USPTO for new publications in tracked domains. Summarize top 5 new findings.")
  db_execute("INSERT INTO scan_logs (scan_type, sources_queried, artifacts_found) VALUES (?, ?, 5)", ["incremental", "arxiv,biorxiv,medrxiv,uspto"])
  return result
}

// Daily 06:00: digest
pattern LZDailyDigest() -> String {
  let hot = db_execute("SELECT title, disruption_score FROM knowledge_artifacts WHERE status = ? ORDER BY disruption_score DESC LIMIT 3", ["hot"])
  let watch = db_execute("SELECT topic FROM watchlist_entries WHERE status = ?", ["active"])
  let result = call_llm("Daily ЛЗ digest:\nHot artifacts: " + to_string(hot) + "\nActive watchlist: " + to_string(watch) + "\n\nSummarize top-3 events + any alerts triggered by watchlist thresholds.")
  db_execute("INSERT INTO scan_logs (scan_type, sources_queried, artifacts_found) VALUES (?, ?, 3)", ["daily", "all"])
  // Send digest to Yana
  http_post("/yana/notify", {dept: "lz", event: "daily_digest", summary: result})
  return result
}

// Weekly: inflection candidates review
pattern LZWeeklyReview() -> String {
  let candidates = db_execute("SELECT title, hype_cycle_stage, disruption_score FROM knowledge_artifacts WHERE status IN (?, ?) ORDER BY disruption_score DESC LIMIT 10", ["tracking", "hot"])
  let result = call_llm("Weekly ЛЗ inflection review:\nCandidates: " + to_string(candidates) + "\n\nFor each: Is inflection approaching? Any new signals? Update hype cycle position if changed.")
  db_execute("INSERT INTO scan_logs (scan_type, artifacts_found) VALUES (?, 10)", ["weekly"])
  return result
}

// Monthly: disruption probability re-scoring
pattern LZMonthlyRescoring() -> String {
  let tracked = db_execute("SELECT id, title, disruption_score FROM tracked_technologies ORDER BY disruption_score DESC LIMIT 20", [])
  let result = call_llm("Monthly re-scoring of tracked technologies:\n" + to_string(tracked) + "\n\nRe-evaluate disruption probability at 1y/3y/5y/10y horizons based on latest data.")
  db_execute("INSERT INTO scan_logs (scan_type, artifacts_found) VALUES (?, 20)", ["monthly"])
  return result
}

// Quarterly: report to owner
pattern LZQuarterlyReport() -> String {
  let top = db_execute("SELECT title, domain, disruption_score, hype_cycle_stage, status FROM knowledge_artifacts WHERE status IN (?, ?) ORDER BY disruption_score DESC LIMIT 10", ["hot", "confirmed_disruption"])
  let result = call_llm("Quarterly ЛЗ report to owner:\nTop 10 emerging technologies:\n" + to_string(top) + "\n\nFor each: disruption assessment, investment implications (referral to ОСП), timeline, confidence level.\n\nDISCLAIMER: This is intelligence, not investment advice.")
  // Cross-dept: send to OSP for strategic analysis
  http_post("/osp/quarterly-intel", {source: "lz", report: result})
  // Cross-dept: send to KK for arsenal review
  http_post("/kk/arsenal-input", {source: "lz", skills_used: "hype-cycle,disruption-scoring,inflection-detection"})
  return result
}

