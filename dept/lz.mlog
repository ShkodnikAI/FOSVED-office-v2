//   hype_cycle_stage TEXT, -- innovation_trigger|peak|trough|slope|plateau
//   disruption_score FLOAT DEFAULT 0.0, -- 0.0-100.0
//   inflection_signals TEXT DEFAULT '[]', -- JSON: [{signal, detected_at, strength}]
//   cross_domain_potential TEXT DEFAULT '[]', -- JSON: [{target_domain, applicability_score}]
//   competing_alternatives TEXT DEFAULT '[]', -- JSON: [{alt_name, approach, viability}]
//   status TEXT DEFAULT 'tracking', -- tracking|hot|confirmed_disruption|cooled|failed
//   confirmation_count INT DEFAULT 0, -- must reach 3 before disruption alert
//   tracked_since TIMESTAMP DEFAULT NOW(),
//   last_scored_at TIMESTAMP,
//   created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW()
// );
// CREATE TABLE tracked_technologies (
//   id SERIAL PRIMARY KEY, artifact_id INT REFERENCES knowledge_artifacts(id),
//   technology_name TEXT NOT NULL,
//   category TEXT, -- computational|biotech|energy|materials|military|transport|comms|fintech|robotics|climate
//   oob_data TEXT DEFAULT '{}', -- JSON: {compute, talent, data, capital, ip, manufacturing, regulatory}
//   patent_activity TEXT DEFAULT '[]', -- JSON: [{filing_date, assignee, claim_summary}]
//   talent_flow TEXT DEFAULT '[]', -- JSON: [{researcher, from_org, to_org, date, significance}]
//   vc_investment TEXT DEFAULT '[]', -- JSON: [{round_date, amount_usd, investors, stage}]
//   disruption_1y FLOAT, disruption_3y FLOAT, disruption_5y FLOAT, disruption_10y FLOAT,
//   created_at TIMESTAMP DEFAULT NOW(), updated_at TIMESTAMP DEFAULT NOW()
// );
// CREATE TABLE scan_logs (
//   id SERIAL PRIMARY KEY,
//   scan_type TEXT, -- incremental|daily|weekly|monthly|realtime|deep
//   sources_queried TEXT DEFAULT '[]', -- JSON: [arxiv, github, uspto, tavily, telegram, ...]
//   artifacts_found INT DEFAULT 0,
//   alerts_generated INT DEFAULT 0,
//   scan_duration_ms INT,
//   started_at TIMESTAMP DEFAULT NOW(), completed_at TIMESTAMP
// );
// CREATE TABLE watchlist_entries (
//   id SERIAL PRIMARY KEY, user_id INT DEFAULT 2044005421,
//   topic TEXT NOT NULL, domain TEXT,
//   threshold_disruption FLOAT DEFAULT 70.0, -- alert when score >= threshold
//   threshold_inflection BOOLEAN DEFAULT TRUE, -- alert on inflection signals
//   status TEXT DEFAULT 'active', -- active|paused|expired
//   created_at TIMESTAMP DEFAULT NOW()
// );
// CREATE TABLE disruption_alerts (
//   id SERIAL PRIMARY KEY, artifact_id INT REFERENCES knowledge_artifacts(id),
//   alert_type TEXT, -- disruption|inflection|cross_domain|competing_alternative
//   severity TEXT DEFAULT 'medium', -- low|medium|high|critical
//   confirmation_count INT DEFAULT 0,
//   osp_triggered BOOLEAN DEFAULT FALSE, -- auto-triggered OSP if disruption≥70%
//   message TEXT,
//   created_at TIMESTAMP DEFAULT NOW(), resolved_at TIMESTAMP
// );

// ═══════════════════════════════════════════════════════════════════════
// DISCLOSURE
// ═══════════════════════════════════════════════════════════════════════
pattern LZDisclaimer() -> String {
  return "⚠️ ЛЗ: разведка мира, не инвестиционный совет. Disruption alerts требуют ≥3 подтверждений. Negative signals не игнорируются. /lz invest → пересылка в ОСП."
}

// ═══════════════════════════════════════════════════════════════════════
// HARD RULE GATES (8 programmatic gates)
// ═══════════════════════════════════════════════════════════════════════

// Gate 1: Minimum 3 independent confirmations before disruption alert
pattern LZGateConfirmations(artifact_id: Int) -> String {
  let rows = db_execute("SELECT confirmation_count, status FROM knowledge_artifacts WHERE id = ?", [artifact_id])
  if length(rows) == 0 then { return "FAIL: artifact not found" }
  let count = to_float(get(get(rows, 0), "confirmation_count"))
  let status = to_string(get(get(rows, 0), "status"))
  if status == "confirmed_disruption" then { return "PASS: already confirmed" }
  if count < 3.0 then { return "FAIL: " + to_string(count) + "/3 confirmations" }
  return "PASS: 3+ confirmations reached"
}

// Gate 2: Impact claims must include timeline
pattern LZGateTimeline(claim: String) -> String {
  let result = call_llm("Does this impact claim include a specific timeline (years to commercial/mass adoption)? Claim: " + claim + " Reply YES or NO only.")
  if result != "YES" then { return "FAIL: no timeline in impact claim" }
  return "PASS: timeline present"
}

// Gate 3: Must not ignore negative signals after initial enthusiasm
pattern LZGateNegativeSignals(artifact_id: Int) -> String {
  let rows = db_execute("SELECT title, hype_cycle_stage, disruption_score FROM knowledge_artifacts WHERE id = ?", [artifact_id])
  if len(rows) == 0 then { return "FAIL: not found" }
  let stage = to_string(get(get(rows, 0), "hype_cycle_stage"))
  if stage == "peak" then {
    let check = call_llm("Technology at Peak of Inflated Expectations. Check for negative signals (failed POCs, talent exodus, regulatory blocks, cost overruns). Technology: " + to_string(get(get(rows, 0.0), "title")) + ". List any negative signals found or say NONE.")
    if check == "NONE" then { return "PASS: no negative signals at peak" }
    return "WARN: negative signals at peak — " + check
  }
  return "PASS: not at peak stage"
}

// Gate 4: Hype narrative must be verified against actual flows
pattern LZGateHypeVsFlows(technology: String) -> String {
  let result = call_llm("Compare public narrative about " + technology + " with actual financial/material/talent flows. Are narrative and flows aligned or divergent? Reply ALIGNED or DIVERGENT with brief explanation.")
  if starts_with(result, "DIVERGENT") then { return "WARN: narrative diverges from flows — " + result }
  return "PASS: narrative consistent with flows"
}

// Gate 5: Investment implications must be referred to OSP
pattern LZGateOSPReferral(query: String) -> String {
  let result = call_llm("Does this query involve investment recommendations or portfolio implications? Query: " + query + " Reply YES or NO.")
  if result == "YES" then {
    http_post("/osp/analyze", {source: "lz", query: query, type: "investment_implication"})
    return "REFERRED: investment query sent to OSP"
  }
  return "PASS: no investment implication"
}

// Gate 6: Emerging tech must check emission flow (Cantillon)
pattern LZGateEmissionCheck(technology: String) -> String {
  let result = call_llm("Does " + technology + " involve or depend on monetary emission, credit expansion, or fiscal subsidy flows? Reply YES or NO.")
  if result == "YES" then {
    http_post("/osp/cantillon", {technology: technology, source: "lz"})
    return "REFERRED: emission flow check sent to OSP"
  }
  return "PASS: no emission dependency"
}

// Gate 7: Single-tech focus must check competing alternatives
pattern LZGateCompetingCheck(technology: String) -> String {
  let result = call_llm("Name 2-3 competing alternatives to " + technology + " that solve the same fundamental problem differently. If none exist, reply NONE.")
  if result == "NONE" then { return "PASS: no known alternatives" }
  return "PASS: alternatives identified — " + result
}

// Gate 8: Every tracked technology assessed for cross-domain potential
pattern LZGateCrossDomain(technology: String, source_domain: String) -> String {
  let result = call_llm("Could " + technology + " (currently in " + source_domain + ") have applications in other domains? Name 1-2 cross-domain possibilities or reply NONE.")
  if result == "NONE" then { return "PASS: no cross-domain potential identified" }
  return "PASS: cross-domain potential — " + result
}

// ═══════════════════════════════════════════════════════════════════════
// MAIN DISPATCHER
// ═══════════════════════════════════════════════════════════════════════
pattern HandleLZ(query: String, chat_id: String) -> String {
  let dept = "lz"
  let t = lower(query)
  let disclaimer = LZDisclaimer()

  // ── Domain-specific scans ──
  if starts_with(t, "/lz politics") then {
    let q = substring(query, 12.0, 300.0)
    return disclaimer + "\n" + LZPoliticsScan(q, chat_id)
  }
  if starts_with(t, "/lz economics") or starts_with(t, "/lz economy") then {
    let q = substring(query, 13.0, 300.0)
    return disclaimer + "\n" + LZEconomicsScan(q, chat_id)
  }
  if starts_with(t, "/lz event") then {
    let q = substring(query, 10.0, 300.0)
    return disclaimer + "\n" + LZEventsScan(q, chat_id)
  }
  if starts_with(t, "/lz geopolitics") or starts_with(t, "/lz geopol") then {
    let q = substring(query, 15.0, 300.0)
    return disclaimer + "\n" + LZGeopoliticsScan(q, chat_id)
  }
  // ── Tavily real web search ──
  if starts_with(t, "/lz tavily") then {
    let q = substring(query, 10.0, 300.0)
    return disclaimer + "\n" + LZTavilySearch(q, chat_id)
  }
  // ── Telegram channel search ──
  if starts_with(t, "/lz tg") or starts_with(t, "/lz telegram") then {
    let q = substring(query, 7.0, 300.0)
    return disclaimer + "\n" + LZTelegramSearch(q, chat_id)
  }
  // ── Skill commands ──
  if starts_with(t, "/lz hype") then {
    let q = substring(query, 8.0, 300.0)
    return LZHypeCycleMap(q, chat_id)
  }
  if starts_with(t, "/lz disrupt") then {
    let q = substring(query, 11.0, 300.0)
    return LZDisruptionScore(q, chat_id)
  }
  if starts_with(t, "/lz inflection") then {
    let q = substring(query, 13.0, 300.0)
    return LZInflectionDetect(q, chat_id)
  }
  if starts_with(t, "/lz oob") then {
    let q = substring(query, 7.0, 300.0)
    return LZOrderOfBattle(q, chat_id)
  }
  if starts_with(t, "/lz cross-domain") then {
    let q = substring(query, 15.0, 300.0)
    return LZCrossDomainTransfer(q, chat_id)
  }
  if starts_with(t, "/lz compare") then {
    let q = substring(query, 11.0, 300.0)
    return LZCompetingAlternatives(q, chat_id)
  }
  // ── Watchlist ──
  if starts_with(t, "/lz watch add") then {
    let q = substring(query, 13.0, 300.0)
    return LZWatchAdd(q, chat_id)
  }
  if starts_with(t, "/lz watch remove") then {
    let q = substring(query, 16.0, 300.0)
    return LZWatchRemove(q)
  }
  if starts_with(t, "/lz watch") or starts_with(t, "/lz watchlist") then {
    return LZWatchList()
  }
  // ── Archive ──
  if starts_with(t, "/lz archive") then {
    let q = substring(query, 11.0, 300.0)
    return LZArchiveSearch(q)
  }
  // ── Deep scan / research ──
  if starts_with(t, "/lz deep") then {
    let q = substring(query, 8.0, 300.0)
    return LZDeepScan(q, chat_id)
  }
  if starts_with(t, "/lz all") then {
    return LZAllScan(query, chat_id)
  }
  // ── Metrics ──
  if starts_with(t, "/lz score") then { return LZMetricsScore() }
  if starts_with(t, "/lz recalibrate") then { return LZRecalibrate() }
  // ── Tier 3 commands ──
  if starts_with(t, "/lz leaked") then {
    let q = substring(query, 10.0, 300.0)
    return LZLeakedRoadmap(q, chat_id)
  }
  if starts_with(t, "/lz dark") then {
    let q = substring(query, 8.0, 300.0)
    return LZDarkWebResearch(q, chat_id)
  }
  if starts_with(t, "/lz profile") then {
    let q = substring(query, 11.0, 300.0)
    return LZDeepResearcherProfile(q, chat_id)
  }

  // ── Domain classification + enriched context ──
  let domain = LZClassifyDomain(query)
  let context = BuildLZContext(query, domain, chat_id)

  // Gate 5: Check for investment implications
  let ref = LZGateOSPReferral(query)

  let result = call_llm("ЛЗ (" + domain + "): " + query + "\nContext: " + context + "\n\nProvide intelligence assessment. If this involves investment, say INVEST_REFERRAL instead.")
  if starts_with(result, "INVEST_REFERRAL") then {
    http_post("/osp/analyze", {source: "lz", query: query, domain: domain})
    return disclaimer + "\n🔄 Передано в ОСП для инвестиционного анализа"
  }

  // ── LLM-Verifier: intelligence quality scoring ──
  let lzv_resp = try call_python("llm_verifier", "score", json_encode([query, result, "Source quality: Are claims grounded in verifiable evidence? Analytical depth: Multiple perspectives and second-order effects? Signal vs noise: Distinguishes emerging signals from noise?"]))
  if to_string(lzv_resp) != "()" and contains(to_string(lzv_resp), "error") == false then {
    let lzv_parsed = try parse_json(lzv_resp)
    let lzv_score = to_float(try json_get(lzv_parsed, "result", "0.5"))
    let _ = AuditLog("lz_verify_score", dept, "score=" + to_string(lzv_score) + " domain=" + domain)
  }

  // Log scan
  db_execute("INSERT INTO scan_logs (scan_type, artifacts_found, alerts_generated) VALUES (?, 1, 0)", ["realtime"])

  return disclaimer + "\n" + result
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN CLASSIFICATION + CONTEXT BUILDER
// ═══════════════════════════════════════════════════════════════════════
pattern LZClassifyDomain(query: String) -> String {
  let result = call_llm("Classify this query into exactly one domain: tech, politics, economics, geopolitics, events. Query: " + query + ". Reply with single word only.")
  return result
}

pattern BuildLZContext(query: String, domain: String, chat_id: String) -> String {
  let kb = LZWorldKB(domain)
  let watch = LZWatchRelevance(query)
  let recent = LZRecentArtifacts(domain, 5.0)
  return "KB: " + kb + "\nWatch: " + watch + "\nRecent: " + recent
}

pattern LZWorldKB(domain: String) -> String {
  let tech = "Spheres: Computational·Биотех·Energy·Materials·Военные·Transport·Comms·FinTech·Robotics·Climate"
  let politics = "Spheres: Геополитические сдвиги·Выборы·Санкции·Конфликты·Кибервойна·Ядерная политика"
  let economics = "Spheres: Макро·Монетарная·Фискальная·Валютные·Товарные·Кризисные сигналы·РФ специфика"
  let events = "Spheres: ЧС·Теракты·Протесты·Политкризисы·Пандемии·Корпсобытия·Научные прорывы"
  let geopol = "Spheres: Сферы влияния·Военные альянсы·Энергетическая геополитика·Tech sovereignty·Sanctions regimes"
  if domain == "tech" then { return tech }
  if domain == "politics" then { return politics }
  if domain == "economics" then { return economics }
  if domain == "events" then { return events }
  if domain == "geopolitics" then { return geopol }
  return tech + " | " + politics + " | " + economics
}

pattern LoadLZSkills(query: String, domain: String) -> String {
  // Core skills always loaded
  let core = "hype-cycle-mapping, disruption-scoring, inflection-detection, technology-OOB, cross-domain-transfer"
  let domain_skills = ""
  if domain == "tech" then { domain_skills = "patent-prosecution, talent-flow-tracking, vc-tracking, competing-alternatives" }
  if domain == "politics" then { domain_skills = "cantillon(inject), narrative-vs-flows(inject), cycle-position(inject), iw-watchlist(inject)" }
  if domain == "economics" then { domain_skills = "macro-regime-id(inject), cross-asset-divergence(inject), cashflow-forecasting(inject), cantillon(inject)" }
  if domain == "events" then { domain_skills = "domain-rapid-entry(inject), failure-modes-mapping(inject), adjacent-field-cross-check(inject), iw-watchlist(inject)" }
  // Tier 3: loaded on demand only
  let tier3 = "leaked-roadmap-analysis, dark-web-tech-research, deep-researcher-profiling (owner-approved only)"
  return "Core[" + core + "] Domain[" + domain_skills + "] Tier3[" + tier3 + "]"
}

// ═══════════════════════════════════════════════════════════════════════
// CORE SKILLS (5) — native call_llm implementations
// ═══════════════════════════════════════════════════════════════════════

// Skill 1: hype-cycle-mapping
pattern LZHypeCycleMap(technology: String, chat_id: String) -> String {
  let result = call_llm("HYPE CYCLE MAPPING for: " + technology + "\n\nClassify onto Gartner hype cycle:\n1. Innovation Trigger — breakthrough generates attention\n2. Peak of Inflated Expectations — overpromotion\n3. Trough of Disillusionment — expectations correct\n4. Slope of Enlightenment — practical use emerges\n5. Plateau of Productivity — mainstream adoption\n\nProvide: stage, evidence, timeline_to_next_stage, investment_implication (buy/sell/wait)")
  // Store result
  db_execute("UPDATE knowledge_artifacts SET hype_cycle_stage = ?, updated_at = NOW() WHERE title ILIKE ?", [result, "%" + technology + "%"])
  // Gate 3: Check negative signals at peak
  let neg_check = LZGateNegativeSignals(0)
  // Gate 4: Verify hype vs flows
  let flow_check = LZGateHypeVsFlows(technology)
  return "📊 Hype Cycle: " + technology + "\n" + result + "\n" + neg_check + "\n" + flow_check
}

// Skill 2: disruption-scoring
pattern LZDisruptionScore(technology: String, chat_id: String) -> String {
  let result = call_llm("DISRUPTION SCORING for: " + technology + "\n\nEvaluate 5 components (0-100 each):\n1. Performance ratio vs incumbent\n2. Cost trajectory\n3. Patent activity concentration\n4. Talent flow signal\n5. VC investment patterns\n\nCompute weighted disruption probability at horizons: 1y, 3y, 5y, 10y.\nStatus: tracking | hot | confirmed_disruption | cooled | failed")
  // Store scores
  db_execute("UPDATE tracked_technologies SET disruption_1y = ?, disruption_3y = ?, disruption_5y = ?, disruption_10y = ?, updated_at = NOW() WHERE technology_name ILIKE ?", [0.0, 0.0, 0.0, 0.0, "%" + technology + "%"])
  // Gate 7: Check competing alternatives
  let alt_check = LZGateCompetingCheck(technology)
  // Gate 8: Cross-domain potential
  let cross_check = LZGateCrossDomain(technology, "tech")
  return "🎯 Disruption Score: " + technology + "\n" + result + "\n" + alt_check + "\n" + cross_check
}

// Skill 3: inflection-detection
pattern LZInflectionDetect(technology: String, chat_id: String) -> String {
  let result = call_llm("INFLECTION DETECTION for: " + technology + "\n\nWatch for signals:\n1. First non-academic deployments\n2. Regulatory attention signals\n3. Corporate VC entry\n4. Supply chain emergence\n5. Technical standards formation\n6. Talent concentration shift\n\nIs this technology at inflection point? Provide evidence and confidence level.")
  // If inflection detected, escalate to hot
  let check = call_llm("Is this technology at inflection? Reply YES or NO. Analysis: " + result)
  if check == "YES" then {
    db_execute("UPDATE knowledge_artifacts SET status = ?, updated_at = NOW() WHERE title ILIKE ?", ["hot", "%" + technology + "%"])
    // Auto-trigger OSP if disruption >= 70%
    http_post("/osp/inflection-alert", {technology: technology, source: "lz", analysis: result})
  }
  return "🔬 Inflection: " + technology + "\n" + result
}

// Skill 4: technology-OOB
pattern LZOrderOfBattle(technology: String, chat_id: String) -> String {
  let result = call_llm("TECHNOLOGY ORDER OF BATTLE for: " + technology + "\n\nCompare competing actors' capabilities:\n1. Compute capacity\n2. Talent concentration\n3. Data access\n4. Capital resources\n5. IP position (patents)\n6. Manufacturing capability\n7. Regulatory environment\n8. Time-to-market\n\nWho has structural advantage? Who can catch up? Who is structurally disadvantaged?")
  db_execute("UPDATE tracked_technologies SET oob_data = ?, updated_at = NOW() WHERE technology_name ILIKE ?", [result, "%" + technology + "%"])
  return "⚔️ OOB: " + technology + "\n" + result
}

// Skill 5: cross-domain-transfer
pattern LZCrossDomainTransfer(query: String, chat_id: String) -> String {
  let result = call_llm("CROSS-DOMAIN TRANSFER analysis for: " + query + "\n\nIdentify technologies from one domain applicable in another.\nLook for:\n1. Core capability applicable elsewhere\n2. Unrecognized applicability\n3. Revenue potential in target domain\n4. Barriers to transfer\n5. Historical precedents (mRNA→cancer, ML→finance, Li-ion→EVs)")
  return "🔀 Cross-Domain: " + query + "\n" + result
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN SKILLS (4) — patent, talent, vc, competing-alternatives
// ═══════════════════════════════════════════════════════════════════════

// Skill 6: patent-prosecution-analysis
pattern LZPatentAnalysis(technology: String) -> String {
  let result = call_llm("PATENT PROSECUTION ANALYSIS for: " + technology + "\n\nAnalyze patent activity to reveal real R&D priorities:\n1. Recent filings (USPTO/EPO/WIPO/CN)\n2. Assignee concentration\n3. Claim direction analysis\n4. Filing velocity trend\n5. What they protect reveals what they build")
  db_execute("UPDATE tracked_technologies SET patent_activity = ?, updated_at = NOW() WHERE technology_name ILIKE ?", [result, "%" + technology + "%"])
  return "📋 Patents: " + technology + "\n" + result
}

// Skill 7: talent-flow-tracking
pattern LZTalentFlow(technology: String) -> String {
  let result = call_llm("TALENT FLOW TRACKING for: " + technology + "\n\nTrack migration of top researchers/engineers:\n1. Key researchers in this field\n2. Recent moves (LinkedIn, conferences)\n3. Concentration points (where talent goes)\n4. Exodus signals (where talent leaves)\n5. Implications for capability direction")
  db_execute("UPDATE tracked_technologies SET talent_flow = ?, updated_at = NOW() WHERE technology_name ILIKE ?", [result, "%" + technology + "%"])
  return "👥 Talent Flow: " + technology + "\n" + result
}

// Skill 8: vc-tracking
pattern LZVCTracking(technology: String) -> String {
  let result = call_llm("VC TRACKING for: " + technology + "\n\nAnalyze venture capital patterns:\n1. Recent funding rounds (Crunchbase)\n2. Investor quality signal (track record firms)\n3. Capital concentration by subfield\n4. Stage distribution (seed/A/B/C)\n5. Smart money vs dumb money ratio")
  db_execute("UPDATE tracked_technologies SET vc_investment = ?, updated_at = NOW() WHERE technology_name ILIKE ?", [result, "%" + technology + "%"])
  // Cross-dept: notify Finance if significant VC signal
  let sig_check = call_llm("Is this VC signal significant enough to notify Finance? Reply YES or NO. Analysis: " + result)
  if sig_check == "YES" then {
    http_post("/finance/vc-signal", {technology: technology, analysis: result, source: "lz"})
  }
  return "💰 VC: " + technology + "\n" + result
}

// Skill 9: competing-alternatives
pattern LZCompetingAlternatives(query: String, chat_id: String) -> String {
  let result = call_llm("COMPETING ALTERNATIVES for: " + query + "\n\nIdentify competing solutions to same fundamental problem:\n1. Alternative technologies/approaches\n2. Current status of each\n3. Structural advantages/disadvantages\n4. Which might win and why\n5. Premature convergence risk on single bet")
  return "🔄 Alternatives: " + query + "\n" + result
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN SCANS (4) — politics, economics, events, geopolitics
// ═══════════════════════════════════════════════════════════════════════

pattern LZPoliticsScan(query: String, chat_id: String) -> String {
  let context = BuildLZContext(query, "politics", chat_id)
  let result = call_llm("ЛЗ Politics: " + query + "\n" + context + "\n\nAnalyze political intelligence: geopolitical shifts, elections, sanctions, conflicts, cyber warfare. Apply cantillon, narrative-vs-flows, cycle-position lenses.")
