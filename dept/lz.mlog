// Telegram: no direct API — uses web search for public channel mirrors
pattern ScanTelegram(query: String) -> String {
  let tq = query + " (telegram channel OR t.me)"
  let body = json_encode({query: tq, dept: "lz", limit: 5})
  let resp = TryVal(try http_post("http://127.0.0.1:4000/news/fresh", body, "application/json"))
  if to_string(resp) == "()" then { return "[telegram: no direct API, web search only]" }
  let parsed = TryVal(try parse_json(resp))
  if to_string(parsed) == "()" then { return "[telegram: parse error]" }
  return to_string(json_get(parsed, "news", "no results"))
}

// Darknet: not available — honest placeholder
pattern ScanDarknet(query: String) -> String {
  return "[darknet scan: unavailable — no anonymous access infrastructure]"
}

pattern LZDeepScan(query: String, chat_id: String) -> String {
  let domain = LZClassifyDomain(query)
  let skills = LoadLZSkills(query, domain)
  // Parallel multi-source scan
  let web = ScanWeb(query)
  let science = ScanApiSources(query)
  let github = ScanGitHub(query)
  let yt = ScanYouTube(query)
  // Synthesize
  let result = redact(to_string(TryVal(try call_llm("DEEP SCAN synthesis for: " + query + "\nDomain: " + domain + "\nSkills: " + skills + "\n\nWeb: " + web + "\nScience: " + science + "\nGitHub: " + github + "\nYouTube: " + yt + "\n\nProvide comprehensive intelligence assessment with disruption scoring and inflection analysis."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  // Store artifact
  db_execute("INSERT INTO knowledge_artifacts (title, domain, source, source_tier, status) VALUES (?, ?, ?, 2, ?)", [query, domain, "deep_scan", "tracking"])
  return "🔍 Deep Scan: " + query + "\n" + result
}

pattern LZAllScan(query: String, chat_id: String) -> String {
  let web = ScanWeb(query)
  let yt = ScanYouTube(query)
  let reddit = ScanReddit(query)
  let science = ScanApiSources(query)
  let github = ScanGitHub(query)
  let social = ScanSocial(query)
  let tg = ScanTelegram(query)
  let result = redact(to_string(TryVal(try call_llm("ALL-SOURCE synthesis for: " + query + "\n\nWeb: " + web + "\nYouTube: " + yt + "\nReddit: " + reddit + "\nScience: " + science + "\nGitHub: " + github + "\nSocial: " + social + "\nTelegram: " + tg + "\n\nComprehensive multi-source intelligence assessment."))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  db_execute("INSERT INTO scan_logs (scan_type, sources_queried, artifacts_found) VALUES (?, ?, 1)", ["all", "web,youtube,reddit,arxiv+hn+github-api,github,social,telegram"])
  return result
}

