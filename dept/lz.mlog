pattern LZPoliticsScan(query: String, chat_id: String) -> String {
  let context = BuildLZContext(query, "politics", chat_id)
  let live = LZTavilySearch(query, chat_id)
  let result = redact(to_string(TryVal(try call_llm("ЛЗ Politics: analyze political intelligence — geopolitical shifts, elections, sanctions, conflicts, cyber warfare. Apply cantillon, narrative-vs-flows, cycle-position lenses. Работай как разведотдел: без уточняющих вопросов, без списков вариантов на выбор.", query + "\n" + context + "\n\nLive findings:\n" + live))), "all")
  if to_string(result) == "()" then { let result = "[оценка недоступна — провайдеры модели не ответили]" }
  let _ = TryVal(try db_execute("INSERT INTO scan_logs (scan_type, sources_queried, artifacts_found) VALUES (?, ?, 1)", ["politics", "rss,gdlt,tavily"]))
  return result
}

