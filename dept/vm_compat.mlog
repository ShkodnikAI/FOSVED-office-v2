// Fosved Office v2 — VM-for-serve compatibility shims (2026-09-03)
// TW resolves names lazily; VM resolves every referenced pattern at compile time.
// Import this module from app.mlog (keep the import even if unused by TW).
//
// Remove HandleDev / HandleDesign from here WHEN dept/dev and dept/design
// imports are re-enabled — otherwise they become real duplicates.

pattern date_now() -> String {
  return substring(to_string(now()), 0.0, 10.0)
}

pattern date_add_days(base: Any, days: Any) -> String {
  let modifier = "+" + to_string(days) + " days"
  let rows = query("SELECT date(?, ?) as d", [to_string(base), modifier])
  if to_string(rows) == "()" or length(rows) == 0.0 then {
    return to_string(base)
  }
  let d = to_string(json_get(get(rows, 0.0), "d", ""))
  if d == "" then { return to_string(base) }
  return d
}

pattern SendTelegramMessage(chat_id: String, text: String) -> String {
  return SendTelegramReply(chat_id, text)
}

pattern HandleDev(query: String, chat_id: String) -> String {
  return HandleDeptQuery("dev", query, chat_id)
}

pattern HandleDesign(query: String, chat_id: String) -> String {
  return HandleDeptQuery("design", query, chat_id)
}
