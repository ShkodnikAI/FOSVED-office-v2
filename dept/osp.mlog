test "n625 budget: исчерпанный дневной лимит — EXCEEDED до всякого LLM-вызова" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "")
      // #664: лимит выставляется ЯВНО — тест не зависит от дефолта/сева/миграции
      let _ = OSPW3Setting("daily_budget_osp", "2.00")
      let day = OSPDayUtc()
      let _ = kv_set("daily_budget_osp_used:" + day, "2.0")
      assert_contains(OSPEnsemble("вопрос про бюджет ансамбля"), "EXCEEDED|")
      // W2-пометка оседает на карточке через OSPEnsembleApply
      let _ = kv_set("daily_budget_osp_used:" + day, "0")
      let _ = OSPW3Setting("daily_budget_osp", "10.00")
  }}

test "n625 base rate — поправка 1: n≥10 подаётся, n<10 НЕ подаётся" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let q = "решение ФРС по ключевой ставке n625"
      let dom = OSPClassifyDomain(q)
      let _ = OSPW2SeedBaseRate(dom, 12.0, 0.9)
      assert_contains(OSPBaseRate(q), "OK|0.9|12")
      assert_contains(OSPBaseRateBlock(q), "БАЗОВАЯ ЧАСТОТА")
      // MUT-мишень поправки 1: убрать проверку n<10 — блок появится и здесь.
      // q2 — другой класс (general, без денежных маркеров), чтобы строка
      // находилась классификацией, а не проваливалась поиском
      let q2 = "структурный вопрос n625 малая выборка класса"
      let dom2 = OSPClassifyDomain(q2)
      let _ = OSPW2SeedBaseRate(dom2, 5.0, 0.5)
      assert_eq(OSPBaseRate(q2), "NONE")
      assert_eq(OSPBaseRateBlock(q2), "")
  }}

test "n625 G3: разброс больше 0.25 при трёх прогонах — карточка не публикуется" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      let drows = query("SELECT date('now', '+30 days') AS rb, date('now', '-1 day') AS ao", [])
      let rb = to_string(json_get(get(drows, 0.0), "rb", ""))
      let ao = to_string(json_get(get(drows, 0.0), "ao", ""))
      let saved = OSPSaveCard("n625 G3-вопрос уникальный", 0.5, "Критерий наблюдаемый: значение индекса опубликовано Росстатом", ao, rb, "[\"https://rosstat.gov.ru\"]", -1, "", -1.0, "", "[]", "[]", 1)
      let id = to_float(get(split(saved, "|"), 1.0))
      // MUT-мишень: порог G3 0.25 — при 0.367 карточка обязана остаться gated
      let g = OSPEnsembleApply(id, "OK|3|0.5|0.5|0.49|0.367|0|{\"runs\":[]}", -1.0, "")
      assert_contains(g, "GATED|")
      assert_contains(g, "G3 разброс ансамбля 0.367")
      let rows = query("SELECT p_spread, n_runs, p_ensemble FROM osp_forecast WHERE id = ?", [to_string(id)])
      assert_eq(OSPFmt3(to_float(to_string(json_get(get(rows, 0.0), "p_spread", "0")))), "0.367")
      assert_eq(to_float(to_string(json_get(get(rows, 0.0), "n_runs", "0"))), 3.0)
  }}

test "n625 G3 pass: разброс 0.1 при трёх прогонах — p_base = mean, поля записаны" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      let drows = query("SELECT date('now', '+30 days') AS rb, date('now', '-1 day') AS ao", [])
      let rb = to_string(json_get(get(drows, 0.0), "rb", ""))
      let ao = to_string(json_get(get(drows, 0.0), "ao", ""))
      let saved = OSPSaveCard("n625 G3-pass вопрос уникальный", 0.4, "Критерий наблюдаемый: решение опубликовано протоколом комитета", ao, rb, "[\"https://example.org/n625\"]", -1, "", -1.0, "", "[]", "[]", 1)
      let id = to_float(get(split(saved, "|"), 1.0))
      let g = OSPEnsembleApply(id, "OK|3|0.55|0.5|0.54|0.1|0|{\"runs\":[]}", -1.0, "")
      assert_contains(g, "OK|0.55|")
      assert_contains(g, "g3")
      let rows = query("SELECT p_ensemble, p_median, n_runs, models_json FROM osp_forecast WHERE id = ?", [to_string(id)])
      assert_eq(OSPFmt3(to_float(to_string(json_get(get(rows, 0.0), "p_ensemble", "0")))), "0.550")
      assert_eq(OSPFmt3(to_float(to_string(json_get(get(rows, 0.0), "p_median", "0")))), "0.500")
      assert_eq(to_float(to_string(json_get(get(rows, 0.0), "n_runs", "0"))), 3.0)
  }}

test "n625 G6prime на карточке: 0.4 без обоснования — gated; с обоснованием — published+W6" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      let drows = query("SELECT date('now', '+30 days') AS rb, date('now', '-1 day') AS ao", [])
      let rb = to_string(json_get(get(drows, 0.0), "rb", ""))
      let ao = to_string(json_get(get(drows, 0.0), "ao", ""))
      // MUT-мишень наряда: убрать обязательность market_dissent_reason
      let s1 = OSPSaveCard("n625 рынок-вопрос без обоснования уникальный", 0.5, "Критерий: официальная котировка закрытия на бирже опубликована", ao, rb, "[\"https://example.org/mkt1\"]", -1, "", 0.1, "", "[]", "[]", 1)
      assert_contains(s1, "GATED|")
      assert_contains(s1, "G6prime")
      let s2 = OSPSaveCard("n625 рынок-вопрос с обоснованием уникальный", 0.5, "Критерий: официальная котировка закрытия на бирже опубликована", ao, rb, "[\"https://example.org/mkt2\"]", -1, "", 0.1, "биржевой объём упал на 40% — котировка неинформативна", "[]", "[]", 1)
      assert_contains(s2, "OK|")
      assert_contains(s2, "|published|p_final=0.5")
      let id2 = to_float(get(split(s2, "|"), 1.0))
      let rows = query("SELECT gate_report, market_dissent_reason FROM osp_forecast WHERE id = ?", [to_string(id2)])
      assert_contains(to_string(json_get(get(rows, 0.0), "gate_report", "")), "w6")
      assert_contains(to_string(json_get(get(rows, 0.0), "market_dissent_reason", "")), "40%")
      // W3 — 0.25 внутри окна
      let s3 = OSPSaveCard("n625 рынок-вопрос W3 уникальный", 0.5, "Критерий: официальная котировка закрытия на бирже опубликована", ao, rb, "[\"https://example.org/mkt3\"]", -1, "", 0.25, "", "[]", "[]", 1)
      assert_contains(s3, "OK|")
      let id3 = to_float(get(split(s3, "|"), 1.0))
      let rows3 = query("SELECT gate_report FROM osp_forecast WHERE id = ?", [to_string(id3)])
      assert_contains(to_string(json_get(get(rows3, 0.0), "gate_report", "")), "w3")
  }}

