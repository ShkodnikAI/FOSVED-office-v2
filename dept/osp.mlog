test "n624: G1 хвост — валидный, MISS, битый JSON, неполная форма" {
  let ok = "Проза прогноза.\nCARD: {\"p\":0.25,\"resolution_criteria\":\"Верхняя граница диапазона FOMC ниже 3.50% по итогам заседания\",\"resolve_by\":\"2027-06-30\",\"as_of\":\"2026-11-01\"}"
  assert_contains(OSPFExtractCard(ok), "OK|")
  assert_eq(OSPFExtractCard("Проза без хвоста."), "MISS")
  assert_contains(OSPFExtractCard("Проза.\nCARD: {\"p\":0.25, незакрыто"), "FAIL|json не разобран")
  assert_contains(OSPFExtractCard("Проза.\nCARD: {\"p\":0.25}"), "FAIL|форма хвоста")
  assert_eq(contains(OSPFStripCard(ok), "CARD:"), false)
  assert_contains(OSPFStripCard(ok), "Проза прогноза.")
}

test "n624: клип, метка Кента, дециль — программа, не модель" {
  assert_eq(OSPClip(0.5), 0.5)
  assert_eq(OSPClip(0.001), 0.02)
  assert_eq(OSPClip(0.999), 0.98)
  assert_eq(OSPKentOf(0.202), "маловероятно (20-35%)")
  assert_eq(OSPKentOf(0.72), "вероятно (65-80%)")
  assert_eq(OSPKentOf(0.99), "почти наверняка (95-100%)")
  assert_eq(OSPBucketOf(0.05), 1.0)
  assert_eq(OSPBucketOf(0.15), 2.0)
  assert_eq(OSPBucketOf(0.25), 3.0)
  assert_eq(OSPBucketOf(0.99), 10.0)
}

test "n624: гейты G2/G5 — короткий критерий, даты, пустые источники" {
  // Изолированный python-гвард запускает файл без DATABASE_URL: БД нет —
  // честный SKIP; полная проверка — в прогоне mlog test app.mlog (CI)
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {

      let crit = "Верхняя граница целевого диапазона FOMC по итогам последнего заседания 2026 года ниже 3.50%"
      let drows = query("SELECT date('now', '+30 days') AS rb, date('now', '-1 day') AS ao, date('now', '-400 days') AS old, date('now', '+10 days') AS future", [])
      let rb = to_string(json_get(get(drows, 0.0), "rb", ""))
      let ao = to_string(json_get(get(drows, 0.0), "ao", ""))
      let old = to_string(json_get(get(drows, 0.0), "old", ""))
      let future = to_string(json_get(get(drows, 0.0), "future", ""))
      assert_contains(OSPCardGates("коротко", rb, ao, "[\"https://x\"]"), "FAIL: G2 критерий")
      assert_contains(OSPCardGates(crit, old, ao, "[\"https://x\"]"), "FAIL: G2 resolve_by в прошлом")
      assert_contains(OSPCardGates(crit, "31.12.2026", ao, "[\"https://x\"]"), "FAIL: G2 resolve_by не ISO")
      assert_contains(OSPCardGates(crit, rb, future, "[\"https://x\"]"), "FAIL: G2 as_of в будущем")
      assert_contains(OSPCardGates(crit, rb, "завтра", "[\"https://x\"]"), "FAIL: G2 as_of не ISO")
      assert_contains(OSPCardGates(crit, rb, ao, "[]"), "FAIL: G5")
      assert_eq(OSPCardGates(crit, rb, ao, "[\"https://fred.stlouisfed.org/series/DFF\"]"), "PASS")

  }}

test "n624: автомат — инвариант 1 (публикация мимо гейтов невозможна), терминальные" {
  assert_eq(OSPCanTransition("drafted", "gated"), "OK")
  assert_eq(OSPCanTransition("gated", "published"), "OK")
  assert_eq(OSPCanTransition("gated", "drafted"), "OK")
  assert_eq(OSPCanTransition("published", "watching"), "OK")
  assert_eq(OSPCanTransition("watching", "resolved"), "OK")
  assert_contains(OSPCanTransition("drafted", "published"), "NO")
  assert_contains(OSPCanTransition("resolved", "published"), "NO: resolved — терминальный")
  assert_contains(OSPCanTransition("watching", "watching"), "NO: переход в себя")
}

test "n624: OSPSaveCard сквозной — p_final, Кент, дециль, события, analysis, full_result" {
  // Изолированный python-гвард запускает файл без DATABASE_URL: БД нет —
  // честный SKIP; полная проверка — в прогоне mlog test app.mlog (CI)
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {

      let _ = OSPFTestTables()
      // #625 W2: ансамбль выключен в тестах — ноль LLM-вызовов, карточка по p_raw
      let _ = kv_set("osp_ensemble_models", "off")
      let drows = query("SELECT date('now', '+30 days') AS rb, date('now', '-1 day') AS ao", [])
      let rb = to_string(json_get(get(drows, 0.0), "rb", ""))
      let ao = to_string(json_get(get(drows, 0.0), "ao", ""))
      let aid = OSPDraftAnalysis("n624 сквозной вопрос о ставке", "deep", "monetary", 3)
      let saved = OSPSaveCard("n624 сквозной вопрос о ставке (карточка)", 0.25, "Ставка ниже 3.50% по итогам последнего заседания FOMC 2026 года", ao, rb, "[\"https://fred.stlouisfed.org/series/DFF\"]", aid, "проза прогона для visual", -1.0, "", "[]", "[]", 1)
      assert_contains(saved, "OK|")
      assert_contains(saved, "|published|p_final=0.25")
      let id = to_float(get(split(saved, "|"), 1.0))
      let rows = query("SELECT status, p_final, kent_label, cal_bucket, p_ensemble, n_runs FROM osp_forecast WHERE id = ?", [to_string(id)])
      assert_eq(length(rows), 1.0)
      let r = get(rows, 0.0)
      assert_eq(to_string(json_get(r, "status", "?")), "published")
      assert_eq(to_float(to_string(json_get(r, "p_final", "0"))), 0.25)
      assert_eq(to_string(json_get(r, "kent_label", "?")), "маловероятно (20-35%)")
      assert_eq(to_float(to_string(json_get(r, "cal_bucket", "0"))), 3.0)
      assert_eq(to_float(to_string(json_get(r, "p_ensemble", "0"))), 0.25)
      assert_eq(to_float(to_string(json_get(r, "n_runs", "0"))), 1.0)
      // ≥2 события (создание + gated + published) — инвариант 4
      let ev = query("SELECT COUNT(*) AS n FROM osp_forecast_events WHERE forecast_id = ?", [to_string(id)])
      assert_eq(to_float(to_string(json_get(get(ev, 0.0), "n", "0"))) >= 2.0, true)
      // связь analysis ↔ карточка + первый писатель full_result
      let arows = query("SELECT osp_forecast_id, full_result FROM analysis WHERE id = ?", [to_string(aid)])
      assert_eq(to_string(json_get(get(arows, 0.0), "osp_forecast_id", "?")), to_string(id))
      assert_eq(to_string(json_get(get(arows, 0.0), "full_result", "?")), "проза прогона для visual")
      // отказ перехода — тоже событие (REFUSED>)
      let ref1 = OSPTransition(id, "gated", "проба прямого перевода", "n624")
      assert_contains(ref1, "NO|")
      let refused = query("SELECT COUNT(*) AS n FROM osp_forecast_events WHERE forecast_id = ? AND to_status LIKE 'REFUSED>%'", [to_string(id)])
      assert_eq(to_float(to_string(json_get(get(refused, 0.0), "n", "0"))) >= 1.0, true)
      // вахта и подсказка следующего действия
      let _ = OSPTransition(id, "watching", "вахта по горизонту", "n624")
      assert_contains(OSPNextAction(id), "ждать исхода")
      // ответ владельцу — из строки БД
      assert_contains(OSPFCardLine(id), "p=0.25")
      assert_contains(OSPFCardLine(id), "watching")

  }}

test "n624: G2-провал — карточка в gated, p_final не пишется, причина в событиях" {
  // Изолированный python-гвард запускает файл без DATABASE_URL: БД нет —
  // честный SKIP; полная проверка — в прогоне mlog test app.mlog (CI)
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {

      // #625 W2: ансамбль выключен в тестах — ноль LLM-вызовов
      let _ = kv_set("osp_ensemble_models", "off")
      let drows = query("SELECT date('now', '+30 days') AS rb, date('now', '-1 day') AS ao", [])
      let rb = to_string(json_get(get(drows, 0.0), "rb", ""))
      let ao = to_string(json_get(get(drows, 0.0), "ao", ""))
      let saved = OSPSaveCard("n624 gated-вопрос уникальный", 0.6, "коротко", ao, rb, "[\"https://x\"]", -1, "", -1.0, "", "[]", "[]", 1)
      assert_contains(saved, "GATED|")
      assert_contains(saved, "FAIL: G2 критерий")
      let id = to_float(get(split(saved, "|"), 1.0))
      let rows = query("SELECT status, p_final FROM osp_forecast WHERE id = ?", [to_string(id)])
      assert_eq(to_string(json_get(get(rows, 0.0), "status", "?")), "gated")
      // p_final не пишется: json_get на NULL возвращает дефолт — дефолт вернулся
      assert_eq(to_string(json_get(get(rows, 0.0), "p_final", "NOTNULL")), "NOTNULL")
      // и p вне [0,1] — тоже gated (G1-арифметика)
      let saved2 = OSPSaveCard("n624 p-вне-диапазона уникальный", 1.5, "Ставка ниже 3.50% по итогам последнего заседания FOMC 2026 года", ao, rb, "[\"https://x\"]", -1, "", -1.0, "", "[]", "[]", 1)
      assert_contains(saved2, "GATED|")
      assert_contains(saved2, "p вне [0,1]")

  }}

test "n624: писатель research_source — URL из живого контекста, с as_of" {
  // Изолированный python-гвард запускает файл без DATABASE_URL: БД нет —
  // честный SKIP; полная проверка — в прогоне mlog test app.mlog (CI)
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {

      let _ = OSPFTestTables()
      let ctx = "=== Консультация: lz/factpack ===\n[LIVE]\n• https://fred.stlouisfed.org/series/DFF — эффективная ставка ФРС\n• https://www.reuters.com/markets/xyz-abc — сводка рынка\nбез ссылки здесь\n"
      let aid = OSPDraftAnalysis("n624 research-вопрос", "deep", "monetary", 3)
      let sj = OSPFSourcesToDB(ctx, aid, "2026-11-04")
      assert_contains(sj, "https://fred.stlouisfed.org/series/DFF")
      assert_contains(sj, "https://www.reuters.com/markets/xyz-abc")
      let rows = query("SELECT COUNT(*) AS n FROM research_source WHERE analysis_id = ? AND as_of = '2026-11-04'", [to_string(aid)])
      assert_eq(to_float(to_string(json_get(get(rows, 0.0), "n", "0"))), 2.0)
      // пустой контекст → [] → G5 честно оставит карточку в gated
      assert_eq(OSPFURLsFrom("текст без ссылок"), "")
      assert_eq(OSPFSourcesToDB("текст без ссылок", aid, "2026-11-04"), "[]")

  }}

