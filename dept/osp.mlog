// ═══════════════════════════════════════════════════════════════════════
// CROSS-DEPARTMENT ROUTING
// ═══════════════════════════════════════════════════════════════════════
// #446 (решение владельца 2026-10-02, классы B+C — убрать): прямые HTTP-мосты
// OSPRouteToFinance/Expert/LZ/Legal вычищены — все четыре вели на
// несуществующие Flask-роуты (:4000/dept/*), ошибки глотались, носители
// недостижимы из прода (DEAD/STRING_ONLY по реестру #449). Если межотдельное
// ОСП-маршрутизация понадобится — строить через живой механизм цепочек
// /chain/step (:10001, chain_parallel/chain_durable), не прямыми HTTP-роутами.
// Гвард: tests/test_n446_bridges.py + scripts/deadcall_detector.py в CI.

// ═══════════════════════════════════════════════════════════════════════
// MAIN DISPATCHER
// ═══════════════════════════════════════════════════════════════════════
pattern HandleOSP(query: String, chat_id: String) -> String {
  let dept = "osp"
  let t = lower(query)
  // TEAM-1 #480: сброс бюджетов командной работы на новый запрос
  // владельца (консультации, LLM-вызовы, стек глубины, тихий флаг)
  let _ = TeamBudgetReset()

  // ── Depth routing ──
  if starts_with(t, "/osp quick") or starts_with(t, "/osp fast") then { return OSPQuickAnalyze(substring(query, 10, 300), chat_id) }
  if starts_with(t, "/osp deep") then { return OSPDeepAnalyze(substring(query, 9, 300), chat_id) }
  if starts_with(t, "/osp full") then { return OSPFullAnalyze(substring(query, 9, 300), chat_id) }
  if starts_with(t, "/osp wargame") then { return OSPWargame(substring(query, 12, 300), chat_id) }

  // ── Domain modes ──
  if starts_with(t, "/osp regime") then { return OSPRegimeScan(substring(query, 11, 300), chat_id) }
  if starts_with(t, "/osp cantillon") then { return OSPCantillonScan(substring(query, 13, 300), chat_id) }
  if starts_with(t, "/osp narrative") then { return OSPNarrativeScan(substring(query, 13, 300), chat_id) }

  // ── Verification & calibration ──
  if starts_with(t, "/osp verify") then { return OSPVerify(substring(query, 11, 300), chat_id) }
  // #625 W2: касание владельца — исход подтверждается одной строкой;
  // модель исход не судит, парс программный (OSPParseOutcome)
  if starts_with(t, "/osp resolve") then { return OSPResolveCommand(substring(query, 12, 300), chat_id) }
  // #625 W2 §5.4: /osp score — программный блок СНАЧАЛА, проза модели после;
  // OSPCalibrationScore — модель сочиняла оценку — заменён (§7.3)
  if starts_with(t, "/osp score") or starts_with(t, "/osp brier") then { return OSPScoreCommand(chat_id) }
  if starts_with(t, "/osp recalibrate") then { return OSPRecalibrate(chat_id) }
  // #627 W4: кривая калибровки (картинка chart_line документом) и доска A/B
  if starts_with(t, "/osp curve") then { return OSPCurveCommand(substring(query, 10, 300), chat_id) }
  if starts_with(t, "/osp methods") or starts_with(t, "/osp ab") then { return OSPMethodABCommand(chat_id) }
  if starts_with(t, "/osp bet") then { return OSPRegisterBet(substring(query, 8, 300), chat_id) }

  // ── Red team ──
  if starts_with(t, "/osp redteam") or starts_with(t, "/osp red-team") then { return OSPRedteam(substring(query, 12, 300), chat_id) }

  // ── I&W Watchlist ──
  if starts_with(t, "/osp watch") then { return OSPWatch(substring(query, 10, 300), chat_id) }
  if starts_with(t, "/osp unwatch") then { return OSPUnwatch(substring(query, 12, 300), chat_id) }

  // ── Profile ──
  if starts_with(t, "/osp profile") then { return OSPProfile(substring(query, 12, 300), chat_id) }

  // ── Search ──
  if starts_with(t, "/osp tavily") then { return OSPTavilySearch(substring(query, 10, 300), chat_id) }
  if starts_with(t, "/osp tg") or starts_with(t, "/osp telegram") then { return OSPTelegramSearch(substring(query, 7, 300), chat_id) }

  // ── Default ──
  let domain = OSPClassifyDomain(query)
  let depth = OSPAutoEscalate(query, 1)
  let context = BuildOSPContext(query, domain, chat_id, depth)
  let context = OSPDisclaimer() + "\n\n" + context + "\n\n=== PROJECT PARAMS ===\nDepth: " + to_string(depth) + " Domain: " + domain + "\n"
  let llm_result = redact(to_string(TryVal(try call_llm(context, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)
  // TEAM-2 #481 A.3: маркеры ASK — консультации коллег и второй проход
  // до гейтов качества; маркеры не доходят владельцу
  let enhanced = TeamSecondPass(dept, query, context, reply)
  if enhanced != "" then { let reply = enhanced }
  // W4 #627: g1–g12 удалены (§7.3) — структурные проверки живут в карточном
  // контуре (OSPSaveCard → OSPMethodsGate), здесь — safety и LLM-verifier
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  // ── LLM-Verifier: confidence scoring for strategic analysis ──
  let ov_resp = TryVal(try call_python("llm_verifier", "score", json_encode([query, reply, "Analytical rigor: Logic and evidence quality? Probability calibration: Reasonable confidence levels? Actionability: Decision-relevant conclusions?"])))
  let mut ov_score = 0.0
  if to_string(ov_resp) != "()" and contains(to_string(ov_resp), "error") == false then {
    let ov_parsed = TryVal(try parse_json(ov_resp))
    let ov_score = to_float(TryVal(try json_get(ov_parsed, "result", "0.5")))
    let _ = AuditLog("osp_verify_score", dept, "score=" + to_string(ov_score) + " domain=" + domain + " depth=" + to_string(depth))
  }
  let reply = reply + "\n\n" + OSPDisclaimerBottom() + OSPSourcesFooter(context)
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  let _ = AuditLog("dept_query", dept, "domain=" + domain + " depth=" + to_string(depth) + " safety=" + safety + " verify=" + to_string(ov_score))
  return reply
}

// Подвал со списком реально использованных источников — построен по
// меткам в context. FRED-метка условная (появляется только если
// реально запрашивался, monetary/financial) — простая проверка
// contains() надёжна. "=== News ===" заголовок в контексте есть
// ВСЕГДА (даже при пустом результате), поэтому для него проверяем не
// сам заголовок, а есть ли за ним реальный текст, не только пустота
// до следующей секции.
pattern OSPSourcesFooter(context: String) -> String {
  let mut lines = ""
  let news_start = index_of(context, "=== News ===\n")
  if news_start >= 0.0 then {
    let after = substring(context, news_start + 13.0, length(context))
    let news_end = index_of(after, "\n\n===")
    let mut news_body = after
    if news_end >= 0.0 then { let news_body = substring(after, 0.0, news_end) }
    if length(trim(news_body)) > 20.0 then {
      let lines = lines + "\n· Новостной поиск (RSS)"
    }
  }
  // Наряд #423 A.2 → TEAM-1 #480 A.6: секция разведсводки ЛЗ — только
  // когда консультация реально вошла в контекст. С результатами — имя
  // источника; при отказе — точная причина (преемственность честного
  // правила #423 A.3), владельцу видно, почему разведсводки в ответе нет.
  let fact_start = index_of(context, "=== Консультация: lz/factpack ===")
  if fact_start >= 0.0 then {
    let after = substring(context, fact_start + 33.0, length(context))
    let fact_end = index_of(after, "\n\n===")
    let mut fact_body = after
    if fact_end >= 0.0 then { let fact_body = substring(after, 0.0, fact_end) }
    if contains(fact_body, "•") then {
      let lines = lines + "\n· ЛЗ (разведсводка)"
    } else {
      if length(trim(fact_body)) > 0.0 then {
        let lines = lines + "\n· ЛЗ (разведсводка): " + trim(fact_body)
      }
    }
  }
  // #468 A.1: FRED в подвале — только если реально получен хотя бы один
  // ряд; при полном отказе — точная причина (из первой отказной строки
  // FRED-блока), а не имя источника при нулевых данных (дефект отчёта
  // OSP-GOLD-01: подвал «Источники: FRED» при всех рядах «недоступно»).
  let fred_start = index_of(context, "=== FRED (макроданные) ===")
  if fred_start >= 0.0 then {
    let after = substring(context, fred_start + 26.0, length(context))
    let fred_end = index_of(after, "\n\n===")
    let mut fred_body = after
    if fred_end >= 0.0 then { let fred_body = substring(after, 0.0, fred_end) }
    let mut has_data = false
    let mut first_cause = ""
    each ln in split(trim(fred_body), "\n") {
      let l = trim(ln)
      if length(l) > 0.0 then {
        if contains(l, "недоступно") then {
          if first_cause == "" then {
            let cidx = index_of(l, "недоступно (")
            if cidx >= 0.0 then {
              let rest = substring(l, cidx + 12.0, length(l))
              let cend = index_of(rest, ")")
              let first_cause = trim(rest)
              if cend > 0.0 then { let first_cause = trim(substring(rest, 0.0, cend)) }
            }
          }
        } else {
          let has_data = true
        }
      }
    }
    if has_data then {
      let lines = lines + "\n· FRED (макроданные: доходность облигаций, ставка ФРС, инфляция)"
    } else {
      if first_cause == "" then {
        let lines = lines + "\n· FRED недоступен (данные не получены)"
      } else {
        let lines = lines + "\n· FRED недоступен: " + first_cause
      }
    }
  }
  if length(lines) == 0.0 then { return "" }
  return "\n\n---\n**Источники:**" + lines
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN CLASSIFIER
// ═══════════════════════════════════════════════════════════════════════
pattern OSPClassifyDomain(query: String) -> String {
  let t = lower(query)
  if contains(t, "рынок") or contains(t, "актив") or contains(t, "валют") or contains(t, "акци") or contains(t, "облигац") or contains(t, "крипто") or contains(t, "нефт") or contains(t, "золот") or contains(t, "gold") or contains(t, "vix") then { return "financial" }
  if contains(t, "ставк") or contains(t, "инфляци") or contains(t, "рецесси") or contains(t, "стагфляци") or contains(t, "эмисси") or contains(t, "центробанк") or contains(t, "фрс") or contains(t, "есб") or contains(t, "ввп") or contains(t, "gdp") then { return "monetary" }
  if contains(t, "геополитик") or contains(t, "альянс") or contains(t, "санкци") or contains(t, "nato") or contains(t, "нато") or contains(t, "брикс") or contains(t, "войн") or contains(t, "конфликт") then { return "geopolitical" }
  if contains(t, "армия") or contains(t, "вооружен") or contains(t, "фронт") or contains(t, "ракет") or contains(t, "ядерн") then { return "military" }
  if contains(t, "компани") or contains(t, "корпорац") or contains(t, "стратег") or contains(t, "конкурент") then { return "corporate" }
  if contains(t, "президент") or contains(t, "выбор") or contains(t, "парламент") then { return "political" }
  return "general"
}

// ═══════════════════════════════════════════════════════════════════════
// LIVE SEARCH — наряд #474: поиск по умолчанию, исключения — списком
// ═══════════════════════════════════════════════════════════════════════
// Инцидент OSP-2026-10-05-PLAGUE-01 (#474): белый список доменов и слов
// (#423/#467) слеп к каждому новому классу вопросов — эпидемиология,
// ЧС, техногенные аварии, природные бедствия в списке отсутствовали,
// и ОСП выдал успокаивающий прогноз по уже случившемуся событию
// (P=92% сценарию «ноль случаев», опровергнутому за 3 дня до выдачи).
// Правило перевёрнуто: живой поиск — для КАЖДОГО анализа ОСП; пропуск —
// только для явно вневременных вопросов, коротким списком исключений.
// Неуверенность → поиск (default ON): ложный пропуск стоит отчёта,
// ложный вызов — только кредита. Форма бюджетной защиты — дневной
// бюджет Tavily + кэш ответов (utils.mlog), не словарь: новый класс
// вопросов больше не требует правки списка.
pattern OSPSkipLiveSearch(query: String) -> Bool {
  let t = lower(query)
  // Якорь текущего момента перебивает вневременной маркер:
  // «история и текущее состояние нефти сегодня» — событийный вопрос.
  if contains(t, "сейчас") or contains(t, "сегодня") or contains(t, "вчера") or contains(t, "последние") or contains(t, "новости") or contains(t, "на этой неделе") or contains(t, "на 20") then { return false }
  // Явно вневременные классы: теория, методология, история, определения,
  // принципы устройств/концепций. Список СОЗНАТЕЛЬНО короткий (#474 A.1).
  return contains(t, "теория") or contains(t, "теорет") or contains(t, "методолог") or contains(t, "история") or contains(t, "концепц") or contains(t, "определен") or contains(t, "принцип работ") or contains(t, "как устроен")
}

// Живой поиск в обычном пути. Транспорт — общий TavilySearch (utils.mlog,
// office#354), красные поля — redact внутри TavilyFormatBlock (урок №268).
// Каждый отказ называет точную причину: подвал источников показывает её
// владельцу как есть, без общего «недоступен» (A.3 наряда #423).
pattern OSPLiveSearchBlock(query: String) -> String {
  // Белорусская тематика: запрос дополняется контекстом страны —
  // иначе выдача по «кадровые перестановки» без гео-контекста релевантности
  // не даёт (A.1 наряда #423; релевантность выдачи — smoke владельца).
  let t = lower(query)
  let mut q = query
  if contains(t, "беларус") or contains(t, "минск") or contains(t, "лукашенко") then {
    let q = query + " Беларусь"
  }
  if trim(TavilyKey()) == "" then { return "(живой поиск не выполнен: ключ Tavily не задан)" }
  let response = TavilySearch(q, "osp")
  // #474: бюджетная форма — исчерпание дневного бюджета называется
  // честно, как и остальные отказы (не «сеть недоступна»).
  if response == "(budget)" then { return "(живой поиск не выполнен: дневной бюджет Tavily исчерпан — OSP_TAVILY_DAILY_BUDGET)" }
  if response == "()" then { return "(живой поиск не выполнен: сеть Tavily недоступна)" }
  let parsed = TryVal(try parse_json(response))
  if to_string(parsed) == "()" then { return "(живой поиск не выполнен: ответ Tavily не распознан)" }
  let block = TavilyFormatBlock(response)
  if block == "" then { return "(живой поиск вернул 0 результатов)" }
  return block
}

// ═══════════════════════════════════════════════════════════════════════
// #474 A.2: гейт актуальности — риск-вопрос без свежих данных не даёт
// вероятностей; со свежими данными отчёт открывается «Что произошло сейчас»
// ═══════════════════════════════════════════════════════════════════════
// Риск-вопрос? Маркеры текущих рисков и событий: эпидемиология, ЧС,
// техногенные аварии, природные бедствия, конфликт — классы, на которых
// белый список #423 ослеп (инцидент OSP-2026-10-05-PLAGUE-01: вопрос
// «вероятность эпидемии чумы» не содержал ни одного маркера старого
// списка). Расширение — правкой этого списка, гварды — тесты #474.
pattern OSPIsCurrentRiskQuestion(query: String) -> Bool {
  let t = lower(query)
  return contains(t, "вероятност") or contains(t, "риск") or contains(t, "опасно") or contains(t, "угроз") or contains(t, "прогноз") or contains(t, "что будет") or contains(t, "есть ли") or contains(t, "случил") or contains(t, "произош") or contains(t, "вспышк") or contains(t, "эпидем") or contains(t, "пандем") or contains(t, "карантин") or contains(t, "зараж") or contains(t, "катастроф") or contains(t, "авари") or contains(t, "наводнен") or contains(t, "землетрясен") or contains(t, "цунами") or contains(t, "пожар") or contains(t, "конфликт") or contains(t, "войн") or contains(t, "вторжен") or contains(t, "атак") or contains(t, "обстрел") or contains(t, "ракет") or contains(t, "ядерн")
}

// Гейт актуальности. Свежесть — ТОЛЬКО по живому поиску: кэш новостей
// не показатель (фолбэк /news/fresh отдаёт generic-новости по категории,
// не по вопросу — вторая половина инцидента #474). attempted=false —
// вопрос признан вневременным и поиск не звался: гейт не судит.
pattern OSPFreshnessGate(query: String, live_raw: String, attempted: Bool) -> String {
  if OSPIsCurrentRiskQuestion(query) == false then { return "" }
  if attempted == false then { return "" }
  let live_ok = length(trim(live_raw)) > 0.0 and starts_with(live_raw, "(") == false
  if live_ok then {
    return "\n\n=== ГЕЙТ АКТУАЛЬНОСТИ ===\nСвежие данные есть — в разведсводке ЛЗ выше. Требования к отчёту: (1) открой отчёт разделом «Что произошло сейчас» — факты с датами и URL из секции LIVE разведсводки; (2) калибруй вероятности с их учётом; (3) противоречие с базовой моделью назови в начале отчёта явно, не в дисклеймере."
  }
  return "\n\n=== ГЕЙТ АКТУАЛЬНОСТИ: СВЕЖИХ ДАННЫХ НЕТ ===\nЖивой поиск не выполнен, вернул 0 или отказал (точная причина — в секции LIVE разведсводки выше). ЗАПРЕЩЕНО: таблицы вероятностей, сценарные P=, выводы уровня «экспозиция минимальна», «прямая угроза отсутствует», «нарратив тревоги опережает поток». ВЫДАЙ вместо прогноза: «нужна проверка свежих событий» + конкретный список, что именно проверить (источники, запросы, окно времени). Собственные оценки — только [ИНТЕРПРЕТАЦИЯ], без вероятностных таблиц."
}

// ═══════════════════════════════════════════════════════════════════════
// MARKET DATA — наряд #467: текущие цены для рыночных вопросов
// ═══════════════════════════════════════════════════════════════════════

// Распознавание актива в запросе. Возврат "kind|p1|p2|label" или "".
// Чистая функция — реальные кейсы в test-блоках внизу файла.
// Осторожные маркеры: «евро/eur» одиночкой не ловим («Европа/Europe»
// давали ложное срабатывание) — только в парах «курс евро», «доллар к евро».
pattern OSPMarketAsset(query: String) -> String {
  let t = lower(query)
  if contains(t, "биткоин") or contains(t, "bitcoin") or contains(t, "btc") then { return "crypto|bitcoin|usd|Биткоин (BTC/USD)" }
  if contains(t, "эфир") or contains(t, "ethereum") then { return "crypto|ethereum|usd|Эфир (ETH/USD)" }
  if contains(t, "золот") or contains(t, "gold") then { return "forex|xau|usd|Золото (XAU/USD)" }
  if contains(t, "серебр") or contains(t, "silver") then { return "forex|xag|usd|Серебро (XAG/USD)" }
  if contains(t, "нефт") or contains(t, "oil") or contains(t, "brent") or contains(t, "wti") then { return "" }
  if (contains(t, "курс") or contains(t, "цена") or contains(t, "стоит")) and (contains(t, "доллар") or contains(t, "usd")) then {
    if contains(t, "евро") or contains(t, "eur") then { return "forex|usd|eur|Доллар/евро (USD/EUR)" }
    if contains(t, "юань") or contains(t, "cny") then { return "forex|usd|cny|Доллар/юань (USD/CNY)" }
    if contains(t, "рубл") or contains(t, "rub") then { return "forex|usd|rub|Доллар/рубль (USD/RUB)" }
    return "forex|usd|byn|Доллар/белорусский рубль (USD/BYN)"
  }
  if (contains(t, "курс") or contains(t, "цена") or contains(t, "стоит")) and (contains(t, "евро") or contains(t, "eur")) then { return "forex|eur|usd|Евро/доллар (EUR/USD)" }
  if contains(t, "aapl") then { return "stock|AAPL||Apple (AAPL)" }
  if contains(t, "tsla") then { return "stock|TSLA||Tesla (TSLA)" }
  if contains(t, "nvda") then { return "stock|NVDA||Nvidia (NVDA)" }
  if contains(t, "gazp") then { return "stock|GAZP||Газпром (GAZP)" }
  return ""
}

pattern OSPMarketSource(kind: String) -> String {
  if kind == "crypto" then { return "CoinGecko" }
  if kind == "forex" or kind == "stock" then { return "Alpha Vantage" }
  return "markets MCP"
}

// Дата запроса (локальная зона) — для «текущее значение с датой» (#467).
pattern OSPNowDate() -> String {
  let dp = date_parts(now())
  let mo = to_string(dp.month)
  if length(mo) < 2.0 then { let mo = "0" + mo }
  let d = to_string(dp.day)
  if length(d) < 2.0 then { let d = "0" + d }
  return to_string(dp.year) + "-" + mo + "-" + d
}

// Рыночная секция контекста. Сначала MCP get_* (крипта — CoinGecko без
// ключа; forex/stock — Alpha Vantage, ключ ALPHAVANTAGE_API_KEY через шов
// AvKey() в utils.mlog); если ключ не задан или MCP отказал — Tavily-запрос
// «<актив> price today» (#467 A.1). Причина прямого отказа сохраняется в
// секции. Дата и источник — в каждой строке данных.
pattern OSPMarketDataBlock(query: String) -> String {
  let asset = OSPMarketAsset(query)
  if asset == "" then { return "" }
  let parts = split(asset, "|")
  let kind = get(parts, 0.0)
  let p1 = get(parts, 1.0)
  let p2 = get(parts, 2.0)
  let label = get(parts, 3.0)
  let need_key = kind != "crypto"
  let mut r_ok = false
  let mut r_body = ""
  let mut r_note = ""
  if need_key == false or trim(AvKey()) != "" then {
    let mut tool = ""
    let mut args_json = "{}"
    if kind == "crypto" then {
      let tool = "get_crypto_price"
      let args_json = json_encode({coin_id: p1, vs_currency: p2})
    }
    if kind == "forex" then {
      let tool = "get_forex_rate"
      let args_json = json_encode({from_currency: p1, to_currency: p2})
    }
    if kind == "stock" then {
      let tool = "get_stock_quote"
      let args_json = json_encode({symbol: p1})
    }
    let r = McpMarketsCall("osp", tool, args_json, "osp market data (#467)")
    let r_ok = r.ok
    let r_body = r.body
    let r_note = r.note
  }
  if r_ok == true then {
    let d = TryVal(try parse_json(r_body))
    let mut value = to_string(json_get(d, "price", ""))
    if kind == "forex" then { let value = to_string(json_get(d, "rate", "")) }
    let mut unit = "USD"
    if kind == "forex" then { let unit = upper(p2) }
    if trim(value) == "" or value == "0" or value == "0.0" then {
      // форма ответа не распознана — честно отдаём весь ответ сервера
      return "\n\n=== Рыночные данные ===\n" + label + ": " + r_body + " (источник: " + OSPMarketSource(kind) + ", " + OSPNowDate() + ")\n"
    }
    return "\n\n=== Рыночные данные ===\n" + label + ": " + value + " " + unit + " (источник: " + OSPMarketSource(kind) + ", дата: " + OSPNowDate() + ")\n"
  }
  // Прямой источник недоступен: точная причина (#467), затем Tavily-фолбэк
  let cause = r_body
  if trim(cause) == "" then { let cause = r_note }
  if need_key and trim(AvKey()) == "" then { let cause = "ALPHAVANTAGE_API_KEY не установлен" }
  let response = TavilySearch(label + " price today", "osp")
  // #474: исчерпание бюджета — честная причина, не «MCP недоступен»
  if response == "(budget)" then { let cause = cause + "; дневной бюджет Tavily исчерпан" }
  if response != "()" then {
    let block = TavilyFormatBlock(response)
    if block != "" then {
      return "\n\n=== Рыночные данные ===\n" + block + "(прямой источник " + label + " недоступен: " + cause + "; значение — живой поиск Tavily, " + OSPNowDate() + ")\n"
    }
  }
  if trim(cause) == "" then { let cause = "MCP-сервер markets недоступен" }
  return "\n\n=== Рыночные данные ===\n" + label + " недоступен (" + cause + ")\n"
}

// ═══════════════════════════════════════════════════════════════════════
// CONTEXT BUILDER
// ═══════════════════════════════════════════════════════════════════════
pattern BuildOSPContext(query: String, domain: String, chat_id: String, depth: Int) -> String {
  let profile = ReadDeptProfile("osp")
  // #623: реальный depth режима (0 quick … 4 full) идёт в загрузчик скиллов:
  // уровень нарезки L2/L3/L4 и бюджет — из глубины, не константа.
  let skills = LoadOSPEnrichedSkills(query, domain, depth)
  let corrections = GetCorrections("osp")
  let dialog = GetRecentDialog(chat_id, "10", "osp")
  let facts = GetFacts("osp", "12")
  let memories = YanaRecallMemories(query)
  let now_info = YanaNowInfo()
  let domain_kb = OSPDomainKB(domain)
  let news = ""
  let news_result = TryVal(try http_post("http://127.0.0.1:4000/news/fresh", json_encode({query: query, dept: "osp", limit: 5}), "application/json"))
  if to_string(news_result) != "()" then { let news = json_get(parse_json(news_result), "news", "") }
  // #474 A.1 → TEAM-1 #480 A.6: живой поиск — для КАЖДОГО анализа ОСП,
  // но через командную работу с ЛЗ (разведсводка factpack, ADR-0016)
  // вместо собственного Tavily-вызова. Пропуск — только вневременные
  // вопросы (OSPSkipLiveSearch); кэш и бюджет Tavily — общий шов
  // utils.mlog; сам /osp tavily остаётся прямым (OSPLiveSearchBlock).
  let mut live_raw = ""
  let mut live_attempted = false
  let mut factpack_block = ""
  if OSPSkipLiveSearch(query) == false then {
    let live_attempted = true
    let consult = TeamConsult("osp", "lz", "factpack", query, "")
    let factpack_block = "\n\n" + consult
    let live_raw = TeamExtractSection(consult, "[LIVE]", "[NEWS]")
  }
  // #474 A.2: гейт актуальности судит live-часть разведсводки ЛЗ
  // (та же скобка-причина — отказ, тот же "•" — свежие данные).
  // #474 A.2: гейт актуальности — риск-вопрос без свежих данных не
  // даёт вероятностей; со свежими — отчёт открывается разделом
  // «Что произошло сейчас».
  let fresh_gate = OSPFreshnessGate(query, live_raw, live_attempted)
  // FRED (McpMarketsCall) — для monetary/financial: общие RSS-ленты
  // /news/fresh не дают числовых макро-рядов (доходность облигаций,
  // ставка ФРС, инфляция) — это и была реальная причина отчёта-каркаса
  // без цифр по долгу США. Фиксированный набор ключевых рядов, не
  // произвольный (нет лишнего вызова модели на извлечение series_id).
  // #467 A.1: рыночная секция — текущее значение актива с датой и
  // источником (MCP get_*, при отказе/отсутствии ключа — Tavily
  // «<актив> price today»). Вплетается после FRED: гварды #423 требуют
  // Live Search между News и FRED, порядок секций модель видит целиком.
  let market_block = OSPMarketDataBlock(query)
  let fred_data = ""
  if domain == "monetary" or domain == "financial" then {
    let mut fred_lines = ""
    each series in ["DGS10", "FEDFUNDS", "CPIAUCSL"] {
      let r = McpMarketsCall("osp", "get_fred_series", json_encode({series_id: series, limit: 1}), "osp monetary/financial context")
      if r.ok == true then {
        let fred_lines = fred_lines + series + ": " + r.body + "\n"
      } else {
        // #467 A.2: настоящая причина — текст ошибки сервера (r.body, уже
        // под redact в McpMarketsCall); общий r.note — только если тела нет.
        let fred_cause = r.body
        if trim(fred_cause) == "" then { let fred_cause = r.note }
        let fred_lines = fred_lines + series + ": недоступно (" + fred_cause + ")\n"
      }
    }
    let fred_data = "\n\n=== FRED (макроданные) ===\n" + fred_lines
  }
  let s_mem = to_string(memories)
  if s_mem == "()" then { let s_mem = "" }
  let s_cor = to_string(corrections)
  if s_cor == "()" then { let s_cor = "" }
  let s_dlg = to_string(dialog)
  if s_dlg == "()" then { let s_dlg = "" }
  let s_facts = to_string(facts)
  if s_facts == "()" then { let s_facts = "" }
  let s_now = to_string(now_info)
  if s_now == "()" then { let s_now = "" }
  let s_sk = to_string(skills)
  if s_sk == "()" then { let s_sk = "" }
  let context = profile + "\n\n=== Дата ===\n" + s_now + "\n\n=== Domain: " + domain + " ===\n" + domain_kb + "\n\n=== Skills ===\n" + s_sk + "\n\n=== News ===\n" + news + factpack_block + fred_data + market_block + "\n\n=== Corrections ===\n" + s_cor + "\n\n=== Memory ===\n" + s_mem + "\n\n=== Консолидированные факты ===\n" + s_facts + "\n\n=== Dialog ===\n" + s_dlg + fresh_gate
  let context = context + "\n\n" + TeamAskBlock("osp")
  let context = context + "\n\n=== ПОВТОР: ДАТА ===\n" + s_now
  // TEAM-3 #482 A.3: доска находок (алерты ЛЗ — с подписью источника)
  let context = context + TeamBoardBlockOspAppended()
  return context
}

// TEAM-3 #482 A.3: помощник, чтобы не переименовывать накопленный context
pattern TeamBoardBlockOspAppended() -> String {
  let board_block = TeamBoardBlock("osp")
  if board_block == "" then { return "" }
  return "\n\n" + board_block
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN KB
// ═══════════════════════════════════════════════════════════════════════
pattern OSPDomainKB(domain: String) -> String {
  let kb = "ОСП V2: Корни→Стебель→Ветви→Плоды→Семена | P=A×R×S×L×E | [ФАКТ]/[ИНТЕРПРЕТАЦИЯ]/[СПЕКУЛЯЦИЯ] | Sherman Kent | Two-paths\n"
  if domain == "financial" then { let kb = kb + "Фокус: cross-asset divergence, asymmetric bet, antifragility, Cantillon\n" }
  if domain == "monetary" then { let kb = kb + "Фокус: macro regime, ЦБ actions, Cantillon, narrative-vs-flows, cycle position\n" }
  if domain == "geopolitical" then { let kb = kb + "Фокус: balance of power, narrative-vs-flows, order-of-battle, Schelling points, I&W\n" }
  if domain == "military" then { let kb = kb + "Фокус: OOB, phase transition, Schelling points, red team\n" }
  if domain == "corporate" then { let kb = kb + "Фокус: strategic maneuvers, forces, reflexive impact, decision tree\n" }
  if domain == "political" then { let kb = kb + "Фокус: deep profiling, narrative-vs-flows, cycle position, Cantillon\n" }
  return kb
}

// ═══════════════════════════════════════════════════════════════════════
// SKILL LOADING (3-tier)
// ═══════════════════════════════════════════════════════════════════════
pattern LoadOSPEnrichedSkills(query: String, domain: String, depth: Int) -> String {
  // #623 W0 (план v2 D3, поправка владельца 03.11): нарезка по секциям H2
  // через общий модуль dept/skills (SkillCoreSliced/SkillsAppend); уровень —
  // по depth режима (0→L2, 1→L3, 2–4→L4); бюджет — ПОСЛЕ добавления,
  // пропуск — громко в журнал (skill_skipped). Бюджеты: OSPSkillBudget.
  let t = lower(query)
  let mut result = ""
  let budget = OSPSkillBudget(depth)
  let level = SkillsLevelByDepth(depth)
  // Tier 1 — ядро, всегда; deconstruct первым (#623); + source-triangulation
  let t1 = "deconstruct|awareness-frame|root-cause-mapping|forces-and-potentials|strategic-maneuvers|two-paths-synthesis|decision-tree-forecast|reflexive-impact|calibration|system-health-diagnostics|source-triangulation"
  each nm in split(t1, "|") {
    result = SkillsAppend(result, to_string(nm), level, budget, "osp")
  }
  // Tier 2 — по домену
  if domain == "financial" then {
    result = SkillsAppend(result, "cross-asset-divergence", level, budget, "osp")
    result = SkillsAppend(result, "asymmetric-bet-structure", level, budget, "osp")
  }
  if domain == "monetary" then {
    result = SkillsAppend(result, "macro-regime-id", level, budget, "osp")
    result = SkillsAppend(result, "cantillon", level, budget, "osp")
  }
  // Tier 2 — по триггерам запроса; +3 никогда не подключённых (#623 п. 4)
  if contains(t, "нарратив") or contains(t, "поток") then { result = SkillsAppend(result, "narrative-vs-flows", level, budget, "osp") }
  if contains(t, "цикл") or contains(t, "фаза") then { result = SkillsAppend(result, "cycle-position", level, budget, "osp") }
  if contains(t, "персона") or contains(t, "лидер") then { result = SkillsAppend(result, "deep-profiling", level, budget, "osp") }
  if contains(t, "индикатор") or contains(t, "watch") then { result = SkillsAppend(result, "iw-watchlist", level, budget, "osp") }
  if contains(t, "антихрупк") or contains(t, "antifragil") or contains(t, "волатильн") or contains(t, "volatility") then { result = SkillsAppend(result, "antifragility-design", level, budget, "osp") }
  if contains(t, "фазов") or contains(t, "перелом") or contains(t, "tipping") then { result = SkillsAppend(result, "phase-transition-detection", level, budget, "osp") }
  if contains(t, "шеллинг") or contains(t, "schelling") or contains(t, "фокальн") then { result = SkillsAppend(result, "schelling-points", level, budget, "osp") }
  // Tier 3
  if domain == "military" then { result = SkillsAppend(result, "order-of-battle", level, budget, "osp") }
  if contains(t, "redteam") or contains(t, "red-team") then { result = SkillsAppend(result, "red-team", level, budget, "osp") }
  if result == "" then { return "No skills loaded." }
  return result
}

// ═══════════════════════════════════════════════════════════════════════
// DEPTH-ROUTED ANALYSIS MODES (all native call_llm)
// ═══════════════════════════════════════════════════════════════════════
pattern OSPQuickAnalyze(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id, 0)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nБЫСТРЫЙ АНАЛИЗ (depth=0). 200-300 слов. Суть — риск — действие."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result) + "\n\n" + OSPDisclaimerBottom()
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_quick", "osp", "domain=" + domain)
  return reply
}

pattern OSPDeepAnalyze(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id, 3)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nГЛУБОКОЕ ПРЕПАРИРОВАНИЕ (depth=3). 4 фазы. [ФАКТ]/[ИНТЕРПРЕТАЦИЯ]/[СПЕКУЛЯЦИЯ]. Sherman Kent. Two-paths. Индикаторы 30/60/90/180/365 дней. Если строишь сценарии изменения одной величины (цена, курс, индекс) — диапазоны взаимоисключающие без пересечений, вероятность в таблице сценариев форматом P=<число>% (точечная или узкая ≤15 п.п.), сумма середин = 100%. Шкала Кента — словесная метка К числу, не вместо числа. ACH и прогноз согласованы: выжила null-гипотеза — распределение широкое, без «likely» для одного направления.\n\nВ САМОМ КОНЦЕ ответа добавь ОДНУ строку — машиночитаемая карточка прогноза (владелец её не видит):\nCARD: {\"p\": <итоговая вероятность 0.02–0.98>, \"resolution_criteria\": \"<наблюдаемый критерий исхода — как именно проверять>\", \"resolve_by\": \"ГГГГ-ММ-ДД\", \"as_of\": \"ГГГГ-ММ-ДД\", \"market_dissent_reason\": \"<если твой p расходится с рыночной ценой из контекста сильнее чем на 35 п.п. — один проверяемый аргумент: ряд, число, дата; иначе поле не добавляй>\", \"methods\": {<опционально — ТОЛЬКО реально построенные тобой методики>: \"cg_chain\": {\"cg\": \"<центр тяжести>\", \"cc\": \"<критическая capability>\", \"cr\": \"<требование>\", \"cv\": \"<уязвимость>\"}; \"matrix\": [{\"a\": \"<фактор>\", \"b\": \"<фактор>\", \"sign\": \"+|-\", \"weight\": 0.0–1.0}]; \"forces\": {\"A\": 0.0–1.0, \"R\": 0.0–1.0, \"S\": 0.0–1.0, \"L\": 0.0–1.0, \"E\": 0.0–1.0, \"E_mod\": 0.5–1.5}; \"tree\": [{\"node\": \"<имя>\", \"parent\": \"<имя родителя или пусто>\", \"question\": \"<условие>\", \"p_cond\": 0.02–0.98, \"event\": \"true|false\" — у листьев, сумма произведений ветвей ≈ p}]; \"narratives\": [ровно 2: {\"name\": \"<сценарий>\", \"if_true_indicators\": [≥2 на каждый: {\"indicator\": \"<наблюдаемый>\", \"verify_date\": \"ГГГГ-ММ-ДД\", \"confirms_what\": \"<что подтверждает>\"}]}]}, \"assumptions\": [≥3: {\"text\": \"<допущение>\", \"confidence\": 0.0–1.0 числом, \"evidence_url\": \"<источник или пусто>\", \"if_wrong\": \"<что если неверно>\"} — без источника метка [СПЕКУЛЯЦИЯ] в text]}. Если методика не строилась — поле не добавляй; проверяются структурой, дерево обязано сходиться с p (расхождение >0.15 блокирует публикацию)."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  // #469 A.2: сценарный гейт — сумма вероятностей 98–102%, непересекающиеся
  // диапазоны. Один повтор с указанием ошибки; повторный провал — отчёт
  // выходит с пометкой, прогноз НЕ записывается в верификацию (Brier).
  let gate1 = OSPScenarioGateCheck(reply)
  if starts_with(gate1, "FAIL") then {
    let prompt_fix = prompt + "\n\nОТВЕТ ОТВЕРГНУТ ГЕЙТОМ КАЧЕСТВА: " + gate1 + "\nИсправь: сценарии одной величины — взаимоисключающие диапазоны без пересечений; вероятности форматом P=<число>% (точечные или узкие ≤15 п.п.); сумма середин = 100% ±2. Сгенерируй отчёт заново целиком."
    let llm_fix = redact(to_string(TryVal(try call_llm(prompt_fix, query))), "all")
    if to_string(llm_fix) != "()" then { let reply = to_string(llm_fix) }
  }
  let gate = OSPScenarioGateCheck(reply)
  let mut not_accepted = ""
  if starts_with(gate, "FAIL") then { let not_accepted = "\n\n[ПРОГНОЗ НЕ ПРИНЯТ К ВЕРИФИКАЦИИ: " + gate + " — вероятности не согласованы, запись в Brier не выполняется (наряд #469)]" }
  // W4 #627: g1–g12 удалены (§7.3) — структурные проверки методик теперь
  // в OSPSaveCard → OSPMethodsGate; здесь — safety (аналитический контур)
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  let reply = reply + "\n\n" + OSPDisclaimerBottom() + not_accepted
  // #469 A.3: в верификацию (Brier) попадает только согласованное
  // распределение — при повторном провале гейта запись прогноза не создаётся.
  // (фикс затенения: aid присваивается в блоке, а не теряется — #624)
  let mut aid = -1.0
  if not_accepted == "" then { aid = OSPDraftAnalysis(query, "deep", domain, 3) }
  // W1 #624: карточка прогноза — структурный хвост CARD (G1), гейты G2/G5,
  // единая точка записи; владельцу — проза + числовой хвост из строки БД
  let mut card_line = ""
  let mut body = reply
  let card = OSPFExtractCard(reply)
  if starts_with(card, "OK|") then {
    body = OSPFStripCard(reply)
    let cj = TryVal(try parse_json(substring(card, 3.0, length(card))))
    if to_string(cj) != "()" then {
      let p_raw = to_float(to_string(json_get(cj, "p", "-1")))
      let crit = to_string(json_get(cj, "resolution_criteria", ""))
      let as_of = to_string(json_get(cj, "as_of", ""))
      let resolve_by = to_string(json_get(cj, "resolve_by", ""))
      let src_json = OSPFSourcesToDB(context, aid, as_of)
      // #625 W2: линии рынка предсказаний в офисе нет — crowd_p = -1 (A.9),
      // гейты рынка молчат; обоснование расхождения — из CARD, если модель
      // видела рыночную цену и не согласна (поправка 2)
      let dissent = to_string(json_get(cj, "market_dissent_reason", ""))
      // #627 W4: методики как структуры — опциональные CARD-поля §7.2
      let mv = json_get(cj, "methods", "")
      let methods = "{}"
      if to_string(mv) != "()" and to_string(mv) != "" then { let methods = to_string(json_encode(mv)) }
      let av = json_get(cj, "assumptions", "")
      let assum = "[]"
      if to_string(av) != "()" and to_string(av) != "" then { let assum = to_string(json_encode(av)) }
      let saved = OSPSaveCard(query, p_raw, crit, as_of, resolve_by, src_json, aid, body, -1.0, dissent, methods, assum, 3)
      if starts_with(saved, "OK|") or starts_with(saved, "GATED|") then {
        card_line = "\n\n" + OSPFCardLine(to_float(get(split(saved, "|"), 1.0)))
      }
    }
  }
  let _ = RecordAssistantMessage(chat_id, "osp", body + card_line)
  let _ = AuditLog("osp_deep", "osp", "domain=" + domain + " aid=" + to_string(aid) + " scenario_gate=" + gate + " card=" + substring(card, 0.0, 60.0))
  return body + card_line
}

pattern OSPFullAnalyze(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id, 4)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nПОЛНЫЙ АНАЛИЗ (depth=4). depth=3 + Red team + I&W + Verification dates + Asymmetric bet + Premortem 3mo/12mo + ACH 5+ гипотез. Сценарии одной величины — взаимоисключающие непересекающиеся диапазоны; вероятности в таблице форматом P=<число>% (точечные или узкие ≤15 п.п.), сумма середин = 100% ±2. Шкала Кента — метка К числу. ACH согласован с прогнозом.\n\nВ САМОМ КОНЦЕ ответа добавь ОДНУ строку — машиночитаемая карточка прогноза (владелец её не видит):\nCARD: {\"p\": <итоговая вероятность 0.02–0.98>, \"resolution_criteria\": \"<наблюдаемый критерий исхода — как именно проверять>\", \"resolve_by\": \"ГГГГ-ММ-ДД\", \"as_of\": \"ГГГГ-ММ-ДД\", \"market_dissent_reason\": \"<если твой p расходится с рыночной ценой из контекста сильнее чем на 35 п.п. — один проверяемый аргумент: ряд, число, дата; иначе поле не добавляй>, \"methods\": {<опционально, форма как в deep — ТОЛЬКО реально построенные методики: cg_chain, frame {P,M,E,S,I,IT,PH,T — при depth≥2 заполнено ≥6/8}, matrix, forces, tree (сходится с p, иначе блок публикации), narratives [ровно 2, у каждого ≥2 датированных индикатора]}, \"assumptions\": [≥3: {text, confidence числом, evidence_url или [СПЕКУЛЯЦИЯ], if_wrong}]}. Если методика не строилась — поле не добавляй.\"}"
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  // #469 A.2: сценарный гейт — как в OSPDeepAnalyze: один повтор,
  // повторный провал — пометка и отказ от записи прогноза.
  let gate1 = OSPScenarioGateCheck(reply)
  if starts_with(gate1, "FAIL") then {
    let prompt_fix = prompt + "\n\nОТВЕТ ОТВЕРГНУТ ГЕЙТОМ КАЧЕСТВА: " + gate1 + "\nИсправь: сценарии одной величины — взаимоисключающие диапазоны без пересечений; вероятности форматом P=<число>% (точечные или узкие ≤15 п.п.); сумма середин = 100% ±2. Сгенерируй отчёт заново целиком."
    let llm_fix = redact(to_string(TryVal(try call_llm(prompt_fix, query))), "all")
    if to_string(llm_fix) != "()" then { let reply = to_string(llm_fix) }
  }
  let gate = OSPScenarioGateCheck(reply)
  let mut not_accepted = ""
  if starts_with(gate, "FAIL") then { let not_accepted = "\n\n[ПРОГНОЗ НЕ ПРИНЯТ К ВЕРИФИКАЦИИ: " + gate + " — вероятности не согласованы, запись в Brier не выполняется (наряд #469)]" }
  // W4 #627: g1–g12 удалены (§7.3) — safety (аналитический контур)
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  let reply = reply + "\n\n" + OSPDisclaimerBottom() + not_accepted
  // #469 A.3: в верификацию (Brier) попадает только согласованное
  // распределение — при повторном провале гейта запись прогноза не создаётся.
  // (фикс затенения: aid присваивается в блоке, а не теряется — #624)
  let mut aid = -1.0
  if not_accepted == "" then { aid = OSPDraftAnalysis(query, "full", domain, 4) }
  // W1 #624: карточка прогноза — структурный хвост CARD (G1), гейты G2/G5,
  // единая точка записи; владельцу — проза + числовой хвост из строки БД
  let mut card_line = ""
  let mut body = reply
  let card = OSPFExtractCard(reply)
  if starts_with(card, "OK|") then {
    body = OSPFStripCard(reply)
    let cj = TryVal(try parse_json(substring(card, 3.0, length(card))))
    if to_string(cj) != "()" then {
      let p_raw = to_float(to_string(json_get(cj, "p", "-1")))
      let crit = to_string(json_get(cj, "resolution_criteria", ""))
      let as_of = to_string(json_get(cj, "as_of", ""))
      let resolve_by = to_string(json_get(cj, "resolve_by", ""))
      let src_json = OSPFSourcesToDB(context, aid, as_of)
      // #625 W2: crowd_p = -1 — линии рынка предсказаний нет (A.9, см. deep)
      let dissent = to_string(json_get(cj, "market_dissent_reason", ""))
      // #627 W4: методики как структуры — опциональные CARD-поля §7.2
      let mv = json_get(cj, "methods", "")
      let methods = "{}"
      if to_string(mv) != "()" and to_string(mv) != "" then { let methods = to_string(json_encode(mv)) }
      let av = json_get(cj, "assumptions", "")
      let assum = "[]"
      if to_string(av) != "()" and to_string(av) != "" then { let assum = to_string(json_encode(av)) }
      let saved = OSPSaveCard(query, p_raw, crit, as_of, resolve_by, src_json, aid, body, -1.0, dissent, methods, assum, 4)
      if starts_with(saved, "OK|") or starts_with(saved, "GATED|") then {
        card_line = "\n\n" + OSPFCardLine(to_float(get(split(saved, "|"), 1.0)))
      }
    }
  }
  let _ = RecordAssistantMessage(chat_id, "osp", body + card_line)
  let _ = AuditLog("osp_full", "osp", "domain=" + domain + " aid=" + to_string(aid) + " scenario_gate=" + gate + " card=" + substring(card, 0.0, 60.0))
  return body + card_line
}

pattern OSPWargame(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id, 2)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nWARGAME (depth=2). Стороны→Интересы→Силы→Ходы→Дерево→Schelling points→Нэш→Наша стратегия→Red flags."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result) + "\n\n" + OSPDisclaimerBottom()
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_wargame", "osp", "domain=" + domain)
  return reply
}

