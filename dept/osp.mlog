  assert_eq(OSPBenchCrowd("polymarket", "0.4"), 0.4)
  // MUT-мишень: убрать фильтр источника — уровень ряда принят за вероятность
  assert_eq(OSPBenchCrowd("fred", "103.8443465423"), -1.0)
  assert_eq(OSPBenchCrowd("serpapi", "0.5"), -1.0)
  assert_eq(OSPBenchCrowd("kalshi", "мусор"), -1.0)
}

test "n626 ingest: 3 вопроса, market=2, rows=4; повторный ingest — SKIP" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let due = "2026-12-06"
      let payload = "{\"forecast_due_date\": \"2026-12-06\", \"questions\": [{\"id\": \"m1\", \"source\": \"kalshi\", \"question\": \"Вопрос рынка m1 про инфляцию\", \"resolution_criteria\": \"Официальная публикация значения индекса CPI за период\", \"freeze_datetime\": \"2030-01-01\", \"freeze_datetime_value\": \"0.61\", \"resolution_dates\": \"N/A\"}, {\"id\": \"m2\", \"source\": \"polymarket\", \"question\": \"Вопрос рынка m2 про выборы\", \"resolution_criteria\": \"Официальная публикация итогов голосования комиссии\", \"freeze_datetime\": \"2030-01-01\", \"freeze_datetime_value\": \"0.4\", \"resolution_dates\": \"N/A\"}, {\"id\": \"d1\", \"source\": \"fred\", \"question\": \"Вопрос данных d1 про ставку\", \"resolution_criteria\": \"Публикация значения ряда FRED по ключевой ставке\", \"freeze_datetime\": \"2030-01-01\", \"freeze_datetime_value\": \"103.8\", \"resolution_dates\": [\"2031-01-01\", \"2031-04-01\"]}]}"
      let r = OSPBenchIngestData(due, payload)
      assert_contains(r, "OK|questions=3|market=2|dataset=1|")
      assert_contains(r, "rows=4")
      // приёмка наряда: повторный ingest того же due — SKIP
      assert_contains(OSPBenchIngestData(due, payload), "SKIP|")
      // строка раунда с атрибуцией
      let rnd = query("SELECT license, n_rows FROM osp_bench_rounds WHERE due_date = ?", [due])
      assert_contains(to_string(json_get(get(rnd, 0.0), "license", "")), "CC BY-SA 4.0")
      assert_eq(to_float(to_string(json_get(get(rnd, 0.0), "n_rows", "0"))), 4.0)
  }}

