      assert_contains(r, "ADOPTED gain=0.0356")
      assert_eq(OSPPriorWeight(20.0), 0.6666666666666666)
      // карточка с prior_rate=0.5, prior_n=20: p=0.6 → 0.667·0.5+0.333·0.6=0.5333
      let fid = query("SELECT id, prior_rate, prior_n FROM osp_forecast WHERE kind = 'n627priorok' AND prior_rate IS NOT NULL ORDER BY id DESC LIMIT 1", [])
      let idv = to_float(to_string(json_get(get(fid, 0.0), "id", "0")))
      assert_eq(OSPFmt4(OSPPriorApply(idv, 0.6)), "0.5333")
  }}


// Фикстура кривой: resolved-строка с ЗАДАННЫМ cal_bucket (OSPW2SeedResolved
// пишет bucket=1 всем — кривой нужен честный расклад по децилям)
pattern OSPW27SeedBucket(kind: String, p: Float, y: Float, bucket: Float) -> String {
  let _ = OSPFEnsureSchema()
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_final, outcome, cal_bucket, verified_at, created_at) VALUES (?, ?, 'resolved', ?, ?, ?, datetime('now'), datetime('now'))", [kind, "n627 curve-fixture " + kind + " p=" + to_string(p), to_string(p), to_string(y), to_string(bucket)])
  return "ok"
}

test "n627 кривая: 3 бакета × 5 строк — JSON в monthly_reviews; нехватка — честный NO" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let pm = query("SELECT strftime('%Y-%m', 'now') AS p", [])
      let period = to_string(json_get(get(pm, 0.0), "p", ""))
      if OSPW2SeedIfEmpty("n627curve") == "empty" then {
        // бакет 1 (p≈0.05): 5 строк, y=1 — верхняя кривая-ошибка переуверенности
        let _ = OSPW27SeedBucket("n627curve", 0.05, 1.0, 1.0)
        let _ = OSPW27SeedBucket("n627curve", 0.05, 1.0, 1.0)
        let _ = OSPW27SeedBucket("n627curve", 0.05, 1.0, 1.0)
        let _ = OSPW27SeedBucket("n627curve", 0.05, 1.0, 1.0)
        let _ = OSPW27SeedBucket("n627curve", 0.05, 1.0, 1.0)
        // бакет 5 (p=0.5): 5 строк, y=0
        let _ = OSPW27SeedBucket("n627curve", 0.5, 0.0, 5.0)
        let _ = OSPW27SeedBucket("n627curve", 0.5, 0.0, 5.0)
        let _ = OSPW27SeedBucket("n627curve", 0.5, 0.0, 5.0)
        let _ = OSPW27SeedBucket("n627curve", 0.5, 0.0, 5.0)
        let _ = OSPW27SeedBucket("n627curve", 0.5, 0.0, 5.0)
        // бакет 9 (p≈0.9): 5 строк, y=1
        let _ = OSPW27SeedBucket("n627curve", 0.9, 1.0, 9.0)
        let _ = OSPW27SeedBucket("n627curve", 0.9, 1.0, 9.0)
        let _ = OSPW27SeedBucket("n627curve", 0.9, 1.0, 9.0)
        let _ = OSPW27SeedBucket("n627curve", 0.9, 1.0, 9.0)
        let _ = OSPW27SeedBucket("n627curve", 0.9, 1.0, 9.0)
      }
      let r = OSPCalibrationCurve("n627curve", period, "")
      assert_contains(r, "OK|" + period + "|бакетов=3|строк=15")
      let row = query("SELECT calibration_curve FROM monthly_reviews WHERE year_month = ?", [period])
      let cc = to_string(json_get(get(row, 0.0), "calibration_curve", ""))
      assert_contains(cc, "0-10%")
      assert_contains(cc, "40-50%")
      assert_contains(cc, "80-90%")
      assert_contains(cc, "\"mean_p\":0.05")
      // кривой период — отказ по форме
      assert_contains(OSPCalibrationCurve("n627curve", "2026-1", ""), "NO|период не ГГГГ-ММ")
      // нехватка: 4 строки в новом контуре — бакетов 0/3
      if OSPW2SeedIfEmpty("n627curve2") == "empty" then {
        let _ = OSPW2SeedResolved("n627curve2", 0.5, 1.0)
        let _ = OSPW2SeedResolved("n627curve2", 0.5, 0.0)
        let _ = OSPW2SeedResolved("n627curve2", 0.5, 1.0)
        let _ = OSPW2SeedResolved("n627curve2", 0.5, 0.0)
      }
      let r2 = OSPCalibrationCurve("n627curve2", period, "")
      assert_contains(r2, "NO|недостаточно данных для кривой")
  }}

test "n627 методики: assumptions, deception, CG, PMESII — PASS/W/SKIP" {
  // 1. Key Assumptions Check
  assert_contains(OSPAssumptionsGate("[{\"text\":\"ставка снижена\",\"confidence\":0.7,\"evidence_url\":\"https://fred\",\"if_wrong\":\"инфляция\"},{\"text\":\"спрос устойчив\",\"confidence\":0.6,\"evidence_url\":\"https://x\",\"if_wrong\":\"спад\"},{\"text\":\"трейд-флоу положительный [СПЕКУЛЯЦИЯ]\",\"confidence\":0.5,\"evidence_url\":\"\",\"if_wrong\":\"отток\"}]"), "PASS|допущений=3")
  assert_contains(OSPAssumptionsGate("[{\"text\":\"a\",\"confidence\":0.5,\"evidence_url\":\"\",\"if_wrong\":\"\"},{\"text\":\"b\",\"confidence\":0.6,\"evidence_url\":\"\",\"if_wrong\":\"\"}]"), "W: допущений 2")
  assert_contains(OSPAssumptionsGate("[{\"text\":\"a\",\"confidence\":\"высокая\",\"evidence_url\":\"\",\"if_wrong\":\"\"},{\"text\":\"b\",\"confidence\":0.6,\"evidence_url\":\"\",\"if_wrong\":\"\"},{\"text\":\"c\",\"confidence\":0.5,\"evidence_url\":\"\",\"if_wrong\":\"\"}]"), "confidence не число: 1")
  assert_contains(OSPAssumptionsGate("[{\"text\":\"a\",\"confidence\":0.5,\"evidence_url\":\"\",\"if_wrong\":\"\"},{\"text\":\"b\",\"confidence\":0.6,\"evidence_url\":\"\",\"if_wrong\":\"\"},{\"text\":\"c без источника и без метки\",\"confidence\":0.5,\"evidence_url\":\"\",\"if_wrong\":\"\"}]"), "без evidence_url")
  assert_contains(OSPAssumptionsGate(""), "SKIP|не заявлено")
  // 2. Deception Detection
  assert_contains(OSPDeceptionGate("[{\"tier\":\"primary\",\"interested\":true}]"), "W: единственный источник primary")
  assert_eq(OSPDeceptionGate("[{\"tier\":\"primary\",\"interested\":false}]"), "")
  assert_eq(OSPDeceptionGate("[{\"tier\":\"primary\",\"interested\":true},{\"tier\":\"secondary\",\"interested\":false}]"), "")
  assert_eq(OSPDeceptionGate("[\"https://example.org/a\"]"), "")
  // 3. Центр тяжести CG→CC→CR→CV
  assert_contains(OSPCGGate("{\"cg_chain\":{\"cg\":\"ПЛБ\",\"cc\":\"ПАВО\",\"cr\":\"речка\",\"cv\":\"мост\"}}"), "PASS|CG→CC→CR→CV")
  assert_contains(OSPCGGate("{\"cg_chain\":{\"cg\":\"ПЛБ\",\"cc\":\"\",\"cr\":\"речка\",\"cv\":\"мост\"}}"), "W: центр тяжести заявлен, но не построен")
  assert_eq(OSPCGGate("{}"), "")
  // 4. PMESII-PT (только depth≥2)
  assert_contains(OSPMesiiGate("{\"frame\":{\"P\":\"п\",\"M\":\"м\",\"E\":\"э\",\"S\":\"с\",\"I\":\"и\",\"IT\":\"ит\",\"PH\":\"фх\",\"T\":\"т\"}}", 2), "PASS|PMESII-PT 8/8")
  assert_contains(OSPMesiiGate("{\"frame\":{\"P\":\"п\",\"M\":\"м\",\"E\":\"э\",\"S\":\"с\",\"I\":\"и\"}}", 3), "W: PMESII-PT заявлен, заполнено 5/8")
  assert_eq(OSPMesiiGate("{\"frame\":{\"P\":\"п\"}}", 1), "")
  assert_eq(OSPMesiiGate("{}", 4), "")
}

test "n627 методики: матрица противоречий, потенциал из сил, дерево, нарративы" {
  // 5. Cross-Impact: противоречие без feedback
  assert_contains(OSPMatrixGate("{\"matrix\":[{\"a\":\"инфляция\",\"b\":\"ставка\",\"sign\":\"+\",\"weight\":1.0},{\"a\":\"ставка\",\"b\":\"инфляция\",\"sign\":\"-\",\"weight\":1.0}]}"), "W: противоречие матрицы без feedback: инфляция↔ставка")
  // с пометкой feedback противоречие легально
  assert_eq(OSPMatrixGate("{\"matrix\":[{\"a\":\"инфляция\",\"b\":\"ставка\",\"sign\":\"+\",\"weight\":1.0,\"feedback\":true},{\"a\":\"ставка\",\"b\":\"инфляция\",\"sign\":\"-\",\"weight\":1.0,\"feedback\":false}]}"), "")
  // потенциал из матрицы сил — программа (0.8·0.7·0.6·0.5·0.4·1.0 = 0.0672)
  assert_contains(OSPMatrixGate("{\"forces\":{\"A\":0.8,\"R\":0.7,\"S\":0.6,\"L\":0.5,\"E\":0.4,\"E_mod\":1.0}}"), "потенциал P=0.0672")
  assert_eq(OSPMatrixGate("{}"), "")
  // 6. Дерево: сходится (Σevent=0.6 vs p_final=0.55)
  let tree_ok = "{\"tree\":[{\"node\":\"A\",\"parent\":\"\",\"question\":\"корень\",\"p_cond\":1.0},{\"node\":\"B\",\"parent\":\"A\",\"question\":\"ветка да\",\"p_cond\":0.6,\"event\":\"true\"},{\"node\":\"C\",\"parent\":\"A\",\"question\":\"ветка нет\",\"p_cond\":0.4,\"event\":\"false\"}]}"
  assert_contains(OSPTreeGate(tree_ok, 0.55), "PASS|дерево сходится")
  // расхождение > 0.15 — G-гейт
  assert_contains(OSPTreeGate(tree_ok, 0.85), "FAIL|дерево не сходится с ответом")
  // сумма терминальных > 1
  let tree_sum = "{\"tree\":[{\"node\":\"A\",\"parent\":\"\",\"question\":\"да\",\"p_cond\":0.7,\"event\":\"true\"},{\"node\":\"B\",\"parent\":\"\",\"question\":\"нет\",\"p_cond\":0.6,\"event\":\"false\"}]}"
  assert_contains(OSPTreeGate(tree_sum, 0.7), "FAIL|сумма терминальных ветвей 1.3000 > 1")
  // без event-разметки — честное W, выдуманной сверки нет
  assert_contains(OSPTreeGate("{\"tree\":[{\"node\":\"A\",\"parent\":\"\",\"question\":\"x\",\"p_cond\":0.5}]}", 0.5), "W: у дерева нет event-разметки")
  assert_eq(OSPTreeGate("{}", 0.5), "SKIP")
  // 7. Нарративы: ровно 2, у каждого ≥2 индикаторов с датой
  let narr_ok = "{\"narratives\":[{\"name\":\"эскалация\",\"if_true_indicators\":[{\"indicator\":\"передислокация бригад\",\"verify_date\":\"2026-12-01\",\"confirms_what\":\"эскалация\"},{\"indicator\":\"обмен ударами по базам\",\"verify_date\":\"2026-12-15\",\"confirms_what\":\"эскалация\"}]},{\"name\":\"деэскалация\",\"if_true_indicators\":[{\"indicator\":\"пресс-релиз о переговорах\",\"verify_date\":\"2026-12-05\",\"confirms_what\":\"деэскалация\"},{\"indicator\":\"снижение ОбО\",\"verify_date\":\"2026-12-20\",\"confirms_what\":\"деэскалация\"}]}]}"
  assert_contains(OSPNarrativesGate(narr_ok, 1.0, -1.0), "OK|индикаторов записано=4")
  assert_contains(OSPNarrativesGate("{\"narratives\":[{\"name\":\"один\",\"if_true_indicators\":[]}]}", 1.0, -1.0), "W: нарративов 1")
  let narr_bad = "{\"narratives\":[{\"name\":\"а\",\"if_true_indicators\":[]},{\"name\":\"б\",\"if_true_indicators\":[]}]}"
  assert_contains(OSPNarrativesGate(narr_bad, 1.0, -1.0), "W: у нарративов нет ≥2 индикаторов с датой")
  assert_eq(OSPNarrativesGate("{}", 1.0, -1.0), "SKIP")
}

test "n627 OSPMethodsGate: дерево не сходится — BLOCK; пустые методы — PASS" {
  let tree_bad = "{\"tree\":[{\"node\":\"A\",\"parent\":\"\",\"question\":\"корень\",\"p_cond\":1.0},{\"node\":\"B\",\"parent\":\"A\",\"question\":\"да\",\"p_cond\":0.9,\"event\":\"true\"},{\"node\":\"C\",\"parent\":\"A\",\"question\":\"нет\",\"p_cond\":0.1,\"event\":\"false\"}]}"
  // Σevent=0.9 vs p_final=0.4 → расхождение 0.5 → публикация блокирована
  assert_contains(OSPMethodsGate(tree_bad, "[]", "[]", 3, 0.4, 0.0, -1.0), "BLOCK|G7 дерево")
  assert_contains(OSPMethodsGate("{}", "[]", "[]", 1, 0.5, 0.0, -1.0), "PASS|")
  // сценные марки попадают в фрагмент gate_report
  let mg = OSPMethodsGate("{\"cg_chain\":{\"cg\":\"1\",\"cc\":\"2\",\"cr\":\"3\",\"cv\":\"4\"}}", "[{\"text\":\"x\",\"confidence\":0.5,\"evidence_url\":\"https://x\",\"if_wrong\":\"y\"},{\"text\":\"y\",\"confidence\":0.6,\"evidence_url\":\"https://y\",\"if_wrong\":\"z\"},{\"text\":\"z [СПЕКУЛАЦИЯ]\",\"confidence\":0.4,\"evidence_url\":\"\",\"if_wrong\":\"w\"}]", "[]", 3, 0.5, 0.0, -1.0)
  assert_contains(mg, "\"assumptions\":\"допущений=3\"")
  assert_contains(mg, "\"cg\":\"CG→CC→CR→CV построена\"")
}

test "n627 A/B методологий: пол n≥10 — доска, skill_reviews, честный отказ" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      if OSPW2SeedIfEmpty("n627ab") == "empty" then {
        // glm-4.6: 12 прогонов p_i=0.8, y=1 → Brier=0.04, skill vs 0.25=0.84
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        let _ = OSPW27SeedAB("n627ab", "glm-4.6", 0.8, 1.0)
        // kimi-k3: 9 прогонов — ниже пола
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 1.0)
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 0.0)
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 1.0)
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 0.0)
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 1.0)
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 0.0)
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 1.0)
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 0.0)
        let _ = OSPW27SeedAB("n627ab", "kimi-k3", 0.5, 1.0)
      }
      let board = OSPMethodAB("n627ab")
      assert_contains(board, "glm-4.6: n=12, Brier=0.040, skill vs 0.25=0.840")
      assert_contains(board, "kimi-k3: недостаточно данных (9/10) — число не публикуется")
      // семейства моделей
      assert_eq(OSPFamilyOf("openai/gpt-oss-20b"), "openai")
      assert_eq(OSPFamilyOf("glm-4.6"), "glm")
      assert_eq(OSPFamilyOf("kimi-k3"), "kimi")
      assert_eq(OSPFamilyOf("gpt-oss-120b"), "gpt")
      assert_eq(OSPFamilyOf("deepseek-chat"), "deepseek")
  }}

test "n627 слот и команды: ежемесячный обзор программой, /osp methods, /osp curve" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let slot = OSPMonthlySlot()
      assert_contains(slot, "Ежемесячный обзор ОСП")
      // /osp methods — доска (контур owner; прогонов может не быть)
      let ab = OSPMethodABCommand("111")
      assert_contains(ab, "A/B методологий")
      assert_contains(ab, "отложен владельцем")
      // /osp curve — программный ответ без LLM (кривой период нормализуется
      // к текущему; форма периода гвардится в OSPCalibrationCurve)
      assert_contains(OSPCurveCommand("2026-1", "111"), "Калибровочная кривая (owner, ")
      // строка калибровки в скор-блоке (при n≥10 — после метрик; n625test
      // засеян n625-тестами: 12 разрешённых строк)
      assert_contains(OSPScoreBlock("n625test"), "Калибровка Platt:")
  }}

test "n627 гигиена: боевые настройки калибровки восстановлены после тестов" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      // вердикты тестов не остаются боевыми: честная заглушка REJECTED
      // (боевого ADOPTED в БД нет — фактический пересчёт /osp recalibrate)
      let _ = OSPSettingUpsert("osp_cal_note", "REJECTED gain=0.0000 holdout_n=0 train_n=0 недостаточно данных (нужно train≥60, hold≥30) — идентичность a=1 b=0")
      // коэффициенты — идентичность: боевых ADOPTED-данных в БД нет,
      // фактический пересчёт — /osp recalibrate владельцем
      let _ = OSPSettingUpsert("osp_cal_a", "1.0")
      let _ = OSPSettingUpsert("osp_cal_b", "0.0")
      // сжатие — тоже выключено
      let _ = OSPSettingUpsert("osp_prior_note", "REJECTED gain=0.0000 holdout_n=0 train_n=0 недостаточно данных (нужно train≥60, hold≥30) — сжатие выключено (поправка 1)")
      let cn = query("SELECT value FROM system_settings WHERE key = 'osp_cal_note'", [])
      assert_contains(to_string(json_get(get(cn, 0.0), "value", "?")), "REJECTED")
      // побитовая идентичность подтверждена
      assert_eq(OSPPlattApply(0.33), 0.33)
      assert_eq(OSPPriorApply(1.0, 0.44), 0.44)
  }}
