test "n626 выборка: детерминированная, первые по qid с источника, повторы совпадают" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let due = "2027-01-10"
      let _ = OSPW3Setting("osp_bench_per_source", "2")
      let _ = OSPW3SeedQuestion(due, OSPBenchQid("kalshi", "e", due), "kalshi", "вопрос e", "2030-01-01", "0.5", "N/A")
      let _ = OSPW3SeedQuestion(due, OSPBenchQid("kalshi", "b", due), "kalshi", "вопрос b", "2030-01-01", "0.5", "N/A")
      let _ = OSPW3SeedQuestion(due, OSPBenchQid("kalshi", "d", due), "kalshi", "вопрос d", "2030-01-01", "0.5", "N/A")
      let _ = OSPW3SeedQuestion(due, OSPBenchQid("kalshi", "a", due), "kalshi", "вопрос a", "2030-01-01", "0.5", "N/A")
      let _ = OSPW3SeedQuestion(due, OSPBenchQid("fred", "f2", due), "fred", "вопрос f2", "2030-01-01", "10.0", "N/A")
      let s1 = OSPBenchSample(due)
      let s2 = OSPBenchSample(due)
      assert_eq(s1, s2)
      assert_contains(s1, OSPBenchQid("kalshi", "a", due))
      assert_contains(s1, OSPBenchQid("kalshi", "b", due))
      assert_contains(s1, OSPBenchQid("fred", "f2", due))
      // c, d, e — за пределами per_source=2
      assert_eq(contains(s1, OSPBenchQid("kalshi", "c", due)), false)
      assert_eq(contains(s1, OSPBenchQid("kalshi", "d", due)), false)
      let _ = OSPW3Setting("osp_bench_per_source", "18")
  }}

test "n626 бюджет-гейт: OK, OVER с точным cap, UNLIMITED" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      let _ = kv_set("daily_budget_osp_used:" + OSPDayUtc(), "0")
      // off в system_settings — enforcement снят (UNLIMITED §6.4)
      let _ = OSPW3Setting("daily_budget_osp", "off")
      assert_contains(OSPBenchBudgetGate(100.0), "UNLIMITED|")
      // жёсткий лимит 0.01, стоимость строки 0.01 при выключенном ансамбле
      let _ = OSPW3Setting("daily_budget_osp", "0.01")
      assert_contains(OSPBenchBudgetGate(1.0), "OK|")
      let over = OSPBenchBudgetGate(2.0)
      assert_contains(over, "OVER|")
      assert_contains(over, "cap=1 строк из 2")
      let _ = OSPW3Setting("daily_budget_osp", "2.00")
      let _ = kv_set("daily_budget_osp_used:" + OSPDayUtc(), "0")
  }}

test "n626 лимит: единая точка чтения — system_settings приоритет, значения явные" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      // #664: тест не зависит от дефолта/сева — все значения выставляются явно
      let _ = OSPW3Setting("daily_budget_osp", "2.00")
      assert_eq(OSPLimitRead(), "2.00")
      let _ = OSPW3Setting("daily_budget_osp", "5.00")
      assert_eq(OSPLimitRead(), "5.00")
      let _ = OSPW3Setting("daily_budget_osp", "off")
      assert_eq(OSPLimitRead(), "off")
      let _ = OSPW3Setting("daily_budget_osp", "10.00")
      assert_eq(OSPLimitRead(), "10.00")
  }}

test "n664 миграция бюджета: 2.00 → 10.00 по маркеру, ручное значение не трогается" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      // сценарий 1: значение 2.00 (наследие B.3), маркера нет → после вызова
      // 10.00, маркер есть (№312: DELETE в тесте — только через грант)
      let g = grant_issue("db:delete:system_settings", 120, "once")
      let _ = try db_execute_with_grant(g, "DELETE FROM system_settings WHERE key IN ('daily_budget_osp', 'mig_osp_budget_1105')", [])
      let _ = db_execute("INSERT INTO system_settings (key, value) VALUES ('daily_budget_osp', '2.00')", [])
      let _ = OSPBenchEnsureSchema()
      let r1 = query("SELECT value FROM system_settings WHERE key = 'daily_budget_osp'", [])
      assert_eq(to_string(json_get(get(r1, 0.0), "value", "?")), "10.00")
      let mk = query("SELECT COUNT(*) AS c FROM system_settings WHERE key = 'mig_osp_budget_1105'", [])
      assert_eq(to_float(to_string(json_get(get(mk, 0.0), "c", "0"))), 1.0)
      // сценарий 2: повторный вызов после ручного 3.50 → остаётся 3.50
      // (защищён и маркером, и значение-гардом «только literal 2.00»)
      let _ = db_execute("UPDATE system_settings SET value = '3.50' WHERE key = 'daily_budget_osp'", [])
      let _ = OSPBenchEnsureSchema()
      let r2 = query("SELECT value FROM system_settings WHERE key = 'daily_budget_osp'", [])
      assert_eq(to_string(json_get(get(r2, 0.0), "value", "?")), "3.50")
      // сценарий 3 (мутационный гард маркера): literal 2.00 при живом маркере
      // НЕ мигрируется повторно — миграция одноразовая за жизнь БД; мутация
      // «убрать проверку маркера» делает этот ассерт красным (2.00 → 10.00)
      let _ = db_execute("UPDATE system_settings SET value = '2.00' WHERE key = 'daily_budget_osp'", [])
      let _ = OSPBenchEnsureSchema()
      let r3 = query("SELECT value FROM system_settings WHERE key = 'daily_budget_osp'", [])
      assert_eq(to_string(json_get(get(r3, 0.0), "value", "?")), "2.00")
      // гигиена: вернуть боевое значение (маркер остаётся — консистентно)
      let _ = db_execute("UPDATE system_settings SET value = '10.00' WHERE key = 'daily_budget_osp'", [])
  }}

test "n626 временной заслон: прогноз после freeze не принимается (MUT-приёмка)" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      let due = "2027-02-01"
      let qid = OSPBenchQid("kalshi", "past1", due)
      let _ = OSPW3SeedQuestion(due, qid, "kalshi", "Вопрос с прошедшей заморозкой n626", "2020-01-01", "0.5", "N/A")
      // MUT-приёмка: now позже freeze_datetime — прогноз не принят
      let r = OSPBenchForecastRow(due, qid, "")
      assert_contains(r, "SKIP|freeze прошёл")
      let cnt = query("SELECT COUNT(*) AS c FROM osp_forecast WHERE bench_qid = ?", [qid + "|"])
      assert_eq(to_float(to_string(json_get(get(cnt, 0.0), "c", "0"))), 0.0)
      // freeze в будущем, но ансамбль выключен — честный пропуск без строки
      let qid2 = OSPBenchQid("kalshi", "fut1", due)
      let _ = OSPW3SeedQuestion(due, qid2, "kalshi", "Вопрос с будущей заморозкой n626", "2030-01-01", "0.5", "N/A")
      assert_contains(OSPBenchForecastRow(due, qid2, ""), "SKIP|ансамбль недоступен")
  }}

