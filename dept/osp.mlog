  let _ = AuditLog("osp_watch", "osp", "")
  return reply
}
pattern OSPUnwatch(query: String, chat_id: String) -> String {
  // №312: DELETE — irreversible-content, через грант (№421/ADR-0155)
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:delete:watchlist_scenarios", 3600.0, "once"), "DELETE FROM watchlist_scenarios WHERE scenario_label = ?", [substring(query, 0, 100)]))
  let _ = AuditLog("osp_unwatch", "osp", "removed")
  return "Удалено из watchlist: " + query
}

