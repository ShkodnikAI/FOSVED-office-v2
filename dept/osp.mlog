test "n625 verify: да после resolve_by — resolved, строка brier_score_log" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      let drows = query("SELECT date('now', '+30 days') AS rb, date('now', '-1 day') AS ao", [])
      let rb = to_string(json_get(get(drows, 0.0), "rb", ""))
      let ao = to_string(json_get(get(drows, 0.0), "ao", ""))
      let saved = OSPSaveCard("n625 verify-вопрос уникальный", 0.25, "Критерий: ставка по итогу заседания опубликована пресс-релизом", ao, rb, "[\"https://fred.stlouisfed.org/series/DFF\"]", -1, "", -1.0, "", "[]", "[]", 1)
      let id = to_float(get(split(saved, "|"), 1.0))
      // до горизонта — отказ
      assert_contains(OSPVerifyCard(id, "да", ""), "NO|горизонт не наступил")
      // сдвигаем resolve_by в прошлое (фикстура — сырой SQL в паттерне запрещён
      // в тесте, поэтому через служебный UPDATE там же, где сел seeded-карточка)
      let _ = OSPW2ForcePast(id)
      let v = OSPVerifyCard(id, "да", "")
      assert_contains(v, "OK|")
      assert_contains(v, "brier=0.563")
      let rows = query("SELECT status, outcome, brier FROM osp_forecast WHERE id = ?", [to_string(id)])
      assert_eq(to_string(json_get(get(rows, 0.0), "status", "?")), "resolved")
      assert_eq(to_float(to_string(json_get(get(rows, 0.0), "outcome", "0"))), 1.0)
      let bl = query("SELECT forecast_probability, brier_score, total_forecasts FROM brier_score_log WHERE analysis_id IS NULL AND forecast_probability = 0.25 ORDER BY id DESC LIMIT 1", [])
      assert_eq(to_float(to_string(json_get(get(bl, 0.0), "total_forecasts", "0"))) >= 1.0, true)
      assert_eq(OSPFmt3(to_float(to_string(json_get(get(bl, 0.0), "brier_score", "0")))), "0.563")
      // повторное подтверждение — отказ (терминальный статус)
      assert_contains(OSPVerifyCard(id, "да", ""), "NO|статус resolved")
      // нераспознанный исход — отказ, модель не угадывает; горизонт в прошлом,
      // иначе rb-проверка сработает раньше парса
      let saved2 = OSPSaveCard("n625 verify-вопрос второй уникальный", 0.6, "Критерий: отчёт опубликован агентством с датой выпуска", ao, rb, "[\"https://example.org/v2\"]", -1, "", -1.0, "", "[]", "[]", 1)
      let id2 = to_float(get(split(saved2, "|"), 1.0))
      let _ = OSPW2ForcePast(id2)
      assert_contains(OSPVerifyCard(id2, "может быть", ""), "FAIL|исход не распознан")
  }}

test "n625 score: пол n<10 — честное недостаточно данных; при n=12 — числа из БД" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      if OSPW2SeedIfEmpty("n625small") == "empty" then {
        let _ = OSPW2SeedResolved("n625small", 0.9, 1.0)
        let _ = OSPW2SeedResolved("n625small", 0.8, 0.0)
        let _ = OSPW2SeedResolved("n625small", 0.7, 1.0)
        let _ = OSPW2SeedResolved("n625small", 0.6, 0.0)
        let _ = OSPW2SeedResolved("n625small", 0.5, 0.0)
        let _ = OSPW2SeedResolved("n625small", 0.4, 1.0)
        let _ = OSPW2SeedResolved("n625small", 0.3, 0.0)
      }
      // MUT-мишень: убрать пол n≥10 — блок напечатал бы метрики по 7 строкам
      assert_contains(OSPScoreBlock("n625small"), "Недостаточно данных для метрик (7/10)")
      if OSPW2SeedIfEmpty("n625test") == "empty" then {
        let _ = OSPW2SeedResolved("n625test", 0.9, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.8, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.7, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.6, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.5, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.4, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.3, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.2, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.1, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.85, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.95, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.55, 1.0)
      }
      let blk = OSPScoreBlock("n625test")
      assert_contains(blk, "разрешено: 12")
      assert_contains(blk, "Brier: 0.156")
      assert_contains(blk, "Skill vs «всегда 50%» (0.25): 0.374")
      assert_contains(blk, "Skill vs базовая частота исходов (0.583): 0.356")
      assert_contains(blk, "Hit-rate при p ≥ 80%: недостаточно данных (4/10)")
      // crowd-линия — отдельный контур: 10 строк с brier_crowd = 0.25
      if OSPW2SeedIfEmpty("n625crowd") == "empty" then {
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 1.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 0.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 1.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 0.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 1.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 0.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 1.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 0.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 1.0, 0.25)
        let _ = OSPW2SeedCrowd("n625crowd", 0.5, 0.0, 0.25)
      }
      let crb = OSPScoreBlock("n625crowd")
      assert_contains(crb, "Brier толпы/рынка: 0.250")
      assert_contains(crb, "skill vs толпа: 0.000")
  }}

test "n625 monthly: писатель monthly_reviews через strftime — строка периода" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      if OSPW2SeedIfEmpty("n625test") == "empty" then {
        let _ = OSPW2SeedResolved("n625test", 0.9, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.8, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.7, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.6, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.5, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.4, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.3, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.2, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.1, 0.0)
        let _ = OSPW2SeedResolved("n625test", 0.85, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.95, 1.0)
        let _ = OSPW2SeedResolved("n625test", 0.55, 1.0)
      }
      let pm = query("SELECT strftime('%Y-%m', 'now') AS p", [])
      let period = to_string(json_get(get(pm, 0.0), "p", ""))
      let mr = OSPMonthlyReview(period, "n625test")
      assert_contains(mr, "OK|" + period + "|verified=12|brier=0.156")
      let row = query("SELECT forecasts_verified, brier_average FROM monthly_reviews WHERE year_month = ?", [period])
      assert_eq(to_float(to_string(json_get(get(row, 0.0), "forecasts_verified", "0"))), 12.0)
      assert_contains(to_string(json_get(get(row, 0.0), "brier_average", "")), "0.15645")
      // пустой период — честный отказ без выдуманных нулей
      assert_contains(OSPMonthlyReview("2025-01", "n625test"), "разрешённых прогнозов нет")
      // кривой период — отказ по форме
      assert_contains(OSPMonthlyReview("2026-1", "n625test"), "NO|период не ГГГГ-ММ")
  }}

// Фикстура owner-карточки для вахты
pattern OSPW3SeedOwnerCard(status: String, resolve_by: String, with_outcome: Bool) -> String {
  let _ = OSPFEnsureSchema()
  if with_outcome then {
    let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_raw, p_final, kent_label, cal_bucket, resolve_by, outcome, created_at) VALUES ('owner', ?, ?, 0.5, 0.5, 'примерно равные шансы (35-65%)', 5, ?, 1.0, datetime('now'))", ["n626 вахта-вопрос " + status + " " + resolve_by + " с исходом", status, resolve_by])
  } else {
    let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_raw, p_final, kent_label, cal_bucket, resolve_by, created_at) VALUES ('owner', ?, ?, 0.5, 0.5, 'примерно равные шансы (35-65%)', 5, ?, datetime('now'))", ["n626 вахта-вопрос " + status + " " + resolve_by + " без исхода", status, resolve_by])
  }
  return "ok"
}

