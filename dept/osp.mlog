        let _ = OSPW27SeedCal("n627cal", 0.9, 1.0, 42.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.1, 0.0, 41.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.9, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.1, 0.0, 39.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.9, 1.0, 38.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.1, 0.0, 37.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.9, 1.0, 36.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.1, 0.0, 35.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.9, 1.0, 34.0, "")
        let _ = OSPW27SeedCal("n627cal", 0.1, 0.0, 33.0, "")
      }
      let r = OSPPlattFit("n627cal")
      // ожидание из симуляции: a≈2.11, gain=0.00991 → ADOPTED
      assert_contains(r, "ADOPTED gain=0.0099")
      assert_contains(r, "holdout_n=30 train_n=60")
      // ADOPTED → применение: p=0.9 тянется к краю (sigmoid(2.11·logit(0.9))≈0.990)
      let ap = OSPPlattApply(0.9)
      assert_eq(ap > 0.95, true)
      let cn = query("SELECT value FROM system_settings WHERE key = 'osp_cal_note'", [])
      assert_contains(to_string(json_get(get(cn, 0.0), "value", "")), "ADOPTED")
  }}

test "n627 Platt порог: слабый выигрыш 0.0040 < 0.005 → REJECTED (MUT порога 0 → красный)" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      if OSPW2SeedIfEmpty("n627thresh") == "empty" then {
        // 60 строк обучения — сильная связь (как тест A)
        let _ = OSPW27SeedCal("n627thresh", 0.9, 1.0, 120.0, "")
