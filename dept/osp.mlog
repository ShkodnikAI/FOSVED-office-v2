        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.5, 0.0, 40.0, "")
      }
      let r = OSPPlattFit("n627thresh")
      // «нет выигрыша на отложке → REJECTED»: gain=0.0026 < 0.005
      // (симуляция 0.002642; запас ×1.9 от дрейфа GD между python и mlog)
      assert_contains(r, "REJECTED gain=0.0026")
      // MUT-приёмка: снизить порог до 0 → ADOPTED → этот тест красный
      // идентичность побитово: OSPPlattApply вернул вход без изменений
      assert_eq(OSPPlattApply(0.42), 0.42)
  }}

