// ═══════════════════════════════════════════════════════════════════════
// VERIFICATION & CALIBRATION
// ═══════════════════════════════════════════════════════════════════════
pattern OSPVerify(query: String, chat_id: String) -> String {
  let rows = query("SELECT id, topic, confidence FROM analysis WHERE status IN ('watching','published') AND topic LIKE ? LIMIT 5", ["%" + query + "%"])
  if length(rows) == 0 then { return "Нет анализов для верификации: " + query }
  let context = BuildOSPContext(query, "general", chat_id)
  let prompt = context + "\n\nВЕРИФИКАЦИЯ: предсказали→произошло→Brier→систематическая ошибка→corrigendum."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Верифицируй: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_verify", "osp", "")
  return reply
}

pattern OSPCalibrationScore(chat_id: String) -> String {
  let total = query("SELECT COUNT(*) as c FROM analysis", [])
  let verified = query("SELECT COUNT(*) as c FROM analysis WHERE status = 'verified'", [])
  let t_count = to_string(json_get(get(total, 0), "c", "0"))
  let v_count = to_string(json_get(get(verified, 0), "c", "0"))
  let brier_rows = query("SELECT AVG(brier_total) as avg_brier FROM analysis_verifications", [])
  let avg_brier = "N/A"
  if length(brier_rows) > 0 then { let avg_brier = to_string(json_get(get(brier_rows, 0), "avg_brier", "N/A")) }
  let context = BuildOSPContext("калибровка", "general", chat_id)
  let prompt = context + "\n\nКАЛИБРОВКА. Всего: " + t_count + " Верифицировано: " + v_count + " Avg Brier: " + avg_brier + " Цели: Y1≤0.25 Y2≤0.20 Y3≤0.18"
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Калибровочный скор ОСП"))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_score", "osp", "total=" + t_count + " verified=" + v_count + " brier=" + avg_brier)
  return reply
}

pattern OSPRecalibrate(chat_id: String) -> String {
  let context = BuildOSPContext("рекалибровка", "general", chat_id)
  let prompt = context + "\n\nРЕКАЛИБРОВКА: повторяющиеся ошибки→недоиспользуемые навыки→калибровочные смещения→3 конкретных изменения."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Рекалибровка ОСП"))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = db_execute("INSERT INTO monthly_reviews (year_month, improvements) VALUES (to_char(datetime('now'), 'YYYY-MM'), ?)", [substring(reply, 0, 2000)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_recalibrate", "osp", "")
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// RED TEAM & BETS
// ═══════════════════════════════════════════════════════════════════════
pattern OSPRedteam(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = context + "\n\nRED TEAM: доминирующий тезис→5 аргументов ПРОТИВ→вероятности→асимметрия→рекомендация."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Red team: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result) + "\n\n" + OSPDisclaimerBottom()
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_redteam", "osp", "")
  return reply
}

pattern OSPRegisterBet(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nАСИММЕТРИЧНАЯ СТАВКА: тезис→bounded downside→upside→ratio≥3:1→EV→условия выхода→горизонт→исполнение."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Ставка: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  let reply = reply + "\n\n" + OSPDisclaimerBottom()
  let _ = db_execute("INSERT INTO asymmetric_bet (thesis, status) VALUES (?, 'OPEN')", [substring(query, 0, 500)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_bet", "osp", "")
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// I&W WATCHLIST
// ═══════════════════════════════════════════════════════════════════════
pattern OSPWatch(query: String, chat_id: String) -> String {
  let _ = db_execute("INSERT INTO watchlist_scenarios (scenario_label, description, status) VALUES (?, ?, 'pending')", [substring(query, 0, 100), query])
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = context + "\n\nI&W: индикаторы 30/60/90/180/365 дней, пороги, действие при активации."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Watch: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_watch", "osp", "")
  return reply
}
pattern OSPUnwatch(query: String, chat_id: String) -> String {
  // №312: DELETE — irreversible-content, через грант (№421/ADR-0155)
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:delete:watchlist_scenarios", 3600.0, "once"), "DELETE FROM watchlist_scenarios WHERE scenario_label = ?", [substring(query, 0, 100)]))
  let _ = AuditLog("osp_unwatch", "osp", "removed")
  return "Удалено из watchlist: " + query
}
pattern OSPAlertEscalation(scenario_id: Int, level: String) -> String {
  if level == "red" then {
    let _ = AuditLog("osp_alert_red", "osp", "IMMEDIATE id=" + to_string(scenario_id))
    return "RED ALERT: immediate notification"
  }
  if level == "orange" then {
    let _ = AuditLog("osp_alert_orange", "osp", "SPECIFIC id=" + to_string(scenario_id))
    return "ORANGE ALERT: specific notification"
  }
  let _ = AuditLog("osp_alert_yellow", "osp", "WEEKLY id=" + to_string(scenario_id))
  return "YELLOW: weekly digest"
}

// ═══════════════════════════════════════════════════════════════════════
// PROFILE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════
pattern OSPProfile(query: String, chat_id: String) -> String {
  let context = BuildOSPContext(query, "political", chat_id)
  let prompt = context + "\n\nDEEP PROFILING: биография→сеть→коммуникация→психология→leverage/vulnerabilities→предсказание→трек-рекорд. [ФАКТ]/[ИНТЕРПРЕТАЦИЯ]/[СПЕКУЛЯЦИЯ]"
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Profile: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = db_execute("INSERT INTO profiles (subject_name, subject_type, full_profile) VALUES (?, 'person', ?) ON CONFLICT (subject_name) DO UPDATE SET full_profile = EXCLUDED.full_profile, last_updated_at = datetime('now')", [substring(query, 0, 200), substring(reply, 0, 5000)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_profile", "osp", "subject: " + substring(query, 0, 100))
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SEARCH & RECORDING
// ═══════════════════════════════════════════════════════════════════════
pattern OSPTavilySearch(query: String, chat_id: String) -> String {
  // office#354: транспорт через общий паттерн TavilySearch (utils.mlog)
  // вместо несуществующего внутреннего роута на :4000. Транспорт — прямой
  // вызов api.tavily.com, один путь к Tavily на весь проект.
  let response = TavilySearch(query, "osp")
  if response == "()" then { return "Tavily недоступен." }
  let reply = TavilyFormatBlock(response)
  if reply == "" then { return "Tavily недоступен: пустой ответ." }
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  return reply
}
pattern OSPTelegramSearch(query: String, chat_id: String) -> String {
  // #446 A.1 (решение владельца: построить): TG-скан идёт через ЖИВОЙ
  // mlog-роут /lz/telegram (:10001, app.mlog — тот же секрет-контракт №318,
  // hash-form), внутри — живой LZTelegramSearch (dept/lz.mlog).
  // Раньше: http_post на несуществующий Flask-роут :4000/lz/telegram —
  // поиск «/osp tg» молча терялся (класс ошибок №1, #381).
  let result = TryVal(try http_post("http://127.0.0.1:10001/lz/telegram?secret=" + redact(env("CRON_SECRET"), "hash_only"), json_encode({query: query, dept: "osp", chat_id: chat_id}), "application/json", 90.0))
  if to_string(result) == "()" then { return "Telegram недоступен." }
  let reply = redact(to_string(json_get(parse_json(result), "response", "Search failed.")), "all")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  return reply
}
pattern OSPRecordDivergence(pair: String, div_type: String, z_score: Float, notes: String) -> String {
  let _ = db_execute("INSERT INTO cross_asset_divergences (pair_assets, divergence_type, z_score, notes) VALUES (?, ?, ?, ?)", [pair, div_type, to_string(z_score), notes])
  return "OK: divergence recorded"
}
pattern OSPRecordRegime(regime: String, region: String, notes: String) -> String {
  let _ = db_execute("INSERT INTO macro_regime_snapshots (regime, region, regime_notes) VALUES (?, ?, ?)", [regime, region, notes])
  return "OK: regime recorded"
}
pattern OSPGetCurrentRegime(region: String) -> String {
  let rows = query("SELECT regime, regime_notes, date FROM macro_regime_snapshots WHERE region = ? ORDER BY date DESC LIMIT 1", [region])
  if length(rows) == 0 then { return "No regime for " + region }
  return to_string(json_get(get(rows, 0), "regime", "")) + " [" + to_string(json_get(get(rows, 0), "date", "")) + "]"
}
pattern OSPUpdateBetStatus(bet_id: Int, new_status: String, note: String) -> String {
  let _ = db_execute("UPDATE asymmetric_bet SET status = ?, outcome_note = ? WHERE id = ?", [new_status, note, to_string(bet_id)])
  return "OK: bet " + to_string(bet_id) + " → " + new_status
}

