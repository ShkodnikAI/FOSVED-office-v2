test "n626 resolve полный: исходы записаны, Brier, конфиг-непригодные помечены" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let due = "2027-04-01"
      let _ = kv_set("osp_ensemble_models", "off")
      let _ = OSPW3SeedRound(due, 2.0)
      let qid1 = OSPBenchQid("kalshi", "r1", due)
      let qid2 = OSPBenchQid("kalshi", "r2", due)
      let _ = OSPW3SeedQuestion(due, qid1, "kalshi", "Резолв-вопрос r1 n626", "2030-01-01", "0.5", "N/A")
      let _ = OSPW3SeedQuestion(due, qid2, "kalshi", "Резолв-вопрос r2 n626", "2030-01-01", "0.5", "N/A")
      // наши строки: p=0.7 со СВЕЖЕЙ конфигурацией, p=0.2 со СТАРОЙ (поправка 3)
      let _ = OSPW3SeedBenchRow(qid1, "2031-01-01", 0.7, OSPBenchConfigCurrent())
      let _ = OSPW3SeedBenchRow(qid2, "2031-01-01", 0.2, "старая-конфигурация")
      let payload = "{\"resolutions\": [{\"id\": \"r1\", \"source\": \"kalshi\", \"resolution_date\": \"2031-01-01\", \"resolved\": true, \"resolved_to\": 1.0}, {\"id\": \"r2\", \"source\": \"kalshi\", \"resolution_date\": \"2031-01-01\", \"resolved\": true, \"resolved_to\": 0.0}, {\"id\": \"zz\", \"source\": \"fred\", \"resolution_date\": \"2031-01-01\", \"resolved\": true, \"resolved_to\": 0.0}]}"
      let r = OSPBenchResolveData(due, payload)
      // Brier покрытых: (0.7−1)² и (0.2−0)² → среднее 0.065; нет нашего прогноза: 1 (fred zz); штраф +0.25
      assert_contains(r, "RESOLVE|due=" + due)
      assert_contains(r, "разрешено_наших=2")
      assert_contains(r, "нет_нашего_прогноза=1")
      assert_contains(r, "Brier_покрытых=0.065")
      assert_contains(r, "покрытие=2/2")
      assert_contains(r, "штраф_за_пропуски=+0.250")
      assert_contains(r, "конфиг-несовместимых=1")
      // строки: resolved, outcome, brier — float через OSPFmt3 (артефакты binary)
      let rows = query("SELECT bench_qid, status, outcome, brier, gate_report FROM osp_forecast WHERE kind = 'bench' AND bench_qid LIKE ? ORDER BY bench_qid", [qid1 + "|%"])
      assert_eq(OSPFmt3(to_float(to_string(json_get(get(rows, 0.0), "brier", "0")))), "0.090")
      assert_eq(to_string(json_get(get(rows, 0.0), "status", "?")), "resolved")
      // повторный resolve — идемпотентен: разрешать нечего
      let r2 = OSPBenchResolveData(due, payload)
      assert_contains(r2, "разрешено_наших=0")
  }}

test "n626 вахта: due-карточки в списке, bench — отдельная строка, истёкшие архивируются" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let today = query("SELECT date('now') AS d, date('now', '-10 days') AS old, date('now', '-2 days') AS recent", [])
      let dnow = to_string(json_get(get(today, 0.0), "d", ""))
      let dold = to_string(json_get(get(today, 0.0), "old", ""))
      let drec = to_string(json_get(get(today, 0.0), "recent", ""))
      // due-owner-карточка без исхода — ждёт сверки
      let _ = OSPW3SeedOwnerCard("watching", dold, false)
      // bench-строка с наступившим горизонтом — строка про OSPBenchResolve
      let _ = OSPW3SeedBenchRow(OSPBenchQid("kalshi", "w1", "2027-05-01"), dold, 0.5, OSPBenchConfigCurrent())
      let w = OSPWatchDue(dnow)
      assert_contains(w, "ждёт сверки")
      assert_contains(w, "/osp resolve")
      assert_contains(w, "bench")
      // в грейсе (2 дня) и свежая due-карточка — старая (>7 дней) архивируется
      let _ = OSPW3SeedOwnerCard("watching", drec, false)
      let exp = OSPArchiveExpired(dnow)
      assert_contains(exp, "истекла без исхода")
      let ev = query("SELECT COUNT(*) AS c FROM osp_forecast_events WHERE to_status = 'expired' AND reason LIKE 'истекла без исхода%'", [])
      assert_eq(to_float(to_string(json_get(get(ev, 0.0), "c", "0"))) >= 1.0, true)
      // повторная архивация — уже терминальный статус, вахта чистая
      assert_contains(OSPArchiveExpired(dnow), "вахта: истёкших нет")
      // карточка в грейсе не тронута
      let gr = query("SELECT COUNT(*) AS c FROM osp_forecast WHERE status = 'watching' AND resolve_by = ?", [drec])
      assert_eq(to_float(to_string(json_get(get(gr, 0.0), "c", "0"))) >= 1.0, true)
  }}

// ═══════════════════════════════════════════════════════════════════════
// Тесты W4 #627: Platt (§5.2), сжатие поправки 1, кривая, методики §7.2,
// A/B §7.4. Фикстуры подобраны симуляцией (scripts/n627_platt_sim.py):
//   A: train/hold сильная связь → a=2.11, gain=0.0099 → ADOPTED
//   B: hold нейтральный (p=0.5, y пополам) → gain=0.0000 → REJECTED
//      (мутация порога 0.005→0: ADOPTED — тест красный)
//   C: hold обратный → gain=−0.17 → REJECTED (честный fit);
//      мутация «обучить на отложке» → gain=+0.81 ADOPTED — тест красный
// ═══════════════════════════════════════════════════════════════════════

// Фикстура: resolved-строка с исходом и verified_at N дней назад
// (ORDER BY verified_at DESC, id DESC — хвост отложки всегда новее обучения)
pattern OSPW27SeedCal(kind: String, p: Float, y: Float, days_ago: Float, gate: String) -> String {
  let _ = OSPFEnsureSchema()
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_final, outcome, cal_bucket, verified_at, gate_report, created_at) VALUES (?, ?, 'resolved', ?, ?, 1, datetime('now', '-' || ? || ' days'), ?, datetime('now'))", [kind, "n627 cal-fixture " + kind + " p=" + to_string(p) + " y=" + to_string(y), to_string(p), to_string(y), to_string(days_ago), gate])
  return "ok"
}

// Фикстура: resolved-строка с базовой частотой (для OSPPriorFit, поправка 1)
pattern OSPW27SeedPrior(kind: String, p: Float, y: Float, rate: Float, n: Float, days_ago: Float) -> String {
  let _ = OSPFEnsureSchema()
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_final, outcome, prior_rate, prior_n, cal_bucket, verified_at, created_at) VALUES (?, ?, 'resolved', ?, ?, ?, ?, 1, datetime('now', '-' || ? || ' days'), datetime('now'))", [kind, "n627 prior-fixture " + kind, to_string(p), to_string(y), to_string(rate), to_string(n), to_string(days_ago)])
  return "ok"
}

// Фикстура: resolved-карточка + строка прогона ансамбля (для OSPMethodAB)
pattern OSPW27SeedAB(kind: String, method: String, p_i: Float, y: Float) -> String {
  let _ = OSPFEnsureSchema()
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_final, outcome, cal_bucket, verified_at, created_at) VALUES (?, ?, 'resolved', ?, ?, 1, datetime('now'), datetime('now'))", [kind, "n627 ab-fixture " + kind, to_string(p_i), to_string(y)])
  let _ = db_execute("INSERT INTO osp_forecast_method_runs (forecast_id, method, p_i, family) VALUES ((SELECT id FROM osp_forecast WHERE question = ? AND kind = ? ORDER BY id DESC LIMIT 1), ?, ?, ?)", ["n627 ab-fixture " + kind, kind, method, to_string(p_i), OSPFamilyOf(method)])
  return "ok"
}

