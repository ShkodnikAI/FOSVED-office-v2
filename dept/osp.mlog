pattern OSPRedteam(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id, 1)
  let prompt = context + "\n\nRED TEAM: доминирующий тезис→5 аргументов ПРОТИВ→вероятности→асимметрия→рекомендация."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Red team: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result) + "\n\n" + OSPDisclaimerBottom()
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_redteam", "osp", "")
  return reply
}

pattern OSPRegisterBet(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id, 1)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nАСИММЕТРИЧНАЯ СТАВКА: тезис→bounded downside→upside→ratio≥3:1→EV→условия выхода→горизонт→исполнение."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Ставка: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  let reply = reply + "\n\n" + OSPDisclaimerBottom()
  let _ = db_execute("INSERT INTO asymmetric_bet (thesis, status) VALUES (?, 'OPEN')", [substring(query, 0, 500)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_bet", "osp", "")
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// I&W WATCHLIST
// ═══════════════════════════════════════════════════════════════════════
pattern OSPWatch(query: String, chat_id: String) -> String {
  let _ = db_execute("INSERT INTO watchlist_scenarios (scenario_label, description, status) VALUES (?, ?, 'pending')", [substring(query, 0, 100), query])
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id, 1)
  let prompt = context + "\n\nI&W: индикаторы 30/60/90/180/365 дней, пороги, действие при активации."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Watch: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_watch", "osp", "")
  return reply
}
pattern OSPUnwatch(query: String, chat_id: String) -> String {
  // №312: DELETE — irreversible-content, через грант (№421/ADR-0155)
  let _ = TryVal(try db_execute_with_grant(grant_issue("db:delete:watchlist_scenarios", 3600.0, "once"), "DELETE FROM watchlist_scenarios WHERE scenario_label = ?", [substring(query, 0, 100)]))
  let _ = AuditLog("osp_unwatch", "osp", "removed")
  return "Удалено из watchlist: " + query
}

// ═══════════════════════════════════════════════════════════════════════
// PROFILE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════
pattern OSPProfile(query: String, chat_id: String) -> String {
  let context = BuildOSPContext(query, "political", chat_id, 1)
  let prompt = context + "\n\nDEEP PROFILING: биография→сеть→коммуникация→психология→leverage/vulnerabilities→предсказание→трек-рекорд. [ФАКТ]/[ИНТЕРПРЕТАЦИЯ]/[СПЕКУЛЯЦИЯ]"
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Profile: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = db_execute("INSERT INTO profiles (subject_name, subject_type, full_profile) VALUES (?, 'person', ?) ON CONFLICT (subject_name) DO UPDATE SET full_profile = EXCLUDED.full_profile, last_updated_at = datetime('now')", [substring(query, 0, 200), substring(reply, 0, 5000)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_profile", "osp", "subject: " + substring(query, 0, 100))
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SEARCH & RECORDING
// ═══════════════════════════════════════════════════════════════════════
pattern OSPTavilySearch(query: String, chat_id: String) -> String {
  // office#354: транспорт — общий паттерн TavilySearch (utils.mlog).
  // TEAM-1 #480: честные причины и гео-дополнение — OSPLiveSearchBlock;
  // это единственный прямой путь ОСП к Tavily — команда владельца.
  // Автоматический анализ ходит через командную работу с ЛЗ (ADR-0016).
  let reply = OSPLiveSearchBlock(query)
  if reply == "" then { return "Tavily недоступен: пустой ответ." }
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  return reply
}
pattern OSPTelegramSearch(query: String, chat_id: String) -> String {
  // #446 A.1 (решение владельца: построить): TG-скан идёт через ЖИВОЙ
  // mlog-роут /lz/telegram (:10001, app.mlog — тот же секрет-контракт №318,
  // hash-form), внутри — живой LZTelegramSearch (dept/lz.mlog).
  // Раньше: http_post на несуществующий Flask-роут :4000/lz/telegram —
  // поиск «/osp tg» молча терялся (класс ошибок №1, #381).
  let result = TryVal(try http_post("http://127.0.0.1:10001/lz/telegram?secret=" + redact(env("CRON_SECRET"), "hash_only"), json_encode({query: query, dept: "osp", chat_id: chat_id}), "application/json", 90.0))
  if to_string(result) == "()" then { return "Telegram недоступен." }
  let reply = redact(to_string(json_get(parse_json(result), "response", "Search failed.")), "all")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  return reply
}
pattern OSPUpdateBetStatus(bet_id: Int, new_status: String, note: String) -> String {
  let _ = db_execute("UPDATE asymmetric_bet SET status = ?, outcome_note = ? WHERE id = ?", [new_status, note, to_string(bet_id)])
  return "OK: bet " + to_string(bet_id) + " → " + new_status
}

// ═══════════════════════════════════════════════════════════════════════
// BOT COMMAND REGISTRY
// /osp <topic> /osp quick /osp deep /osp full /osp wargame
// /osp regime /osp cantillon /osp narrative /osp verify /osp score
// /osp recalibrate /osp bet /osp redteam /osp watch /osp unwatch
// /osp profile /osp tavily /osp tg
//
// DEPT REGISTRY: osp | v4.0 | call_llm:15 | CallLLMProxy:0 | patterns:56
// | db_execute:16 | gates:12 | disclaimer:top+bottom+safety | cross:4
// | skills:23(T1:10 T2:10 T3:3) | models:15 | lifecycle:7 states
// | brier_targets: Y1≤0.25 Y2≤0.20 Y3≤0.18
// Source: Fosved_v4_1_Transition_Pack (SPD), library/osp.md v3.0, schema-v4.1.prisma

// ═══════════════════════════════════════════════════════════════════════
// TESTS — наряд #469: сценарный гейт (реальное исполнение чистых функций).
// Прогон: ./bin/mlog test dept/osp.mlog — интегрирован в
// tests/test_n469_osp_scenario_gate.py (pytest вызывает subprocess).
// ═══════════════════════════════════════════════════════════════════════

// ── TEAM-2 #481 A.1: навык osp/forecast (реестр dept/team.mlog) ──────
// Тихая облегчённая функция: калиброванная оценка без 12 гейтов полного
// ответа ОСП (глубина для коллег, не для владельца). Не пишет в диалог.
pattern OSPForecast(question: String) -> String {
  let prompt = "Ты ОСП (отдел стратегического прогнозирования), коллега запрашивает навык forecast: калиброванная оценка вероятности. Вопрос: " + question + "\nФормат: (1) уточнённая формулировка прогноза и горизонт; (2) оценка вероятности с обоснованием по фактам из вопроса; (3) что изменило бы оценку; (4) метка уверенности. Без приветствий и подписи."
  let r = redact(to_string(TryVal(try call_llm(prompt, question))), "all")
  if r == "()" then { return "(коллега osp/forecast недоступен: модель не ответила)" }
  // TEAM-3 #482 A.4: прогноз с горизонтом публикуется на доску (видят Эксперт/Финансы/ЛЗ;
  // связь с верификацией Brier). Дедуп по (osp, тема, день) — повторные консультации не плодят записей.
  let _ = TeamPublish("osp", "forecast", question, "[]", substring(r, 0.0, 600.0), "", 72.0)
  return r
}

// ── TEAM-2 #481 A.1: навык osp/cross_country ─────────────────────────
pattern OSPCrossCountry(question: String) -> String {
  let prompt = "Ты ОСП, коллега запрашивает навык cross_country: кросс-страновая проекция. Вопрос: " + question + "\nФормат: различия между странами/юрисдикциями по существу вопроса, таблицей или списком; где различия принципиальны. Без приветствий и подписи."
  let r = redact(to_string(TryVal(try call_llm(prompt, question))), "all")
  if r == "()" then { return "(коллега osp/cross_country недоступен: модель не ответила)" }
  return r
}

// ═══════════════════════════════════════════════════════════════════════
// W1 #624 — КАРТОЧКА ПРОГНОЗА И ЖИЗНЕННЫЙ ЦИКЛ (OSP_DESIGN_v1 §1, §3.2–3.3,
// §4.1–4.2, §10; поправки владельца 02.11 — приоритет над дизайном).
//   • Поправка 1: базовая частота — вход модели (промпт), НЕ механическое
//     сжатие: OSPBlendPrior/OSPPriorWeight в W1 не пишутся, p_final = clip(p).
//   • Прогон один (ансамбль — W2): p_ensemble = p_raw, n_runs = 1.
//   • Гейты W1: G1 (структурный хвост, json_validate), G2 (критерий/даты),
//     G5 (наблюдаемый источник); G3 — W2 (ансамбль), G4 — #469 без изменений,
//     G6/W3 (рынок) — W2.
//   • История отказов сохраняется: карточка создаётся в drafted ДО гейтов,
//     каждый переход и каждый отказ — строка в osp_forecast_events (§3.5.4).
// ═══════════════════════════════════════════════════════════════════════

// Схема §3.2: таблицы карточки (osp_base_rates/osp_bench_* — волны 2–3)
// + аддитивный ALTER-хвост §3.3 (один грант, гвардованный AlterColIfMissing).
pattern OSPFEnsureSchema() -> String {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS osp_forecast (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT NOT NULL DEFAULT 'owner', question TEXT NOT NULL, resolution_criteria TEXT, as_of TEXT, resolve_by TEXT, status TEXT NOT NULL DEFAULT 'drafted', p_raw REAL, p_ensemble REAL, p_median REAL, p_logit REAL, p_spread REAL, n_runs INTEGER DEFAULT 0, p_final REAL, crowd_p REAL, prior_rate REAL, prior_n INTEGER, outcome REAL, brier REAL, brier_base REAL, brier_crowd REAL, cal_bucket INTEGER, kent_label TEXT, analysis_id INTEGER, bench_qid TEXT, resolution_date TEXT, methods_json TEXT DEFAULT '[]', gate_report TEXT, models_json TEXT, sources_json TEXT, market_dissent_reason TEXT, published_at TEXT, verified_at TEXT, updated_at TEXT, created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE INDEX IF NOT EXISTS idx_ospf_kind_status ON osp_forecast(kind, status)", [])
  let _ = db_execute("CREATE INDEX IF NOT EXISTS idx_ospf_resolve ON osp_forecast(status, resolve_by)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS osp_forecast_events (id INTEGER PRIMARY KEY AUTOINCREMENT, forecast_id INTEGER NOT NULL, from_status TEXT, to_status TEXT, reason TEXT, actor TEXT DEFAULT 'osp', created_at TEXT, FOREIGN KEY(forecast_id) REFERENCES osp_forecast(id))", [])
  // #625 W2: базовые частоты по классам вопросов — вход прогона ансамбля
  // (поправка 1 владельца); писатель приходит с W3/bench, читатель — OSPBaseRate
  let _ = db_execute("CREATE TABLE IF NOT EXISTS osp_base_rates (topic TEXT PRIMARY KEY, n INTEGER, base_rate REAL, source TEXT, updated_at TEXT)", [])
  // #625 W2: три таблицы-писателя W2 — CREATE идемпотентен к InitDB app.mlog
  // (списки колонок 1:1 с app.mlog:280/:402/:443); в изолированном прогоне
  // dept-файла app.mlog недоступен — без этого тесты верификации падают
  let _ = db_execute("CREATE TABLE IF NOT EXISTS brier_score_log (id INTEGER PRIMARY KEY AUTOINCREMENT, analysis_id INTEGER, forecast_probability REAL, actual_outcome REAL, brier_score REAL, cumulative_brier REAL, total_forecasts INTEGER, created_at TEXT DEFAULT (datetime('now')), FOREIGN KEY(analysis_id) REFERENCES analysis(id))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS monthly_reviews (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER DEFAULT 0, year_month TEXT UNIQUE, forecasts_verified INTEGER DEFAULT 0, brier_average REAL, brier_trend REAL, hit_rate_high_conf REAL, surprise_index REAL, calibration_curve TEXT DEFAULT '[]', error_clusters TEXT, dominant_error TEXT, improvements TEXT DEFAULT '[]', improvements_applied INTEGER DEFAULT 0, flags_for_quarterly TEXT, created_at TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS system_settings (key TEXT PRIMARY KEY, value TEXT)", [])
  // #627 W4 (§7.4): седьмая таблица — A/B методологий. Каждый прогон ансамбля
  // пишет (forecast_id, method, p_i, family); после разрешения исхода карточки
  // OSPMethodAB группирует с полом n≥10 → skill_reviews.success_rate
  let _ = db_execute("CREATE TABLE IF NOT EXISTS osp_forecast_method_runs (id INTEGER PRIMARY KEY AUTOINCREMENT, forecast_id INTEGER NOT NULL, method TEXT NOT NULL, p_i REAL NOT NULL, family TEXT DEFAULT '', created_at TEXT DEFAULT (datetime('now')), FOREIGN KEY(forecast_id) REFERENCES osp_forecast(id))", [])
  let _ = db_execute("CREATE INDEX IF NOT EXISTS idx_ospmr_method ON osp_forecast_method_runs(method)", [])
  let _ = db_execute("CREATE INDEX IF NOT EXISTS idx_ospmr_fid ON osp_forecast_method_runs(forecast_id)", [])
  // try: изолированный python-гвард (mlog test dept/osp.mlog) не знает
  // utils (AlterColIfMissing) — UNDEFINED_FUNCTION глотается, миграционная
  // часть проверяется в полном прогоне app.mlog; в serve — резолвится глобально
  let mig = grant_issue("db:alter:*", 120, "n", 52)
  let _ = try AlterColIfMissing(mig, "analysis", "osp_forecast_id", "ALTER TABLE analysis ADD COLUMN osp_forecast_id INTEGER")
  let _ = try AlterColIfMissing(mig, "analysis_verifications", "osp_forecast_id", "ALTER TABLE analysis_verifications ADD COLUMN osp_forecast_id INTEGER")
  let _ = try AlterColIfMissing(mig, "watchlist_scenarios", "osp_forecast_id", "ALTER TABLE watchlist_scenarios ADD COLUMN osp_forecast_id INTEGER")
  let _ = try AlterColIfMissing(mig, "watchlist_scenarios", "threshold_json", "ALTER TABLE watchlist_scenarios ADD COLUMN threshold_json TEXT")
  let _ = try AlterColIfMissing(mig, "indicator", "osp_forecast_id", "ALTER TABLE indicator ADD COLUMN osp_forecast_id INTEGER")
  let _ = try AlterColIfMissing(mig, "research_source", "as_of", "ALTER TABLE research_source ADD COLUMN as_of TEXT")
  let _ = try AlterColIfMissing(mig, "osp_forecast", "market_dissent_reason", "ALTER TABLE osp_forecast ADD COLUMN market_dissent_reason TEXT")
  // #627 W4 §7.2: допущения Key Assumptions Check — на карточку (структура)
  let _ = try AlterColIfMissing(mig, "osp_forecast", "assumptions_json", "ALTER TABLE osp_forecast ADD COLUMN assumptions_json TEXT")
  return "ok"
}

// G1: структурный хвост ответа — строка `CARD: {json}` в конце прозы.
// Извлечение — split по маркеру (LLM не зовётся, runtime ±0); форма —
// json_validate под try: «не JSON» = провал прогона, а не 0.5 молча (§4.1).
pattern OSPFCardSchema() -> String {
  // #627 W4: methods (§7.2 — cg_chain/frame/matrix/forces/tree/narratives)
  // и assumptions — ОПЦИОНАЛЬНЫЕ поля: старые хвосты без них валидны,
  // required не тронут — форма существующих ответов не меняется
  return "{\"type\":\"object\",\"properties\":{\"p\":{\"type\":\"number\"},\"resolution_criteria\":{\"type\":\"string\"},\"resolve_by\":{\"type\":\"string\"},\"as_of\":{\"type\":\"string\"},\"market_dissent_reason\":{\"type\":\"string\"},\"methods\":{\"type\":\"object\"},\"assumptions\":{\"type\":\"array\"}},\"required\":[\"p\",\"resolution_criteria\",\"resolve_by\",\"as_of\"]}"
}

// OK|<json> — хвост есть и валиден; FAIL|<причина> — брак формы; MISS — нет.
pattern OSPFExtractCard(reply: String) -> String {
  let parts = split(reply, "CARD:")
  if length(parts) < 2.0 then { return "MISS" }
  let tail = trim(to_string(get(split(to_string(get(parts, 1.0)), "\n"), 0.0)))
  if tail == "" then { return "MISS" }
  let r = try json_validate(OSPFCardSchema(), tail)
  if r.ok == false then { return "FAIL|json не разобран: " + to_string(r.error.message) }
  let v = r.value
  if to_string(json_get(v, "valid", "false")) != "true" then {
    return "FAIL|форма хвоста: " + to_string(json_get(v, "errors", ""))
  }
  return "OK|" + tail
}

// Владельцу уходит проза без машиночитаемого хвоста (формат ответа не меняется)
pattern OSPFStripCard(reply: String) -> String {
  let parts = split(reply, "CARD:")
  if length(parts) < 2.0 then { return reply }
  return to_string(get(parts, 0.0))
}

// Знаковые дни от сейчас до ISO-даты; -99999 = не распарсилось (приём card.mlog)
pattern OSPFEpochOf(iso: String) -> Float {
  let t = try date_parse_iso(trim(iso))
  if to_string(t) == "()" then { return -1.0 }
  return to_float(to_string(t))
}

// Гейты W1. G2: критерий ≥20 символов; resolve_by — ISO в будущем;
// as_of — ISO не в будущем (инвариант 6). G5: есть наблюдаемый источник.
pattern OSPCardGates(criteria: String, resolve_by: String, as_of: String, src_json: String) -> String {
  if length(trim(criteria)) < 20.0 then { return "FAIL: G2 критерий исхода короче 20 символов — сверять нечем" }
  let rb = OSPFEpochOf(resolve_by)
  if rb < 0.0 then { return "FAIL: G2 resolve_by не ISO-дата: " + resolve_by }
  if rb <= now_unix() then { return "FAIL: G2 resolve_by в прошлом — окно сверки уже наступило" }
  let ao = OSPFEpochOf(as_of)
  if ao < 0.0 then { return "FAIL: G2 as_of не ISO-дата: " + as_of }
  if ao > now_unix() then { return "FAIL: G2 as_of в будущем — прогноз задним числом не публикуется" }
  if trim(src_json) == "" or trim(src_json) == "[]" then { return "FAIL: G5 нет наблюдаемого источника — прогноз непроверяем (research_source/src_json пусты)" }
  return "PASS"
}

// §5.3: клип [0.02, 0.98] — программа, не модель (инвариант 3)
pattern OSPClip(p: Float) -> Float {
  if p < 0.02 then { return 0.02 }
  if p > 0.98 then { return 0.98 }
  return p
}

// Метка Шермана Кента К числу — обратная OSPShermanKent (формат §9.4)
pattern OSPKentOf(p: Float) -> String {
  if p < 0.05 then { return "почти наверняка нет (0-5%)" }
  if p < 0.20 then { return "очень маловероятно (5-20%)" }
  if p < 0.35 then { return "маловероятно (20-35%)" }
  if p < 0.65 then { return "примерно равные шансы (35-65%)" }
  if p < 0.80 then { return "вероятно (65-80%)" }
  if p < 0.95 then { return "очень вероятно (80-95%)" }
  return "почти наверняка (95-100%)"
}

// Дециль калибровочной кривой: 1..10
pattern OSPBucketOf(p: Float) -> Float {
  let b = to_float(to_int(p * 10.0)) + 1.0
  if b > 10.0 then { return 10.0 }
  if b < 1.0 then { return 1.0 }
  return b
}

// Автомат статусов (§3.2): drafted → gated → published → watching →
// resolved | expired | superseded. Терминальные — история не переписывается;
// drafted→published в карте НЕТ (инвариант 1: публикация только через гейты).
pattern OSPCanTransition(from: String, to: String) -> String {
  if from == to then { return "NO: переход в себя (" + from + ")" }
  if from == "drafted" then {
    if to == "gated" or to == "superseded" then { return "OK" }
    return "NO: drafted → " + to + " — публикация только через гейты"
  }
  if from == "gated" then {
    if to == "published" or to == "drafted" or to == "superseded" then { return "OK" }
    return "NO: gated → " + to
  }
  if from == "published" then {
    if to == "watching" or to == "resolved" or to == "expired" or to == "superseded" then { return "OK" }
    return "NO: published → " + to
  }
  if from == "watching" then {
    if to == "resolved" or to == "expired" or to == "superseded" then { return "OK" }
    return "NO: watching → " + to
  }
  return "NO: " + from + " — терминальный статус (история не переписывается)"
}

// Переход + событие с причиной; отказ — тоже событие REFUSED> (инвариант 4:
// «аудит не зависит от памяти модели»). MUT1-мишень: убрать INSERT события.
pattern OSPTransition(forecast_id: Float, to: String, reason: String, actor: String) -> String {
  let _ = OSPFEnsureSchema()
  let rows = query("SELECT status FROM osp_forecast WHERE id = ?", [to_string(forecast_id)])
  if length(rows) == 0.0 then { return "NO|карточка " + to_string(forecast_id) + " не найдена" }
  let from = to_string(json_get(get(rows, 0.0), "status", ""))
  let allowed = OSPCanTransition(from, to)
  if allowed != "OK" then {
    let _ = db_execute("INSERT INTO osp_forecast_events (forecast_id, from_status, to_status, reason, actor, created_at) VALUES (?, ?, ?, ?, ?, datetime('now'))", [to_string(forecast_id), from, "REFUSED>" + to, allowed + " (причина: " + reason + ")", actor])
    return "NO|" + allowed
  }
  let _ = db_execute("UPDATE osp_forecast SET status = ?, updated_at = datetime('now') WHERE id = ?", [to, to_string(forecast_id)])
  if to == "published" then { let _ = db_execute("UPDATE osp_forecast SET published_at = datetime('now') WHERE id = ?", [to_string(forecast_id)]) }
  let _ = db_execute("INSERT INTO osp_forecast_events (forecast_id, from_status, to_status, reason, actor, created_at) VALUES (?, ?, ?, ?, ?, datetime('now'))", [to_string(forecast_id), from, to, reason, actor])
  return "OK|" + from + " → " + to
}

// Следующее действие по статусу карточки — для владельца и ночной вахты (W3)
pattern OSPNextAction(forecast_id: Float) -> String {
  let _ = OSPFEnsureSchema()
  let rows = query("SELECT status, resolve_by FROM osp_forecast WHERE id = ?", [to_string(forecast_id)])
  if length(rows) == 0.0 then { return "карточка не найдена" }
  let st = to_string(json_get(get(rows, 0.0), "status", ""))
  let rb = to_string(json_get(get(rows, 0.0), "resolve_by", ""))
  if st == "drafted" then { return "дождаться гейтов и публикации (сейчас drafted)" }
  if st == "gated" then { return "устранить причину гейта — последнее событие REFUSED в osp_forecast_events" }
  if st == "published" then { return "перевести в вахту (watching) — прогноз ждёт окна сверки " + rb }
  if st == "watching" then { return "ждать исхода; сверка после " + rb + " (OSPVerifyCard — W2)" }
  if st == "resolved" then { return "исход записан; Brier — в /osp score (W2)" }
  if st == "expired" then { return "карточка истекла без исхода — громкая архивация" }
  return "superseded — заменена новой карточкой"
}

// URL из строки: посимвольно до разделителя (regex в mlog нет; формат
// «https://… — заголовок» и markdown-скобки — оба обрезаются честно)
pattern OSPFURLTill(seg: String) -> String {
  let mut out = ""
  let mut i = 0.0
  while i < length(seg) {
    let ch = substring(seg, i, i + 1.0)
    if ch == " " or ch == ")" or ch == "]" or ch == "," or ch == ";" or ch == "\"" or ch == "'" then { return out }
    out = out + ch
    i = i + 1.0
  }
  return out
}

// URL-ы из контекста прогона (factpack ЛЗ, FRED, news) — CSV через ";"
pattern OSPFURLsFrom(context: String) -> String {
  let lines = split(context, "\n")
  let mut urls = ""
  each l in lines {
    let line = trim(to_string(l))
    if contains(line, "http") then {
      let parts = split(line, "http")
      if length(parts) >= 2.0 {
        let u = "http" + OSPFURLTill(to_string(get(parts, 1.0)))
        if length(u) > 10.0 and contains(urls, u) == false and length(urls) < 1800.0 {
          urls = urls + u + ";"
        }
      }
    }
  }
  return urls
}

// Первый писатель research_source (§9.2): URL из живого контекста, с as_of.
// Возвращает src_json ([] если живого поиска не было — тогда G5 честно
// оставит карточку в gated).
pattern OSPFSourcesToDB(context: String, analysis_id: Int, as_of: String) -> String {
  let _ = OSPFEnsureSchema()
  let urls = split(OSPFURLsFrom(context), ";")
  let mut n = 0.0
  let mut json_arr = "["
  each u in urls {
    let url = trim(to_string(u))
    if url != "" then {
      let _ = db_execute("INSERT INTO research_source (analysis_id, url, title, tier, as_of) VALUES (?, ?, ?, 'secondary', ?)", [to_string(analysis_id), substring(url, 0.0, 300.0), substring(url, 0.0, 120.0), as_of])
      if n > 0.0 then { json_arr = json_arr + "," }
      json_arr = json_arr + "\"" + url + "\""
      n = n + 1.0
    }
  }
  if n == 0.0 then { return "[]" }
  return json_arr + "]"
}

// ── ЕДИНСТВЕННАЯ точка записи карточки (§3.2, §9.1; ответ владельцу —
// из строки БД, OSPFCardLine). Провал гейта — карточка в gated с причиной
// в событиях: тихих отказов нет. MUT2-мишень: OSPCanTransition drafted→published.
// #625 W2: до публикации — ансамбль (OSPEnsemble→OSPEnsembleApply: поля
// p_ensemble/p_spread, G3) и гейты рынка (G6′/W6/W3, поправка 2). crowd_p —
// линия рынка предсказаний; -1 = линии нет (A.9) — гейты рынка молчат.
// #627 W4: p_final — по цепочке сжатие к базовой частоте (OSPPriorApply,
// только при ADOPTED по правилу §5.2 — поправка 1) → clip → Platt
// (OSPPlattApply, только при ADOPTED; при REJECTED — идентичность побитово);
// методики §7.2 — структурный гейт OSPMethodsGate (дерево — блок, остальное
// — марки gate_report); narratives пишут строки indicator.
// methods_json/assumptions_json — из CARD-хвоста (опциональные поля §7.2).
pattern OSPSaveCard(question: String, p_raw: Float, criteria: String, as_of: String, resolve_by: String, src_json: String, analysis_id: Int, prose: String, crowd_p: Float, dissent: String, methods_json: String, assumptions_json: String, depth: Int) -> String {
  let _ = OSPFEnsureSchema()
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, resolution_criteria, as_of, resolve_by, status, p_raw, p_ensemble, n_runs, crowd_p, sources_json, analysis_id, models_json, gate_report) VALUES ('owner', ?, ?, ?, ?, 'drafted', ?, ?, 1, ?, ?, ?, '{\"n_runs\":1}', '')", [question, criteria, as_of, resolve_by, to_string(p_raw), to_string(p_raw), to_string(crowd_p), src_json, to_string(analysis_id)])
  let rows = query("SELECT id FROM osp_forecast WHERE question = ? ORDER BY id DESC LIMIT 1", [question])
  let id = to_float(to_string(json_get(get(rows, 0.0), "id", "0")))
  let _ = db_execute("INSERT INTO osp_forecast_events (forecast_id, from_status, to_status, reason, actor, created_at) VALUES (?, '', 'drafted', 'карточка создана (поправка 1 владельца: базовая частота — вход прогона, без сжатия)', 'osp', datetime('now'))", [to_string(id)])
  // связь с analysis (§3.3) + первый писатель analysis.full_result (§9.6)
  if to_float(to_string(analysis_id)) > 0.0 then {
    let _ = db_execute("UPDATE analysis SET osp_forecast_id = ?, full_result = ? WHERE id = ?", [to_string(id), substring(prose, 0.0, 8000.0), to_string(analysis_id)])
  }
  // G1-арифметика: p ∈ [0,1] (схема типа number это не гарантирует)
  if p_raw < 0.0 or p_raw > 1.0 then {
    let g = OSPTransition(id, "gated", "FAIL: G1 p вне [0,1]: " + to_string(p_raw), "osp")
    return "GATED|" + to_string(id) + "|FAIL: G1 p вне [0,1]: " + to_string(p_raw)
  }
  let gates = OSPCardGates(criteria, resolve_by, as_of, src_json)
  if gates != "PASS" then {
    let g = OSPTransition(id, "gated", gates, "osp")
    return "GATED|" + to_string(id) + "|" + gates
  }
  let _ = OSPTransition(id, "gated", "G2, G5 PASS", "osp")
  // W2 #625: ансамбль и гейты чисел — до публикации; отказ (G3/G6′)
  // оставляет карточку в gated с reason в событиях и gate_report
  let ens = OSPEnsemble(question)
  let apply = OSPEnsembleApply(id, ens, crowd_p, dissent)
  if starts_with(apply, "GATED|") then {
    let reason = to_string(get(split(apply, "|"), 2.0))
    let _ = db_execute("UPDATE osp_forecast SET gate_report = ? WHERE id = ?", [reason, to_string(id)])
    let _ = db_execute("INSERT INTO osp_forecast_events (forecast_id, from_status, to_status, reason, actor, created_at) VALUES (?, 'gated', 'REFUSED>published', ?, 'osp', datetime('now'))", [to_string(id), reason])
    return "GATED|" + to_string(id) + "|" + reason
  }
  let mut p_base = p_raw
  let mut marks = ""
  if starts_with(apply, "OK|") then {
    p_base = to_float(to_string(get(split(apply, "|"), 1.0)))
    marks = to_string(get(split(apply, "|"), 2.0))
  }
  if trim(dissent) != "" then {
    let _ = db_execute("UPDATE osp_forecast SET market_dissent_reason = ? WHERE id = ?", [substring(dissent, 0.0, 500.0), to_string(id)])
  }
  // W4 #627: цепочка итоговой вероятности — сжатие (если ADOPTED) → clip →
  // Platt (если ADOPTED); при выключенных — p_final = clip(p_ensemble) побитово
  let p_blend = OSPPriorApply(id, p_base)
  let pc = OSPClip(p_blend)
  let p = OSPPlattApply(pc)
  // W4 #627: методики как структуры — дерево не сходится (G7) — блок;
  // остальные — марки в gate_report; narratives — строки indicator
  let mg = OSPMethodsGate(methods_json, assumptions_json, src_json, depth, p, id, analysis_id)
  if starts_with(mg, "BLOCK|") then {
    let reason = substring(mg, 6.0, length(mg))
    let _ = db_execute("UPDATE osp_forecast SET gate_report = ? WHERE id = ?", [reason, to_string(id)])
    let _ = db_execute("INSERT INTO osp_forecast_events (forecast_id, from_status, to_status, reason, actor, created_at) VALUES (?, 'gated', 'REFUSED>published', ?, 'osp', datetime('now'))", [to_string(id), reason])
    return "GATED|" + to_string(id) + "|" + reason
  }
  if trim(assumptions_json) != "" and trim(assumptions_json) != "[]" {
    let _ = db_execute("UPDATE osp_forecast SET assumptions_json = ? WHERE id = ?", [substring(trim(assumptions_json), 0.0, 6000.0), to_string(id)])
  }
  let _ = db_execute("UPDATE osp_forecast SET p_final = ?, kent_label = ?, cal_bucket = ?, gate_report = ? WHERE id = ?", [to_string(p), OSPKentOf(p), to_string(OSPBucketOf(p)), "{\"g1\":\"PASS\",\"g2\":\"PASS\",\"g5\":\"PASS\"" + marks + to_string(get(split(mg, "|"), 1.0)) + "}", to_string(id)])
  let pub = OSPTransition(id, "published", "гейты пройдены, p_final=" + to_string(p), "osp")
  return "OK|" + to_string(id) + "|published|p_final=" + to_string(p)
}

// Тест-стенд самодостаточен: таблицы app.mlog с уже добавленными колонками
// (прод: CREATE в InitDB + ALTER в OSPFEnsureSchema; изолированный python-гвард
// гоняет файл без app.mlog — здесь таблицы создаются сразу полными)
pattern OSPFTestTables() -> String {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS analysis (id INTEGER PRIMARY KEY AUTOINCREMENT, topic TEXT, full_result TEXT, status TEXT DEFAULT 'drafted', verification_date TEXT, confidence TEXT, created_at TEXT DEFAULT (datetime('now')), mode TEXT, published_at TEXT, superseded_by_id TEXT, topic_slug TEXT, watch_until TEXT, osp_forecast_id INTEGER)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS research_source (id INTEGER PRIMARY KEY AUTOINCREMENT, analysis_id INTEGER, url TEXT, title TEXT, tier TEXT DEFAULT 'secondary', claim TEXT, created_at TEXT DEFAULT (datetime('now')), as_of TEXT)", [])
  return "ok"
}

// Числовой хвост ответу владельцу — ТОЛЬКО из строки БД (инвариант 8)
pattern OSPFCardLine(forecast_id: Float) -> String {
  let rows = query("SELECT id, status, p_final, kent_label, resolve_by FROM osp_forecast WHERE id = ?", [to_string(forecast_id)])
  if length(rows) == 0.0 then { return "" }
  let r = get(rows, 0.0)
  let st = to_string(json_get(r, "status", "?"))
  let pf = to_string(json_get(r, "p_final", ""))
  if pf == "" then { return "🎲 Карточка прогноза #" + to_string(forecast_id) + ": статус " + st + " — вероятность не опубликована (причина в gated-событиях)" }
  return "🎲 Карточка прогноза #" + to_string(forecast_id) + ": p=" + pf + " — " + to_string(json_get(r, "kent_label", "")) + ", проверка " + to_string(json_get(r, "resolve_by", "")) + ", статус " + st
}

// ═══════════════════════════════════════════════════════════════════════
// W2 #625: ЧИСЛА — ансамбль, агрегация, метрики, скоринг, бюджет
// ═══════════════════════════════════════════════════════════════════════

// Формат числа — 3 знака: to_string даёт -0.6399999999999999, в Telegram
// такое отправлять нельзя — проверено исполнением (§5.4)
pattern OSPFmt3(x: Float) -> String {
  let mut neg = ""
  let mut v = x
  if v < 0.0 then {
    neg = "-"
    v = 0.0 - v
  }
  let n = to_int(v * 1000.0 + 0.5)
  let ip = to_int(to_float(to_string(n)) / 1000.0)
  let frac = n - ip * 1000
  let mut fs = to_string(frac)
  if frac < 10 then { fs = "00" + to_string(frac) }
  if frac >= 10 and frac < 100 then { fs = "0" + to_string(frac) }
  return neg + to_string(ip) + "." + fs
}

// G1-схема прогона ансамбля: p, base_rate_hint, why (§4.2)
pattern OSPFRunSchema() -> String {
  return "{\"type\":\"object\",\"properties\":{\"p\":{\"type\":\"number\"},\"base_rate_hint\":{\"type\":\"string\"},\"why\":{\"type\":\"string\"}},\"required\":[\"p\"]}"
}

// PASS|<p> | FAIL|<причина> — не-JSON = провал прогона, а не 0.5 молча (§4.1)
// json_validate возвращает вердикт формы — само число берём parse_json-ом
pattern OSPParseRun(reply: String) -> String {
  let t = trim(reply)
  let r = try json_validate(OSPFRunSchema(), t)
  if to_string(r) == "()" then { return "FAIL|ответ не JSON по схеме прогона" }
  if r.ok == false then { return "FAIL|форма прогона: " + to_string(r.error.message) }
  let v = parse_json(t)
  let p = to_float(to_string(json_get(v, "p", "-999")))
  if p < 0.0 or p > 1.0 then { return "FAIL|p вне [0,1]: " + to_string(p) }
  return "PASS|" + to_string(p)
}

// Сортировка CSV-чисел по возрастанию — выбором минимума; прогонов ≤ 7
pattern OSPSortCsv(csv: String) -> String {
  let mut src = trim(csv)
  let mut out = ""
  let mut guard = 0.0
  while src != "" and guard < 10.0 {
    guard = guard + 1.0
    let parts = split(src, ";")
    let n = length(parts)
    let mut mi = 0.0
    let mut mv = to_float(to_string(get(parts, 0.0)))
    let mut i = 0.0
    while i < n {
      let v = to_float(to_string(get(parts, i)))
      if v < mv then {
        mv = v
        mi = i
      }
      i = i + 1.0
    }
    if out == "" then { out = to_string(mv) } else { out = out + ";" + to_string(mv) }
    let mut rest = ""
    let mut j = 0.0
    while j < n {
      if j != mi then {
        if rest == "" then { rest = to_string(get(parts, j)) } else { rest = rest + ";" + to_string(get(parts, j)) }
      }
      j = j + 1.0
    }
    src = rest
  }
  return out
}

// Агрегация: mean — основной; median и logit-pool сохраняются для честного
// сравнения агрегаторов (§2.1, пример 2); p_spread — population stdev.
// Вход — CSV валидных вероятностей; выход OK|<mean>|<median>|<logit>|<spread>|<n>
pattern OSPAggregate(csv: String) -> String {
  let t = trim(csv)
  if t == "" then { return "FAIL|нет валидных прогонов" }
  let parts = split(t, ";")
  let n = length(parts)
  let mut sum = 0.0
  let mut i = 0.0
  while i < n {
    sum = sum + to_float(to_string(get(parts, i)))
    i = i + 1.0
  }
  let mean = sum / n
  let sp = split(OSPSortCsv(t), ";")
  let midi = to_int(n / 2.0)
  let mut median = to_float(to_string(get(sp, to_float(to_string(midi)))))
  if n == 2.0 * to_float(to_string(midi)) then {
    median = (median + to_float(to_string(get(sp, to_float(to_string(midi - 1)))))) / 2.0
  }
  let mut lsum = 0.0
  let mut vsum = 0.0
  let mut k = 0.0
  while k < n {
    let p = to_float(to_string(get(parts, k)))
    let pc = OSPClip(p)
    lsum = lsum + ln(pc / (1.0 - pc))
    vsum = vsum + (p - mean) * (p - mean)
    k = k + 1.0
  }
  let spread = sqrt(vsum / n)
  let lp = sigmoid(lsum / n)
  return "OK|" + to_string(mean) + "|" + to_string(median) + "|" + to_string(lp) + "|" + to_string(spread) + "|" + to_string(n)
}

// Поправка 1: базовая частота — ВХОД прогона, не сжатие. Класс сравнения —
// домен вопроса, прокси «вопросы того же типа»; n<10 — не подаётся вовсе.
// MUT-мишень поправки 1 — проверка n<10. OSPBlendPrior не реализуется:
// механическое сжатие включается только в W4 по правилу Platt (§5.2)
pattern OSPBaseRate(question: String) -> String {
  let _ = OSPFEnsureSchema()
  let rows = query("SELECT n, base_rate FROM osp_base_rates WHERE topic = ?", [OSPClassifyDomain(question)])
  if length(rows) == 0.0 then { return "NONE" }
  let n = to_float(to_string(json_get(get(rows, 0.0), "n", "0")))
  if n < 10.0 then { return "NONE" }
  return "OK|" + to_string(to_float(to_string(json_get(get(rows, 0.0), "base_rate", "0")))) + "|" + to_string(n)
}

pattern OSPBaseRateBlock(question: String) -> String {
  let br = OSPBaseRate(question)
  if starts_with(br, "OK|") == false then { return "" }
  let pp = split(br, "|")
  return "\nБАЗОВАЯ ЧАСТОТА класса (n=" + to_string(get(pp, 2.0)) + "): " + to_string(get(pp, 1.0)) + " — вход для оценки, не приговор; механическое сжатие запрещено (поправка 1 владельца)."
}

// UTC-день для kv-ключа бюджета — strftime в SQLite (UTC по умолчанию)
pattern OSPDayUtc() -> String {
  let rows = query("SELECT strftime('%Y-%m-%d', 'now') AS d", [])
  return to_string(json_get(get(rows, 0.0), "d", ""))
}

// Оценка прогона 0.01 USD — верхняя граница оценки §10 «до +0.05 при полном
// ансамбле» из 5 прогонов; groq/cerebras фактически 0 USD (прайс офиса —
// proxy/providers.py MODEL_COSTS). Консервативная — бюджет не недооцениваем
pattern OSPRunCostEst() -> Float {
  return 0.01
}

// Лимит дневного бюджета — ЕДИНАЯ точка чтения (W3 #626: тот же ключ, что у
// прокси и бенчмарк-гейта): system_settings daily_budget_osp — 10.00 — решение
// владельца 03.11, подтверждено 05.11 (B.3 2.00 отменено; наряд #664) →
// kv daily_budget_osp → дефолт 10.0. Значение off/пусто в
// system_settings — enforcement снят (UNLIMITED в терминах §6.4)
pattern OSPLimitRead() -> String {
  let rows = query("SELECT value FROM system_settings WHERE key = 'daily_budget_osp'", [])
  if length(rows) > 0.0 then {
    let v = trim(to_string(json_get(get(rows, 0.0), "value", "")))
    if v == "off" or v == "" then { return "off" }
    return v
  }
  let kvv = kv_get("daily_budget_osp")
  if kvv != "" then { return kvv }
  return "10.0"
}

// Лимит из kv — легаси-путь W2, оставлен для тестов изолированного гварда
pattern OSPBudgetUsed() -> String {
  let v = kv_get("daily_budget_osp_used:" + OSPDayUtc())
  if v == "" then { return "0" }
  return v
}

pattern OSPBudgetCharge(usd: Float) -> String {
  let cur = to_float(OSPBudgetUsed())
  let nv = cur + usd
  let _ = kv_set("daily_budget_osp_used:" + OSPDayUtc(), to_string(nv))
  return to_string(nv)
}

// Реестр семейств ансамбля: проверенные пары из COMBO_CHAINS fosved-standard
// (proxy/providers.py:151-160), дешёвые первыми (§10). kv-override
// osp_ensemble_models — CSV моделей; значение off — рубильник ансамбля
// (тесты CI дают ноль LLM-вызовов). 400 «no such model» на чужих рунгах
// circuit breaker не открывает — проверено экспериментом с mock-провайдером
pattern OSPEnsembleModels() -> String {
  let ov = kv_get("osp_ensemble_models")
  if ov == "off" then { return "OFF" }
  if ov != "" then { return ov }
  return "openai/gpt-oss-20b;gpt-oss-120b;deepseek-chat;glm-4.6;kimi-k3"
}

// Один вопрос — до 5 независимых прогонов на разных семействах; прогон —
// компактный промпт со структурным ответом, заряд бюджета до каждого вызова.
// Выход: OFF| | EXCEEDED|<причина> | FAIL|<причина> |
//        OK|<n>|<mean>|<median>|<logit>|<spread>|<skipped>|<models_json>
pattern OSPEnsemble(question: String) -> String {
  let models = OSPEnsembleModels()
  if models == "OFF" then { return "OFF|" }
  if trim(question) == "" then { return "FAIL|пустой вопрос" }
  // Лимит — единый OSPLimitRead (system_settings daily_budget_osp → kv → 10.0;
  // off — enforcement снят владельцем). #626 W3 унифицировал с OSPBenchBudgetGate
  let lv = OSPLimitRead()
  let mut lim = 999999.0
  if lv != "off" then { lim = to_float(lv) }
  let used0 = to_float(OSPBudgetUsed())
  if lim - used0 < OSPRunCostEst() then {
    return "EXCEEDED|бюджет ансамбля на UTC-день исчерпан: " + to_string(used0) + " из " + to_string(lv) + " USD — оценка по одиночному прогону, пометка W2"
  }
  let base = OSPBaseRateBlock(question)
  let prompt = "Ты — независимый аналитик ансамбля прогнозов. Вопрос: " + trim(question) + "." + base + "\nДай ОДНУ строку строго валидного JSON без какого-либо текста до и после: {\"p\": <твоя вероятность числом 0.02-0.98>, \"base_rate_hint\": \"<как базовая частота повлияла; пусто, если не подавалась>\", \"why\": \"<один проверяемый аргумент: ряд, число, дата>\"}"
  let fams = split(models, ";")
  let mut runs = ""
  let mut mj = "{\"runs\":["
  let mut nval = 0.0
  let mut skipped = 0.0
  let mut first = true
  let mut used = used0
  each m in fams {
    let model = trim(to_string(m))
    if model != "" then {
      if used + OSPRunCostEst() > lim then {
        skipped = 1.0
      } else {
        let r = TryVal(try call_llm(prompt, question, model))
        // one-way redact до решений — выход call_llm недоверенный (№316),
        // идиома офиса как в deep/full; структура JSON переживает redact
        let rs = redact(to_string(r), "all")
        if first then { first = false } else { mj = mj + "," }
        if rs == "()" then {
          mj = mj + "{\"model\":\"" + model + "\",\"status\":\"FAIL\",\"cause\":\"провайдер не ответил\"}"
        } else {
          let pr = OSPParseRun(rs)
          if starts_with(pr, "PASS|") then {
            nval = nval + 1.0
            let pv = substring(pr, 5.0, length(pr))
            if runs == "" then { runs = pv } else { runs = runs + ";" + pv }
            mj = mj + "{\"model\":\"" + model + "\",\"status\":\"PASS\",\"p\":" + pv + "}"
          } else {
            mj = mj + "{\"model\":\"" + model + "\",\"status\":\"FAIL\"}"
          }
        }
        used = to_float(OSPBudgetCharge(OSPRunCostEst()))
      }
    }
  }
  mj = mj + "],\"n_valid\":" + to_string(nval) + "}"
  if nval == 0.0 then { return "FAIL|валидных прогонов нет " + mj }
  let agg = OSPAggregate(runs)
  if starts_with(agg, "FAIL|") then { return agg }
  let ap = split(agg, "|")
  return "OK|" + to_string(get(ap, 5.0)) + "|" + to_string(get(ap, 1.0)) + "|" + to_string(get(ap, 2.0)) + "|" + to_string(get(ap, 3.0)) + "|" + to_string(get(ap, 4.0)) + "|" + to_string(skipped) + "|" + mj
}

// Структурность обоснования расхождения с рынком: программа проверяет форму,
// не смысл — длина ≥ 20 и проверяемый след: цифра или URL
pattern OSPDissentOK(dissent: String) -> Bool {
  let d = trim(dissent)
  if length(d) < 20.0 then { return false }
  let mut i = 0.0
  while i < length(d) {
    let ch = substring(d, i, i + 1.0)
    if ch == "0" or ch == "1" or ch == "2" or ch == "3" or ch == "4" or ch == "5" or ch == "6" or ch == "7" or ch == "8" or ch == "9" then { return true }
    i = i + 1.0
  }
  if contains(d, "http") then { return true }
  return false
}

// Поправка 2: расхождение с рынком — предупреждение, не блокировка.
// d = |p − crowd_p|: ≤0.15 OK; ≤0.35 W3; >0.35 — W6 при обосновании,
// иначе G6BLOCK. crowd_p < 0 — линии нет, молчание (A.9)
pattern OSPCrowdCompare(p_final: Float, crowd_p: Float, dissent: String) -> String {
  if crowd_p < 0.0 then { return "SKIP|линии нет" }
  let mut d = p_final - crowd_p
  if d < 0.0 then { d = 0.0 - d }
  let ds = OSPFmt3(d)
  if d <= 0.15 then { return "OK" }
  if d <= 0.35 then { return "W3|" + ds }
  if OSPDissentOK(dissent) then { return "W6|" + ds }
  return "G6BLOCK|" + ds
}

// Применение результата ансамбля к карточке ДО публикации: поля ансамбля,
// G3 (разброс), рынок по поправке 2, W1/W2/W4-пометки. Отказ —
// GATED|<id>|<причина>, карточка остаётся в gated. MUT-мишени: порог G3
// 0.25, блок G6prime, обязательность market_dissent_reason.
// Выход: GATED|<id>|<причина> | OK|<p_base>|<фрагмент gate_report>
pattern OSPEnsembleApply(forecast_id: Float, ens: String, crowd_p: Float, dissent: String) -> String {
  let rows = query("SELECT question, p_raw, resolve_by, as_of FROM osp_forecast WHERE id = ?", [to_string(forecast_id)])
  if length(rows) == 0.0 then { return "GATED|" + to_string(forecast_id) + "|карточка не найдена для применения ансамбля" }
  let row = get(rows, 0.0)
  let question = to_string(json_get(row, "question", ""))
  let as_of = to_string(json_get(row, "as_of", ""))
  let resolve_by = to_string(json_get(row, "resolve_by", ""))
  let mut p_base = to_float(to_string(json_get(row, "p_raw", "0.5")))
  let mut marks = ""
  if starts_with(ens, "OK|") then {
    let pp = split(ens, "|")
    let nv = to_float(to_string(get(pp, 1.0)))
    let mean = to_float(to_string(get(pp, 2.0)))
    let median = to_float(to_string(get(pp, 3.0)))
    let lp = to_float(to_string(get(pp, 4.0)))
    let spread = to_float(to_string(get(pp, 5.0)))
    let skipped = to_string(get(pp, 6.0))
    let mj = to_string(get(pp, 7.0))
    let _ = db_execute("UPDATE osp_forecast SET p_ensemble = ?, p_median = ?, p_logit = ?, p_spread = ?, n_runs = ?, models_json = ? WHERE id = ?", [to_string(mean), to_string(median), to_string(lp), to_string(spread), to_string(nv), mj, to_string(forecast_id)])
    // #627 W4 A.5: писатель osp_forecast_method_runs — каждый валидный прогон
    // ансамбля → (forecast_id, method, p_i, family); GROUP BY — OSPMethodAB
    let mjo = try parse_json(mj)
    if to_string(mjo) != "()" {
      if mjo.ok == true {
      let runs = json_get(mjo.value, "runs", [])
      if to_string(runs) != "()" and length(runs) > 0.0 {
        each r in runs {
          let rstatus = to_string(json_get(r, "status", ""))
          if rstatus == "PASS" {
            let model = to_string(json_get(r, "model", ""))
            let rp = to_string(json_get(r, "p", ""))
            if model != "" and rp != "" and OSPStrIsNumber(rp) {
              let _ = db_execute("INSERT INTO osp_forecast_method_runs (forecast_id, method, p_i, family) VALUES (?, ?, ?, ?)", [to_string(forecast_id), substring(model, 0.0, 120.0), rp, OSPFamilyOf(model)])
            }
          }
        }
      }
      }
    }
    if nv >= 3.0 then {
      if spread > 0.25 then {
        return "GATED|" + to_string(forecast_id) + "|FAIL: G3 разброс ансамбля " + OSPFmt3(spread) + " больше 0.25 при " + to_string(nv) + " валидных прогонах — модели отвечают на разные вопросы"
      }
      marks = marks + ",\"g3\":\"PASS\""
      p_base = mean
    } else {
      let mut w2 = "W2: мета-уверенность низкая — валидных прогонов " + to_string(nv)
      if skipped == "1" or skipped == "1.0" then { w2 = w2 + "; состав сокращён по бюджету дня" }
      marks = marks + ",\"w2\":\"" + w2 + "\""
    }
  } else {
    if starts_with(ens, "EXCEEDED|") then {
      marks = marks + ",\"w2\":\"бюджет ансамбля на день исчерпан — оценка по одному прогону\""
    }
  }
  // G6-рынок (поправка 2): ≤0.15 тихо; 0.15–0.35 W3; >0.35 — W6 только
  // со структурным обоснованием, иначе G6prime блок
  if crowd_p >= 0.0 then {
    let cc = OSPCrowdCompare(p_base, crowd_p, dissent)
    if starts_with(cc, "G6BLOCK|") then {
      return "GATED|" + to_string(forecast_id) + "|FAIL: G6prime расхождение с рынком " + substring(cc, 8.0, length(cc)) + " больше 0.35 без market_dissent_reason — публикация блокирована (поправка 2 владельца)"
    }
    if starts_with(cc, "W6|") then {
      marks = marks + ",\"w6\":\"расхождение с рынком " + substring(cc, 3.0, length(cc)) + " — опубликовано с обоснованием\""
    }
    if starts_with(cc, "W3|") then {
      marks = marks + ",\"w3\":\"расхождение с рынком " + substring(cc, 3.0, length(cc)) + "\""
    }
  }
  // W1: отклонение от базовой частоты — |p − rate| > 0.3 при n ≥ 10;
  // prior_rate/prior_n пишутся на карточку (данные для будущего Platt, W4)
  let br = OSPBaseRate(question)
  if starts_with(br, "OK|") then {
    let bpp = split(br, "|")
    let rate = to_float(to_string(get(bpp, 1.0)))
    let bn = to_float(to_string(get(bpp, 2.0)))
    let _ = db_execute("UPDATE osp_forecast SET prior_rate = ?, prior_n = ? WHERE id = ?", [to_string(rate), to_string(bn), to_string(forecast_id)])
    let mut d = p_base - rate
    if d < 0.0 then { d = 0.0 - d }
    if d > 0.3 then {
      marks = marks + ",\"w1\":\"отклонение от базовой частоты " + OSPFmt3(d) + " больше 0.3\""
    }
  }
  // W4: короткий горизонт — resolve_by − as_of < 7 дней
  let days = (OSPFEpochOf(resolve_by) - OSPFEpochOf(as_of)) / 86400.0
  if days > 0.0 and days < 7.0 then {
    marks = marks + ",\"w4\":\"горизонт " + OSPFmt3(days) + " дн меньше 7\""
  }
  return "OK|" + to_string(p_base) + "|" + marks
}

// Brier = (p − y)² — программа, не модель (§5.1). MUT-мишень наряда:
// замена на abs ловится тестом «0.7 против да — 0.090»
pattern OSPBrier(p: Float, y: Float) -> Float {
  return (p - y) * (p - y)
}

// Log-loss, p клиппингован в [0.0001, 0.9999] (§5.1)
pattern OSPLogLoss(p: Float, y: Float) -> Float {
  let mut pc = p
  if pc < 0.0001 then { pc = 0.0001 }
  if pc > 0.9999 then { pc = 0.9999 }
  return 0.0 - (y * ln(pc) + (1.0 - y) * ln(1.0 - pc))
}

// Skill score = 1 − Brier/baseline; линии: 0.25, частота исходов, рынок.
// baseline > 0 ограждает вызывающий — пол и ограда в OSPScoreBlock (§5.1)
pattern OSPSkillScore(brier: Float, baseline: Float) -> Float {
  return 1.0 - brier / baseline
}

// Пол выборки — одна константа отдела (§5.1, стиль Narad 8: ComputeFinanceMAPE)
pattern OSPMinN() -> Float {
  return 10.0
}

// Парс исхода от владельца — программный, модель исход не судит (§9.7).
// да/yes/1/true/произошло → 1; нет/no/0/false → 0; дробь и проценты —
// дробный исход (обобщённый Brier §5.1). Иначе FAIL — не угадываем
pattern OSPParseOutcome(text: String) -> String {
  let t = lower(trim(text))
  if t == "да" or t == "yes" or t == "y" or t == "1" or t == "true" or t == "произошло" or t == "сбылось" then { return "OK|1.0" }
  if t == "нет" or t == "no" or t == "n" or t == "0" or t == "false" or t == "не произошло" or t == "не сбылось" then { return "OK|0.0" }
  let mut num = t
  if contains(num, "%") then {
    let pp = split(num, "%")
    num = trim(to_string(get(pp, 0.0)))
    let v = to_float(num)
    if v < 0.0 or v > 100.0 then { return "FAIL|проценты вне 0-100: " + text }
    return "OK|" + to_string(v / 100.0)
  }
  if OSPStrIsNumber(num) then {
    let v = to_float(num)
    if v < 0.0 or v > 1.0 then { return "FAIL|дробный исход вне 0-1: " + text }
    return "OK|" + to_string(v)
  }
  return "FAIL|исход не распознан: " + text
}

// Подтверждение исхода владельцем (§9.7): статус → resolved, Brier, строка
// brier_score_log, analysis_verifications с verified_by=owner. Сверка —
// только после resolve_by; p_final обязателен (инвариант 1: без него в
// Brier не попадаем). Инвариант 2: resolved ⇒ outcome+brier+verified_at
pattern OSPVerifyCard(forecast_id: Float, outcome_text: String, note: String) -> String {
  let _ = OSPFEnsureSchema()
  let rows = query("SELECT status, p_final, crowd_p, prior_rate, analysis_id, resolve_by FROM osp_forecast WHERE id = ?", [to_string(forecast_id)])
  if length(rows) == 0.0 then { return "NO|карточка не найдена" }
  let row = get(rows, 0.0)
  let st = to_string(json_get(row, "status", "?"))
  if st != "published" and st != "watching" then { return "NO|статус " + st + " — исход принимается только с published или watching" }
  if to_string(json_get(row, "p_final", "")) == "" then { return "NO|p_final отсутствует — карточка в Brier не участвует (инвариант 1)" }
  let rb = to_string(json_get(row, "resolve_by", ""))
  if now_unix() < OSPFEpochOf(rb) then { return "NO|горизонт не наступил: сверка после " + rb }
  let oy = OSPParseOutcome(outcome_text)
  if starts_with(oy, "FAIL|") then { return "NO|" + oy }
  let y = to_float(substring(oy, 3.0, length(oy)))
  let pf = to_float(to_string(json_get(row, "p_final", "0")))
  let b = OSPBrier(pf, y)
  let mut reason = "исход подтверждён владельцем: " + outcome_text
  if trim(note) != "" then { reason = reason + " — " + trim(note) }
  let tr = OSPTransition(forecast_id, "resolved", reason, "owner")
  if starts_with(tr, "NO|") then { return tr }
  let _ = db_execute("UPDATE osp_forecast SET outcome = ?, brier = ?, cal_bucket = ?, verified_at = datetime('now'), updated_at = datetime('now') WHERE id = ?", [to_string(y), to_string(b), to_string(OSPBucketOf(pf)), to_string(forecast_id)])
  let cp = to_float(to_string(json_get(row, "crowd_p", "-1")))
  if cp >= 0.0 then {
    let _ = db_execute("UPDATE osp_forecast SET brier_crowd = ? WHERE id = ?", [to_string(OSPBrier(cp, y)), to_string(forecast_id)])
  }
  let prs = to_string(json_get(row, "prior_rate", ""))
  if prs != "" then {
    let _ = db_execute("UPDATE osp_forecast SET brier_base = ? WHERE id = ?", [to_string(OSPBrier(to_float(prs), y)), to_string(forecast_id)])
  }
  // ряд кумулятивной динамики — у brier_score_log появился первый писатель
  let prev = query("SELECT COALESCE(SUM(brier_score), 0.0) AS s, COUNT(*) AS c FROM brier_score_log", [])
  let psum = to_float(to_string(json_get(get(prev, 0.0), "s", "0")))
  let pcnt = to_float(to_string(json_get(get(prev, 0.0), "c", "0")))
  let aid = to_float(to_string(json_get(row, "analysis_id", "-1")))
  // два статических INSERT вместо конкатенации — SQL_DYNAMIC не создаём
  if aid > 0.0 then {
    let _ = db_execute("INSERT INTO brier_score_log (analysis_id, forecast_probability, actual_outcome, brier_score, cumulative_brier, total_forecasts) VALUES (?, ?, ?, ?, ?, ?)", [to_string(aid), to_string(pf), to_string(y), to_string(b), to_string(psum + b), to_string(pcnt + 1.0)])
  } else {
    let _ = db_execute("INSERT INTO brier_score_log (analysis_id, forecast_probability, actual_outcome, brier_score, cumulative_brier, total_forecasts) VALUES (NULL, ?, ?, ?, ?, ?)", [to_string(pf), to_string(y), to_string(b), to_string(psum + b), to_string(pcnt + 1.0)])
  }
  if aid > 0.0 then {
    let _ = db_execute("INSERT INTO analysis_verifications (analysis_id, scenario_outcomes, brier_scores, brier_total, verified_by) VALUES (?, '[]', ?, ?, 'owner')", ["[\"" + to_string(y) + "\"]", to_string(b), to_string(aid)])
  }
  // try: AuditLog живёт в dept/utils — изолированный прогон dept-файла без
  // app.mlog его не знает; в проде (serve) резолвится глобально
  let _ = try AuditLog("osp_verify_card", "osp", "id=" + to_string(forecast_id) + " y=" + to_string(y) + " brier=" + OSPFmt3(b))
  return "OK|" + to_string(forecast_id) + "|brier=" + OSPFmt3(b)
}

// Программный блок точности (§5.4): числа ТОЛЬКО из БД; пол OSPMinN на
// каждой метрике; n<10 — честное «недостаточно данных (k/10)», не выдумка
pattern OSPScoreBlock(kind: String) -> String {
  let _ = OSPFEnsureSchema()
  let tot = query("SELECT COUNT(*) AS c FROM osp_forecast WHERE kind = ?", [kind])
  let total = to_float(to_string(json_get(get(tot, 0.0), "c", "0")))
  let res = query("SELECT COUNT(*) AS c, AVG(brier) AS ab, AVG(outcome) AS af FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final IS NOT NULL AND outcome IS NOT NULL", [kind])
  let n = to_float(to_string(json_get(get(res, 0.0), "c", "0")))
  let mut out = "📐 ОСП · точность (" + kind + ")\nПрогнозов всего: " + to_string(total) + " · разрешено: " + to_string(n)
  if n < OSPMinN() then {
    return out + "\nНедостаточно данных для метрик (" + to_string(n) + "/" + to_string(OSPMinN()) + ") — пол " + to_string(OSPMinN()) + ", выдуманных чисел нет"
  }
  let ab = to_float(to_string(json_get(get(res, 0.0), "ab", "0")))
  let f = to_float(to_string(json_get(get(res, 0.0), "af", "0")))
  out = out + "\nBrier: " + OSPFmt3(ab)
  out = out + "\nSkill vs «всегда 50%» (0.25): " + OSPFmt3(OSPSkillScore(ab, 0.25))
  let bl = f * (1.0 - f)
  if bl > 0.0 then {
    out = out + "\nSkill vs базовая частота исходов (" + OSPFmt3(f) + "): " + OSPFmt3(OSPSkillScore(ab, bl))
  }
  let cr = query("SELECT COUNT(*) AS c, AVG(brier_crowd) AS ac FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND brier_crowd IS NOT NULL", [kind])
  let nc = to_float(to_string(json_get(get(cr, 0.0), "c", "0")))
  if nc >= OSPMinN() then {
    let ac = to_float(to_string(json_get(get(cr, 0.0), "ac", "0")))
    out = out + "\nBrier толпы/рынка: " + OSPFmt3(ac) + " · skill vs толпа: " + OSPFmt3(OSPSkillScore(ab, ac))
  } else {
    out = out + "\nSkill vs толпа: недостаточно данных (" + to_string(nc) + "/" + to_string(OSPMinN()) + ")"
  }
  let hi = query("SELECT COUNT(*) AS c, AVG(outcome) AS h FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final >= 0.8 AND outcome IS NOT NULL", [kind])
  let nh = to_float(to_string(json_get(get(hi, 0.0), "c", "0")))
  if nh >= OSPMinN() then {
    let h = to_float(to_string(json_get(get(hi, 0.0), "h", "0")))
    out = out + "\nHit-rate при p ≥ 80%: " + OSPFmt3(h) + " · surprise index: " + OSPFmt3(1.0 - h)
  } else {
    out = out + "\nHit-rate при p ≥ 80%: недостаточно данных (" + to_string(nh) + "/" + to_string(OSPMinN()) + ")"
  }
  // #627 W4 §5.4: строка калибровки Platt — вердикт из system_settings
  let cal = query("SELECT value FROM system_settings WHERE key = 'osp_cal_note'", [])
  if length(cal) > 0.0 then {
    out = out + "\nКалибровка Platt: " + trim(to_string(json_get(get(cal, 0.0), "value", "")))
  } else {
    out = out + "\nКалибровка Platt: не запускалась (/osp recalibrate)"
  }
  return out
}

// Месячный обзор — писатель monthly_reviews через strftime (§5.4: прежний
// to_char падал молча). kind фильтрует контуры (инвариант 5). Идемпотентно:
// строка периода обновляется, соседние периоды не трогаются
pattern OSPMonthlyReview(period: String, kind: String) -> String {
  let _ = OSPFEnsureSchema()
  let p = trim(period)
  if length(p) != 7.0 then { return "NO|период не ГГГГ-ММ: " + period }
  let res = query("SELECT COUNT(*) AS c, AVG(brier) AS ab FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND outcome IS NOT NULL AND verified_at LIKE ? || '%'", [kind, p])
  let n = to_float(to_string(json_get(get(res, 0.0), "c", "0")))
  if n == 0.0 then { return "NO|" + p + ": разрешённых прогнозов нет — строка не пишется" }
  let ab = to_float(to_string(json_get(get(res, 0.0), "ab", "0")))
  let ex = query("SELECT id FROM monthly_reviews WHERE year_month = ?", [p])
  if length(ex) == 0.0 then {
    let _ = db_execute("INSERT INTO monthly_reviews (year_month, forecasts_verified, brier_average) VALUES (?, ?, ?)", [p, to_string(n), to_string(ab)])
  } else {
    let _ = db_execute("UPDATE monthly_reviews SET forecasts_verified = ?, brier_average = ? WHERE year_month = ?", [to_string(n), to_string(ab), p])
  }
  let pm = query("SELECT strftime('%Y-%m', ? || '-01', '-1 month') AS p", [p])
  let prevp = to_string(json_get(get(pm, 0.0), "p", ""))
  let pv = query("SELECT COUNT(*) AS c, AVG(brier) AS ab FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND outcome IS NOT NULL AND verified_at LIKE ? || '%'", [kind, prevp])
  let pn = to_float(to_string(json_get(get(pv, 0.0), "c", "0")))
  if pn >= OSPMinN() then {
    let pab = to_float(to_string(json_get(get(pv, 0.0), "ab", "0")))
    let _ = db_execute("UPDATE monthly_reviews SET brier_trend = ? WHERE year_month = ?", [to_string(ab - pab), p])
  }
  let hi = query("SELECT COUNT(*) AS c, AVG(outcome) AS h FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final >= 0.8 AND outcome IS NOT NULL AND verified_at LIKE ? || '%'", [kind, p])
  let nh = to_float(to_string(json_get(get(hi, 0.0), "c", "0")))
  if nh >= OSPMinN() then {
    let h = to_float(to_string(json_get(get(hi, 0.0), "h", "0")))
    let _ = db_execute("UPDATE monthly_reviews SET hit_rate_high_conf = ?, surprise_index = ? WHERE year_month = ?", [to_string(h), to_string(1.0 - h), p])
  }
  let _ = try AuditLog("osp_monthly_review", "osp", p + " n=" + to_string(n) + " brier=" + OSPFmt3(ab))
  return "OK|" + p + "|verified=" + to_string(n) + "|brier=" + OSPFmt3(ab)
}

// ═══════════════════════════════════════════════════════════════════════
// W4 #627: ОБУЧЕНИЕ И МЕТОДИКИ — Platt (§5.2), сжатие к базовой частоте
// (поправка 1 владельца: то же правило включения, что у Platt), калибровочная
// кривая (§5.4), методики как структуры (§7.2), A/B методологий (§7.4).
// Общий каркас: отложенная выборка — хвост архива ПО ВРЕМЕНИ (30 новейших
// разрешённых строк по verified_at), обучение — всё, что старше; «подсмотреть
// ответ» невозможно конструкцией. Данных нет — вердикт честно REJECTED
// (указание владельца по наряду #627: нехватка данных ≠ придуманные числа).
// ═══════════════════════════════════════════════════════════════════════

// Формат числа — 4 знака (порог выигрыша 0.005 на 3 знаках неразличим)
pattern OSPFmt4(x: Float) -> String {
  let mut neg = ""
  let mut v = x
  if v < 0.0 then {
    neg = "-"
    v = 0.0 - v
  }
  let n = to_int(v * 10000.0 + 0.5)
  let ip = to_int(to_float(to_string(n)) / 10000.0)
  let frac = n - ip * 10000
  let mut fs = to_string(frac)
  if frac < 10 then { fs = "000" + to_string(frac) }
  if frac >= 10 and frac < 100 then { fs = "00" + to_string(frac) }
  if frac >= 100 and frac < 1000 then { fs = "0" + to_string(frac) }
  return neg + to_string(ip) + "." + fs
}

// Логит с клипом [0.02, 0.98] (§5.3: клип до Platt — крайние вероятности
// дают непропорциональный log-loss на единственной ошибке)
pattern OSPCalLogit(p: Float) -> Float {
  let mut pc = p
  if pc < 0.02 then { pc = 0.02 }
  if pc > 0.98 then { pc = 0.98 }
  return ln(pc / (1.0 - pc))
}

// UPSERT настройки — INSERT при первом появлении ключа, UPDATE после
// (голый UPDATE при отсутствии строки пишет молча в никуда)
pattern OSPSettingUpsert(key: String, value: String) -> String {
  let _ = OSPFEnsureSchema()
  let ex = query("SELECT key FROM system_settings WHERE key = ?", [key])
  if length(ex) == 0.0 then {
    let _ = db_execute("INSERT INTO system_settings (key, value) VALUES (?, ?)", [key, value])
  } else {
    let _ = db_execute("UPDATE system_settings SET value = ? WHERE key = ?", [value, key])
  }
  return "ok"
}

// Platt-применение: p' = sigmoid(a·logit(p) + b) при ADOPTED; иначе вход
// ПОБИТОВО без изменений (инвариант наряда: при REJECTED p_final = clip(p))
pattern OSPPlattApply(p: Float) -> Float {
  let rows = query("SELECT value FROM system_settings WHERE key = 'osp_cal_note'", [])
  if length(rows) == 0.0 then { return p }
  let note = trim(to_string(json_get(get(rows, 0.0), "value", "")))
  if starts_with(note, "ADOPTED") == false then { return p }
  let ra = query("SELECT value FROM system_settings WHERE key = 'osp_cal_a'", [])
  let rb = query("SELECT value FROM system_settings WHERE key = 'osp_cal_b'", [])
  if length(ra) == 0.0 or length(rb) == 0.0 then { return p }
  let a = to_float(to_string(json_get(get(ra, 0.0), "value", "1")))
  let b = to_float(to_string(json_get(get(rb, 0.0), "value", "0")))
  return sigmoid(a * OSPCalLogit(p) + b)
}

// Platt-fit (§5.2). Отложка = 30 новейших разрешённых строк (verified_at DESC),
// обучение = старше. Строки с пометкой "unfit-config" (поправка 3: конфиг
// прогона отличается от боевого) в выборку НЕ идут. Обучение — градиентный
// спуск по log-loss (400 итераций, lr 0.05; только ln/exp/sigmoid registry).
// Правило включения единственное: ADOPTED при n_train≥60 AND n_hold≥30 AND
// Brier_hold(a,b) ≤ Brier_hold(1,0) − 0.005; иначе идентичность a=1,b=0.
// Вердикт и коэффициенты — system_settings osp_cal_a/osp_cal_b/osp_cal_note:
// «почему сегодня сжато/не сжато» видно запросом к БД (§5.2).
pattern OSPPlattFit(kind: String) -> String {
  let _ = OSPFEnsureSchema()
  // SQL — литералы (audit SQL_DYNAMIC): строки, непригодные для калибровки
  // owner (поправка 3, пометка unfit-config в gate_report), в выборку не идут
  let holdq = query("SELECT p_final, outcome FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final IS NOT NULL AND outcome IS NOT NULL AND gate_report NOT LIKE '%unfit-config%' ORDER BY verified_at DESC, id DESC LIMIT 30", [kind])
  let trainq = query("SELECT p_final, outcome FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final IS NOT NULL AND outcome IS NOT NULL AND id NOT IN (SELECT id FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final IS NOT NULL AND outcome IS NOT NULL AND gate_report NOT LIKE '%unfit-config%' ORDER BY verified_at DESC, id DESC LIMIT 30) AND gate_report NOT LIKE '%unfit-config%' ORDER BY verified_at ASC", [kind, kind])
  let nt = length(trainq)
  let nh = length(holdq)
  if nt < 60.0 or nh < 30.0 then {
    let note = "REJECTED gain=0.0000 holdout_n=" + to_string(nh) + " train_n=" + to_string(nt) + " недостаточно данных (нужно train≥60, hold≥30) — идентичность a=1 b=0"
    let _ = OSPSettingUpsert("osp_cal_note", note)
    let _ = OSPSettingUpsert("osp_cal_a", "1.0")
    let _ = OSPSettingUpsert("osp_cal_b", "0.0")
    let _ = try AuditLog("osp_platt_fit", "osp", kind + " REJECTED n=" + to_string(nt) + "/" + to_string(nh))
    return "OK|" + note
  }
  // GD по log-loss на обучении; данные в массиве — SQL внутри цикла нет
  let mut a = 1.0
  let mut b = 0.0
  let lr = 0.05
  let mut it = 0.0
  while it < 400.0 {
    let mut ga = 0.0
    let mut gb = 0.0
    let mut i = 0.0
    while i < nt {
      let row = get(trainq, i)
      let p = to_float(to_string(json_get(row, "p_final", "0.5")))
      let y = to_float(to_string(json_get(row, "outcome", "0")))
      let z = OSPCalLogit(p)
      let s = sigmoid(a * z + b)
      let err = s - y
      ga = ga + err * z
      gb = gb + err
      i = i + 1.0
    }
    a = a - lr * ga / nt
    b = b - lr * gb / nt
    it = it + 1.0
  }
  // Brier на отложке: обученный (a,b) против идентичности (1,0)
  let mut bab = 0.0
  let mut bid = 0.0
  let mut j = 0.0
  while j < nh {
    let row = get(holdq, j)
    let p = to_float(to_string(json_get(row, "p_final", "0.5")))
    let y = to_float(to_string(json_get(row, "outcome", "0")))
    let z = OSPCalLogit(p)
    let s = sigmoid(a * z + b)
    let d1 = s - y
    let d2 = p - y
    bab = bab + d1 * d1
    bid = bid + d2 * d2
    j = j + 1.0
  }
  bab = bab / nh
  bid = bid / nh
  let gain = bid - bab
  let mut verdict = "REJECTED"
  if gain >= 0.005 then { let verdict = "ADOPTED" }
  let note = verdict + " gain=" + OSPFmt4(gain) + " holdout_n=" + to_string(nh) + " train_n=" + to_string(nt)
  if verdict == "REJECTED" then {
    let note = note + " — идентичность a=1 b=0 (выигрыш меньше 0.005)"
    let _ = OSPSettingUpsert("osp_cal_a", "1.0")
    let _ = OSPSettingUpsert("osp_cal_b", "0.0")
  } else {
    let _ = OSPSettingUpsert("osp_cal_a", to_string(a))
    let _ = OSPSettingUpsert("osp_cal_b", to_string(b))
  }
  let _ = OSPSettingUpsert("osp_cal_note", note)
  let _ = try AuditLog("osp_platt_fit", "osp", kind + " " + substring(note, 0.0, 100.0))
  return "OK|" + note
}

// Вес базовой частоты (§9.3): w = n/(n+10)
pattern OSPPriorWeight(n: Float) -> Float {
  return n / (n + 10.0)
}

// Поправка 1: механическое сжатие к базовой частоте — ТО ЖЕ правило включения,
// что у Platt (§5.2). Сжатие p' = w·rate + (1−w)·p (w = OSPPriorWeight) по
// строкам, у которых есть prior_rate с prior_n ≥ 10; ADOPTED только при
// n_train≥60 AND n_hold≥30 AND выигрыш ≥0.005 Brier на отложке. Класс
// сравнения — вопросы того же типа (домен — OSPBaseRate), n<10 не входит.
pattern OSPPriorFit(kind: String) -> String {
  let _ = OSPFEnsureSchema()
  // SQL — литералы (audit SQL_DYNAMIC)
  let holdq = query("SELECT p_final, outcome, prior_rate, prior_n FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final IS NOT NULL AND outcome IS NOT NULL AND prior_rate IS NOT NULL AND prior_n IS NOT NULL AND prior_n >= 10 ORDER BY verified_at DESC, id DESC LIMIT 30", [kind])
  let trainq = query("SELECT p_final, outcome, prior_rate, prior_n FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final IS NOT NULL AND outcome IS NOT NULL AND prior_rate IS NOT NULL AND prior_n IS NOT NULL AND prior_n >= 10 AND id NOT IN (SELECT id FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND p_final IS NOT NULL AND outcome IS NOT NULL AND prior_rate IS NOT NULL AND prior_n IS NOT NULL AND prior_n >= 10 ORDER BY verified_at DESC, id DESC LIMIT 30) ORDER BY verified_at ASC", [kind, kind])
  let nt = length(trainq)
  let nh = length(holdq)
  if nt < 60.0 or nh < 30.0 then {
    let note = "REJECTED gain=0.0000 holdout_n=" + to_string(nh) + " train_n=" + to_string(nt) + " недостаточно данных (нужно train≥60, hold≥30) — сжатие выключено (поправка 1)"
    let _ = OSPSettingUpsert("osp_prior_note", note)
    let _ = try AuditLog("osp_prior_fit", "osp", kind + " REJECTED n=" + to_string(nt) + "/" + to_string(nh))
    return "OK|" + note
  }
  let mut bab = 0.0
  let mut bid = 0.0
  let mut j = 0.0
  while j < nh {
    let row = get(holdq, j)
    let p = to_float(to_string(json_get(row, "p_final", "0.5")))
    let y = to_float(to_string(json_get(row, "outcome", "0")))
    let rate = to_float(to_string(json_get(row, "prior_rate", "0.5")))
    let pn = to_float(to_string(json_get(row, "prior_n", "10")))
    let w = OSPPriorWeight(pn)
    let d1 = (w * rate + (1.0 - w) * p) - y
    let d2 = p - y
    bab = bab + d1 * d1
    bid = bid + d2 * d2
    j = j + 1.0
  }
  bab = bab / nh
  bid = bid / nh
  let gain = bid - bab
  let mut verdict = "REJECTED"
  if gain >= 0.005 then { let verdict = "ADOPTED" }
  let note = verdict + " gain=" + OSPFmt4(gain) + " holdout_n=" + to_string(nh) + " train_n=" + to_string(nt)
  if verdict == "REJECTED" then {
    let note = note + " — сжатие выключено (поправка 1: выигрыш меньше 0.005)"
  }
  let _ = OSPSettingUpsert("osp_prior_note", note)
  let _ = try AuditLog("osp_prior_fit", "osp", kind + " " + substring(note, 0.0, 100.0))
  return "OK|" + note
}

// Применение сжатия к карточке: только при osp_prior_note ADOPTED и наличии
// на карточке prior_rate с prior_n ≥ 10; иначе вход побитово
pattern OSPPriorApply(forecast_id: Float, p: Float) -> Float {
  let rows = query("SELECT value FROM system_settings WHERE key = 'osp_prior_note'", [])
  if length(rows) == 0.0 then { return p }
  let note = trim(to_string(json_get(get(rows, 0.0), "value", "")))
  if starts_with(note, "ADOPTED") == false then { return p }
  let fc = query("SELECT prior_rate, prior_n FROM osp_forecast WHERE id = ?", [to_string(forecast_id)])
  if length(fc) == 0.0 then { return p }
  let pr = to_string(json_get(get(fc, 0.0), "prior_rate", ""))
  let pn = to_float(to_string(json_get(get(fc, 0.0), "prior_n", "0")))
  if pr == "" or pn < 10.0 then { return p }
  let rate = to_float(pr)
  let w = OSPPriorWeight(pn)
  return w * rate + (1.0 - w) * p
}

// Калибровочная кривая (§5.1/§5.4): GROUP BY cal_bucket → {bucket, n, mean_p,
// mean_y}; пол — ≥3 бакета с n≥5. JSON — monthly_reviews.calibration_curve;
// при svg_path непустом — chart_line + write_file (картинка к ответу владельцу).
// Числа mean_y — по разрешённым исходам периода (verified_at LIKE период%).
pattern OSPCalibrationCurve(kind: String, period: String, svg_path: String) -> String {
  let _ = OSPFEnsureSchema()
  let p = trim(period)
  if length(p) != 7.0 then { return "NO|период не ГГГГ-ММ: " + period }
  let rows = query("SELECT cal_bucket AS b, COUNT(*) AS n, AVG(p_final) AS mp, AVG(outcome) AS my FROM osp_forecast WHERE kind = ? AND status = 'resolved' AND outcome IS NOT NULL AND p_final IS NOT NULL AND verified_at LIKE ? || '%' GROUP BY cal_bucket ORDER BY b", [kind, p])
  // годные бакеты — с n ≥ 5 (§5.1)
  let mut ok_n = 0.0
  let mut tot = 0.0
  let mut items = "["
  let mut labels = "["
  let mut first = true
  let mut i = 0.0
  while i < length(rows) {
    let r = get(rows, i)
    let bn = to_float(to_string(json_get(r, "n", "0")))
    tot = tot + bn
    if bn >= 5.0 then {
      ok_n = ok_n + 1.0
      let bucket = to_float(to_string(json_get(r, "b", "0")))
      let mp = to_float(to_string(json_get(r, "mp", "0")))
      let my = to_float(to_string(json_get(r, "my", "0")))
      let mut lab = "бакет"
      if bucket >= 1.0 and bucket <= 10.0 then {
        let lo = (bucket - 1.0) * 10.0
        let hi = bucket * 10.0
        lab = to_string(to_int(lo)) + "-" + to_string(to_int(hi)) + "%"
      }
      if first then { first = false } else {
        items = items + ","
        labels = labels + ","
      }
      items = items + "{\"label\":\"" + lab + "\",\"n\":" + to_string(bn) + ",\"mean_p\":" + OSPFmt4(mp) + ",\"mean_y\":" + OSPFmt4(my) + "}"
      labels = labels + "{\"label\":\"" + lab + "\",\"value\":" + OSPFmt4(my) + "}"
    }
    i = i + 1.0
  }
  items = items + "]"
  labels = labels + "]"
  if ok_n < 3.0 then {
    return "NO|недостаточно данных для кривой (бакетов с n≥5: " + to_string(ok_n) + "/3, всего разрешено " + to_string(tot) + ")"
  }
  let ex = query("SELECT id FROM monthly_reviews WHERE year_month = ?", [p])
  if length(ex) == 0.0 then {
    let _ = db_execute("INSERT INTO monthly_reviews (year_month, calibration_curve) VALUES (?, ?)", [p, items])
  } else {
    let _ = db_execute("UPDATE monthly_reviews SET calibration_curve = ? WHERE year_month = ?", [items, p])
  }
  let mut svg = ""
  if trim(svg_path) != "" then {
    // chart_line требует List<Struct{label,value}> (проверено §5.4); стиль —
    // Monolith F тёмная тема (как в dept/visual.mlog MonolithPaint)
    let style = diagram_style({paper: "#1A1D22", ink: "#ebeaec", accent: "#FFA733", muted: "#9AA0A8", rule: "#3A3F46"})
    let svg_res = TryVal(try chart_line(parse_json(labels), style))
    if to_string(svg_res) != "()" then {
      let w = TryVal(try write_file(trim(svg_path), redact(to_string(svg_res), "all")))
      if to_string(w) != "()" then { svg = trim(svg_path) }
    }
  }
  let _ = try AuditLog("osp_calibration_curve", "osp", kind + " " + p + " buckets=" + to_string(ok_n))
  return "OK|" + p + "|бакетов=" + to_string(ok_n) + "|строк=" + to_string(tot) + "|svg=" + svg
}

// ═══════════════════════════════════════════════════════════════════════
// W4 #627 A.4 — МЕТОДИКИ КАК СТРУКТУРЫ (§7.2). Принцип §7.1: результат
// методики — число или структура → проверяется программой; ход мысли →
// скилл-промпт; что можно посчитать — код, модель не считает. Все семь
// методик живут в methods_json/assumptions_json карточки — новых таблиц
// не требуется. Не заявлена методика → SKIP (проверка не выдумывает
// претензий); заявлена криво → W-марка; дерево, не сходящееся с ответом
// (расхождение > 0.15) → G-гейт — единственная методичная блокировка.
// ═══════════════════════════════════════════════════════════════════════

// 1. Key Assumptions Check: ≥3 допущения; у каждого evidence_url или метка
// [СПЕКУЛЯЦИЯ]; confidence — число, а не слово. Данные — assumptions_json:
// [{text, confidence, evidence_url, if_wrong}]
pattern OSPAssumptionsGate(assumptions_json: String) -> String {
  let t = trim(assumptions_json)
  if t == "" or t == "[]" or t == "()" then { return "SKIP|не заявлено" }
  let d = try parse_json(t)
  if to_string(d) == "()" then { return "W: допущения не JSON" }
  if d.ok == false then { return "W: допущения не JSON" }
  // корневой массив — само значение разбора (не по ключу)
  let arr = d.value
  let n = length(arr)
  if n == 0.0 then { return "SKIP|не заявлено" }
  if n < 3.0 then { return "W: допущений " + to_string(n) + ", методика требует ≥3" }
  let mut bad_url = 0.0
  let mut bad_conf = 0.0
  let mut i = 0.0
  while i < n {
    let a = get(arr, i)
    let text = to_string(json_get(a, "text", ""))
    let conf = to_string(json_get(a, "confidence", ""))
    let url = to_string(json_get(a, "evidence_url", ""))
    if text != "" {
      // [СПЕКУЛАЦИЯ] — метка честной спекуляции; lower() в mlog не понижает
      // кириллицу — проверяем оба написания
      if url == "" and contains(text, "[СПЕКУЛАЦИЯ]") == false and contains(lower(text), "[спекуляция]") == false then { bad_url = bad_url + 1.0 }
      if conf != "" and OSPStrIsNumber(conf) == false then { bad_conf = bad_conf + 1.0 }
    }
    i = i + 1.0
  }
  if bad_url > 0.0 or bad_conf > 0.0 then {
    return "W: допущения неструктурны (без evidence_url/[СПЕКУЛЯЦИЯ]: " + to_string(bad_url) + "; confidence не число: " + to_string(bad_conf) + ")"
  }
  return "PASS|допущений=" + to_string(n)
}

// 2. Deception Detection: W-гейт — единственный источник с tier='primary' и
// заинтересованный автор {interested:true} → предупреждение, не блокировка.
// Строки-URL (текущий формат sources_json) данных о tier не несут — молчание.
pattern OSPDeceptionGate(src_json: String) -> String {
  let t = trim(src_json)
  if t == "" or t == "[]" or t == "()" then { return "" }
  let d = try parse_json(t)
  if to_string(d) == "()" then { return "" }
  if d.ok == false then { return "" }
  let arr = d.value
  if length(arr) != 1.0 then { return "" }
  let s = get(arr, 0.0)
  let tier = to_string(json_get(s, "tier", ""))
  let interested = to_string(json_get(s, "interested", "false"))
  if tier == "primary" and interested == "true" then {
    return "W: единственный источник primary и заинтересованная сторона — риск обмана (§7.2)"
  }
  return ""
}

// 3. Центр тяжести по Стрейнджу: cg_chain = {cg, cc, cr, cv} — все 4 элемента
// непустые, иначе «заявлено, но не построено» (частота → skill_reviews)
pattern OSPCGGate(methods_json: String) -> String {
  let t = trim(methods_json)
  if t == "" or t == "[]" or t == "{}" or t == "()" then { return "" }
  let d = try parse_json(t)
  if to_string(d) == "()" then { return "" }
  if d.ok == false then { return "" }
  let cg = json_get(d.value, "cg_chain", "")
  if to_string(cg) == "{}" or to_string(cg) == "()" or to_string(cg) == "" then { return "" }
  let mut empty = ""
  each k in ["cg", "cc", "cr", "cv"] {
    if length(trim(to_string(json_get(cg, to_string(k), "")))) == 0.0 then {
      if empty == "" then { empty = to_string(k) } else { empty = empty + "," + to_string(k) }
    }
  }
  if empty != "" then { return "W: центр тяжести заявлен, но не построен (пустые: " + empty + ")" }
  return "PASS|CG→CC→CR→CV построена"
}

// 4. PMESII-PT: frame = {P,M,E,S,I,IT,PH,T} — при depth≥2 заполнено ≥6 из 8
pattern OSPMesiiGate(methods_json: String, depth: Int) -> String {
  if depth < 2 then { return "" }
  let t = trim(methods_json)
  if t == "" or t == "[]" or t == "{}" or t == "()" then { return "" }
  let d = try parse_json(t)
  if to_string(d) == "()" then { return "" }
  if d.ok == false then { return "" }
  let fr = json_get(d.value, "frame", "")
  if to_string(fr) == "{}" or to_string(fr) == "()" or to_string(fr) == "" then { return "" }
  let mut filled = 0.0
  each k in ["P", "M", "E", "S", "I", "IT", "PH", "T"] {
    if length(trim(to_string(json_get(fr, to_string(k), "")))) > 0.0 then { filled = filled + 1.0 }
  }
  if filled < 6.0 then { return "W: PMESII-PT заявлен, заполнено " + to_string(filled) + "/8 (нужно ≥6 при depth≥2)" }
  return "PASS|PMESII-PT " + to_string(filled) + "/8"
}

// 5. Cross-Impact: matrix = [{a, b, sign, weight}] — программа ловит
// противоречия (A→B + при B→A − без пометки feedback); из methods.forces
// {A,R,S,L,E,E_mod} потенциал P = A×R×S×L×E×E_mod считается программой
// (OSPComputePotential), а не прозой
pattern OSPMatrixGate(methods_json: String) -> String {
  let t = trim(methods_json)
  if t == "" or t == "[]" or t == "{}" or t == "()" then { return "" }
  let d = try parse_json(t)
  if to_string(d) == "()" then { return "" }
  if d.ok == false then { return "" }
  let mut out = ""
  let mx = json_get(d.value, "matrix", [])
  if to_string(mx) != "()" and to_string(mx) != "[]" and length(mx) > 0.0 {
    let n = length(mx)
    let mut i = 0.0
    while i < n {
      let x = get(mx, i)
      let xa = to_string(json_get(x, "a", ""))
      let xb = to_string(json_get(x, "b", ""))
      let sx = to_string(json_get(x, "sign", ""))
      let fx = to_string(json_get(x, "feedback", "false"))
      let mut j = 0.0
      while j < n {
        let y = get(mx, j)
        let ya = to_string(json_get(y, "a", ""))
        let yb = to_string(json_get(y, "b", ""))
        let sy = to_string(json_get(y, "sign", ""))
        let fy = to_string(json_get(y, "feedback", "false"))
        if ya == xb and yb == xa and fx == "false" and fy == "false" {
          let mut opp = false
          if (sx == "+" and sy == "-") or (sx == "-" and sy == "+") { let opp = true }
          if (sx == "+" and sy == "−") or (sx == "−" and sy == "+") { let opp = true }
          if opp then {
            if contains(out, xa + "↔" + xb) == false and contains(out, xb + "↔" + xa) == false {
              if out == "" then { out = "W: противоречие матрицы без feedback: " + xa + "↔" + xb } else { out = out + "; " + xa + "↔" + xb }
            }
          }
        }
        j = j + 1.0
      }
      i = i + 1.0
    }
  }
  let f = json_get(d.value, "forces", "")
  if to_string(f) != "()" and to_string(f) != "{}" and to_string(f) != "" {
    let fa = to_string(json_get(f, "A", ""))
    let fr2 = to_string(json_get(f, "R", ""))
    let fs = to_string(json_get(f, "S", ""))
    let fl = to_string(json_get(f, "L", ""))
    let fe = to_string(json_get(f, "E", ""))
    let fem = to_string(json_get(f, "E_mod", "1.0"))
    if OSPStrIsNumber(fa) and OSPStrIsNumber(fr2) and OSPStrIsNumber(fs) and OSPStrIsNumber(fl) and OSPStrIsNumber(fe) and OSPStrIsNumber(fem) then {
      let pot = OSPComputePotential(to_float(fa), to_float(fr2), to_float(fs), to_float(fl), to_float(fe), to_float(fem))
      out = out + "|потенциал P=" + OSPFmt4(pot) + " (программа из матрицы сил)"
    }
  }
  if out == "" then { return "" }
  return out
}

// 6. Условные деревья (FRI): tree = [{node, parent, question, p_cond, event}]
// — программа перемножает p_cond вдоль ветвей, проверяет сумму терминальных
// ≤ 1 и сверяет Σ ветвей с event=true против p_final; расхождение > 0.15 →
// G-гейт «дерево не сходится с ответом»
pattern OSPTreeGate(methods_json: String, p_final: Float) -> String {
  let t = trim(methods_json)
  if t == "" or t == "[]" or t == "{}" or t == "()" then { return "SKIP" }
  let d = try parse_json(t)
  if to_string(d) == "()" then { return "SKIP" }
  if d.ok == false then { return "SKIP" }
  let tr = json_get(d.value, "tree", [])
  if to_string(tr) == "()" or to_string(tr) == "[]" then { return "SKIP" }
  let n = length(tr)
  if n == 0.0 then { return "SKIP" }
  // произведения вдоль цепочек родителей
  let mut prods = "["
  let mut i = 0.0
  while i < n {
    let node = get(tr, i)
    let pc = to_float(to_string(json_get(node, "p_cond", "1.0")))
    let mut prod = pc
    let mut parent = to_string(json_get(node, "parent", ""))
    let mut guard = 0.0
    while parent != "" and guard < 20.0 {
      guard = guard + 1.0
      let mut found = false
      let mut k = 0.0
      while k < n {
        let cand = get(tr, k)
        if to_string(json_get(cand, "node", "")) == parent {
          prod = prod * to_float(to_string(json_get(cand, "p_cond", "1.0")))
          parent = to_string(json_get(cand, "parent", ""))
          found = true
        }
        k = k + 1.0
      }
      if found == false then { parent = "" }
    }
    if i > 0.0 { prods = prods + "," }
    prods = prods + to_string(prod)
    i = i + 1.0
  }
  prods = prods + "]"
  let pv = try parse_json(prods)
  if to_string(pv) == "()" then { return "SKIP" }
  if pv.ok == false then { return "SKIP" }
  // терминалы — узлы, на которые никто не ссылается как parent
  let mut sum_term = 0.0
  let mut sum_event = 0.0
  let mut has_event = false
  let mut i2 = 0.0
  while i2 < n {
    let node = get(tr, i2)
    let name = to_string(json_get(node, "node", ""))
    let mut is_parent = false
    let mut k2 = 0.0
    while k2 < n {
      if to_string(json_get(get(tr, k2), "parent", "")) == name { is_parent = true }
      k2 = k2 + 1.0
    }
    if is_parent == false {
      let pr = to_float(to_string(get(pv.value, i2)))
      sum_term = sum_term + pr
      let ev = to_string(json_get(node, "event", ""))
      if ev != "" {
        has_event = true
        if ev == "true" or ev == "1" or ev == "yes" or ev == "да" then { sum_event = sum_event + pr }
      }
    }
    i2 = i2 + 1.0
  }
  if sum_term > 1.02 then { return "FAIL|сумма терминальных ветвей " + OSPFmt4(sum_term) + " > 1" }
  if has_event then {
    let diff = sum_event - p_final
    if diff < 0.0 then { let diff = 0.0 - diff }
    if diff > 0.15 then {
      return "FAIL|дерево не сходится с ответом: сумма ветвей event=true " + OSPFmt4(sum_event) + " против p_final " + OSPFmt4(p_final) + " (расхождение " + OSPFmt4(diff) + " > 0.15)"
    }
    return "PASS|дерево сходится: Σ(event)=" + OSPFmt4(sum_event) + " vs p_final=" + OSPFmt4(p_final)
  }
  return "W: у дерева нет event-разметки — сверка с p_final невозможна"
}

// 7. Contrasting Narratives / Red Hat: ровно 2 нарратива; у каждого ≥2
// индикатора с датой → индикаторы становятся строками indicator с verify_date
// и confirms_what (первый писатель таблицы — §7.2)
pattern OSPNarrativesGate(methods_json: String, forecast_id: Float, analysis_id: Float) -> String {
  let t = trim(methods_json)
  if t == "" or t == "[]" or t == "{}" or t == "()" then { return "SKIP" }
  let d = try parse_json(t)
  if to_string(d) == "()" then { return "SKIP" }
  if d.ok == false then { return "SKIP" }
  let ns = json_get(d.value, "narratives", [])
  if to_string(ns) == "()" or to_string(ns) == "[]" then { return "SKIP" }
  let n = length(ns)
  if n != 2.0 then { return "W: нарративов " + to_string(n) + ", методика требует ровно 2" }
  let mut wrote = 0.0
  let mut bad = 0.0
  let mut i = 0.0
  while i < n {
    let nr = get(ns, i)
    let inds = json_get(nr, "if_true_indicators", [])
    if to_string(inds) == "()" or to_string(inds) == "[]" then {
      bad = bad + 1.0
    } else {
      if length(inds) < 2.0 then {
        bad = bad + 1.0
      } else {
        let mut k = 0.0
        while k < length(inds) {
          let ind = get(inds, k)
          let desc = to_string(json_get(ind, "indicator", ""))
          let vd = trim(to_string(json_get(ind, "verify_date", "")))
          let cw = to_string(json_get(ind, "confirms_what", ""))
          if desc != "" and vd != "" then {
            // try: таблица indicator живёт в app.mlog (InitDB) — изолированный
            // python-гвард dept-файла её не создаёт; в проде строка пишется
            let _ = try db_execute("INSERT INTO indicator (analysis_id, description, verify_date, confirms_what, osp_forecast_id) VALUES (?, ?, ?, ?, ?)", [to_string(analysis_id), substring(desc, 0.0, 300.0), substring(vd, 0.0, 10.0), substring(cw, 0.0, 200.0), to_string(forecast_id)])
            wrote = wrote + 1.0
          } else {
            bad = bad + 1.0
          }
          k = k + 1.0
        }
      }
    }
    i = i + 1.0
  }
  if wrote > 0.0 then { return "OK|индикаторов записано=" + to_string(wrote) }
  if bad > 0.0 then { return "W: у нарративов нет ≥2 индикаторов с датой" }
  return "W: нарративы без индикаторов"
}

// Сводный структурный гейт методик: собирает марки всех семи проверок.
// Возврат: PASS|<фрагмент gate_report> | BLOCK|<причина> (только дерево)
pattern OSPMethodsGate(methods_json: String, assumptions_json: String, src_json: String, depth: Int, p_final: Float, forecast_id: Float, analysis_id: Float) -> String {
  let mut frag = ""
  let mut block = ""
  let ag = OSPAssumptionsGate(assumptions_json)
  if starts_with(ag, "PASS|") then { frag = frag + ",\"assumptions\":\"" + substring(ag, 5.0, length(ag)) + "\"" }
  if starts_with(ag, "W:") then { frag = frag + ",\"assumptions\":\"" + substring(ag, 3.0, length(ag)) + "\"" }
  let dg = OSPDeceptionGate(src_json)
  if dg != "" then { frag = frag + ",\"deception\":\"" + substring(dg, 3.0, length(dg)) + "\"" }
  let cg = OSPCGGate(methods_json)
  if starts_with(cg, "PASS|") then { frag = frag + ",\"cg\":\"" + substring(cg, 5.0, length(cg)) + "\"" }
  if starts_with(cg, "W:") then { frag = frag + ",\"cg\":\"" + substring(cg, 3.0, length(cg)) + "\"" }
  let ms = OSPMesiiGate(methods_json, depth)
  if starts_with(ms, "PASS|") then { frag = frag + ",\"pmesii\":\"" + substring(ms, 5.0, length(ms)) + "\"" }
  if starts_with(ms, "W:") then { frag = frag + ",\"pmesii\":\"" + substring(ms, 3.0, length(ms)) + "\"" }
  let mg = OSPMatrixGate(methods_json)
  if mg != "" then {
    // потенциал — после первой «|»; противоречия — до неё
    let parts = split(mg, "|")
    if length(parts) > 1.0 {
      frag = frag + ",\"matrix\":\"" + trim(to_string(get(parts, 0.0))) + "\",\"potential\":\"" + trim(to_string(get(parts, 1.0))) + "\""
    } else {
      frag = frag + ",\"matrix\":\"" + trim(mg) + "\""
    }
  }
  let tg = OSPTreeGate(methods_json, p_final)
  if starts_with(tg, "FAIL|") then { block = "G7 дерево: " + substring(tg, 5.0, length(tg)) }
  if starts_with(tg, "PASS|") then { frag = frag + ",\"tree\":\"" + substring(tg, 5.0, length(tg)) + "\"" }
  if starts_with(tg, "W:") then { frag = frag + ",\"tree\":\"" + substring(tg, 3.0, length(tg)) + "\"" }
  let ng = OSPNarrativesGate(methods_json, forecast_id, analysis_id)
  if starts_with(ng, "OK|") then { frag = frag + ",\"narratives\":\"" + substring(ng, 3.0, length(ng)) + "\"" }
  if starts_with(ng, "W:") then { frag = frag + ",\"narratives\":\"" + substring(ng, 3.0, length(ng)) + "\"" }
  if block != "" then { return "BLOCK|" + block }
  return "PASS|" + frag
}

// ═══════════════════════════════════════════════════════════════════════
// W4 #627 A.5 — A/B МЕТОДОЛОГИЙ (§7.4). Плоская таблица
// osp_forecast_method_runs(forecast_id, method, p_i, family); писатель —
// OSPEnsembleApply/OSPBenchForecastRow (каждый прогон ансамбля). После
// разрешения исхода карточки — GROUP BY method с полом n≥10 → строки доски
// + skill_reviews.success_rate. Ниже пола — «недостаточно данных», число не
// публикуется (§5.1). Пункт приёмки «у ≥3 методик n≥10» — отложен владельцем:
// механизм копит данные, приёмка — по факту набора.
// ═══════════════════════════════════════════════════════════════════════

// Семейство модели: до "/" ("openai/gpt-oss-20b" → openai), иначе до "-"
// ("deepseek-chat" → deepseek, "glm-4.6" → glm, "kimi-k3" → kimi)
pattern OSPFamilyOf(model: String) -> String {
  let m = trim(model)
  let parts = split(m, "/")
  if length(parts) >= 2.0 then { return to_string(get(parts, 0.0)) }
  let pp = split(m, "-")
  return to_string(get(pp, 0.0))
}

// Доска A/B: GROUP BY method по разрешённым карточкам; n≥10 → Brier и skill
// vs «всегда 50%» + запись в skill_reviews (dept_name='osp'); n<10 — честно
pattern OSPMethodAB(kind: String) -> String {
  let _ = OSPFEnsureSchema()
  let rows = query("SELECT mr.method AS method, COUNT(*) AS n, AVG((mr.p_i - f.outcome) * (mr.p_i - f.outcome)) AS ab FROM osp_forecast_method_runs mr JOIN osp_forecast f ON f.id = mr.forecast_id WHERE f.kind = ? AND f.status = 'resolved' AND f.outcome IS NOT NULL GROUP BY mr.method ORDER BY ab", [kind])
  if length(rows) == 0.0 then { return "A/B методологий (" + kind + "): прогонов нет — доска появится после разрешения карточек с прогонами" }
  let mut out = "A/B методологий (" + kind + "):\n"
  let mut i = 0.0
  while i < length(rows) {
    let r = get(rows, i)
    let method = to_string(json_get(r, "method", "?"))
    let n = to_float(to_string(json_get(r, "n", "0")))
    if n >= OSPMinN() then {
      let ab = to_float(to_string(json_get(r, "ab", "0")))
      out = out + "· " + method + ": n=" + to_string(n) + ", Brier=" + OSPFmt3(ab) + ", skill vs 0.25=" + OSPFmt3(OSPSkillScore(ab, 0.25)) + "\n"
      // skill_reviews — таблица app.mlog:452; try для изолированного гварда
      let ex = try query("SELECT id FROM skill_reviews WHERE skill_name = ? AND dept_name = 'osp'", [method])
      if to_string(ex) != "()" {
        if ex.ok == true {
          if length(ex.value) > 0.0 then {
            let _ = try db_execute("UPDATE skill_reviews SET usage_count = ?, success_rate = ?, last_reviewed_at = datetime('now'), updated_at = datetime('now') WHERE skill_name = ? AND dept_name = 'osp'", [to_string(n), to_string(OSPSkillScore(ab, 0.25)), method])
          } else {
            let _ = try db_execute("INSERT INTO skill_reviews (skill_name, dept_name, usage_count, success_rate, last_reviewed_at, updated_at) VALUES (?, 'osp', ?, ?, datetime('now'), datetime('now'))", [method, to_string(n), to_string(OSPSkillScore(ab, 0.25))])
          }
        }
      }
    } else {
      out = out + "· " + method + ": недостаточно данных (" + to_string(n) + "/" + to_string(OSPMinN()) + ") — число не публикуется\n"
    }
    i = i + 1.0
  }
  let _ = try AuditLog("osp_method_ab", "osp", kind + " methods=" + to_string(length(rows)))
  return out
}

pattern OSPMethodABCommand(chat_id: String) -> String {
  let owner = OSPMethodAB("owner")
  return OSPDisclaimer() + "\n\n" + owner + "\n\nПол n≥10 на методику (§5.1); запись в skill_reviews — только при n≥10. Пункт приёмки «у ≥3 методик n≥10» отложен владельцем (#627): доска наполняется по мере разрешения прогонов."
}

// /osp curve [ГГГГ-ММ]: кривая калибровки владельцу — программный блок чисел
// + SVG (chart_line) документом в чат (/send-document, путь от корня офиса).
// Ошибка доставки/записи НЕ ломает ответ — числа приходят текстом.
pattern OSPCurveCommand(rest: String, chat_id: String) -> String {
  let arg = trim(substring(trim(rest), 0.0, 10.0))
  let mut period = ""
  if OSPStrIsNumber(replace(replace(arg, "-", ""), "", "")) == false or length(arg) < 7.0 {
    let pm = query("SELECT strftime('%Y-%m', 'now') AS p", [])
    period = to_string(json_get(get(pm, 0.0), "p", ""))
  } else {
    period = arg
  }
  let svg_path = "visuals/osp_calibration_owner_" + period + ".svg"
  let cr = OSPCalibrationCurve("owner", period, svg_path)
  let mut out = OSPDisclaimer() + "\n\n📐 Калибровочная кривая (owner, " + period + ")\n" + cr
  if starts_with(cr, "OK|") {
    // строка period из monthly_reviews — уже с кривой; доставляем SVG документом
    let rows = query("SELECT calibration_curve FROM monthly_reviews WHERE year_month = ?", [period])
    if length(rows) > 0.0 {
      out = out + "\n\nКривая (бакет: n, средний p, частота исхода): " + to_string(json_get(get(rows, 0.0), "calibration_curve", ""))
    }
    if chat_id != "" and length(svg_path) > 0.0 and contains(cr, "|svg=" + svg_path) {
      let body = json_encode({path: svg_path, chat_id: to_float(chat_id), caption: "Калибровочная кривая ОСП (owner, " + period + "): частота исходов по бакетам p_final"})
      let resp = TryVal(try http_post("http://127.0.0.1:4000/send-document", body, "application/json", 90.0))
      if to_string(resp) == "()" {
        out = out + "\n\n(SVG не доставлен — сервис отправки не ответил; файл: " + svg_path + ")"
      }
    }
  }
  let _ = try AuditLog("osp_curve", "osp", period + " " + substring(cr, 0.0, 80.0))
  return out
}

// Ежемесячный слот 1-го числа (наряд #627 п.3): метрики ПРОГРАММОЙ —
// OSPMonthlyReview прошлого месяца + калибровочная кривая; находки —
// в ночной отчёт 07:15 через OutboxPut (механизм #550, как osp-watch).
// Ноль LLM-вызовов и ноль сети — деньги не тратит
pattern OSPMonthlySlot() -> String {
  let _ = OSPFEnsureSchema()
  let pm = query("SELECT strftime('%Y-%m', 'now', '-1 month') AS p", [])
  let period = to_string(json_get(get(pm, 0.0), "p", ""))
  let mr = OSPMonthlyReview(period, "owner")
  let cr = OSPCalibrationCurve("owner", period, "")
  let rep = "📅 Ежемесячный обзор ОСП (" + period + "):\n" + mr + "\n" + cr
  let _ = try OutboxPut("osp-monthly", rep)
  let _ = try AuditLog("osp_monthly_slot", "osp", period)
  return rep
}

// Касание владельца одной строкой: /osp resolve <id> да|нет [заметка]
pattern OSPResolveCommand(rest: String, chat_id: String) -> String {
  let parts = split(trim(rest), " ")
  if length(parts) < 2.0 then { return "Формат: /osp resolve <id> да|нет [заметка] — исход подтверждает владелец; сверка после resolve_by" }
  let ids = trim(to_string(get(parts, 0.0)))
  if OSPStrIsNumber(ids) == false then { return "NO|id не число: " + ids }
  let id = to_float(ids)
  let outcome = trim(to_string(get(parts, 1.0)))
  let mut note = ""
  let mut i = 2.0
  while i < length(parts) {
    if note == "" then { note = to_string(get(parts, i)) } else { note = note + " " + to_string(get(parts, i)) }
    i = i + 1.0
  }
  let r = OSPVerifyCard(id, outcome, note)
  if starts_with(r, "OK|") then {
    return "✅ Исход записан: " + r + "\n" + OSPFCardLine(id) + "\nБлок точности: /osp score"
  }
  return "⚠️ " + r
}

// ── Фикстуры W2-тестов: сырой SQL только в паттерне (гвард №312).
// kind изолирует тестовый контур от owner-данных (инвариант 5);
// засев только в пустой контур — повторные прогоны идемпотентны
pattern OSPW2SeedIfEmpty(kind: String) -> String {
  let _ = OSPFEnsureSchema()
  let cnt = query("SELECT COUNT(*) AS c FROM osp_forecast WHERE kind = ?", [kind])
  if to_float(to_string(json_get(get(cnt, 0.0), "c", "0"))) == 0.0 then { return "empty" }
  return "has"
}

pattern OSPW2SeedResolved(kind: String, p: Float, y: Float) -> String {
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_final, outcome, brier, cal_bucket, verified_at, created_at) VALUES (?, ?, 'resolved', ?, ?, ?, 1, datetime('now'), datetime('now'))", [kind, "n625 seed " + kind + " p=" + to_string(p) + " y=" + to_string(y), to_string(p), to_string(y), to_string(OSPBrier(p, y))])
  return "ok"
}

pattern OSPW2SeedCrowd(kind: String, p: Float, y: Float, bc: Float) -> String {
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_final, outcome, brier, brier_crowd, cal_bucket, verified_at, created_at) VALUES (?, ?, 'resolved', ?, ?, ?, ?, 1, datetime('now'), datetime('now'))", [kind, "n625 seed crowd " + kind + " p=" + to_string(p), to_string(p), to_string(y), to_string(OSPBrier(p, y)), to_string(bc)])
  return "ok"
}

pattern OSPW2SeedBaseRate(topic: String, n: Float, rate: Float) -> String {
  let ex = query("SELECT topic FROM osp_base_rates WHERE topic = ?", [topic])
  if length(ex) == 0.0 then {
    let _ = db_execute("INSERT INTO osp_base_rates (topic, n, base_rate, source, updated_at) VALUES (?, ?, ?, 'n625-test', datetime('now'))", [topic, to_string(n), to_string(rate)])
  } else {
    let _ = db_execute("UPDATE osp_base_rates SET n = ?, base_rate = ? WHERE topic = ?", [to_string(n), to_string(rate), topic])
  }
  return "ok"
}

// Фикстура верификации: горизонт в прошлом — сверка владельцем разрешена
pattern OSPW2ForcePast(forecast_id: Float) -> String {
  let _ = db_execute("UPDATE osp_forecast SET resolve_by = date('now', '-1 day') WHERE id = ?", [to_string(forecast_id)])
  return "ok"
}

// ═══════════════════════════════════════════════════════════════════════
// W3 #626: внешний поток ForecastBench + ночная вахта
// Данные проверены загрузкой реальных файлов 05.11 (question_sets/2026-10-25-llm.json
// 1473008 байт, 500 вопросов; resolution_sets/2026-10-11: 496 строк, 271 resolved).
// http-контент публичного источника — недоверенный (№316): все решения — на
// redact("all")-копии; redact детерминичен между процессами (проверено), одинаковые
// id обоих файлов маскируются одинаково — join qid сходится
// ═══════════════════════════════════════════════════════════════════════

// Схема §3.2: внешний контур (удаляется целиком, owner-контур не трогает) +
// system_settings (тот же ключ бюджета, что у прокси — proxy/budget.py:99-108)
pattern OSPBenchEnsureSchema() -> String {
  let _ = OSPFEnsureSchema()
  let _ = db_execute("CREATE TABLE IF NOT EXISTS osp_bench_rounds (due_date TEXT PRIMARY KEY, question_set TEXT, n_questions INTEGER, n_market INTEGER, n_dataset INTEGER, n_blocked INTEGER, n_rows INTEGER, license TEXT DEFAULT 'CC BY-SA 4.0 · forecastingresearch/forecastbench-datasets', ingested_at TEXT)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS osp_bench_questions (qid TEXT PRIMARY KEY, due_date TEXT, source TEXT, question TEXT, freeze_datetime TEXT, crowd_p REAL, horizons INTEGER, model_payload TEXT)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS osp_bench_blocked (qid TEXT PRIMARY KEY, due_date TEXT, source TEXT, reason TEXT, checked_at TEXT)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS system_settings (key TEXT PRIMARY KEY, value TEXT)", [])
  // Бюджет ОСП 10.00 — решение владельца 03.11, подтверждено 05.11 (B.3 2.00
  // отменено, наряд #664); seeded один раз, дальше — только владелец меняет
  // (UPDATE OSPW3Setting в тестах)
  let ex = query("SELECT value FROM system_settings WHERE key = 'daily_budget_osp'", [])
  if length(ex) == 0.0 then {
    let _ = db_execute("INSERT INTO system_settings (key, value) VALUES ('daily_budget_osp', '10.00')", [])
  }
  // A.2 #664: разовая миграция прода 2.00 → 10.00 по маркеру mig_osp_budget_1105:
  // мигрируется ТОЛЬКО literal '2.00' (наследие B.3) — ручное значение владельца
  // не трогается; маркер делает миграцию одноразовой за жизнь БД
  let mig = query("SELECT key FROM system_settings WHERE key = 'mig_osp_budget_1105'", [])
  if length(mig) == 0.0 then {
    let cur = query("SELECT value FROM system_settings WHERE key = 'daily_budget_osp'", [])
    if length(cur) > 0.0 and to_string(json_get(get(cur, 0.0), "value", "")) == "2.00" then {
      let _ = db_execute("UPDATE system_settings SET value = '10.00' WHERE key = 'daily_budget_osp'", [])
    }
    let _ = db_execute("INSERT OR IGNORE INTO system_settings (key, value) VALUES ('mig_osp_budget_1105', 'done')", [])
  }
  return "ok"
}

// Атрибуция §6.7 — в каждой строке раунда и в экспорте
pattern OSPBenchAttribution() -> String {
  return "CC BY-SA 4.0 · forecastingresearch/forecastbench-datasets"
}

// Белый список полей (§6.3 слой 1): payload собирается заново — поля исхода
// не могут в него попасть, потому что их нет в списке. MUT-мишень наряда
pattern OSPBenchWhitelist() -> String {
  return "question;resolution_criteria;background;source_intro;url;freeze_datetime_value;resolution_dates;market_info_resolution_criteria"
}

pattern OSPBenchSetUrl(due: String) -> String {
  return "https://raw.githubusercontent.com/forecastingresearch/forecastbench-datasets/main/datasets/question_sets/" + due + "-llm.json"
}

// http_get без гранта (registry.rs:281 — проверка №620); недоверенный контент
// уходит через one-way redact ДО решений (№316/B1)
pattern OSPBenchFetchSet(due: String) -> String {
  let raw = TryVal(try http_get(OSPBenchSetUrl(due), 120.0))
  let rs = redact(to_string(raw), "all")
  if rs == "()" or rs == "" then { return "FAIL|источник не ответил: " + OSPBenchSetUrl(due) }
  return "OK|" + rs
}

// Слой 1: точное присутствие ключей исхода в вопросе (json_get с sentinel,
// не поиск подстроки). Блок — раунд останавливается: взят resolution_set
pattern OSPBenchHasForbidden(qjson: String) -> String {
  let d = parse_json(qjson)
  let wl = split("resolved_to;resolved;direction;outcome;actual_value;resolution_value", ";")
  each k in wl {
    let key = to_string(k)
    if to_string(json_get(d, key, "АБСЕНТ")) != "АБСЕНТ" then {
      return "BLOCK|" + key
    }
  }
  return "CLEAN"
}

// Payload — только белый список (конструкция, а не фильтр, §6.3).
// json_encode значения, не to_string: массив resolution_dates — не строка
pattern OSPBenchBuildPayload(qjson: String) -> String {
  let d = parse_json(qjson)
  let wl = split(OSPBenchWhitelist(), ";")
  let mut out = "{"
  let mut first = true
  each k in wl {
    let key = to_string(k)
    let v = json_get(d, key, "АБСЕНТ")
    if to_string(v) != "АБСЕНТ" then {
      if first then { first = false } else { out = out + "," }
      out = out + json_encode(key) + ":" + json_encode(v)
    }
  }
  return out + "}"
}

// resolution_dates: массив ISO-дат (dataset — до 5 горизонтов) | "N/A"
// (рыночные — одно разрешение на закрытии). Выход: CSV дат | "" — один ряд
pattern OSPBenchHorizons(res_dates: String) -> String {
  let t = trim(res_dates)
  if t == "" or t == "N/A" then { return "" }
  let inner = trim(t)
  if starts_with(inner, "[") then { let inner = substring(inner, 1.0, length(inner) - 1.0) }
  if ends_with(inner, "]") then { let inner = substring(inner, 0.0, length(inner) - 1.0) }
  let parts = split(inner, ",")
  let mut out = ""
  each p in parts {
    let d = trim(to_string(p))
    let d2 = d
    if starts_with(d2, "\"") then { let d2 = substring(d2, 1.0, length(d2) - 1.0) }
    if length(d2) > 0.0 then {
      if out == "" then { out = d2 } else { out = out + ";" + d2 }
    }
  }
  return out
}

// Crowd-линия §6.2 (2): вероятность сообщества только у рынков; у fred/yfinance
// freeze_value — УРОВЕНЬ РЯДА — принять за вероятность значит Brier ≈ 10000
pattern OSPBenchCrowd(source: String, freeze_value: String) -> Float {
  let s = lower(trim(source))
  if s != "kalshi" and s != "manifold" and s != "metaculus" and s != "polymarket" then { return -1.0 }
  // №514: to_float на нечисле бросает — явный фолбэк
  let v = to_float_or(trim(freeze_value), -1.0)
  if v < 0.0 or v > 1.0 then { return -1.0 }
  return v
}

pattern OSPBenchQid(source: String, id: String, due: String) -> String {
  return lower(trim(source)) + ":" + trim(id) + "@" + due
}

// Ingest ядра: payload → белый список → утечка-гвард → строки раунда.
// Идемпотентен: повторный ingest того же due → SKIP (приёмка наряда)
pattern OSPBenchIngestData(due: String, payload: String) -> String {
  let _ = OSPBenchEnsureSchema()
  let ex = query("SELECT n_rows FROM osp_bench_rounds WHERE due_date = ?", [due])
  if length(ex) > 0.0 then {
    return "SKIP|раунд " + due + " уже засеян: n_rows=" + to_string(json_get(get(ex, 0.0), "n_rows", "?"))
  }
  let d = try parse_json(payload)
  if to_string(d) == "()" then { return "FAIL|не JSON: question_set" }
  if d.ok == false then { return "FAIL|не JSON: question_set" }
  let qs = json_get(d.value, "questions", [])
  let nq = length(qs)
  if nq == 0.0 then { return "FAIL|пустой набор вопросов" }
  // Утечка-гвард по КАЖДОМУ вопросу — один блок останавливает раунд.
  // json_encode, не to_string: строковая форма объекта не JSON (урок №603 B.2)
  each q in qs {
    let qj = json_encode(q)
    let g = OSPBenchHasForbidden(qj)
    if starts_with(g, "BLOCK|") then {
      return "BLOCK|раунд остановлен: в вопросе поле исхода (" + substring(g, 6.0, length(g)) + ") — взят resolution_set вместо question_set"
    }
  }
  // Строки вопросов: payload из белого списка, crowd по источнику
  let mut nmarket = 0.0
  let mut i = 0.0
  while i < nq {
    let q = get(qs, i)
    let src = to_string(json_get(q, "source", ""))
    let qid = OSPBenchQid(src, to_string(json_get(q, "id", "")), due)
    let fz = to_string(json_get(q, "freeze_datetime", ""))
    let crowd = OSPBenchCrowd(src, to_string(json_get(q, "freeze_datetime_value", "")))
    let hz = OSPBenchHorizons(to_string(json_get(q, "resolution_dates", "")))
    let nhz = 1.0
    if hz != "" then { let nhz = length(split(hz, ";")) }
    let _ = db_execute("INSERT INTO osp_bench_questions (qid, due_date, source, question, freeze_datetime, crowd_p, horizons, model_payload) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", [qid, due, src, substring(to_string(json_get(q, "question", "")), 0.0, 2000.0), fz, to_string(crowd), to_string(nhz), OSPBenchBuildPayload(json_encode(q))])
    if crowd >= 0.0 then { let nmarket = nmarket + 1.0 }
    i = i + 1.0
  }
  let ndataset = nq - nmarket
  // Детерминированная стратифицированная выборка (поправка 3): по N вопросов
  // с источника, порядок по qid, без random — иначе раунд невоспроизводим
  let ps_rows = query("SELECT value FROM system_settings WHERE key = 'osp_bench_per_source'", [])
  let mut per_source = 18.0
  if length(ps_rows) > 0.0 then { let per_source = to_float(to_string(json_get(get(ps_rows, 0.0), "value", "18"))) }
  let srcs = query("SELECT DISTINCT source FROM osp_bench_questions WHERE due_date = ? ORDER BY source", [due])
  let mut sample_csv = ""
  each s in srcs {
    let src = to_string(json_get(s, "source", ""))
    let sub = query("SELECT qid, horizons FROM osp_bench_questions WHERE due_date = ? AND source = ? ORDER BY qid LIMIT ?", [due, src, to_string(per_source)])
    each r in sub {
      let qid = to_string(json_get(r, "qid", ""))
      let nh = to_float(to_string(json_get(r, "horizons", "1")))
      if sample_csv == "" then { sample_csv = qid + ":" + to_string(nh) } else { sample_csv = sample_csv + ";" + qid + ":" + to_string(nh) }
    }
  }
  let sample_parts = split(sample_csv, ";")
  let mut nrows = 0.0
  each p in sample_parts {
    let pp = split(to_string(p), ":")
    // qid сам содержит ":" (source:id@due) — горизонт последний элемент
    if length(pp) >= 2.0 then { nrows = nrows + to_float(to_string(get(pp, to_float(to_string(length(pp) - 1.0))))) }
  }
  let nsample = length(sample_parts)
  let _ = db_execute("INSERT INTO osp_bench_rounds (due_date, question_set, n_questions, n_market, n_dataset, n_blocked, n_rows, license, ingested_at) VALUES (?, ?, ?, ?, ?, 0, ?, ?, datetime('now'))", [due, OSPBenchSetUrl(due), to_string(nq), to_string(nmarket), to_string(ndataset), to_string(nrows), OSPBenchAttribution()])
  return "OK|questions=" + to_string(nq) + "|market=" + to_string(nmarket) + "|dataset=" + to_string(ndataset) + "|sample=" + to_string(nsample) + "|rows=" + to_string(nrows)
}

// Ingest прод: живой fetch + ядро
pattern OSPBenchIngest(due: String) -> String {
  let f = OSPBenchFetchSet(due)
  if starts_with(f, "FAIL|") then { return f }
  return OSPBenchIngestData(due, substring(f, 3.0, length(f)))
}

// Детерминированная выборка раунда — пересчитывается, состояние не хранится
pattern OSPBenchSample(due: String) -> String {
  let _ = OSPBenchEnsureSchema()
  let ps_rows = query("SELECT value FROM system_settings WHERE key = 'osp_bench_per_source'", [])
  let mut per_source = 18.0
  if length(ps_rows) > 0.0 then { let per_source = to_float(to_string(json_get(get(ps_rows, 0.0), "value", "18"))) }
  let srcs = query("SELECT DISTINCT source FROM osp_bench_questions WHERE due_date = ? ORDER BY source", [due])
  let mut out = ""
  each s in srcs {
    let src = to_string(json_get(s, "source", ""))
    let sub = query("SELECT qid FROM osp_bench_questions WHERE due_date = ? AND source = ? ORDER BY qid LIMIT ?", [due, src, to_string(per_source)])
    each r in sub {
      let qid = to_string(json_get(r, "qid", ""))
      if out == "" then { out = qid } else { out = out + ";" + qid }
    }
  }
  return out
}

// Маркер конфигурации прогона (поправка 3): строка с отличной конфигурацией —
// непригодна для калибровки owner
pattern OSPBenchConfigCurrent() -> String {
  return "ensemble-v1:" + OSPEnsembleModels()
}

// Стоимость строки прогноза: ансамбль × оценка прогона (верхняя граница §6.4)
pattern OSPBenchCostPerRow() -> Float {
  let fams = split(OSPEnsembleModels(), ";")
  let mut n = 0.0
  each f in fams {
    if trim(to_string(f)) != "" then { let n = n + 1.0 }
  }
  if n == 0.0 then { return OSPRunCostEst() }
  return n * OSPRunCostEst()
}

// Ворота бюджета §6.4: тот же ключ, что у прокси (OSPLimitRead). Вердикты:
// OK / OVER с точным cap строк / UNLIMITED (off — enforcement не активен)
pattern OSPBenchBudgetGate(rows_planned: Float) -> String {
  let lv = OSPLimitRead()
  if lv == "off" then { return "UNLIMITED|лимит не установлен — enforcement не активен (видно в отчёте)" }
  let left = to_float(lv) - to_float(OSPBudgetUsed())
  let cpr = OSPBenchCostPerRow()
  let cost = rows_planned * cpr
  if left >= cost then { return "OK|left=" + OSPFmt3(left) }
  let cap = to_int(left / cpr)
  return "OVER|cap=" + to_string(cap) + " строк из " + to_string(rows_planned) + " (left=" + OSPFmt3(left) + ", cost_per_row=" + OSPFmt3(cpr) + ") — лучше все строки дешёвыми семействами, чем половину дорогими (§6.5)"
}

// Прогноз одной строки раунда: временной заслон (слой 2) → тот же ансамбль,
// что у owner (поправка 3) → строка kind='bench' в вахту. bench_qid =
// qid|res_date; конфиг прогона — в models_json
pattern OSPBenchForecastRow(due: String, qid: String, res_date: String) -> String {
  let _ = OSPBenchEnsureSchema()
  let rows = query("SELECT question, model_payload, freeze_datetime, crowd_p FROM osp_bench_questions WHERE qid = ?", [qid])
  if length(rows) == 0.0 then { return "SKIP|вопрос не найден: " + qid }
  let row = get(rows, 0.0)
  let payload = to_string(json_get(row, "model_payload", ""))
  let crit = to_string(json_get(parse_json(payload), "resolution_criteria", ""))
  let freeze = to_string(json_get(row, "freeze_datetime", ""))
  let crowd = to_float(to_string(json_get(row, "crowd_p", "-1")))
  // Временной заслон (§6.3 слой 2): прогноз после freeze — утечка. MUT-мишень
  let fe = OSPFEpochOf(freeze)
  if fe <= 0.0 then { return "SKIP|freeze не распознан: " + freeze }
  if now_unix() > fe then { return "SKIP|freeze прошёл " + freeze + " — прогноз после заморозки не принимается" }
  if length(trim(crit)) < 20.0 then { return "SKIP|критерий исхода короче 20 символов" }
  let qtext = to_string(json_get(row, "question", ""))
  let ens = OSPEnsemble(qtext + " Критерий исхода: " + crit)
  if starts_with(ens, "OK|") == false then { return "SKIP|ансамбль недоступен: " + substring(ens, 0.0, 60.0) }
  let pp = split(ens, "|")
  let nv = to_float(to_string(get(pp, 1.0)))
  let mean = to_float(to_string(get(pp, 2.0)))
  let median = to_float(to_string(get(pp, 3.0)))
  let lp = to_float(to_string(get(pp, 4.0)))
  let spread = to_float(to_string(get(pp, 5.0)))
  let mj = to_string(get(pp, 7.0))
  let p = OSPPlattApply(OSPClip(mean))
  let bench_qid = qid + "|" + res_date
  let mut g3s = "\"w2\":\"валидных прогонов мало\""
  if nv >= 3.0 and spread <= 0.25 then { g3s = "\"g3\":\"PASS\"" }
  let gr = "{\"g1\":\"PASS\"," + g3s + "}"
  let mjf = "{\"config\":" + json_encode(OSPBenchConfigCurrent()) + ",\"runs\":" + mj + "}"
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, resolution_criteria, as_of, resolve_by, status, p_raw, p_ensemble, p_median, p_logit, p_spread, n_runs, crowd_p, p_final, kent_label, cal_bucket, bench_qid, resolution_date, gate_report, models_json, created_at) VALUES ('bench', ?, ?, ?, ?, 'watching', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now'))", [substring(qtext, 0.0, 2000.0), substring(crit, 0.0, 2000.0), freeze, res_date, to_string(mean), to_string(mean), to_string(median), to_string(lp), to_string(spread), to_string(nv), to_string(crowd), to_string(p), OSPKentOf(p), to_string(OSPBucketOf(p)), bench_qid, res_date, gr, substring(mjf, 0.0, 6000.0)])
  let _ = db_execute("INSERT INTO osp_forecast_events (forecast_id, from_status, to_status, reason, actor, created_at) VALUES ((SELECT id FROM osp_forecast WHERE bench_qid = ? ORDER BY id DESC LIMIT 1), '', 'watching', 'bench-прогноз записан (ансамбль, конфиг в models_json)', 'osp-bench', datetime('now'))", [bench_qid])
  // #627 W4 A.5: прогоны bench-ансамбля — тоже в osp_forecast_method_runs
  // (конфиг в models_json; непригодные для калибровки owner — поправка 3,
  // помечает OSPBenchResolveData)
  let mjo = try parse_json(mj)
  if to_string(mjo) != "()" {
    if mjo.ok == true {
    let runs = json_get(mjo.value, "runs", [])
    if to_string(runs) != "()" and length(runs) > 0.0 {
      each r in runs {
        if to_string(json_get(r, "status", "")) == "PASS" {
          let model = to_string(json_get(r, "model", ""))
          let rp = to_string(json_get(r, "p", ""))
          if model != "" and rp != "" and OSPStrIsNumber(rp) {
            let _ = db_execute("INSERT INTO osp_forecast_method_runs (forecast_id, method, p_i, family) VALUES ((SELECT id FROM osp_forecast WHERE bench_qid = ? ORDER BY id DESC LIMIT 1), ?, ?, ?)", [bench_qid, substring(model, 0.0, 120.0), rp, OSPFamilyOf(model)])
          }
        }
      }
    }
    }
  }
  return "OK|" + bench_qid + "|p_final=" + to_string(p)
}

// Прогон раунда: бюджетные ворота (§6.4) → цикл по выборке × горизонтам.
// Не вызывается тестами (живой LLM); верифицируется компонентами выше
pattern OSPBenchRunRound(due: String) -> String {
  let _ = OSPBenchEnsureSchema()
  let rnd = query("SELECT n_rows FROM osp_bench_rounds WHERE due_date = ?", [due])
  if length(rnd) == 0.0 then { return "FAIL|раунд не засеян: " + due }
  let sample = OSPBenchSample(due)
  if trim(sample) == "" then { return "FAIL|выборка пуста" }
  let parts = split(sample, ";")
  let mut plan = 0.0
  each p in parts {
    let prow = query("SELECT horizons FROM osp_bench_questions WHERE qid = ?", [to_string(p)])
    if length(prow) > 0.0 then { plan = plan + to_float(to_string(json_get(get(prow, 0.0), "horizons", "1"))) }
  }
  let gate = OSPBenchBudgetGate(plan)
  let mut budget_rows = plan
  if starts_with(gate, "OVER|") then {
    // OVER|cap=<k> строк из ... — точный потолок строк по бюджету
    let capv = to_string(get(split(to_string(get(split(gate, " "), 1.0)), "="), 1.0))
    budget_rows = to_float(capv)
  }
  let mut ok = 0.0
  let mut skip = 0.0
  let mut fail = 0.0
  let mut done = 0.0
  each p in parts {
    if done >= budget_rows then {
      skip = skip + 1.0
    } else {
      let qid = to_string(p)
      let qrow = query("SELECT model_payload FROM osp_bench_questions WHERE qid = ?", [qid])
      if length(qrow) == 0.0 then {
        skip = skip + 1.0
      } else {
        let payload = to_string(json_get(get(qrow, 0.0), "model_payload", ""))
        let hz = OSPBenchHorizons(to_string(json_get(parse_json(payload), "resolution_dates", "")))
        if hz == "" then {
          // рыночный вопрос — один ряд без даты (разрешение на закрытии)
          let r = OSPBenchForecastRow(due, qid, "")
          if starts_with(r, "OK|") then { ok = ok + 1.0 } else {
            if starts_with(r, "SKIP|") then { skip = skip + 1.0 } else { fail = fail + 1.0 }
          }
          done = done + 1.0
        } else {
          each d in split(hz, ";") {
            if done >= budget_rows then {
              skip = skip + 1.0
            } else {
              let r = OSPBenchForecastRow(due, qid, to_string(d))
              if starts_with(r, "OK|") then { ok = ok + 1.0 } else {
                if starts_with(r, "SKIP|") then { skip = skip + 1.0 } else { fail = fail + 1.0 }
              }
              done = done + 1.0
            }
          }
        }
      }
    }
  }
  return "ROUND|due=" + due + "|план=" + to_string(plan) + "|бюджет_строк=" + to_string(budget_rows) + "|ok=" + to_string(ok) + "|skip=" + to_string(skip) + "|fail=" + to_string(fail) + "|гейт=" + substring(gate, 0.0, 30.0)
}

// URL набора исходов §6.2
pattern OSPBenchResolveUrl(due: String) -> String {
  return "https://raw.githubusercontent.com/forecastingresearch/forecastbench-datasets/main/datasets/resolution_sets/" + due + "_resolution_set.json"
}

// Resolve прод: живой fetch набора исходов + ядро
pattern OSPBenchResolve(due: String) -> String {
  let raw = TryVal(try http_get(OSPBenchResolveUrl(due), 120.0))
  let rs = redact(to_string(raw), "all")
  if rs == "()" or rs == "" then { return "FAIL|источник не ответил: " + OSPBenchResolveUrl(due) }
  return OSPBenchResolveData(due, rs)
}

// Resolve ядра §6.5: только после записи всех прогнозов раунда (правило Б —
// MUT-приёмка); исход — из resolution_set, автоматически (B.4 владельца);
// штраф пропуска — импутация 0.5, считается явно; конфиг-несовместимые строки
// помечаются непригодными для калибровки owner (поправка 3)
pattern OSPBenchResolveData(due: String, payload: String) -> String {
  let _ = OSPBenchEnsureSchema()
  let rnd = query("SELECT n_rows FROM osp_bench_rounds WHERE due_date = ?", [due])
  if length(rnd) == 0.0 then { return "FAIL|раунд не засеян: " + due }
  let nrows = to_float(to_string(json_get(get(rnd, 0.0), "n_rows", "0")))
  let sample = OSPBenchSample(due)
  let mut written = 0.0
  each q in split(sample, ";") {
    let c = query("SELECT COUNT(*) AS c FROM osp_forecast WHERE kind = 'bench' AND bench_qid LIKE ?", [to_string(q) + "|%"])
    written = written + to_float(to_string(json_get(get(c, 0.0), "c", "0")))
  }
  if nrows > 0.0 and written < nrows then {
    return "BLOCK|раунд не прогнан: записано " + to_string(written) + " из " + to_string(nrows) + " строк — resolve до прогнозов запрещён (правило Б §6.3)"
  }
  let d = try parse_json(payload)
  if to_string(d) == "()" then { return "FAIL|не JSON: resolution_set" }
  if d.ok == false then { return "FAIL|не JSON: resolution_set" }
  let rs = json_get(d.value, "resolutions", [])
  let nres = length(rs)
  let mut ok = 0.0
  let mut pending = 0.0
  let mut missing = 0.0
  let mut bsum = 0.0
  let mut unfit = 0.0
  let mut i = 0.0
  while i < nres {
    let r = get(rs, i)
    let rsv = to_string(json_get(r, "resolved", "false"))
    if rsv == "true" or rsv == "True" or rsv == "1" then {
      let src = to_string(json_get(r, "source", ""))
      let res_date = to_string(json_get(r, "resolution_date", ""))
      let y = to_float(to_string(json_get(r, "resolved_to", "-1")))
      if y < 0.0 or y > 1.0 then {
        missing = missing + 1.0
      } else {
        let qid = OSPBenchQid(src, to_string(json_get(r, "id", "")), due)
        let fq = query("SELECT id, p_final, models_json FROM osp_forecast WHERE kind = 'bench' AND bench_qid = ? AND status <> 'resolved' ORDER BY id DESC LIMIT 1", [qid + "|" + res_date])
        if length(fq) == 0.0 and res_date != "" then {
          // рыночный вопрос — наш ряд без даты (закрытие рынка)
          let fq = query("SELECT id, p_final, models_json FROM osp_forecast WHERE kind = 'bench' AND bench_qid = ? AND status <> 'resolved' ORDER BY id DESC LIMIT 1", [qid + "|"])
        }
        if length(fq) == 0.0 then {
          missing = missing + 1.0
        } else {
          let frow = get(fq, 0.0)
          let fid = to_float(to_string(json_get(frow, "id", "0")))
          let pf = to_float(to_string(json_get(frow, "p_final", "0.5")))
          let b = OSPBrier(pf, y)
          let tr = OSPTransition(fid, "resolved", "исход из resolution_set (bench, " + OSPBenchAttribution() + ")", "osp-bench")
          if starts_with(tr, "OK|") then {
            let _ = db_execute("UPDATE osp_forecast SET outcome = ?, brier = ?, verified_at = datetime('now'), updated_at = datetime('now') WHERE id = ?", [to_string(y), to_string(b), to_string(fid)])
            bsum = bsum + b
            ok = ok + 1.0
            // поправка 3: конфиг прогона отличается — непригодно для калибровки owner
            let cfg = to_string(json_get(parse_json(to_string(json_get(frow, "models_json", "{}"))), "config", ""))
            if cfg != OSPBenchConfigCurrent() then {
              unfit = unfit + 1.0
              let _ = db_execute("UPDATE osp_forecast SET gate_report = gate_report || ? WHERE id = ?", [",\"calibration\":\"unfit-config\"", to_string(fid)])
            }
          } else {
            missing = missing + 1.0
          }
        }
      }
    } else {
      pending = pending + 1.0
    }
    i = i + 1.0
  }
  let penalty = missing * 0.25
  let mut bavg = 0.0
  if ok > 0.0 then { bavg = bsum / ok }
  return "RESOLVE|due=" + due + "|строк_исходов=" + to_string(nres) + "|разрешено_наших=" + to_string(ok) + "|ещё_не_разрешено=" + to_string(pending) + "|нет_нашего_прогноза=" + to_string(missing) + "|Brier_покрытых=" + OSPFmt3(bavg) + "|покрытие=" + to_string(written) + "/" + to_string(nrows) + "|штраф_за_пропуски=+" + OSPFmt3(penalty) + "|конфиг-несовместимых=" + to_string(unfit)
}

// ── Ночная вахта (§4.5, §10 волна 3): обход due-карточек и громкая архивация ──

// Что ждёт сверки владельца: watching-карточки с наступившим горизонтом;
// bench-строки — ждут автоматического исхода, не трогаем
pattern OSPWatchDue(now_iso: String) -> String {
  let _ = OSPFEnsureSchema()
  let t = OSPFEpochOf(now_iso)
  if t <= 0.0 then { return "FAIL|now не ISO: " + now_iso }
  // resolve_by — ISO-дата; строковое сравнение в SQL легально (SQLite ISO,
  // §6.3 слой 2 прим.: лексикографика в mlog нет, в SQL — есть)
  let rows = query("SELECT id, question, bench_qid FROM osp_forecast WHERE status = 'watching' AND resolve_by IS NOT NULL AND resolve_by <> '' AND resolve_by <= ? ORDER BY id", [substring(now_iso, 0.0, 10.0)])
  if length(rows) == 0.0 then { return "вахта: ничего не ждёт сверки" }
  let mut out = ""
  each r in rows {
    let id = to_string(json_get(r, "id", ""))
    let bq = to_string(json_get(r, "bench_qid", ""))
    let q = substring(to_string(json_get(r, "question", "")), 0.0, 80.0)
    if bq != "" then {
      if out == "" then { out = "⏳ bench " + bq + " — исход придёт OSPBenchResolve" } else { out = out + "\n⏳ bench " + bq + " — исход придёт OSPBenchResolve" }
    } else {
      let line = "📐 карточка " + id + " ждёт сверки: " + q + " — /osp resolve " + id + " да|нет"
      if out == "" then { out = line } else { out = out + "\n" + line }
    }
  }
  return out
}

// Громкая архивация: watching/published без исхода после горизонта + 7 дней
// (грейс на сверку владельцем) → expired + событие (инвариант 4). AUTOMATON:
// published/watching → expired разрешён (W1 карта переходов)
pattern OSPArchiveExpired(now_iso: String) -> String {
  let _ = OSPFEnsureSchema()
  let cutoff = query("SELECT date(?, '-7 days') AS c", [substring(now_iso, 0.0, 10.0)])
  let cut = to_string(json_get(get(cutoff, 0.0), "c", ""))
  let rows = query("SELECT id, question, status FROM osp_forecast WHERE status IN ('watching','published') AND resolve_by IS NOT NULL AND resolve_by <> '' AND resolve_by < ? AND outcome IS NULL ORDER BY id", [cut])
  if length(rows) == 0.0 then { return "вахта: истёкших нет" }
  let mut out = ""
  let mut n = 0.0
  each r in rows {
    let id = to_float(to_string(json_get(r, "id", "0")))
    let st = to_string(json_get(r, "status", "?"))
    let tr = OSPTransition(id, "expired", "истекла без исхода: горизонт прошёл больше 7 дней назад, сверки владельца не было", "osp-watch")
    if starts_with(tr, "OK|") then {
      n = n + 1.0
      let line = "🗄️ карточка " + to_string(id) + " истекла без исхода — громкая архивация (был статус " + st + ")"
      if out == "" then { out = line } else { out = out + "\n" + line }
    }
  }
  if n == 0.0 then { return "вахта: истёкших нет" }
  return out
}

// Ночной слот: обход due + архивация; находки — в ночной отчёт 07:15
// (OutboxPut → OutboxFlush 07:15, механизм #550)
pattern OSPWatchSlot() -> String {
  let _ = OSPBenchEnsureSchema()
  let today = query("SELECT date('now') AS d", [])
  let now_iso = to_string(json_get(get(today, 0.0), "d", ""))
  let due = OSPWatchDue(now_iso)
  let expired = OSPArchiveExpired(now_iso)
  let mut rep = "🌙 Ночная вахта ОСП:\n" + due
  if expired != "вахта: истёкших нет" then {
    rep = rep + "\n" + expired
    let _ = try OutboxPut("osp-watch", rep)
  }
  let _ = try AuditLog("osp_watch_slot", "osp", substring(rep, 0.0, 120.0))
  return rep
}

// Слот раунда бенчмарка: самый свежий засеянный раунд — прогон + попытка resolve.
// Расписание (вторник/суббота) — реестр dept/schedules.mlog, entry выключен
// до решения владельца (протокол №419); роут /cron/osp-bench — ручной триггер
pattern OSPBenchSlot() -> String {
  let _ = OSPBenchEnsureSchema()
  let rnd = query("SELECT due_date FROM osp_bench_rounds ORDER BY due_date DESC LIMIT 1", [])
  if length(rnd) == 0.0 then { return "BENCH|засеянных раундов нет — начните с /cron/osp-bench-ingest?due=ГГГГ-ММ-ДД" }
  let due = to_string(json_get(get(rnd, 0.0), "due_date", ""))
  let run = OSPBenchRunRound(due)
  let res = OSPBenchResolve(due)
  return "BENCH|раунд " + due + "\n" + run + "\n" + res
}

// ── Фикстуры W3: сырой SQL только в паттерне (гвард №312) ──

pattern OSPW3SeedRound(due: String, nrows: Float) -> String {
  let _ = OSPBenchEnsureSchema()
  let _ = db_execute("INSERT INTO osp_bench_rounds (due_date, question_set, n_questions, n_market, n_dataset, n_blocked, n_rows, license, ingested_at) VALUES (?, 'fixture', 0, 0, 0, 0, ?, 'CC BY-SA 4.0 · forecastingresearch/forecastbench-datasets', datetime('now'))", [due, to_string(nrows)])
  return "ok"
}

pattern OSPW3SeedQuestion(due: String, qid: String, source: String, question: String, freeze: String, freeze_value: String, res_dates: String) -> String {
  let _ = OSPBenchEnsureSchema()
  let hz = OSPBenchHorizons(res_dates)
  let nhz = 1.0
  if hz != "" then { let nhz = length(split(hz, ";")) }
  let crowd = OSPBenchCrowd(source, freeze_value)
  // res_dates приходит в исходной форме: массив JSON или строка N/A
  let mut rd = "\"N/A\""
  if starts_with(res_dates, "[") then { rd = res_dates }
  let _ = db_execute("INSERT INTO osp_bench_questions (qid, due_date, source, question, freeze_datetime, crowd_p, horizons, model_payload) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", [qid, due, source, question, freeze, to_string(crowd), to_string(nhz), OSPBenchBuildPayload("{\"id\": \"" + qid + "\", \"source\": \"" + source + "\", \"question\": \"" + question + "\", \"resolution_criteria\": \"Критерий наблюдаемый: официальная публикация итогового значения по адресу\", \"freeze_datetime\": \"" + freeze + "\", \"freeze_datetime_value\": \"" + freeze_value + "\", \"resolution_dates\": " + rd + "}")])
  return "ok"
}

pattern OSPW3SeedBenchRow(qid: String, res_date: String, p: Float, config: String) -> String {
  let _ = OSPBenchEnsureSchema()
  let bench_qid = qid + "|" + res_date
  let _ = db_execute("INSERT INTO osp_forecast (kind, question, status, p_raw, p_ensemble, p_final, kent_label, cal_bucket, bench_qid, resolution_date, resolve_by, gate_report, models_json, created_at) VALUES ('bench', ?, 'watching', ?, ?, ?, 'примерно равные шансы (35-65%)', 5, ?, ?, ?, '{\"g1\":\"PASS\"}', ?, datetime('now'))", ["fixture-вопрос " + bench_qid, to_string(p), to_string(p), to_string(p), bench_qid, res_date, res_date, "{\"config\":\"" + config + "\"}"])
  return "ok"
}

pattern OSPW3Setting(key: String, value: String) -> String {
  let _ = OSPBenchEnsureSchema()
  let ex = query("SELECT key FROM system_settings WHERE key = ?", [key])
  if length(ex) == 0.0 then {
    let _ = db_execute("INSERT INTO system_settings (key, value) VALUES (?, ?)", [key, value])
  } else {
    let _ = db_execute("UPDATE system_settings SET value = ? WHERE key = ?", [value, key])
  }
  return "ok"
}



