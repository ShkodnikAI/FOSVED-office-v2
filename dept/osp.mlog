test "n625 fmt3: три знака, минус, артефакты сложения" {
  assert_eq(OSPFmt3(0.1 + 0.2), "0.300")
  assert_eq(OSPFmt3(0.0 - 0.6399999), "-0.640")
  assert_eq(OSPFmt3(1.0), "1.000")
  assert_eq(OSPFmt3(0.02), "0.020")
}

test "n625 brier: (0.7−1)² = 0.090; монетка 0.5 даёт 0.250 в обе стороны" {
  // MUT-мишень: OSPBrier → abs(p−y) — здесь красное: abs даёт 0.300
  assert_eq(OSPFmt3(OSPBrier(0.7, 1.0)), "0.090")
  // MUT-мишень: константа 0.25 — здесь красное
  assert_eq(OSPFmt3(OSPBrier(0.5, 1.0)), "0.250")
  assert_eq(OSPFmt3(OSPBrier(0.5, 0.0)), "0.250")
  assert_eq(OSPFmt3(OSPBrier(0.7, 0.0)), "0.490")
}

test "n625 logloss: монетка 0.693; клип крайней вероятности 9.210" {
  assert_eq(OSPFmt3(OSPLogLoss(0.5, 1.0)), "0.693")
  assert_eq(OSPFmt3(OSPLogLoss(0.99999, 0.0)), "9.210")
}

test "n625 skill: 1 − 0.15/0.25 = 0.400" {
  assert_eq(OSPFmt3(OSPSkillScore(0.15, 0.25)), "0.400")
}

test "n625 parseRun: валидный JSON, мусор и p вне диапазона" {
  assert_eq(OSPParseRun("{\"p\":0.42,\"base_rate_hint\":\"\",\"why\":\"ряд FRED\"}"), "PASS|0.42")
  assert_contains(OSPParseRun("мусор без json"), "FAIL|")
  assert_contains(OSPParseRun("{\"p\":1.5,\"why\":\"x\"}"), "FAIL|p вне")
}

test "n625 aggregate: mean 0.2, median 0.2, logit-pool 0.186, spread 0.082" {
  let a = OSPAggregate("0.1;0.2;0.3")
  assert_contains(a, "OK|")
  let pp = split(a, "|")
  assert_eq(OSPFmt3(to_float(to_string(get(pp, 1.0)))), "0.200")
  assert_eq(OSPFmt3(to_float(to_string(get(pp, 2.0)))), "0.200")
  assert_eq(OSPFmt3(to_float(to_string(get(pp, 3.0)))), "0.186")
  assert_eq(OSPFmt3(to_float(to_string(get(pp, 4.0)))), "0.082")
  assert_eq(to_float(to_string(get(pp, 5.0))), 3.0)
}

test "n625 aggregate: чётное n — median 0.5 по двум середкам; один прогон; пусто" {
  let a = OSPAggregate("0.8;0.1;0.9;0.2")
  let pp = split(a, "|")
  assert_eq(OSPFmt3(to_float(to_string(get(pp, 2.0)))), "0.500")
  let b = OSPAggregate("0.7")
  assert_contains(b, "OK|0.7|0.7|")
  assert_contains(OSPAggregate(""), "FAIL|")
}

test "n625 crowd: OK, W3, G6-блок без обоснования, W6 с обоснованием, SKIP" {
  assert_eq(OSPCrowdCompare(0.50, 0.45, ""), "OK")
  assert_contains(OSPCrowdCompare(0.50, 0.25, ""), "W3|")
  // MUT-мишень наряда: убрать market_dissent_reason при расхождении 0.4 —
  // публикация блокируется
  assert_contains(OSPCrowdCompare(0.50, 0.10, ""), "G6BLOCK|")
  assert_contains(OSPCrowdCompare(0.50, 0.10, "ряд FRED DFF за октябрь снизился до 3.9%"), "W6|")
  assert_contains(OSPCrowdCompare(0.50, -1.0, ""), "SKIP|")
}

test "n625 dissent: короткое и бесцифровое — нет; с числом или URL — да" {
  assert_eq(OSPDissentOK("коротко"), false)
  assert_eq(OSPDissentOK("рынок явно ошибается, ждите разворота обратно"), false)
  assert_eq(OSPDissentOK("ряд FRED DFF за октябрь снизился до 3.9%"), true)
  assert_eq(OSPDissentOK("см. https://fred.stlouisfed.org/series/DFF"), true)
}

test "n625 parseOutcome: да, НЕТ, дробное, проценты, отказ" {
  assert_eq(OSPParseOutcome("да"), "OK|1.0")
  assert_eq(OSPParseOutcome("НЕТ"), "OK|0.0")
  assert_eq(OSPParseOutcome("0.5"), "OK|0.5")
  assert_eq(OSPParseOutcome("60%"), "OK|0.6")
  assert_contains(OSPParseOutcome("может быть"), "FAIL|")
}

