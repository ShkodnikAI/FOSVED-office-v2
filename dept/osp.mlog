test "n469 разбор: OSPParseChangeRange — нормализованные пары" {
  assert_eq(OSPParseChangeRange("+10…+25%"), "10|25")
  assert_eq(OSPParseChangeRange("−10…−25%"), "-25|-10")
  assert_eq(OSPParseChangeRange("±10%"), "-10|10")
  assert_eq(OSPParseChangeRange("+30% и выше"), "30|30")
  assert_eq(OSPParseChangeRange("−25% и ниже"), "-25|-25")
  assert_eq(OSPParseChangeRange("Рост +10…+25%"), "")
}

test "n469 разбор: OSPStrIsNumber — фильтр формата числа" {
  assert_eq(OSPStrIsNumber("65"), true)
  assert_eq(OSPStrIsNumber("12.5"), true)
  assert_eq(OSPStrIsNumber("-25"), true)
  assert_eq(OSPStrIsNumber("−10.5"), true)
  assert_eq(OSPStrIsNumber(""), false)
  assert_eq(OSPStrIsNumber("abc"), false)
  assert_eq(OSPStrIsNumber("12x"), false)
  assert_eq(OSPStrIsNumber("1.2.3"), false)
  assert_eq(OSPStrIsNumber("1-2"), false)
}

test "n468 подвал: FRED с полученным рядом — источник показан" {
  let ctx = "=== News ===\nзаголовок новости\n\n=== FRED (макроданные) ===\nDGS10: {\"ok\":true,\"value\":\"4.28\"}\nFEDFUNDS: недоступно (FRED_API_KEY не установлен)\n\n=== Corrections ===\n-"
  let footer = OSPSourcesFooter(ctx)
  assert_contains(footer, "· FRED (макроданные: доходность облигаций, ставка ФРС, инфляция)")
}

test "n468 подвал: FRED все ряды отказали — точная причина вместо источника" {
  let ctx = "=== News ===\nзаголовок новости\n\n=== FRED (макроданные) ===\nDGS10: недоступно (FRED_API_KEY не установлен)\nFEDFUNDS: недоступно (FRED_API_KEY не установлен)\nCPIAUCSL: недоступно (FRED_API_KEY не установлен)\n\n=== Corrections ===\n-"
  let footer = OSPSourcesFooter(ctx)
  assert_contains(footer, "FRED недоступен: FRED_API_KEY не установлен")
  if contains(footer, "· FRED (макроданные") then { error("источник не должен показываться при нулевых данных") }
}

test "n468 подвал: FRED отказ без скобки-причины — общая честная строка" {
  let ctx = "=== News ===\nзаголовок новости\n\n=== FRED (макроданные) ===\nDGS10: недоступно\n\n=== Corrections ===\n-"
  let footer = OSPSourcesFooter(ctx)
  assert_contains(footer, "FRED недоступен (данные не получены)")
  if contains(footer, "· FRED (макроданные") then { error("источник не должен показываться при нулевых данных") }
}

test "n468 подвал: нет FRED-блока — нет FRED-строки, news остаётся" {
  let footer = OSPSourcesFooter("=== News ===\nзаголовок новости про индикатор FRED\n\n=== Corrections ===\n-")
  if contains(footer, "FRED") then { error("FRED-строка не должна появляться без FRED-блока") }
  assert_contains(footer, "Новостной поиск (RSS)")
}

