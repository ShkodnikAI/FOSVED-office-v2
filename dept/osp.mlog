test "n627 Platt нехватка: 10 строк — честный REJECTED, идентичность побитово" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      if OSPW2SeedIfEmpty("n627few") == "empty" then {
        let _ = OSPW27SeedCal("n627few", 0.9, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627few", 0.1, 0.0, 39.0, "")
        let _ = OSPW27SeedCal("n627few", 0.9, 1.0, 38.0, "")
        let _ = OSPW27SeedCal("n627few", 0.1, 0.0, 37.0, "")
        let _ = OSPW27SeedCal("n627few", 0.9, 1.0, 36.0, "")
        let _ = OSPW27SeedCal("n627few", 0.1, 0.0, 35.0, "")
        let _ = OSPW27SeedCal("n627few", 0.9, 1.0, 34.0, "")
        let _ = OSPW27SeedCal("n627few", 0.1, 0.0, 33.0, "")
        let _ = OSPW27SeedCal("n627few", 0.9, 1.0, 32.0, "")
        let _ = OSPW27SeedCal("n627few", 0.1, 0.0, 31.0, "")
      }
      // указание владельца (#627): при нехватке данных калибровка честно REJECTED
      let r = OSPPlattFit("n627few")
      assert_contains(r, "REJECTED")
      assert_contains(r, "недостаточно данных")
      assert_contains(r, "holdout_n=10 train_n=0")
      let ca = query("SELECT value FROM system_settings WHERE key = 'osp_cal_a'", [])
      let cb = query("SELECT value FROM system_settings WHERE key = 'osp_cal_b'", [])
      assert_eq(to_string(json_get(get(ca, 0.0), "value", "?")), "1.0")
      assert_eq(to_string(json_get(get(cb, 0.0), "value", "?")), "0.0")
      // идентичность ПОБИТОВО: p_final = clip(p_ensemble)
      assert_eq(OSPPlattApply(0.77), 0.77)
  }}

test "n627 Platt поправка 3: unfit-config строки не идут в выборку" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      if OSPW2SeedIfEmpty("n627unfit") == "empty" then {
        // 10 строк, все с пометкой непригодности конфигурации
        let _ = OSPW27SeedCal("n627unfit", 0.9, 1.0, 40.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.1, 0.0, 39.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.9, 1.0, 38.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.1, 0.0, 37.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.9, 1.0, 36.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.1, 0.0, 35.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.9, 1.0, 34.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.1, 0.0, 33.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.9, 1.0, 32.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
        let _ = OSPW27SeedCal("n627unfit", 0.1, 0.0, 31.0, "{\"g1\":\"PASS\",\"calibration\":\"unfit-config\"}")
      }
      // unfit-строки не считаются: holdout_n=0 train_n=0 — не 10
      let r = OSPPlattFit("n627unfit")
      assert_contains(r, "holdout_n=0 train_n=0")
  }}

test "n627 сжатие поправки 1: нехватка — REJECTED, apply идентичен" {
  let dbp = try query("SELECT 1 AS one", [])
  if to_string(dbp) == "()" then { print("SKIP: БД недоступна в изолированном прогоне") } else {
      let _ = kv_set("osp_ensemble_models", "off")
      if OSPW2SeedIfEmpty("n627prior") == "empty" then {
        let _ = OSPW27SeedPrior("n627prior", 0.45, 1.0, 0.5, 20.0, 40.0)
        let _ = OSPW27SeedPrior("n627prior", 0.55, 0.0, 0.5, 20.0, 39.0)
        let _ = OSPW27SeedPrior("n627prior", 0.45, 1.0, 0.5, 20.0, 38.0)
        let _ = OSPW27SeedPrior("n627prior", 0.55, 0.0, 0.5, 20.0, 37.0)
        let _ = OSPW27SeedPrior("n627prior", 0.45, 1.0, 0.5, 20.0, 36.0)
      }
      let r = OSPPriorFit("n627prior")
      assert_contains(r, "REJECTED")
      assert_contains(r, "сжатие выключено")
      assert_contains(r, "holdout_n=5 train_n=0")
      // идентичность побитово при выключенном сжатии
      assert_eq(OSPPriorApply(999999.0, 0.6), 0.6)
  }}

