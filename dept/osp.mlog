// DISCLOSURE — mandatory top disclaimer
// ═══════════════════════════════════════════════════════════════════════
db { url: env("DATABASE_URL") }
pattern OSPDisclaimer() -> String {
  return "⚠️ ОСП: Аналитическая оценка для информирования решений владельца. Не является инвестиционной рекомендацией. Все вероятности по шкале Шермана Кента. Прогнозы подлежат обязательной верификации."
}
pattern OSPDisclaimerBottom() -> String {
  return "---\n⚠️ Верификация: каждый прогноз должен быть сверен по наступлении даты проверки. Brier score обновляется автоматически. /osp verify <id>"
}

// ═══════════════════════════════════════════════════════════════════════
// PROJECT PARAMETERS V4.0
// ═══════════════════════════════════════════════════════════════════════
pattern OSPSkillBudget(depth: Int) -> Float {
  // #623 (решение владельца 03.11 — «экономия не цель»): бюджет растёт под
  // уровень нарезки: depth 0 → L2 (замер 20 656 на 11 ядрах Tier-1),
  // depth 1 → L3 (32 759), depth 2–4 → L4 (83 146) + приложения домена
  // (financial ≈ 17,4 тыс. L4). Замер: probe_d3_ladder, 05.11.
  if depth == 0 then { return 26000.0 }
  if depth == 1 then { return 42000.0 }
  return 120000.0
}

// ═══════════════════════════════════════════════════════════════════════
// SHERMAN KENT VERBAL-TO-NUMERIC SCALE
// ═══════════════════════════════════════════════════════════════════════
pattern OSPShermanKent(label: String) -> String {
  let l = lower(label)
  if l == "almost certainly not" then { return "0.02 [0-5%]" }
  if l == "very unlikely" then { return "0.12 [5-20%]" }
  if l == "unlikely" then { return "0.27 [20-35%]" }
  if l == "roughly even chance" then { return "0.50 [35-65%]" }
  if l == "likely" then { return "0.72 [65-80%]" }
  if l == "very likely" then { return "0.87 [80-95%]" }
  if l == "almost certain" then { return "0.97 [95-100%]" }
  if l == "почти наверняка нет" then { return "0.02 [0-5%]" }
  if l == "очень маловероятно" then { return "0.12 [5-20%]" }
  if l == "маловероятно" then { return "0.27 [20-35%]" }
  if l == "примерно равные шансы" then { return "0.50 [35-65%]" }
  if l == "вероятно" then { return "0.72 [65-80%]" }
  if l == "очень вероятно" then { return "0.87 [80-95%]" }
  if l == "почти наверняка" then { return "0.97 [95-100%]" }
  return "UNMAPPED — use only Kent-approved terms"
}
pattern OSPValidateProbability(text: String) -> String {
  let t = lower(text)
  if contains(t, "likely") or contains(t, "unlikely") or contains(t, "certain") or contains(t, "вероятно") or contains(t, "наверняка") or contains(t, "маловероятно") or contains(t, "%") then { return "PASS" }
  return "FAIL: uncalibrated probability"
}

// ── Сценарный гейт качества (наряд #469) ────────────────────────────────
// Вероятности сценариев ИЗМЕНЕНИЯ ОДНОЙ ВЕЛИЧИНЫ (цена, курс, индекс) —
// взаимоисключающие исходы: они обязаны образовывать исчерпывающее
// непересекающееся покрытие и в сумме давать 100% (±2%). Реальный
// инцидент: отчёт OSP-2026-10-03-GOLD-01 — сумма середин ≈172%, отчёт
// «норма» — это не норма, Brier по таким вероятностям не определён.
//
// Формат строки сценария в таблице (library/osp.md §«Сценарии одной
// величины»): | Метка | Диапазон изменения: +10…+25% / ±10% / +30% и выше | P=65% или P=55–70% |
// Гейт проверяет:
//   1) разметка P=<число>% в каждой строке сценария (без неё — FAIL);
//   2) узкость вероятностного диапазона ≤15 п.п.;
//   3) сумма середин 98–102%;
//   4) попарное непересечение диапазонов изменения (где парсятся).
// Диапазоны «X% и выше/ниже» — точкой отсечения (консервативно).
// Чистая функция (env/db не читает) — реальные кейсы в test-блоках
// внизу файла, исполняются CI/pytest через bin/mlog test dept/osp.mlog.

// Проверка формата числа (только цифры, максимум одна точка, ведущий минус).
// Самодостаточна (не зовёт utils-TryVal — test-блоки исполняются изолированно
// через bin/mlog test). to_float на мусоре молча отдаёт 0.0, поэтому явный
// фильтр обязателен перед каждым числовым разбором гейта.
pattern OSPStrIsNumber(s: String) -> Bool {
  let t = trim(s)
  if length(t) == 0.0 then { return false }
  let mut body = t
  if starts_with(t, "-") or starts_with(t, "−") then { let body = substring(t, 1.0, length(t)) }
  if length(body) == 0.0 then { return false }
  let n_dots = length(body) - length(replace(body, ".", ""))
  if n_dots > 1.0 then { return false }
  let mut c = replace(body, ".", "")
  let c = replace(c, "0", "")
  let c = replace(c, "1", "")
  let c = replace(c, "2", "")
  let c = replace(c, "3", "")
  let c = replace(c, "4", "")
  let c = replace(c, "5", "")
  let c = replace(c, "6", "")
  let c = replace(c, "7", "")
  let c = replace(c, "8", "")
  let c = replace(c, "9", "")
  return c == ""
}

pattern OSPScenarioGateCheck(output: String) -> String {
  let lines = split(output, "\n")
  let mut p_mids = ""    // середины вероятностей, CSV через ";"
  let mut ch_ranges = "" // диапазоны изменения "lo|hi|n;" — для парной проверки
  let mut rows = 0.0
  each line in lines {
    if contains(line, "|") and contains(line, "P=") then {
      let pstart = index_of(line, "P=") + 2.0
      let after_p = substring(line, pstart, length(line))
      let pend = index_of(after_p, "%")
      if pend < 0.0 then { return "FAIL: вероятность сценария без % после P= (формат P=65%)" }
      let p_str = trim(substring(after_p, 0.0, pend))
      let p_norm = replace(replace(replace(p_str, "–", "-"), "—", "-"), "−", "-")
      let mut lo = 0.0
      let mut hi = 0.0
      if contains(p_norm, "-") then {
        let parts = split(p_norm, "-")
        if length(parts) != 2.0 then { return "FAIL: неверный формат вероятности P=" + p_str }
        if OSPStrIsNumber(get(parts, 0.0)) == false or OSPStrIsNumber(get(parts, 1.0)) == false then { return "FAIL: неверный формат вероятности P=" + p_str }
        let lo = to_float(get(parts, 0.0))
        let hi = to_float(get(parts, 1.0))
        if hi - lo > 15.0 then { return "FAIL: диапазон вероятности не узкий (>15 п.п.): P=" + p_str }
      } else {
        if OSPStrIsNumber(p_norm) == false then { return "FAIL: неверный формат вероятности P=" + p_str }
        let lo = to_float(p_norm)
        let hi = to_float(p_norm)
      }
      let p_mids = p_mids + to_string((lo + hi) / 2.0) + ";"
      let rows = rows + 1.0
      // диапазон изменения — колонка таблицы перед колонкой с P=
      let cols = split(line, "|")
      let mut p_col = -1.0
      let mut ci = 0.0
      each c in cols {
        if contains(c, "P=") then { let p_col = ci }
        let ci = ci + 1.0
      }
      if p_col >= 1.0 then {
        let parsed = OSPParseChangeRange(trim(get(cols, p_col - 1.0)))
        if parsed != "" then {
          let pc = split(parsed, "|")
          let ch_ranges = ch_ranges + get(pc, 0.0) + "|" + get(pc, 1.0) + "|" + to_string(rows) + ";"
        }
      }
    }
  }
  if rows < 2.0 then { return "PASS" }
  let mut sum = 0.0
  each m in split(p_mids, ";") {
    if trim(m) != "" then { let sum = sum + to_float(trim(m)) }
  }
  if sum < 98.0 or sum > 102.0 then {
    return "FAIL: сумма вероятностей сценариев " + to_string(sum) + "% вне 98–102% — сценарии одной величины взаимоисключающие, распределение не согласовано"
  }
  // попарное непересечение диапазонов изменения (n — уникальный номер строки)
  let all = split(ch_ranges, ";")
  each a in all {
    if trim(a) != "" then {
      let pa = split(a, "|")
      let alo = to_float(get(pa, 0.0))
      let ahi = to_float(get(pa, 1.0))
      let an = get(pa, 2.0)
      each b in all {
        if trim(b) != "" then {
          let pb = split(b, "|")
          if get(pb, 2.0) != an then {
            let blo = to_float(get(pb, 0.0))
            let bhi = to_float(get(pb, 1.0))
            if alo < bhi and blo < ahi then {
              return "FAIL: диапазоны изменения сценариев пересекаются: [" + to_string(alo) + ";" + to_string(ahi) + "] и [" + to_string(blo) + ";" + to_string(bhi) + "]"
            }
          }
        }
      }
    }
  }
  return "PASS"
}

// Разбор колонки «Диапазон изменения» в нормализованную пару "lo|hi".
// Формат методологии: +10…+25%, −10…−25%, ±10%, +30% и выше, −25% и ниже.
// Возвращает "" если колонка не распарсена — такие строки не участвуют
// в проверке пересечений (сумма вероятностей всё равно гейтится).
pattern OSPParseChangeRange(ch: String) -> String {
  let s = trim(ch)
  if s == "" then { return "" }
  let s2 = replace(replace(s, " и выше", ""), " и ниже", "")
  let s2 = replace(replace(replace(replace(s2, "%", ""), "…", "~"), "–", "~"), "—", "~")
  let s2 = replace(replace(s2, "−", "-"), "±", "-")
  if contains(s, "±") then {
    // ±X → [-X;+X]
    let v_str = trim(replace(replace(s2, "-", ""), "~", ""))
    if OSPStrIsNumber(v_str) == false then { return "" }
    let v = to_float(v_str)
    return to_string(-1.0 * v) + "|" + to_string(v)
  }
  let tokens = split(s2, "~")
  if OSPStrIsNumber(replace(trim(get(tokens, 0.0)), "+", "")) == false then { return "" }
  let lo = to_float(replace(trim(get(tokens, 0.0)), "+", ""))
  let mut hi = lo
  if length(tokens) >= 2.0 then {
    let hi_str = replace(trim(get(tokens, 1.0)), "+", "")
    if OSPStrIsNumber(hi_str) then { let hi = to_float(hi_str) }
  }
  if lo > hi then { return to_string(hi) + "|" + to_string(lo) }
  return to_string(lo) + "|" + to_string(hi)
}

// ═══════════════════════════════════════════════════════════════════════
// FORCES & POTENTIALS — native formula P = A × R × S × L × E × E_modifier
// ═══════════════════════════════════════════════════════════════════════
pattern OSPComputePotential(A: Float, R: Float, S: Float, L: Float, E: Float, E_modifier: Float) -> Float {
  return A * R * S * L * E * E_modifier
}

// ═══════════════════════════════════════════════════════════════════════
// BRIER SCORE — native computation
// ═══════════════════════════════════════════════════════════════════════
pattern OSPComputeBrier(forecast_prob: Float, actual_outcome: Float) -> Float {
  let diff = forecast_prob - actual_outcome
  return diff * diff
}

// ═══════════════════════════════════════════════════════════════════════
// LIFECYCLE STATE MACHINE
// ═══════════════════════════════════════════════════════════════════════
pattern OSPDraftAnalysis(topic: String, mode: String, domain: String, depth: Int) -> Int {
  let slug = lower(replace(topic, " ", "-"))
  let _ = db_execute("INSERT INTO analysis (topic, topic_slug, mode, status) VALUES (?, ?, ?, 'drafted')", [topic, slug, mode])
  let ids = query("SELECT id FROM analysis WHERE topic = ? ORDER BY created_at DESC LIMIT 1", [topic])
  if length(ids) > 0 then { return to_int(to_string(json_get(get(ids, 0), "id", "-1"))) }
  return -1
}

// ═══════════════════════════════════════════════════════════════════════
// PROGRAMMATIC QUALITY GATES (12 gates)
// ═══════════════════════════════════════════════════════════════════════
pattern OSPCheckQualityGates(output: String, depth: Int) -> String {
  let gates = "{"
  // Gate 1: awareness frame
  let g1 = "true"
  if contains(output, "AWARENESS") == false then { if contains(output, "ОСОЗНАНИЕ") == false then { if contains(output, "SUBJECT:") == false then { let g1 = "false" } } }
  let gates = gates + "\"g1_awareness\":" + g1
  // Gate 2: topology 5 levels
  let g2 = "true"
  if contains(output, "Leaves") == false then { if contains(output, "Листья") == false then { let g2 = "false" } }
  if contains(output, "Roots") == false then { if contains(output, "Корни") == false then { let g2 = "false" } }
  if contains(output, "Fruit") == false then { if contains(output, "Плод") == false then { let g2 = "false" } }
  let gates = gates + ",\"g2_topology\":" + g2
  // Gate 3: forces P=
  let g3 = "true"
  if contains(output, "P =") == false then { if contains(output, "FORCES") == false then { if contains(output, "СИЛЫ") == false then { let g3 = "false" } } }
  let gates = gates + ",\"g3_forces\":" + g3
  // Gate 4: two paths
  let g4 = "true"
  if depth >= 1 then { if contains(output, "Path A") == false then { if contains(output, "Путь А") == false then { let g4 = "false" } } }
  let gates = gates + ",\"g4_twoPaths\":" + g4
  // Gate 5: falsifiable indicators
  let g5 = "true"
  if contains(output, "Indicator") == false then { if contains(output, "Индикатор") == false then { let g5 = "false" } }
  let gates = gates + ",\"g5_indicators\":" + g5
  // Gate 6: Sherman Kent
  let g6 = "true"
  if OSPValidateProbability(output) != "PASS" then { let g6 = "false" }
  let gates = gates + ",\"g6_kentProb\":" + g6
  // Gate 7: confidence labels
  let g7 = "true"
  if contains(output, "ФАКТ") == false then { if contains(output, "FACT") == false then { let g7 = "false" } }
  let gates = gates + ",\"g7_confLabels\":" + g7
  // Gate 8: premortem (depth≥2)
  let g8 = "true"
  if depth >= 2 then { if contains(output, "Premortem") == false then { if contains(output, "премортем") == false then { let g8 = "false" } } }
  let gates = gates + ",\"g8_premortem\":" + g8
  // Gate 9: ACH hypotheses (depth≥2)
  let g9 = "true"
  if depth >= 2 then { if contains(output, "H1") == false then { if contains(output, "Гипотеза 1") == false then { let g9 = "false" } } }
  let gates = gates + ",\"g9_achHypo\":" + g9
  // Gate 10: spillover check
  let g10 = "true"
  let gates = gates + ",\"g10_spillover\":" + g10
  // Gate 11: compact summary
  let g11 = "true"
  let gates = gates + ",\"g11_compact\":" + g11
  // Gate 12: no uncalibrated probability
  let g12 = "true"
  if contains(output, "возможно") or contains(output, "может быть") then { let g12 = "false" }
  let gates = gates + ",\"g12_noUncalib\":" + g12
  let gates = gates + "}"
  return gates
}

// ── Final safety check ──
pattern OSPFinalSafetyCheck(output: String) -> String {
  let t = lower(output)
  if contains(t, "покупай") or contains(t, "buy now") or contains(t, "продавай") or contains(t, "sell now") or contains(t, "инвестируй в") or contains(t, "invest in") then {
    return "BLOCKED: direct investment advice detected"
  }
  return "PASS"
}

// ── Auto-escalation ──
pattern OSPAutoEscalate(topic: String, base_depth: Int) -> Int {
  let t = lower(topic)
  let depth = base_depth
  let iw_flag = kv_get("iw_active_" + substring(t, 0, 30))
  if to_string(iw_flag) != "()" and to_string(iw_flag) != "" then { let depth = depth + 1 }
  let owner_pri = kv_get("owner_priority_topics")
  if contains(to_string(owner_pri), substring(t, 0, 20)) then { let depth = depth + 1 }
  let miss_count = query("SELECT COUNT(*) as c FROM analysis WHERE topic LIKE ? AND status IN ('missed','partial')", ["%" + substring(t, 0, 30) + "%"])
  if length(miss_count) > 0 then {
    let mc = json_get(get(miss_count, 0), "c", "0")
    if to_float(to_string(mc)) >= 2.0 then { let depth = depth + 1 }
  }
  if contains(t, "критич") or contains(t, "existential") then { let depth = depth + 2 }
  if depth > 4 then { let depth = 4 }
  return depth
}


