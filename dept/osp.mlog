  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_wargame", "osp", "query: " + substring(query, 0, 100))
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN-SPECIFIC STRUCTURED SCANS
// ═══════════════════════════════════════════════════════════════════════

pattern OSPRegimeScan(query: String, chat_id: String) -> String {
  let context = BuildOSPContext(query, "monetary", chat_id)
  let prompt = context + "\n\nРЕЖИМ: ИДЕНТИФИКАЦИЯ МАКРО-РЕЖИМА\nСтруктура:\n1. Текущий режим: инфляционный рост / стагфляция / рецессия / дезинфляция\n2. Ключевые индикаторы: ВВП, инфляция, ставки, безработица, yield curve\n3. Действия ЦБ: что делают, что сигналят, что рынок ожидает\n4. Перекрёстные сигналы: bonds vs equities vs commodities vs FX\n5. Кантильон: первый получатель текущей политики, кто платит\n6. Нарратив vs реальность: что заявляют ЦБ vs что данные\n7. Сдвиг режима: индикаторы перехода в другой режим (I&W)\n8. Инвестиционные последствия каждого сценария\n\nЦифры, графики данных, конкретные источники."
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Macro regime: " + query}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_regime", "osp", "query: " + substring(query, 0, 100))
  return reply
}

pattern OSPCantillonScan(query: String, chat_id: String) -> String {
  let context = BuildOSPContext(query, "monetary", chat_id)
  let prompt = context + "\n\nРЕЖИМ: АНАЛИЗ КАНТИЛЬОНА\nСтруктура:\n1. Что создаёт новые деньги/ресурсы? (эмиссия, дефицит, кредит)\n2. Порядок получения: кто первый → кто последний\n3. Первый получатель: выгода (покупает по старым ценам)\n4. Последний получатель: платит инфляцию (покупает по новым ценам)\n5. Перекрёстные эффекты: как это влияет на активы, зарплаты, долги\n6. Кто выигрывает, кто проигрывает — конкретные группы/секторы\n7. Исторические аналоги этого распределения\n8. Стратегические последствия: как позиционироваться\n\nИмена, цифры, конкретика."
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Cantillon: " + query}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_cantillon", "osp", "query: " + substring(query, 0, 100))
  return reply
}

pattern OSPNarrativeScan(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = context + "\n\nРЕЖИМ: НАРРАТИВ vs ПОТОКИ\nСтруктура:\n1. Нарратив: что заявляют официально (правительство, ЦБ, корпорации, СМИ)\n2. Реальные потоки: куда идут деньги, люди, ресурсы, информация\n3. Расхождения: где нарратив и потоки противоречат друг другу\n4. Почему расхождение: намеренная дезинформация / самообман / лаг данных\n5. Сигнал: расхождение = самый сильный сигнал в анализе\n6. Прогноз по нарративу vs прогноз по потокам\n7. Какой прогноз правильнее (и почему)\n8. Действия на основе реальных потоков\n\nКонкретные заявления + конкретные цифры потоков."
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Narrative vs flows: " + query}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_narrative", "osp", "query: " + substring(query, 0, 100))
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// VERIFICATION & CALIBRATION
// ═══════════════════════════════════════════════════════════════════════

pattern OSPVerify(query: String, chat_id: String) -> String {
  // query = analysis ID or topic
  let rows = query("SELECT id, topic, confidence, verification_date, created_at FROM analysis WHERE status = 'drafted' AND topic LIKE ? ORDER BY created_at DESC LIMIT 5", ["%" + query + "%"])
  if len(rows) == 0.0 then {
    return "Нет найденных анализов для верификации по запросу: " + query + "\nИспользуйте /archive osp чтобы посмотреть архив."
  }
  let context = BuildOSPContext(query, "general", chat_id)
  let prompt = context + "\n\nРЕЖИМ: ВЕРИФИКАЦИЯ ПРОГНОЗА\nНайди прошлый анализ по этой теме в архиве.\nСравни прогноз с реальностью:\n1. Что предсказали (вероятности, индикаторы, сроки)\n2. Что произошло на самом деле\n3. MAPE (mean absolute percentage error) если есть численные прогнозы\n4. Систематическая ошибка: завышение/занижение вероятностей\n5. Что сработало в анализе\n6. Что не сработало и почему\n7. Corrigendum: что нужно исправить в методологии\n8. Brier score для калибровки"
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Верифицируй: " + query}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_verify", "osp", "query: " + substring(query, 0, 100))
  return reply
}

pattern OSPCalibrationScore(chat_id: String) -> String {
  // Count verified vs unverified analyses
  let total = query("SELECT COUNT(*) as c FROM analysis", [])
  let verified = query("SELECT COUNT(*) as c FROM analysis WHERE status = 'verified'", [])
  let t_count = get(get(total, 0.0), "c")
  let v_count = get(get(verified, 0.0), "c")
  let context = BuildOSPContext("калибровка Brier score", "general", chat_id)
  let prompt = context + "\n\nРЕЖИМ: КАЛИБРОВОЧНЫЙ СКОР\nВсего анализов: " + to_string(t_count) + "\nВерифицировано: " + to_string(v_count) + "\n\nСтруктура:\n1. Количество верифицированных прогнозов\n2. Brier score: средний (forecast - outcome)^2 по всем прогнозам\n3. Calibration curve: predicted probability vs actual frequency\n4. Систематические смещения: завышение/занижение confidence\n5. Рекомендации по улучшению калибровки\n\nЕсли данных мало — так и скажи. Не выдумывай цифры."
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Покажи калибровочный скор ОСП"}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_score", "osp", "calibration check")
  return reply
}

pattern OSPRecalibrate(chat_id: String) -> String {
  let context = BuildOSPContext("рекалибровка методологии", "general", chat_id)
  let prompt = context + "\n\nРЕЖИМ: РЕКАЛИБРОВКА\nЕжемесячный пересмотр методологии ОСП:\n1. Какие ошибки повторяются\n2. Какие навыки недоиспользуются\n3. Где калибровка系统性 смещена\n4. Какие домены требуют обновления KB\n5. 3 конкретных изменения для следующего месяца\n\nОпиши конкретно. Не общими словами."
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Рекалибровка ОСП"}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_recalibrate", "osp", "monthly review")
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// RED TEAM & ASYMMETRIC BETS
// ═══════════════════════════════════════════════════════════════════════

pattern OSPRedteam(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = context + "\n\nРЕЖИМ: RED TEAM\nВстречный анализ. Твоя задача — найти слабые места в доминирующем нарративе:\n1. Сформулируй доминирующий тезис\n2. Найди 5 аргументов ПРОТИВ (даже если ты лично с ними не согласен)\n3. Для каждого: насколько он вероятен, что бы это значило если он прав\n4. Асимметрия: если прав доминирующий тезис — выигрыш X, если прав контраргумент — потеря Y\n5. Рекомендация: учитывать контраргумент или нет, и как захеджировать\n\nБудь жёстким. Красная команда не соглашается — она ищет дыры."
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Red team: " + query}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_redteam", "osp", "query: " + substring(query, 0, 100))
  return reply
}

pattern OSPRegisterBet(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = context + "\n\nРЕЖИМ: АСИММЕТРИЧНАЯ СТАВКА\nСтруктурируй тезис как асимметричную ставку:\n1. Тезис (что ты считаешь верным)\n2. Верхняя граница убытка (bounded downside): максимум сколько можно потерять\n3. Потенциальный выигрыш (upside): насколько большим может быть выигрыш\n4. Соотношение upside/downside\n5. Условия при которых тезис неверен (выход из ставки)\n6. Временной горизонт: когда проверить\n7. Механизм исполнения: как именно реализовать эту позицию\n\nБез абстракции — конкретные цифры и инструменты."
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Ставка: " + query}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_bet", "osp", "query: " + substring(query, 0, 100))
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// I&W WATCHLIST
// ═══════════════════════════════════════════════════════════════════════

pattern OSPWatch(query: String, chat_id: String) -> String {
  // Register an indicator to watch
  let _ = db_execute("INSERT INTO lz_monitors (query, sources, frequency, last_scan) VALUES (?, 'osp-iw', 'daily', '')", [query])
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = context + "\n\nРЕЖИМ: I&W WATCHLIST — ДОБАВИТЬ ИНДИКАТОР\nДля указанного сценария/риска определи:\n1. Индикаторы на 30 дней (ранний сигнал)\n2. Индикаторы на 60 дней\n3. Индикаторы на 90 дней\n4. Индикаторы на 180 дней\n5. Индикаторы на 365 дней\n6. Порог срабатывания: при каком значении индикатор считается активированным\n7. Действие при активации: что делать\n\nФормат: каждый индикатор — конкретный, измеримый, с источником данных."
  let messages = json_encode([{role: "system", content: prompt}, {role: "user", content: "Watch: " + query}])
  let proxy_result = CallLLMProxy("osp", messages)
  if to_string(proxy_result) == "()" then { return "Сервис временно недоступен." }
  let reply = json_get(parse_json(proxy_result), "reply", "Error")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_watch", "osp", "query: " + substring(query, 0, 100))
  return reply
}

pattern OSPUnwatch(query: String, chat_id: String) -> String {
  let _ = db_execute("DELETE FROM lz_monitors WHERE query = ? AND sources = 'osp-iw'", [query])
  let _ = AuditLog("osp_unwatch", "osp", "removed: " + substring(query, 0, 100))
  return "Индикатор удалён из I&W watchlist: " + query
}

// ═══════════════════════════════════════════════════════════════════════
// TAVILY & TELEGRAM SEARCH (same pattern as LZ)
// ═══════════════════════════════════════════════════════════════════════

pattern OSPTavilySearch(query: String, chat_id: String) -> String {
  let body = json_encode({query: query, dept: "osp", chat_id: chat_id})
  let result = try http_post("http://127.0.0.1:4000/lz/tavily", body, "application/json")
  if to_string(result) == "()" then { return "Tavily недоступен. Установите TAVILY_API_KEY." }
  let reply = json_get(parse_json(result), "response", "Tavily search failed.")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_tavily", "osp", "query: " + substring(query, 0, 100))
  return reply
}

pattern OSPTelegramSearch(query: String, chat_id: String) -> String {
  let body = json_encode({query: query, dept: "osp", chat_id: chat_id})
  let result = try http_post("http://127.0.0.1:4000/lz/telegram", body, "application/json")
  if to_string(result) == "()" then { return "Telegram search недоступен." }
  let reply = json_get(parse_json(result), "response", "Telegram search failed.")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_tg", "osp", "query: " + substring(query, 0, 100))
  return reply
}
