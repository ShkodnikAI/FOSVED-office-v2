// ═══════════════════════════════════════════════════════════════════════
// VERIFICATION & CALIBRATION
// ═══════════════════════════════════════════════════════════════════════
pattern OSPVerify(query: String, chat_id: String) -> String {
  let rows = query("SELECT id, topic, confidence FROM analysis WHERE status IN ('watching','published') AND topic LIKE ? LIMIT 5", ["%" + query + "%"])
  if length(rows) == 0 then { return "Нет анализов для верификации: " + query }
  let context = BuildOSPContext(query, "general", chat_id)
  let prompt = context + "\n\nВЕРИФИКАЦИЯ: предсказали→произошло→Brier→систематическая ошибка→corrigendum."
  let llm_result = try call_llm(prompt, "Верифицируй: " + query)
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_verify", "osp", "")
  return reply
}

pattern OSPCalibrationScore(chat_id: String) -> String {
  let total = query("SELECT COUNT(*) as c FROM analysis", [])
  let verified = query("SELECT COUNT(*) as c FROM analysis WHERE status = 'verified'", [])
  let t_count = to_string(get(get(total, 0), "c"))
  let v_count = to_string(get(get(verified, 0), "c"))
  let brier_rows = query("SELECT AVG(brier_total) as avg_brier FROM analysis_verifications", [])
  let avg_brier = "N/A"
  if length(brier_rows) > 0 then { let avg_brier = to_string(get(get(brier_rows, 0), "avg_brier")) }
  let context = BuildOSPContext("калибровка", "general", chat_id)
  let prompt = context + "\n\nКАЛИБРОВКА. Всего: " + t_count + " Верифицировано: " + v_count + " Avg Brier: " + avg_brier + " Цели: Y1≤0.25 Y2≤0.20 Y3≤0.18"
  let llm_result = try call_llm(prompt, "Калибровочный скор ОСП")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_score", "osp", "total=" + t_count + " verified=" + v_count + " brier=" + avg_brier)
  return reply
}

pattern OSPRecalibrate(chat_id: String) -> String {
  let context = BuildOSPContext("рекалибровка", "general", chat_id)
  let prompt = context + "\n\nРЕКАЛИБРОВКА: повторяющиеся ошибки→недоиспользуемые навыки→калибровочные смещения→3 конкретных изменения."
  let llm_result = try call_llm(prompt, "Рекалибровка ОСП")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = db_execute("INSERT INTO monthly_reviews (year_month, improvements) VALUES (to_char(NOW(), 'YYYY-MM'), ?)", [substring(reply, 0, 2000)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_recalibrate", "osp", "")
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// RED TEAM & BETS
// ═══════════════════════════════════════════════════════════════════════
pattern OSPRedteam(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
