  let llm_result = try call_llm(prompt, "Red team: " + query)
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result) + "\n\n" + OSPDisclaimerBottom()
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_redteam", "osp", "")
  return reply
}

pattern OSPRegisterBet(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nАСИММЕТРИЧНАЯ СТАВКА: тезис→bounded downside→upside→ratio≥3:1→EV→условия выхода→горизонт→исполнение."
  let llm_result = try call_llm(prompt, "Ставка: " + query)
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  let reply = reply + "\n\n" + OSPDisclaimerBottom()
  let _ = db_execute("INSERT INTO asymmetric_bets (thesis, status) VALUES (?, 'identified')", [substring(query, 0, 500)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_bet", "osp", "")
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// I&W WATCHLIST
// ═══════════════════════════════════════════════════════════════════════
pattern OSPWatch(query: String, chat_id: String) -> String {
  let _ = db_execute("INSERT INTO watchlist_scenarios (scenario_label, description, status) VALUES (?, ?, 'pending')", [substring(query, 0, 100), query])
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = context + "\n\nI&W: индикаторы 30/60/90/180/365 дней, пороги, действие при активации."
  let llm_result = try call_llm(prompt, "Watch: " + query)
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_watch", "osp", "")
  return reply
}
pattern OSPUnwatch(query: String, chat_id: String) -> String {
  let _ = db_execute("DELETE FROM watchlist_scenarios WHERE scenario_label = ?", [substring(query, 0, 100)])
  let _ = AuditLog("osp_unwatch", "osp", "removed")
  return "Удалено из watchlist: " + query
}
pattern OSPAlertEscalation(scenario_id: Int, level: String) -> String {
  if level == "red" then {
    let _ = AuditLog("osp_alert_red", "osp", "IMMEDIATE id=" + to_string(scenario_id))
    return "RED ALERT: immediate notification"
  }
  if level == "orange" then {
    let _ = AuditLog("osp_alert_orange", "osp", "SPECIFIC id=" + to_string(scenario_id))
    return "ORANGE ALERT: specific notification"
  }
  let _ = AuditLog("osp_alert_yellow", "osp", "WEEKLY id=" + to_string(scenario_id))
  return "YELLOW: weekly digest"
}

// ═══════════════════════════════════════════════════════════════════════
// PROFILE MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════
pattern OSPProfile(query: String, chat_id: String) -> String {
  let context = BuildOSPContext(query, "political", chat_id)
  let prompt = context + "\n\nDEEP PROFILING: биография→сеть→коммуникация→психология→leverage/vulnerabilities→предсказание→трек-рекорд. [ФАКТ]/[ИНТЕРПРЕТАЦИЯ]/[СПЕКУЛЯЦИЯ]"
  let llm_result = try call_llm(prompt, "Profile: " + query)
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = db_execute("INSERT INTO profiles (subject_name, subject_type, full_profile) VALUES (?, 'person', ?) ON CONFLICT (subject_name) DO UPDATE SET full_profile = EXCLUDED.full_profile, last_updated_at = NOW()", [substring(query, 0, 200), substring(reply, 0, 5000)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_profile", "osp", "subject: " + substring(query, 0, 100))
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// SEARCH & RECORDING
// ═══════════════════════════════════════════════════════════════════════
pattern OSPTavilySearch(query: String, chat_id: String) -> String {
  let result = try http_post("http://127.0.0.1:4000/lz/tavily", json_encode({query: query, dept: "osp"}), "application/json")
  if to_string(result) == "()" then { return "Tavily недоступен." }
  let reply = json_get(parse_json(result), "response", "Search failed.")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  return reply
}
pattern OSPTelegramSearch(query: String, chat_id: String) -> String {
  let result = try http_post("http://127.0.0.1:4000/lz/telegram", json_encode({query: query, dept: "osp"}), "application/json")
  if to_string(result) == "()" then { return "Telegram недоступен." }
  let reply = json_get(parse_json(result), "response", "Search failed.")
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  return reply
}
pattern OSPRecordDivergence(pair: String, div_type: String, z_score: Float, notes: String) -> String {
  let _ = db_execute("INSERT INTO cross_asset_divergences (pair_assets, divergence_type, z_score, notes) VALUES (?, ?, ?, ?)", [pair, div_type, to_string(z_score), notes])
  return "OK: divergence recorded"
}
pattern OSPRecordRegime(regime: String, region: String, notes: String) -> String {
  let _ = db_execute("INSERT INTO macro_regime_snapshots (regime, region, regime_notes) VALUES (?, ?, ?)", [regime, region, notes])
  return "OK: regime recorded"
}
pattern OSPGetCurrentRegime(region: String) -> String {
  let rows = query("SELECT regime, regime_notes, date FROM macro_regime_snapshots WHERE region = ? ORDER BY date DESC LIMIT 1", [region])
  if length(rows) == 0 then { return "No regime for " + region }
  return to_string(get(get(rows, 0), "regime")) + " [" + to_string(get(get(rows, 0), "date")) + "]"
}
pattern OSPUpdateBetStatus(bet_id: Int, new_status: String, note: String) -> String {
  let _ = db_execute("UPDATE asymmetric_bets SET status = ?, outcome_note = ? WHERE id = ?", [new_status, note, to_string(bet_id)])
  return "OK: bet " + to_string(bet_id) + " → " + new_status
}

