// ═══════════════════════════════════════════════════════════════════════
// VERIFICATION & CALIBRATION
// ═══════════════════════════════════════════════════════════════════════
pattern OSPVerify(query: String, chat_id: String) -> String {
  let rows = query("SELECT id, topic, confidence FROM analysis WHERE status IN ('watching','published') AND topic LIKE ? LIMIT 5", ["%" + query + "%"])
  if length(rows) == 0 then { return "Нет анализов для верификации: " + query }
  let context = BuildOSPContext(query, "general", chat_id, 1)
  let prompt = context + "\n\nВЕРИФИКАЦИЯ: предсказали→произошло→Brier→систематическая ошибка→corrigendum."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Верифицируй: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_verify", "osp", "")
  return reply
}

// §5.4 #625: числа владельцу — ТОЛЬКО из БД, программным блоком (инвариант 8);
// прежний OSPCalibrationScore, где модель сочиняла оценку, заменён (§7.3).
// Проза модели — строго ПОСЛЕ блока.
pattern OSPScoreCommand(chat_id: String) -> String {
  let block = OSPScoreBlock("owner")
  let context = BuildOSPContext("калибровка", "general", chat_id, 1)
  let prompt = context + "\n\nКАЛИБРОВКА. Ниже программный блок точности — НЕ повторяй его числа и не добавляй своих: прокомментируй причины и что улучшить.\n" + block
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Калибровочный скор ОСП"))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return block }
  let _ = AuditLog("osp_score", "osp", substring(block, 0.0, 120.0))
  return block + "\n\n" + to_string(llm_result)
}

pattern OSPRecalibrate(chat_id: String) -> String {
  // §5.4 #625: прежний OSPRecalibrate падал молча на to_char в INSERT
  // monthly_reviews — писатель теперь OSPMonthlyReview (strftime), проза
  // модели идёт после программного пересчёта
  // #627 W4: перед обзором — Platt и сжатие (поправка 1) судятся данными;
  // нехватка данных — честно REJECTED (идентичность), вердикты — владельцу
  let platt = OSPPlattFit("owner")
  let prior = OSPPriorFit("owner")
  let prev = query("SELECT strftime('%Y-%m', 'now', '-1 month') AS p", [])
  let period = to_string(json_get(get(prev, 0.0), "p", ""))
  let mr = OSPMonthlyReview(period, "owner")
  let context = BuildOSPContext("рекалибровка", "general", chat_id, 1)
  let prompt = context + "\n\nРЕКАЛИБРОВКА: повторяющиеся ошибки→недоиспользуемые навыки→калибровочные смещения→3 конкретных изменения."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Рекалибровка ОСП"))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_recalibrate", "osp", "monthly=" + substring(mr, 0.0, 80.0))
  return "⚙️ Калибровка Platt: " + substring(platt, 3.0, length(platt)) + "\n⚙️ Сжатие к базовой частоте (поправка 1): " + substring(prior, 3.0, length(prior)) + "\n\n" + reply
}

