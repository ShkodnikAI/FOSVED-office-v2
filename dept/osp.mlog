        // 30 строк отложки: 4 сильные пары + 11 нейтральных пар → Platt
        // помогает чуть-чуть: gain=0.0026 в (0, 0.005) → REJECTED,
        // при мутации порога до 0 — ADOPTED (тест красный)
        let _ = OSPW27SeedCal("n627thresh", 0.9, 1.0, 40.0, "")
        let _ = OSPW27SeedCal("n627thresh", 0.9, 1.0, 40.0, "")
