// ═══════════════════════════════════════════════════════════════════════
// DISCLOSURE — mandatory top disclaimer
// ═══════════════════════════════════════════════════════════════════════
pattern OSPDisclaimer() -> String {
  return "⚠️ ОСП: Аналитическая оценка для информирования решений владельца. Не является инвестиционной рекомендацией. Все вероятности по шкале Шермана Кента. Прогнозы подлежат обязательной верификации."
}
pattern OSPDisclaimerBottom() -> String {
  return "---\n⚠️ Верификация: каждый прогноз должен быть сверен по наступлении даты проверки. Brier score обновляется автоматически. /osp verify <id>"
}

// ═══════════════════════════════════════════════════════════════════════
// PROJECT PARAMETERS V4.0
// ═══════════════════════════════════════════════════════════════════════
pattern OSPSelectModel(depth: Int) -> String {
  if depth == 0 then { return "claude-3-5-haiku" }
  if depth == 1 then { return "claude-sonnet-4-20250514" }
  if depth == 2 then { return "claude-sonnet-4-20250514" }
  if depth == 3 then { return "claude-opus-4-20250514" }
  if depth == 4 then { return "claude-opus-4-20250514" }
  return "claude-sonnet-4-20250514"
}
pattern OSPPhaseBudget(depth: Int) -> String {
  if depth == 0 then { return "500,1000,800,600,600" }
  if depth == 1 then { return "800,4000,3000,2000,1200" }
  if depth == 2 then { return "1000,6000,5000,3500,1500" }
  if depth == 3 then { return "1200,8000,7000,5000,2000" }
  if depth == 4 then { return "1500,10000,9000,7000,2500" }
  return "800,4000,3000,2000,1200"
}
pattern OSPSkillBudget(depth: Int) -> Float {
  if depth == 0 then { return 8000.0 }
  if depth == 1 then { return 12000.0 }
  if depth == 2 then { return 18000.0 }
  if depth == 3 then { return 20000.0 }
  if depth == 4 then { return 23000.0 }
  return 12000.0
}

// ═══════════════════════════════════════════════════════════════════════
// SHERMAN KENT VERBAL-TO-NUMERIC SCALE
// ═══════════════════════════════════════════════════════════════════════
pattern OSPShermanKent(label: String) -> String {
  let l = lower(label)
  if l == "almost certainly not" then { return "0.02 [0-5%]" }
  if l == "very unlikely" then { return "0.12 [5-20%]" }
  if l == "unlikely" then { return "0.27 [20-35%]" }
  if l == "roughly even chance" then { return "0.50 [35-65%]" }
  if l == "likely" then { return "0.72 [65-80%]" }
  if l == "very likely" then { return "0.87 [80-95%]" }
  if l == "almost certain" then { return "0.97 [95-100%]" }
  if l == "почти наверняка нет" then { return "0.02 [0-5%]" }
  if l == "очень маловероятно" then { return "0.12 [5-20%]" }
  if l == "маловероятно" then { return "0.27 [20-35%]" }
  if l == "примерно равные шансы" then { return "0.50 [35-65%]" }
  if l == "вероятно" then { return "0.72 [65-80%]" }
  if l == "очень вероятно" then { return "0.87 [80-95%]" }
  if l == "почти наверняка" then { return "0.97 [95-100%]" }
  return "UNMAPPED — use only Kent-approved terms"
}
pattern OSPValidateProbability(text: String) -> String {
  let t = lower(text)
  if contains(t, "likely") or contains(t, "unlikely") or contains(t, "certain") or contains(t, "вероятно") or contains(t, "наверняка") or contains(t, "маловероятно") or contains(t, "%") then { return "PASS" }
  return "FAIL: uncalibrated probability"
}

// ═══════════════════════════════════════════════════════════════════════
// FORCES & POTENTIALS — native formula P = A × R × S × L × E × E_modifier
// ═══════════════════════════════════════════════════════════════════════
pattern OSPComputePotential(A: Float, R: Float, S: Float, L: Float, E: Float, E_modifier: Float) -> Float {
  return A * R * S * L * E * E_modifier
}
pattern OSPCategorizeForce(P: Float) -> String {
  if P >= 5000.0 then { return "DOMINANT (≥5000)" }
  if P >= 1000.0 then { return "MAJOR (1000-4999)" }
  if P >= 100.0 then { return "ACTIVE (100-999)" }
  return "MARGINAL (<100)"
}
pattern OSPComputeDifferential(P1: Float, P2: Float) -> String {
  let D = P1 - P2
  if D > 2000.0 then { return "DECISIVE_ADVANTAGE" }
  if D > 500.0 then { return "CLEAR_ADVANTAGE" }
  if D > 0.0 then { return "SLIGHT_ADVANTAGE" }
  if D > -500.0 then { return "SLIGHT_DISADVANTAGE" }
  return "DECISIVE_DISADVANTAGE"
}

// ═══════════════════════════════════════════════════════════════════════
// BRIER SCORE — native computation
// ═══════════════════════════════════════════════════════════════════════
pattern OSPComputeBrier(forecast_prob: Float, actual_outcome: Float) -> Float {
  let diff = forecast_prob - actual_outcome
  return diff * diff
}
pattern OSPClassifyBrierError(brier: Float, forecast_prob: Float, actual_outcome: Float) -> String {
  if brier <= 0.05 then { return "WELL_CALIBRATED" }
  if forecast_prob < 0.2 and actual_outcome > 0.5 then { return "TAIL_MISS" }
  if forecast_prob > 0.8 and actual_outcome < 0.5 then { return "TAIL_MISS" }
  if forecast_prob - actual_outcome > 0.3 then { return "OVERCONFIDENT" }
  if actual_outcome - forecast_prob > 0.3 then { return "UNDERCONFIDENT" }
  return "MISCALIBRATED"
}

// ═══════════════════════════════════════════════════════════════════════
// LIFECYCLE STATE MACHINE
// ═══════════════════════════════════════════════════════════════════════
pattern OSPDraftAnalysis(topic: String, mode: String, domain: String, depth: Int) -> Int {
  let slug = lower(replace(topic, " ", "-"))
  let _ = db_execute("INSERT INTO analysis (topic, topic_slug, mode, status) VALUES (?, ?, ?, 'drafted')", [topic, slug, mode])
  let ids = query("SELECT id FROM analysis WHERE topic = ? ORDER BY created_at DESC LIMIT 1", [topic])
  if length(ids) > 0 then { return to_int(to_string(json_get(get(ids, 0), "id", "-1"))) }
  return -1
}
pattern OSPPublishAnalysis(analysis_id: Int) -> String {
  let rows = query("SELECT status FROM analysis WHERE id = ?", [to_string(analysis_id)])
  if length(rows) == 0 then { return "ERROR: not found" }
  let status = to_string(json_get(get(rows, 0), "status", ""))
  if status != "drafted" then { return "ERROR: status is '" + status + "', must be 'drafted'" }
  let _ = db_execute("UPDATE analysis SET status = 'published', published_at = datetime('now') WHERE id = ?", [to_string(analysis_id)])
  let _ = AuditLog("osp_publish", "osp", "id=" + to_string(analysis_id) + " drafted→published")
  return "OK: published"
}
pattern OSPWatchAnalysis(analysis_id: Int, watch_until_date: String) -> String {
  let _ = db_execute("UPDATE analysis SET status = 'watching', watch_until = ? WHERE id = ? AND status = 'published'", [watch_until_date, to_string(analysis_id)])
  let _ = AuditLog("osp_watch", "osp", "id=" + to_string(analysis_id) + " published→watching")
  return "OK: watching until " + watch_until_date
}
pattern OSPVerifyAnalysis(analysis_id: Int, outcome: String) -> String {
  let _ = db_execute("UPDATE analysis SET status = ? WHERE id = ? AND status IN ('watching','published')", [outcome, to_string(analysis_id)])
  let _ = AuditLog("osp_verify", "osp", "id=" + to_string(analysis_id) + " →" + outcome)
  return "OK: " + outcome
}
pattern OSPSupersedeAnalysis(old_id: Int, new_id: Int) -> String {
  let _ = db_execute("UPDATE analysis SET status = 'superseded', superseded_by_id = ? WHERE id = ?", [to_string(new_id), to_string(old_id)])
  return "OK: superseded"
}

// ═══════════════════════════════════════════════════════════════════════
// PROGRAMMATIC QUALITY GATES (12 gates)
// ═══════════════════════════════════════════════════════════════════════
pattern OSPCheckQualityGates(output: String, depth: Int) -> String {
  let gates = "{"
  // Gate 1: awareness frame
  let g1 = "true"
  if contains(output, "AWARENESS") == false then { if contains(output, "ОСОЗНАНИЕ") == false then { if contains(output, "SUBJECT:") == false then { let g1 = "false" } } }
  let gates = gates + "\"g1_awareness\":" + g1
  // Gate 2: topology 5 levels
  let g2 = "true"
  if contains(output, "Leaves") == false then { if contains(output, "Листья") == false then { let g2 = "false" } }
  if contains(output, "Roots") == false then { if contains(output, "Корни") == false then { let g2 = "false" } }
  if contains(output, "Fruit") == false then { if contains(output, "Плод") == false then { let g2 = "false" } }
  let gates = gates + ",\"g2_topology\":" + g2
  // Gate 3: forces P=
  let g3 = "true"
  if contains(output, "P =") == false then { if contains(output, "FORCES") == false then { if contains(output, "СИЛЫ") == false then { let g3 = "false" } } }
  let gates = gates + ",\"g3_forces\":" + g3
  // Gate 4: two paths
  let g4 = "true"
  if depth >= 1 then { if contains(output, "Path A") == false then { if contains(output, "Путь А") == false then { let g4 = "false" } } }
  let gates = gates + ",\"g4_twoPaths\":" + g4
  // Gate 5: falsifiable indicators
  let g5 = "true"
  if contains(output, "Indicator") == false then { if contains(output, "Индикатор") == false then { let g5 = "false" } }
  let gates = gates + ",\"g5_indicators\":" + g5
  // Gate 6: Sherman Kent
  let g6 = "true"
  if OSPValidateProbability(output) != "PASS" then { let g6 = "false" }
  let gates = gates + ",\"g6_kentProb\":" + g6
  // Gate 7: confidence labels
  let g7 = "true"
  if contains(output, "ФАКТ") == false then { if contains(output, "FACT") == false then { let g7 = "false" } }
  let gates = gates + ",\"g7_confLabels\":" + g7
  // Gate 8: premortem (depth≥2)
  let g8 = "true"
  if depth >= 2 then { if contains(output, "Premortem") == false then { if contains(output, "премортем") == false then { let g8 = "false" } } }
  let gates = gates + ",\"g8_premortem\":" + g8
  // Gate 9: ACH hypotheses (depth≥2)
  let g9 = "true"
  if depth >= 2 then { if contains(output, "H1") == false then { if contains(output, "Гипотеза 1") == false then { let g9 = "false" } } }
  let gates = gates + ",\"g9_achHypo\":" + g9
  // Gate 10: spillover check
  let g10 = "true"
  let gates = gates + ",\"g10_spillover\":" + g10
  // Gate 11: compact summary
  let g11 = "true"
  let gates = gates + ",\"g11_compact\":" + g11
  // Gate 12: no uncalibrated probability
  let g12 = "true"
  if contains(output, "возможно") or contains(output, "может быть") then { let g12 = "false" }
  let gates = gates + ",\"g12_noUncalib\":" + g12
  let gates = gates + "}"
  return gates
}

// ── Final safety check ──
pattern OSPFinalSafetyCheck(output: String) -> String {
  let t = lower(output)
  if contains(t, "покупай") or contains(t, "buy now") or contains(t, "продавай") or contains(t, "sell now") or contains(t, "инвестируй в") or contains(t, "invest in") then {
    return "BLOCKED: direct investment advice detected"
  }
  return "PASS"
}

// ── Auto-escalation ──
pattern OSPAutoEscalate(topic: String, base_depth: Int) -> Int {
  let t = lower(topic)
  let depth = base_depth
  let iw_flag = kv_get("iw_active_" + substring(t, 0, 30))
  if to_string(iw_flag) != "()" and to_string(iw_flag) != "" then { let depth = depth + 1 }
  let owner_pri = kv_get("owner_priority_topics")
  if contains(to_string(owner_pri), substring(t, 0, 20)) then { let depth = depth + 1 }
  let miss_count = query("SELECT COUNT(*) as c FROM analysis WHERE topic LIKE ? AND status IN ('missed','partial')", ["%" + substring(t, 0, 30) + "%"])
  if length(miss_count) > 0 then {
    let mc = json_get(get(miss_count, 0), "c", "0")
    if to_float(to_string(mc)) >= 2.0 then { let depth = depth + 1 }
  }
  if contains(t, "критич") or contains(t, "existential") then { let depth = depth + 2 }
  if depth > 4 then { let depth = 4 }
  return depth
}

// ── Error classifier ──
pattern OSPClassifyError(forecast: String, actual: String) -> String {
  let f = lower(forecast)
  let a = lower(actual)
  if contains(f, "spillover") == false then { if contains(a, "spillover") then { return "MISSED_SPILLOVER" } }
  if contains(f, "force") == false then { if contains(a, "force") then { return "MISSED_FORCE" } }
  if contains(f, "convergent") then { if contains(a, "convergent") == false then { return "PREMATURE_CONVERGENCE" } }
  return "OTHER"
}

// ═══════════════════════════════════════════════════════════════════════
// API ENDPOINTS
// ═══════════════════════════════════════════════════════════════════════
pattern OSPArchiveAPI(status: String, domain: String, limit: Int) -> String {
  // №312: параметризованный запрос (была конкатенация status — SQL-инъекция).
  // Попутно починен латентный баг: прежний `let q = q + ...` внутри if создавал
  // shadow-биндинг, умиравший с веткой — фильтр по status никогда не применялся.
  if status != "" then {
    return json_encode(query("SELECT id, topic, status, created_at FROM analysis WHERE status = ? ORDER BY created_at DESC LIMIT ?", [status, limit]))
  }
  return json_encode(query("SELECT id, topic, status, created_at FROM analysis ORDER BY created_at DESC LIMIT ?", [limit]))
}
pattern OSPVerifyIndicatorAPI(indicator_id: String, result: Boolean) -> String {
  let _ = db_execute("UPDATE indicator SET result = ?, verified_at = datetime('now') WHERE id = ?", [to_string(result), indicator_id])
  return "{verified: true}"
}

// ═══════════════════════════════════════════════════════════════════════
// CROSS-DEPARTMENT ROUTING
// ═══════════════════════════════════════════════════════════════════════
// #446 (решение владельца 2026-10-02, классы B+C — убрать): прямые HTTP-мосты
// OSPRouteToFinance/Expert/LZ/Legal вычищены — все четыре вели на
// несуществующие Flask-роуты (:4000/dept/*), ошибки глотались, носители
// недостижимы из прода (DEAD/STRING_ONLY по реестру #449). Если межотдельное
// ОСП-маршрутизация понадобится — строить через живой механизм цепочек
// /chain/step (:10001, chain_parallel/chain_durable), не прямыми HTTP-роутами.
// Гвард: tests/test_n446_bridges.py + scripts/deadcall_detector.py в CI.

// ═══════════════════════════════════════════════════════════════════════
// MAIN DISPATCHER
// ═══════════════════════════════════════════════════════════════════════
pattern HandleOSP(query: String, chat_id: String) -> String {
  let dept = "osp"
  let t = lower(query)

  // ── Depth routing ──
  if starts_with(t, "/osp quick") or starts_with(t, "/osp fast") then { return OSPQuickAnalyze(substring(query, 10, 300), chat_id) }
  if starts_with(t, "/osp deep") then { return OSPDeepAnalyze(substring(query, 9, 300), chat_id) }
  if starts_with(t, "/osp full") then { return OSPFullAnalyze(substring(query, 9, 300), chat_id) }
  if starts_with(t, "/osp wargame") then { return OSPWargame(substring(query, 12, 300), chat_id) }

  // ── Domain modes ──
  if starts_with(t, "/osp regime") then { return OSPRegimeScan(substring(query, 11, 300), chat_id) }
  if starts_with(t, "/osp cantillon") then { return OSPCantillonScan(substring(query, 13, 300), chat_id) }
  if starts_with(t, "/osp narrative") then { return OSPNarrativeScan(substring(query, 13, 300), chat_id) }

  // ── Verification & calibration ──
  if starts_with(t, "/osp verify") then { return OSPVerify(substring(query, 11, 300), chat_id) }
  if starts_with(t, "/osp score") or starts_with(t, "/osp brier") then { return OSPCalibrationScore(chat_id) }
  if starts_with(t, "/osp recalibrate") then { return OSPRecalibrate(chat_id) }
  if starts_with(t, "/osp bet") then { return OSPRegisterBet(substring(query, 8, 300), chat_id) }

  // ── Red team ──
  if starts_with(t, "/osp redteam") or starts_with(t, "/osp red-team") then { return OSPRedteam(substring(query, 12, 300), chat_id) }

  // ── I&W Watchlist ──
  if starts_with(t, "/osp watch") then { return OSPWatch(substring(query, 10, 300), chat_id) }
  if starts_with(t, "/osp unwatch") then { return OSPUnwatch(substring(query, 12, 300), chat_id) }

  // ── Profile ──
  if starts_with(t, "/osp profile") then { return OSPProfile(substring(query, 12, 300), chat_id) }

  // ── Search ──
  if starts_with(t, "/osp tavily") then { return OSPTavilySearch(substring(query, 10, 300), chat_id) }
  if starts_with(t, "/osp tg") or starts_with(t, "/osp telegram") then { return OSPTelegramSearch(substring(query, 7, 300), chat_id) }

  // ── Default ──
  let domain = OSPClassifyDomain(query)
  let depth = OSPAutoEscalate(query, 1)
  let context = BuildOSPContext(query, domain, chat_id)
  let context = OSPDisclaimer() + "\n\n" + context + "\n\n=== PROJECT PARAMS ===\nDepth: " + to_string(depth) + " Domain: " + domain + "\n"
  let llm_result = redact(to_string(TryVal(try call_llm(context, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис временно недоступен." }
  let reply = to_string(llm_result)
  let gates = OSPCheckQualityGates(reply, depth)
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  // ── LLM-Verifier: confidence scoring for strategic analysis ──
  let ov_resp = TryVal(try call_python("llm_verifier", "score", json_encode([query, reply, "Analytical rigor: Logic and evidence quality? Probability calibration: Reasonable confidence levels? Actionability: Decision-relevant conclusions?"])))
  let mut ov_score = 0.0
  if to_string(ov_resp) != "()" and contains(to_string(ov_resp), "error") == false then {
    let ov_parsed = TryVal(try parse_json(ov_resp))
    let ov_score = to_float(TryVal(try json_get(ov_parsed, "result", "0.5")))
    let _ = AuditLog("osp_verify_score", dept, "score=" + to_string(ov_score) + " domain=" + domain + " depth=" + to_string(depth))
  }
  let reply = reply + "\n\n" + OSPDisclaimerBottom() + OSPSourcesFooter(context)
  let _ = RecordAssistantMessage(chat_id, dept, reply)
  let _ = AuditLog("dept_query", dept, "domain=" + domain + " depth=" + to_string(depth) + " gates=" + gates + " safety=" + safety + " verify=" + to_string(ov_score))
  return reply
}

// Подвал со списком реально использованных источников — построен по
// меткам в context. FRED-метка условная (появляется только если
// реально запрашивался, monetary/financial) — простая проверка
// contains() надёжна. "=== News ===" заголовок в контексте есть
// ВСЕГДА (даже при пустом результате), поэтому для него проверяем не
// сам заголовок, а есть ли за ним реальный текст, не только пустота
// до следующей секции.
pattern OSPSourcesFooter(context: String) -> String {
  let mut lines = ""
  let news_start = index_of(context, "=== News ===\n")
  if news_start >= 0.0 then {
    let after = substring(context, news_start + 13.0, length(context))
    let news_end = index_of(after, "\n\n===")
    let mut news_body = after
    if news_end >= 0.0 then { let news_body = substring(after, 0.0, news_end) }
    if length(trim(news_body)) > 20.0 then {
      let lines = lines + "\n· Новостной поиск (RSS)"
    }
  }
  // Наряд #423 A.2: секция Live Search — только когда реально была.
  // С результатами — имя источника; при отказе — точная причина из
  // блока, владельцу видно, почему живого поиска в ответе нет.
  let live_start = index_of(context, "=== Live Search ===")
  if live_start >= 0.0 then {
    let after = substring(context, live_start + 19.0, length(context))
    let live_end = index_of(after, "\n\n===")
    let mut live_body = after
    if live_end >= 0.0 then { let live_body = substring(after, 0.0, live_end) }
    if contains(live_body, "•") then {
      let lines = lines + "\n· Живой поиск (Tavily)"
    } else {
      if length(trim(live_body)) > 0.0 then {
        let lines = lines + "\n· Живой поиск (Tavily): " + trim(live_body)
      }
    }
  }
  if contains(context, "=== FRED (макроданные) ===") then {
    let lines = lines + "\n· FRED (макроданные: доходность облигаций, ставка ФРС, инфляция)"
  }
  if length(lines) == 0.0 then { return "" }
  return "\n\n---\n**Источники:**" + lines
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN CLASSIFIER
// ═══════════════════════════════════════════════════════════════════════
pattern OSPClassifyDomain(query: String) -> String {
  let t = lower(query)
  if contains(t, "рынок") or contains(t, "актив") or contains(t, "валют") or contains(t, "акци") or contains(t, "облигац") or contains(t, "крипто") or contains(t, "нефт") or contains(t, "золот") or contains(t, "gold") or contains(t, "vix") then { return "financial" }
  if contains(t, "ставк") or contains(t, "инфляци") or contains(t, "рецесси") or contains(t, "стагфляци") or contains(t, "эмисси") or contains(t, "центробанк") or contains(t, "фрс") or contains(t, "есб") or contains(t, "ввп") or contains(t, "gdp") then { return "monetary" }
  if contains(t, "геополитик") or contains(t, "альянс") or contains(t, "санкци") or contains(t, "nato") or contains(t, "нато") or contains(t, "брикс") or contains(t, "войн") or contains(t, "конфликт") then { return "geopolitical" }
  if contains(t, "армия") or contains(t, "вооружен") or contains(t, "фронт") or contains(t, "ракет") or contains(t, "ядерн") then { return "military" }
  if contains(t, "компани") or contains(t, "корпорац") or contains(t, "стратег") or contains(t, "конкурент") then { return "corporate" }
  if contains(t, "президент") or contains(t, "выбор") or contains(t, "парламент") then { return "political" }
  return "general"
}

// ═══════════════════════════════════════════════════════════════════════
// LIVE SEARCH — наряд #423: событийность + честная деградация
// ═══════════════════════════════════════════════════════════════════════
// Событийность запроса: домены, где события решают, плюс явные
// событийные маркеры. Точная проверка «даты текущего месяца» в mlog-
// паттерне ненадёжна — date-функций нет, now() только Unix-секунды,
// поэтому год/месяц в запросе НЕ является триггером. Расширение списка
// маркеров — правкой этого паттерна, гварды — в тестах наряда #423.
pattern OSPNeedsLiveSearch(query: String, domain: String) -> Bool {
  if domain == "political" or domain == "geopolitical" or domain == "military" then { return true }
  let t = lower(query)
  return contains(t, "что происходит") or contains(t, "сейчас") or contains(t, "последние") or contains(t, "новости") or contains(t, "сегодня") or contains(t, "вчера") or contains(t, "на этой неделе") or contains(t, "кадров") or contains(t, "назнач") or contains(t, "перестанов")
}

// Живой поиск в обычном пути. Транспорт — общий TavilySearch (utils.mlog,
// office#354), красные поля — redact внутри TavilyFormatBlock (урок №268).
// Каждый отказ называет точную причину: подвал источников показывает её
// владельцу как есть, без общего «недоступен» (A.3 наряда #423).
pattern OSPLiveSearchBlock(query: String) -> String {
  // Белорусская тематика: запрос дополняется контекстом страны —
  // иначе выдача по «кадровые перестановки» без гео-контекста релевантности
  // не даёт (A.1 наряда #423; релевантность выдачи — smoke владельца).
  let t = lower(query)
  let mut q = query
  if contains(t, "беларус") or contains(t, "минск") or contains(t, "лукашенко") then {
    let q = query + " Беларусь"
  }
  if trim(TavilyKey()) == "" then { return "(живой поиск не выполнен: ключ Tavily не задан)" }
  let response = TavilySearch(q, "osp")
  if response == "()" then { return "(живой поиск не выполнен: сеть Tavily недоступна)" }
  let parsed = TryVal(try parse_json(response))
  if to_string(parsed) == "()" then { return "(живой поиск не выполнен: ответ Tavily не распознан)" }
  let block = TavilyFormatBlock(response)
  if block == "" then { return "(живой поиск вернул 0 результатов)" }
  return block
}

// ═══════════════════════════════════════════════════════════════════════
// CONTEXT BUILDER
// ═══════════════════════════════════════════════════════════════════════
pattern BuildOSPContext(query: String, domain: String, chat_id: String) -> String {
  let profile = ReadDeptProfile("osp")
  let skills = LoadOSPEnrichedSkills(query, domain)
  let corrections = GetCorrections("osp")
  let dialog = GetRecentDialog(chat_id, "10", "osp")
  let facts = GetFacts("osp", "12")
  let memories = YanaRecallMemories(query)
  let now_info = YanaNowInfo()
  let domain_kb = OSPDomainKB(domain)
  let news = ""
  let news_result = TryVal(try http_post("http://127.0.0.1:4000/news/fresh", json_encode({query: query, dept: "osp", limit: 5}), "application/json"))
  if to_string(news_result) != "()" then { let news = json_get(parse_json(news_result), "news", "") }
  // Наряд #423: живой поиск — только на событийных запросах при пустом
  // кэше новостей. Двухчастное условие: не жечь кредиты Tavily на
  // структурных темах (smoke-пункт 2 наряда) и не дублировать свежие
  // RSS, когда кэш жив (наряд #424). Буквальное чтение «news пуст ИЛИ
  // событийный» звало бы Tavily на каждый вопрос при пустом кэше —
  // противоречит smoke-кейсу 2 того же наряда.
  let live_block = ""
  if OSPNeedsLiveSearch(query, domain) and length(trim(news)) == 0.0 then {
    let live_block = "\n\n=== Live Search ===\n" + OSPLiveSearchBlock(query)
  }
  // FRED (McpMarketsCall) — для monetary/financial: общие RSS-ленты
  // /news/fresh не дают числовых макро-рядов (доходность облигаций,
  // ставка ФРС, инфляция) — это и была реальная причина отчёта-каркаса
  // без цифр по долгу США. Фиксированный набор ключевых рядов, не
  // произвольный (нет лишнего вызова модели на извлечение series_id).
  let fred_data = ""
  if domain == "monetary" or domain == "financial" then {
    let mut fred_lines = ""
    each series in ["DGS10", "FEDFUNDS", "CPIAUCSL"] {
      let r = McpMarketsCall("osp", "get_fred_series", json_encode({series_id: series, limit: 1}), "osp monetary/financial context")
      if r.ok == true then {
        let fred_lines = fred_lines + series + ": " + r.body + "\n"
      } else {
        let fred_lines = fred_lines + series + ": недоступно (" + r.note + ")\n"
      }
    }
    let fred_data = "\n\n=== FRED (макроданные) ===\n" + fred_lines
  }
  let s_mem = to_string(memories)
  if s_mem == "()" then { let s_mem = "" }
  let s_cor = to_string(corrections)
  if s_cor == "()" then { let s_cor = "" }
  let s_dlg = to_string(dialog)
  if s_dlg == "()" then { let s_dlg = "" }
  let s_facts = to_string(facts)
  if s_facts == "()" then { let s_facts = "" }
  let s_now = to_string(now_info)
  if s_now == "()" then { let s_now = "" }
  let s_sk = to_string(skills)
  if s_sk == "()" then { let s_sk = "" }
  let context = profile + "\n\n=== Дата ===\n" + s_now + "\n\n=== Domain: " + domain + " ===\n" + domain_kb + "\n\n=== Skills ===\n" + s_sk + "\n\n=== News ===\n" + news + live_block + fred_data + "\n\n=== Corrections ===\n" + s_cor + "\n\n=== Memory ===\n" + s_mem + "\n\n=== Консолидированные факты ===\n" + s_facts + "\n\n=== Dialog ===\n" + s_dlg
  let context = context + "\n\n=== ПОВТОР: ДАТА ===\n" + s_now
  return context
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN KB
// ═══════════════════════════════════════════════════════════════════════
pattern OSPDomainKB(domain: String) -> String {
  let kb = "ОСП V2: Корни→Стебель→Ветви→Плоды→Семена | P=A×R×S×L×E | [ФАКТ]/[ИНТЕРПРЕТАЦИЯ]/[СПЕКУЛЯЦИЯ] | Sherman Kent | Two-paths\n"
  if domain == "financial" then { let kb = kb + "Фокус: cross-asset divergence, asymmetric bet, antifragility, Cantillon\n" }
  if domain == "monetary" then { let kb = kb + "Фокус: macro regime, ЦБ actions, Cantillon, narrative-vs-flows, cycle position\n" }
  if domain == "geopolitical" then { let kb = kb + "Фокус: balance of power, narrative-vs-flows, order-of-battle, Schelling points, I&W\n" }
  if domain == "military" then { let kb = kb + "Фокус: OOB, phase transition, Schelling points, red team\n" }
  if domain == "corporate" then { let kb = kb + "Фокус: strategic maneuvers, forces, reflexive impact, decision tree\n" }
  if domain == "political" then { let kb = kb + "Фокус: deep profiling, narrative-vs-flows, cycle position, Cantillon\n" }
  return kb
}

// ═══════════════════════════════════════════════════════════════════════
// SKILL LOADING (3-tier)
// ═══════════════════════════════════════════════════════════════════════
pattern LoadOSPEnrichedSkills(query: String, domain: String) -> String {
  let t = lower(query)
  let mut result = ""
  let budget = OSPSkillBudget(1)
  // Tier 1 always
  let s = redact(read_file("skills/deconstruct/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- deconstruct ---\n" + s }
  let s = redact(read_file("skills/awareness-frame/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- awareness-frame ---\n" + s }
  let s = redact(read_file("skills/root-cause-mapping/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- root-cause-mapping ---\n" + s }
  let s = redact(read_file("skills/forces-and-potentials/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- forces-and-potentials ---\n" + s }
  let s = redact(read_file("skills/strategic-maneuvers/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- strategic-maneuvers ---\n" + s }
  let s = redact(read_file("skills/two-paths-synthesis/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- two-paths-synthesis ---\n" + s }
  let s = redact(read_file("skills/decision-tree-forecast/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- decision-tree-forecast ---\n" + s }
  let s = redact(read_file("skills/reflexive-impact/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- reflexive-impact ---\n" + s }
  let s = redact(read_file("skills/calibration/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- calibration ---\n" + s }
  let s = redact(read_file("skills/system-health-diagnostics/SKILL.md"), "all")
  if s != "" and length(result) < budget then { result = result + "\n--- system-health-diagnostics ---\n" + s }
  // Tier 2 by domain
  if domain == "financial" and length(result) < budget then {
    let s = redact(read_file("skills/cross-asset-divergence/SKILL.md"), "all")
    if s != "" then { result = result + "\n--- cross-asset-divergence ---\n" + s }
    let s = redact(read_file("skills/asymmetric-bet-structure/SKILL.md"), "all")
    if s != "" then { result = result + "\n--- asymmetric-bet-structure ---\n" + s }
  }
  if domain == "monetary" and length(result) < budget then {
    let s = redact(read_file("skills/macro-regime-id/SKILL.md"), "all")
    if s != "" then { result = result + "\n--- macro-regime-id ---\n" + s }
    let s = redact(read_file("skills/cantillon/SKILL.md"), "all")
    if s != "" then { result = result + "\n--- cantillon ---\n" + s }
  }
  if contains(t, "нарратив") or contains(t, "поток") then {
    let s = redact(read_file("skills/narrative-vs-flows/SKILL.md"), "all")
    if s != "" and length(result) < budget then { result = result + "\n--- narrative-vs-flows ---\n" + s }
  }
  if contains(t, "цикл") or contains(t, "фаза") then {
    let s = redact(read_file("skills/cycle-position/SKILL.md"), "all")
    if s != "" and length(result) < budget then { result = result + "\n--- cycle-position ---\n" + s }
  }
  if contains(t, "персона") or contains(t, "лидер") then {
    let s = redact(read_file("skills/deep-profiling/SKILL.md"), "all")
    if s != "" and length(result) < budget then { result = result + "\n--- deep-profiling ---\n" + s }
  }
  if contains(t, "индикатор") or contains(t, "watch") then {
    let s = redact(read_file("skills/iw-watchlist/SKILL.md"), "all")
    if s != "" and length(result) < budget then { result = result + "\n--- iw-watchlist ---\n" + s }
  }
  // Tier 3
  if domain == "military" and length(result) < budget then {
    let s = redact(read_file("skills/order-of-battle/SKILL.md"), "all")
    if s != "" then { result = result + "\n--- order-of-battle ---\n" + s }
  }
  if contains(t, "redteam") or contains(t, "red-team") then {
    let s = redact(read_file("skills/red-team/SKILL.md"), "all")
    if s != "" and length(result) < budget then { result = result + "\n--- red-team ---\n" + s }
  }
  if result == "" then { return "No skills loaded." }
  return result
}

// ═══════════════════════════════════════════════════════════════════════
// DEPTH-ROUTED ANALYSIS MODES (all native call_llm)
// ═══════════════════════════════════════════════════════════════════════
pattern OSPQuickAnalyze(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nБЫСТРЫЙ АНАЛИЗ (depth=0). 200-300 слов. Суть — риск — действие."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result) + "\n\n" + OSPDisclaimerBottom()
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_quick", "osp", "domain=" + domain)
  return reply
}

pattern OSPDeepAnalyze(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nГЛУБОКОЕ ПРЕПАРИРОВАНИЕ (depth=3). 4 фазы. [ФАКТ]/[ИНТЕРПРЕТАЦИЯ]/[СПЕКУЛЯЦИЯ]. Sherman Kent. Two-paths. Индикаторы 30/60/90/180/365 дней."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let gates = OSPCheckQualityGates(reply, 3)
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  let reply = reply + "\n\n" + OSPDisclaimerBottom()
  let aid = OSPDraftAnalysis(query, "deep", domain, 3)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_deep", "osp", "domain=" + domain + " aid=" + to_string(aid) + " gates=" + gates)
  return reply
}

pattern OSPFullAnalyze(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nПОЛНЫЙ АНАЛИЗ (depth=4). depth=3 + Red team + I&W + Verification dates + Asymmetric bet + Premortem 3mo/12mo + ACH 5+ гипотез."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let gates = OSPCheckQualityGates(reply, 4)
  let safety = OSPFinalSafetyCheck(reply)
  if safety != "PASS" then { let reply = reply + "\n\n[SAFETY: " + safety + "]" }
  let reply = reply + "\n\n" + OSPDisclaimerBottom()
  let aid = OSPDraftAnalysis(query, "full", domain, 4)
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_full", "osp", "domain=" + domain + " aid=" + to_string(aid) + " gates=" + gates)
  return reply
}

pattern OSPWargame(query: String, chat_id: String) -> String {
  let domain = OSPClassifyDomain(query)
  let context = BuildOSPContext(query, domain, chat_id)
  let prompt = OSPDisclaimer() + "\n\n" + context + "\n\nWARGAME (depth=2). Стороны→Интересы→Силы→Ходы→Дерево→Schelling points→Нэш→Наша стратегия→Red flags."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result) + "\n\n" + OSPDisclaimerBottom()
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_wargame", "osp", "domain=" + domain)
  return reply
}

// ═══════════════════════════════════════════════════════════════════════
// DOMAIN SCANS
// ═══════════════════════════════════════════════════════════════════════
pattern OSPRegimeScan(query: String, chat_id: String) -> String {
  let context = BuildOSPContext(query, "monetary", chat_id)
  let prompt = context + "\n\nМАКРО-РЕЖИМ: текущий режим, индикаторы, ЦБ, cross-asset, Cantillon, narrative-vs-reality, I&W перехода."
  let llm_result = redact(to_string(TryVal(try call_llm(prompt, "Macro regime: " + query))), "all")
  if to_string(llm_result) == "()" then { let llm_result = "[оценка недоступна — провайдеры модели не ответили]" }
  if to_string(llm_result) == "()" then { return "Сервис недоступен." }
  let reply = to_string(llm_result)
  let _ = db_execute("INSERT INTO macro_regime_snapshots (regime, regime_notes) VALUES ('scan', ?)", [substring(reply, 0, 500)])
  let _ = RecordAssistantMessage(chat_id, "osp", reply)
  let _ = AuditLog("osp_regime", "osp", "")
  return reply
}

