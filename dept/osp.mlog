test "n626 атрибуция и белый список: 8 полей, полей исхода нет" {
  assert_contains(OSPBenchAttribution(), "CC BY-SA 4.0")
  assert_contains(OSPBenchAttribution(), "forecastbench-datasets")
  let wl = split(OSPBenchWhitelist(), ";")
  assert_eq(length(wl), 8.0)
  // MUT-мишень наряда: убрать белый список — payload получит поле исхода
  let pl = OSPBenchBuildPayload("{\"question\": \"вопрос?\", \"resolved_to\": 1.0, \"url\": \"https://x\"}")
  assert_contains(pl, "\"question\"")
  assert_eq(to_string(json_get(parse_json(pl), "resolved_to", "АБСЕНТ")), "АБСЕНТ")
}

test "n626 утечка-гвард: чистый вопрос CLEAN, вопрос с resolved_to — BLOCK" {
  // MUT-приёмка: подменить question_set на resolution_set — BLOCK, раунд стоит
  assert_eq(OSPBenchHasForbidden("{\"id\": \"1\", \"question\": \"чисто\"}"), "CLEAN")
  assert_contains(OSPBenchHasForbidden("{\"id\": \"1\", \"resolved_to\": 1.0}"), "BLOCK|resolved_to")
  assert_contains(OSPBenchHasForbidden("{\"id\": \"1\", \"resolved\": true}"), "BLOCK|resolved")
  assert_contains(OSPBenchHasForbidden("{\"id\": \"1\", \"direction\": \"up\"}"), "BLOCK|direction")
}

