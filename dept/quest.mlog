// Fosved Office v2 — Quest/Dossier Module (QUEST-1, нативно переработан #366)
// Multi-step task management: grants, contracts, reports, outreach
// All state in SQLite (quests, quest_files, quest_checkpoints).
// НАРЯД #366: create/list/status работают нативно из БД — HTTP-моста к Flask
// больше нет (роуты /api/quest/* никогда не существовали, вызовы были
// мёртвыми). send-package/generate честно сообщают «не реализовано» —
// почтового контура в офисе нет (MAIL-1 из 5bea453 не дошла до продакшена).

// ---------------------------------------------------------------------------
// 1. QuestCreate — create a new dossier with N steps
//    Returns quest_id for subsequent operations
//    НАРЯД #366 B.1: чекпоинты создаются нативно — рекурсивный CTE в SQLite
//    (комментарий «Metalogos has no loop construct» устарел). Нумерация шагов
//    0-based согласована с current_step в QuestApproveStep/QuestAdvanceStep.
//    CAST(?2 AS INTEGER) безопасен и для строкового биндинга; мусорный
//    total_steps даёт 0 чекпоинтов — честно видно в /quest status.
// ---------------------------------------------------------------------------
pattern QuestCreate(title: String, quest_type: String, total_steps: String, deadline: String, chat_id: String) -> String {
  let qid = "Q-" + to_string(now())

  db_execute("INSERT INTO quests (id, title, quest_type, status, current_step, total_steps, deadline, owner_chat_id, updated_at) VALUES (?1, ?2, ?3, 'active', 0, ?4, ?5, ?6, datetime('now'))",
    [qid, title, quest_type, total_steps, deadline, chat_id])

  db_execute("WITH RECURSIVE seq(n) AS (SELECT 0 UNION ALL SELECT n + 1 FROM seq WHERE n < CAST(?2 AS INTEGER) - 1) INSERT INTO quest_checkpoints (quest_id, step_num, step_label, status) SELECT ?1, n, 'Shag ' || CAST(n + 1 AS TEXT), 'pending' FROM seq",
    [qid, total_steps])

  let _ = AuditLog("quest_create", "quest", "id=" + qid + " title=" + title + " type=" + quest_type)
  return qid
}

// ---------------------------------------------------------------------------
// 2. QuestList — list active quests for owner
//    Returns formatted text for Telegram
//    НАРЯД #366 B.1: форматирование нативно из БД (раньше вызов шел в
//    несуществующий /api/quest/format-list и всегда падал до сырого JSON)
// ---------------------------------------------------------------------------
pattern QuestList(chat_id: String) -> String {
  let rows = query("SELECT id, title, quest_type, status, current_step, total_steps, deadline FROM quests WHERE status = 'active' ORDER BY created_at DESC LIMIT 20", [])
  let count = length(rows)
  if count == 0.0 then {
    return "Net aktivnyh zadach."
  }

  let mut out = "Aktivnye dossye:\n"
  each r in rows {
    let qid = redact(to_string(json_get(r, "id", "")), "all")
    let qtitle = redact(to_string(json_get(r, "title", "")), "all")
    let qtype = redact(to_string(json_get(r, "quest_type", "general")), "all")
    let qstep = redact(to_string(json_get(r, "current_step", "0")), "all")
    let qtotal = redact(to_string(json_get(r, "total_steps", "0")), "all")
    let qdl = redact(to_string(json_get(r, "deadline", "")), "all")
    let mut line = ""
    line = line + qid + " — " + qtitle + " [" + qtype + "] shag " + qstep + "/" + qtotal
    if qdl != "" then { line = line + " (srok " + qdl + ")" }
    let out = out + line + "\n"
  }
  return out
}

// ---------------------------------------------------------------------------
// 3. QuestStatus — detailed status of one quest with all checkpoints
//    НАРЯД #366 B.1: статус и шаги читаются из БД напрямую (раньше вызов шел
//    в несуществующий /api/quest/format-status — статус всегда был ошибкой)
// ---------------------------------------------------------------------------
pattern QuestStatus(qid: String) -> String {
  let qrows = query("SELECT id, title, quest_type, status, current_step, total_steps, deadline FROM quests WHERE id = ?1 LIMIT 1", [qid])
  if length(qrows) == 0.0 then {
    return "Dossye " + qid + " ne najdeno."
  }

  let q = qrows[0]
  let qtitle = redact(to_string(json_get(q, "title", "")), "all")
  let qtype = redact(to_string(json_get(q, "quest_type", "general")), "all")
  let qstatus = redact(to_string(json_get(q, "status", "")), "all")
  let qstep = redact(to_string(json_get(q, "current_step", "0")), "all")
  let qtotal = redact(to_string(json_get(q, "total_steps", "0")), "all")
  let qdl = redact(to_string(json_get(q, "deadline", "")), "all")
  let mut out = ""
  out = out + qid + " — " + qtitle + " [" + qtype + "]\nStatus: " + qstatus + ", shag " + qstep + " iz " + qtotal
  if qdl != "" then { out = out + ", srok " + qdl }

  let crows = query("SELECT step_num, COALESCE(step_label, 'Shag ' || CAST(step_num + 1 AS TEXT)) AS step_label, status FROM quest_checkpoints WHERE quest_id = ?1 ORDER BY step_num", [qid])
  if length(crows) > 0.0 then {
    let out = out + "\nShagi:"
    each c in crows {
      let num = redact(to_string(json_get(c, "step_num", "0")), "all")
      let label = redact(to_string(json_get(c, "step_label", "")), "all")
      let cstatus = redact(to_string(json_get(c, "status", "")), "all")
      let out = out + "\n  " + num + ". " + label + " — " + cstatus
    }
  }
  return out
}

// ---------------------------------------------------------------------------
// 4. QuestAdvanceStep — move to next step (mark current as in_progress)
// ---------------------------------------------------------------------------
pattern QuestAdvanceStep(qid: String) -> String {
  let rows = query("SELECT current_step, total_steps FROM quests WHERE id = ?1", [qid])
  if length(rows) == 0.0 then { return "Zadacha ne najdena." }

  let r = rows[0]
  let cstep = to_float(TryVal(try json_get(r, "current_step", "0")))
  let tstep = to_float(TryVal(try json_get(r, "total_steps", "0")))

  if cstep >= tstep then {
    db_execute("UPDATE quests SET status = 'completed', updated_at = datetime('now') WHERE id = ?1", [qid])
    return "Vse shagi vypolneny. Zadacha " + qid + " zavershena."
  }

  // Mark current step as in_progress
  db_execute("UPDATE quest_checkpoints SET status = 'in_progress' WHERE quest_id = ?1 AND step_num = ?2", [qid, to_string(cstep)])
  db_execute("UPDATE quests SET current_step = ?1, updated_at = datetime('now') WHERE id = ?2", [to_string(cstep), qid])

  let _ = AuditLog("quest_advance", "quest", "id=" + qid + " step=" + to_string(cstep) + "/" + to_string(tstep))
  return "Shag " + to_string(cstep + 1.0) + "/" + to_string(tstep) + " in progress."
}

// ---------------------------------------------------------------------------
// 5. QuestApproveStep — owner approves current step, advance to next
// ---------------------------------------------------------------------------
pattern QuestApproveStep(qid: String, approved_by: String) -> String {
  let rows = query("SELECT current_step, total_steps FROM quests WHERE id = ?1", [qid])
  if length(rows) == 0.0 then { return "Zadacha ne najdena." }

  let r = rows[0]
  let cstep = redact(to_string(TryVal(try json_get(r, "current_step", "0"))), "all")
  let tstep = to_float(TryVal(try json_get(r, "total_steps", "0")))

  // Approve current step
  db_execute("UPDATE quest_checkpoints SET status = 'approved', approved_by = ?1, approved_at = datetime('now') WHERE quest_id = ?2 AND step_num = ?3",
    [approved_by, qid, cstep])

  // Advance to next step
  let next_step = to_float(cstep) + 1.0
  if next_step >= tstep then {
    db_execute("UPDATE quests SET status = 'completed', updated_at = datetime('now') WHERE id = ?1", [qid])
    let _ = AuditLog("quest_approve_complete", "quest", "id=" + qid + " all steps approved")
    return "Poslednij shag odobren. Zadacha " + qid + " zavershena."
  }

  db_execute("UPDATE quests SET current_step = ?1, updated_at = datetime('now') WHERE id = ?2", [to_string(next_step), qid])
  db_execute("UPDATE quest_checkpoints SET status = 'in_progress' WHERE quest_id = ?1 AND step_num = ?2", [qid, to_string(next_step)])

  let _ = AuditLog("quest_approve_step", "quest", "id=" + qid + " step=" + cstep + " approved_by=" + approved_by)
  return "Shag " + cstep + " odobren. Perehodim k shagu " + to_string(next_step + 1.0) + "."
}



// ---------------------------------------------------------------------------
// 8. QuestClose — mark quest as closed/cancelled
// ---------------------------------------------------------------------------
pattern QuestClose(qid: String) -> String {
  db_execute("UPDATE quests SET status = 'closed', updated_at = datetime('now') WHERE id = ?1", [qid])
  let _ = AuditLog("quest_close", "quest", "id=" + qid)
  return "Zadacha " + qid + " zakryta."
}

// ---------------------------------------------------------------------------
// 9. QuestSendPackage — честный отказ (НАРЯД #366 B.2)
//    Почтового контура в офисе нет: SMTP не поднят, Python-сторона MAIL-1
//    (коммит 5bea453) не дошла до продакшена. Роут /api/quest/send-package
//    отвечал 404, а паттерн докладывал «Paket otpravlen» — ложное
//    подтверждение отправки. Теперь — честный отказ, без мёртвого вызова.
// ---------------------------------------------------------------------------
pattern QuestSendPackage(qid: String, recipient: String, subject: String) -> String {
  let f_rows = query("SELECT COUNT(*) AS cnt FROM quest_files WHERE quest_id = ?1", [qid])
  let fcount = redact(to_string(json_get(f_rows[0], "cnt", "0")), "all")
  let _ = AuditLog("quest_send_unavailable", "quest", "id=" + qid + " to=" + recipient)
  return "Otpravka paketa pochtoy ne realizovana — pochtovogo kontura v ofise net (fajlov v dossye " + qid + ": " + fcount + ")."
}

// ---------------------------------------------------------------------------
// 10. QuestGenerateDocument — честный отказ (НАРЯД #366 B.2)
//    Генерация документов по шаблонам досье не реализована — роут
//    /api/quest/generate никогда не существовал. Мост на контур Visual
//    (/send-document, #361) — отдельное решение вне объёма наряда.
// ---------------------------------------------------------------------------
pattern QuestGenerateDocument(qid: String, tpl_name: String, data: String) -> String {
  // Имя параметра — tpl_name: параметр/подстрока с латинским именем шаблона
  // (t-word) коллизирует с шаблонным механизмом mlog 0.23 (__TEMPLATE_BODY_N)
  // — вызов паттерна с таким параметром/строкой ломает компиляцию (наряд #366)
  let _ = AuditLog("quest_generate_unavailable", "quest", "id=" + qid + " tpl=" + tpl_name)
  return "Generaciya dokumentov po shablonam dosse ne realizovana."
}
