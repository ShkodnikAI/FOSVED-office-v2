// test_n734v1.mlog — GENERATED by scripts/n734_fixture.py (#734 REPORT-2).
// Сегменты вырезаны из актуального dept/scheduler.mlog (не ручная копия).
// Транспорт — заглушки-INSERT'ы: проверки делает pytest по БД фикстуры.
// Запуск: N734_SCENARIO=arch|cap|reg DATABASE_URL=sqlite:/tmp/n734/t.db \
//   ./bin/mlog run test_n734v1.mlog
profile legacy { egress: permissive_with_audit }
db { url: env("DATABASE_URL") }
import dept/utils
import dept/skills  // #771 H: SkillFileRead

// ── заглушки транспорта ─────────────────────────────────────────────────
pattern SendTelegramReply(chat_id: String, text: String) -> String {
  let _ = query("INSERT INTO tg_calls (kind, text, url) VALUES ('tg', ?, '')", [text])
  return "()"
}

pattern SendReportMiniAppMessage(token: String, chat_id: String, text: String, miniapp_url: String, dept: String, doc_id: String) -> String {
  let _ = query("INSERT INTO tg_calls (kind, text, url) VALUES ('miniapp', ?, ?)", [text, miniapp_url])
  return "()"
}

pattern AuditLog(action: String, dept: String, details: String) -> String {
  let _ = query("INSERT INTO audit_log (action, dept, details) VALUES (?, ?, ?)", [action, dept, details])
  return "()"
}

pattern TgToken() -> String {
  return "fake-token"
}

pattern RenderUrl() -> String {
  return "http://miniapp.local"
}

pattern InitDB() -> String {
  let _ = db_execute("CREATE TABLE IF NOT EXISTS owner_outbox (id INTEGER PRIMARY KEY AUTOINCREMENT, created_at TEXT DEFAULT (datetime('now')), source TEXT NOT NULL, text TEXT NOT NULL, sent_at TEXT)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS miniapp_responses (id TEXT PRIMARY KEY, dept TEXT, title TEXT, query TEXT, raw_text TEXT, html TEXT, confidence TEXT, created_at TEXT)", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS audit_log (id INTEGER PRIMARY KEY AUTOINCREMENT, action TEXT, dept TEXT, details TEXT, timestamp TEXT DEFAULT (datetime('now')))", [])
  let _ = db_execute("CREATE TABLE IF NOT EXISTS tg_calls (id INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT, text TEXT, url TEXT)", [])
  return "ok"
}

// ── реальные сегменты из dept/scheduler.mlog ────────────────────────────
pattern OutboxMaxParts() -> Float {
  return 3.0
}


pattern OutboxFlush() -> String {
  let _ = InitDB()
  let dup_rows = query("SELECT COUNT(*) AS cnt FROM owner_outbox WHERE sent_at IS NOT NULL AND date(sent_at) = date('now')", [])
  let mut dup_cnt = 0.0
  each dr in dup_rows {
    let dup_cnt = to_float(json_get(dr, "cnt", "0"))
  }
  if dup_cnt > 0.0 then { return "outbox: already delivered today" }

  // #734 A.1: выборка с created_at и stale-флагом (DDL owner_outbox содержит
  // created_at — scheduler.mlog:561 и proxy/core.py:496, правило при
  // затруднении не сработало). Строки старше 48 ч не идут текстом — вместо
  // них один блок «— архив —»; полный текст (свежие + старые ЦЕЛИКОМ)
  // сохраняется в miniapp_responses (dept night) для кнопки Mini App.
  let rows = query("SELECT id, source, text, created_at, CASE WHEN created_at IS NOT NULL AND created_at < datetime('now','-48 hours') THEN 1 ELSE 0 END AS stale FROM owner_outbox WHERE sent_at IS NULL ORDER BY id", [])
  if length(rows) == 0.0 then { return "outbox: empty" }

  // №588 B.1: куски всех блоков режутся по абзацам (OutboxSplitChunks, ≤3400),
  // части собираются ТОЛЬКО вокруг кусков — пустая «часть 1» из одного
  // заголовка больше невозможна, кусок ≤3400 помещается в часть ≤3500.
  let mut all_json = ""
  let mut total = 0.0
  let mut full_text = ""
  each r in rows {
    let src = redact(to_string(json_get(r, "source", "?")), "all")
    let txt = to_string(json_get(r, "text", ""))
    let stale = redact(to_string(json_get(r, "stale", "0")), "all")
    let cat = to_string(json_get(r, "created_at", ""))
    if stale == "1" then {
      // #734 A.1: строка старше 48 ч — в архив (текст не идёт в сообщения)
      if length(full_text) > 0.0 then { let full_text = full_text + "\n\n" }
      let full_text = full_text + "— " + src + " — (" + cat + ")\n" + txt
    } else {
      let block = "— " + src + " —\n" + txt
      if length(full_text) > 0.0 then { let full_text = full_text + "\n\n" }
      let full_text = full_text + block
      let arr = parse_json(OutboxSplitChunks(block, 3400.0))
      each piece in arr {
        let pc = to_string(piece)
        if length(pc) > 0.0 then {
          let all_json = all_json + json_encode(pc) + ","
          let total = total + 1.0
        }
      }
    }
  }
  // #734 A.1: один архивный блок вместо текстов старых строк:
  // «— архив —\nN старых записей за <мин>–<макс>: <source>×k, …».
  // n/min/max и счёт по source — SQL-ом (строковые < в mlog нет).
  let arch_stats = query("SELECT COUNT(*) AS n, MIN(created_at) AS mn, MAX(created_at) AS mx FROM owner_outbox WHERE sent_at IS NULL AND created_at IS NOT NULL AND created_at < datetime('now','-48 hours')", [])
  let arch_n = to_float(redact(to_string(json_get(get(arch_stats, 0), "n", "0")), "all"))
  if arch_n > 0.0 then {
    let arch_min = to_string(json_get(get(arch_stats, 0), "mn", ""))
    let arch_max = to_string(json_get(get(arch_stats, 0), "mx", ""))
    let usage_rows = query("SELECT source, COUNT(*) AS k FROM owner_outbox WHERE sent_at IS NULL AND created_at IS NOT NULL AND created_at < datetime('now','-48 hours') GROUP BY source ORDER BY source", [])
    let mut usage = ""
    each u in usage_rows {
      let us = redact(to_string(json_get(u, "source", "?")), "all")
      let uk = to_float(redact(to_string(json_get(u, "k", "0")), "all"))
      if length(usage) > 0.0 then { let usage = usage + ", " }
      let usage = usage + us + "×" + to_string(to_int(uk))
    }
    let arch_line = to_string(to_int(arch_n)) + " старых записей за " + substring(arch_min, 0.0, 16.0) + "–" + substring(arch_max, 0.0, 16.0) + ": " + usage
    // старые строки ЦЕЛИКОМ — только в полный текст Mini App, не в Telegram
    let arch_block = "— архив —\n" + arch_line
    let arr2 = parse_json(OutboxSplitChunks(arch_block, 3400.0))
    each piece2 in arr2 {
      let pc2 = to_string(piece2)
      if length(pc2) > 0.0 then {
        let all_json = all_json + json_encode(pc2) + ","
        let total = total + 1.0
      }
    }
  }
  if total == 0.0 then { return "outbox: nothing deliverable" }
  let parts = parse_json("[" + substring(all_json, 0.0, length(all_json) - 1.0) + "]")

  // #734 A.2: сбор ПОЛНЫХ сообщений (заголовок+текст) в массив — отправка
  // отделена от сборки; разбиение по 3500 и заголовки — как раньше
  // (регрессия: 1–3 части уходят байт в байт).
  let mut msgs_json = ""
  let mut i = 0.0
  let mut part_no = 1.0
  let mut cur = ""
  while i < length(parts) {
    let piece = to_string(get(parts, i))
    if length(cur) + length(piece) + 2.0 > 3500.0 then {
      // закрыть часть — только если в ней есть хотя бы один кусок (№588: пустых частей нет)
      if length(cur) > 0.0 then {
        let header = "🌙 Ночной отчёт"
        if part_no > 1.0 then { let header = "🌙 Ночной отчёт (часть " + to_string(to_int(part_no)) + ")" }
        let msgs_json = msgs_json + json_encode(header + "\n" + cur) + ","
        let part_no = part_no + 1.0
      }
      let cur = piece
    } else {
      if length(cur) > 0.0 then { let cur = cur + "\n\n" + piece } else { let cur = piece }
    }
    let i = i + 1.0
  }
  if length(cur) > 0.0 then {
    let header = "🌙 Ночной отчёт"
    if part_no > 1.0 then { let header = "🌙 Ночной отчёт (часть " + to_string(to_int(part_no)) + ")" }
    let msgs_json = msgs_json + json_encode(header + "\n" + cur) + ","
  }
  let msgs = parse_json("[" + substring(msgs_json, 0.0, length(msgs_json) - 1.0) + "]")

  // #734 A.2: не больше OutboxMaxParts() сообщений. Меньше или равно — как
  // раньше. Больше — части 1–2 текстом, третье сообщение — capped-пометка с
  // кнопкой «Открыть отчёт» (SendReportMiniAppMessage, dept night): полный
  // текст (свежие + все старые строки целиком) — в miniapp_responses.
  if length(msgs) <= OutboxMaxParts() then {
    let mut k = 0.0
    while k < length(msgs) {
      let _ = SendTelegramReply(env("OWNER_TELEGRAM_ID"), to_string(get(msgs, k)))
      let k = k + 1.0
    }
    let _ = db_execute("UPDATE owner_outbox SET sent_at = datetime('now') WHERE sent_at IS NULL", [])
    let _ = AuditLog("owner_outbox_flush", "system", "delivered parts=" + to_string(to_int(length(msgs))) + " chunks=" + to_string(to_int(total)) + " rows=" + to_string(to_int(length(rows))))
    return "outbox: delivered"
  }

  // #734 A.2: capped-ветка — части 1..2 текстом как обычно, полный текст в
  // miniapp_responses тем же путём, что SendReport (та же схема INSERT +
  // SendReportMiniAppMessage с кнопкой)
  let send_n = OutboxMaxParts() - 1.0
  let mut k = 0.0
  while k < send_n {
    let _ = SendTelegramReply(env("OWNER_TELEGRAM_ID"), to_string(get(msgs, k)))
    let k = k + 1.0
  }
  let doc_id = "doc-night-" + to_string(now())
  let _ = TryVal(try query("INSERT INTO miniapp_responses (id, dept, title, query, raw_text, html, confidence, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, datetime('now'))", [doc_id, "night", "Ночной отчёт", "night report", full_text, "", ""]))
  let more = length(msgs) - OutboxMaxParts() + 1.0
  let capped_text = "🌙 Ночной отчёт (часть " + to_string(to_int(OutboxMaxParts())) + ")\nОтчёт не поместился: ещё " + to_string(to_int(more)) + " частей"
  let miniapp_url = RenderUrl() + "/miniapp/" + doc_id
  let _ = SendReportMiniAppMessage(TgToken(), env("OWNER_TELEGRAM_ID"), capped_text, miniapp_url, "night", doc_id)
  let _ = db_execute("UPDATE owner_outbox SET sent_at = datetime('now') WHERE sent_at IS NULL", [])
  let _ = AuditLog("owner_outbox_flush", "system", "delivered parts=" + to_string(to_int(OutboxMaxParts())) + " chunks=" + to_string(to_int(total)) + " rows=" + to_string(to_int(length(rows))) + " capped=1 archived_rows=" + to_string(to_int(arch_n)) + " doc=" + doc_id)
  return "outbox: delivered (capped)"
}

// №588 B.1: резка текста на куски ≤ max_len по абзацам "\n\n"; абзац длиннее
// max_len режется жёстко (substring, как _tg_split_report #567). Возвращает
// json_encode массива строк: mlog не строит списки динамически — строковый
// аккумулятор единственный; пустые куски не возвращаются никогда.

pattern OutboxSplitChunks(text: String, max_len: Float) -> String {
  let mut parts_json = ""
  let mut count = 0.0
  let paras = split(text, "\n\n")
  let mut cur = ""
  each p in paras {
    let par = to_string(p)
    if length(par) > 0.0 then {
      if length(par) > max_len then {
        if length(cur) > 0.0 then {
          let parts_json = parts_json + json_encode(cur) + ","
          let count = count + 1.0
          let cur = ""
        }
        let mut off = 0.0
        while off < length(par) {
          let piece = substring(par, off, off + max_len)
          if length(piece) > 0.0 then {
            let parts_json = parts_json + json_encode(piece) + ","
            let count = count + 1.0
          }
          let off = off + max_len
        }
      } else {
        if length(cur) + length(par) + 2.0 > max_len then {
          if length(cur) > 0.0 then {
            let parts_json = parts_json + json_encode(cur) + ","
            let count = count + 1.0
          }
          let cur = par
        } else {
          if length(cur) > 0.0 then { let cur = cur + "\n\n" + par } else { let cur = par }
        }
      }
    }
  }
  if length(cur) > 0.0 then {
    let parts_json = parts_json + json_encode(cur) + ","
    let count = count + 1.0
  }
  if count == 0.0 then { return "[]" }
  return "[" + substring(parts_json, 0.0, length(parts_json) - 1.0) + "]"
}

// ── №588 A.3: resume-маркеры ночного цикла (night_run_state) — повторный
// старт в ту же дату (catch-up после рестарта OOM) не повторяет выполненные
// фазы. DDL — в InitDB app.mlog. Three семантики:
//   NightPhaseDone(name) → "done"|"new" — чек до фазы (mark-after-run);
//   NightPhaseMark(name) — пометить выполненной (после успеха);
//   NightPhaseBegin(name) → "done"|"acquired" — at-most-once (ЛЗ в ночи —
//   не больше одного раза за дату, даже при сбое).

// ── сценарии данных ─────────────────────────────────────────────────────
pattern Main1(x: String) -> String {
  let _ = InitDB()
  let _ = db_execute("DELETE FROM tg_calls", [])
  let _ = db_execute("DELETE FROM audit_log", [])
  let _ = db_execute("DELETE FROM miniapp_responses", [])
  let _ = db_execute("DELETE FROM owner_outbox", [])
  let scen = env("N734_SCENARIO")
  if scen == "arch" then {
    // #734 A.1: 10 старых (SourceA×8, SourceB×2, 5 суток) + 2 свежих
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceA', 'старый блок 1', datetime('now','-120 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceA', 'старый блок 2', datetime('now','-118 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceA', 'старый блок 3', datetime('now','-116 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceA', 'старый блок 4', datetime('now','-114 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceA', 'старый блок 5', datetime('now','-112 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceA', 'старый блок 6', datetime('now','-110 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceA', 'старый блок 7', datetime('now','-108 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceA', 'старый блок 8', datetime('now','-106 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceB', 'старый блок 9', datetime('now','-104 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text, created_at) VALUES ('SourceB', 'старый блок 10', datetime('now','-102 hours'))", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text) VALUES ('SourceC', 'свежий блок C1 — отчёт по проекту')", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text) VALUES ('SourceC', 'свежий блок C2 — сборка зелёная')", [])
    return OutboxFlush()
  }
  if scen == "cap" then {
    // #734 A.2: 30 свежих длинных блоков → больше 3 частей
    let pad = ""
    let mut i = 0.0
    while i < 30.0 {
      let _ = db_execute("INSERT INTO owner_outbox (source, text) VALUES ('ФинОтдел', ?1)", ["Блок " + to_string(to_int(i)) + ": " + pad])
      let i = i + 1.0
    }
    return OutboxFlush()
  }
  if scen == "reg" then {
    // #734 A.3: регрессия — 5 свежих коротких блоков → 1 часть
    let _ = db_execute("INSERT INTO owner_outbox (source, text) VALUES ('S1', 'текст 1')", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text) VALUES ('S2', 'текст 2')", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text) VALUES ('S3', 'текст 3')", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text) VALUES ('S4', 'текст 4')", [])
    let _ = db_execute("INSERT INTO owner_outbox (source, text) VALUES ('S5', 'текст 5')", [])
    return OutboxFlush()
  }
  return "unknown scenario"
}

flow Main {
  input: String = "" -> Main1 -> output
}
