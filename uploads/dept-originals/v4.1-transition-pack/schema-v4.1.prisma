// ============================================================================
// ─── Эксперт — Technical Due Diligence ───
// ============================================================================

model ExpertBriefing {
  id             Int      @id @default(autoincrement())
  userId         Int      @default(0) @map("user_id")

  // Core:
  topic          String
  meetingContext String?  @db.Text @map("meeting_context")
  meetingDate    DateTime? @map("meeting_date")
  attendees      String?  @db.Text  // JSON list with roles
  depthLevel     Int      @default(2) @map("depth_level")  // 1 quick | 2 standard | 3 deep
  timeToMeeting  Int?     @map("time_to_meeting")  // hours

  status String @default("requested")
  // requested | research | drafted | briefing_ready | meeting_held | debriefed | archived

  // Phase 1 — Rapid Domain Immersion:
  domainImmersion String? @db.Text @map("domain_immersion")

  // Phase 2 — Project Deconstruction:
  projectDeconstruction String? @db.Text @map("project_deconstruction")

  // Phase 3 — Failure Modes Mapping:
  failureModes String? @db.Text @map("failure_modes")

  // Phase 4 — Combat Questions (main output):
  combatQuestions String? @db.Text @map("combat_questions")

  // Parallel — Bullshit Detection:
  bullshitDetection String? @db.Text @map("bullshit_detection")

  // Tier 2 outputs (loaded based on depth + topic):
  economicsValidation       String? @db.Text @map("economics_validation")
  peerReviewSimulation      String? @db.Text @map("peer_review_simulation")
  adjacentFieldCrossCheck   String? @db.Text @map("adjacent_field_cross_check")
  competingClaimsComparison String? @db.Text @map("competing_claims_comparison")

  // Tier 3 outputs (deep mode only):
  preMeetingIntel  String? @db.Text @map("pre_meeting_intel")
  tacticalProtocol String? @db.Text @map("tactical_protocol")

  // LDR-inspired iterative research:
  iterativeResearchLog String? @db.Text @map("iterative_research_log")
  // JSON: [{ iteration, query, findings, gaps_identified, citations }]

  // Final briefing document:
  briefingDocument String? @db.Text @map("briefing_document")
  combatCards      String? @db.Text @map("combat_cards")
  redFlagsCard     String? @db.Text @map("red_flags_card")

  // Cross-references:
  ospAnalysisLinks       Int[]                @map("osp_analysis_links")
  ospAnalyses            Analysis[]
  knowledgeArtifactLinks Int[]                @map("knowledge_artifact_links")
  knowledgeArtifacts     KnowledgeArtifact[]
  researchSources        ExpertBriefingResearchSource[]

  // Post-meeting debrief:
  debriefNotes    String?   @db.Text @map("debrief_notes")
  meetingHeldAt   DateTime? @map("meeting_held_at")
  meetingOutcome  String?   @map("meeting_outcome")
  // promising | uncertain | declined | needs_followup

  // Performance metrics:
  understandingScore Int?     @map("understanding_score")  // 1-5
  questionsHitRate   Float?   @map("questions_hit_rate")
  bullshitDetected   Boolean? @map("bullshit_detected")
  ownerConfidence    Int?     @map("owner_confidence")  // 1-5

  // Long-term outcome tracking:
  projectFollowupDate   DateTime? @map("project_followup_date")
  projectActualOutcome  String?   @map("project_actual_outcome")
  predictionAccuracy    String?   @db.Text @map("prediction_accuracy")

  // Cost tracking:
  timeInvested Int? @map("time_invested")  // minutes
  tokensUsed   Int? @map("tokens_used")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  briefingDeliveredAt DateTime? @map("briefing_delivered_at")
  archivedAt          DateTime? @map("archived_at")

  @@index([userId])
  @@index([topic])
  @@index([status])
  @@index([meetingDate])
  @@index([depthLevel])
  @@map("expert_briefings")
}

// ============================================================================
// ─── Research Engine — LDR-inspired Knowledge Base ───
// ============================================================================

model ResearchSource {
  id           Int      @id @default(autoincrement())
  userId       Int      @default(0) @map("user_id")

  url          String   @unique
  sourceType   String   @map("source_type")
  // peer_review | government | industry | news | blog | book | patent | other

  tier         Int      // 1-5; 1=peer-reviewed top-tier, 5=blog/forum

  title        String
  authors      String?  @db.Text
  publishedDate DateTime? @map("published_date")
  accessedAt   DateTime  @default(now()) @map("accessed_at")

  summary      String?  @db.Text
  keyClaims    String?  @db.Text @map("key_claims")
  // JSON: [{ claim, page_or_section, type: "fact"|"interpretation"|"speculation" }]

  topicTags    String   @default("[]") @map("topic_tags")  // JSON

  // Citation count:
  citedInBriefings Int @default(0) @map("cited_in_briefings")
  citedInAnalyses  Int @default(0) @map("cited_in_analyses")

  // Cross-references:
  briefingLinks ExpertBriefingResearchSource[]
  analysisLinks AnalysisResearchSource[]
  knowledgeArtifactLinks KnowledgeArtifactResearchSource[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([sourceType])
  @@index([tier])
  @@index([accessedAt(sort: Desc)])
  @@index([citedInBriefings])
  @@map("research_sources")
}

// ─── Junction tables for many-to-many ResearchSource references ───
model ExpertBriefingResearchSource {
  briefingId Int @map("briefing_id")
  sourceId   Int @map("source_id")
  citation   String? @db.Text  // how the source was cited in this briefing
  createdAt  DateTime @default(now()) @map("created_at")

  briefing ExpertBriefing @relation(fields: [briefingId], references: [id], onDelete: Cascade)
  source   ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([briefingId, sourceId])
  @@map("expert_briefing_research_sources")
}

model AnalysisResearchSource {
  analysisId Int @map("analysis_id")
  sourceId   Int @map("source_id")
  layer      String?  // which level (leaves/branches/stem/roots/fruits) it was used in
  citation   String? @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  analysis Analysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  source   ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([analysisId, sourceId])
  @@map("analysis_research_sources")
}

model KnowledgeArtifactResearchSource {
  artifactId Int @map("artifact_id")
  sourceId   Int @map("source_id")
  section    String?  // which section it informed
  citation   String? @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  artifact KnowledgeArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  source   ResearchSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([artifactId, sourceId])
  @@map("knowledge_artifact_research_sources")
}

