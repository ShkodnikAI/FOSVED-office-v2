// ============================================================================
// schema-v4.1.prisma — Fosved Office v4.1 Complete Database Schema
// ============================================================================
//
// This is the TARGET schema after Phase 1 migration. Replaces existing
// schema.prisma in fosved-bot/prisma/.
//
// CHANGES FROM v3 (current production):
//   - DROP V1 OSP models (replaced with V2): Analysis, AnalysisIndicator,
//     AnalysisVerification, MonthlyReview, QuarterlyMethodologyReview,
//     WatchTopic — ALL DATA IS PLACEHOLDER, drop and recreate
//   - PRESERVE: Settings (with STT/TTS keys), all schema for Conversation,
//     Client, Project, Task, Invoice, Document, TeamMember, DriveFile, etc.
//   - ADD userId field to entities for multi-user readiness (default OWNER_ID)
//   - ADD OSP V2 models: Analysis (enhanced), WatchlistScenario,
//     MonthlyReview, QuarterlyReview, ArsenalReview, ParadigmReview,
//     AsymmetricBet, Profile, MacroRegimeSnapshot, CrossAssetDivergence,
//     IndicatorActivation
//   - ADD Knowledge Lab models: KnowledgeArtifact, TalentFlowEvent,
//     VCFundingEvent, LZMonthlyReview, LZQuarterlyReview, LZWatchlist
//   - ADD Expert models: ExpertBriefing
//   - ADD Research engine model: ResearchSource (LDR-inspired KB)
//   - EXTEND DriveFile: tags, parentFolder, thumbnailUrl, linkedAnalysisId,
//     linkedBriefingId
//   - DROP placeholder data: clean slate for all tables except Settings
//
// OWNER_ID default: 0 (set everywhere via @default)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User (placeholder for multi-user future) ───
// Not used in v4.1 logic but referenced via userId fields everywhere.
// In future, will replace OWNER_ID hardcoding.
model User {
  id        Int      @id @default(autoincrement())
  telegramId BigInt  @unique @map("telegram_id")
  name      String?
  role      String   @default("owner")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

// ─── Core conversation ───
model Conversation {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(0) @map("user_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("conversations")
}

// ─── Client (Entity with Knowledge Graph support) ───
model Client {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(0) @map("user_id")
  name            String
  company         String?
  email           String?
  phone           String?
  notes           String?  @db.Text
  status          String   @default("active")
  tier            Int      @default(3)
  tags            String   @default("[]")
  mentionCount    Int      @default(0) @map("mention_count")
  compiledProfile String?  @db.Text @map("compiled_profile")
  lastEnrichedAt  DateTime? @map("last_enriched_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  invoices  Invoice[]
  documents Document[]
  projects  Project[]
  timeline  ClientTimeline[]
  linksFrom EntityLink[] @relation("FromLinks")
  linksTo   EntityLink[] @relation("ToLinks")
  analyses  Analysis[]

  @@unique([userId, name])
  @@index([userId])
  @@index([status])
  @@index([tier])
  @@index([mentionCount(sort: Desc)])
  @@map("clients")
}

// ─── Client Timeline (Compiled Truth: append-only chronology) ───
model ClientTimeline {
  id        Int      @id @default(autoincrement())
  clientId  Int      @map("client_id")
  type      String
  summary   String
  detail    String?  @db.Text
  source    String?
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([clientId, date(sort: Desc)])
  @@map("client_timeline")
}

// ─── Entity Link (Knowledge Graph: typed edges) ───
model EntityLink {
  id           Int      @id @default(autoincrement())
  fromType     String
  fromId       Int
  toType       String
  toId         Int
  linkType     String
  context      String?  @db.Text
  weight       Float    @default(1.0)
  mentionCount Int      @default(1) @map("mention_count")
  createdAt    DateTime @default(now()) @map("created_at")

  fromClient Client? @relation("FromLinks", fields: [fromId], references: [id], onDelete: Cascade)
  toClient   Client? @relation("ToLinks", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromType, fromId])
  @@index([toType, toId])
  @@index([linkType])
  @@index([mentionCount(sort: Desc)])
  @@unique([fromType, fromId, toType, toId, linkType])
  @@map("entity_links")
}

// ─── Project ───
model Project {
  id         Int      @id @default(autoincrement())
  userId     Int      @default(0) @map("user_id")
  name       String
  status     String   @default("active")
  type       String   @default("razovyy")
  progress   Int      @default(0)
  priority   String   @default("green")
  deadline   String?
  annotation String?
  team       String   @default("[]")
  clientId   Int?     @map("client_id")
  createdAt  DateTime @default(now()) @map("created_at")

  messages ProjectMessage[]
  tasks    Task[]
  client   Client?   @relation(fields: [clientId], references: [id])
  analyses Analysis[]

  @@index([userId])
  @@index([userId, status])
  @@map("projects")
}

// ─── Project Messages ───
model ProjectMessage {
  id        Int      @id @default(autoincrement())
  projectId Int      @map("project_id")
  role      String
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("project_messages")
}

// ─── Task ───
model Task {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(0) @map("user_id")
  title     String
  projectId Int?     @map("project_id")
  agent     String   @default("Управление")
  priority  String   @default("green")
  deadline  String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id])

  @@index([userId])
  @@index([userId, done])
  @@map("tasks")
}

// ─── Settings (PRESERVED through migration — STT/TTS keys) ───
model Settings {
  userId         Int      @id @default(0) @map("user_id")
  activeModel    String   @default("claude") @map("active_model")
  morningDigest  Boolean  @default(true) @map("morning_digest")
  digestHour     Int      @default(9) @map("digest_hour")
  digestDays     String   @default("[1,2,3,4,5]") @map("digest_days")
  createdAt      DateTime @default(now()) @map("created_at")
  // STT/TTS API ключи (preserved through v4.1 migration)
  groqApiKey     String?  @map("groq_api_key")
  deepgramApiKey String?  @map("deepgram_api_key")
  minimaxApiKey  String?  @map("minimax_api_key")
  ttsVoice       String?  @map("tts_voice") @default("male-qn-qingse")
  sttLanguage    String?  @map("stt_language") @default("ru")

  @@map("settings")
}

// ─── Invoice ───
model Invoice {
  id          Int      @id @default(autoincrement())
  userId      Int      @default(0) @map("user_id")
  number      String   @unique
  client      String
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("EUR")
  description String?
  status      String   @default("pending")
  dueDate     String?  @map("due_date")
  clientId    Int?     @map("client_id")
  createdAt   DateTime @default(now()) @map("created_at")

  clientRel Client? @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@map("invoices")
}

// ─── Document ───
model Document {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(0) @map("user_id")
  type      String
  title     String
  client    String?
  content   String?
  status    String   @default("draft")
  clientId  Int?     @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")

  clientRel Client? @relation(fields: [clientId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@map("documents")
}

// ─── Team Member ───
model TeamMember {
  id        Int      @id @default(autoincrement())
  userId    Int      @default(0) @map("user_id")
  name      String
  role      String   @default("Специалист")
  telegram  String?
  email     String?
  skills    String   @default("[]")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("team_members")
}

// ─── Drive File (extended: tags, folders, thumbnails, cross-links) ───
model DriveFile {
  id                Int      @id @default(autoincrement())
  userId            Int      @default(0) @map("user_id")
  filename          String
  folder            String   @default("Общие")          // legacy, kept for compatibility
  parentFolder      String?  @map("parent_folder")      // new: hierarchical folder path
  mimeType          String   @default("")
  size              Int      @default(0)
  telegramMessageId Int?     @map("telegram_message_id")
  telegramFileId    String?  @map("telegram_file_id")
  caption           String?
  // v4.1 additions:
  tags              String   @default("[]")             // JSON array of tags
  thumbnailUrl      String?  @map("thumbnail_url")      // for image previews in drive-screen
  linkedAnalysisId  Int?     @map("linked_analysis_id") // crosslink to OSP Analysis
  linkedBriefingId  Int?     @map("linked_briefing_id") // crosslink to ExpertBriefing
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, parentFolder])
  @@index([linkedAnalysisId])
  @@index([linkedBriefingId])
  @@map("drive_files")
}

// ─── Search Log (analytics) ───
model SearchLog {
  id           Int      @id @default(autoincrement())
  userId       Int      @default(0) @map("user_id")
  query        String
  resultsCount Int      @default(0) @map("results_count")
  clickedType  String?  @map("clicked_type")
  clickedId    Int?     @map("clicked_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([query])
  @@index([createdAt(sort: Desc)])
  @@map("search_logs")
}

// ─── Job Queue (Postgres-backed reliable queue) ───
model JobQueue {
  id          Int       @id @default(autoincrement())
  type        String
  payload     String?   @db.Text
  status      String    @default("pending")
  priority    Int       @default(5)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  runAfter    DateTime  @default(now()) @map("run_after")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  error       String?   @db.Text
  result      String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([status, runAfter])
  @@index([type])
  @@map("job_queue")
}

// ============================================================================
// ─── ОСП V2 — Strategic Planning Department v2 ───
// 5-level topology: leaves / branches / stem / roots / fruits
// Forces & potentials: P = A × R × S × L × E
// Two-paths-synthesis at bifurcation points
// ============================================================================

model Analysis {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(0) @map("user_id")
  topic           String
  topicSlug       String?  @map("topic_slug")
  mode            String   @default("full")     // full | quick | followup
  status          String   @default("drafted")  // drafted | published | watching | verified | missed | partial | superseded

  sources         String   @default("[]")  @db.Text
  skillsLoaded    String   @default("[]")  @map("skills_loaded")  @db.Text

  // V2 5-level topology (replaces V1 12-layer):
  fullAnalysis    String?  @db.Text @map("full_analysis")
  leaves          String?  @db.Text  // visible recent events
  branches        String?  @db.Text  // active processes / dynamics
  stem            String?  @db.Text  // institutional structures
  roots           String?  @db.Text  // underlying conditions (economy, demography, geography)
  fruits          String?  @db.Text  // anticipated outcomes / actor goals

  // Forces and potentials (V2):
  forcesAnalysis  String?  @db.Text @map("forces_analysis")
  // JSON: [{ actor, A, R, S, L, E, E_modifier, total_P, notes }]

  // Two-paths-synthesis (V2):
  bifurcationPoints String? @db.Text @map("bifurcation_points")
  // JSON: [{ description, pathA, pathB, triggers, probabilities }]

  // Scenarios (still core):
  scenarios       String   @default("[]") @db.Text
  // JSON: [{ label, probability (0-1), description, pre-conditions }]

  // Premortems:
  premortem3mo    String?  @db.Text @map("premortem_3mo")
  premortem12mo   String?  @db.Text @map("premortem_12mo")

  // Calibration:
  confidence       String   @default("medium") // low | medium | high
  confidenceReason String?  @db.Text @map("confidence_reason")
  verificationDate DateTime? @map("verification_date")
  watchUntil       DateTime? @map("watch_until")

  // Red team:
  redTeamAnalysis String?  @db.Text @map("red_team_analysis")
  redTeamOutcome  String?  @map("red_team_outcome")
  redTeamRunAt    DateTime? @map("red_team_run_at")

  // Bias tracking:
  biasesDetected  String   @default("[]") @map("biases_detected")
  biasesAddressed String   @default("[]") @map("biases_addressed")

  // Cross-references:
  supersededById Int?     @map("superseded_by_id")
  supersededBy   Analysis? @relation("AnalysisSupersedes", fields: [supersededById], references: [id])
  supersedes     Analysis[] @relation("AnalysisSupersedes")
  parentId       Int?     @map("parent_id")
  parent         Analysis? @relation("AnalysisFollowUp", fields: [parentId], references: [id])
  children       Analysis[] @relation("AnalysisFollowUp")

  clientId   Int?     @map("client_id")
  projectId  Int?     @map("project_id")
  client     Client?  @relation(fields: [clientId], references: [id])
  project    Project? @relation(fields: [projectId], references: [id])

  // Cross-reference to ExpertBriefings that draw from this Analysis:
  expertBriefings ExpertBriefing[]

  // ResearchSource link table:
  researchSources AnalysisResearchSource[]

  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  scenarioWatch    WatchlistScenario[]
  verifications    AnalysisVerification[]
  indicatorActivations IndicatorActivation[]

  @@index([userId])
  @@index([status])
  @@index([verificationDate])
  @@index([status, verificationDate])
  @@index([topicSlug])
  @@index([createdAt(sort: Desc)])
  @@index([clientId])
  @@map("analysis")
}

// ─── Watchlist Scenario (binary indicators per scenario, time-bounded) ───
// V2 enhancement: indicators tied to scenarios, not flat
model WatchlistScenario {
  id              Int      @id @default(autoincrement())
  analysisId      Int      @map("analysis_id")
  scenarioLabel   String   @map("scenario_label")
  description     String   @db.Text
  observableSource String  @map("observable_source")
  threshold       String?  @db.Text
  windowStart     DateTime? @map("window_start")
  windowEnd       DateTime  @map("window_end")
  status          String   @default("pending")  // pending | triggered | expired
  triggeredAt     DateTime? @map("triggered_at")
  triggeredNote   String?  @db.Text @map("triggered_note")
  createdAt       DateTime @default(now()) @map("created_at")

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([status])
  @@index([windowEnd])
  @@map("watchlist_scenarios")
}

// ─── Analysis Verification (Brier scoring per forecast) ───
model AnalysisVerification {
  id         Int      @id @default(autoincrement())
  analysisId Int      @map("analysis_id")

  scenarioOutcomes String @db.Text @map("scenario_outcomes")
  // JSON: { scenarioLabel: actualOutcome (true/false/partial) }

  brierScores String @db.Text @map("brier_scores")
  // JSON: { scenarioLabel: brier_score }

  brierTotal Float @map("brier_total")

  errorCategory       String? @map("error_category") // tail | miscalibrated | analysis_wrong | unfalsifiable
  errorNote           String? @db.Text @map("error_note")
  improvementsForNext String? @db.Text @map("improvements_for_next")

  biasesActiveInAnalysis String @default("[]") @map("biases_active_in_analysis")

  indicatorsTriggered Int @default(0) @map("indicators_triggered")
  indicatorsTotal     Int @default(0) @map("indicators_total")

  verifiedAt DateTime @default(now()) @map("verified_at")
  verifiedBy String   @default("system") @map("verified_by")

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([verifiedAt(sort: Desc)])
  @@index([brierTotal])
  @@map("analysis_verifications")
}

// ─── Indicator Activation (when an external indicator triggers, link it) ───
model IndicatorActivation {
  id              Int      @id @default(autoincrement())
  analysisId      Int      @map("analysis_id")
  indicatorName   String   @map("indicator_name")
  observedAt      DateTime @map("observed_at")
  observedValue   String?  @db.Text @map("observed_value")
  source          String?
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([observedAt(sort: Desc)])
  @@map("indicator_activations")
}

// ─── Monthly Performance Review (OSP V2) ───
model MonthlyReview {
  id                  Int      @id @default(autoincrement())
  userId              Int      @default(0) @map("user_id")
  yearMonth           String   @map("year_month")  // "2026-05"

  forecastsVerified   Int     @default(0) @map("forecasts_verified")
  brierAverage        Float?  @map("brier_average")
  brierTrend          Float?  @map("brier_trend")
  hitRateHighConf     Float?  @map("hit_rate_high_conf")
  surpriseIndex       Float?  @map("surprise_index")

  calibrationCurve    String  @default("[]") @db.Text @map("calibration_curve")
  // JSON: [{ probabilityBand: [low, high], predicted_count, actual_count }]

  errorClusters       String? @db.Text @map("error_clusters")
  dominantError       String? @map("dominant_error")

  improvements        String  @default("[]") @db.Text
  improvementsApplied Boolean @default(false) @map("improvements_applied")

  flagsForQuarterly   String? @db.Text @map("flags_for_quarterly")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, yearMonth])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("monthly_reviews")
}

// ─── Quarterly Methodology Review (OSP V2) ───
model QuarterlyReview {
  id          Int      @id @default(autoincrement())
  userId      Int      @default(0) @map("user_id")
  yearQuarter String   @map("year_quarter")  // "2026-Q2"

  monthlyReviewsIncluded String  @default("[]") @map("monthly_reviews_included") @db.Text
  persistentPatterns     String? @db.Text @map("persistent_patterns")
  methodologicalGaps     String? @db.Text @map("methodological_gaps")

  skillsUpdated    String  @default("[]") @map("skills_updated")
  skillsAdded      String  @default("[]") @map("skills_added")
  skillsDeprecated String  @default("[]") @map("skills_deprecated")

  reviewNote String?  @db.Text @map("review_note")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, yearQuarter])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("quarterly_reviews")
}

// ─── Semi-annual Arsenal Review (V2 specific — toolkit assessment) ───
model ArsenalReview {
  id          Int      @id @default(autoincrement())
  userId      Int      @default(0) @map("user_id")
  yearHalf    String   @map("year_half")  // "2026-H1"

  skillsInUse        String  @default("[]") @map("skills_in_use") @db.Text
  skillsUnderused    String  @default("[]") @map("skills_underused") @db.Text
  skillsObsolete     String  @default("[]") @map("skills_obsolete") @db.Text
  skillsToAdd        String  @default("[]") @map("skills_to_add") @db.Text
  toolingChanges     String? @db.Text @map("tooling_changes")
  newSourcesAdded    String? @db.Text @map("new_sources_added")
  reviewNote         String? @db.Text @map("review_note")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([userId, yearHalf])
  @@index([userId])
  @@map("arsenal_reviews")
}

// ─── Bi-annual Paradigm Review (V2 specific — fundamental frame check) ───
model ParadigmReview {
  id          Int      @id @default(autoincrement())
  userId      Int      @default(0) @map("user_id")
  yearBiAnnual String  @map("year_biannual")  // "2026-2027"

  paradigmAssumptions String  @db.Text @map("paradigm_assumptions")
  // JSON: [{ assumption, status: "validated"|"weakened"|"falsified", evidence }]

  emergingFrames    String? @db.Text @map("emerging_frames")
  paradigmShifts    String? @db.Text @map("paradigm_shifts")
  reviewNote        String? @db.Text @map("review_note")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([userId, yearBiAnnual])
  @@index([userId])
  @@map("paradigm_reviews")
}

// ─── Asymmetric Bet (V2 — explicit asymmetric bet records) ───
model AsymmetricBet {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(0) @map("user_id")
  thesis          String   @db.Text
  costEstimate    Decimal? @db.Decimal(15, 2) @map("cost_estimate")
  payoffEstimate  Decimal? @db.Decimal(15, 2) @map("payoff_estimate")
  asymmetryRatio  Float?   @map("asymmetry_ratio")
  probabilityWin  Float?   @map("probability_win")
  watchIndicators String   @default("[]") @db.Text @map("watch_indicators")
  status          String   @default("identified")  // identified | acted | passed | won | lost
  outcomeNote     String?  @db.Text @map("outcome_note")
  createdAt       DateTime @default(now()) @map("created_at")
  closedAt        DateTime? @map("closed_at")

  @@index([userId])
  @@index([status])
  @@map("asymmetric_bets")
}

// ─── Profile (deep profile of an actor — OSP V2 deep_profiling skill output) ───
model Profile {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(0) @map("user_id")
  subjectName     String   @map("subject_name")
  subjectType     String   @map("subject_type")  // person | organization | country | concept
  fullProfile     String?  @db.Text @map("full_profile")
  decisionStyle   String?  @db.Text @map("decision_style")
  pressurePoints  String?  @db.Text @map("pressure_points")
  trackRecord     String?  @db.Text @map("track_record")
  recentMoves     String?  @db.Text @map("recent_moves")
  lastUpdatedAt   DateTime @default(now()) @map("last_updated_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, subjectName])
  @@index([userId])
  @@map("profiles")
}

// ─── Macro Regime Snapshot (OSP V2 macro-regime-id skill output) ───
model MacroRegimeSnapshot {
  id          Int      @id @default(autoincrement())
  userId      Int      @default(0) @map("user_id")
  date        DateTime @default(now())
  region      String   @default("global")
  regime      String  // expansion | slowdown | contraction | recovery
  regimeNotes String?  @db.Text @map("regime_notes")
  cpiTrend    String?  @map("cpi_trend")
  rateTrend   String?  @map("rate_trend")
  liquidityTrend String? @map("liquidity_trend")
  riskAssetSentiment String? @map("risk_asset_sentiment")
  signalStrength Float? @map("signal_strength")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([date(sort: Desc)])
  @@map("macro_regime_snapshots")
}

// ─── Cross Asset Divergence (OSP V2 cross-asset-divergence skill) ───
