// ============================================================================
// ─── ЛЗ — Knowledge Lab ───
// Continuous technology scanning, hype-cycle, disruption probability
// ============================================================================

model KnowledgeArtifact {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(0) @map("user_id")
  topic           String
  topicSlug       String   @map("topic_slug")
  status          String   @default("scanning")  // scanning | tracking | maturing | productized | disrupting | obsolete

  // Hype cycle position (Gartner-inspired):
  hypePosition    String?  @map("hype_position")
  // trigger | peak_inflated_expectations | trough_disillusionment |
  // slope_enlightenment | plateau_productivity

  disruptionProbability Float?  @map("disruption_probability")  // 0-1
  disruptionTimeline    String? @map("disruption_timeline")     // "12-24 months"
  inflectionDetected    Boolean @default(false) @map("inflection_detected")

  // Skills loaded for the artifact:
  skillsLoaded String @default("[]") @map("skills_loaded") @db.Text

  // Scan output sections (mapped to ЛЗ skills):
  fullProfile         String? @db.Text @map("full_profile")
  hypeCycleAnalysis   String? @db.Text @map("hype_cycle_analysis")
  disruptionAnalysis  String? @db.Text @map("disruption_analysis")
  oobMapping          String? @db.Text @map("oob_mapping")  // technology order of battle
  competingAlternatives String? @db.Text @map("competing_alternatives")
  patentLandscape     String? @db.Text @map("patent_landscape")
  vcFlows             String? @db.Text @map("vc_flows")
  talentFlows         String? @db.Text @map("talent_flows")
  crossDomainTransfer String? @db.Text @map("cross_domain_transfer")

  // Tracking:
  lastScannedAt DateTime? @map("last_scanned_at")
  watchedSince  DateTime? @map("watched_since")
  watchUntil    DateTime? @map("watch_until")

  // Relations:
  researchSources KnowledgeArtifactResearchSource[]
  expertBriefings ExpertBriefing[]
  talentEvents    TalentFlowEvent[]
  vcEvents        VCFundingEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, topicSlug])
  @@index([userId])
  @@index([status])
  @@index([disruptionProbability])
  @@index([inflectionDetected])
  @@map("knowledge_artifacts")
}

