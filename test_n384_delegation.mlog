// test_n384_delegation.mlog — Наряд #384: живая проба делегирования Яны.
// Таблица slug → гейт-2 → диспетчер: все 12 slug'ов проходят гейт-2 И
// резолвятся диспетчером YanaCheckDelegate (единый источник office#359);
// admin — честно блокируется В ОБОИХ местах (сознательное исключение,
// AGENTS.md §3): гейт даёт ОТКАЗ, диспетчер возвращает "".
//
// Запуск: ./bin/mlog run test_n384_delegation.mlog (cwd = корень репо)

profile legacy { egress: permissive_with_audit }

// №523 (0.28.0): run требует резолюции КАЖДОГО вызова. Стенд изолированный:
// импортируется ТОЛЬКО dept/yana; все внешние зависимости (utils/context/
// app) — stub'ы с арностями из мест вызова, сетевые/БД-эффекты отключены.
// Живые импорты utils/context недопустимы: ихAuditLog/GetCorrections ходят
// в БД — рантайм-отказ без соединения (проверено на обоих бинарях).
import dept/yana

pattern SendTelegramReply(chat_id: String, text: String) -> String {
  return ""
}

pattern CallLLMProxy(dept: String, messages: String) -> String {
  return ""
}

pattern GetBudgetedHistory(chat_id: String, limit: String, max_tokens_str: String, dept: String) -> String {
  return ""
}

pattern RecordAssistantMessage(chat_id: String, dept: String, text: String) -> String {
  return ""
}

pattern TryVal(x: String) -> String { return "" }

pattern AuditLog(action: String, dept: String, details: String) -> String { return "" }

pattern ReadDeptProfile(dept: String) -> String { return "" }

pattern SelectSkillsByKeywords(dept: String, query: String) -> String { return "" }

// Хвост зависимостей dept/context, живущих в app.mlog.
pattern GetInjectedContext(p1: String) -> String { return "" }
pattern GetSteerContext(p1: String) -> String { return "" }
pattern ReadConsensus() -> String { return "" }
pattern RecallLearnings(p1: String, p2: String) -> String { return "" }
pattern GetExpertPersona(p1: String) -> String { return "" }
pattern GetBrandContract() -> String { return "" }
pattern ResolveSubAgent(p1: String, p2: String) -> String { return "" }

pattern GetCorrections(p1: String) -> String { return "" }

pattern GetFacts(p1: String, p2: String) -> String { return "" }

pattern TraceLog(p1: String, p2: String) -> String { return "" }


pattern _Mark(name: String, ok: Bool) -> String {
  if ok then { return "PASS " + name + "\n" }
  return "FAILED " + name + "\n"
}

pattern Main1(_tick: String) -> String {
  let mut out = ""

  // ── 12 валидных slug'ов: гейт PASS, диспетчер резолвит ──
  let d01 = YanaGateDelegationIntegrity("x [DELEGATE: osp] y")
  let out = out + _Mark("g01_osp_gate_pass", contains(d01, "PASS"))
  let out = out + _Mark("d01_osp_dispatcher", YanaCheckDelegate("x [DELEGATE: osp] y") == "osp")

  let d02 = YanaGateDelegationIntegrity("[DELEGATE: lz]")
  let out = out + _Mark("g02_lz_gate_pass", contains(d02, "PASS"))
  let out = out + _Mark("d02_lz_dispatcher", YanaCheckDelegate("[DELEGATE: lz]") == "lz")

  let d03 = YanaGateDelegationIntegrity("[DELEGATE: expert]")
  let out = out + _Mark("g03_expert_gate_pass", contains(d03, "PASS"))
  let out = out + _Mark("d03_expert_dispatcher", YanaCheckDelegate("[DELEGATE: expert]") == "expert")

  let d04 = YanaGateDelegationIntegrity("[DELEGATE: marketing]")
  let out = out + _Mark("g04_marketing_gate_pass", contains(d04, "PASS"))
  let out = out + _Mark("d04_marketing_dispatcher", YanaCheckDelegate("[DELEGATE: marketing]") == "marketing")

  let d05 = YanaGateDelegationIntegrity("[DELEGATE: finance]")
  let out = out + _Mark("g05_finance_gate_pass", contains(d05, "PASS"))
  let out = out + _Mark("d05_finance_dispatcher", YanaCheckDelegate("[DELEGATE: finance]") == "finance")

  let d06 = YanaGateDelegationIntegrity("[DELEGATE: legal]")
  let out = out + _Mark("g06_legal_gate_pass", contains(d06, "PASS"))
  let out = out + _Mark("d06_legal_dispatcher", YanaCheckDelegate("[DELEGATE: legal]") == "legal")

  let d07 = YanaGateDelegationIntegrity("[DELEGATE: dev]")
  let out = out + _Mark("g07_dev_gate_pass", contains(d07, "PASS"))
  let out = out + _Mark("d07_dev_dispatcher", YanaCheckDelegate("[DELEGATE: dev]") == "dev")

  let d08 = YanaGateDelegationIntegrity("[DELEGATE: design]")
  let out = out + _Mark("g08_design_gate_pass", contains(d08, "PASS"))
  let out = out + _Mark("d08_design_dispatcher", YanaCheckDelegate("[DELEGATE: design]") == "design")

  let d09 = YanaGateDelegationIntegrity("[DELEGATE: qa]")
  let out = out + _Mark("g09_qa_gate_pass", contains(d09, "PASS"))
  let out = out + _Mark("d09_qa_dispatcher", YanaCheckDelegate("[DELEGATE: qa]") == "qa")

  let d10 = YanaGateDelegationIntegrity("[DELEGATE: visual]")
  let out = out + _Mark("g10_visual_gate_pass", contains(d10, "PASS"))
  let out = out + _Mark("d10_visual_dispatcher", YanaCheckDelegate("[DELEGATE: visual]") == "visual")

  let d11 = YanaGateDelegationIntegrity("[DELEGATE: engineering]")
  let out = out + _Mark("g11_engineering_gate_pass", contains(d11, "PASS"))
  let out = out + _Mark("d11_engineering_dispatcher", YanaCheckDelegate("[DELEGATE: engineering]") == "engineering")

  let d12 = YanaGateDelegationIntegrity("[DELEGATE: kavalnya]")
  let out = out + _Mark("g12_kavalnya_gate_pass", contains(d12, "PASS"))
  let out = out + _Mark("d12_kavalnya_dispatcher", YanaCheckDelegate("[DELEGATE: kavalnya]") == "kavalnya")

  // ── admin: сознательно исключён — блокируется В ОБОИХ местах (office#359) ──
  let da = YanaGateDelegationIntegrity("[DELEGATE: admin] сделать то-то")
  let out = out + _Mark("ga_admin_gate_denies", contains(da, "ОТКАЗ"))
  let out = out + _Mark("da_admin_dispatcher_empty", YanaCheckDelegate("[DELEGATE: admin]") == "")

  // ── негатив: несуществующий slug блокируется ──
  let dg = YanaGateDelegationIntegrity("[DELEGATE: ghost_dept]")
  let out = out + _Mark("gn_ghost_gate_denies", contains(dg, "ОТКАЗ"))
  let out = out + _Mark("dn_ghost_dispatcher_empty", YanaCheckDelegate("[DELEGATE: ghost_dept]") == "")

  // ── единый источник: гейт и диспетчер читают один список (office#359) ──
  let out = out + _Mark("s01_single_source_by_construction", YanaCheckDelegate("[DELEGATE: osp]") == YanaDelegateTarget("[DELEGATE: osp]"))

  return out
}

flow Main { input: String = "" -> Main1 -> output }
