// ============================================================================
// engineering-schema.prisma — Engineering Department schema additions
// ============================================================================
//
// APPEND these models to existing prisma/schema.prisma (do not replace).
// Adds 5 new models for the Engineering (Инженерный) department:
//
//   EngineeringCalculation             — a calculation with discipline, norms,
//                                        load cases, result, review status
//   NormReference                      — catalogue of applied norms
//   DesignReview                       — sanity-check of third-party / internal calcs
//   EngineeringCalculationVerification — calc verification (vs engineer / reality)
//   EngineeringMonthlyReview           — aggregated monthly performance review
//
// Does NOT modify any existing models. Append-only, snake_case @@map,
// userId default 2044005421 — same conventions as the other dept schemas.
// ============================================================================

// ─── EngineeringCalculation ──────────────────────────────────────────────────

model EngineeringCalculation {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(2044005421) @map("user_id")

  // Task definition
  title           String
  discipline      String   // structural | hydraulic | power_electronics
  taskDescription String   @db.Text @map("task_description")
  objectType      String?  @map("object_type")  // roof | greenhouse | lift | inverter | etc.

  // Norm base (hard rule 2 — mandatory before calculation)
  normSystem      String?  @map("norm_system")   // RF | eurocode | iec | iso | mixed
  normsApplied    String   @default("[]") @db.Text @map("norms_applied")
  // JSON: [{ code, title, edition, what_it_governs }]

  // Input data (hard rule 9 — uncertainty made explicit)
  inputData       String   @default("[]") @db.Text @map("input_data")
  // JSON: [{ parameter, value, unit, certainty: "known|assumed|provisional" }]
  dataComplete    Boolean  @default(false) @map("data_complete")
  missingData     String?  @db.Text @map("missing_data")

  // Load cases (hard rule 3 — mandatory)
  loadCases       String   @default("[]") @db.Text @map("load_cases")
  // JSON: [{ caseName, type: "permanent|live|snow|wind|operational|emergency", value, unit }]

  // Assumptions (hard rule 5 — every assumption recorded, all conservative)
  assumptions     String   @default("[]") @db.Text

  // Calculation result
  method          String?  @db.Text  // calculation method per the norm
  resultSummary   String?  @db.Text @map("result_summary")
  resultDetails   String?  @db.Text @map("result_details")  // full working

  // Safety factor (hard rule 4)
  safetyFactor    Float?   @map("safety_factor")
  safetyFactorRequired Float? @map("safety_factor_required")  // per the norm
  safetyFactorOk  Boolean? @map("safety_factor_ok")

  // Verdict (hard rule 10 — stated plainly)
  verdict         String?  // passes | fails | conditional | needs_more_data

  // Independent verification (hard rule 7)
  verificationMethod String? @db.Text @map("verification_method")
  verificationAgrees Boolean? @map("verification_agrees")
  dimensionalCheckOk Boolean? @map("dimensional_check_ok")  // hard rule 8

  // Disclaimer (hard rule 1)
  disclaimerIncluded Boolean @default(false) @map("disclaimer_included")

  // Lifecycle
  status          String   @default("drafted")
  // drafted | calculated | self_verified | sent_for_review |
  // engineer_approved | engineer_corrected | archived

  // Engineer review (the calc is an ASSISTANT output — a licensed engineer
  // reviews, approves, signs, and carries responsibility)
  sentForReviewAt DateTime? @map("sent_for_review_at")
  engineerVerdict String?  @map("engineer_verdict")  // approved | corrected
  engineerNotes   String?  @db.Text @map("engineer_notes")
  reviewedAt      DateTime? @map("reviewed_at")

  // Archive
  archiveMessageId Int?    @map("archive_message_id")

  // Relations
  verification    EngineeringCalculationVerification?

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([discipline])
  @@index([status])
  @@index([verdict])
  @@index([createdAt(sort: Desc)])
  @@map("engineering_calculations")
}

// ─── NormReference ───────────────────────────────────────────────────────────

model NormReference {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(2044005421) @map("user_id")

  code            String   // "SP 20.13330" | "Eurocode 3" | "IEC 62109" etc.
  title           String
  normSystem      String   @map("norm_system")  // RF | eurocode | iec | iso
  discipline      String   // structural | hydraulic | power_electronics
  edition         String?  // edition / year
  whatItGoverns   String   @db.Text @map("what_it_governs")

  // Norms get revised — track currency
  isCurrent       Boolean  @default(true) @map("is_current")
  supersededBy    String?  @map("superseded_by")
  lastCheckedAt   DateTime? @map("last_checked_at")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([userId, code])
  @@index([userId])
  @@index([discipline])
  @@index([normSystem])
  @@map("norm_references")
}

// ─── DesignReview ────────────────────────────────────────────────────────────

model DesignReview {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(2044005421) @map("user_id")

  // What is being reviewed
  subject         String
  discipline      String
  reviewType      String   @map("review_type")
  // third_party_calc | internal_sanity_check | feasibility_check

  // The review
  scope           String   @db.Text
  findings        String   @db.Text  // JSON array of findings
  // [{ severity: "critical|major|minor|note", finding, recommendation }]
  grossErrorsFound Int     @default(0) @map("gross_errors_found")

  // Verdict
  verdict         String   // sound | has_issues | unsound | inconclusive
  recommendation  String   @db.Text

  // Disclaimer applies here too — a review is not an approval
  disclaimerIncluded Boolean @default(false) @map("disclaimer_included")

  calculationId   Int?     @map("calculation_id")

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([discipline])
  @@index([reviewType])
  @@map("design_reviews")
}

// ─── EngineeringCalculationVerification ──────────────────────────────────────

model EngineeringCalculationVerification {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(2044005421) @map("user_id")

  calculationId   Int      @unique @map("calculation_id")
  calculation     EngineeringCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  // The licensed engineer's review is the verification source
  engineerFoundError Boolean @map("engineer_found_error")
  errorWasSubstantive Boolean @default(false) @map("error_was_substantive")
  // косметика не считается промахом — только содержательная ошибка

  // Error classification (for learning-loop clustering)
  errorClass      String?  @map("error_class")
  // missed_load_case | wrong_coefficient | wrong_norm | dimensional_error |
  // wrong_assumption | method_error | none
  errorDescription String? @db.Text @map("error_description")

  // Could the department's own checks have caught it?
  catchableInternally Boolean? @map("catchable_internally")
  // true → a real miss (verification/dimensional/load-case review should have caught it)

  // Independent-method agreement (hard rule 7 outcome)
  independentMethodAgreed Boolean? @map("independent_method_agreed")

  lessonLearned   String?  @db.Text @map("lesson_learned")

  verifiedAt      DateTime @default(now()) @map("verified_at")

  @@index([userId])
  @@index([errorClass])
  @@map("engineering_calculation_verifications")
}

// ─── EngineeringMonthlyReview ────────────────────────────────────────────────

model EngineeringMonthlyReview {
  id              Int      @id @default(autoincrement())
  userId          Int      @default(2044005421) @map("user_id")

  periodStart     DateTime @map("period_start")
  periodEnd       DateTime @map("period_end")

  // Aggregated metrics
  calculationsReviewed   Int     @default(0) @map("calculations_reviewed")
  engineerCorrectionRate Float?  @map("engineer_correction_rate")
  // share where engineer found a substantive error
  independentAgreementRate Float? @map("independent_agreement_rate")
  missedLoadCaseRate     Float?  @map("missed_load_case_rate")
  disclaimerComplianceRate Float? @map("disclaimer_compliance_rate")

  // Error clustering
  errorClusters   String   @default("[]") @db.Text @map("error_clusters")
  // JSON: [{ errorClass, count }]

  // Chosen improvements (1-2 per month)
  improvementsChosen String @default("[]") @db.Text @map("improvements_chosen")

  // Trend vs previous month
  trendNote       String?  @db.Text @map("trend_note")

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([periodStart(sort: Desc)])
  @@map("engineering_monthly_reviews")
}

// ============================================================================
// END OF ENGINEERING SCHEMA ADDITIONS
// 5 new models added.
// ============================================================================
