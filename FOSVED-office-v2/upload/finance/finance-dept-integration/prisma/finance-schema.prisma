// finance-schema.prisma
// Finance department models.
// APPEND THIS to main prisma/schema.prisma — do NOT replace.

model FinancialForecast {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shortTitle        String
  fullResult        String   @db.Text
  confidence        String   @default("medium")
  resultType        String   // forecast | tax | unit_economics | invoice | runway | mrr_arr | other
  status            String   @default("drafted")
  verificationDate  DateTime?
  supersededById    Int?

  jurisdiction      String   // BY | RU | EU | US
  businessForm      String   // ooo | ip | selfemployed

  amount            Decimal? @db.Decimal(20, 4)
  currency          String?

  archiveMessageId  Int?
  archiveChannelId  BigInt?

  clientId          Int?
  projectId         Int?

  verifications     FinancialForecastVerification[]

  @@index([status])
  @@index([resultType])
  @@index([jurisdiction])
  @@index([createdAt])
  @@index([verificationDate])
  @@index([clientId])
  @@index([projectId])
  @@map("financial_forecasts")
}

model FinancialForecastVerification {
  id           Int      @id @default(autoincrement())
  forecastId   Int
  outcome      String
  actualValue  Decimal? @db.Decimal(20, 4)
  mape         Float?
  notes        String?  @db.Text
  verifiedAt   DateTime @default(now())

  forecast     FinancialForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)

  @@index([forecastId])
  @@index([verifiedAt])
  @@map("financial_forecast_verifications")
}

model FinanceMonthlyReview {
  id                 Int      @id @default(autoincrement())
  periodStart        DateTime
  periodEnd          DateTime
  totalForecasts     Int      @default(0)
  correctForecasts   Int      @default(0)
  avgMape            Float?
  mapeBreakdown      String?  @db.Text
  errorPatterns      String?  @db.Text
  improvements       String?  @db.Text
  createdAt          DateTime @default(now())
  archiveMessageId   Int?
  archiveChannelId   BigInt?

  @@index([periodStart])
  @@map("finance_monthly_reviews")
}

model FinanceQuarterlyMethodologyReview {
  id                 Int      @id @default(autoincrement())
  periodStart        DateTime
  periodEnd          DateTime
  patternsSummary    String   @db.Text
  methodologyChanges String?  @db.Text
  createdAt          DateTime @default(now())
  archiveMessageId   Int?
  archiveChannelId   BigInt?

  @@index([periodStart])
  @@map("finance_quarterly_methodology_reviews")
}

// IMPORTANT: Check if Invoice model already exists in main schema before adding!
// If yes — merge fields (add jurisdiction, businessForm, archiveMessageId, etc.)
// If no — apply this whole model.

model Invoice {
  id                Int       @id @default(autoincrement())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  invoiceNumber     String    @unique
  issueDate         DateTime
  dueDate           DateTime
  clientId          Int?
  clientName        String
  clientTaxId       String?
  amount            Decimal   @db.Decimal(20, 4)
  currency          String
  vatRate           Float?
  vatAmount         Decimal?  @db.Decimal(20, 4)
  jurisdiction      String
  businessForm      String
  reverseCharge     Boolean   @default(false)
  status            String    @default("drafted")
  sentAt            DateTime?
  paidAt            DateTime?
  paidAmount        Decimal?  @db.Decimal(20, 4)
  closedAt          DateTime?
  writeOffDate      DateTime?
  writeOffReason    String?
  projectId         Int?
  archiveMessageId  Int?
  archiveChannelId  BigInt?
  description       String    @db.Text
  statusHistory     InvoiceStatusHistory[]

  @@index([status])
  @@index([dueDate])
  @@index([clientId])
  @@index([projectId])
  @@map("invoices")
}

model InvoiceStatusHistory {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  fromStatus  String?
  toStatus    String
  reason      String?
  changedAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([changedAt])
  @@map("invoice_status_history")
}

model TaxCalendarEvent {
  id                Int      @id @default(autoincrement())
  jurisdiction      String
  businessForm      String
  taxType           String
  description       String
  deadlineDate      DateTime
  notifyDaysBefore  Int      @default(7)
  completed         Boolean  @default(false)
  completedAt       DateTime?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([jurisdiction, businessForm])
  @@index([deadlineDate])
  @@map("tax_calendar_events")
}
