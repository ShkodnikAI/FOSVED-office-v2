// ============================================================
// NARAD #9: Контекст-менеджер — умная загрузка контекста
// Файл: dept/context.mlog
// Импортируется в app.mlog через: import ./dept/context
// ============================================================


// --- Инициализация таблиц ---

pattern InitContextTables() {
  db_execute("CREATE TABLE IF NOT EXISTS dialog_history (id INTEGER PRIMARY KEY AUTOINCREMENT, chat_id TEXT NOT NULL, role TEXT NOT NULL, dept TEXT, content TEXT NOT NULL, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)")
  db_execute("CREATE TABLE IF NOT EXISTS adapt_corrections (id INTEGER PRIMARY KEY AUTOINCREMENT, dept TEXT NOT NULL, original_query TEXT, original_response TEXT, correction TEXT NOT NULL, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)")
  db_execute("CREATE TABLE IF NOT EXISTS pinned_facts (id INTEGER PRIMARY KEY AUTOINCREMENT, fact TEXT NOT NULL, created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_dialog_chat ON dialog_history(chat_id)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_dialog_created ON dialog_history(created_at)")
  db_execute("CREATE INDEX IF NOT EXISTS idx_corrections_dept ON adapt_corrections(dept)")
}


// --- Выбор скиллов по ключевым словам (keyword matching, без LLM) ---

pattern SelectSkillsByKeywords(dept: String, query_text: String) -> String {
  let result = ""
  let q = lower(query_text)

  if dept == "osp" {
    if contains(q, "прогноз") == 1.0 {
      let skill = read_file("skills/fosved/spd/calibration/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "актор") == 1.0 or contains(q, "действующ") == 1.0 {
      let skill = read_file("skills/fosved/spd/deep-profiling/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "декомпозиц") == 1.0 {
      let skill = read_file("skills/fosved/spd/deconstruct/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "гипотез") == 1.0 {
      let skill = read_file("skills/fosved/spd/calibration/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "нарратив") == 1.0 {
      let skill = read_file("skills/fosved/spd/narrative-vs-flows/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "источник") == 1.0 {
      let skill = read_file("skills/fosved/spd/source-triangulation/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "риск") == 1.0 {
      let skill = read_file("skills/fosved/spd/antifragility-design/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "манёвр") == 1.0 or contains(q, "стратег") == 1.0 {
      let skill = read_file("skills/fosved/spd/strategic-maneuvers/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
  }

  if dept == "expert" {
    if contains(q, "встреч") == 1.0 or contains(q, "переговор") == 1.0 {
      let skill = read_file("skills/fosved/expert/tactical-meeting-protocol/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "вопрос") == 1.0 {
      let skill = read_file("skills/fosved/expert/combat-questions-design/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "проект") == 1.0 or contains(q, "задач") == 1.0 {
      let skill = read_file("skills/fosved/expert/project-deconstruction/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
  }

  if dept == "finance" {
    if contains(q, "cashflow") == 1.0 or contains(q, "денежн") == 1.0 or contains(q, "поток") == 1.0 {
      let skill = read_file("skills/fosved/finance/cashflow-forecasting/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "налог") == 1.0 {
      let skill = read_file("skills/fosved/finance/tax-compliance-multi-jurisdiction/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "unit") == 1.0 or contains(q, "экономик") == 1.0 {
      let skill = read_file("skills/fosved/finance/unit-economics-calculation/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
  }

  if dept == "legal" {
    if contains(q, "договор") == 1.0 or contains(q, "контракт") == 1.0 {
      let skill = read_file("skills/fosved/legal/contract-drafting-discipline/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "gdpr") == 1.0 or contains(q, "персональн") == 1.0 or contains(q, "конфиденци") == 1.0 {
      let skill = read_file("skills/fosved/legal/gdpr-compliance-check/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "риск") == 1.0 {
      let skill = read_file("skills/fosved/legal/risk-mapping-protocol/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
  }

  if dept == "marketing" {
    if contains(q, "аудитори") == 1.0 or contains(q, "целев") == 1.0 {
      let skill = read_file("skills/fosved/marketing/audience-analysis/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "контент") == 1.0 or contains(q, "публикац") == 1.0 {
      let skill = read_file("skills/fosved/marketing/content-strategy/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "воронк") == 1.0 or contains(q, "конверс") == 1.0 {
      let skill = read_file("skills/fosved/marketing/funnel-optimization/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
  }

  if dept == "hr" {
    if contains(q, "найм") == 1.0 or contains(q, "собесед") == 1.0 {
      let skill = read_file("skills/fosved/hr/hiring-protocol/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "команд") == 1.0 or contains(q, "мотивац") == 1.0 {
      let skill = read_file("skills/fosved/hr/team-motivation/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
  }

  if dept == "engineering" {
    if contains(q, "архитектур") == 1.0 or contains(q, "техническ") == 1.0 {
      let skill = read_file("skills/fosved/engineering/architecture-review/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
    if contains(q, "код") == 1.0 or contains(q, "рефактор") == 1.0 {
      let skill = read_file("skills/fosved/engineering/code-review-protocol/SKILL.md")
      if len(skill) > 0.0 { result = result + skill + "\n---\n" }
    }
  }

  return result
}


// --- Загрузка последних сообщений диалога ---

pattern GetRecentDialog(chat_id: String, limit_val: Float) -> String {
  let rows = query("SELECT role, dept, content FROM dialog_history WHERE chat_id = ? ORDER BY created_at DESC LIMIT ?", [chat_id, to_string(limit_val)])
  let result = ""
  each row in rows {
    let role = row.role
    let content = row.content
    if len(result) > 0.0 {
      result = result + "\n"
    }
    result = result + role + ": " + content
  }
  return result
}


// --- Загрузка adapt-коррекций для отдела ---

pattern GetCorrections(dept: String) -> String {
  let rows = query("SELECT correction FROM adapt_corrections WHERE dept = ? ORDER BY created_at DESC LIMIT 5", [dept])
  let result = ""
  each row in rows {
    let correction = row.correction
    if len(result) > 0.0 {
      result = result + "\n- "
    } else {
      result = "- "
    }
    result = result + correction
  }
  return result
}


// --- Загрузка закреплённых фактов (по релевантности через SQL LIKE) ---

pattern GetPinnedFacts(query_text: String) -> String {
  let words = split(lower(query_text), " ")
  let checked = ""
  let result = ""
  each word in words {
    if len(word) < 3.0 {
      // Пропускаем короткие слова
    } else {
      if contains(checked, word) == 0.0 {
        checked = checked + " " + word
        let rows = query("SELECT fact FROM pinned_facts WHERE lower(fact) LIKE '%' || ? || '%' LIMIT 3", [word])
        each row in rows {
          let fact = row.fact
          if contains(result, fact) == 0.0 {
            if len(result) > 0.0 {
              result = result + "\n- "
            } else {
              result = "- "
            }
            result = result + fact
          }
        }
      }
    }
  }
  return result
}


// --- Основная функция: сборка контекста (3 уровня) ---

pattern BuildContext(dept: String, query_text: String, chat_id: String) -> String {
  // Уровень 1: профиль отдела
  let profile = read_file("library/" + dept + ".md")
  let context = profile + "\n\n"

  // Уровень 2: релевантные скиллы
  let skills = SelectSkillsByKeywords(dept, query_text)
  if len(skills) > 0.0 {
    context = context + "=== РЕЛЕВАНТНЫЕ СКИЛЛЫ ===\n" + skills + "\n"
  }

  // Уровень 2: закреплённые факты о владельце
  let facts = GetPinnedFacts(query_text)
  if len(facts) > 0.0 {
    context = context + "=== ИЗВЕСТНЫЕ ФАКТЫ О ВЛАДЕЛЬЦЕ ===\n" + facts + "\n"
  }

  // Уровень 2: семантическая память (recall — если есть данные)
  let memory = recall(query_text)
  if len(memory) > 0.0 {
    context = context + "=== ПАМЯТЬ ===\n" + memory + "\n"
  }

  // Уровень 2: adapt-коррекции
  let corrections = GetCorrections(dept)
  if len(corrections) > 0.0 {
    context = context + "=== ПРЕДЫДУЩИЕ КОРРЕКЦИИ (ОБЯЗАТЕЛЬНО УЧИТЫВАЙ!) ===\n" + corrections + "\n"
  }

  // Уровень 2: последние 5 сообщений диалога
  let dialog = GetRecentDialog(chat_id, 5.0)
  if len(dialog) > 0.0 {
    context = context + "=== ПОСЛЕДНИЕ СООБЩЕНИЯ ДИАЛОГА ===\n" + dialog + "\n"
  }

  return context
}


// --- Запись сообщения в историю ---

pattern RecordMessage(chat_id: String, role: String, dept: String, content: String) {
  // Ограничиваем историю до 100 записей
  let count_val = query_scalar("SELECT COUNT(*) FROM dialog_history WHERE chat_id = ?", [chat_id])
  let count = 0.0
  if type_of(count_val) == "Float" {
    count = count_val
  }
  if count > 100.0 {
    query("DELETE FROM dialog_history WHERE chat_id = ? AND id IN (SELECT id FROM dialog_history WHERE chat_id = ? ORDER BY created_at ASC LIMIT 20)", [chat_id, chat_id])
  }
  query("INSERT INTO dialog_history (chat_id, role, dept, content) VALUES (?, ?, ?, ?)", [chat_id, role, dept, content])
}


// --- Запись ответа и проверка на сжатие ---

pattern RecordAndRespond(chat_id: String, dept: String, query_text: String, reply: String) {
  RecordMessage(chat_id, "assistant", dept, reply)
  MaybeCompress(chat_id)
}


// --- Проверка необходимости сжатия ---

pattern MaybeCompress(chat_id: String) {
  let count_val = query_scalar("SELECT COUNT(*) FROM dialog_history WHERE chat_id = ?", [chat_id])
  let count = 0.0
  if type_of(count_val) == "Float" {
    count = count_val
  }
  if count > 20.0 {
    CompressDialog(chat_id)
  }
}


// --- Сжатие диалога через LLM ---

pattern CompressDialog(chat_id: String) -> String {
  let rows = query("SELECT role, content FROM dialog_history WHERE chat_id = ? ORDER BY created_at ASC LIMIT 15", [chat_id])
  let old_text = ""
  each row in rows {
    old_text = old_text + row.role + ": " + row.content + "\n"
  }

  if len(old_text) == 0.0 {
    return "ok"
  }

  let provider = read_file("config/priority_provider.txt")
  let model = read_file("config/priority_model.txt")
  let api_key = GetApiKey(provider)

  let summary = call_claude(api_key, model, "Сожми следующий диалог в 3-5 предложений. Сохрани ключевые факты и решения. Пиши на русском.", old_text)

  if len(summary) > 0.0 {
    query("INSERT INTO pinned_facts (fact) VALUES (?)", [summary])
  }

  query("DELETE FROM dialog_history WHERE chat_id = ? AND id IN (SELECT id FROM dialog_history WHERE chat_id = ? ORDER BY created_at ASC LIMIT 15)", [chat_id, chat_id])

  return "ok"
}


// --- /fix — adapt-коррекция ---

pattern HandleFix(chat_id: String, text: String) -> String {
  let correction = substring(text, 5.0, len(text))

  if len(trim(correction)) == 0.0 {
    return "Использование: /fix <что исправить>. Пример: /fix ответ слишком общий, нужна конкретика"
  }

  let last_row = query("SELECT dept, content FROM dialog_history WHERE chat_id = ? AND role = 'assistant' ORDER BY created_at DESC LIMIT 1", [chat_id])
  let last_dept = ""
  let last_response = ""

  each row in last_row {
    last_dept = row.dept
    last_response = row.content
  }

  if len(last_dept) == 0.0 {
    return "Нет предыдущего ответа для коррекции"
  }

  query("INSERT INTO adapt_corrections (dept, original_query, original_response, correction) VALUES (?, '', ?, ?)", [last_dept, last_response, trim(correction)])

  return "Коррекция принята для отдела " + last_dept + ". Следующие ответы будут учитывать: " + trim(correction)
}


// --- /remember — закрепить факт ---

pattern HandleRemember(text: String) -> String {
  let fact = substring(text, 10.0, len(text))

  if len(trim(fact)) == 0.0 {
    return "Использование: /remember <факт>. Пример: /remember мой бизнес - EdTech платформа"
  }

  query("INSERT INTO pinned_facts (fact) VALUES (?)", [trim(fact)])
  kv_set("remembered_fact_" + to_string(now()), trim(fact))

  return "Запомнил: " + trim(fact)
}


// --- Вспомогательный: получить API ключ по провайдеру ---

pattern GetApiKey(provider: String) -> String {
  let p = lower(trim(provider))
  if p == "zai" or p == "claude" or p == "anthropic" {
    return env("ANTHROPIC_KEY")
  }
  if p == "openai" {
    return env("OPENAI_KEY")
  }
  if p == "grok" or p == "xai" {
    return env("GROK_KEY")
  }
  return env("ANTHROPIC_KEY")
}